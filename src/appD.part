function attCanvasFitForModel(cv, format, quality, opts) {
  var o = opts || {};
  var edgeLimit = (Number(o.maxEdge) > 0) ? Number(o.maxEdge) : imgMaxSide();
  var hardMax = (Number(o.hardMax) > 0) ? Number(o.hardMax) : READ_IMG_HARD_MAX;
  var w0 = cv.width, h0 = cv.height, longest = Math.max(w0, h0), i, j;
  var e0 = Math.min(edgeLimit, longest), cand = [e0, 1400, 1000, 768, 512], edges = [];
  for (i = 0; i < cand.length; i++) {
    if (cand[i] > 0 && cand[i] <= e0 && edges.indexOf(cand[i]) < 0) edges.push(cand[i]);
  }
  for (i = 0; i < edges.length; i++) {
    var k = edges[i] / longest;
    var cw = Math.max(1, Math.round(w0 * k)), ch = Math.max(1, Math.round(h0 * k));
    var c = (k < 1) ? downscaleImage(cv, cw, ch, imgResampleMode(), false) : cv;
    var qs = (i === 0) ? [quality, 0.6, 0.4] : [0.6, 0.4];
