/* xlsx/xls 的「图片档」= 本机自绘表格图(方案 D12;零新库 = canvas + toDataURL)。
   **数据保真、非视觉保真**:行列表格与文本内容可信;字体/颜色/合并单元格/列宽/公式/条件格式/图表一律不还原
   —— 调用方必须把这句话写进 degraded(文案见方案 §2.7-① 的 renderSrc="drawn" 分支)。
   · text = 已抽好的正文(每表一段:`# <表名>` 段头 + 内容);两种读视图都能画(CSV 行 / grid 的 `地址→值` 行)
   · opts = { maxSheets, maxRows, maxCols, scale, format:"image/jpeg", quality, maxEdge, hardMax }
   返回 { ok, images:[{mime,data,w,h,bytes,page,label}], notes:[…], error }
   · page = 表序号(1-based)· label = "表 N · <表名>" · 每表一张图
   · 每张图交付前一律过 attCanvasFitForModel(R11:按 imgMaxSide() 下采样 + 单张 1 MiB 硬顶);
     压不进硬顶的那张**不发**,并在 notes 记「表 N 的表格图超过单张 <上限> 上限,未绘制」
   · 行/列/表数超上限 ⇒ 截断 + notes 记(调用方并入 degraded;文案逐字见方案 R11 与批-4 报告) */
function attachDrawSheetImages(text, opts) {
  var o = opts || {};
  var maxSheets = Math.max(1, Math.round(Number(o.maxSheets) || 10));
  var maxRows = Math.max(1, Math.round(Number(o.maxRows) || 60));
  var maxCols = Math.max(1, Math.round(Number(o.maxCols) || 12));
  var scale = Number(o.scale) > 0 ? Number(o.scale) : 1;
  var format = String(o.format || "image/jpeg");
  var quality = (typeof o.quality === "number") ? o.quality : 0.86;
  var res = { ok: false, images: [], notes: [], error: "" };
  if (!canvasOK()) { res.error = "当前浏览器不支持图片绘制(canvas)"; return res; }
  var segs = attPartitionByPage(text, [], "sheetHead").segs;
  if (!segs.length) { res.error = "没有可绘制的表格段"; return res; }
  /* CSV 行的引号规则(逗号/双引号/换行都在引号内时才特殊);grid 视图的 `地址\t值` 行只取值 */
  function cellsOf(line) {
    var gm = /^[A-Z]{1,3}[0-9]{1,7}\t([\s\S]*)$/.exec(line);
    if (gm) return [gm[1].replace(/\t\{z=[\s\S]*$/, "")];
    var out = [], cur = "", q = false;
    for (var i2 = 0; i2 < line.length; i2++) {
      var ch = line.charAt(i2);
      if (q) {
        if (ch === '"') { if (line.charAt(i2 + 1) === '"') { cur += '"'; i2++; } else q = false; }
        else cur += ch;
      } else if (ch === '"') q = true;
      else if (ch === ",") { out.push(cur); cur = ""; }
      else cur += ch;
    }
    out.push(cur);
    return out;
  }
  var rowsAll = [], si, ri, j3;
  function nameOf(i2) {
    var h = String(segs[i2].head || "").replace(/^#\s*/, "").replace(/\s{2,}\(.*$/, "").replace(/\s+$/, "");
    return h || ("表 " + (i2 + 1));
  }
  for (si = 0; si < segs.length && si < maxSheets; si++) {
    var ls = String(segs[si].text || "").split("\n"), rows = [], rest = 0;
    for (ri = 0; ri < ls.length; ri++) {
      if (!ls[ri].replace(/\s/g, "")) continue;
      if (rows.length >= maxRows) { rest++; continue; }
      rows.push(cellsOf(ls[ri]));
    }
    rowsAll.push({ no: si + 1, name: nameOf(si), rows: rows });
    if (rest > 0) res.notes.push("表 " + (si + 1) + " 仅绘制前 " + maxRows + " 行(另有 " + rest + " 行未画)");
  }
  if (segs.length > maxSheets) res.notes.push("仅绘制前 " + maxSheets + " 张表(共 " + segs.length + " 张)");
  var gauge = document.createElement("canvas").getContext("2d");
  var font = Math.round(13 * scale) + "px sans-serif";
  var headFont = "bold " + Math.round(14 * scale) + "px sans-serif";
  for (si = 0; si < rowsAll.length; si++) {
    var it = rowsAll[si], cols = 0, i3;
    for (i3 = 0; i3 < it.rows.length; i3++) if (it.rows[i3].length > cols) cols = it.rows[i3].length;
    var cutCols = false;
    if (cols > maxCols) { cols = maxCols; cutCols = true; }
    if (cols < 1) cols = 1;
    var widths = [], wsum = 0;
    gauge.font = font;
    for (j3 = 0; j3 < cols; j3++) {
      var mw = 48 * scale;
      for (i3 = 0; i3 < it.rows.length; i3++) {
        var tv = (it.rows[i3][j3] == null) ? "" : String(it.rows[i3][j3]);
        var tw = gauge.measureText(tv).width + 12 * scale;
        if (tw > mw) mw = tw;
      }
      if (mw > 260 * scale) mw = 260 * scale;          /* 单列上限:超长文本按列宽裁切显示 */
      widths.push(Math.round(mw));
      wsum += widths[j3];
    }
    var pad = Math.round(10 * scale), headH = Math.round(26 * scale), rowH = Math.round(20 * scale);
    var cv = document.createElement("canvas");
    cv.width = Math.max(80, Math.round(wsum + pad * 2));
    cv.height = Math.max(60, Math.round(headH + it.rows.length * rowH + pad * 2));
    var g = cv.getContext("2d");
    g.fillStyle = "#ffffff";
    g.fillRect(0, 0, cv.width, cv.height);
    g.fillStyle = "#111111";
    g.font = headFont;
    g.fillText(it.name, pad, pad + Math.round(14 * scale));
    var top = pad + headH, x0 = pad;
    for (ri = 0; ri <= it.rows.length; ri++) {
      var y = top + ri * rowH;
      g.strokeStyle = "#bbbbbb";
      g.lineWidth = 1;
      g.beginPath();
      g.moveTo(x0, y);
      g.lineTo(x0 + wsum, y);
      g.stroke();
      if (ri >= it.rows.length) continue;
      var xx = x0;
      g.font = font;
      g.fillStyle = "#000000";
      for (j3 = 0; j3 < cols; j3++) {
        g.save();
        g.beginPath();
        g.rect(xx + 1, y + 2, widths[j3] - 2, rowH - 2);
        g.clip();
        g.fillText((it.rows[ri][j3] == null) ? "" : String(it.rows[ri][j3]), xx + 6 * scale, y + Math.round(14 * scale));
        g.restore();
        xx += widths[j3];
      }
    }
    g.strokeStyle = "#bbbbbb";
    for (j3 = 0; j3 <= cols; j3++) {
      var cx = x0;
      for (i3 = 0; i3 < j3; i3++) cx += widths[i3];
      g.beginPath();
      g.moveTo(cx, top);
      g.lineTo(cx, top + it.rows.length * rowH);
      g.stroke();
    }
    var fit = attCanvasFitForModel(cv, format, quality, { maxEdge: o.maxEdge, hardMax: o.hardMax });
    if (!fit.ok) {
      if (fit.over) {                        /* 压不进硬顶 ⇒ 只跳过这一张(其余表照画) */
        res.notes.push("表 " + it.no + " 的表格图超过单张 " + fmtBytes(fit.limit) + " 上限,未绘制");
        continue;
      }
      res.error = "表格图导出失败(" + fit.error + ")";
      return res;
    }
    res.images.push({
      mime: fit.mime, data: fit.data, w: fit.w, h: fit.h, bytes: fit.bytes,
      page: it.no, label: "表 " + it.no + " · " + it.name
    });
    if (cutCols) res.notes.push("表 " + it.no + " 仅绘制前 " + maxCols + " 列");
  }
  res.ok = res.images.length > 0;
  if (!res.ok && !res.error) res.error = "没有绘制出任何表格图";
  return res;
}

/* ===== S7:docx 逐页渲染成「页图」(唯一渲染出口;方案 specs/b31-s7-renderer-plan.md v2.1 §2.2 十步) =====
   库 = docx-preview 0.4.0 + jszip 3.10.2 + modern-screenshot 4.7.0(均已由 render.part 内联);
   · f    = 附件对象(只给日志/未来扩展;不读 f.text)
   · ext  = "docx"(唯一允许值;其它值直接 {ok:false},防误接)
   · buf  = ArrayBuffer/Uint8Array(OfficeKit 已读出的同一份字节;**不重新读文件**)
   · opts = { onProgress?:fn(phase), maxPages?:n, dpi?:n }   // 缺省 = pdfMaxPages() / pdfDpi()
   返回 Promise<{ ok, images:[PageImage], notes:[String], pages:Number, clipped:Boolean, error:String }>
   · 永不 reject;整体失败 ⇒ ok:false + error(中文);部分页失败/截断 ⇒ ok:true + notes
   · images[].page = 1-based 真页号(顺序即渲染序)
   十步:① 守卫 → ② 双宿主(游离) → ③ parseAsync(OPTIONS 钉死) → ④ 资源守卫(wrap 三方法,值级阻断)
        → ⑤ renderDocument(仍游离) → ⑥ 游离态资源清洗(防御纵深) → ⑦ 双容器挂载 + 等图
        → ⑧ 分页(section.docx) → ⑨ 逐页光栅化 + attCanvasFitForModel 闸门(+空页守卫) → ⑩ 注记 + 清理 + 返回 */
function attachRenderPageImages(f, ext, buf, opts) {
  var o = opts || {};
  var res = { ok: false, images: [], notes: [], pages: 0, clipped: false, error: "", clean: { attr: 0, styleUrl: 0 } };
  /* ① 守卫(不抛) */
  if (String(ext).toLowerCase() !== "docx" || !docxRenderReady()
    || !(window.docx && window.JSZip && window.modernScreenshot)) {
    res.error = "渲染器未内嵌";
    return Promise.resolve(res);
  }
  var maxPages = Math.max(1, Math.round(Number(o.maxPages) || pdfMaxPages()));
  var dpi = (Number(o.dpi) > 0) ? Number(o.dpi) : pdfDpi();
  var host = null, styleHost = null;
  function cleanup() {   /* ⑦ 宿主用后必删(成功/失败/超时三条路径都在收口处执行) */
    try { if (host && host.parentNode) { host.parentNode.removeChild(host); } } catch (e) {}
    try { if (styleHost && styleHost.parentNode) { styleHost.parentNode.removeChild(styleHost); } } catch (e) {}
  }
  function mkHost() {
    var d = document.createElement("div");
    d.style.cssText = "position:absolute;left:-10000px;top:0;pointer-events:none;";
    return d;                                   /* 只创建、不挂载(第 ⑦ 步才挂) */
  }
  /* OPTIONS 钉死(parse 与 render 传同一对象;useBase64URL:true ⇒ 图/内嵌字体全 data: URL;
     renderAltChunks:false ⇒ 斩断 altChunk 的 iframe srcdoc 取网面;ignoreLastRenderedPageBreak:false
     = 让 docx-preview 按 <w:lastRenderedPageBreak/> 分页 —— 贴 Word 页数的关键一项) */
  var OPT = {
    className: "docx", inWrapper: true, breakPages: true, ignoreLastRenderedPageBreak: false,
    renderHeaders: true, renderFooters: true, renderFootnotes: true, renderEndnotes: true,
    useBase64URL: true, renderAltChunks: false
  };
  /* ④ 资源守卫(值级阻断):三个装载口任何一个返回空/抛错 ⇒ 透明 GIF 哨兵(计数 img/numbering/font/errors) */
  function installGuard(d) {
    var counters = { img: 0, numbering: 0, font: 0, errors: 0 };
    function wrap(name, key) {
      var orig = d[name];
      if (typeof orig !== "function") { return; }
      d[name] = function (a, b) {
        return Promise.resolve().then(function () { return orig.call(d, a, b); })
          .then(function (u) { if (u) { return u; } counters[key]++; return RENDER_IMG_SKIP_GIF; },
            function () { counters.errors++; return RENDER_IMG_SKIP_GIF; });
      };
    }
    wrap("loadDocumentImage", "img");
    wrap("loadNumberingImage", "numbering");
    wrap("loadFont", "font");
    return counters;
  }
  /* ⑥ 游离态资源清洗(防御纵深):白名单外 URL 属性中和(<a>/<area> 的 href 豁免:超链接不发起请求,点击才是用户动作);
     `<style>` 节点文本里的 url(http(s)://…) 一并中和为 url(about:blocked#)(方案 §2.2-⑥ 的 style 文本面)。
     两类计数 = {attr: 属性中和数, styleUrl: 样式文本中和数} —— **正常输入下都应为 0**
     (不为 0 说明还有未驯服的引用 ⇒ 调用方如实进 notes,见步骤 ⑩)。 */
  function cleanNodes(nodes) {
    var attrs = ["src", "srcset", "poster", "data", "xlink:href", "href"];
    var out = { attr: 0, styleUrl: 0 };
    var URL_RE = /url\(\s*['"]?https?:\/\/[^)'"]*['"]?\s*\)/gi;
    function walk(el) {
      if (el.nodeType === 1) {
        var tag = String(el.tagName || "").toLowerCase(), i, v;
        for (i = 0; i < attrs.length; i++) {
          if (i === 5 && (tag === "a" || tag === "area")) { continue; }
          v = el.getAttribute(attrs[i]);
          if (v == null) { continue; }
          if (!/^(data:|blob:|about:|#)/.test(v)) { out.attr++; el.removeAttribute(attrs[i]); }
        }
        if (tag === "style") {
          var t = String(el.textContent || "");
          var hits = (t.match(URL_RE) || []).length;
          if (hits) { out.styleUrl += hits; el.textContent = t.replace(URL_RE, "url(about:blocked#)"); }
        }
      }
      for (var j = 0; j < el.childNodes.length; j++) { walk(el.childNodes[j]); }
    }
    for (var k = 0; k < nodes.length; k++) { walk(nodes[k]); }
    return out;
  }
  /* ⑦ 等 img 解码(上限 RENDER_IMG_WAIT_MS;超时继续,不失败) */
  function waitImages(rootEl, ms) {
    var imgs = rootEl.querySelectorAll("img"), pending = [], i;
    for (i = 0; i < imgs.length; i++) { if (!imgs[i].complete) { pending.push(imgs[i]); } }
    if (!pending.length) { return Promise.resolve(); }
    return new Promise(function (resolve) {
      var left = pending.length, done = false;
      var timer = setTimeout(function () { if (!done) { done = true; resolve(); } }, ms);
      pending.forEach(function (im) {
        var h = function () { left--; if (left <= 0 && !done) { done = true; clearTimeout(timer); resolve(); } };
        im.addEventListener("load", h);
        im.addEventListener("error", h);
      });
    });
  }
  /* ⑩ 注记来源(解析层 rels):external image / altChunk 两条 */
  function relsCount(d, kinds) {
    var out = { extImg: 0, altChunk: 0 };
    try {
      var rels = d.documentPart.rels;
      for (var k in rels) {
        if (!Object.prototype.hasOwnProperty.call(rels, k)) { continue; }
        var r = rels[k];
        if (!r) { continue; }
        if (r.targetMode === "External" && /\/image$/.test(String(r.type || ""))) { out.extImg++; }
        if (/\/aFChunk$/.test(String(r.type || ""))) { out.altChunk++; }
      }
    } catch (e) {}
    return out;
  }
  /* ⑨ 空页守卫的读数:原生分辨率步长 8 抽样(取不到像素 ⇒ 返回 1,宁可多发一张也不静默丢页) */
  function inkRatioOf(cv) {
    try {
      var g = cv.getContext("2d");
      var im = g.getImageData(0, 0, cv.width, cv.height).data;
      var ink = 0, tot = 0, st = 8, px, py, idx;
      for (py = 0; py < cv.height; py += st) {
        for (px = 0; px < cv.width; px += st) {
          idx = (py * cv.width + px) * 4; tot++;
          if ((im[idx] + im[idx + 1] + im[idx + 2]) / 3 < 200) { ink++; }
        }
      }
      return tot ? (ink / tot) : 1;
    } catch (e) { return 1; }
  }
  var onProgress = o.onProgress;
  var work = (function () {
    host = mkHost();                              /* ② 两容器都只创建、不挂载 */
    styleHost = mkHost();
    if (onProgress) { onProgress("rendering"); }
    return window.docx.parseAsync(buf, OPT).then(function (d) {   /* ③ 解析 */
      var wrap = installGuard(d);                 /* ④ 资源守卫 */
      return window.docx.renderDocument(d, OPT).then(function (nodes) {   /* ⑤ 渲染(仍游离) */
        var clean = cleanNodes(nodes);            /* ⑥ 游离态清洗(计数 attr / styleUrl,见 cleanNodes) */
        res.clean = clean;
        for (var i = 0; i < nodes.length; i++) {  /* ⑦ STYLE 进 styleHost、其余进 host,再两个都挂 */
          (nodes[i].nodeName === "STYLE" ? styleHost : host).appendChild(nodes[i]);
        }
        document.body.appendChild(host);
        document.body.appendChild(styleHost);
        return waitImages(host, RENDER_IMG_WAIT_MS).then(function () {
          var secs = host.querySelectorAll("section.docx");   /* ⑧ 分页 */
          res.pages = secs.length;
          res.clipped = secs.length > maxPages;
          if (res.clipped) { res.notes.push("文档共 " + secs.length + " 页,按页数上限仅渲染前 " + maxPages + " 页"); }
          var n = Math.min(secs.length, maxPages);
          var scale = dpi / 96;
          var k = 0;
          function onePage() {
            if (k >= n) { return Promise.resolve(); }
            var idx = k, sec = secs[idx];
            k++;
            return window.modernScreenshot.domToCanvas(sec, { scale: scale, backgroundColor: "#fff" })   /* ⑨ 光栅化 */
              .then(function (cv) {
                /* 单页 try/catch 全覆盖(P2-8):闸门/取样段若同步抛也走"跳过该页 + 注记",不冒泡成整轮失败 */
                try {
                  /* 与 PDF 图片档同参数:jpeg / q0.86(首选档) / 同一 DPI 与页数;再额外过 attCanvasFitForModel 闸门 */
                  var fit = attCanvasFitForModel(cv, "image/jpeg", 0.86, { maxEdge: Math.min(2000, imgMaxSide()) });
                  if (!fit.ok) {
                    if (fit.over) {
                      res.notes.push("第 " + (idx + 1) + " 页页图超过单张 " + fmtBytes(fit.limit) + " 上限,未包含");
                    } else {
                      res.notes.push("第 " + (idx + 1) + " 页渲染失败,未包含在页图里(" + fit.error + ")");
                    }
                  } else if (inkRatioOf(cv) === 0 && String(sec.textContent || "").trim()) {
                    res.notes.push("第 " + (idx + 1) + " 页渲染为空,已跳过");   /* D6 空页守卫:有文字却全白 ⇒ 跳过 + 注记 */
                  } else {
                    res.images.push({
                      mime: fit.mime, data: fit.data, w: fit.w, h: fit.h, bytes: fit.bytes,
                      page: idx + 1, label: "第 " + (idx + 1) + " 页"
                    });
                  }
                } catch (e2) {
                  res.notes.push("第 " + (idx + 1) + " 页渲染失败,未包含在页图里(" + ((e2 && e2.message) || e2) + ")");
                }
                return onePage();
              }, function (e) {
                res.notes.push("第 " + (idx + 1) + " 页渲染失败,未包含在页图里(" + ((e && e.message) || e) + ")");
                return onePage();
              });
          }
          return onePage().then(function () {
            var rc = relsCount(d);                /* ⑩ 外部引用/占位注记(来源可信:解析层 rels) */
            if (rc.extImg > 0) { res.notes.push("文档含 " + rc.extImg + " 个外部引用(未随文档打包),已按离线模式忽略"); }
            if (wrap.img > rc.extImg) { res.notes.push("另有 " + (wrap.img - rc.extImg) + " 张图片在文档里无法解析,已按空白占位"); }
            if (wrap.numbering > 0) { res.notes.push("有 " + wrap.numbering + " 处图片项目符号在文档里无法解析,已按空白占位"); }
            if (wrap.font > 0) { res.notes.push("有 " + wrap.font + " 处内嵌字体引用无法解析,已回退系统字体"); }
            if (rc.altChunk > 0) { res.notes.push("文档含 " + rc.altChunk + " 处嵌入片段(altChunk),已按离线模式忽略"); }
            /* 清洗层计数只在非 0 时进 notes(方案 §2.2-⑥:正常输入下这两类计数应为 0;不为 0 = 还有未驯服的引用,如实说) */
            if (clean.attr > 0) { res.notes.push("渲染树里有 " + clean.attr + " 处资源引用已按离线模式中和"); }
            if (clean.styleUrl > 0) { res.notes.push("样式表里有 " + clean.styleUrl + " 处远程引用已按离线模式中和"); }
            res.ok = res.images.length > 0;
            if (!res.ok && !res.error) { res.error = "没有渲染出任何页面"; }
            return res;
          });
        });
      });
    }).catch(function (e) {
      res.error = res.error || ("渲染失败(" + ((e && e.message) || e) + ")");
      return res;
    });
  })();
  /* P2-2:超时**先于挂载**发生时 cleanNodes 还没跑、宿主尚未 appendChild ⇒ race 结算时的 cleanup 是空刀,
     work 之后仍会把两个 div 挂进 body ⇒ 在 work 自身结算处再清一次(cleanup 幂等,两条路径都覆盖) */
  work.then(cleanup, cleanup);
  var timeout = new Promise(function (resolve) {
    setTimeout(function () {
      resolve({ ok: false, images: [], notes: [], pages: 0, clipped: false,
        error: "渲染超时(" + (RENDER_DOCX_TIMEOUT_MS / 1000) + " 秒)" });
    }, RENDER_DOCX_TIMEOUT_MS);
  });
  return Promise.race([work, timeout]).then(function (r) {
    cleanup();
    return r;
  }, function (e) {
    cleanup();
    res.error = String((e && e.message) || e) || "渲染失败";
    return res;
  });
}

/* 附件侧 PDF 取图计划的**统一参数**(方案 §2.4「四路统一」):下面三处调用点全传它,
   别处不许另立一组(禁止"图片档+非视觉只处理 6 张、纯文本升档却 10 张"这类同结局不同预算) */
function attPdfOpts() { return { maxScan: pdfMaxPages(), maxImages: ATT_IMG_MAX_IMAGES }; }
/* 「有没有文字层」的唯一判据:剥掉 pdf.js 的页分隔标记后看还剩不剩内容。
   ⚠️ 与 Read 侧(appE 的 `realText`,同一条正则)是**同一判据的两份实现** ⇒ 改一处必须同步另一处
   (登记为跨段同源债;本批不动 appE)。 */
function pdfRealText(text) {
  return String(text == null ? "" : text).replace(/^[-\s]*第\s*\d+\s*页[-\s]*$/gm, "").trim();
}
/* 非视觉:把取到的图逐张本机 OCR,按原序并入正文(mode 落 `text` —— 图不进消息)。
   dec = 枢纽产物(取其 toast);plan = 已取到的候选(唯一实现,②/⑦/④ 三处共用) */
function pdfFuseToAtt(att, text, plan, notes, dec) {
  var all = (notes || []).slice(0);
  if (!plan.list.length) {
    if (all.length) att.degraded = all.join(" · ");
    return att;
  }
  if (plan.leftover > 0) all.push("另有 " + plan.leftover + " 图未处理(超出单次上限)");
  if (dec && dec.toast) { toast(dec.toast, "info", 4200); all.push(dec.toast); }
  return attOcrFuse(text, plan.list, "pages").then(function (fz) {
    att.text = fz.text;
    att.textChars = fz.text.length;
    att.ocrImgs = fz.ocrImgs;
    if (fz.clipped) att.clipped = true;
    var more = all.concat(fz.notes);
    if (more.length) att.degraded = more.join(" · ");
    return att;
  });
}
function resolvePdf(file) {
  if (!pdfKitReady()) {
    return Promise.reject(new Error(file.name + ":PDF 解析库不可用(" +
      ((window.PDFKit && window.PDFKit.why) || "缺少必要能力") + ")"));
  }
  var src = attachImgMode();                       /* 用户所选档:text | image | both(默认) */
  var vision = visionState().vision;               /* true | false | null */
  var cap = attachRenderCap("pdf", "pdf");         /* "pages"(逐页渲染) */
  /* 形态先按「档 + 视觉」取(此刻还不知道有没有文字层/图 ⇒ 用中性占位);
     **判定唯一来源 = 枢纽**(decideAttachPlan),本函数只负责执行它给的动作 */
  var pre = decideAttachPlan({
    kind: "pdf", subtype: "pdf", srcMode: src, vision: vision,
    hasText: true, imgCount: 0, hasTextLayer: true, cap: cap
  });
  return readAs(file, "buffer").then(function (buf) {
    /* ③ 图片档 + 视觉可用 ⇒ 逐页渲染(批前行为逐字节不变) */
    if (pre.send === "image") {
      return PDFKit.renderPages(buf, { dpi: pdfDpi(), maxPages: pdfMaxPages(), format: "image/jpeg", quality: 0.86 })
        .then(function (r) {
          if (!r || !r.ok) throw new Error(file.name + ":PDF 渲染失败(" + ((r && r.error) || "未知") + ")");
          if (!r.images || !r.images.length) throw new Error(file.name + ":没有渲染出任何页面");
          return {
            id: uid(), kind: "pdf", name: file.name, size: file.size, mode: "image",
            srcMode: src, renderSrc: "pages", imgCount: r.images.length,
            pages: r.pages || r.images.length, clipped: !!r.truncated,
            images: r.images.map(function (im) {
              return {
                mime: (String(im.dataUrl || "").match(/^data:([^;,]+)/) || [])[1] || "image/jpeg",
                data: dataUrlPayload(im.dataUrl || ""), w: im.width || 0, h: im.height || 0
              };
            })
          };
        });
    }
    return PDFKit.extractText(buf, { maxChars: ATTACH_TEXT_MAX, maxPages: 200 }).then(function (r) {
      if (!r || !r.ok) throw new Error(file.name + ":PDF 文本抽取失败(" + ((r && r.error) || "未知") + ")");
      var t = String(r.text || "").trim();
      if (!t) {
        throw new Error(file.name + ":这份 PDF 里没有可提取的文字(可能是扫描件),可在 设置 → 附件 中改用「图片」档");
      }
      var att = {
        id: uid(), kind: "pdf", name: file.name, size: file.size, mode: "text", srcMode: src,
        pages: r.pages || 1, text: t, clipped: !!r.truncated
      };
      /* ②/⑦ 非视觉(图片档或混合档):原图不发,图改用本机 OCR 后按原序并入正文(取图调用点 1/3) */
      if (pre.images === "ocr") {
        var n1 = [];
        return attPdfImgCands(buf, n1, attPdfOpts()).then(function (plan) {
          return pdfFuseToAtt(att, t, plan, n1, pre);
        });
      }
      /* ⑦ 混合档 + 视觉可用:正文 + 文档内图/页图;真的取到图才落 `both`(无图 ⇒ `text`,正文逐字节不变) */
      if (pre.send === "both") {
        var notes0 = [];
        return attPdfImgCands(buf, notes0, attPdfOpts()).then(function (plan) {    /* 取图调用点 2/3 */
          if (plan.list.length) {
            att.mode = "both";
            att.images = plan.list;
            att.renderSrc = (pre.render === "drawn") ? "drawn" : "pages";
            att.imgCount = plan.list.length;
          }
          if (plan.leftover > 0) notes0.push("另有 " + plan.leftover + " 图未处理(超出单次上限)");
          if (notes0.length) att.degraded = notes0.join(" · ");
          return att;
        });
      }
      /* ⑥ 纯文本档:**严格** —— 有文字层就到此为止(不探页图、不渲染、不 OCR) */
      if (pdfRealText(t)) return att;
      /* ④ 纯文本档 + 没有文字层 + 有图 ⇒ 升档(D1):先探图,真的取到图才升 */
      var notes = [];
      return attPdfImgCands(buf, notes, attPdfOpts()).then(function (plan) {       /* 取图调用点 3/3 */
        if (!plan.list.length) {
          if (notes.length) att.degraded = notes.join(" · ");
          return att;
        }
        var up = decideAttachPlan({
          kind: "pdf", subtype: "pdf", srcMode: src, vision: vision,
          hasText: !!t, imgCount: plan.list.length, hasTextLayer: false, cap: cap
        });
        if (up.images === "ocr") return pdfFuseToAtt(att, t, plan, notes, up);    /* 升档·非视觉 */
        att.mode = "both";                                                        /* 升档·视觉可用 ⇒ 发页图 */
        att.images = plan.list;
        att.renderSrc = (up.render === "drawn") ? "drawn" : "pages";
        att.imgCount = plan.list.length;
        if (plan.leftover > 0) notes.push("另有 " + plan.leftover + " 图未处理(超出单次上限)");
        if (up.toast) { toast(up.toast, "info", 4200); notes.push(up.toast); }
        if (notes.length) att.degraded = notes.join(" · ");
        return att;
      });
    });
  });
}

function resolveImage(file, ext, inMime) {
  return readAs(file, "data").then(function (dataUrl) {
    if (typeof dataUrl !== "string" || dataUrl.indexOf("data:") !== 0) throw new Error(file.name + ":读取图片失败");
    return transcodeImage(dataUrl, inMime).then(function (r) {
      var att = {
        id: uid(), kind: "image", name: file.name, size: file.size,
        mime: r.mime, data: r.data, w: r.w, h: r.h, scaled: r.scaled
      };
      return maybeOcrImage(att);
    });
  });
}
/* 模型不支持视觉时:用内嵌的 Tesseract.js 把字识别出来再发,而不是把图丢给模型 */
function maybeOcrImage(att) {
  if (visionState().vision !== false) return Promise.resolve(att);   // 支持 / 未知 → 直接按图片发
  if (!ocrReady()) {
    return Promise.reject(new Error(att.name + ":当前模型不支持图像输入,且本浏览器的 OCR 引擎不可用(" +
      ((window.OCRKit && window.OCRKit.why) || "缺少 Web Worker / WebAssembly") + ")"));
  }
  toast("正在用 OCR 识别「" + att.name + "」里的文字…", "info", 2600);
  return OCRKit.recognize("data:" + att.mime + ";base64," + att.data, { langs: ocrLangs() }).then(function (r) {
    if (!r || !r.ok) throw new Error(att.name + ":OCR 识别失败(" + ((r && r.error) || "未知") + ")");
    att.ocr = String(r.text || "").trim() || "(未识别出文字)";
    att.ocrConfidence = r.confidence || 0;
    return att;
  });
}

/* ---- 图文按序融合的共享助手(appD;appE 的 Read 侧与附件侧同 IIFE 可见)----
   非视觉模型读文档时,把图片按文档顺序本机 OCR 并插进文本。四个函数只做
   「逐张 OCR + 预算/中止」「块格式」「切页」「插块」,不做任何调用方文案
   (状态行与注记仍归调用方;旧 `【第 N 页】` 注记口径在 wsOcrCands 里逐字保留)。
   READ_* 常量在 appE(本段之后)⇒ 同 appD 既有约定,只在函数体内取。 */

/* OCR 块头(唯一来源):【<label> · 本机 OCR】+ 换行 */
function ocrBlockHead(label) {
  return "【" + String(label == null ? "" : label) + " · 本机 OCR】\n";
}
/* OCR 块正文(唯一来源):空/纯空白 ⇒ ""(不写空块;调用方据此累计「未识别」计数) */
function ocrBlockText(label, text) {
  var t = String(text == null ? "" : text);
  return t.trim() ? (ocrBlockHead(label) + t) : "";
}
/* 逐张 OCR(OCRKit 本身串行;单次 recognize 不可中断 ⇒ 中止生效点在两张之间)。
   cands = [{mime,data,label,page,kind}] —— label/page/kind 原样带回 blocks
   opts  = { signal(可中止对象,逐张检查), deadline(绝对时间戳), maxChars(字符预算),
             baseChars(调用方已占用的字符数,如页文本长度), prefixOf(cand,seq)→块前缀(只用于预算核算) }
   -> { blocks:[{label,text,ms,seq,page,kind}], done, empty, stopped, stop, aborted, ms }
      · blocks 只收「OCR 成功且有文字」的张(与 wsOcrCands 既有 if (o.ok && o.text) 同口径)
      · empty = fit 失败 / OCR 无文字(只计数,不入 blocks);命中 OCR 超时而停的那张不计 empty
      · stopped = 因时间或字符预算没做的张数;stop = "time" | "chars" | "" */
function ocrSeqCands(cands, opts) {
  opts = opts || {};
  var sig = opts.signal;
  var deadline = opts.deadline || (Date.now() + READ_OCR_TIMEOUT_MS);
  var maxChars = (opts.maxChars > 0) ? opts.maxChars : 0;          /* 0 / 未给 ⇒ 不限 */
  var acc = Math.max(0, Number(opts.baseChars) || 0);
  var prefixOf = (typeof opts.prefixOf === "function") ? opts.prefixOf : null;
  var blocks = [], done = 0, empty = 0, stopped = 0, stop = "", aborted = false, t0 = Date.now();
  var list = (cands && typeof cands.length === "number") ? cands : [];
  function prefixFor(c, seq) {
    if (!prefixOf) return "";
    try { return String(prefixOf(c, seq) == null ? "" : prefixOf(c, seq)); } catch (e) { return ""; }
  }
  function step() {
    if (done >= list.length) return Promise.resolve();
    if (sig && sig.aborted) { aborted = true; return Promise.resolve(); }
    if (Date.now() >= deadline) { stopped = list.length - done; stop = "time"; return Promise.resolve(); }
    if (maxChars > 0 && acc >= maxChars) { stopped = list.length - done; stop = "chars"; return Promise.resolve(); }
    var c = list[done] || {};
    var seq = done + 1;                                  /* 1-based 序号(与 wsOcrCands 的 done 同刻) */
    var remain = Math.max(1000, deadline - Date.now());
    var blob = wsBase64Blob(c.data, c.mime);
    if (!blob) { done++; empty++; return step(); }
    return wsImgFitForModel(blob, c.mime, {}).then(function (f) {
      if (!f.ok) { done++; empty++; return step(); }
      return wsOcrTextOf("data:" + f.mime + ";base64," + f.data, { remainingMs: remain }).then(function (o) {
        done++;
        if (o.ok && o.text) {
          blocks.push({
            label: String(c.label == null ? "" : c.label), text: o.text, ms: o.ms || 0,
            seq: seq, page: c.page || 0, kind: c.kind || ""
          });
          acc += prefixFor(c, seq).length + String(o.text).length;
        } else if (!o.ok && /超时/.test(String(o.error || ""))) {
          /* 超时那张不计 empty(「未识别」≠「没做完」;同 wsOcrCands 既有 else if 口径),
             它也不进 stopped(stopped 只数它之后的张) */
          stopped = list.length - done; stop = "time";
          return Promise.resolve();
        } else {
          empty++;
        }
        return step();
      });
    });
  }
  return step().then(function () {
    return {
      blocks: blocks, done: done, empty: empty, stopped: stopped, stop: stop,
      aborted: aborted, ms: Date.now() - t0
    };
  });
}
/* PDF 文本按页切分:切页判据 = 行级分隔行 ^----- 第 N 页 -----$
   (与生成端 scripts/make-pdfjs-part.js 的 '----- 第 ' + n + ' 页 -----' 逐字一致;
    **不用** realText 的宽松正则 —— 那是「有没有文字」的判据,不是分隔符)
   -> [{ page, head, body }]
      · page = 分隔行里的页号(1-based);head = 分隔行原文(不含换行);body = 该页正文(末尾空白已去)
      · page = 0 的条目 = 没有页号的残余(首个分隔行之前的文本;整篇无分隔行时即全文)⇒ 不得丢 */
var PDF_PAGE_SEP_RE = /^----- 第 (\d+) 页 -----$/;
function pdfPageSplit(text) {
  var lines = String(text == null ? "" : text).split("\n");
  var out = [], cur = null, buf = [];
  /* cur 为 null 时缓冲的是「首个分隔行之前的残余」(page = 0),非空才落一条(纯空白不产生空块) */
  function flush() {
    var body = buf.join("\n").replace(/\s+$/, "");
    if (cur) out.push({ page: cur.page, head: cur.head, body: body });
    else if (body) out.push({ page: 0, head: "", body: body });
    buf = [];
  }
  for (var i = 0; i < lines.length; i++) {
    var m = PDF_PAGE_SEP_RE.exec(lines[i]);
    if (m) {
      flush();
      cur = { page: parseInt(m[1], 10) || 0, head: lines[i] };
      continue;
    }
    buf.push(lines[i]);
  }
  if (cur) flush();
  else if (lines.length) out.push({ page: 0, head: "", body: lines.join("\n").replace(/\s+$/, "") });
  return out;
}
/* 把「按页分好的 OCR 块」插到各页文本之后(块串由调用方渲染,本函数只管位置与顺序):
   pageText = extractText 的文本;blocksByPage = { 页号: [块串,…] };info(可选数组)= 未匹配页的注记落点。
   · 无块 ⇒ 原样返回(**逐字节**,不变量②)
   · 匹配不到页号的块 ⇒ 追加到文末、标题里注明(原页未在文本中找到),并往 info 记一条(不静默丢弃)
   · 空页(只有分隔行)照常输出分隔行 + 块;跨页截断的尾部留在最后那个页块的正文里(不丢) */
function docFusePages(pageText, blocksByPage, info) {
  var text = String(pageText == null ? "" : pageText);
  var pages = pdfPageSplit(text);
  var bag = blocksByPage || {};
  var used = {}, chunks = [], keys = [], added = 0, i, k, key;
  function asList(v) { return (typeof v === "string") ? [v] : (v || []); }
  function moved(block) {                                  /* 尾部追加件的标题改写 */
    var s = String(block == null ? "" : block), j = s.indexOf("】");
    return (j < 0) ? s : (s.slice(0, j) + "(原页未在文本中找到)" + s.slice(j));
  }
  for (i = 0; i < pages.length; i++) {
    var e = pages[i];
    var chunk = e.head ? (e.head + (e.body ? "\n" + e.body : "")) : e.body;
    var list = (e.page > 0 && bag[e.page]) ? asList(bag[e.page]) : null;
    if (list) {
      used[e.page] = true;
      for (k = 0; k < list.length; k++) {
        if (!list[k]) continue;
        chunk += "\n\n" + list[k];
        added++;
      }
    }
    chunks.push(chunk);
  }
  var orphan = [];
  for (key in bag) {
    if (!Object.prototype.hasOwnProperty.call(bag, key) || used[key]) continue;
    keys.push(key);
  }
  keys.sort(function (a, b) { return (parseInt(a, 10) || 0) - (parseInt(b, 10) || 0); });
  for (i = 0; i < keys.length; i++) {
    var arr = asList(bag[keys[i]]);
    for (k = 0; k < arr.length; k++) if (arr[k]) { orphan.push(moved(arr[k])); added++; }
  }
  if (!added) return text;
  var out = chunks.join("\n\n");
  if (orphan.length) {
    out += (out ? "\n\n" : "") + orphan.join("\n\n");
    if (info && typeof info.push === "function") {
      info.push("另有 " + orphan.length + " 块图片未匹配到页号,已追加到文末");
    }
  }
  return out;
}

/* ---- 附件侧「图文按序融合」(非视觉模型;与 Read 侧同一套助手)----
   与 Read 侧 wsFuseOcrText 的分工:那里贴的是「工具结果 + 状态行」,这里贴的是附件对象
   (`att.text` / `att.ocrImgs` / `att.degraded`),两者共用 ocrSeqCands / ocrBlockText /
   docFusePages 三个助手与同一套块格式,只有预算常量与注记落点不同。 */

/* 附件侧块渲染(与 Read 侧 wsFuseOcrText 同一口径):kind:"full"(整页兜底)的块头不带
   「· 本机 OCR」—— label 里已写明「整页图像 OCR(含文字层重复…)」;两类块头的唯一区别 */
function attOcrBlock(c, text) {
  return (c.kind === "full") ? ("【" + c.label + "】\n" + text) : ocrBlockText(c.label, text);
}
/* 逐张 OCR 并插块(附件侧入口)。text = 已有正文;items = 候选图 [{mime,data,label,page,kind}]
   (与 Read 侧同形;data 是 base64 裸串);layout = "pages"(PDF:按页插) | "flat"(office:正文之后按序接)。
   -> { text, ocrImgs, clipped, over, empty, stopped, stop, aborted, notes:[…] }
      · ocrImgs = 写入过非空块的张数(§2.5:未识别的另计,不计入 ocrImgs)
      · over = 超出单次张数预算没做的张数;stopped/stop = 时间或字符预算没做的张数
      · notes = 给 att.degraded 的注记(张数超限 / 预算用尽 / 未识别 / 引擎不可用),**不静默**;
        引擎不可用 ⇒ 只给注记、原文照旧(不伪造文本)
      · 融合后超 ATTACH_TEXT_MAX ⇒ 截断并置 clipped(沿用既有「已截断」标注) */
function attOcrFuse(text, items, layout) {
  var base = String(text == null ? "" : text);
  var all = items || [];
  var out = {
    text: base, ocrImgs: 0, clipped: false,
    over: Math.max(0, all.length - ATT_IMG_MAX_IMAGES),
    empty: 0, stopped: 0, stop: "", aborted: false, notes: []
  };
  var use = all.slice(0, ATT_IMG_MAX_IMAGES);
  if (!use.length) return Promise.resolve(out);
  if (!ocrReady()) {
    out.notes.push("本机 OCR 引擎不可用(" + ((window.OCRKit && window.OCRKit.why) || "缺少 Web Worker / WebAssembly") +
      "),图片内容无法读取(可换支持视觉的模型)");
    return Promise.resolve(out);
  }
  return ocrSeqCands(use, {
    deadline: Date.now() + ATT_OCR_TIMEOUT_MS,
    maxChars: ATTACH_TEXT_MAX,
    baseChars: base.length,
    prefixOf: function (c) { return (c.kind === "full") ? ("【" + c.label + "】\n") : ocrBlockHead(c.label); }
  }).then(function (res) {
    var blocks = res.blocks || [], rendered = [], byPage = {}, flat = [], i, k, s;
    for (i = 0; i < blocks.length; i++) {
      s = attOcrBlock(blocks[i], blocks[i].text);
      if (!s) continue;
      rendered.push(s);
      if (layout === "pages") {
        k = blocks[i].page || 0;
        if (!byPage[k]) byPage[k] = [];
        byPage[k].push(s);
      } else flat.push(s);
    }
    out.ocrImgs = rendered.length;
    out.empty = res.empty; out.stopped = res.stopped; out.stop = res.stop; out.aborted = res.aborted;
    if (layout === "pages") out.text = docFusePages(base, byPage, out.notes);
    else if (flat.length) out.text = base ? (base + "\n\n" + flat.join("\n\n")) : flat.join("\n\n");
    var nFull = 0, seenPage = {};
    if (layout === "pages") {
      for (i = 0; i < blocks.length; i++) {
        if (blocks[i].kind !== "full") continue;
        k = blocks[i].page || 0;
        if (seenPage[k]) continue;
        seenPage[k] = 1; nFull++;
      }
    }
    if (rendered.length) {
      out.notes.push("图片 " + rendered.length + " 张已本机 OCR 并" + (layout === "pages" ? "按页" : "按序") +
        "插入(当前模型不支持图像输入,OCR 可能有误差)");
    }
    if (nFull) out.notes.push("其中 " + nFull + " 页为整页图像 OCR(含文字层重复,可能有误差)");
    if (out.over > 0) out.notes.push("另有 " + out.over + " 图未处理(超出单次上限)");
    if (res.stopped > 0) {
      out.notes.push(res.stop === "chars"
        ? ("另有 " + res.stopped + " 图未处理(结果文本已达单次长度上限)")
        : ("另有 " + res.stopped + " 图未处理(本机 OCR 时间预算用尽)"));
    }
    if (res.empty > 0) out.notes.push(res.empty + " 图 OCR 未识别到文字");
    if (out.text.length > ATTACH_TEXT_MAX) {
      out.text = out.text.slice(0, ATTACH_TEXT_MAX);
      out.clipped = true;
      out.notes.push("融合后文本超过单次上限,已截断");
    }
    return out;
  });
}
/* 附件侧 PDF 取图计划(非视觉;法与 Read 侧 wsPdfImgCands 一致,常量换成附件侧口径):
   pageImages 报含图 ⇒ 每图一个候选;mode:"full" 的页用「远超整页的面积」触发 renderCrops 的
   整页护栏 ⇒ 该页退整页渲染;renderCrops 失败 ⇒ renderPages 整页兜底并注记(不静默、不假装成功)。
   扫描页数 = min(用户设置 pdfMaxPages(), READ_DOC_OCR_MAX_PAGES) —— 页数上限与 Read 侧同源,
   不另立副本。失败/无图 ⇒ list 为空(注记写进 notes)。
   **opts**(S3 新增)= { maxScan, maxImages }:附件侧三处调用点(②⑦/④ 与 ⑦视觉)一律传 attPdfOpts()
   ⇒ 同一组预算;不传(缺省)= 上面那组现状值 ⇒ 既有行为的调用点逐字节不变。 */
function attPdfImgCands(buf, notes, opts) {
  var oo = opts || {};
  var maxScan = (Number(oo.maxScan) > 0) ? Math.round(Number(oo.maxScan)) : Math.min(pdfMaxPages(), READ_DOC_OCR_MAX_PAGES);
  var maxImg = (Number(oo.maxImages) > 0) ? Math.round(Number(oo.maxImages)) : ATT_IMG_MAX_IMAGES;
  return window.PDFKit.pageImages(buf, {
    maxPages: maxScan, dpi: pdfDpi(), region: "rect", timeout: ATT_OCR_TIMEOUT_MS
  }).then(function (pr) {
    var out = { list: [], leftover: 0 };
    if (!pr || !pr.ok) {
      notes.push("图片检测失败(" + ((pr && pr.error) || "未知") + "),图片内容未读取");
      return out;
    }
    var pages = pr.pages || [], imgPages = [], i, j;
    for (i = 0; i < pages.length; i++) if (pages[i] && pages[i].hasImages) imgPages.push(pages[i]);
    if (!imgPages.length) return out;                    /* 纯文本/无图 ⇒ 不改动输出 */
    var unscanned = Math.max(0, (pr.pageCount || pages.length) - pages.length);
    if (unscanned > 0) notes.push("仅处理前 " + maxScan + " 页的图片(共 " + unscanned + " 页未扫描图片)");
    var groups = [], meta = [];
    for (i = 0; i < imgPages.length; i++) {
      var pg = imgPages[i];
      if (pg.mode === "rect" && pg.rects && pg.rects.length) {
        for (j = 0; j < pg.rects.length; j++) {
          groups.push({ page: pg.page, rect: pg.rects[j] });
          meta.push({ page: pg.page, kind: "rect", seq: j + 1 });
        }
      } else {
        groups.push({ page: pg.page, rect: { x: 0, y: 0, w: 1e7, h: 1e7 } });
        meta.push({ page: pg.page, kind: "full", seq: 1 });
      }
    }
    if (groups.length > maxImg) {                        /* 超出的张数如实报出(不静默丢) */
      out.leftover = groups.length - maxImg;
      groups = groups.slice(0, maxImg);
      meta = meta.slice(0, maxImg);
    }
    function mimeOf(u) { return (String(u || "").match(/^data:([^;,]+)/) || [])[1] || "image/jpeg"; }
    function fill(list) {
      out.list = [];
      for (var k = 0; k < list.length; k++) {
        var m = meta[k] || {}, full = (m.kind === "full");
        out.list.push({
          mime: mimeOf(list[k].dataUrl), data: dataUrlPayload(list[k].dataUrl || ""),
          label: full ? ("第 " + m.page + " 页 · 整页图像 OCR(含文字层重复,可能有误差)") : ("第 " + m.page + " 页 · 图 " + m.seq),
          page: m.page, kind: full ? "full" : "rect"
        });
      }
      return out;
    }
    return window.PDFKit.renderCrops(buf, {
      groups: groups, dpi: pdfDpi(), format: "image/jpeg", quality: 0.86, timeout: ATT_OCR_TIMEOUT_MS
    }).then(function (cr) {
      if (cr && cr.ok && cr.images && cr.images.length) return fill(cr.images);
      return pagesFallback((cr && cr.error) || "未知");
    }, function (e) { return pagesFallback((e && e.message) || String(e)); });
    function pagesFallback(why) {
      var need = {}, maxPage = 0, k;
      for (k = 0; k < meta.length; k++) { need[meta[k].page] = true; if (meta[k].page > maxPage) maxPage = meta[k].page; }
      return window.PDFKit.renderPages(buf, {
        dpi: pdfDpi(), maxPages: maxPage, format: "image/jpeg", quality: 0.86, timeout: ATT_OCR_TIMEOUT_MS
      }).then(function (rr) {
        if (!rr || !rr.ok || !rr.images || !rr.images.length) {
          notes.push("精确取区与整页渲染都失败(" + why + "),图片内容无法读取");
          return out;
        }
        notes.push("精确取区失败(" + why + "),已改用整页图像 OCR");
        var list = [], kk;
        for (kk = 0; kk < rr.images.length; kk++) if (rr.images[kk] && need[rr.images[kk].page]) list.push(rr.images[kk]);
        list.sort(function (a, b) { return (a.page || 0) - (b.page || 0); });
        meta = list.map(function (im) { return { page: im.page, kind: "full", seq: 1 }; });
        return fill(list);
      }, function (e) {
        notes.push("精确取区与整页渲染都失败(" + ((e && e.message) || String(e)) + "),图片内容无法读取");
        return out;
      });
    }
  }, function (e) {
    notes.push("图片检测失败(" + ((e && e.message) || String(e)) + "),图片内容未读取");
    return { list: [], leftover: 0 };
  });
}

/* ---- 办公文档附件(doc / docx / ppt / pptx / xls / xlsx)----
   解析全在本机内嵌的 OfficeKit 里完成(worker 优先,无 Worker 时降级主线程):
   docx 取文本 + 正文引用的图像;xlsx/xls 转多表 CSV(+ 表内图像);pptx 取文本 + 图像;
   doc/ppt 只取文本(老格式无纯 JS 图像方案,如实降级)。 */
/* 办公图片被跳过的一次性提示:按会话记(convId → 已提示过一次)。
   新会话 = 新键,遇到同样情况会照常提示;切回提示过的会话不再重复打扰 */
var officeVisionToastShown = {};
function isOfficeExt(ext) { return OFFICE_EXT.indexOf(ext) > -1; }
function isMacroExt(ext) { return MACRO_EXT.indexOf(ext) > -1; }
function officeReady() { return !!(window.OfficeKit && window.OfficeKit.available); }
/* 主线程降级模式的准入上限从 OfficeKit 的导出里读(单一来源 = officekit.src.js 的 MAIN_THREAD_CAP,
   经 limits.mainThreadSizeCap 暴露)——这里不再存同值副本:以前两处同值但无任何机制锁在一起,
   改一处就会静默不同步。worker 模式与普通附件同为 ATTACH_MAX_BYTES */
function officeSizeCap() {
  var ok = window.OfficeKit;
  if (ok && ok.mode === "main-thread" && ok.limits) return ok.limits.mainThreadSizeCap;
  return ATTACH_MAX_BYTES;
}
/* 附件 chip / 消息卡片 / 预览弹窗统一的摘要文案:
   DOCX · 7,040 字 · 2 图 ｜ PPTX · 9 页 · 1 图 ｜ PPT · 文本 4,676 字 ｜ XLSX · 9 表 · 1 图 */
function officeBrief(f) {
  if (!f) return "";
  var label = String(f.subtype || "").toUpperCase() || "办公文档";
  var out = [label];
  if (f.unit === "页" && f.pages) out.push(num(f.pages) + " 页");
  else if (f.unit === "表" && f.pages) out.push(num(f.pages) + " 表");
  else out.push("文本 " + num(f.textChars || (f.text ? String(f.text).length : 0)) + " 字");
  if (f.imgCount) out.push(num(f.imgCount) + " 图");
  /* 非视觉模型下图片不进消息、改为本机 OCR 后并入正文(见 resolveOffice);旧数据无 ocrImgs = 0 */
  if (f.ocrImgs) out.push(num(f.ocrImgs) + " 图已 OCR");
  if (f.clipped) out.push("已截断");
  return out.join(" · ");
}
function resolveOffice(file, ext, hooks) {
  if (!officeReady()) {
    return Promise.reject(new Error(file.name + ":办公文档解析库不可用(" +
      ((window.OfficeKit && window.OfficeKit.why) || "缺少必要能力") + ")"));
  }
  var sizeCap = officeSizeCap();
  if (file.size > sizeCap) {
    return Promise.reject(new Error(file.name + ":超过 " + fmtBytes(sizeCap) + " 上限,已跳过"
      + (sizeCap === ATTACH_MAX_BYTES ? "" : "(当前是主线程降级模式)")));
  }
  /* S6:走同一个枢纽(判定唯一来源);此刻还不知道有没有正文/图 ⇒ 用中性占位取「档 + 视觉」的形态 */
  var src = attachImgMode();
  var vision = visionState().vision;
  var cap = attachRenderCap("office", ext);
  var nonVis = (vision === false);
  var sub = String(ext == null ? "" : ext).toLowerCase();
  var pre = decideAttachPlan({
    kind: "office", subtype: ext, srcMode: src, vision: vision,
    hasText: true, imgCount: 0, hasTextLayer: true, cap: cap
  });
  /* S6c:docx 位置锚 —— 只在「图可能随消息发出」的形态下向 worker 要 HTML(纯文本档 / 非视觉 OCR
     不要:要了也不锚,还白跨线程搬 HTML)。后续 docx 分支据此决定"锚 / 回退 + 注记"。 */
  var wantAnchor = (sub === "docx") && !nonVis && (pre.images === "send" || src === "image");
  /* OCR 候选的 label 与布局(O2):pptx 认得出真幻灯号 ⇒ "pages"(按幻灯插块),否则 "flat";
     label 按工具侧口径 `第 N 页 · 图 k`;认不出页号(page===0)⇒ 整篇序号 `图 k` + 一次性注记 */
  function officeCands(list) {
    return list.map(function (im, i) {
      var pg = Number(im.page) || 0;
      return {
        mime: im.mime, data: im.data, page: pg, kind: "",
        label: pg ? ("第 " + pg + " 页 · 图 " + (i + 1)) : (im.label || ("图 " + (i + 1)))
      };
    });
  }
  function officeLayoutOf(list) {
    if (String(ext || "").toLowerCase() !== "pptx") return "flat";
    for (var i = 0; i < list.length; i++) if (Number(list[i].page) > 0) return "pages";
    return "flat";
  }
  /* pptx 有图认不出幻灯号(page===0)时的一次性注记(O2,与工具侧 appE 的口径同源) */
  function officePageZeroNote(list) {
    var n = 0, i;
    for (i = 0; i < list.length; i++) if (!Number(list[i].page)) n++;
    return n ? ("有 " + n + " 张图认不出所属幻灯,已按整篇顺序编号") : "";
  }
  function plainImgs(list) {
    return list.map(function (im) {
      return { mime: im.mime, data: im.data, bytes: im.bytes, label: im.label, page: im.page };
    });
  }
  /* S6c:注记去重(多条同句只留一条)后按既有口径 " · " 连接(锚回退 / 图→表映射的如实交代) */
  function joinNotes(list) {
    var outN = [], seenN = {}, i, s;
    for (i = 0; i < list.length; i++) {
      s = String(list[i] == null ? "" : list[i]);
      if (s && !seenN[s]) { seenN[s] = 1; outN.push(s); }
    }
    return outN.join(" · ");
  }
  var onProgress = hooks && hooks.onProgress;
  /* S7:docx 图片档的渲染分支(方案 §2.4「前置链结果判别」)。渲染成功 ⇒ 直接产出「图片档」att
     (只发页图、不带正文 —— 与 PDF 图片档同形);失败 ⇒ 两支注记串交给既有链消费(见下两处注入点)。
     注记串在 .then 之前声明、跨链共享;**不许**用 `return null` 表达"落回既有链"(那会终止整个回调)。 */
  var bufRef = null;
  var renderFailNote = "", renderFailNote2 = "";
  var isDocxImg = (pre.send === "image" && pre.render === "pages" && sub === "docx");
  return readAs(file, "buffer").then(function (buf) {
    bufRef = buf;
    return window.OfficeKit.parse(buf, ext, {
      timeout: (window.OfficeKit.limits && window.OfficeKit.limits.timeoutMs) || 60000,
      onProgress: onProgress,
      docxAnchor: wantAnchor          /* S6c:docx 位置锚要 HTML(其余格式 / 档位不要) */
    });
  }).then(function (r) {
    if (!r || !r.ok) throw new Error(file.name + ":" + ((r && r.error) || "解析失败"));
    if (!isDocxImg) { return { r: r }; }          /* 非「docx 图片档 + 视觉可用」⇒ 既有链照走 */
    return attachRenderPageImages(file, "docx", bufRef, { onProgress: onProgress }).then(function (rp) {
      if (rp.ok && rp.images.length) {
        if (rp.notes.length) { toast(rp.notes[0], "info", 4200); }   /* 一次性;注记全文在 degraded */
        return { att: {
          id: uid(), kind: "office", subtype: (r.subtype || ext), name: file.name, size: file.size,
          mime: "", mode: "image", srcMode: src, renderSrc: "pages",
          text: "", textChars: 0, images: rp.images, imgCount: rp.images.length,
          pages: rp.pages, unit: "页", clipped: !!rp.clipped,
          skippedImgs: r.skippedImgs || 0, degraded: rp.notes.join(" · ")
        } };
      }
      var rpWhy = rp.error || "未知";
      renderFailNote = "本机渲染失败(" + rpWhy + "),已改用「混合」:发送文档内嵌图";
      renderFailNote2 = "本机渲染失败(" + rpWhy + "),已改用「纯文本」:只发送文字";
      return { r: r };                            /* 没有早退产物 ⇒ 既有链照走(注记按下两处注入) */
    });
  }).then(function (pass) {
    if (pass.att) { return pass.att; }            /* 渲染成功 ⇒ 到此为止 */
    var r = pass.r;
    var rawImgs = r.images || [];
    var text = String(r.text || "").trim();
    var notes = [];      /* S6c:锚 / 映射的如实注记(去重后并入 att.degraded;不静默) */
    /* docx 位置锚(S6c;D1/D2):worker 带回的 HTML 按文档序生成 `【图 k】` 标记(自检与两条守卫都
       在 attachDocxAnchorText 内完成)。通过 ⇒ att.text = 标记正文;不过 / 被截断 ⇒ 回退 flat + 注记 */
    if (wantAnchor && !r.clipped && r.docxHtml && rawImgs.length) {
      var anchored = attachDocxAnchorText(r.docxHtml, r.text, rawImgs.length);
      if (anchored !== null) { text = anchored; }
      else { notes.push("图未能在正文里定位,已按原顺序附在文本之前"); }
    }
    /* S6b(D12):xlsx/xls 的「图片档」= **本机自绘表格图**(canvas,零新库)—— 图源按枢纽产物取,
       且**先于内嵌图判定**:混合档/升档一律仍用文档内嵌图(自绘图只在图片档出现,免得与 CSV 文本重复计费) */
    var drawn = null;
    if (text && pre.send === "image" && pre.render === "drawn") {
      /* scale=2:自绘按 2× 出图(单元格字体 13px ⇒ 26px)。方案 §9 把"自绘图可读性"列为 S6b 首跑必验项:
         1× 时单元格字高只有 ~13px,本机 OCR 与视觉模型都读不稳(批-4 真机读数在案);2× 后暗号稳定可读,
         体积仍远低于 R11 的 imgMaxSide()/1 MiB 双上限。 */
      drawn = attachDrawSheetImages(text, { maxSheets: ATT_IMG_MAX_IMAGES, scale: 2 });   /* 张数上限与 PDF 同源 */
      if (!drawn.ok) throw new Error(file.name + ":表格图绘制失败(" + (drawn.error || "未知") + ")");
    }
    var wantsImgs = (pre.images === "send") && !drawn;      /* 视觉可用 + 不是「纯文本」档 ⇒ 图随消息发送 */
    /* S6c:xlsx/xls 的「图 → 表」归属(唯一接线点;D3)—— 认不出表名 ⇒ page=0 ⇒ 落 rest(文末)+ 注记 */
    var sheetMap = null;
    if (wantsImgs && (sub === "xlsx" || sub === "xls") && rawImgs.length) {
      sheetMap = attachSheetImgPages(text, rawImgs);
      for (var ni = 0; ni < sheetMap.notes.length; ni++) { notes.push(sheetMap.notes[ni]); }
    }
    var images = drawn ? drawn.images : (wantsImgs ? (sheetMap ? sheetMap.images : plainImgs(rawImgs)) : []);
    var att = {
      id: uid(), kind: "office", subtype: r.subtype || ext, name: file.name, size: file.size, mime: "",
      mode: drawn ? "image" : (images.length ? "both" : "text"), srcMode: src,
      renderSrc: drawn ? "drawn" : (images.length ? "embedded" : ""),
      text: text, textChars: r.textChars || text.length, clipped: !!r.clipped,
      images: images, imgCount: images.length,
      skippedImgs: r.skippedImgs || 0,
      pages: r.pages || 0, unit: r.unit || ""
    };
    if (notes.length) { att.degraded = joinNotes(notes); }
    if (drawn) {
      /* R11 + §2.7-①:自绘表格图必须自报口径 —— 「数据网格」声明 + 行/列/表数截断注记(截断必须可见) */
      att.degraded = ["本机绘制的表格图(仅数据网格,不含原表格式)"].concat(drawn.notes).join(" · ");
    }
    /* O3(条件化):只有「本机解析器确实没从老格式里收到图」才写这句 —— 否则就是谎报(D8 实测:有图时该句自然不出现) */
    if ((att.subtype === "doc" || att.subtype === "ppt") && !rawImgs.length) {
      att.degraded = "本机解析器未从老格式(." + att.subtype + ")里提取到图片";
    }
    /* O6:图片档被降级时的如实交代(§2.7-①)。判据 = **用户选了「图片」档但图没随消息发出**;
       解析后按**真实 imgCount** 复查一次枢纽,再**逐支消费**它的产物(P1-2:只消费 "send" 会把
       非视觉下的 "ocr" 漏掉 ⇒ 内嵌图既不发也不 OCR = 内容丢) */
    if (src === "image" && !images.length) {
      var post = decideAttachPlan({
        kind: "office", subtype: ext, srcMode: src, vision: vision,
        hasText: true, imgCount: rawImgs.length, hasTextLayer: true, cap: cap
      });
      if (post.images === "ocr" && rawImgs.length) {
        /* 降级后仍要**本机 OCR 兜底**(与 O1-① 同一融合腿与注记口径) */
        return attOcrFuse(att.text || "", officeCands(rawImgs), officeLayoutOf(rawImgs)).then(function (fz) {
          att.text = fz.text;
          att.textChars = fz.text.length;
          att.ocrImgs = fz.ocrImgs;
          if (fz.clipped) att.clipped = true;
          var dn6 = fz.notes.slice(0);
          if (post.toast) dn6.push(post.toast);
          var n6 = officePageZeroNote(rawImgs);
          if (n6) dn6.push(n6);
          if (!dn6.length) dn6.push("当前模型不支持图像输入,图片未随消息发送");
          att.degraded = att.degraded ? (att.degraded + " · " + dn6.join(" · ")) : dn6.join(" · ");
          toast(post.toast || "当前模型不支持图像输入,图片内容已改用本机 OCR 提取", "info", 4200);
          return att;
        });
      }
      if (post.images === "send" && rawImgs.length) {
        att.images = plainImgs(rawImgs);
        att.imgCount = att.images.length;
        att.mode = "both";
        att.renderSrc = "embedded";
      }
      var why6 = (cap === "drawn") ? "" : post.toast;
      /* cap="drawn"(xlsx/xls)走到这里只剩一种情形:没有可绘制的表(文字为空)⇒ 下面立刻按空文档拒收。
         此时**不能**说「没有可信的离线渲染器」(xlsx/xls 的渲染器就是本机 canvas,已在上面的
         drawn 分支落地)⇒ 该子例不发降级 toast,由拒收文案自己说话。 */
      if (why6) { toast(why6, "info", 4200); att.degraded = att.degraded ? (att.degraded + " · " + why6) : why6; }
    }
    /* S7:docx 页图渲染失败的两支回退注记(必须落在这条**共同出口**上,不得依赖上面的 O6 块:
       cap="pages" 时 pre.images==="send" ⇒ 内嵌图在 O6 复查**之前**就已随 wantsImgs 落进 images
       ⇒ `!images.length` 恒假 ⇒ O6 块根本不进 —— 而"静默降级"恰好会藏在那里)。
       · 有内嵌图(images 已就位)⇒ 实际落「混合(内嵌图)」⇒ 注记 renderFailNote;
       · 无内嵌图 + 有正文 ⇒ 实际落「纯文本」⇒ 注记 renderFailNote2。两支都不得静默。 */
    if (renderFailNote && images.length) {
      att.degraded = att.degraded ? (att.degraded + " · " + renderFailNote) : renderFailNote;
      toast(renderFailNote, "info", 4200);
    } else if (renderFailNote2 && !rawImgs.length && text) {
      att.degraded = att.degraded ? (att.degraded + " · " + renderFailNote2) : renderFailNote2;
      toast(renderFailNote2, "info", 4200);
    }
    /* O1 三分支(判据与视觉态**解耦**):禁止再用"当前模型不支持图像输入"解释"没有正文" */
    if (!text && !rawImgs.length) {
      throw new Error(file.name + ":没有提取到可发送的内容(空文档)");
    }
    if (!text && rawImgs.length) {
      if (!nonVis) {
        /* ② 视觉可用 ⇒ 升档发图(用户选 image 档时本来就发图 ⇒ 不触发本条) */
        att.images = plainImgs(rawImgs);
        att.imgCount = att.images.length;
        att.mode = "both";
        att.renderSrc = "embedded";
        var note2 = "这份" + attachKindWord(att) + "只有图片,已按图片发送";
        toast(note2, "info", 4200);
        att.degraded = att.degraded ? (att.degraded + " · " + note2) : note2;
        return att;
      }
      /* ① 非视觉 ⇒ 本机 OCR 兜底;融合后仍空**才**拒收(文案只说 OCR 没认出) */
      return attOcrFuse("", officeCands(rawImgs), officeLayoutOf(rawImgs)).then(function (fz) {
        if (!String(fz.text || "").trim()) {
          throw new Error(file.name + ":这份文档只有图片,且本机 OCR 没有识别到文字");
        }
        att.text = fz.text;
        att.textChars = fz.text.length;
        att.ocrImgs = fz.ocrImgs;
        if (fz.clipped) att.clipped = true;
        var dn = fz.notes.slice(0);
        dn.push(pre.toast || "这份文档只有图片,图片内容已改用本机 OCR 提取(原图未发送)");
        var n0 = officePageZeroNote(rawImgs);
        if (n0) dn.push(n0);
        att.degraded = att.degraded ? (att.degraded + " · " + dn.join(" · ")) : dn.join(" · ");
        return att;
      });
    }
    /* 非视觉 + 有正文 + 有图 ⇒ 图不进消息,改用本机 OCR 按原序并入正文(toast 按会话一次;解析进度走 onProgress)*/
    if (pre.images === "ocr" && rawImgs.length && text) {
      var ocid = (conv && conv.id) ? String(conv.id) : "";
      if (!Object.prototype.hasOwnProperty.call(officeVisionToastShown, ocid)) {
        officeVisionToastShown[ocid] = true;
        toast(pre.toast || ("当前模型不支持图像输入,正在用本机 OCR 识别「" + file.name + "」里的图片…"), "info", 3600);
      }
      return attOcrFuse(text, officeCands(rawImgs), officeLayoutOf(rawImgs)).then(function (fz) {
        att.text = fz.text;
        att.textChars = fz.text.length;
        att.ocrImgs = fz.ocrImgs;
        if (fz.clipped) att.clipped = true;
        var dn2 = fz.notes.slice(0);
        if (pre.toast) dn2.push(pre.toast);
        var n1 = officePageZeroNote(rawImgs);
        if (n1) dn2.push(n1);
        if (!dn2.length) dn2.push("当前模型不支持图像输入,图片未随消息发送");
        att.degraded = att.degraded ? (att.degraded + " · " + dn2.join(" · ")) : dn2.join(" · ");
        return att;
      });
    }
    /* 纯文本档把图挡下(§2.5 的 P1-1):用户**显式**选了「纯文本」⇒ 不发图、也不用 OCR 兜底 */
    if (src === "text" && rawImgs.length && !images.length && !nonVis) {
      var note3 = "已按「纯文本」档发送:图片未随消息发送";
      att.degraded = att.degraded ? (att.degraded + " · " + note3) : note3;
    }
    return att;
  });
}


function prepareAttachment(file, hooks) {
  return new Promise(function (resolve, reject) {
    if (!file) { reject(new Error("无效文件")); return; }
    if (file.size > ATTACH_MAX_BYTES) {
      reject(new Error(file.name + ":超过 " + fmtBytes(ATTACH_MAX_BYTES) + " 上限,已跳过")); return;
    }
    if (!file.size) { reject(new Error(file.name + ":空文件,已跳过")); return; }
    var ext = extOf(file.name);
    var mime = (file.type || "").toLowerCase();
    if (/^image\//.test(mime) || IMAGE_EXT.indexOf(ext) > -1) {
      resolveImage(file, ext, mimeOfImage(file, ext)).then(resolve, reject);
      return;
    }
    if (mime === "application/pdf" || ext === "pdf") { resolvePdf(file).then(resolve, reject); return; }
    if (isOfficeExt(ext)) { resolveOffice(file, ext, hooks).then(resolve, reject); return; }
    if (isMacroExt(ext)) {
      reject(new Error(file.name + ":暂不支持宏格式(." + ext + "),请另存为 .docx / .xlsx / .pptx 后重试"));
      return;
    }
    if (isBlockedExt(ext)) {
      reject(new Error(file.name + ":不支持 ." + ext + " 这类文件,只接受纯文本 / 图片 / PDF / 办公文档(doc/docx/ppt/pptx/xls/xlsx)"));
      return;
    }
    /* 其余(纯文本后缀 / 无后缀 / 未知后缀):一律交给共享内容探针判定。
       后缀与 mime 只是提示(wsProbeTextHint),不再"先认定是文本"也不再看乱码 ——
       GBK/GB18030、UTF-16 的文本会被正确解码;判不出文本的按二进制拒收并报出类型。 */
    wsProbeBlob(file, file.name, mime).then(function (probe) {
      if (probe.kind !== "text") {
        reject(new Error(file.name + ":" + attachTextRejectText(probe)));
        return;
      }
      if (probe.lossyHint) {
        reject(new Error(file.name + ":文本编码无法在本机解码(缺少对应的解码器),请先转成 UTF-8 后重试"));
        return;
      }
      return wsDecodeTextBlob(file, probe.enc || "utf-8", { strict: false }).then(function (dr) {
        if (!dr || !dr.ok) {
          reject(new Error(file.name + ":按 " + wsEncName(probe.enc) + " 解码失败,请先转成 UTF-8 后重试"));
          return;
        }
        var text = String(dr.text == null ? "" : dr.text);
        /* 探针只采样首 8 KB + 末 512 B:窗外的 NUL 会在解码后露出来 ⇒ 与 Read 的消费侧守卫同口径,
           仍按二进制拒收(旧实现同样会拒,别让这类文件变成"带 NUL 的乱码正文"发给模型) */
        if (text.indexOf("\u0000") > -1) {
          reject(new Error(file.name + ":采样窗之外仍含 NUL 字节,按二进制处理,无法作为文本读取"));
          return;
        }
        if (!text) { reject(new Error(file.name + ":内容为空")); return; }
        var clipped = text.length > ATTACH_TEXT_MAX;
        var att = {
          id: uid(), kind: "text", name: file.name, size: file.size,
          text: clipped ? text.slice(0, ATTACH_TEXT_MAX) : text, clipped: clipped
        };
        /* 编码注记:只对非 UTF-8 记(旧数据没有这个字段 = 按 UTF-8,无需迁移、不动 IDB 结构) */
        if (probe.enc && probe.enc !== "utf-8") att.enc = probe.enc;
        resolve(att);
      });
    }).then(undefined, function (e) {
      reject(e && e.message ? e : new Error(file.name + ":读取失败(" + ((e && e.message) || e) + ")"));
    });
  });
}
/* 附件文本分支的拒收文案:类型取自共享探针(probe.type 是给人看的中文串:PNG 图片 / ZIP 压缩包…),
   再给三条出路(与工作区 Read 的 EBINARY 同口径) */
function attachTextRejectText(probe) {
  var t = (probe && probe.type) || "未知二进制";
  return "无法作为文本读取(检测到" + t + "),只接受纯文本 / 图片 / PDF / 办公文档;" +
    "内容确实是文本的文件请另存为 .txt / .md 后重试,或先转成 UTF-8";
}
function attachSizeOf(a) {
  if (!a) return 0;
  if (a.kind === "image") return String(a.data || "").length;
  if (a.kind === "pdf") {
    if (a.mode === "image" || a.mode === "both") {        /* 图发出去 ⇒ 正文 + Σ图(方案 §2.6) */
      var n = String(a.text || "").length;
      (a.images || []).forEach(function (im) { n += String(im.data || "").length; });
      return n;
    }
    return String(a.text || "").length;
  }
  if (a.kind === "office") {
    var m = String(a.text || "").length;
    (a.images || []).forEach(function (im) { m += String(im.data || "").length; });
    return m;
  }
  return String(a.text || "").length;
}
function draftAttachBytes() {
  var n = 0;
  draftFiles.forEach(function (f) { n += attachSizeOf(f); });
  return n;
}
/* 附件按 token 粗算:文本走四桶估算,一张图 ≈900,PDF / 办公文档的图片模式按张数累加
   (混合档同理:文字 + 900×张数;`drawn` 的自绘表格图也走同一条 900/张,方案 §3-S4) */
function draftAttachTokens(f) {
  if (!f) return 0;
  if (f.kind === "text") return estimateTokens(f.text);
  if (f.kind === "pdf" && f.mode === "image") return 900 * ((f.images && f.images.length) || 1);
  if (f.kind === "office" && f.mode === "image") return 900 * ((f.images && f.images.length) || 1);   /* S6b:自绘表格图同口径 */
  if (f.kind === "pdf" && f.mode === "both") {
    return estimateTokens(f.text) + 900 * ((f.images && f.images.length) || 0);
  }
  if (f.kind === "office" && f.mode === "both") {
    return estimateTokens(f.text) + 900 * ((f.images && f.images.length) || 1);
  }
  if (f.kind === "pdf" || f.kind === "office") return estimateTokens(f.text);
  return 900;
}
/* 预览弹窗的 token 读数与草稿环 / 上下文用量浮层**同一口径**(上一段那个函数):
   图片模式下正文是空的,只对 text 估算会显示「约 0 tokens」,与浮层里的 ≈N×900 自相矛盾。
   这里把正文补进对象再走同一个函数 —— 900/页 的算法全库只有一份 */
function previewAttachTokens(f, text) {
  var t = (text == null) ? "" : String(text);
  if (!f || !f.kind) return estimateTokens(t);
  if (typeof f.text === "string") return draftAttachTokens(f);
  var o = {};
  for (var k in f) { if (Object.prototype.hasOwnProperty.call(f, k)) o[k] = f[k]; }
  o.text = t;
  return draftAttachTokens(o);
}
/* 办公文档解析中的占位(解析耗时可感知,先给一个可移除的「解析中」chip;
   占位不进 draftFiles,既有预算 / 排序逻辑零改动) */
var pendingOffice = [];
function pendingOfficeRemove(ph) {
  var i = pendingOffice.indexOf(ph);
  if (i > -1) pendingOffice.splice(i, 1);
  ph.cancelled = true;
  if (window.OfficeKit && window.OfficeKit.cancelCurrent) window.OfficeKit.cancelCurrent();
  renderAttachBar();
}
/* 清空输入区草稿:文字 + 已解析的附件 + 还在解析中的占位。
   占位必须连带取消解析 —— 只清 draftFiles 的话,解析完成回调会把它推进新会话的附件条
   (「新建对话」把上一轮的附件带进新会话,就是这么发生的)。
   发送路径不受影响:doSend/sendMessage 先取走 draftFiles 再建会话(newConversation({keepDraft:true})) */
function clearDraft() {
  elInput.value = "";
  draftFiles = [];
  while (pendingOffice.length) pendingOfficeRemove(pendingOffice[0]);
  autoResize();
  renderAttachBar();
  updateCtxMeter();
}
var OFFICE_PHASE_TEXT = {
  started: "开始解析…", extracting: "提取内容…", parsing: "解析中…", rendering: "渲染页面…", done: "即将完成…"
};
function addFiles(fileList) {
  var files = Array.prototype.slice.call(fileList || []);
  if (!files.length) return;
  /* 「解析中」的办公文件已经占了 chip 位(见 renderAttachBar 的 N / 10 计数),
     这里必须把 pendingOffice 一起减掉,否则连拖两次就能挂超过 10 个 */
  var room = MAX_DRAFT_FILES - draftFiles.length - pendingOffice.length;
  if (room <= 0) {
    toast("一条消息最多放 " + MAX_DRAFT_FILES + " 个附件,请先发送或移除一些", "warn", 3600);
    return;
  }
  var skipped = 0;
  if (files.length > room) { skipped = files.length - room; files = files.slice(0, room); }
  var errs = [];
  /* 按输入顺序占位:prepareAttachment 是异步的,谁先完成不确定 ——
     直接 push 会让「一次拖进来的多个附件」顺序随机(图文交错就乱了) */
  var results = new Array(files.length);
  var tasks = files.map(function (f, i) {
    var ext = extOf(f.name);
    if (!isOfficeExt(ext)) {
      return prepareAttachment(f).then(function (a) { results[i] = a; },
        function (e) { results[i] = null; errs.push(e.message || String(e)); });
    }
    var ph = { name: f.name, size: f.size, phase: "started", cancelled: false };
    pendingOffice.push(ph);
    renderAttachBar();
    var hooks = { onProgress: function (phase) { ph.phase = phase; renderAttachBar(); } };
    return prepareAttachment(f, hooks).then(function (a) {
      var k = pendingOffice.indexOf(ph);
      if (k > -1) pendingOffice.splice(k, 1);
      if (!ph.cancelled) results[i] = a;
      renderAttachBar();
    }, function (e) {
      var k = pendingOffice.indexOf(ph);
      if (k > -1) pendingOffice.splice(k, 1);
      results[i] = null;
      if (!ph.cancelled) errs.push(e.message || String(e));
      renderAttachBar();
    });
  });
  Promise.all(tasks).then(function () {
    var used = draftAttachBytes(), added = 0, any = false;
    for (var i = 0; i < results.length; i++) {
      var a = results[i];
      if (!a) continue;
      /* 回收循环不再敢信上游的 room:两次 addFiles 交错时(前一次的解析还没完),
         只有在这里兜底判一次,才能保证真的不超过 10 个 */
      if (draftFiles.length >= MAX_DRAFT_FILES) {
        errs.push(a.name + ":一条消息最多放 " + MAX_DRAFT_FILES + " 个附件,已跳过");
        continue;
      }
      var budget = attachMsgMaxBytes();
      if (used + added + attachSizeOf(a) > budget) {
        errs.push(a.name + ":超过单条消息 " + fmtBytes(budget) + " 的附件总量上限(可在 设置 → 附件 里调大)");
        continue;
      }
      added += attachSizeOf(a);
      draftFiles.push(a);
      any = true;
    }
    if (any) { renderAttachBar(); updateCtxMeter(); }
    if (skipped) errs.push("一次最多 " + MAX_DRAFT_FILES + " 个附件," + skipped + " 个未加入");
    if (errs.length) toast(errs.slice(0, 3).join("\n"), "error", 5200);
  });
}

/* ---- 附件条的拖拽排序(HTML5 DnD,桌面端;触屏用不到也无妨) ---- */
var attachDragFrom = -1;
function bindAttachDrag(chip, i) {
  chip.addEventListener("dragstart", function (e) {
    attachDragFrom = i;
    chip.classList.add("dragging");
    if (e.dataTransfer) {
      try { e.dataTransfer.effectAllowed = "move"; e.dataTransfer.setData("text/plain", String(i)); } catch (er) {}
    }
  });
  chip.addEventListener("dragend", function () {
    attachDragFrom = -1;
    var all = $("attach-bar").children;
    for (var k = 0; k < all.length; k++) {
      all[k].className = all[k].className.replace(/\s*(dragging|drag-over)/g, "");
    }
  });
  chip.addEventListener("dragover", function (e) {
    if (attachDragFrom < 0) return;
    e.preventDefault();
    e.stopPropagation();
    if (e.dataTransfer) { try { e.dataTransfer.dropEffect = "move"; } catch (er) {} }
    chip.classList.add("drag-over");
  });
  chip.addEventListener("dragleave", function () { chip.classList.remove("drag-over"); });
  chip.addEventListener("drop", function (e) {
    if (attachDragFrom < 0) return;
    e.preventDefault();
    e.stopPropagation();
    var from = attachDragFrom;
    attachDragFrom = -1;
    if (from === i || from < 0 || from >= draftFiles.length) { renderAttachBar(); return; }
    var item = draftFiles.splice(from, 1)[0];
    draftFiles.splice(i, 0, item);
    renderAttachBar();
    updateCtxMeter();
  });
}
function renderAttachBar() {
  var bar = $("attach-bar");
  if (!bar) return;
  while (bar.firstChild) bar.removeChild(bar.firstChild);
  bar.classList.toggle("has-files", draftFiles.length > 0 || pendingOffice.length > 0);
  pendingOffice.forEach(function (ph) {
    var chip = document.createElement("div");
    chip.className = "attach-chip pending";
    chip.title = "正在本机解析,点 × 可取消并移除";
    chip.innerHTML = '<span class="ac-ico">' + icon("file", "sm") + "</span>" +
      '<span class="ac-main"><span class="ac-name" title="' + escAttr(ph.name) + '">' + escapeHtml(ph.name) + "</span>" +
      '<span class="ac-sub">' + escapeHtml((String(ph.name).split(".").pop() || "").toUpperCase()
        + " · " + (OFFICE_PHASE_TEXT[ph.phase] || "解析中…")) + "</span></span>" +
      '<button class="ac-rm" title="取消并移除" aria-label="取消解析">' + icon("x", "sm") + "</button>";
    chip.querySelector(".ac-rm").addEventListener("click", function (e) {
      e.stopPropagation();
      pendingOfficeRemove(ph);
    });
    bar.appendChild(chip);
  });
  draftFiles.forEach(function (f, i) {
    var chip = document.createElement("div");
    chip.className = "attach-chip" + (f.kind === "image" ? " is-img" : "");
    chip.setAttribute("data-idx", String(i));
    chip.setAttribute("draggable", "true");
    chip.title = "点击预览 · 拖动可调整顺序";
    var ico = f.kind === "image"
      ? '<img src="data:' + f.mime + ";base64," + f.data + '" alt="" />'
      : '<span class="ac-ico">' + icon(f.kind === "pdf" ? "file" : "file", "sm") + "</span>";
    var sub = f.kind === "image"
      ? ((f.w && f.h) ? f.w + "×" + f.h : "图片") + (f.scaled ? " · 已缩放" : "")
      : f.kind === "pdf"
        ? "PDF · " + (f.pages || 1) + " 页 · " + attachModeLabel(f) +
          (f.ocrImgs ? " · " + f.ocrImgs + " 图已 OCR" : "")
        : f.kind === "office"
          ? officeBrief(f) + " · " + attachModeLabel(f) + (f.degraded ? " · " + f.degraded : "")
          : fmtBytes(f.size) + (f.enc ? " · " + wsEncName(f.enc) + "(已转码显示)" : "") +
            (f.clipped ? " · 已截断" : "");
    if (f.ocr) sub += " · OCR";
    chip.innerHTML = ico +
      '<span class="ac-main"><span class="ac-name" title="' + escAttr(f.name) + '">' + escapeHtml(f.name) + "</span>" +
      '<span class="ac-sub">' + escapeHtml(sub) + "</span></span>" +
      '<button class="ac-rm" title="移除" aria-label="移除附件">' + icon("x", "sm") + "</button>";
    chip.querySelector(".ac-rm").addEventListener("click", function (e) {
      e.stopPropagation();
      draftFiles.splice(i, 1);
      renderAttachBar();
      updateCtxMeter();
    });
    chip.addEventListener("click", function () { previewAttachment(f); });
    bindAttachDrag(chip, i);
    bar.appendChild(chip);
  });
  /* 末尾跟一个「N / 10」计数,提示还能放几个 */
  if (draftFiles.length || pendingOffice.length) {
    var cnt = document.createElement("span");
    cnt.className = "attach-count";
    cnt.textContent = (draftFiles.length + pendingOffice.length) + " / " + MAX_DRAFT_FILES;
    cnt.title = "最多 " + MAX_DRAFT_FILES + " 个附件 · 单条消息总量上限 " + fmtBytes(attachMsgMaxBytes());
    bar.appendChild(cnt);
  }
}
/* 附件预览:图片走灯箱,文本 / PDF / 办公文档走弹窗(弹窗只能点 ✕ 关) */
function previewAttachment(f) {
  if (!f) return;
  if (f.kind === "image") { openLightbox("data:" + f.mime + ";base64," + f.data, f.name); return; }
  if ((f.kind === "pdf" || f.kind === "office") && f.images && f.images.length) {
    openFilePreview(f.name, f.text || "", f);
    return;
  }
  openFilePreview(f.name, f.text || "", f);
}

/* ---- 一轮用户消息的协议组装:文件/图片在前,问题在后 ---- */
function attachMetaOf(f) {
  var m = {
    id: f.id, kind: f.kind, name: f.name, size: f.size, mime: f.mime || "",
    pages: f.pages || 0, clipped: !!f.clipped, w: f.w || 0, h: f.h || 0,
    mode: f.mode || "", ocrOnly: f.ocr ? 1 : 0, ocrText: f.ocr || "",
    subtype: f.subtype || "", unit: f.unit || "", imgCount: f.imgCount || 0,
    skippedImgs: f.skippedImgs || 0, degraded: f.degraded || "", textChars: f.textChars || 0,
    /* 非视觉模型下已本机 OCR 并入正文的图片张数(旧数据没有这个键 = 0,无需迁移) */
    ocrImgs: f.ocrImgs || 0,
    /* 用户所选档与"这次图从哪来"(方案 §2.9;旧数据无 ⇒ 空串,读取侧一律回退 mode)。
       只进气泡展示元数据 —— protocolContent 会把 attach 整块剥掉,请求体不受影响 */
    srcMode: f.srcMode || "", renderSrc: f.renderSrc || "",
    enc: f.enc || ""        /* 非 UTF-8 文本附件的原始编码(旧数据为空 = 按 UTF-8) */
  };
  if (f.ext) m.blob = f.id;      // payload 在 IndexedDB 里,消息里只留这个键
  return m;
}
/* data 为空字符串表示 payload 已经外置到 IndexedDB(attach.blob 是它的键),
   渲染与发送时再从内存缓存/IndexedDB 取回来 —— 消息本体(存 localStorage 的那份)就很小了 */
function imagePartFor(proto, mime, data, attach) {
  var p = proto === "anthropic"
    ? { type: "image", source: { type: "base64", media_type: mime || "image/png", data: data || "" } }
    : { type: "image_url", image_url: { url: data ? ("data:" + (mime || "image/png") + ";base64," + data) : "" } };
  if (attach) p.attach = attach;
  return p;
}
/* 交错锚类型(方案 §2.6 的唯一映射表):pdf / pptx ⇒ 页分隔行 · xlsx/xls ⇒ `# <表名>` ·
   docx ⇒ 正文里真的有 `【图 k】` 标记(D7 位置锚自检通过后才会写出这种文本)时才算有锚 ·
   其余(.doc/.ppt/认不出)⇒ none(调用方保持既有"图在前、文本在后"形态)。
   ⚠️ 四种锚已全部接线(pptx/xlsx = S6;docx = S6c)。 */
function attAnchorKindOf(f) {
  var st = String((f && f.subtype) || "").toLowerCase();
  if (f && f.kind === "pdf") return "pageSep";
  if (st === "pptx") return "pageSep";
  if (st === "xlsx" || st === "xls") return "sheetHead";
  if (st === "docx") return /^【图 \d+】$/m.test(String((f && f.text) || "")) ? "inlineMarker" : "none";
  return "none";
}
/* 混合档的交错组装(方案 §2.6):[头][段1 文本][段1 图…][段2 文本][段2 图…][尾:对不上锚的图 + 注记]
   · 文本件一律取**原文切片**(不重新拼接)⇒ 正文逐字节不变(§5.4-N5② 的判据靠这一点成立)
   · 每个 text / image 部件都挂 attach: attachMetaOf(f)(**P2-5 不变量**:漏挂的部件既不进
     payload.texts 也不进 payload.imgs ⇒ 预览会丢/错位);图部件另带 page(真页号)与 blob 键(与
     externalizeFiles 的 -pN 对齐,键位按**数组下标**而不是页号)
   · anchorKind 认不出 / 文本切不出段 ⇒ 返回 null(调用方退回既有形态)
   · 不变量(S6c/T7):拼接所有 text 部件(排除头件与 rest 尾注件)== f.text 逐字节 —— 见下方补件 */
function attInterleaveParts(f, proto, meta, anchorKind) {
  var text = String(f.text || "");
  var imgs = f.images || [];
  if (!text || !imgs.length) return null;
  var segs = attPartitionByPage(text, imgs, anchorKind).segs;
  if (!segs.length) return null;
  var bounds = [], cursor = 0, i;
  for (i = 0; i < segs.length; i++) {
    var head = String(segs[i].head || "");
    var at = head ? text.indexOf(head, cursor) : -1;
    if (at < 0) at = cursor;
    bounds.push({ from: Math.max(cursor, at), seg: segs[i] });
    if (head) cursor = at + head.length;
  }
  var out = [];
  /* S6c(P0-1):首个锚之前若还有正文,必须先发一件 —— inlineMarker 的切分把首锚前的正文并进
     锚段、切片从锚行位置开始,不补这一件 ⇒ 文档首段在部件序列里**整段丢失**(sheetHead 自带
     前导段 / pageSep 的首锚恒在 0 ⇒ 本补件对它们是逐字节 no-op;D6 的 pptx/pdf 门不受影响) */
  if (bounds.length && bounds[0].from > 0) {
    out.push({ type: "text", attach: meta, text: text.slice(0, bounds[0].from) });
  }
  for (i = 0; i < bounds.length; i++) {
    var to = (i + 1 < bounds.length) ? bounds[i + 1].from : text.length;
    var body = text.slice(bounds[i].from, to);
    if (body) out.push({ type: "text", attach: meta, text: body });
    var list = bounds[i].seg.images || [];
    for (var j = 0; j < list.length; j++) {
      out.push(attImagePartFor(proto, f, meta, list[j], attImgIndexOf(imgs, list[j])));
    }
  }
  /* 尾:锚对不上的图(按数组序)+ 一条注记(不静默丢) */
  var rest = attPartitionByPage(text, imgs, anchorKind).rest;
  if (rest.length) {
    for (i = 0; i < rest.length; i++) out.push(attImagePartFor(proto, f, meta, rest[i], attImgIndexOf(imgs, rest[i])));
    out.push({ type: "text", attach: meta, text: "(以上 " + rest.length + " 张图未能在正文里定位到所属页/表,已按序附在末尾)" });
  }
  return out;
}
/* 图在 f.images 里的**数组下标**(= 外置键 `id + "-p" + (下标+1)` 的唯一来源,必须与 externalizeFiles 一致)。
   P1 修复:原实现拿"由下标组成的数组"去找**对象**(`idx.indexOf(obj)` 恒为 -1 ⇒ 键退化成 `-p0` ⇒
   发送期 blobMemo 未命中 ⇒ 请求体里页图变「数据不在本机」占位)。找不到时返回 -1,由调用方退化为内联 data。 */
function attImgIndexOf(imgs, im) {
  var k = (imgs || []).indexOf(im);
  return (k >= 0) ? k : -1;
}
/* 交错里的单个图部件:attach 元数据 + 真页号(没有就按数组序号)+ 外置 blob 键(下标键) */
function attImagePartFor(proto, f, meta, im, i) {
  var m = {}, k;
  for (k in meta) if (Object.prototype.hasOwnProperty.call(meta, k)) m[k] = meta[k];
  m.page = im.page || (i + 1);
  if (im.label) m.label = im.label;
  var idxOk = (i >= 0);
  if (im.ext && idxOk) m.blob = f.id + "-p" + (i + 1);
  return imagePartFor(proto, im.mime, (im.ext && idxOk) ? "" : im.data, m);
}
function attachmentParts(f, proto) {
  var out = [];
  if (f.kind === "image") {
    out.push(imagePartFor(proto, f.mime, f.ext ? "" : f.data, attachMetaOf(f)));
    return out;
  }
  if (f.kind === "pdf") {
    if (f.mode === "image" && f.images && f.images.length) {
      var meta = attachMetaOf(f);
      f.images.forEach(function (im, i) {
        var m = {};
        for (var k in meta) if (Object.prototype.hasOwnProperty.call(meta, k)) m[k] = meta[k];
        m.page = i + 1;
        if (im.ext) m.blob = f.id + "-p" + (i + 1);
        out.push(imagePartFor(proto, im.mime, im.ext ? "" : im.data, m));
      });
      return out;
    }
    if (f.mode === "both" && f.images && f.images.length) {
      /* 混合档:按页锚交错(头行单独一件 ⇒ §5.4-N5② 的"排除头行"可判) */
      var pmeta = attachMetaOf(f);
      var seg = attInterleaveParts(f, proto, pmeta, attAnchorKindOf(f));
      if (seg) {
        out.push({
          type: "text", attach: pmeta,
          text: "文件:" + f.name + "(PDF · 共 " + (f.pages || 1) + " 页" + (f.clipped ? " · 已截断" : "") + ")"
        });
        for (var q = 0; q < seg.length; q++) out.push(seg[q]);
        return out;
      }
      /* 交错不成立(文本空/切不出段)⇒ 退回既有形态:图在前、单个 text 在后 */
      f.images.forEach(function (im, i) {
        var mm = {};
        for (var k2 in pmeta) if (Object.prototype.hasOwnProperty.call(pmeta, k2)) mm[k2] = pmeta[k2];
        mm.page = im.page || (i + 1);
        if (im.ext) mm.blob = f.id + "-p" + (i + 1);
        out.push(imagePartFor(proto, im.mime, im.ext ? "" : im.data, mm));
      });
    }
    out.push({
      type: "text",
      attach: attachMetaOf(f),
      text: "文件:" + f.name + "(PDF · 共 " + (f.pages || 1) + " 页" + (f.clipped ? " · 已截断" : "") + ")\n\n" + (f.text || "")
    });
    return out;
  }
  if (f.kind === "office") {
    /* S6b(D12):自绘表格图的**图片档** ⇒ 只发图、不发正文(与 PDF 图片档同形)。
       少了这一支,office 的 mode="image" 会一路落到下面的 text 分支 ⇒ 图**根本发不出去**。 */
    if (f.mode === "image" && f.images && f.images.length) {
      var dmeta = attachMetaOf(f);
      f.images.forEach(function (im, i) {
        var dm = {};
        for (var dk in dmeta) if (Object.prototype.hasOwnProperty.call(dmeta, dk)) dm[dk] = dmeta[dk];
        dm.page = im.page || (i + 1);                 /* 表序号(1-based;与 externalizeFiles 的 -pN 对齐) */
        if (im.label) dm.label = im.label;
        if (im.ext) dm.blob = f.id + "-p" + (i + 1);
        out.push(imagePartFor(proto, im.mime, im.ext ? "" : im.data, dm));
      });
      return out;
    }
    /* O5(S6):有锚的格式按锚交错(pptx = 页分隔行 / xlsx|.xls = `# <表名>` / docx = 只有真出现
       `【图 k】` 时才 inlineMarker —— 位置锚由 S6c 生成)⇒ 与 PDF 复用同一个助手;
       顺序改变是**有意**的(pptx/xlsx)⇒ 回归门用结构门(N5③④),docx 本批仍逐字节不变。
       没锚(老格式 / 自检不通过 / 交错不成立)⇒ 退回既有"图在前、单 text 在后"形态。 */
    var okind = attAnchorKindOf(f);
    if (f.mode === "both" && f.images && f.images.length && okind !== "none" && f.text) {
      var ometa0 = attachMetaOf(f);
      var oseg = attInterleaveParts(f, proto, ometa0, okind);
      if (oseg) {
        var info0 = String(f.subtype || "").toUpperCase();
        if (f.unit === "页" && f.pages) info0 += " · 共 " + f.pages + " 页";
        else if (f.unit === "表" && f.pages) info0 += " · 共 " + f.pages + " 表";
        else info0 += " · 文本 " + f.textChars + " 字";
        if (f.imgCount) info0 += " · " + f.imgCount + " 图";
        out.push({ type: "text", attach: ometa0, text: "文件:" + f.name + "(" + info0 + ")" });
        for (var oq = 0; oq < oseg.length; oq++) out.push(oseg[oq]);
        return out;
      }
    }
    /* 图像在前、文本在后(与「文件在前、问题在后」的既有约定一致);
       文本不加代码围栏,保证 unwrapFileText() 能还原正文 */
    if (f.mode === "both" && f.images && f.images.length) {
      var ometa = attachMetaOf(f);
      f.images.forEach(function (im, i) {
        var m = {};
        for (var k in ometa) if (Object.prototype.hasOwnProperty.call(ometa, k)) m[k] = ometa[k];
        m.page = i + 1;                        /* 键位用序号(与 externalizeFiles 的 -pN 对齐) */
        m.label = im.label || ("图 " + (i + 1));
        if (im.ext) m.blob = f.id + "-p" + (i + 1);
        out.push(imagePartFor(proto, im.mime, im.ext ? "" : im.data, m));
      });
    }
    if (f.text) {
      var info = String(f.subtype || "").toUpperCase();
      if (f.unit === "页" && f.pages) info += " · 共 " + f.pages + " 页";
      else if (f.unit === "表" && f.pages) info += " · 共 " + f.pages + " 表";
      else info += " · 文本 " + f.textChars + " 字";
      if (f.imgCount) info += " · " + f.imgCount + " 图";
      if (f.ocrImgs) info += " · " + f.ocrImgs + " 图已本机 OCR(非视觉模型,图片内容在正文里)";
      if (!f.imgCount && (f.subtype === "doc" || f.subtype === "ppt")) info += " · 仅文本";
      if (f.clipped) info += " · 已截断";
      /* S5 + P2-①:**只在降级/OCR 场景**才把模式词接进请求体信息行(默认路径逐字节不变 —— N5③ 的逐字节门靠这一点成立) */
      if (f.ocrImgs || f.degraded) info += " · " + attachModeLabel(f);
      out.push({
        type: "text",
        attach: attachMetaOf(f),
        text: "文件:" + f.name + "(" + info + ")\n\n" + f.text
      });
    }
    return out;
  }
  var body = String(f.text || "");
  var fence = body.indexOf("```") > -1 ? "````" : "```";
  var tinfo = [f.enc ? ("编码 " + wsEncName(f.enc) + " · 已转码显示") : "", f.clipped ? "内容过长 · 已截断" : ""]
    .filter(Boolean).join(" · ");
  out.push({
    type: "text",
    attach: attachMetaOf(f),
    text: "文件:" + f.name + (tinfo ? "(" + tinfo + ")" : "") + "\n" +
      fence + "\n" + body + "\n" + fence
  });
  return out;
}
/* 把草稿附件的 payload 写进 IndexedDB:成功才标记 ext(消息里不再带 base64);
   失败就保持原样(内联进 localStorage),不会丢数据 */
function externalizeFiles(files) {
  var list = files || [];
  if (!list.length) return Promise.resolve(0);
  return blobDb().then(function (db) {
    if (!db) return 0;
    var jobs = [];
    list.forEach(function (f) {
      if (!f) return;
      if (f.kind === "image" && f.data) {
        jobs.push(blobPut(f.id, f.mime, f.data).then(function (ok) { if (ok) f.ext = true; }));
      } else if (f.kind === "pdf" && (f.mode === "image" || f.mode === "both") && f.images) {
        f.images.forEach(function (im, i) {
          if (!im.data) return;
          var key = f.id + "-p" + (i + 1);
          jobs.push(blobPut(key, im.mime, im.data).then(function (ok) { if (ok) im.ext = true; }));
        });
      } else if (f.kind === "office" && f.images) {
        f.images.forEach(function (im, i) {
          if (!im.data) return;
          var key = f.id + "-p" + (i + 1);
          jobs.push(blobPut(key, im.mime, im.data).then(function (ok) { if (ok) im.ext = true; }));
        });
      }
    });
    return Promise.all(jobs).then(function (r) { return r.length; });
  }, function () { return 0; });
}
function buildUserContent(text, files) {
  var proto = state.settings.protocol;
  var parts = [];
  (files || []).forEach(function (f) {
    var ps = attachmentParts(f, proto);
    for (var i = 0; i < ps.length; i++) parts.push(ps[i]);
  });
  /* 文件/图片在前、问题在后:多数多模态模型按这个顺序训练 */
  if (text && text.trim()) parts.push({ type: "text", text: text });
  if (!parts.length) return "";
  if (parts.length === 1 && parts[0].type === "text" && !parts[0].attach) return parts[0].text;
  return parts;
}

/* ---- 附件设置面板(设置 → 附件) ---- */
/* 附件图片策略(三档;唯一选项源) —— 文案说明"哪些格式支持 + 默认是哪个"(D13-b:选择器恒显三档、
   不支持该档的格式走降级并在气泡/预览里如实注记;能力表见 attachRenderCap) */
var ATTACH_MODE_OPTIONS = [
  { v: "text", label: "纯文本", desc: "只发抽出的文字(最省 token);PDF/办公文档都支持。图片附件本身仍按图片发送" },
  { v: "image", label: "图片", desc: "整页/整表渲染成图片发送(需模型支持图像输入);PDF 与 docx=逐页渲染成页图(docx 基于浏览器排版,分页与 Word 可能不一致;页数为渲染结果),xlsx/xls=本机绘制表格图,其余格式会降级为混合并说明" },
  { v: "both", label: "混合", desc: "默认:文字 + 文档内的图片一起发送(非视觉模型下图片自动改走本机 OCR)" }
];
var OCR_LANG_OPTIONS = [
  { v: "chi_sim+eng", label: "中文 + 英文", desc: "默认,中英混排的图片都能认" },
  { v: "chi_sim", label: "仅中文", desc: "只加载中文模型" },
  { v: "eng", label: "仅英文", desc: "只加载英文模型,体积最小" }
];
var VISION_FORCE_OPTIONS = [
  { v: "auto", label: "自动", desc: "先看服务端模型清单,再自动探测(默认)" },
  { v: "yes", label: "强制支持", desc: "不探测,图片一律按原图发送" },
  { v: "no", label: "强制不支持", desc: "图片一律走 OCR,只发文字给模型" }
];
function initAttachSelects() {
  setupNsel("set-attachmode", ATTACH_MODE_OPTIONS, function (v) {
    state.settings.attachImgMode = (v === "text" || v === "image" || v === "both") ? v : "both";
    saveSoon();
    renderAttachPanel();
  });
  setupNsel("set-ocrlangs", OCR_LANG_OPTIONS, function (v) {
    state.settings.ocrLangs = v;
    saveSoon();
    renderAttachPanel();
  });
  var resampleOpts = [];
  for (var rk in RESAMPLE_PRESETS) {
    if (Object.prototype.hasOwnProperty.call(RESAMPLE_PRESETS, rk)) {
      resampleOpts.push({ v: rk, label: RESAMPLE_PRESETS[rk].label, desc: RESAMPLE_PRESETS[rk].desc });
    }
  }
  setupNsel("set-resample", resampleOpts, function (v) {
    state.settings.imgResample = RESAMPLE_PRESETS[v] ? v : "spline";
    saveSoon();
    renderAttachPanel();
  });
  setupNsel("set-visionforce", VISION_FORCE_OPTIONS, function (v) {
    state.settings.visionForce = (v === "yes" || v === "no") ? v : "auto";
    saveSoon();
    renderVisionHint();
    updateCtxMeter();
  });
  var b = $("btn-vision-probe");
  if (b) b.addEventListener("click", function () {
    var m = effectiveModel();
    if (!m) { toast("先选择模型", "warn"); return; }
    saveSettingsFromModal(false, true);
    toast("正在探测「" + m + "」是否支持图像输入…", "info", 2600);
    probeModelVision(m, false);
  });
}
function renderVisionHint() {
  var name = effectiveModel();
  var el = $("set-vision-state");
  if (el) el.textContent = (name ? name + " : " : "") + visionLabel(name);
  var oc = $("set-ocr-state");
  if (oc) {
    oc.textContent = ocrReady()
      ? "引擎可用(Tesseract.js " + escapeHtml(window.OCRKit.version || "?") + ",已内嵌:" +
        escapeHtml((window.OCRKit.langs || []).join(" / ")) + ")。模型不支持视觉时,图片会自动 OCR 后只发文字。"
      : "引擎不可用:" + ((window.OCRKit && window.OCRKit.why) || "缺少 Web Worker / WebAssembly / Blob");
  }
  var libs = $("attach-libs");
  if (libs) {
    libs.innerHTML =
      "<dt>pdf.js</dt><dd>" + (pdfKitReady()
        ? "可用(" + escapeHtml(window.PDFKit.version || "?") + ")"
        : "不可用:" + escapeHtml((window.PDFKit && window.PDFKit.why) || "未加载")) + "</dd>" +
      "<dt>Tesseract.js</dt><dd>" + (ocrReady()
        ? "可用(" + escapeHtml(window.OCRKit.version || "?") + ")"
        : "不可用:" + escapeHtml((window.OCRKit && window.OCRKit.why) || "未加载")) + "</dd>" +
      "<dt>办公解析</dt><dd>" + (officeReady()
        ? "可用(" + escapeHtml(window.OfficeKit.version || "?") + ",模式 " + escapeHtml(window.OfficeKit.mode || "?") + ")"
        : "不可用:" + escapeHtml((window.OfficeKit && window.OfficeKit.why) || "未加载")
          + "(doc/docx/ppt/pptx/xls/xlsx 附件会被拒绝)") + "</dd>" +
      "<dt>Canvas / FileReader</dt><dd>" + (canvasOK() && CAP.fileReader ? "可用" : "不可用(图片会被原样发送)") + "</dd>" +
      "<dt>Web Worker</dt><dd>" + (CAP.worker ? "可用" : "不可用(库会降级到主线程运行)") + "</dd>";
  }
}
function renderAttachPanel() {
  setNselValue("set-resample", imgResampleMode(), true);
  var maxEl = $("set-imgmax");
  if (maxEl) {
    maxEl.value = String(imgMaxSide());
    syncRangeLabel(maxEl);
  }
  var amEl = $("set-attachmax");
  if (amEl) {
    amEl.value = String(Math.round(attachMsgMaxBytes() / 1048576));
    syncRangeLabel(amEl);
  }
  var kvA = $("kv-attach-max");
  if (kvA) kvA.textContent = fmtBytes(attachMsgMaxBytes()) + "(本地存储与请求都算它)";
  var kvI = $("kv-img-max");
  if (kvI) kvI.textContent = imgMaxSide() + " px,超出自动下采样(" + (RESAMPLE_PRESETS[imgResampleMode()] || {}).label + ")";
  setNselValue("set-attachmode", attachImgMode(), true);
  setNselValue("set-ocrlangs", ocrLangs(), true);
  setNselValue("set-visionforce", state.settings.visionForce || "auto", true);
  var pages = $("set-pdfpages");
  if (pages) {
    pages.value = String(pdfMaxPages());
    syncRangeLabel(pages);
  }
  var dpi = $("set-pdfdpi");
  if (dpi) {
    dpi.value = String(pdfDpi());
    syncRangeLabel(dpi);
  }
  renderVisionHint();
}
/* ---- 上下文压缩:自动路径的入口(appD 侧;压缩内核在 appE §28) ----
   · 去重:同一水位不重复压(CX_LEDGER.lastAfter,等价 Kimi lastCompactedTokenCount)
   · 限流:自动发送前路径靠**去重闸**(L.lastAfter:同一水位不重复压)限流;
     L.round 语义收窄为"本 turn 自动路径已压次数"的读数,不再是闸
     (计数在 sendMessage 开头复位;溢出恢复另用 CX_LEDGER.ovfCount,上限 CX_OVERFLOW_PER_TURN_MAX)
   · 降噪:ECOMPACT_SMALL / NOSPACE **不 toast、不写状态行**(根本没进压缩流程),
     只按 CX_LEDGER.warned 的 5 个百分点步长提示一次 —— cxPlanFor 落水位档并给出 warnFresh
   · **不吞 ECOMPACT_ABORT**:原样返回给发送链,由它决定放弃本次发送
   返回形状统一 {ok, code, compacted, text} */
/* 预留项(U-4 借鉴-2;b24 方案 P2-新3 已批准的公式,原为孤儿常量):
   reserve = min(max(CX_RESERVE_MIN, win*5%), win*50%);win ≤ 0 ⇒ 0。
   纯函数、可页内断言(U12①:8192 ⇒ 4096 · 65536 ⇒ 16384 · 262144 ⇒ 16384) */
function cxReserveOf(win) {
  var w = Number(win) || 0;
  if (!(w > 0)) return 0;
  return Math.min(Math.max(CX_RESERVE_MIN, w * 0.05), w * 0.5);
}
async function cxAutoBeforeSend(tf) {
  if (!cxEnabled() || !tf || !Array.isArray(tf.messages)) return null;
  var s = ctxSnapshot(tf);
  var pct = s.win > 0 ? (s.used / s.win * 100) : 0;
  /* 两条触发式:①水位百分比 ②预留项(再涨 reserve 就满窗 ⇒ 提前压,避免"下一步就溢出") */
  var reserve = cxReserveOf(s.win);
  var byPct = (pct >= cxTriggerPct());
  var byReserve = (reserve > 0 && reserve < s.win && (s.used + reserve) >= s.win);
  if (!byPct && !byReserve) return null;
  var L = cxLedger(tf.id);
  if (L.lastAfter > 0 && s.used <= L.lastAfter) return null;   /* 没长过就不再压 */
  L.round = (L.round || 0) + 1;
  var r = await cxCompactNow(tf, { source: "auto", mode: "auto", triggerReason: byPct ? "pct" : "reserve" });
  if (r && r.ok) {
    L.lastAfter = ctxSnapshot(tf).used;
    toast("摘要已生成:上下文已自动压缩(" + (byPct ? "阈值" : "预留") + "触发),丢弃 " + (r.dropped || 0) + " 条较早的消息" +
      (r.released ? "(释放 " + r.released + " 个附件)" : "") +
      ",约 " + num(r.before) + " → " + num(r.after) + " tok(重要中间结论建议落到工作区文件)" +
      (Number(r.after) > Number(r.before) ? "（本次摘要比被丢弃内容更长，属正常）" : ""),
      "info", 6000);
    return { ok: true, code: "", compacted: true, text: "" };
  }
  var code = (r && r.code) || "ECOMPACT_FAIL";
  if (code === "ECOMPACT_ABORT" || code === "ECOMPACT_BUSY") {
    return { ok: false, code: code, compacted: false, text: "" };
  }
  if (code === "ECOMPACT_SMALL" || code === "ECOMPACT_NOSPACE") {
    /* 同一水位档只提示一次(水位涨幅不足 5 个百分点 ⇒ 静默),绝不逐轮刷 toast */
    if (r && r.warnFresh) {
      var realUsers = 0, i;
      for (i = 0; i < tf.messages.length; i++) if (cxIsRealUser(tf.messages[i])) realUsers++;
      toast("自动压缩未生效:" + cxCodeText(code, realUsers <= 1) , "warn", 6400);
    }
    return { ok: false, code: code, compacted: false, text: "" };
  }
  toast("自动压缩失败:" + cxCodeText(code, false, r && r.note) + "(原文未改动) —— 本轮照常继续", "warn", 6000);
  return { ok: false, code: code, compacted: false, text: "" };
}
/* 轮次之间的检查点:同一判定(去重 / 限流 / 降噪一致) */
async function cxAutoBetweenRounds(tf) {
  var r = await cxAutoBeforeSend(tf);
  return r || { ok: false, code: "", compacted: false, text: "" };
}
/* ---- 生成中的待发送缓冲区(内存 · **按会话多槽** · 多项) ----
   用户原话:Agent 循环工作期间回车 → 文本进缓冲区(输入框上方浮窗),**下一个工具轮边界**
   (工具结果写入后、下一次模型请求前)即作为 user 消息插入会话,支持中途补充需求;最后一个工具轮
   之后到达的由回合结束的兜底 flush 发送。循环结束前可召回(编辑按钮 / ↑)或丢弃;普通 Esc 丢弃整槽
   (仅当槽归属当前会话、浮窗可见时;中断已改为 Ctrl+X)。条目不持久化(刷新即失,与 Kimi 的内存队列对齐)。
   并发后同一时刻可能有多条在飞 send ⇒ 槽按 convId 分开(每条会话一个队列,浮窗只显示当前会话的);
   超过并发上限被挡下的发送也落进这里,由 genDrop 的唤醒扫描按"槽首项最旧"补发。
   item = { id, convId, text, at };convId = **入队时**那条会话 —— 生成期间允许切走会话,
   缓冲消息必须落回它入队时那一条(读侧见 sendMessage 的 opts.bufItem.convId)。 */
var SQ = {};                    /* convId → { items: [{ id, convId, text, at }] } */
var SQ_RETRY_COOLDOWN_MS = 4000;   /* 自动补发失败后的冷却:防"补发 → 失败 → 再补发"的即时循环 */
function sqSlot(convId, make) {
  if (!convId) return null;
  var s = SQ[convId];
  if (!s && make) { s = SQ[convId] = { items: [] }; }
  return s || null;
}
function sqAnyItems() {
  var k;
  for (k in SQ) {
    if (!Object.prototype.hasOwnProperty.call(SQ, k)) continue;
    if (SQ[k] && SQ[k].items && SQ[k].items.length) return true;
  }
  return false;
}
function sqHasFor(convId) {
  var s = convId ? SQ[convId] : null;
  return !!(s && s.items && s.items.length);
}
/* 上下文用量环:把**当前会话**的缓冲文本当成"待发送草稿"的一部分,文本从输入框移进缓冲时读数不跳变。
   (旧实现无条件累加全局唯一槽 ⇒ 用户在 B 时会把 A 的缓冲文本算进 B 的环 —— 缺陷 I 的修法) */
function sqDraftTokens(c) {
  if (!c || !conv || c.id !== conv.id) return 0;
  var s = sqSlot(c.id);
  if (!s) return 0;
  var n = 0, i;
  for (i = 0; i < s.items.length; i++) n += estimateTokens(s.items[i].text || "");
  return n;
}
/* 入队原语(按会话;进队列尾部,保持"先入先发") */
function sqPush(convId, text) {
  var s = sqSlot(convId, true);
  if (!s) return false;
  s.items.push({ id: uid(), convId: convId, text: text, at: Date.now() });
  return true;
}
/* 生成中回车 → 入队(唯一入口;空文本不动作,保持"空 Enter 无效果") */
function sqEnqueueFromInput() {
  var text = elInput.value.trim();
  if (!text) return;
  /* 只有"当前会话自己在生成"才入队:生成期间切走后回车不该悄悄塞进别人的队列 */
  if (!conv || !genOn(conv.id)) {
    toast("另一条会话正在生成中,本条消息未发送", "warn", 4200);
    return;
  }
  if (pendingOffice.length) {
    toast("办公文档还在本机解析中,完成后才能发送(点附件上的 ✕ 可取消)", "warn", 3600);
    return;
  }
  if (draftFiles.length) {   /* v1 不支持附件入队(文本与附件都不动,不产生半截状态) */
    toast("生成中:带附件的消息请等本轮结束后再发送(文字与附件都保留在输入框)", "warn", 4600);
    return;
  }
  sqPush(conv.id, text);
  elInput.value = "";
  autoResize();
  updateCtxMeter();
  sqRender();
  focusInput();
}
/* 早退回队(幂等):同一 item 重复调用只放回一次,防"交接期异常 → 重复发送"。
   item.convId 必填(槽就是按它定位的);retryAt = 自动补发的短冷却(手动 Enter 不受它限制) */
function sqRestoreBuf(item) {
  if (!item || !item.id || !item.convId) return;
  var s = sqSlot(item.convId, true);
  if (!s) return;
  for (var i = 0; i < s.items.length; i++) if (s.items[i].id === item.id) { sqRender(); return; }
  item.retryAt = Date.now() + SQ_RETRY_COOLDOWN_MS;
  s.items.unshift(item);
  sqRender();
}
/* 召回(编辑按钮 & ↑ 共用):严格镜像 Kimi 的"编辑器完全为空"判定(D4,不 trim)。
   多槽后跨槽找这条 item(itemId 全局唯一;浮窗只显示当前槽) */
function sqRecall(itemId) {
  if (elInput.value.length !== 0) {
    toast("输入框里还有内容,先清空再召回(避免覆盖草稿)", "warn", 3600);
    return;
  }
  var it = null, i, k, s, arr;
  for (k in SQ) {
    if (!Object.prototype.hasOwnProperty.call(SQ, k)) continue;
    s = SQ[k];
    arr = s && s.items ? s.items : [];
    for (i = 0; i < arr.length; i++) if (arr[i].id === itemId) { it = arr[i]; arr.splice(i, 1); break; }
    if (it) break;
  }
  if (!it) return;
  elInput.value = it.text;
  autoResize();
  updateCtxMeter();
  sqRender();
  focusInput();
}
function sqDiscard(itemId) {
  var i, k, s, arr;
  for (k in SQ) {
    if (!Object.prototype.hasOwnProperty.call(SQ, k)) continue;
    s = SQ[k];
    arr = s && s.items ? s.items : [];
    for (i = 0; i < arr.length; i++) if (arr[i].id === itemId) { arr.splice(i, 1); break; }
  }
  updateCtxMeter();
  sqRender();
}
/* 丢弃整槽(普通 Esc 的收尾动作;只丢**指定会话**的,别的会话队列原样保留) */
function sqDiscardAllOf(convId) {
  if (convId && SQ[convId]) {
    SQ[convId].items = [];
    delete SQ[convId];
  }
  updateCtxMeter();
  sqRender();
}
/* 残留态(未生成但队列非空)的手动恢复路径:唯一入口 = 空 Enter(hint 明示) */
function sqSendableIdle() {
  return !!conv && !genOn(conv.id) && sqHasFor(conv.id) &&
    !elInput.value.trim() && !draftFiles.length;
}
/* 补发 / 手动发送槽首项(按会话)。返回 = 是否真的发起了 send(唤醒扫描据此判断"已补发") */
function sqSendHead(convId) {
  if (!convId || genOn(convId) || !sqHasFor(convId)) return false;
  var s = SQ[convId];
  var it = s.items.shift();
  sqRender();
  sendMessage(it.text, { bufItem: it });
  return true;
}
/* 回合结束后的兜底发送:取队首 1 条,**同步**调 sendMessage(不 await、不 catch —— 错误在
   sendMessage 既有链路里 toast)。它的同步段会把该会话置回生成中 ⇒ 紧随的 pvNotifyCheck(convId)
   命中 genOn(convId) 自动让位(缓冲是用户内容,优先于自动续跑)。
   主路径 = 工具轮边界的 sqInsertAtToolBoundary;这里兜住"最后一个工具轮之后 / 无工具轮"到达的条目。
   wakeSent = genDrop 的唤醒已补发过 ⇒ 本次让位(一次收尾至多补发一次,方案 §9-D1) */
function sqFlushAfterTurn(endedConvId, wakeSent) {
  if (wakeSent) return;
  if (!endedConvId || genOn(endedConvId)) return;
  if (!sqHasFor(endedConvId)) return;
  if (genCount() >= genMaxNow()) return;     /* 空位不足:条目保留,等下一次唤醒 */
  if (!getConv(endedConvId)) {               /* 目标会话已删(或整库替换拿走):整槽丢弃 */
    delete SQ[endedConvId];
    sqRender();
    toast("该对话已被删除,待发送消息已丢弃", "warn", 5000);
    return;
  }
  if (!effectiveModel().trim() || !apiUrl("")) {   /* 廉价前置校验:不出队、留待用户动作 */
    sqRender();
    toast("待发送消息已保留:配置好模型 / Base URL 后按 Enter 或召回发送", "warn", 5200);
    return;
  }
  var it = SQ[endedConvId].items.shift();    /* 交接即出队 */
  sqRender();
  sendMessage(it.text, { bufItem: it });
}
/* 工具轮边界插入(主路径):生成期间入队的缓冲消息在「工具结果写入后、下一次模型请求前」
   逐条作为 user 消息补进会话(下一轮请求自然带上 = 中途补充需求);持久化 + msgList 同步 + 渲染,
   交接即出队。未插到的(例如这是最后一轮)留在队里,由 finally 的 sqFlushAfterTurn 兜底发送。
   只动**该会话自己的槽**:目标会话已走 / 槽为空:整段不动,不丢文本 */
function sqInsertAtToolBoundary(sendConvId, tf, msgList) {
  var s = sendConvId ? SQ[sendConvId] : null;
  if (!tf || !msgList || !s || !s.items.length) return 0;
  if (!getConv(sendConvId)) return 0;
  var n = 0;
  while (s.items.length) {
    var it = s.items.shift();                  /* 交接即出队(主路径;flush 兜底仍保留) */
    var content = buildUserContent(it.text, null);
    tf.messages.push({ id: uid(), role: "user", content: content, createdAt: Date.now() });
    msgList.push({ role: "user", content: protocolContent(content, state.settings.protocol) });
    n++;
  }
  if (!n) return 0;
  tf.updatedAt = Date.now();
  /* 与普通发送路径同一套配套:自动命名 + 空闲自动续跑计数复位(插入等价于用户真实发言) */
  autoTitle(tf.id);
  if (typeof pvAutoLoopReset === "function") pvAutoLoopReset(tf.id);
  saveState(true);
  if (tf === conv) { renderChat(); scrollToBottom(true); }
  updateCtxMeter();
  sqRender();
  return n;
}
function sqHintText() {
  var cid = conv && conv.id;
  /* 超限等位优先判:该会话不在生成、但全局已满 ⇒ 这里的条目由 genDrop 的唤醒补发(Enter 也发不出) */
  if (!genOn(cid) && sqHasFor(cid) && genCount() >= genMaxNow()) return "待前序会话空出槽位后自动发送";
  if (!genOn(cid) && sqHasFor(cid)) return "按 Enter 立即发送";
  if (typeof ASK_WAITS !== "undefined" && waitsCountOf(cid, "ask") + waitsCountOf(cid, "approval")) {
    return "正在等你回答 / 放行,之后自动发送";
  }
  if (typeof CX_RUN !== "undefined" && CX_RUN && CX_RUN.phase !== "idle" && CX_RUN.convId === cid) return "压缩完成后自动发送";
  return "下一轮工具结果后自动发送 · Esc 丢弃待发送 · ↑ 召回最后一条 · 可编辑 / 丢弃";
}
/* 浮窗渲染(清空重建;调用点 = 入队/召回/丢弃/交接 + renderChat 两个出口)。
   只显示**当前会话**的槽:别的会话的队列不可见(切过去自然可见) */
function sqRender() {
  var box = $("send-queue"), rows = $("send-queue-rows"), hint = $("send-queue-hint");
  var s = conv ? sqSlot(conv.id) : null;
  if (!box || !rows) return;
  var show = !!(s && s.items && s.items.length);
  while (rows.firstChild) rows.removeChild(rows.firstChild);           /* 先清空:隐藏时不留残留 DOM */
  if (!show) {
    box.classList.remove("open");
    box.setAttribute("hidden", "");
    return;
  }
  s.items.forEach(function (it) {
    var row = document.createElement("div");
    row.className = "sq-row";
    row.setAttribute("role", "listitem");
    row.setAttribute("data-id", it.id);
    var t = document.createElement("span");
    t.className = "sq-text";
    t.textContent = it.text;             /* 一律 textContent:缓冲文本可能含标签 */
    t.title = it.text;
    row.appendChild(t);
    var be = document.createElement("button");
    be.className = "sq-btn"; be.type = "button";
    be.setAttribute("data-sq-act", "edit");
    be.setAttribute("aria-label", "编辑这条待发送消息");
    be.innerHTML = icon("edit", "sm");
    row.appendChild(be);
    var bd = document.createElement("button");
    bd.className = "sq-btn"; bd.type = "button";
    bd.setAttribute("data-sq-act", "discard");
    bd.setAttribute("aria-label", "丢弃这条待发送消息");
    bd.innerHTML = icon("trash", "sm");
    row.appendChild(bd);
    rows.appendChild(row);
  });
  if (!rows.__sqBound) {                /* 事件委托一次绑定(先例 = ctx-pop 的 click 委托) */
    rows.__sqBound = true;
    rows.addEventListener("click", function (e) {
      var btn = (e.target && e.target.closest) ? e.target.closest("[data-sq-act]") : null;
      if (!btn) return;
      var row = btn.closest(".sq-row");
      var id = row ? row.getAttribute("data-id") : "";
      if (!id) return;
      if (btn.getAttribute("data-sq-act") === "edit") sqRecall(id); else sqDiscard(id);
    });
  }
  if (hint) hint.textContent = sqHintText();
  box.classList.add("open");
  box.removeAttribute("hidden");
}
function doSend() {
  /* 防御性早退:当前会话自己在生成 ⇒ 与 Enter 同口径走缓冲(按钮 / 快捷键 / 命令面板
     三处调用点都已先行按会话判定,这里兜住竞态,不静默丢消息) */
  if (genCur()) { sqEnqueueFromInput(); return; }
  /* 办公文档还在本机解析:这时候发出去要么把附件静默漏掉、要么按了没反应 —— 明确挡住并说明 */
  if (pendingOffice.length) {
    toast("办公文档还在本机解析中,完成后才能发送(点附件上的 ✕ 可取消)", "warn", 3600);
    return;
  }
  var text = elInput.value.trim();
  if (!text && !draftFiles.length) return;
  if (!conv) { if (!newConversation({ keepDraft: true })) return; }
  var files = draftFiles;
  draftFiles = [];
  renderAttachBar();
  elInput.value = "";
  autoResize();
  sendMessage(text, { files: files });
}

/* ---- 参数浮层 ---- */
var PARAM_DEFS = [
  { key: "temperature", id: "p-temp", out: "p-temp-v", min: -1, max: 2, fmt: function (v) { return v < 0 ? "不发送" : v.toFixed(2); } },
  { key: "topP", id: "p-topp", out: "p-topp-v", min: -1, max: 1, fmt: function (v) { return v < 0 ? "不发送" : v.toFixed(2); } },
  { key: "maxTokens", id: "p-maxtok", out: "p-maxtok-v", min: 0, max: 393216, fmt: function (v) { return fmtTok(v); } },
  { key: "freqPenalty", id: "p-reppen", out: "p-reppen-v", min: 0, max: 2, fmt: function (v) { return v === 0 ? "不启用" : v.toFixed(2); } }
];
function syncEffortInputs() {
  var v = state.settings.reasoningEffort || "";
  setNselValue("set-reff", v, true);
  setNselValue("p-reff", v, true);
}
function syncParamInputs() {
  PARAM_DEFS.forEach(function (d) {
    var el = $(d.id), out = $(d.out);
    if (!el) return;
    el.value = state.settings[d.key];
    if (out) out.textContent = d.fmt(Number(state.settings[d.key]));
  });
  syncEffortInputs();
  syncCtxWinInputs();
}
/* 上下文长度(手动设定)的两个控件:输入区浮层 + 设置面板各一组,显示态与取值同源。
   forceEl = 刚提交完的那个输入框(它可能仍持有焦点,必须回写 clamp 后的值) */
function syncCtxWinInputs(forceEl) {
  var on = ctxWinManualOn();
  var v = ctxWinKNow();
  [["p-ctxwin-field", "p-ctxwin", "p-ctxwin-n"], ["set-ctxwin-field", "set-ctxwin", "set-ctxwin-n"]].forEach(function (ids) {
    var box = $(ids[0]);
    if (box) box.style.display = on ? "" : "none";
    var r = $(ids[1]);
    if (r && Number(r.value) !== v) r.value = v;
    var n = $(ids[2]);
    if (n && (n === forceEl || (Number(n.value) !== v && document.activeElement !== n))) n.value = v;
  });
}
/* 手调上下文长度的**唯一写入口**:clamp → 写设置 → 两处控件同步 → 用量环 / 来源文案即时刷新。
   服务端给了窗口长度时计算路径根本不看这个值(ctxWindowFor 先判 server),控件也已隐藏 */
function setCtxWinK(v, src) {
  var k = clampNum(v, CTX_WIN_K_MIN, CTX_WIN_K_MAX, DEFAULT_SETTINGS.ctxWinK);
  state.settings.ctxWinK = k;
  saveSoon();
  syncCtxWinInputs(src);
  updateModelsHint();
  updateCtxMonitor();
  return k;
}
/* K 输入框的取值(与设置面板数字输入 numBindValue 同一口径):
   `input[type=number]` 会把非数字串消毒成 ""(清空、输入 'abc' 都是这个结果),而 Number("")=0
   是"合法数字" ⇒ 直接 clamp 会把清空动作钉到**最小值** 8K。所以空串与非数字都回默认值,
   只有真数字才按区间夹(4→8、2048→1024) */
function ctxWinKFromInput(el) {
  var raw = el ? String(el.value == null ? "" : el.value).trim() : "";
  if (raw === "" || !isFinite(Number(raw))) return DEFAULT_SETTINGS.ctxWinK;
  return clampNum(Number(raw), CTX_WIN_K_MIN, CTX_WIN_K_MAX, DEFAULT_SETTINGS.ctxWinK);
}
/* 四个输入框(两组 × 滑块 + K 输入框):滑块即时生效;输入框失焦 / 回车(change)生效。
   范围与步进取自常量,HTML 里的 min/max/step 只是初始值 */
function initCtxWinInputs() {
  [["p-ctxwin", "p-ctxwin-n"], ["set-ctxwin", "set-ctxwin-n"]].forEach(function (ids) {
    var r = $(ids[0]), n = $(ids[1]);
    if (r) {
      r.min = String(CTX_WIN_K_MIN); r.max = String(CTX_WIN_K_MAX); r.step = String(CTX_WIN_K_STEP);
      r.addEventListener("input", function () { setCtxWinK(Number(r.value)); });
    }
    if (n) {
      n.min = String(CTX_WIN_K_MIN); n.max = String(CTX_WIN_K_MAX); n.step = String(CTX_WIN_K_STEP);
      n.addEventListener("change", function () { setCtxWinK(ctxWinKFromInput(n), n); });
    }
  });
}
function initParamInputs() {
  PARAM_DEFS.forEach(function (d) {
    var el = $(d.id);
    if (!el) return;
    el.addEventListener("input", function () {
      state.settings[d.key] = Number(el.value);
      $(d.out).textContent = d.fmt(Number(el.value));
      var mirror = $("set-" + d.key.toLowerCase());
      if (mirror) { mirror.value = el.value; syncRangeLabel(mirror); }
      saveSoon();
    });
  });
  initCtxWinInputs();
  $("p-reset").addEventListener("click", function () {
    PARAM_DEFS.forEach(function (d) { state.settings[d.key] = DEFAULT_SETTINGS[d.key]; });
    state.settings.reasoningEffort = DEFAULT_SETTINGS.reasoningEffort;
    state.settings.ctxWinK = DEFAULT_SETTINGS.ctxWinK;
    syncParamInputs(); syncSettingsForm(); saveSoon();
    toast("已恢复默认生成参数", "success", 1600);
  });
  $("p-close").addEventListener("click", function () { $("params-pop").classList.remove("open"); $("btn-params").classList.remove("on"); });
}
function toggleParamsPop() {
  var pop = $("params-pop"), btn = $("btn-params");
  var open = !pop.classList.contains("open");
  $("pop-menu").classList.remove("open");
  syncParamInputs();
  syncParamTools();      /* 「工具」分组的开关态 / 可用数 / prefill 提示 */
  pop.classList.toggle("open", open);
  btn.classList.toggle("on", open);
  if (open) {
    placePopover(pop, btn, { align: "left", width: 320 });
    /* F12 同类（#ctx-pop 已修，此处补齐）：开屏一律回到浮层顶部 —— 浮层自身的内滚偏移是 DOM 状态,
       关掉不清 ⇒ 重开后顶部的滑块/开关被推出视图（与 `toggleCtxPop` 同形、同一判据） */
    pop.scrollTop = 0;
  }
}
/* ---- 提示词模板 ---- */
/* 菜单项按**数组顺序**输出,遇到 group 变化才插组头(U-3 的 18 条 / 6 组):
   —— 不按 group 聚合再排序,这样用户自建的无 group 条目会留在它被创建的位置附近,不被重排;
   —— 无 group(缺省 / 旧备份导入 / 新增入口 push({name,text}))⇒ 不插组头,但用分隔线与上一组隔开;
   —— 组头复用既有的裸类名 `.pop-sub-title` / `.pm-sep`(零新增 CSS)。 */
function openLibMenu(anchor) {
  closeMenus();
  var menu = $("pop-menu");
  var items = "", lastG = null;
  state.promptLib.forEach(function (t) {
    var g = (typeof t.group === "string") ? t.group.trim() : "";
    if (lastG !== null && g !== lastG) items += '<div class="pm-sep"></div>';
    if (g && g !== lastG) items += '<div class="pop-sub-title">' + escapeHtml(g) + "</div>";
    lastG = g;
    items += '<button data-libtext="' + escAttr(t.text) + '" title="' + escAttr(t.text) + '">' +
      icon("book", "sm") + "<span>" + escapeHtml(t.name) + "</span></button>";
  });
  if (!items) items = '<div class="pm-hint" style="padding:8px 11px">模板库为空</div>';
  menu.innerHTML = items +
    '<div class="pm-sep"></div><button data-libact="manage">' + icon("sliders", "sm") + " 管理模板…</button>";
  placeMenu(menu, anchor);
}
/* 贴着锚点放:优先放正上方,上面放不下才翻到下方;左右夹紧在视口内。
   两条硬要求(都来自实测缺陷):
   ① **量布局尺寸,不量 rect** —— 本元素带 `animation: popIn .14s`(起帧
      `translateY(6px) scale(.98)`),而 `display:none → block` 每次开合都会**重启动画** ⇒
      `getBoundingClientRect()` 在 add("open") 之后立即读到的**是动画起帧**(高少 2%、位置多 6px)
      ⇒ 菜单"首次点击就偏一点,开合多次读数还会抖"。`offsetWidth/offsetHeight` 是**布局盒**尺寸,
      不受 transform 影响 ⇒ 同一内容每次读数逐位相同(浮窗漂移的根因修)。
   ② **先重置 max-height / overflow-y** —— `#pop-menu` 是**多主单例**(会话菜单 / 工作区挂载 /
      模板菜单 / 右键菜单共用)。旧实现只设 left/top,谁设过高上限就会**串到下一个菜单**上
      (placeMenuAt 会重置、placeMenu 不会 ⇒ 两侧口径不一致)。
   ③ 超高时给上限 + 自身滚动(旧实现对超高菜单直接出屏):上限只由视口与锚点位置决定,
      不含任何"测量值反馈"⇒ 不引入读数漂移。
   ④ **开屏一律回滚到顶部** —— 内滚偏移是元素自身的 DOM 状态,关掉不清 ⇒ 重开后顶部条目
      被推出视图(F12 债:实测 `#pop-menu` 开 → 滚 200 → 关 → 再开仍 200)。口径与 F12 三面
      (`#cmd-list` 的 `openPalette` / `#ctx-pop` 的 `toggleCtxPop` / `#params-pop` 的
      `toggleParamsPop`)同源 ⇒ **「同一菜单重开保留上次位置」的旧行为按该口径统一取消**(placeMenuAt 同)。 */
function placeMenu(menu, anchor) {
  menu.classList.add("open");
  menu.style.maxHeight = "";
  menu.style.overflowY = "";
  var a = anchor.getBoundingClientRect();
  var vw = window.innerWidth, vh = window.innerHeight, gap = 8;
  var mw = menu.offsetWidth, mh = menu.offsetHeight;
  var y = a.top - mh - gap;
  if (y < gap) y = a.bottom + gap;
  var room = Math.max(a.top - gap * 2, vh - a.bottom - gap * 2);
  var cap = Math.max(160, Math.min(Math.round(vh * 0.8), room));
  if (mh > cap) {
    menu.style.maxHeight = cap + "px";
    menu.style.overflowY = "auto";
    mh = cap;
    y = a.top - mh - gap;
    if (y < gap) y = a.bottom + gap;
  }
  if (y + mh > vh - gap) y = Math.max(gap, vh - mh - gap);
  var x = a.left;
  if (x + mw > vw - gap) x = vw - mw - gap;
  if (x < gap) x = gap;
  menu.style.left = Math.round(x) + "px";
  menu.style.top = Math.round(y) + "px";
  /* ④ 的落地(F12 口径):**必须放在最后一行** —— 写早了不生效。实测(探针 `tmp/p1fix/probe-scroll.js`):
     关掉后元素无盒(`display:none`),`classList.add("open")` 一让它有盒,浏览器会**把上次的内滚偏移
     还回来**,并在 cap/overflow 落地的那一刻再次施加;而"清空 cap(overflow:visible)"期间元素**不是
     滚动容器**,此时写 `scrollTop` 会被丢弃 ⇒ 复位若写在前面,重开仍是旧值(本轮实测 200)。
     与 F12 三面同形:`openPalette` 的注释也写着"遮罩未显示时元素无盒,写 scrollTop 不生效"。 */
  menu.scrollTop = 0;
}
/* 定点放置(右键菜单用):以鼠标位置为左上角,四边夹紧在视口内。
   与 placeMenu 并列、不替换 —— 后者是「贴着锚点上方」语义,右键没有锚点元素。
   高度超过视口时自身滚动(超高菜单在窄屏抽屉形态下同样不出屏)。
   内滚偏移同样按 placeMenu ④ 的 F12 口径回零(同一 `#pop-menu` 单例:右键菜单重开不留在上次滚位) */
function placeMenuAt(menu, x, y) {
  menu.classList.add("open");
  menu.style.maxHeight = "";
  menu.style.overflowY = "";
  var vh = window.innerHeight, vw = window.innerWidth;
  var r = menu.getBoundingClientRect();
  if (r.height > vh - 16) {
    menu.style.maxHeight = (vh - 16) + "px";
    menu.style.overflowY = "auto";
    r = menu.getBoundingClientRect();
  }
  if (x + r.width > vw - 8) x = vw - r.width - 8;
  if (y + r.height > vh - 8) y = y - r.height;      /* 右下放不下就往上翻(菜单底边贴鼠标) */
  if (x < 8) x = 8;
  if (y < 8) y = 8;
  menu.style.left = x + "px";
  menu.style.top = y + "px";
  menu.scrollTop = 0;   /* ④ 落地:同 placeMenu —— 必须在 cap 落地之后(写早了会被浏览器还原的旧偏移覆盖) */
}
/* 浮层贴着触发按钮:优先放正上方(与「插入提示词模板」菜单同一套做法),
   上面放不下才翻到下方;太高时自身滚动,保证始终贴着按钮且不出屏。
   左右按 align 对齐按钮的两侧。调用前浮层必须已显示。 */
function placePopover(pop, anchor, opts) {
  if (!pop || !anchor) return;
  opts = opts || {};
  var w = Math.round(opts.width || pop.offsetWidth || 320);
  var gap = 10;
  pop.style.maxHeight = "none";
  pop.style.overflowY = "visible";
  var h = Math.round(pop.offsetHeight || 0);
  var a = anchor.getBoundingClientRect();
  var vw = window.innerWidth, vh = window.innerHeight;
  var spaceAbove = a.top - gap - 10;
  var spaceBelow = vh - a.bottom - gap - 10;
  var useAbove = spaceAbove >= Math.min(h, opts.preferAbove || 220);
  var avail = useAbove ? spaceAbove : spaceBelow;
  var cap = Math.max(160, Math.min(Math.round(vh * 0.8), avail));
  if (h > cap) {
    pop.style.maxHeight = cap + "px";
    pop.style.overflowY = "auto";
  }
  var drawH = Math.min(h, cap);
  var y = useAbove ? (a.top - gap - drawH) : (a.bottom + gap);
  if (y + drawH > vh - 10) y = vh - drawH - 10;
  if (y < 10) y = 10;
  var x = (opts.align === "right") ? (a.right - w) : a.left;
  if (x + w > vw - 10) x = vw - w - 10;
  if (x < 10) x = 10;
  pop.style.position = "fixed";
  pop.style.right = "auto";
  pop.style.bottom = "auto";
  pop.style.width = w + "px";
  pop.style.left = Math.round(x) + "px";
  pop.style.top = Math.round(y) + "px";
  pop.setAttribute("data-placement", useAbove ? "top" : "bottom");
}
function repositionPops() {
  if ($("params-pop").classList.contains("open")) {
    placePopover($("params-pop"), $("btn-params"), { align: "left", width: 320 });
  }
  if ($("ctx-pop").classList.contains("open")) {
    placePopover($("ctx-pop"), $("ctx-meter"), { align: "right", width: 344 });
  }
}

/* ---------------------------------------------------------------------------
   15. API 层(OpenAI 兼容 / Anthropic Messages)
--------------------------------------------------------------------------- */
function apiUrl(path) {
  var b = (state.settings.baseUrl || "").trim().replace(/\/+$/, "");
  if (!b) return "";
  if (/\/(v1|api\/v1)$/.test(b)) return b + (path ? "/" + path : "");
  return b + "/v1/" + path;
}
/* 预检规避兼容模式(默认关;门控 + 前置探针见下面「CORS 分层」节的 corsBypassGate / setCorsBypass):
   请求改发「简单请求」—— Content-Type 取 CORS 安全清单内的 text/plain,且不带任何自定义头,
   浏览器因此不发 OPTIONS 预检。关闭(或门控不满足)时本函数逐字节不变。 */
function headersFor(withBody) {
  if (corsBypassOn()) return corsBypassHeaders(withBody);
  var h = { "Accept": "text/event-stream, application/json" };
  if (withBody !== false) h["Content-Type"] = "application/json";
  var key = (state.settings.apiKey || "").trim();
  if (state.settings.protocol === "openai") {
    if (key) h["Authorization"] = "Bearer " + key;
  } else {
    if (key) h["x-api-key"] = key;
    h["anthropic-version"] = "2023-06-01";
    h["anthropic-dangerous-direct-browser-access"] = "true";
  }
  return h;
}
function errText(e) {
  if (!e) return "未知错误";
  if (e.name === "AbortError") return "请求已取消";
  return e.message || String(e);
}
/* 第三参数 family 缺省 ⇒ 缺省分支文案**逐字不变**;family ∈ {preflight, acao, net, timeout, textplain}
   = 「CORS 分层」节四探针判定的 CORS 族,传入后把浏览器一律报成 `Failed to fetch` 的那条链拆开说清,
   并给出可执行的下一步(服务端要补哪些头 / 改用同源反向代理 / 关掉兼容模式)。
   ⚠ **族分支在产线不可达**(C2 审查 P3-5 登记;依据 = 调用点普查):本函数全库 6 个调用点
   (886 / 3515 / 5234 / 5296 / 5345 / 5953)全部只传 ≤2 参 ⇒ fam 恒为空,产线只会看到缺省文案;
   族级文案当前从 CORS_FAMILY_TEXT 的三条消费路径露出(诊断面板结论行 + 开关被拒时的红字 note
   + 开关开启成功时的绿字 note,后者见 setCorsBypass 的成功分支)。
   该分支为将来「把族接到发送失败路径」保留,不按死代码删。 */
function friendlyError(e, url, family) {
  var msg = errText(e);
  var fam = (family && CORS_FAMILY_TEXT && CORS_FAMILY_TEXT[family] && family !== "ok" && family !== "unknown") ? family : "";
  if (e && e.name === "AbortError") return "已超时或已取消";
  if (/Failed to fetch|NetworkError|Load failed/i.test(msg)) {
    msg = fam ? ("无法连接到服务器:" + corsFamilyText(fam).label + "\n" + corsFamilyAdvice(fam))
              : "无法连接到服务器(网络不可达、地址错误或被跨域策略拦截)";
  } else if (/ERR_CONNECTION_REFUSED|ECONNREFUSED|拒绝/i.test(msg)) {
    msg = "连接被拒绝:请确认服务已启动,且地址与端口正确";
  } else if (fam) {
    msg = msg + "\n" + corsFamilyAdvice(fam);
  }
  return msg + (url ? "\n目标地址:" + url : "");
}
function safeJson(text, limit) {
  if (!text) return "";
  return text.length > (limit || 400) ? text.slice(0, limit || 400) + "…" : text;
}

/* ---- 工具媒体进请求的三种装配(单一来源;§3.4/§3.8.3) ----
   · trimToolMediaForRequest:聊天轮软护栏(非破坏性;摘要请求不调用);
   · stripToolMediaForWire:结构类 4xx 降级(noToolMedia)时去掉 media(工具文本照发);
   · expandToolMediaForOpenAI:OpenAI 兼容形态,按工具轮分组插一条合成 user(只进请求体)。
   常量(TOOL_MEDIA_CHAT_*)在 appE(本段之后)⇒ 只在函数体内取,不在模块级读。 */
function trimToolMediaForRequest(list) {
  var keepN = TOOL_MEDIA_CHAT_KEEP_ITEMS, maxBytes = TOOL_MEDIA_CHAT_MAX_BYTES;
  var idx = [], i, j;
  for (i = 0; i < list.length; i++) {
    var m = list[i];
    if (m && m.role === "tool" && m.media && m.media.length) idx.push(i);
  }
  if (!idx.length) return list;
  var keepFrom = Math.max(0, idx.length - keepN);      /* 只裁**更早**的:当前工具轮的图永不被裁 */
  var cut = {}, bytes = 0, any = false;
  for (i = idx.length - 1; i >= 0; i--) {
    var it = list[idx[i]], sz = 0;
    for (j = 0; j < it.media.length; j++) sz += String((it.media[j] && it.media[j].data) || "").length;
    if (i >= keepFrom && bytes + sz <= maxBytes) { bytes += sz; continue; }
    cut[idx[i]] = true; any = true;
  }
  if (!any) return list;
  var out = list.slice();
  for (var k in cut) {
    if (!Object.prototype.hasOwnProperty.call(cut, k)) continue;
    var src = out[k], copy = {}, key;
    for (key in src) if (Object.prototype.hasOwnProperty.call(src, key) && key !== "media") copy[key] = src[key];
    copy.content = String(src.content == null ? "" : src.content) + "\n[图像已省略:超出请求体积上限,需要时可重新读取]";
    out[k] = copy;
  }
  return out;
}
function stripToolMediaForWire(list) {
  var out = [], changed = false, i, key;
  for (i = 0; i < list.length; i++) {
    var m = list[i];
    if (m && m.role === "tool" && m.media && m.media.length) {
      var copy = {};
      for (key in m) if (Object.prototype.hasOwnProperty.call(m, key) && key !== "media") copy[key] = m[key];
      out.push(copy); changed = true;
    } else out.push(m);
  }
  return changed ? out : list;
}
/* OpenAI 兼容:tool 消息 content 只认字符串 ⇒ 把同一工具轮(连续 role==="tool" 段)的媒体合并成
   **一条**合成 user 消息,插在该段最后一条 tool 之后(跨段不合并 ⇒ 不产出 tool→user→tool 交错)。
   非破坏性:带 media 的项浅拷贝并删掉内部 media 字段(msgList 与 payload 共享对象,就地删会把
   下一轮的图也删掉);合成消息只在请求体里存在:不落盘、不进界面、文案写明「这不是用户的新提问」。 */
function expandToolMediaForOpenAI(list) {
  var out = [], i;
  for (i = 0; i < list.length; i++) {
    var m = list[i];
    if (!m || m.role !== "tool" || !m.media || !m.media.length) { out.push(m); continue; }
    var j = i, media = [], paths = [];
    while (j < list.length && list[j] && list[j].role === "tool") {
      var src = list[j];
      if (src.media && src.media.length) {
        var copy = {}, key;
        for (key in src) if (Object.prototype.hasOwnProperty.call(src, key) && key !== "media") copy[key] = src[key];
        out.push(copy);
        for (var k = 0; k < src.media.length; k++) {
          var im = src.media[k] || {};
          media.push(im);
          if (im.path) paths.push(im.path);
          else if (im.label) paths.push(im.label);
        }
      } else out.push(src);
      j++;
    }
    if (media.length) {
      var parts = [{ type: "text", text: "以下是工具读取的 " + media.length + " 个文件" +
        (paths.length ? "(" + paths.join("、") + ")" : "") + "的图片内容,请据此继续完成任务(这不是用户的新提问)" }];
      for (var q = 0; q < media.length; q++) parts.push(imagePartFor("openai", media[q].mime, media[q].data, null));
      out.push({ role: "user", content: parts });
    }
    i = j - 1;
  }
  return out;
}
/* 结构类 4xx 分类器(与 b25 cxIsOverflowError 同范式:显式状态码集合 + 显式正则):
   只匹配「消息/工具结构」类报文,不误伤配额 / 鉴权 / 模型不存在(那三类走既有失败路径) */
function isToolMediaStructureError(err) {
  if (!err) return false;
  var st = Number(err.__httpStatus);
  if (st !== 400 && st !== 422) return false;
  return /tool_call|tool_calls|tool_use|tool_result|tool role|messages\[\d+\]|Invalid.*(tool|content|message)|content.*(type|must)|unexpected.*(role|content)/i.test(String(err.message || ""));
}

/* 组装将要发送的消息(带上下文裁剪)。
   opts(缺省 undefined ⇒ 既有行为逐字节不变):
     noCap : true = 绕过「携带历史条数上限(ctxMsgs)」截断 —— **仅压缩请求用**
            (摘要输入必须是完整历史;聊天轮不传,语义不变) */
function payloadMessages(baseList, opts) {
  if (!conv && !baseList) return { list: [], truncated: false, tokens: 0 };
  var noCap = !!(opts && opts.noCap === true);
  var src = baseList || conv.messages;
  var all = [];
  for (var i = 0; i < src.length; i++) {
    var m = src[i];
    if (m.error) continue;
    /* 工具结果:必须回传,否则模型会因为缺少 tool_call 的应答而报错。
       media(内联图片)是**payload 项内部字段**:不落盘、不进 wire,由 openai 分支的
       expandToolMediaForOpenAI / anthropic 分支按规范各自展开(见 §3.4) */
    if (m.role === "tool") {
      var tItem = {
        role: "tool",
        content: m.content || (m.status === "wait" ? "用户尚未确认执行" : "工具未执行"),
        tool_call_id: m.toolCallId,
        name: m.toolName
      };
      if (m.media && m.media.length) tItem.media = m.media;
      all.push(tItem);
      continue;
    }
    if (m.streaming) continue;
    var hasCalls = m.role === "assistant" && m.toolCalls && m.toolCalls.length;
    if (!hasCalls && m.role === "assistant" && !contentToText(m.content).trim()) continue;
    if (m.role === "user" && !contentToText(m.content).trim() && typeof m.content === "string") continue;
    var item = { role: m.role, content: protocolContent(m.content, state.settings.protocol) };
    if (hasCalls) item.tool_calls = apiToolCalls(m.toolCalls);
    all.push(item);
  }
  var s = state.settings;
  var list = all, truncated = false;
  if (!noCap && s.ctxMsgs > 0 && list.length > s.ctxMsgs) {
    list = list.slice(list.length - s.ctxMsgs);
    truncated = true;
    /* 截断后开头若是孤立的工具结果:只补一条说明**修不好结构** —— 服务端会因为
       「找不到对应的 tool_call / tool_use」直接 400(Anthropic 更严格),而且
       history-union 只能保住 body.tools 里的定义、保不住消息结构。
       所以这里把开头这些「已经没有对应调用」的 tool 消息一并丢掉,再用一句说明交代省略
       (复现:ctxMsgs=2 + 末两条为 tool/user 时,截断后 payload 首条就是 role:"tool") */
    var orphan = false;
    while (list.length && list[0].role === "tool") { list = list.slice(1); orphan = true; }
    if (orphan) list = [{ role: "user", content: "(较早的工具调用记录已因历史条数限制被省略)" }].concat(list);
  }
  var tokens = 0;
  list.forEach(function (m) {
    tokens += estimateContentTokens(m.content);
    /* 工具媒体必须计入(否则用量环 / 自动压缩低估);调用点清单见方案 §3.12-2 */
    tokens += estimateToolMediaTokens(m);
