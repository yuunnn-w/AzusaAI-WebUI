}
function corsBypassOn() { return !!state.settings.corsPreflightBypass && corsBypassGate().ok; }
/* 兼容模式下的请求头:Content-Type 取 CORS 安全清单内的 text/plain,且**不带任何自定义头** */
function corsBypassHeaders(withBody) {
