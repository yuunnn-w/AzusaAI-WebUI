    try { ok = !!c[1](); } catch (e) { ok = false; }
    return "<dt>" + escapeHtml(c[0]) + "</dt><dd class='" + (ok ? "ok" : "bad") + "'>" + (ok ? "可用" : "不可用") + "</dd>";
  }).join("");
