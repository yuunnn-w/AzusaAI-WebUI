  });
}
/* PDF:首页图(最多 8 页,转成弹窗认识的 {mime,data(裸 base64),label}) + 文字,两者并发、互不影响 */
function wsPreviewPdf(name, buf, size) {
  var jobs = [];
  jobs.push(window.PDFKit.renderPages(buf, { dpi: 110, maxPages: WS_PREVIEW_PDF_PAGES, format: "image/jpeg", quality: 0.82 })
    .then(function (r) {
      if (!r || !r.ok) return null;
      return (r.images || []).map(function (im, i) {
        return { mime: "image/jpeg", data: dataUrlPayload(im.dataUrl), label: "第 " + ((im.page || (i + 1))) + " 页" };
      });
    }, function () { return null; }));
  jobs.push(window.PDFKit.extractText(buf, { maxPages: 50, maxChars: 200000 })
    .then(function (r) { return (r && r.ok) ? r : null; }, function () { return null; }));
  return Promise.all(jobs).then(function (out) {
    var images = out[0] || [], txt = out[1];
    if (!images.length && !txt) {
      openFilePreview(name, "", { kind: "pdf", size: size, wsPreview: true, failed: "解析失败或文件已损坏" });
      return;
    }
    openFilePreview(name, txt ? txt.text : "", {
      kind: "pdf", size: size, wsPreview: true, mode: "text", pages: (txt && txt.pages) || images.length,
      images: images, clipped: !!(txt && txt.truncated), pdfPages: images.length
    });
  });
}

/* ---- 申请持久化存储 ---- */
var WS_PERSIST_STATE = { checked: false, granted: false };
function wsPersistBtnSync() {
  var b = $("btn-wsr-persist");
  if (b) {
    if (WS_PERSIST_STATE.granted) {
      b.disabled = true;
      b.textContent = "已授予持久化存储";
      b.title = "浏览器已把本页数据标记为「持久化」:磁盘空间紧张时也不会被自动清理。";
    } else {
      b.disabled = false;
      b.textContent = "申请持久化存储";
      b.title = "请浏览器把本页的本地数据标记为「持久化」,尽量不被自动清理。" +
        "Chrome 106 起不再弹授权框、改为按其内部条件静默授予,未命中时立刻返回「未授予」—— 这是正常现象,不影响数据读写。";
    }
  }
  if (!WS_PERSIST_STATE.checked && navigator.storage && typeof navigator.storage.persisted === "function") {
    WS_PERSIST_STATE.checked = true;   /* 只查一次;失败静默 */
    navigator.storage.persisted().then(function (v) {
      WS_PERSIST_STATE.granted = !!v;
      wsPersistBtnSync();
    }, function () {});
  }
}
function wsPersistRequest() {
  var st = navigator.storage;
  if (!st || typeof st.persist !== "function") { toast("当前浏览器不支持申请持久化存储", "warn", 4200); return; }
  st.persist().then(function (granted) {
    WS_PERSIST_STATE.checked = true;
    WS_PERSIST_STATE.granted = !!granted;
    wsPersistBtnSync();
    toast(granted
      ? "已获得持久化存储:浏览器不会再自动清理本页数据"
      : "浏览器未授予持久化存储(正常现象:Chrome 106 起不再弹授权框,只在满足其内部条件时静默授予)。" +
        "数据仍完整保存在本机,只在磁盘空间紧张时可能被系统回收;建议偶尔用「导出全部」备份。",
      granted ? "success" : "info", 6400);
  }, function () { toast("申请持久化存储失败", "error", 4200); });
}

/* ---- 上传链:单文件与批量同一入口,Blob 直存 IDB ---- */
function wsNormalizeUpload(file, relPath) {
  var rel = String(relPath || (file && file.webkitRelativePath) || (file && file.name) || "");
  rel = rel.replace(/\\/g, "/").replace(/[\u0000-\u001f\u007f]/g, "").replace(/\/+/g, "/");
  var segs = rel.split("/").filter(function (s) { return !!s && s !== "." && s !== ".."; });
  var out = [], i;
  for (i = 0; i < segs.length && out.length < WS_DEPTH_MAX; i++) {
    var s = segs[i].replace(/[. ]+$/, "");     /* 结尾的点/空格在 Unix 语义盘里是坑 */
    if (!s) continue;
    if (s.length > WS_SEG_MAX) s = s.slice(0, WS_SEG_MAX);
    out.push(s);
  }
  if (!out.length) return { ok: false, error: "文件名不合法(去掉路径分隔符后为空)" };
  var joined = out.join("/");
  if (wsJoinPath("/", joined).length > WS_PATH_MAX) return { ok: false, error: "路径过长(超过 " + WS_PATH_MAX + " 字符)" };
  return { ok: true, rel: joined, name: out[out.length - 1] };
}
/* webkitGetAsEntry() 递归取文件,按相对路径保留目录结构;不支持则平铺。
   返回 { list: [{file, rel}], failed: 读不出来的条目数 } —— failed 让调用方能给**可操作**的
   错误提示,而不是把「一个都没解析出来」混同于「拖了个空」(旧实现是静默 resolve 空数组)。
   robust:isFile / isDirectory 两个标记都缺失、但带 .file() 的 entry 也当文件试读一次
   (旧实现只认 en.isFile === true,形状不认识的条目被静默丢掉) */
function wsCollectEntries(entries) {
  var out = [], queue = [], i, failed = 0;
  for (i = 0; i < entries.length; i++) {
    var en = entries[i];
    if (!en) { failed++; continue; }
    if (en.__file) { out.push({ file: en.__file, rel: en.__file.webkitRelativePath || en.__file.name }); continue; }
    queue.push({ entry: en, prefix: "" });
  }
  function pump() {
    if (!queue.length) return Promise.resolve({ list: out, failed: failed });
    var job = queue.shift();
    var en = job.entry;
    var rel = (job.prefix ? (job.prefix + "/" + en.name) : en.name) || "未命名项";
    if (en.isDirectory === true) {
      if (typeof en.createReader !== "function") { failed++; return pump(); }
      return new Promise(function (res) {
        var reader = en.createReader(), kids = [];
        (function more() {
          reader.readEntries(function (batch) {
            if (!batch || !batch.length) { res(kids); return; }
            for (var j = 0; j < batch.length; j++) kids.push(batch[j]);
            more();       /* readEntries 一次只给一批,要读到空数组为止 */
          }, function () { failed++; res(kids); });
        })();
      }).then(function (kids) {
        for (var j = 0; j < kids.length; j++) queue.push({ entry: kids[j], prefix: rel });
        return pump();
