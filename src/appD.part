/* 把面板上所有信息拍成纯文本,方便贴到 issue / 聊天里上报 */
function envReportText() {
  var secs = [["运行环境自检", "env-kv"], ["系统与设备", "env-sys"], ["页面信息", "env-info"],
    ["显示与图形", "env-gpu"], ["存储与配额", "env-store"]];
  var out = ["AzusaAI WebUI 环境信息 v" + APP_VERSION + " · " + new Date().toLocaleString()];
  secs.forEach(function (sec) {
    var el = $(sec[1]);
    if (!el) return;
    var kids = el.children, lines = [], i;
    for (i = 0; i + 1 < kids.length; i += 2) lines.push("  " + kids[i].textContent + ": " + kids[i + 1].textContent);
    if (lines.length) out.push("[" + sec[0] + "]\n" + lines.join("\n"));
  });
  var diag = $("diag-result");
  if (diag && diag.textContent && diag.textContent.indexOf("正在自检") !== 0) out.push("[最近一次诊断]\n" + diag.textContent);
  return out.join("\n");
}
/* 连不上时给一句能落地的提示:绝大多数是「地址是本机端口但服务不在」或「跨域 / 网络不通」 */
function connectHint(url) {
  var host = "";
  try { host = String(url).replace(/^[a-z]+:\/\//i, "").split("/")[0]; } catch (e) {}
  if (/^(localhost|127\.0\.0\.1|\[::1\])(:\d+)?$/i.test(host)) {
    return "提示:该地址是本机端口,浏览器只会在「运行本页的这台机器」上找服务。确认服务已启动、端口没写错;若服务在别的机器上,请把 localhost 换成它的 IP。";
  }
  return "提示:确认地址与端口正确、服务已启动;若服务在别的机器上,注意服务端需要允许跨域(CORS),手机/平板访问时不要用 localhost。";
}
async function runDiagnostics() {
  var box = $("diag-result");
  box.className = "note show";
  box.textContent = "正在自检…";
  var lines = [];
  lines.push("· 页面:v" + APP_VERSION + " · " + (location.protocol === "file:" ? "本地文件(file://)" : location.protocol + "//" + location.host));
  lines.push("· 本地存储:" + (storageBroken ? "不可用(数据仅保存在内存)" : "正常") + " · 占用 " + fmtBytes(storageBytes()));
  lines.push("· 数据:" + state.conversations.length + " 个对话 / " + msgTotal() + " 条消息");
  var bad = false;
  var url = apiUrl("models");
  if (!url) {
    bad = true;
    lines.push("· 接口:未配置 Base URL(到「模型」栏目填写,或点预置按钮)");
  } else {
    lines.push("· 接口地址:" + url);
    var t0 = Date.now(), to = timeoutSignal(15000);
    try {
      var r = await fetch(url, { headers: headersFor(false), signal: to.signal });
      var ms = Date.now() - t0;
      if (r.ok) {
        var j = null;
        try { j = await r.json(); } catch (e0) {}
        var n = j ? ((j.data || j.models || []).length) : 0;
        lines.push("· 接口:可达 · " + ms + " ms" + (n ? " · 返回 " + n + " 个模型" : ""));
      } else {
        bad = true;
        lines.push("· 接口:能连上,但返回 HTTP " + r.status + "(地址多半写错了,或该服务不支持 /v1/models)");
      }
    } catch (e) {
      bad = true;
      lines.push("· 接口:不可达 — " + friendlyError(e, "").split("\n")[0]);
      lines.push("  " + connectHint(url));
    } finally { to.abort(); }
  }
  /* 可见性旁路:开关状态与计数从 mcpStatusInfo() 派生,不在这里按 toolsEnabled 早退 */
  var mcpInfo = mcpStatusInfo(conv);
  lines.push("· MCP 工具:" + (mcpInfo.on
    ? "已开启(" + mcpInfo.activeCount + " / " + mcpInfo.totalCount + " 个工具,本轮已调用 " + toolTurnCount() + " 次)"
    : "已关闭"));
  /* 外部 MCP(同上):连接状态按真实状态机写明,不再是一句「未接入」;
     开启判定一律走 extToolsOn()(会话级覆盖优先);覆盖值择一写明,不重复 */
  var extCfg = mcpServerCfg();
  var extOv = extToolsOverride(conv);
  var extLine;
  if (!extToolsOn(conv)) {
    extLine = (extOv === false ? "本会话已覆盖为关闭(全局默认开着也只对别的会话生效)"
      : "未开启") + "(设置 → MCP 工具 → 外部 MCP 服务器)";
  } else if (!extCfg) extLine = "已开启,但没有服务器配置";
  else if (mcpState.phase === "ready") {
    extLine = "已连接 " + extCfg.name + (mcpState.serverInfo ? " · " + mcpState.serverInfo : "") +
      " · 协议 " + (mcpState.protoVersion || "?") + " · " + mcpTools().length + " 个工具(可用 " +
      mcpActiveTools().length + " 个)";
  } else if (mcpState.phase === "connecting") extLine = "正在连接 " + extCfg.url + " …";
  else if (mcpState.phase === "error") extLine = "连接失败:" + (mcpState.lastErr || "未知原因");
  else extLine = "已开启但尚未连接(点「测试连接」)";
  /* 覆盖为关时主句已写明原因(上面那一支),行尾再标一次是重复;只有覆盖为开时主句没提,才补标 */
  if (extOv === true) extLine += "(本会话覆盖为开)";
  lines.push("· 外部 MCP 工具:" + extLine);
  lines.push("· 沙箱:" + (CAP.worker ? "可用(Web Worker)" : "不可用(缺少 Web Worker / Blob)"));
  lines.push("· 公式渲染:" + (hasKatex ? "正常" : "不可用"));
  lines.push("· 内嵌库:pdf.js " + (window.PDFKit ? (window.PDFKit.version || "?") : "未加载") +
    " · Tesseract.js " + (window.OCRKit ? (window.OCRKit.version || "?") : "未加载"));
  box.className = "note show" + (bad ? " err" : " ok");
  box.textContent = (bad ? "自检完成(有需要处理的项目)\n" : "自检完成\n") + lines.join("\n");
}
function storageBytes() {
  try { return (localStorage.getItem(LS_KEY) || "").length; } catch (e) { return 0; }
}
/* ---- 存储容量:精确探测 ----
   1) StorageManager.estimate() 给的是「整个站点的配额」(含 IndexedDB / Cache),不是 localStorage 的上限;
   2) localStorage 的真实上限只能靠写入探测:先倍增找上界,再二分收敛(1MB 粒度)。
   实测本机 Chrome:单个 origin 约 5M 字符(≈5MB UTF-16 前的字符数口径)。 */
var storageProbe = { done: false, limitChar: 0, freeChar: 0, sites: null, at: 0 };
function probeLocalStorageLimit() {
  var key = "__ls_cap_probe__";
  var probeChar = 0;
  function tryWrite(n) {
    try {
      localStorage.setItem(key, n > 0 ? new Array(n + 1).join("x") : "");
      return true;
    } catch (e) {
      return false;
    } finally {
      try { localStorage.removeItem(key); } catch (e2) {}
    }
  }
  if (!tryWrite(0)) return Promise.resolve(null);
  var step = 1 * 1024 * 1024, hi = 0, guard = 0;
  while (hi < 96 * 1024 * 1024 && tryWrite(hi + step) && guard++ < 12) hi += step;
  var lo = hi, up = hi + step;
  for (var i = 0; i < 8; i++) {
    var mid = Math.floor((lo + up) / 2);
    if (tryWrite(mid)) lo = mid; else up = mid;
  }
  probeChar = lo;
  storageProbe.freeChar = probeChar;
  storageProbe.limitChar = storageBytes() + probeChar;
  storageProbe.done = true;
  storageProbe.at = Date.now();
  /* StorageManager:给出站点总配额(仅 http(s) 下可用,file:// 一般是 undefined) */
  var est = (navigator.storage && navigator.storage.estimate) ? navigator.storage.estimate() : null;
  if (est) {
    return est.then(function (r) {
      storageProbe.sites = { usage: (r && r.usage) || 0, quota: (r && r.quota) || 0 };
      return storageProbe;
    }, function () { return storageProbe; });
  }
  return Promise.resolve(storageProbe);
}
function storageLimitHint() {
  if (storageProbe.done) {
    return "实测:localStorage 已用 " + fmtBytes(storageBytes()) + ",还可写约 " + fmtBytes(storageProbe.freeChar) +
      "(上限约 " + fmtBytes(storageProbe.limitChar) + ",按字符数实测)";
  }
  return "localStorage 的配额由浏览器写死(Chrome 是 5MB,与上面那个几十 GB 的「站点总配额」不是一个池子)。" +
    "点上面的「精确探测可用空间」可以实测出真实上限与剩余可写量。";
}
/* 分项统计:找出到底是谁占了空间 */
function storageBreakdown() {
  var out = { settings: 0, list: [] };
  try { out.settings = JSON.stringify(state.settings).length; } catch (e) {}
  var arr = state.conversations.map(function (c) {
    var n = 0;
    try { n = JSON.stringify(c).length; } catch (e) { n = 0; }
    return { id: c.id, title: c.title || "(无标题)", n: n, msgs: c.messages.length, model: c.model || "" };
  });
  arr.sort(function (a, b) { return b.n - a.n; });
  out.list = arr;
  return out;
}
function updateStorageMeter() {
  var bytes = storageBytes();
  var limit = storageProbe.done && storageProbe.limitChar > 0 ? storageProbe.limitChar : 5 * 1024 * 1024;
  var pct = Math.min(100, bytes / limit * 100);
  var meter = $("ds-meter");
  if (meter) {
    meter.className = "meter" + (pct > 92 ? " err" : pct > 72 ? " warn" : "");
    meter.firstChild.style.width = pct.toFixed(1) + "%";
  }
  var s = $("ds-size");
  if (s) {
    s.textContent = fmtBytes(bytes) + " / " + (storageProbe.done ? "实测上限 " : "约 ") +
      fmtBytes(limit) + "(" + pct.toFixed(1) + "%)";
  }
}
function renderDataPanel() {
  renderWsDataPanel();      /* 工作区区:与「本地存储」同一页,单独一段渲染 */
  blobStats().then(function (st) { renderDataPanelText(st); }, function () { renderDataPanelText(null); });
  var msgs = 0;
  state.conversations.forEach(function (c) { msgs += c.messages.length; });
  $("ds-convs").textContent = String(state.conversations.length);
  $("ds-msgs").textContent = String(msgs);
  var setRow = $("ds-settings");
  if (setRow) setRow.textContent = fmtBytes(storageBytes());
  updateStorageMeter();
  blobStats().then(function (st) {
    var totRow = $("ds-total");
    if (!totRow) return;
    var convChars = 0;
    storageBreakdown().list.forEach(function (x) { convChars += x.n; });
    totRow.textContent = fmtBytes(convChars + ((st && st.chars) || 0)) +
      "(对话 " + fmtBytes(convChars) + " · 附件 " + ((st && st.count) || 0) + " 个 " + fmtBytes((st && st.chars) || 0) + ")";
  }, function () {});
  renderDataPanelText(null);
}
/* 面板里那段多行说明:IndexedDB 统计是异步来的,单独抽成函数方便两处调用 */
function renderDataPanelText(blobInfo) {
  var hint = $("ds-hint");
  if (!hint) return;
  hint.className = "hint gap-top multi";
  if (storageBroken) {
    hint.textContent = "⚠ 当前浏览器禁用了 localStorage(可能处于隐私模式),数据只能保存在内存中,刷新即丢失。";
  } else {
    var lines = [];
    if (!convsInIdb()) {
      lines.push("⚠ 本机大仓库(IndexedDB)不可用,所有数据都挤在 localStorage 的 5MB 里。");
      if (blobStore.note) lines.push(blobStore.note);
    }
    if (autoTidyStat) {
      var tp = [];
      if (autoTidyStat.migratedConvs) tp.push("迁移 " + autoTidyStat.migratedConvs + " 个对话");
      if (autoTidyStat.moved) tp.push("搬入 " + autoTidyStat.moved + " 个附件");
      if (autoTidyStat.removed) tp.push("回收 " + autoTidyStat.removed + " 条无用记录");
      if (tp.length) lines.push("打开时已自动整理:" + tp.join("、") + "。");
    }
    hint.textContent = lines.join("\n");
    hint.style.display = lines.length ? "" : "none";
  }
  /* 占用排行:体积从大到小、最多 20 条(一次露 3 条,其余滚动),每行右侧显示占用并提供「压缩 / 删除」 */
  var box = $("ds-rank");
  if (box) {
    var rank = storageBreakdown().list.filter(function (x) { return x.n > 512; }).slice(0, 20);
    if (!rank.length) {
      box.innerHTML = '<div class="hint" style="padding:9px 0">还没有对话数据</div>';
    } else {
      box.innerHTML = rank.map(function (x) {
        return '<div class="rank-row" data-conv="' + escAttr(x.id) + '">' +
          '<div class="rr-main"><div class="rr-name" title="' + escAttr(x.title) + '">' + escapeHtml(x.title) + '</div>' +
          '<div class="rr-sub">' + x.msgs + " 条消息 · " + escapeHtml(x.model || "—") + '</div></div>' +
          '<div class="rr-size">' + fmtBytes(x.n) + '</div>' +
          '<div class="rr-ops">' +
          '<button class="btn xs" data-rank="compress" title="只保留这个对话最近 80 条消息(纯空间回收,不生成总结)">精简历史（只留最近 80 条）</button>' +
          '<button class="btn xs danger" data-rank="del" title="删除这个对话">删除</button>' +
          '</div></div>';
      }).join("");
    }
  }
  if (box && !box.__rankBound) {
    box.__rankBound = 1;
    box.addEventListener("click", function (e) {
      var t = e.target;
      var btn = t && t.closest ? t.closest("[data-rank]") : null;
      if (!btn) return;
      var row = btn.closest("[data-rank]") ? btn.closest(".rank-row") : null;
      if (!row) return;
      var cid = row.getAttribute("data-conv");
      var c = getConv(cid);
      if (!c) return;
      var guardMsg = isProtectedConv(cid)
        ? ("注意:「" + (c.title || "") + "」属于最近 " + cleanKeepRecent() + " 个对话(保护范围内)。这里是手动点单条,不受保护范围限制。 ")
        : "";
      if (btn.getAttribute("data-rank") === "del") {
        /* 确认框是异步的:确认后按 id 再查一次(弹窗开着时对侧 / 本页别处可能已经删掉它) */
        askConfirm({
          title: "删除对话", icon: "trash", okText: "删除",
          message: guardMsg + "删除对话「" + (c.title || "") + "」?这会连同它的 " + c.messages.length +
            " 条消息一起删除(附件数据也会回收),无法撤销。建议先「导出全部(JSON)」备份。"
        }, function () { if (getConv(cid)) deleteConv(cid, true); });
      } else {
        if (c.messages.length <= 80) { toast("这个对话只有 " + c.messages.length + " 条消息,不用压缩", "info", 2600); return; }
        askConfirm({
          title: "精简历史（只留最近 80 条）", icon: "eraser", okText: "精简",
          message: guardMsg + "精简「" + (c.title || "") + "」?只保留最近 80 条消息,当前 " + c.messages.length +
            " 条,会删掉较早的 " + (c.messages.length - 80) + " 条(含其附件),无法撤销。" +
            "如果只是想腾出模型窗口,请改用「压缩上下文」(会先生成一份交接总结)。"
        }, function () { compressOneConv(cid); });
      }
    });
  }
  var probeBtn = $("btn-probe-storage");
  if (probeBtn) probeBtn.classList.toggle("on", storageProbe.done);
}
/* 只压缩某一个对话:留下最近 80 条,顺手删掉每条上的统计冗余。
   ★ 语义 = 纯**空间回收**的「精简历史」,与「压缩上下文」(Compact / 自动压缩)不是同一件事:
   后者生成交接总结并按 token 预算保留尾部,这里只是按条数砍到 80 */
function compressOneConv(id) {
  var c = getConv(id);
  if (!c) return 0;
  var before = c.messages.length;
  var drop = before - 80;
  if (drop > 0) {
    /* 丢弃区间走统一原语 + 释放(顺带修掉既有"删消息不释放附件"的孤儿缺陷) */
    var r = cxDropMessages(c, 0, drop - 1);
    var p = cxReleasePlan(r.keys);
    if (p.todo.length) cxReleaseBlobs(p.todo);
  }
  c.messages.forEach(function (m) { delete m.speed; delete m.thinkMs; });
  c.updatedAt = Date.now();
  saveState(true);
  if (state.activeId === id) { conv = c; renderChat(); }
  renderConvList(); updateTopbar(); updateCtxMeter(); updateStorageMeter(); renderDataPanel();
  var removed = before - c.messages.length;
  toast("已压缩「" + (c.title || "") + "」:清理 " + removed + " 条较早的消息", "success", 3600);
  return removed;
}
/* localStorage 里还内联着多少附件数据(面板展示 + 自动搬家判断) */
function stateAttachBytes() {
  var n = 0;
  state.conversations.forEach(function (c) {
    c.messages.forEach(function (m) {
      if (!Array.isArray(m.content)) return;
      m.content.forEach(function (p) {
        if (!p || !p.attach || p.attach.blob) return;
        if (p.type !== "image_url" && p.type !== "image") return;
        var url = (p.type === "image_url" && p.image_url && p.image_url.url) || "";
        n += url ? url.length : (((p.source && p.source.data) || "").length);
      });
    });
  });
  return n;
}
/* 把 localStorage 里内联的附件 payload 搬进 IndexedDB(先写成功再剥掉,不会丢) */
function migrateAttachmentsToIdb() {
  return blobDb().then(function (db) {
    if (!db) return { moved: 0, ok: false };
    var jobs = [], moved = 0;
    state.conversations.forEach(function (c) {
      c.messages.forEach(function (m) {
        if (!Array.isArray(m.content)) return;
        m.content.forEach(function (p) {
          if (!p || !p.attach || p.attach.blob) return;
          var url = p.type === "image_url" ? ((p.image_url && p.image_url.url) || "")
            : (p.source && p.source.data ? ("data:" + (p.source.media_type || "image/png") + ";base64," + p.source.data) : "");
          if (!url) return;
          var mime = (String(url).match(/^data:([^;,]+)/) || [])[1] || p.attach.mime || "image/png";
          var key = p.attach.id + (p.attach.page ? "-p" + p.attach.page : "");
          jobs.push(blobPut(key, mime, url.replace(/^data:[^,]*,/, "")).then(function (ok) {
            if (!ok) return;
            moved++;
            p.attach.blob = key;
            p.attach.mime = mime;
            if (p.type === "image_url") p.image_url = { url: "" };
            else p.source = { type: "base64", media_type: mime, data: "" };
          }));
        });
      });
    });
    if (!jobs.length) return { moved: 0, ok: true };
    return Promise.all(jobs).then(function () {
      saveState(true);
      return { moved: moved, ok: true };
    });
  }, function () { return { moved: 0, ok: false }; });
}
/* 优化:把历史消息里的图片 / PDF 二进制数据剥掉(文本文件内容保留),体积能降一大截。
   工具读取的图片(内联在 m.media[].data,不落 blob 键)同样按「优化存储」回收(只删字段、不动正文) */
function stripAttachmentData(quiet, keepIds) {
  var before = storageBytes(), n = 0, nTool = 0, keys = [];
  state.conversations.forEach(function (c) {
    if (keepIds && keepIds[c.id]) return;      /* 保护范围内的对话:附件一个都不动 */
    c.messages.forEach(function (m) {
      /* 工具媒体:插在下面 `!Array.isArray(m.content)` 早退**之前** —— tool 消息的 content 是字符串,
         早退之后永远进不来(§3.8.4) */
      if (m && Array.isArray(m.media) && m.media.length) {
        nTool += m.media.length;
        delete m.media;
      }
      if (!Array.isArray(m.content)) return;
      var out = [];
      m.content.forEach(function (p) {
        if (!p) return;
        var a = p.attach || null;
        if (p.type === "image_url" || p.type === "image") {
          n++;
          if (a && a.blob) keys.push(a.blob);
          out.push({
            type: "text",
            attach: { id: a && a.id, kind: "image", name: (a && a.name) || "图片", ocrOnly: 1, ocrText: "(历史图片数据已清理)" },
            text: "【图片 " + ((a && a.name) || "") + " 的数据已在「优化存储」中清理】"
          });
          return;
        }
        if (a && a.ocrText) {
          var copy = {};
          for (var k in p) if (Object.prototype.hasOwnProperty.call(p, k)) copy[k] = p[k];
          copy.attach = {};
          for (var k2 in a) if (Object.prototype.hasOwnProperty.call(a, k2)) copy.attach[k2] = a[k2];
          copy.attach.ocrText = "(历史图片数据已清理)";
          out.push(copy);
          return;
        }
        out.push(p);
      });
      m.content = out;
    });
  });
  saveState(true);
  /* 统一释放口径:改写各会话的 content **之后**才释放(既有顺序正确),而 keep 重算能保护
     duplicateConv 副本共享的同一批键 —— 直接 blobDel 会把副本的图片一起删掉(占位化) */
  if (keys.length) {
    var rel = cxReleasePlan(keys);
    if (rel.todo.length) cxReleaseBlobs(rel.todo);
  }
  var after = storageBytes();
  renderDataPanel(); renderChat(); updateStorageMeter();
  if (!quiet) {
    var total = n + nTool;
    toast(total ? "已清理 " + total + " 张历史图片" + (nTool ? "(其中工具读取的图片 " + nTool + " 张)" : "") +
      "(含附件库),释放 " + fmtBytes(Math.max(0, before - after))
      : "没有可清理的图片数据", total ? "success" : "info", 3600);
  }
  return n + nTool;
}

/* ---- 提示词模板库 ---- */
function renderLibList() {
  var box = $("lib-list");
  if (!state.promptLib.length) {
    box.innerHTML = '<div class="hint" style="padding:10px 0">还没有模板</div>';
    return;
  }
  box.innerHTML = state.promptLib.map(function (t, i) {
    return '<div class="tool-row"><div class="tr-main"><div class="tr-name">' + escapeHtml(t.name) +
      '</div><div class="tr-desc">' + escapeHtml(t.text.replace(/\s+/g, " ").slice(0, 90)) + "</div></div>" +
      '<button class="btn xs danger" data-libdel="' + i + '">删除</button></div>';
  }).join("");
  box.querySelectorAll("[data-libdel]").forEach(function (b) {
    b.addEventListener("click", function () {
      state.promptLib.splice(Number(b.getAttribute("data-libdel")), 1);
      saveSoon(); renderLibList(); renderPromptLibChips();
    });
  });
}
function renderPromptLibChips() {
  var box = $("prompt-lib-chips");
  if (!box) return;
  if (!state.promptLib.length) { box.innerHTML = '<span class="hint">模板库为空,可在 设置 → 数据 中添加</span>'; return; }
  box.innerHTML = state.promptLib.map(function (t, i) {
    return '<button class="chip-btn" data-libinsert="' + i + '" title="' + escAttr(t.text) + '">' +
      icon("book", "sm") + escapeHtml(t.name) + "</button>";
  }).join("");
  box.querySelectorAll("[data-libinsert]").forEach(function (b) {
    b.addEventListener("click", function () {
      var t = state.promptLib[Number(b.getAttribute("data-libinsert"))];
      if (!t) return;
      var ta = $("conv-system");
      ta.value = (ta.value ? ta.value.replace(/\s*$/, "") + "\n\n" : "") + t.text;
      ta.focus();
    });
  });
}
function openPromptModal() {
  if (!conv) { toast("请先新建一个对话", "warn"); return; }
  $("conv-system").value = conv.system || "";
  renderPromptLibChips();
  openMask("prompt-modal");
}

/* ---- 数据导入导出 ---- */
/* 把外置附件内联进一份「可独立恢复」的副本(备份不能依赖浏览器的 IndexedDB) */
function inlineBlobsForExport() {
  var all = [];
  state.conversations.forEach(function (c) { all = all.concat(c.messages); });
  return hydrateAttachments(all).then(function () {
    var copy = JSON.parse(JSON.stringify({
      settings: state.settings, conversations: state.conversations, activeId: state.activeId,
      promptLib: state.promptLib, fetchedModels: state.fetchedModels
    }));
    copy.conversations.forEach(function (c) {
      (c.messages || []).forEach(function (m) {
        if (!Array.isArray(m.content)) return;
        m.content.forEach(function (p) {
          if (!p || !p.attach || !p.attach.blob) return;
          var rec = blobMemo(p.attach.blob);
          if (!rec || !rec.data) return;
          var mime = rec.mime || p.attach.mime || "image/png";
          if (p.type === "image_url") p.image_url = { url: "data:" + mime + ";base64," + rec.data };
          else p.source = { type: "base64", media_type: mime, data: rec.data };
          delete p.attach.blob;
        });
      });
    });
    return copy;
  });
}
/* 工作区清单:导出/清空都用它——只列元数据,不含文件内容
   (10×512MB 最坏 ~5GB,JSON.stringify 必 OOM) */
function wsSandboxManifest() {
  if (!wsReady()) return Promise.resolve([]);
  return wsList().then(function (list) {
    return list.map(function (m) {
      return { id: m.id, name: m.name, quotaBytes: m.quotaBytes, usedBytes: m.usedBytes, fileCount: m.fileCount || 0 };
    });
  }, function () { return []; });
}
function exportAll() {
  saveSettingsFromModal(false, true);
  toast("正在打包备份(含附件)…", "info", 2200);
  var boxes = wsSandboxManifest();
  inlineBlobsForExport().then(function (copy) {
    boxes.then(function (sb) {
      copy.sandboxes = sb;
      copy.app = "chatgpt-webui";
      copy.version = APP_VERSION;
      copy.exportedAt = new Date().toISOString();
      var name = "chatgpt-webui-backup-" + new Date().toISOString().slice(0, 10) + ".json";
      var ok = download(name, JSON.stringify(copy, null, 2), "application/json");
      toast(ok ? "已导出备份(附件已内联,可独立恢复;不含工作区文件)" : "导出失败", ok ? "success" : "error", 4600);
    });
  }, function () {
    boxes.then(function (sb) {
      var payload = { app: "chatgpt-webui", version: APP_VERSION, exportedAt: new Date().toISOString(),
                      settings: state.settings, conversations: state.conversations, activeId: state.activeId,
                      promptLib: state.promptLib, fetchedModels: state.fetchedModels, sandboxes: sb };
      download("chatgpt-webui-backup-" + new Date().toISOString().slice(0, 10) + ".json",
        JSON.stringify(payload, null, 2), "application/json");
    });
  });
}
function exportCurrentMd() {
  if (!conv) { toast("当前没有对话", "warn"); return; }
  var name = (conv.title || "conversation").replace(/[\\/:*?"<>|\s]+/g, "_").slice(0, 50);
  if (download(name + ".md", convToMarkdown(conv), "text/markdown;charset=utf-8")) toast("已导出 Markdown", "success");
}
/* 导入后的工作区提示:sandboxes 清单只作提示;本地不存在的 conv.wsId 置 null
   并汇总提示 —— 不阻断导入 */
function wsImportNotice(sandboxes) {
  var sbCount = Array.isArray(sandboxes) ? sandboxes.length : 0;
  if (!wsReady()) {
    if (sbCount) toast("备份里有 " + sbCount + " 个工作区,但备份不含工作区文件内容,没有一起导入", "warn", 6400);
    return;
  }
  wsList().then(function (list) {
    var have = {}, dangling = [];
    list.forEach(function (m) { have[m.id] = 1; });
    state.conversations.forEach(function (c) {
      if (c.wsId && !have[c.wsId]) { c.wsId = null; dangling.push(c.title || c.id); }
    });
    var parts = [];
    if (sbCount) parts.push("备份中有 " + sbCount + " 个工作区,但备份不含工作区文件内容");
    if (dangling.length) {
      saveState(true);
      parts.push("有 " + dangling.length + " 个会话挂着本地不存在的工作区,已改为「未挂载」");
    }
    if (parts.length) toast("导入完成:" + parts.join(";"), "warn", 6800);
    renderConvList(); updateTopbar(); updateCtxMeter(); renderWsDataPanel();
  }, function () {});
}
function importAll(file) {
  if (!file) return;
  var r = new FileReader();
  r.onload = function () {
    var data;
    try { data = JSON.parse(r.result); } catch (e) { toast("导入失败:不是合法的 JSON 文件", "error"); return; }
    if (!data || typeof data !== "object" || !Array.isArray(data.conversations)) {
      toast("导入失败:文件格式不正确(缺少 conversations)", "error"); return;
    }
    /* 覆盖是不可逆的,先确认一次(改成主题化弹窗:原生 confirm 不跟主题)。
       确认框是异步的 ⇒ 把落地动作整段搬进 importApply();文件内容已在 data 这个闭包里,
       确认后照旧用它,不需要重新读盘 */
    askConfirm({
      title: "导入备份", icon: "upload", okText: "覆盖导入",
      message: "导入将覆盖当前全部对话与设置,确定继续吗?"
    }, function () { importApply(data); });
  };
  r.onerror = function () { toast("读取文件失败", "error"); };
  r.readAsText(file, "utf-8");
}
/* 导入的落地段(确认「覆盖导入」之后才走这里):整库替换 + 墓碑 + 撤回台账 ——
   主体与原来的 r.onload 回调逐字相同,只是外层从「读文件回调」换成「确认后回调」 */
function importApply(data) {
  /* 导入前的内存列表:它们中间不在导入集合里的,都是"被这次覆盖丢掉"的会话 —— 下面要按 id 立墓碑 */
    var prevIds = state.conversations.map(function (c) { return c && c.id; });
    state = {
      settings: mergeSettings(data.settings),
      conversations: data.conversations,
      activeId: data.activeId || null,
      promptLib: Array.isArray(data.promptLib) && data.promptLib.length ? data.promptLib : DEFAULT_LIB.slice(),
      fetchedModels: Array.isArray(data.fetchedModels) ? data.fetchedModels : []
    };
    /* 逐条过一遍 sanitizeConv:它是「会话脏数据归一」的唯一点(消息数组/时间/标题/置顶 +
       wsId 类型 / alternates 与 altIndex),导入链不该自己再维护第二份局部规则。
       非对象条目(null / 数字 / 字符串)先滤掉 —— sanitizeConv(null) 只会新建并丢弃一个对象,
       紧接着取 c.id 就抛 TypeError,而 state 此时已被替换 ⇒ UI 与内存态不一致且没有任何提示。
       丢弃条目要如实告知(备份是用户自己的数据,静默少几条比报错更糟)。 */
    var dropped = 0;
    state.conversations = state.conversations.filter(function (c) {
      if (c && typeof c === "object") return true;
      dropped++;
      return false;
    }).map(function (c) {
      sanitizeConv(c);
      if (!c.id) c.id = uid();
      return c;
    });
    if (dropped) toast("备份里有 " + dropped + " 条对话不是合法对象,已跳过", "warn", 5000);
    conv = getConv(state.activeId) || state.conversations[0] || null;
    if (conv) state.activeId = conv.id;
    if (typeof pvAutoLoopPurge === "function") pvAutoLoopPurge();   /* 整库替换 ⇒ 自动续跑计数跟着收敛 */
    /* 整库替换的两个标记(都必须在 saveState 之前落定):
       · 被覆盖掉的旧会话按 id 立墓碑 —— 否则 saveState 的写前合并会照"IDB 权威"把库里那些旧会话
         又合回内存,对侧那份未落库副本也会把它们写回来;
       · 导入集合里那些 id 记一笔**明确撤回**(用户明确要把它们拿回来):撤回台账要跟着记录走,
         既按住同一次 stateRecord() 里 mergeConvsGone(rec0.gone) 的回灌(rec0 还是清墓碑之前
         那份记录 —— 静默丢数据就出在这里),也让对侧把手里那份墓碑作废,
         否则它收敛时会把这些刚导入的会话当"幽灵副本"从 IDB 删掉。
       wiped 标记让对侧遇到"整库被替换"时不再保留自己的本地未落库副本 */
    var keep = {}, keepIds = [];
    state.conversations.forEach(function (c) { if (c && c.id) { keep[c.id] = 1; keepIds.push(c.id); } });
    markConvsRestored(keepIds);
    markConvsGone(prevIds.filter(function (id) { return id && !keep[id]; }));
    convRevState.wiped = Date.now();
    saveState(true);
    /* 导入是**整库替换**(确认框写的就是"覆盖当前全部对话"):IDB 里那些不在导入集合里的旧会话
       记录必须一起删掉。否则它们只是从内存里消失、在库里还留着 —— 一刷新或另一个标签页按
       IDB 重载就会"复活",与"覆盖"的语义不符(同 wipeAll 的清库口径)。
       这里**不**顺带 gcBlobs():导入的内联附件正在 migrateAttachmentsToIdb() 里搬迁,
       此时回收附件记录会把刚 put 进去、消息还没写上 blob 引用的记录删掉(自造悬垂引用) */
    convsGetAll().then(function (old) {
      var keep = {};
      state.conversations.forEach(function (c) { if (c && c.id) keep[c.id] = 1; });
      var gone = [];
      (old || []).forEach(function (c) { if (c && c.id && !keep[c.id]) gone.push(c.id); });
      return gone.length ? convsDel(gone) : 0;
    }).then(function () { updateStorageMeter(); renderDataPanel(); }, function () {});
    applyAppearance();
    syncSettingsForm();
    rebuildModelDatalist();
    renderChat(); renderConvList(); updateTopbar();
    /* 导入进来的附件是内联的:搬进 IndexedDB,给 localStorage 腾地方(失败就保持内联) */
    migrateAttachmentsToIdb().then(function () { updateStorageMeter(); });
    closeMask("settings-modal");
    toast("导入成功:" + state.conversations.length + " 个对话", "success");
    wsImportNotice(data.sandboxes);
}
/* 清空工作区:逐个走 wsDropWorkspace(force),再清 pyocache */
function wsWipeAll(wss) {
  var chain = Promise.resolve(true);
  (wss || []).forEach(function (m) {
    chain = chain.then(function () { return wsDropWorkspace(m.id, { force: true }); },
                       function () { return wsDropWorkspace(m.id, { force: true }); });
  });
  return chain.then(function () { return pyCacheClear(); }, function () { return pyCacheClear(); })
    .then(function () {
      WS_RAIL_SEL = null; WS_CWD = "/"; WSR_LIMIT = 200;
      WS_UPLOAD.rep = null; wsShowReport();
      renderWsRail(); renderWsDataPanel();
    }, function () {});
}
function wipeAll() {
  wsList().then(function (wss) {
    var n = wss.length;
    var suffix = n ? "(含 " + n + " 个工作区及其文件)" : "";
    /* 两级确认(语义与原来的两次原生 confirm 一致:都点「确定」才真清,取消 / Esc 一律不动数据)。
       确认框是异步的 ⇒ 两个弹窗串联,落地动作整段搬进 wipeAllNow() */
    askConfirm({
      title: "清空全部", icon: "trash", okText: "清空全部",
      message: "确定清空全部对话与设置吗?" + suffix + "此操作不可撤销,建议先导出备份。"
    }, function () {
      askConfirm({
        title: "再次确认", icon: "warn", okText: "删除全部数据",
        message: "再次确认:所有本地对话数据" + (n ? "与 " + n + " 个工作区文件" : "") + "都会被删除。"
      }, function () { wipeAllNow(n, wss); });
    });
  }, function () { toast("读取工作区列表失败,已跳过工作区清理", "error", 4200); });
}
/* 清空全部数据的落地段(两级确认都点过之后才走这里) */
function wipeAllNow(n, wss) {
    /* 清空前的内存列表:全部按 id 立墓碑,并打上"整库被替换"标记。
       否则对侧(还有它那份未落库的副本)会在收敛时把已清空的会话写回权威库:清空后残留 */
    var prevIds = state.conversations.map(function (c) { return c && c.id; });
    state = {
      settings: mergeSettings(null), conversations: [], activeId: null,
      promptLib: DEFAULT_LIB.slice(), fetchedModels: []
    };
    markConvsGone(prevIds);
    convRevState.wiped = Date.now();
    conv = null;
    if (typeof pvAutoLoopPurge === "function") pvAutoLoopPurge();   /* 会话全清 ⇒ 自动续跑计数也清 */
    /* 压缩账本与待应用的压缩一并作废:会话都不存在了,留着的条目只会是幽灵 */
    for (var cxk in CX_LEDGER) {
      if (Object.prototype.hasOwnProperty.call(CX_LEDGER, cxk)) delete CX_LEDGER[cxk];
    }
    CX_RUN.pending = null;
    /* 连大仓库里的会话记录与附件记录一起清掉,不留垃圾 */
    var allIds = [];
    convsGetAll().then(function (list) {
      list.forEach(function (c) { if (c && c.id) allIds.push(c.id); });
      return convsDel(allIds);
    }).then(function () { return gcBlobs(); }).then(function () { updateStorageMeter(); renderDataPanel(); });
    wsWipeAll(wss).then(function () { updateStorageMeter(); renderDataPanel(); wsRailSync(); }, function () {});
    saveState(true);
    applyAppearance(); syncSettingsForm(); rebuildModelDatalist();
    renderChat(); renderConvList(); updateTopbar(); updateStorageMeter();
    closeMask("settings-modal");
    toast("已清空全部数据" + (n ? "(含 " + n + " 个工作区)" : ""), "success", 4200);
}

/* ---- 状态栏计量 ---- */
function updateCtxMeter() {
  var p = payloadMessages();
  var extra = 0;
  draftFiles.forEach(function (f) { extra += draftAttachTokens(f); });
  var sys = ((conv && conv.system) || state.settings.systemPrompt || "");
  /* 工作区上下文也计入估算:与 buildBody 用的是同一个 wsContextBlock() */
  var wsCtx = wsContextBlock();
  if (wsCtx) sys = sys ? (sys + "\n\n" + wsCtx) : wsCtx;
  /* 外部 MCP instructions 是否注入也计入:与 buildBody 同口径(含会话级覆盖判定) */
  var mcpCtx = mcpInstructionsBlock(conv);
  if (mcpCtx) sys = sys ? (sys + "\n\n" + mcpCtx) : mcpCtx;
  wsRailSync();   /* 接缝:右栏可见性 + 挂载按钮 + 元数据缓存补热(无 IO,除了一次可能的 wsMeta) */
  var total = p.tokens + estimateTokens(sys) + estimateTokens(elInput.value || "") + extra;
  var el = $("st-ctx");
  if (el) el.textContent = p.list.length + " 条 / ~" + num(total) + " tok";
  var wrap = $("st-ctx-wrap");
  if (wrap) {
    wrap.className = "st" + (p.truncated ? " warn" : "");
    wrap.title = p.truncated
      ? "历史已按「最多携带的历史消息条数」截断,只发送最近 " + p.list.length + " 条"
      : "估算的下一轮请求上下文用量";
  }
  updateCtxMonitor();
}

/* ---------------------------------------------------------------------------
   18.5 上下文用量监控
   · 数字来自协议真实返回:OpenAI 的 usage.prompt_tokens / Anthropic 的 usage.input_tokens
   · 模型窗口来自服务端返回:llama.cpp 的 /v1/models → data[].meta.n_ctx,
     兼容 context_length / max_context_length / details.context_length / /props,
     都拿不到时按「上下文长度」的手动设定计(默认 256K,范围 8–1024K)
--------------------------------------------------------------------------- */
var CTX_POP_OPEN = false;
function ctxUsageOf(c) {
  if (!c) return null;
  if (!c.usage || typeof c.usage !== "object") {
    c.usage = { prompt: null, completion: null, cached: null, at: 0, lastMsgId: "",
      model: "", exact: false, requests: 0, sumPrompt: 0, sumCompletion: 0, peak: 0 };
  }
  var u = c.usage;
  if (typeof u.requests !== "number") u.requests = 0;
  if (typeof u.sumPrompt !== "number") u.sumPrompt = 0;
  if (typeof u.sumCompletion !== "number") u.sumCompletion = 0;
  if (typeof u.peak !== "number") u.peak = 0;
  return u;
}
function ctxMetaFor(model) {
  var bag = state.settings.modelCtx;
  var m = (model && bag) ? bag[model] : null;
  return m && typeof m === "object" ? m : null;
}
/* 手动设定的窗口(K):滑块 / 输入框 / 计算路径共用同一个 clamp 口径 */
function ctxWinKNow() {
  return clampNum(state.settings.ctxWinK, CTX_WIN_K_MIN, CTX_WIN_K_MAX, DEFAULT_SETTINGS.ctxWinK);
}
function ctxWindowFor(model) {
  var m = ctxMetaFor(model);
  var v = m ? Number(m.ctx) : 0;
  /* 服务端报过这个模型的窗口长度 → 永远以它为准(手动设定不覆盖它) */
  if (v > 0 && (m.src || "server") === "server") return Math.round(v);
  return ctxWinKNow() * 1024;
}
function ctxWindowSrc(model) {
  var m = ctxMetaFor(model);
  return (m && Number(m.ctx) > 0 && (m.src || "server") === "server") ? "server" : "manual";
}
/* 「上下文长度」控件是否可用:服务端给了窗口长度就隐藏(两处同源) */
function ctxWinManualOn(model) {
  var m = String(model == null ? effectiveModel() : model).trim();
  return ctxWindowSrc(m) !== "server";
}
function setModelCtx(model, ctx, src) {
  if (!model || !(Number(ctx) > 0)) return false;
  /* 存在 settings 里才会被持久化(loadState / mergeSettings 都读 settings.modelCtx) */
  if (!state.settings.modelCtx || typeof state.settings.modelCtx !== "object") state.settings.modelCtx = {};
  state.settings.modelCtx[model] = { ctx: Math.round(Number(ctx)), src: src || "server", at: Date.now() };
  return true;
}
/* 一次请求结束后,用服务端真实 usage 记录上下文水位 */
function recordUsage(model, prompt, completion, cached, msgId) {
  var u = ctxUsageOf(conv);
  if (!u) return;
  if (prompt == null) return;
  u.prompt = Math.round(Number(prompt) || 0);
  u.completion = Math.round(Number(completion) || 0);
  u.cached = (cached == null) ? null : Math.round(Number(cached) || 0);
  u.at = Date.now();
  u.model = model || "";
  u.lastMsgId = msgId || "";
  u.exact = true;
  u.requests++;
  u.sumPrompt += u.prompt;
  u.sumCompletion += u.completion;
  u.peak = Math.max(u.peak, u.prompt + u.completion);
}
/* 当前上下文的实时用量:实测水位 + 之后新增消息/流式输出的估算 + 待发送草稿。
   targetConv 可选(缺省 = 模块级 conv,**缺省路径逐字节不变**):压缩相关调用一律显式传
   「发起会话」,否则生成中切走后会读到另一条会话的读数。
   草稿(elInput / draftFiles)只属于当前会话 ⇒ 非当前会话不计入 */
function ctxSnapshot(targetConv) {
  var c = targetConv || conv;
  var isCur = (c === conv);
  var model = effectiveModel();
  var win = ctxWindowFor(model);
  var src = ctxWindowSrc(model);
  var sys = ((c && c.system) || state.settings.systemPrompt || "");
  var sysTok = estimateTokens(sys);
  var draftTok = (isCur ? estimateTokens(elInput.value || "") : 0) + sqDraftTokens(c);
  var attTok = 0;
  if (isCur) draftFiles.forEach(function (f) { attTok += draftAttachTokens(f); });
  var p = payloadMessages(c ? c.messages : undefined);
  var estAll = p.tokens + sysTok + draftTok + attTok;
  var u = ctxUsageOf(c);
  var used = estAll, measured = false, base = 0, added = 0, live = 0;
  if (u && u.exact && u.prompt != null && c) {
    base = u.prompt + (u.completion || 0);
    var idx = -1, i;
    for (i = 0; i < c.messages.length; i++) if (c.messages[i].id === u.lastMsgId) { idx = i; break; }
    if (idx >= 0) {
      for (i = idx + 1; i < c.messages.length; i++) {
        var m = c.messages[i];
        if (m.error) continue;
        var t = estimateTokens(contentToText(m.content)) + 4 + estimateTokens(m.reasoning || "");
        if (m.streaming) live += t; else added += t;
      }
      used = base + added + live + draftTok + attTok;
      measured = true;
    }
  }
  return {
    model: model, win: win, src: src, srcLevel: ctxWindowSrcLevel(model), used: Math.round(used), measured: measured,
    base: base, added: added, live: live, draft: draftTok + attTok,
    sysTok: sysTok, msgs: p.list.length, truncated: p.truncated,
    requests: u ? u.requests : 0, sumPrompt: u ? u.sumPrompt : 0,
    sumCompletion: u ? u.sumCompletion : 0, peak: u ? u.peak : 0,
    prompt: u ? u.prompt : null, completion: u ? u.completion : null,
    cached: u ? u.cached : null, at: u ? u.at : 0
  };
}
function ctxRingOffset(ratio) {
  var C = 94.248;
  var r = clamp(Number(ratio) || 0, 0, 1);
  return (C * (1 - r)).toFixed(2);
}
function updateCtxMonitor() {
  var s = ctxSnapshot();
  var numEl = $("ctx-meter-num");
  var met = $("ctx-meter");
  if (!numEl || !met) return;
  var ratio = s.win > 0 ? s.used / s.win : 0;
  numEl.textContent = (s.measured ? "" : "≈") + fmtCtxNum(s.used) + "/" + fmtCtxNum(s.win);
  met.className = "ctx-meter" + (ratio >= 0.92 ? " danger" : ratio >= 0.75 ? " warn" : "");
  met.title = "上下文用量:" + num(s.used) + " / " + num(s.win) + " tokens(" +
    (ratio * 100).toFixed(1) + "%)\n" +
    (s.measured ? "已按服务端返回的真实 token 校准" : "尚无真实数据,当前为估算值") +
    "\n点击查看明细";
  var bar = $("ctx-ring-bar");
  if (bar) bar.style.strokeDashoffset = ctxRingOffset(ratio);
  if (CTX_POP_OPEN) renderCtxPop(s);
}
function ctxRow(dt, dd, cls) {
  return "<dt>" + dt + "</dt><dd" + (cls ? ' class="' + cls + '"' : "") + ">" + dd + "</dd>";
}
function renderCtxPop(s) {
  var body = $("ctx-pop-body");
  if (!body) return;
  s = s || ctxSnapshot();
  var ratio = s.win > 0 ? s.used / s.win : 0;
  var pct = ratio * 100;
  var level = ratio >= 0.92 ? " danger" : ratio >= 0.75 ? " warn" : "";
  var free = Math.max(0, s.win - s.used);
  var h = "";
  h += '<div class="ctx-hero' + level + '">' +
    '<div class="ring-wrap"><svg class="cm-big" viewBox="0 0 36 36"><circle class="cm-track" cx="18" cy="18" r="15"></circle>' +
    '<circle class="cm-bar" cx="18" cy="18" r="15" style="stroke-dashoffset:' + ctxRingOffset(ratio) + '"></circle></svg></div>' +
    '<div><div class="big">' + (s.measured ? "" : "≈") + fmtCtxNum(s.used) + ' <small>/ ' + fmtCtxNum(s.win) + "</small></div>" +
    '<div class="sub">已用 ' + pct.toFixed(1) + "% · 剩余 " + fmtCtxNum(free) + " tokens</div></div></div>";
  h += '<div class="meter' + (ratio >= 0.92 ? " err" : ratio >= 0.75 ? " warn" : "") + '"><i style="width:' +
    Math.min(100, pct).toFixed(1) + '%"></i></div>';
  h += '<div class="ctx-bar-legend"><span>' + escapeHtml(s.model || "未设置模型") + "</span><span>" +
    fmtCtxNum(s.win) + " tok 上限</span></div>";

  h += '<div class="ctx-sect">本次请求构成</div><dl class="kv">';
  if (s.measured) {
    h += ctxRow("上次请求输入", num(s.prompt) + ' <span class="hint" style="display:inline">实测</span>');
    h += ctxRow("上次请求输出", num(s.completion));
    if (s.cached != null) h += ctxRow("其中缓存命中", num(s.cached), "ok");
    h += ctxRow("之后新增内容", "≈" + num(s.added + s.live));
  } else {
    h += ctxRow("历史 + 系统提示", "≈" + num(s.base || (s.used - s.draft)));
  }
  h += ctxRow("待发送草稿", "≈" + num(s.draft));
  h += ctxRow("携带历史条数", s.msgs + " 条" + (s.truncated ? "(已按设置截断)" : ""));
  h += ctxRow("实时合计", (s.measured ? "" : "≈") + num(s.used) + " tok");
  h += "</dl>";

  h += '<div class="ctx-sect">本对话累计</div><dl class="kv">';
  h += ctxRow("请求次数", num(s.requests) + " 次");
  h += ctxRow("输入 token 合计", num(s.sumPrompt));
  h += ctxRow("输出 token 合计", num(s.sumCompletion));
  h += ctxRow("峰值占用", num(s.peak) + " tok");
  if (s.at) h += ctxRow("最近一次测量", fmtTime(s.at));
  h += "</dl>";

  /* 压缩上下文入口:读数与自动压缩同一口径(阈值 = 设置里的 compactTriggerPct) */
  var trig = cxTriggerPct(), warn = cxWarnPct();
  var overTrig = pct >= trig, overWarn = pct >= warn;
  h += '<div class="ctx-sect">压缩上下文</div>';
  h += '<div class="hint" style="line-height:1.7;margin-bottom:9px">' +
    (overTrig
      ? "已超过自动压缩阈值 " + trig + "%" + (state.settings.compactAuto ? "(发送下一条消息前会自动压缩一次)" : "(自动压缩已关闭)") + ";也可以现在就压缩。"
      : overWarn
        ? "已接近窗口上限(提醒阈值 " + warn + "%,自动压缩阈值 " + trig + "%)。"
        : "上下文还宽裕;需要腾窗口时可随时压缩。") +
    "压缩会生成一份交接总结,并**彻底删除**较早的消息与其附件(系统提示词 / 工作区文件 / 后台任务不受影响)。" +
    (state.settings.ctxMsgs > 0
      ? "★ 已开启「携带历史条数上限(" + state.settings.ctxMsgs + " 条)」:压缩后的摘要与尾部可能被条数截断,两者会叠加生效。"
      : "") +
    "</div>";
  h += '<button class="btn sm block" data-compact="1" style="margin-bottom:4px">立即压缩…</button>';
  body.innerHTML = h;
  var srcEl = $("ctx-pop-src");
  if (srcEl) {
    srcEl.textContent = "窗口:" + ctxWinSrcLabel(s.srcLevel, s.model);
    srcEl.title = ctxWinSrcTitle(s.srcLevel);
  }
}
function toggleCtxPop(force) {
  var pop = $("ctx-pop"), btn = $("ctx-meter");
  if (!pop) return;
  var open = (typeof force === "boolean") ? force : !pop.classList.contains("open");
  if (force === false && !pop.classList.contains("open")) return;   // 已关闭,不做无谓重排
  if (open) closeMenus();
  pop.classList.toggle("open", open);
  btn.classList.toggle("on", open);
  CTX_POP_OPEN = open;
  if (open) {
    renderCtxPop();
    placePopover(pop, btn, { align: "right", width: 344 });
  }
}

/* ---- 辅助 ---- */
function lastAssistantMsg() {
  if (!conv) return null;
  for (var i = conv.messages.length - 1; i >= 0; i--) {
    if (conv.messages[i].role === "assistant") return conv.messages[i];
  }
  return null;
}

/* ---------------------------------------------------------------------------
   20. 会话菜单 / 命令面板 / 对话内查找
--------------------------------------------------------------------------- */
var popMenuEl = $("pop-menu");
var popMenuConvId = null;

function openConvMenu(anchor, id) {
  var c = getConv(id);
  if (!c) return;
  closeMenus();
  popMenuConvId = id;
  popMenuEl.innerHTML =
    '<button data-convact="rename">' + icon("edit", "sm") + " 重命名</button>" +
    '<button data-convact="pin">' + icon("pin", "sm") + " " + (c.pinned ? "取消置顶" : "置顶") + "</button>" +
    '<button data-convact="dup">' + icon("duplicate", "sm") + " 创建副本</button>" +
    '<button data-convact="system">' + icon("book", "sm") + " 系统提示词</button>" +
    '<div class="pm-sep"></div>' +
    '<button data-convact="copymd">' + icon("copy", "sm") + " 复制全文(Markdown)</button>" +
    '<button data-convact="exportmd">' + icon("download", "sm") + " 导出 Markdown</button>" +
    '<button data-convact="clear">' + icon("eraser", "sm") + " 清空消息</button>" +
    '<div class="pm-sep"></div>' +
    '<button data-convact="delete" class="danger">' + icon("trash", "sm") + " 删除对话</button>";
  placeMenu(popMenuEl, anchor);
}
popMenuEl.addEventListener("click", function (e) {
  var b = e.target.closest ? e.target.closest("button") : null;
  if (!b) return;
  popMenuEl.classList.remove("open");

  var libText = b.getAttribute("data-libtext");
  if (libText != null) {
    elInput.value = (elInput.value ? elInput.value.replace(/\s*$/, "") + "\n\n" : "") + libText;
    autoResize(); focusInput();
    return;
  }
  if (b.getAttribute("data-libact") === "manage") { openSettings("data"); return; }

  var wsact = b.getAttribute("data-wsact");
  if (wsact) { runWsMenuAction(wsact, b.getAttribute("data-ws")); return; }

  var act = b.getAttribute("data-convact");
  if (!act) { runPaletteAction(b.getAttribute("data-palette")); return; }
  var c = getConv(popMenuConvId);
  if (!c) return;

  if (act === "rename") startRenameConv(c);
  else if (act === "pin") togglePin(c.id);
  else if (act === "dup") duplicateConv(c.id);
  else if (act === "system") { selectConv(c.id); openPromptModal(); }
  else if (act === "copymd") copyText(convToMarkdown(c), "已复制对话全文");
  else if (act === "exportmd") {
    if (conv !== c) selectConv(c.id);
    exportCurrentMd();
  } else if (act === "clear") clearConvMessages(c.id);
  else if (act === "delete") deleteConv(c.id);
});
function startRenameConv(c) {
  var item = elConvList.querySelector('[data-id="' + cssEscape(c.id) + '"]');
  if (!item) { renderConvList(); item = elConvList.querySelector('[data-id="' + cssEscape(c.id) + '"]'); }
  if (!item) {
    /* 列表里没有这一条(命令面板等入口):同样走 17.9 的主题化输入弹窗,不用原生 prompt */
    openAskDialog({
      title: "重命名对话",
      okText: "保存",
      fields: [{ key: "title", label: "对话标题", value: c.title, maxLen: 120, empty: "标题不能为空" }],
      onSubmit: function (v) { renameConv(c.id, v.title); }
    });
    return;
  }
  popMenuConvId = c.id;
  var titleEl = item.querySelector(".ci-title");
  var inp = document.createElement("input");
  inp.className = "rename-input";
  inp.value = c.title;
  if (titleEl) titleEl.replaceWith(inp); else item.appendChild(inp);
  inp.focus(); inp.select();
  var done = false;
  function commit(ok) {
    if (done) return;
    done = true;
    if (ok && inp.value.trim()) renameConv(c.id, inp.value);
    else renderConvList();
  }
  inp.addEventListener("keydown", function (ev) {
    if (ev.key === "Enter") { ev.preventDefault(); commit(true); }
    else if (ev.key === "Escape") { ev.preventDefault(); commit(false); }
  });
  inp.addEventListener("blur", function () { commit(true); });
  inp.addEventListener("click", function (ev) { ev.stopPropagation(); });
}
elConvList.addEventListener("click", function (e) {
  var menuBtn = e.target.closest ? e.target.closest(".ci-menu") : null;
  if (menuBtn) {
    e.stopPropagation();
    var item = menuBtn.closest(".conv-item");
    openConvMenu(menuBtn, item.getAttribute("data-id"));
    return;
  }
  var item2 = e.target.closest ? e.target.closest(".conv-item") : null;
  if (item2) selectConv(item2.getAttribute("data-id"));
});
elConvList.addEventListener("contextmenu", function (e) {
  var item = e.target.closest ? e.target.closest(".conv-item") : null;
  if (!item) return;
  e.preventDefault();
  openConvMenu(item, item.getAttribute("data-id"));
});

/* ---- 命令面板 ---- */
var paletteItems = [], paletteSel = 0;
function paletteSources() {
  var out = [];
  function add(group, name, desc, iconName, key, fn) {
    out.push({ group: group, name: name, desc: desc, icon: iconName, key: key, fn: fn });
  }
  add("操作", "新建对话", "Ctrl+N", "plus", "Ctrl N", function () { newConversationUI(); });
  add("操作", generating ? "停止生成" : "发送当前输入", generating ? "Esc" : "Enter", generating ? "stop" : "send", "Enter",
    function () { if (generating) stopGenerating(); else doSend(); });
  add("操作", "打开设置", "Ctrl+,", "sliders", "Ctrl ,", function () { openSettings(); });
  add("操作", "MCP 工具设置", "模型能否调用工具", "plug", "", function () { openSettings("mcp"); });
  add("操作", "使用教程与关于", "", "book", "F1", function () { openHelp(); });
  add("操作", "切换主题", "Ctrl+Shift+L", "palette", "", function () { cycleTheme(); });
  add("操作", "运行环境自检", "", "shield", "", function () { openSettings("env"); setTimeout(runDiagnostics, 120); });
  add("操作", "复制最后一条回答", "Ctrl+Alt+C", "copy", "", function () {
    var last = lastAssistantMsg();
    if (!last) { toast("还没有 AI 回答", "warn"); return; }
    copyText(contentToText(last.content), "已复制最后一条回答");
  });
  add("操作", "导出当前对话(Markdown)", "", "download", "", exportCurrentMd);
  add("操作", "导出全部数据(JSON)", "", "download", "", exportAll);
  add("操作", "清空当前对话消息", "", "eraser", "", function () { if (conv) clearConvMessages(conv.id); });
  add("操作", "压缩上下文", "丢弃较早的消息与附件(不可撤销)", "layers", "", function () { slashCompact(""); });
  add("操作", "清除本会话上下文", "等价于 /clear", "eraser", "", function () { slashClear(); });
  add("操作", "后台任务", "查看输出与中止", "clock", "", function () { openTasksModal(); });

  (state.fetchedModels || []).slice(0, 40).forEach(function (m) {
    add("模型", m, "切换到该模型", "cpu", "", function () { pickModel(m); });
  });
  state.conversations.slice().sort(function (a, b) { return b.updatedAt - a.updatedAt; })
    .slice(0, 40).forEach(function (c) {
      add("对话", c.title, c.messages.length + " 条消息 · " + timeAgo(c.updatedAt), "chat", "",
        function () { selectConv(c.id); });
    });
  /* 可见性旁路:去掉 toolsEnabled 早退,直接列 activeTools(conv) ——
     没有可用工具时自然一个条目也不加(以后只开外部 MCP 时这里才会出现外部工具);
     传当前会话 ⇒ 会话级覆盖也体现在这份清单里 */
  activeTools(conv).forEach(function (t) {
    add("MCP 工具", t.title + "(" + t.name + ")", "权限:" +
      (toolPermOf(t.name) === "ask" ? "每次询问" : toolPermOf(t.name) === "allow" ? "自动允许" : "禁止"),
      "plug", "", function () { openSettings("mcp"); });
  });
  return out;
}
function openPalette() {
  closeMenus();
  $("cmd-input").value = "";
  renderPalette("");
  openMask("palette-mask");
  setTimeout(function () { try { $("cmd-input").focus(); } catch (e) {} }, 50);
}
function renderPalette(kw) {
  var all = paletteSources();
  var k = (kw || "").toLowerCase().trim();
  var filtered = k ? all.filter(function (i) {
    return (i.name + " " + i.desc + " " + i.group).toLowerCase().indexOf(k) > -1;
  }) : all;
  paletteItems = filtered.slice(0, 60);
  paletteSel = 0;
  var box = $("cmd-list");
  if (!paletteItems.length) {
    box.innerHTML = '<div class="cmd-group">没有匹配项</div>';
    return;
  }
  var html = "", lastGroup = null;
  paletteItems.forEach(function (it, i) {
    if (it.group !== lastGroup) {
      lastGroup = it.group;
      html += '<div class="cmd-group">' + escapeHtml(it.group) + "</div>";
    }
    html += '<button class="cmd-item' + (i === 0 ? " sel" : "") + '" data-pi="' + i + '">' +
      '<span class="ci-ico">' + icon(it.icon, "sm") + "</span>" +
      '<span class="ci-txt"><span class="ci-name">' + escapeHtml(it.name) + "</span>" +
      (it.desc ? '<span class="ci-desc">' + escapeHtml(it.desc) + "</span>" : "") + "</span>" +
      (it.key ? '<span class="ci-key">' + escapeHtml(it.key) + "</span>" : "") + "</button>";
  });
  box.innerHTML = html;
  box.querySelectorAll(".cmd-item").forEach(function (b) {
    b.addEventListener("click", function () { runPaletteIndex(Number(b.getAttribute("data-pi"))); });
    b.addEventListener("mousemove", function () { selectPalette(Number(b.getAttribute("data-pi"))); });
  });
}
function selectPalette(i) {
  if (i < 0 || i >= paletteItems.length) return;
  paletteSel = i;
  var items = $$("#cmd-list .cmd-item");
  items.forEach(function (b, k) { b.classList.toggle("sel", k === i); });
  if (items[i] && items[i].scrollIntoView) items[i].scrollIntoView({ block: "nearest" });
}
function runPaletteIndex(i) {
  var it = paletteItems[i];
  if (!it) return;
  closeMask("palette-mask");
  setTimeout(function () { it.fn(); }, 30);
}
function runPaletteAction(name) {
  var it = paletteSources().filter(function (x) { return x.name === name; })[0];
  if (it) it.fn();
}

/* ---------------------------------------------------------------------------
   19.5 斜杠命令(在输入框里打 `/` 开浮窗) + /tasks 后台任务面板
--------------------------------------------------------------------------- */
/* 命令清单(唯一权威)。hint 只作展示;arg=true = 可带一段自由文本参数(命令名与参数之间用空白分隔);
   idle=true = 「生成中 / 压缩中」不可执行(Kimi 的 availability=idle-only 同义)。
   4 条命令**一律不接收附件**(deepseek 的 input.attachments 缺省即拒绝) */
var SLASH_COMMANDS = [
  { name: "compact", desc: "压缩当前会话的上下文", hint: "[自定义摘要侧重,可省略]", arg: true,  idle: true,  run: slashCompact },
  { name: "clear",   desc: "清除当前会话的全部上下文(不含后台任务)", hint: "", arg: false, idle: true,  run: slashClear },
  { name: "help",    desc: "使用教程与关于", hint: "", arg: false, idle: false, run: slashHelp },
  { name: "tasks",   desc: "查看后台任务与实时输出", hint: "", arg: false, idle: false, run: slashTasks }
];
var slashItems = [], slashSel = 0, slashFrozen = "";
/* WORD_CHAR 等价改写(参考实现是 /[\p{L}\p{N}_]/u):**CJK / 假名 / 谚文 / 全角字母数字一律按 word char**
   ⇒「中文/」「文件/」不开浮窗。不声称覆盖 \p{L}\p{N} 全集(希腊 / 西里尔 / 带音标拉丁不在类内,
   那几种文字后打 `/` 会开浮窗,Esc 可关);全角标点 `／`(U+FF0F)不在类内 —— 本仓库只认 ASCII `/` */
var SLASH_WORD_RE = /[0-9A-Za-z_\u3040-\u30FF\u3400-\u4DBF\u4E00-\u9FFF\uAC00-\uD7AF\uF900-\uFAFF\uFF10-\uFF19\uFF21-\uFF3A\uFF41-\uFF5A]/;
function slashWs(ch) { return ch === " " || ch === "\t" || ch === "\n" || ch === "\r" || ch === "\f" || ch === "\v"; }
function slashBoundaryOk(draft, index) {
  if (index === 0) return true;                                  /* 草稿开头 */
  var prev = draft.charAt(index - 1);
  if (slashWs(prev)) return true;                                /* 空白之后 */
  if (SLASH_WORD_RE.test(prev)) return false;                    /* 词中(含 CJK)⇒ 不是命令起点 */
  if (prev === "/") return false;                                /* '//' 的第二斜杠(URL 豁免 1) */
  if (prev === ":" && index >= 2 && !slashWs(draft.charAt(index - 2))) return false;  /* scheme:/ (URL 豁免 2) */
  return true;                                                   /* 标点之后 */
}
/* 触发检测(纯核,照搬 deepseek-harness detect.ts 的边界规则):
   · 从光标向左扫到最近的空白,再要求那个"词"以 `/` 开头且过边界规则;
   · 参数形态:光标在空白之后,且前一个词恰好是**已写全**的命令名(如 `/compact 重点保留接口签名`),
     此时空白之后的文本算这条命令的参数(`arg=true` 的命令才消费) */
function slashDetect() {
  if (!elInput || typeof elInput.selectionStart !== "number") return null;
  var draft = String(elInput.value || "");
  var caret = elInput.selectionStart;
  if (caret > draft.length) caret = draft.length;
  var i, wordStart, start;
  for (i = caret - 1; i >= 0; i--) { if (slashWs(draft.charAt(i))) break; }
  wordStart = i + 1;
  if (draft.charAt(wordStart) === "/" && slashBoundaryOk(draft, wordStart)) {
    start = wordStart;
    return { name: draft.slice(start + 1, caret), query: draft.slice(start + 1, caret),
             args: "", start: start, end: caret };
  }
  /* ② 参数形态:光标之前存在一个「已写全的命令名」词 —— 命令名之后、同一行之内的文本算参数
     (例如 `/compact 重点保留接口签名`;命令名本身还在输入中时由 ① 处理) */
  var lineStart = draft.lastIndexOf("\n", caret - 1) + 1;
  for (i = caret - 1; i >= lineStart; i--) {
    if (draft.charAt(i) !== "/") continue;
    if (!slashBoundaryOk(draft, i)) continue;
    var nameEnd = i + 1;
    while (nameEnd < draft.length && !slashWs(draft.charAt(nameEnd))) nameEnd++;
    if (nameEnd >= caret) continue;                       /* 光标还在命令名里 ⇒ 不是参数形态 */
    var nm = draft.slice(i + 1, nameEnd).toLowerCase();
    if (!slashCommand(nm)) continue;
    var argText = draft.slice(nameEnd, caret);
    if (argText.indexOf("\n") > -1) continue;             /* 参数只认同一行 */
    return { name: nm, query: nm, args: argText.replace(/^[ \t]+/, ""), start: i, end: caret };
  }
  return null;
}
function slashCommand(name) {
  var k = String(name == null ? "" : name).toLowerCase(), i;
  for (i = 0; i < SLASH_COMMANDS.length; i++) if (SLASH_COMMANDS[i].name === k) return SLASH_COMMANDS[i];
  return null;
}
/* 过滤:精确命中 → name 前缀 → name 子串 → desc 子串;空 query = 全部 */
function slashFilter(query) {
  var k = String(query == null ? "" : query).toLowerCase();
  if (!k) return SLASH_COMMANDS.slice();
  var exact = [], pre = [], sub = [], byDesc = [], i, c, n;
  for (i = 0; i < SLASH_COMMANDS.length; i++) {
    c = SLASH_COMMANDS[i]; n = c.name;
    if (n === k) exact.push(c);
    else if (n.indexOf(k) === 0) pre.push(c);
    else if (n.indexOf(k) > -1) sub.push(c);
    else if (c.desc.toLowerCase().indexOf(k) > -1) byDesc.push(c);
  }
  return exact.concat(pre, sub, byDesc);
}
/* 冻结当前高亮:候选被重新过滤后仍按 Enter 执行同一条命令(deepseek menu.ts 的单一 highlight 同义) */
function slashFreeze() {
  var it = slashItems[slashSel];
  slashFrozen = it ? it.name : "";
}
function slashOpen() {
  if (!$("slash-menu")) return;
  var sl = slashDetect();
  if (!sl) return;
  slashRender(slashFilter(sl.query));
}
function slashClose() {
  var el = $("slash-menu");
  if (el) { el.classList.remove("open"); el.innerHTML = ""; }
  slashItems = []; slashSel = 0; slashFrozen = "";
}
/* 渲染候选(全部动态文本走 escapeHtml;名称与描述虽是常量,也不破例写裸 innerHTML 拼接) */
function slashRender(items) {
  var el = $("slash-menu");
  if (!el) return;
  slashItems = items || [];
  if (!slashItems.length) { slashClose(); return; }                 /* 空结果自动关闭 */
  var idx = 0, i;
  if (slashFrozen) {
    for (i = 0; i < slashItems.length; i++) if (slashItems[i].name === slashFrozen) { idx = i; break; }
  }
  slashSel = idx;
  var html = "";
  for (i = 0; i < slashItems.length; i++) {
    var c = slashItems[i];
    html += '<button type="button" class="slash-item' + (i === slashSel ? " sel" : "") + '"' +
      ' role="option" aria-selected="' + (i === slashSel ? "true" : "false") + '" data-si="' + i + '">' +
      "<b>/" + escapeHtml(c.name) + "</b>" +
      "<span>" + escapeHtml(c.desc) + "</span>" +
      (c.hint ? "<em>" + escapeHtml(c.hint) + "</em>" : "") + "</button>";
  }
  el.innerHTML = html;
  var bs = el.querySelectorAll(".slash-item");
  for (i = 0; i < bs.length; i++) {
    (function (b) {
      var k = Number(b.getAttribute("data-si"));
      b.addEventListener("mousemove", function () {
        if (k === slashSel) return;
        slashSel = k; slashFreeze(); slashRender(slashItems);
      });
      b.addEventListener("click", function () {
        slashSel = k; slashFreeze();
        var sl = slashDetect();
        slashRun(slashItems[slashSel].name, sl ? sl.args : "");
      });
    })(bs[i]);
  }
  el.classList.add("open");
}
function slashMove(dir) {
  if (!slashItems.length) return;
  slashSel = (slashSel + (dir < 0 ? -1 : 1) + slashItems.length) % slashItems.length;
  slashFreeze();
  slashRender(slashItems);
}
/* idle-only 命令的忙碌门(返回 null = 可执行) */
function slashBusy(name) {
  var c = slashCommand(name);
  if (!c || !c.idle) return null;
  if (generating) return "正在生成中,请先按 Esc 停止再执行 /" + c.name;
  if (typeof CX_RUN !== "undefined" && CX_RUN && CX_RUN.phase !== "idle") return "正在压缩中,请稍候";
  return null;
}
/* 执行命令:命令不落消息 —— 先清掉输入框(带附件时附件保留并提示,命令不接附件),
   再分发到 SLASH_COMMANDS[i].run;结果由各命令自己用 toast / 弹窗表达 */
async function slashRun(name, args) {
  var c = slashCommand(name);
  if (!c) { toast("没有这个命令:/" + String(name || ""), "warn", 3000); return; }
  var busy = slashBusy(c.name);
  if (busy) { toast(busy, "warn", 3600); return; }
  elInput.value = "";
  if (draftFiles.length) toast("斜杠命令不接收附件:附件已保留在输入框", "warn", 3600);
  autoResize(); updateCtxMeter();
  slashClose();
  try {
    await c.run(c.arg ? String(args == null ? "" : args).trim() : "");
  } catch (e) {
    toast("命令执行出错:" + ((e && e.message) || e), "warn", 4200);
  }
  focusInput();
}
function slashCompact(argStr) {
  if (!conv) { toast("还没有对话,先发一条消息", "warn"); return; }
  cxCompactUIApply(conv.id, String(argStr || "").trim());
}
function slashClear() {
  if (!conv) { toast("还没有对话,先发一条消息", "warn"); return; }
  /* 与命令面板同一条入口、同一套文案(clearConvMessages 内含忙碌门与确认弹窗) */
  clearConvMessages(conv.id);
}
function slashHelp() { openHelp(); }
function slashTasks() { openTasksModal(); }

/* ---- /tasks:当前会话的后台任务(实时输出 + 手动中止) ---- */
var tasksModalConvId = null, tasksModalTimer = null;
/* 弹窗内的会话对象辅助:`pvListTasks` / `pvRunningList` 取的是**会话对象的 id**,
   传字符串会静默列出空集(P2-新7),所以一律经这里换算 */
function tasksConv() {
  return (tasksModalConvId ? getConv(tasksModalConvId) : null) || conv;
}
function openTasksModal(convId) {
  var c = convId ? getConv(convId) : conv;
  tasksModalConvId = c ? c.id : null;
  renderTasksModal();
  openMask("tasks-modal");
  /* 1s 逐行 Paint(不整体重建);关弹窗必须停表,见 closeTasksModal */
  if (!tasksModalTimer) tasksModalTimer = setInterval(tasksModalTick, 1000);
}
function renderTasksModal() {
  var c = tasksConv();
  var list = c ? pvListTasks(c) : [];
  var note = $("tasks-note"), box = $("tasks-list");
  if (!note || !box) return;
  var run = 0, i;
  for (i = 0; i < list.length; i++) if (!pvIsTerminal(list[i].status)) run++;
  note.textContent = (c ? "会话「" + (c.title || "未命名") + "」: " : "") +
    "运行中 " + run + " 个 · 共 " + list.length + " 个。任务只属于创建它的会话,且不跨页面刷新存活(刷新即失联)。";
  box.__n = list.length;
  if (!list.length) {
    box.innerHTML = '<div class="tasks-empty">当前会话没有后台 Python 任务。</div>';
    return;
  }
  /* 行 = 与卡片行**同一构建路径**(pvTaskRowEnsure / Paint);弹窗内不吃 .tool-card 作用域的
     CSS,由 head.part 里 `#tasks-list` 作用域的同名规则成对复制(P2-13) */
  box.innerHTML = "";
  for (i = 0; i < list.length; i++) {
    var row = document.createElement("div");
    row.className = "tc-task";
    row.setAttribute("data-task", list[i].id);
    pvTaskRowEnsure(row, list[i]);
    box.appendChild(row);
  }
}
/* 每秒:逐行 Paint(不动行结构);行集合变了(新任务 / 任务被淘汰)才重建一次 */
function tasksModalTick() {
  var m = $("tasks-modal"), box = $("tasks-list");
  if (!m || !box || !m.classList.contains("open")) return;
  var c = tasksConv();
  if (!c) return;
  var list = pvListTasks(c), i, row;
  if (box.__n !== list.length) { renderTasksModal(); return; }
  for (i = 0; i < list.length; i++) {
    row = box.querySelector('.tc-task[data-task="' + cssEscape(list[i].id) + '"]');
    if (row) pvTaskRowPaint(row, list[i]);
  }
}
function closeTasksModal() {
  if (tasksModalTimer) { clearInterval(tasksModalTimer); tasksModalTimer = null; }
  var box = $("tasks-list");
  if (box) {
    /* 行里的元素引用一并清掉(防泄漏),DOM 清空 ⇒ 下次打开重建 */
    var rows = box.querySelectorAll(".tc-task"), i;
    for (i = 0; i < rows.length; i++) rows[i].__parts = null;
    box.innerHTML = "";
    box.__n = -1;
  }
  var m = $("tasks-modal");
  if (m) m.classList.remove("open");
  tasksModalConvId = null;
}

/* ---- 对话内查找 ---- */
var findState = { kw: "", hits: [], idx: -1 };
function openFind() {
  $("find-bar").classList.add("open");
  setTimeout(function () { try { $("find-input").focus(); $("find-input").select(); } catch (e) {} }, 40);
}
function closeFind() {
  $("find-bar").classList.remove("open");
  findState = { kw: "", hits: [], idx: -1 };
  $("find-count").textContent = "";
  clearFindHighlights();
}
function clearFindHighlights() {
  $$("mark.search-hit", elChatInner).forEach(function (m) {
    var parent = m.parentNode;
    if (!parent) return;
    parent.replaceChild(document.createTextNode(m.textContent), m);
    parent.normalize();
  });
}
function runFind(kw, noScroll) {
  findState.kw = String(kw || "").trim();
  clearFindHighlights();
  if (!findState.kw) { findState.hits = []; findState.idx = -1; $("find-count").textContent = ""; return; }
  var needle = findState.kw.toLowerCase();
  var walked = [];
  if (document.createTreeWalker) {
    var w = document.createTreeWalker(elChatInner, NodeFilter.SHOW_TEXT, null, false), n;
    while ((n = w.nextNode())) {
      if (!n.nodeValue) continue;
      var p = n.parentNode;
      if (!p || (p.nodeName || "").toLowerCase() === "mark") continue;
      if (n.nodeValue.toLowerCase().indexOf(needle) > -1) walked.push(n);
    }
  }
  walked.forEach(function (node) {
    var val = node.nodeValue, lower = val.toLowerCase();
    var frag = document.createDocumentFragment(), cursor = 0, pos;
    while ((pos = lower.indexOf(needle, cursor)) > -1) {
      if (pos > cursor) frag.appendChild(document.createTextNode(val.slice(cursor, pos)));
      var mk = document.createElement("mark");
      mk.className = "search-hit";
      mk.textContent = val.slice(pos, pos + needle.length);
      frag.appendChild(mk);
      cursor = pos + needle.length;
    }
    if (!frag.childNodes.length) return;
    if (cursor < val.length) frag.appendChild(document.createTextNode(val.slice(cursor)));
    node.parentNode.replaceChild(frag, node);
  });
  findState.hits = $$("mark.search-hit", elChatInner);
  findState.idx = findState.hits.length ? 0 : -1;
  focusFindHit(0, !!noScroll);
}
function focusFindHit(i, silent) {
  var hits = findState.hits;
  hits.forEach(function (h) { h.classList.remove("cur"); });
  if (!hits.length) {
    $("find-count").textContent = "无匹配";
    return;
  }
  if (i < 0) i = hits.length - 1;
  if (i >= hits.length) i = 0;
  findState.idx = i;
  hits[i].classList.add("cur");
  $("find-count").textContent = (i + 1) + " / " + hits.length;
  if (!silent) {
    var msg = hits[i].closest ? hits[i].closest(".msg") : null;
    if (msg && msg.scrollIntoView) msg.scrollIntoView({ block: "center", behavior: state.settings.fx ? "smooth" : "auto" });
    else if (hits[i].scrollIntoView) hits[i].scrollIntoView({ block: "center" });
  } else if (hits.length === 1) {
    var m2 = hits[0].closest ? hits[0].closest(".msg") : null;
    if (m2 && m2.scrollIntoView) m2.scrollIntoView({ block: "center" });
  }
}
function stepFind(delta) {
  if (!findState.hits.length) return;
  focusFindHit(findState.idx + delta, false);
}

/* ---------------------------------------------------------------------------
   21. 界面事件绑定
--------------------------------------------------------------------------- */
function syncSidebarBackdrop() {
  var sb = $("sidebar");
  if (!sb) return;
  $("sidebar-backdrop").classList.toggle("show", isMobile() && !sb.classList.contains("collapsed"));
}
function closeSidebarMobile() { $("sidebar-backdrop").classList.remove("show"); }
function openSidebarMobile() {
  $("sidebar").classList.remove("collapsed");
  $("sidebar-backdrop").classList.add("show");
  wsRailClose();   /* 窄屏下两块抽屉互斥,免得叠在一起打架 */
}
/* 收起侧栏:窄屏下同时收掉遮罩,桌面端只是让它滑出屏幕 */
function collapseSidebar() {
  $("sidebar").classList.add("collapsed");
  closeSidebarMobile();
  /* 左栏收起会吃掉 railColMin() 里的左栏宽度 ⇒ 右栏要让位判定重来一次 */
  if (typeof wsRailRefit === "function") wsRailRefit();
}
function isMobile() { return window.innerWidth <= 880; }

/* ---- 侧栏自动回缩:聊天区被挤到下限时让位,窗口变宽后自动展开 ----
   判定只看「当前状态 + 可用宽度」,不再记「是不是自动收的」:
   手动收起后只要窗口宽度真的变了(≥24px),就会按阈值重新开合,不会一直卡在收起状态。 */
var MIN_CHAT_W = 760;                 /* 「非紧凑」下的对话区下限;紧凑模式见 minChatW() */
var RAIL_W = 340, RAIL_W_CMP = 300;   /* 右栏兜底宽(正常路径仍取 offsetWidth) */
var lastFitW = -1;
/* ---- 右栏形态机(column 占位 / float 窄窗小窗 / drawer ≤880 抽屉) ----
   RAIL_FORM = **生效形态**(只在「打开动作」里锁定、在「关闭动作」里清空;"" = 未打开/无锁定)
   railForm() = 当前宽度下"应该"是什么形态(纯推导,随宽度与左栏状态随时变,不是状态)
   data-rail-form 属性只承载生效形态(未锁定时 = 推导值,纯样式用途、无锁定语义)
   RAIL_AUTO = 「当前不可见」是不是自动让位造成的(纯内存,不持久化)
   ⚠️ clearRailForm() 不接受参数:传 railForm() 进去等于又锁住,形态机就废了 */
var RAIL_FORM = "";
var RAIL_AUTO = false;
function minChatW() { return state.settings.compact ? 620 : MIN_CHAT_W; }
function railW() {
  var r = wsRailEl();
  if (r && r.offsetWidth) return r.offsetWidth;
  return state.settings.compact ? RAIL_W_CMP : RAIL_W;
}
/* 列形态所需的最小窗口宽(左栏收起时左栏计 0);提示文案与"宽窗/窄窗"判据都用它 */
function railColMin() { return minChatW() + sidebarWidthForRail() + railW(); }
function railForm() {
  if (isMobile()) return "drawer";
  if (window.innerWidth >= railColMin()) return "column";
  return "float";
}
function wsRailFormGet() { return RAIL_FORM || "column"; }
function syncRailFormAttr() { document.documentElement.setAttribute("data-rail-form", RAIL_FORM || railForm()); }
function lockRailForm(f) { RAIL_FORM = f || railForm(); syncRailFormAttr(); }
function clearRailForm() { RAIL_FORM = ""; syncRailFormAttr(); }
/* 只在未打开(!RAIL_FORM)时把属性刷新成推导值:纯属性写入,无 IO、不触发重判 ⇒ 无递归 */
function wsRailApplyForm() { if (!RAIL_FORM) syncRailFormAttr(); }
function sidebarWidth() {
  var sb = $("sidebar");
  return (sb && sb.offsetWidth) ? sb.offsetWidth : 278;
}
/* ---- 右栏状态判定:railWidth 用 offsetWidth,且贴边隐藏的 340px 不参与计算 ---- */
function wsRailEl() { return $("ws-rail"); }
function wsRailVisible() { var r = wsRailEl(); return !!(r && !r.hasAttribute("hidden")); }
function wsRailCollapsed() { var r = wsRailEl(); return !r || r.classList.contains("collapsed"); }
/* 只有「生效形态 = 列 且 可见」的右栏才占位(float / drawer 都不占位) */
function railWidth() {
  var r = wsRailEl();
  if (!r || r.hasAttribute("hidden") || r.classList.contains("collapsed")) return 0;
  if (wsRailFormGet() !== "column") return 0;
  return r.offsetWidth || 0;
}
/* 开合右栏后重判一次布局:把 lastFitW 归零,免得 24px 的变化阈值把这次重判挡回去 */
function wsRailRefit() { lastFitW = -1; autoFitSidebar(false); }
/* 左栏在「右栏让位判定」里的宽度:左栏收起是 margin-left:-278px(offsetWidth 仍是 278),
   所以收起时按 0 计 —— 与 railWidth() 对右栏同口径。
   只用于右栏让位判定;左栏自身的回缩/展开口径仍是 sidebarWidth()。 */
function sidebarWidthForRail() {
  var sb = $("sidebar");
  if (!sb || sb.classList.contains("collapsed")) return 0;
  return sidebarWidth();
}
/* 右栏保持打开所需的最小窗口宽(提示文案用,按「左栏展开」这一最坏情形算) */
function wsRailMinWidth() {
  return minChatW() + sidebarWidth() + railW();
}
/* force=true 时忽略宽度变化阈值(初始化 / 切协议等场景直接按当前宽度判定) */
function autoFitSidebar(force) {
  wsRailApplyForm();                     /* 未打开时把属性同步成推导值(便宜、无副作用) */
  if (isMobile()) {
    /* 进入窄屏:桌面列形态必须收回(否则抽屉形态盖住整页、还没遮罩);意图保留,拉宽后可恢复。
       ★ 只对「生效形态是列」的动手 —— 用户主动开的抽屉(RAIL_FORM==="drawer")不能被重判收掉 */
    if (RAIL_FORM === "column" && wsRailVisible() && !wsRailCollapsed()) wsRailCollapseAuto();
    /* 桌面浮窗进入 ≤880:在窄屏里它本来就是抽屉 ⇒ 把生效形态改写实(属性不能指向不存在的几何) */
    else if (RAIL_FORM === "float") lockRailForm("drawer");
    return;
  }
  /* 离开抽屉(≤880 → ≥881):抽屉几何只存在于窄屏,回到桌面等价于「放不下」⇒ 收回,意图保留;
     等宽度真的进入列阈值(第 6 步)再恢复 —— 与 D-E「离开 drawer 不自动弹浮窗」同口径 */
  if (RAIL_FORM === "drawer") {
    if (!wsRailCollapsed()) { wsRailCollapseAuto(); return; }
  }
  var sb = $("sidebar");
  if (!sb) return;
  var w = window.innerWidth;
  if (!force && lastFitW > 0 && Math.abs(w - lastFitW) < 24) return;
  lastFitW = w;
  /* 5) 缩窄自动收回:占位的「列」被挤没了 ⇒ 收回(RAIL_AUTO 记住"是让位造成的",意图不动)。
        锁定形态是 float / drawer 时**不**让位:它们不占位,没有让位的理由。 */
  if (!wsRailCollapsed() && RAIL_FORM === "column" && railForm() !== "column") {
    wsRailCollapseAuto();
    return;
  }
  /* 6) 拉宽自动恢复:**只恢复列形态**(离开 drawer 后若仍放不下列就继续收着,
        等宽度真的够列时再恢复 —— 不自动弹浮窗);且只在"此前确实打开过"时才恢复。 */
  if (wsRailCollapsed() && RAIL_AUTO && wsRailOpenFlag() && railForm() === "column") {
    wsRailExpandAuto();
    return;
  }
  /* 7) 左栏判定(原样:右栏让位优先,同趟不再继续重判左栏) */
  var avail = w - sidebarWidth() - railWidth();
  var collapsed = sb.classList.contains("collapsed");
  if (avail < minChatW() && !collapsed) sb.classList.add("collapsed");
  else if (avail >= minChatW() + 80 && collapsed) sb.classList.remove("collapsed");
}

/* 使用教程与关于(hero + 教程卡 + 斜杠命令 + 快捷键 + 降级策略 + 关于)。
   hero 的作者名 / 链接 / 版本**只来自 appA 的常量**(APP_AUTHOR / APP_HOME_URL / APP_VERSION):
   URL 用 setAttribute(不接受用户输入),作者名与版本用 textContent —— 全部在弹窗打开前写好,
   否则 <a> 没有 href 时不可聚焦、键盘用户打不开。教程卡与命令表全部由 JS 生成,不散落字面量 */
function openHelp() {
  var modal = $("help-modal");
  if (!modal) return;
  var hero = $("about-hero");
  if (hero) {
    hero.setAttribute("href", APP_HOME_URL);
    hero.title = APP_HOME_URL;
  }
  var au = modal.querySelector('[data-about="author"]');
  if (au) au.textContent = APP_AUTHOR;
  var vs = modal.querySelectorAll('[data-about="ver"]');
  for (var v = 0; v < vs.length; v++) vs[v].textContent = "v" + APP_VERSION;

  var guide = modal.querySelector('[data-about="guide"]');
  if (guide) {
    var cards = [
      { icon: "zap", title: "快速开始", items: [
        "打开即用:整个应用就是这一个 HTML 文件,双击运行,不需要服务器、不需要联网。",
        "在「设置 → 模型服务」填 Base URL 与 API Key(只存在本机浏览器里),再用「读取」拉取模型列表或手填模型名。",
        "在下方输入框写消息:Enter 发送,Shift+Enter 换行;草稿不会跨会话保留,切走前先发出去。"
      ] },
      { icon: "chat", title: "对话与分支", items: [
        "「重新生成」不会删掉后面的消息,而是新增一条分支 —— 气泡角上的 ‹n/N› 用来切分支。",
        "「编辑并重发」同样生成分支;分支随会话一起保存,也随导出备份一起走。",
        "左栏会话列表:点条目切换;点条目上的 ⋯ 或右键打开菜单(重命名 / 置顶 / 复制 / 导出 / 删除)。"
      ] },
      { icon: "clip", title: "附件", items: [
        "支持文本 / 图片 / PDF / 办公文档(doc、docx、ppt、pptx、xls、xlsx);单个文件 ≤ 50MB,一条消息最多 10 个。",
        "模型不支持图片时,图片会自动走本机 OCR(内嵌 Tesseract,首次使用需加载语言数据)。",
        "PDF 与办公文档在本机解析成文本与图像后再发送,解析过程放在后台,不阻塞界面。"
      ] },
      { icon: "plug", title: "工具与工作区", items: [
        "「设置 → MCP 工具」是总开关;每个工具有三态权限:每次询问 / 自动允许 / 禁止。",
        "挂载工作区后,模型能用 Read / Write / Edit / Glob / Grep / FileOps 读写沙箱虚拟盘(存在 IndexedDB 里,不上传)。",
        "ExecutePython 在页面内跑 CPython(可后台运行、随时看输出、随时中止);ExecuteJavaScript 跑在独立 Worker 沙箱里,默认断网。"
      ] },
      { icon: "layers", title: "上下文与压缩", items: [
        "输入框右侧的用量环 = 下一轮请求的上下文估算(点击看明细:构成、累计、窗口来源)。",
        "接近窗口上限时系统提示会告诉你;开启自动压缩后,会在发送前自动压缩一次(阈值可调、可关闭)。",
        "手动压缩:输入 /compact(可附一句摘要侧重),或让模型调用 Compact 工具 —— 压缩会丢弃较早的消息与附件,不可回看。",
        "/clear 清空当前会话的上下文(后台任务继续跑);/tasks 查看后台任务与实时输出,可逐个或全部中止。"
      ] },
      { icon: "download", title: "数据与备份", items: [
        "设置存在 localStorage,会话与附件存在 IndexedDB,都在本机;多标签页之间自动同步。",
        "「导出全部(JSON)」是完整备份(含 API Key,请妥善保管);导入会把备份里的会话合并进来。",
        "空间快满时会出现「清理空间」:按勾选项清理并保留最近若干个对话 —— 应用不做无感删除。"
      ] },
      { icon: "shield", title: "隐私与离线", items: [
        "零外部请求:库、字体、图标全部内嵌在这一个文件里,断网也能完整运行。",
        "只有你自己填写的 API 地址会收到请求;API Key 只存在本机浏览器。",
        "页面不对外暴露任何接口(没有 window API、postMessage 或本地 HTTP 端点)。"
      ] }
    ];
    var gh = "", ci;
    for (ci = 0; ci < cards.length; ci++) {
      var cd = cards[ci];
      gh += '<div class="about-card"><b>' + icon(cd.icon, "sm") + escapeHtml(cd.title) + "</b><ul>";
      for (var li = 0; li < cd.items.length; li++) gh += "<li>" + escapeHtml(cd.items[li]) + "</li>";
      gh += "</ul></div>";
    }
    guide.innerHTML = gh;
  }

  var cmds = modal.querySelector('[data-about="cmds"]');
  if (cmds) {
    /* 命令表直接读 SLASH_COMMANDS(单一权威),不再抄一份 */
    var ch = '<dl class="kv">', k;
    for (k = 0; k < SLASH_COMMANDS.length; k++) {
      var sc = SLASH_COMMANDS[k];
      ch += "<dt>/" + escapeHtml(sc.name) + "</dt><dd style='font-family:var(--font-ui)'>" +
        escapeHtml(sc.desc) + (sc.hint ? " " + escapeHtml(sc.hint) : "") + "</dd>";
    }
    ch += "</dl>";
    cmds.innerHTML = ch;
  }

  var meta = modal.querySelector('[data-about="meta"]');
  if (meta) {
    var mh = "<dt>版本</dt><dd data-about='ver'></dd>" +
      "<dt>作者</dt><dd data-about='author'></dd>" +
      "<dt>主页</dt><dd><a data-about='home' target='_blank' rel='noopener noreferrer'></a></dd>" +
      "<dt>许可</dt><dd>GPL-3.0</dd>";
    meta.innerHTML = mh;
    var mv = meta.querySelector('[data-about="ver"]');
    if (mv) mv.textContent = "v" + APP_VERSION;
    var ma = meta.querySelector('[data-about="author"]');
    if (ma) ma.textContent = APP_AUTHOR;
    var mhr = meta.querySelector('[data-about="home"]');
    if (mhr) { mhr.setAttribute("href", APP_HOME_URL); mhr.textContent = APP_HOME_URL; }
  }

  $("shortcut-kv").innerHTML = SHORTCUTS.map(function (s) {
    return "<dt><kbd>" + escapeHtml(s[0]) + "</kbd></dt><dd style='font-family:var(--font-ui)'>" + escapeHtml(s[1]) + "</dd>";
  }).join("");
  var deg = (ENV.soft || []).length;
  $("help-env").innerHTML = deg
    ? "当前环境有 " + deg + " 项能力缺失,页面已自动关闭对应功能:<br>" +
      ENV.soft.map(function (s) { return "· " + escapeHtml(s); }).join("<br>")
    : "所有可选能力均可用,未触发任何降级。";
  openMask("help-modal");
}

function bindUI() {
  /* 侧边栏 */
  $("btn-new-chat").addEventListener("click", function () { newConversationUI(); });
  var searchEl = $("conv-search"), searchWrap = $("conv-search-wrap");
  searchEl.addEventListener("input", function () {
    convSearchKw = searchEl.value.trim().toLowerCase();
    searchWrap.classList.toggle("has-value", !!searchEl.value);
    renderConvList();
  });
  $("conv-search-clear").addEventListener("click", function () {
    searchEl.value = ""; convSearchKw = "";
    searchWrap.classList.remove("has-value");
    renderConvList(); searchEl.focus();
  });
  $("btn-theme").addEventListener("click", cycleTheme);
  $("btn-theme-top").addEventListener("click", cycleTheme);
  $("btn-mcp").addEventListener("click", function () { openSettings("mcp"); });
  $("btn-settings").addEventListener("click", function () { openSettings(); });
  $("btn-help").addEventListener("click", openHelp);
  $("sidebar-backdrop").addEventListener("click", function () { collapseSidebar(); });

  /* 顶栏 */
  $("btn-toggle-sidebar").addEventListener("click", function () {
    if (isMobile()) {
      if ($("sidebar").classList.contains("collapsed")) openSidebarMobile();
      else collapseSidebar();
    } else {
      $("sidebar").classList.toggle("collapsed");
      syncSidebarBackdrop();
      /* 桌面分支不经 collapseSidebar();Ctrl+B 也走这里 ⇒ 左栏开合后右栏必须重判一次 */
      if (typeof wsRailRefit === "function") wsRailRefit();
    }
  });
  $("btn-side-close").addEventListener("click", function () {
    collapseSidebar();
    toast("侧边栏已收起 · Ctrl+B 可再打开", "info", 1400);
  });
  elConvTitle.addEventListener("click", function () {
    if (!conv) { toast("还没有对话,点「新建对话」开始", "info"); return; }
    openConvMenu(elConvTitle, conv.id);
  });
  $("model-chip").addEventListener("click", openModelPicker);
  $("btn-palette").addEventListener("click", openPalette);
  $("btn-find").addEventListener("click", openFind);

  /* 命令面板 */
  $("cmd-close").addEventListener("click", function () { closeMask("palette-mask"); focusInput(); });
  $("cmd-input").addEventListener("input", function () { renderPalette(this.value); });
  $("cmd-input").addEventListener("keydown", function (e) {
    if (e.key === "ArrowDown") { e.preventDefault(); selectPalette(Math.min(paletteSel + 1, paletteItems.length - 1)); }
    else if (e.key === "ArrowUp") { e.preventDefault(); selectPalette(Math.max(paletteSel - 1, 0)); }
    else if (e.key === "Enter") { e.preventDefault(); runPaletteIndex(paletteSel); }
    else if (e.key === "Home") { e.preventDefault(); selectPalette(0); }
    else if (e.key === "End") { e.preventDefault(); selectPalette(paletteItems.length - 1); }
  });

  /* 查找栏 */
  $("find-input").addEventListener("input", function () { runFind($("find-input").value); });
  $("find-input").addEventListener("keydown", function (e) {
    if (e.key === "Enter") { e.preventDefault(); stepFind(e.shiftKey ? -1 : 1); }
    if (e.key === "Escape") { e.preventDefault(); closeFind(); }
  });
  $("find-next").addEventListener("click", function () { stepFind(1); });
  $("find-prev").addEventListener("click", function () { stepFind(-1); });
  $("find-close").addEventListener("click", closeFind);

  /* /tasks 弹窗:任务行的「停止」走事件委托(行内容由 pvTaskRowPaint 就地改,
     按钮可能被替换 —— 逐行绑监听会漏);「全部停止」= 逐个走**同一个**入口 */
  var tasksBox = $("tasks-list");
  if (tasksBox) {
    tasksBox.addEventListener("click", function (e) {
      var b = e.target && e.target.closest ? e.target.closest("[data-task-stop]") : null;
      if (b) pvStopTaskFromUI(b.getAttribute("data-task-stop"));
    });
  }
  var tasksAll = $("tasks-stop-all");
  if (tasksAll) {
    tasksAll.addEventListener("click", function () {
      var c = tasksConv();
      if (!c) return;
      var run = pvRunningList(c);            /* 行集合与弹窗同源 */
      if (!run.length) { toast("当前没有运行中的任务", "info", 3000); return; }
      for (var i = 0; i < run.length; i++) pvStopTaskFromUI(run[i].id);
    });
  }

  /* 输入区 */
  elInput.addEventListener("input", function () {
    autoResize(); updateCtxMeter();
    /* 斜杠浮窗跟随输入:触发符消失 / 候选为空 ⇒ 自动关闭(slashRender 空结果即关) */
    if (slashDetect()) slashOpen(); else slashClose();
  });
  elInput.addEventListener("keydown", function (e) {
    /* 斜杠浮窗开着时先吃键盘:↑↓(与 Tab)移动、Enter 执行命令(不发送消息)。
       Esc 交给全局 onKeyDown —— 那里要按「浮窗 → 弹层 → 停止生成」的顺序关 */
    if ($("slash-menu").classList.contains("open") && slashItems.length) {
      if (e.key === "ArrowDown") { e.preventDefault(); slashMove(1); return; }
      if (e.key === "ArrowUp") { e.preventDefault(); slashMove(-1); return; }
      if (e.key === "Tab") { e.preventDefault(); slashMove(e.shiftKey ? -1 : 1); return; }
      if (e.key === "Enter" && !e.shiftKey && !e.isComposing && e.keyCode !== 229) {
        e.preventDefault();
        var sl = slashDetect();
        slashRun(slashItems[slashSel].name, sl ? sl.args : "");
        return;
      }
    }
    if (e.key === "Enter" && !e.shiftKey && !e.isComposing && e.keyCode !== 229) {
      e.preventDefault();
      if (generating) { sqEnqueueFromInput(); return; }          /* 本批:生成中进缓冲 */
      if (!elInput.value.trim() && !draftFiles.length && sqSendableIdle()) { sqSendHead(); return; }
      doSend();
    }
    /* ↑ 召回最后一条(严格:输入框完全为空 + 无修饰键 + 非组合 + 斜杠浮窗未开时才有意义;
       有意**不**补 Kimi 的 busy 门 —— 空闲也允许召回,否则 ECOMPACT_ABORT 残留态无法用 ↑ 恢复) */
    if (e.key === "ArrowUp" && !e.shiftKey && !e.ctrlKey && !e.metaKey && !e.altKey && !e.isComposing
        && elInput.value.length === 0 && sqHasFor(conv && conv.id)) {
      e.preventDefault();
      sqRecall(SQ.items[SQ.items.length - 1].id);
      return;
    }
  });
  elSend.addEventListener("click", function () { if (generating) stopGenerating(); else doSend(); });
  $("btn-attach").addEventListener("click", function () { $("attach-file").click(); });
  $("attach-file").addEventListener("change", function (e) {
    addFiles(e.target.files);
    e.target.value = "";
  });
  $("btn-clear-input").addEventListener("click", function () {
    elInput.value = ""; draftFiles = [];
    renderAttachBar(); autoResize(); updateCtxMeter(); focusInput();
  });
  $("btn-params").addEventListener("click", toggleParamsPop);
  $("ctx-meter").addEventListener("click", function () { toggleCtxPop(); });
  $("ctx-pop").addEventListener("click", function (e) {
    /* 弹层 body 每次 renderCtxPop 都重建 ⇒ 压缩按钮用事件委托绑在容器上 */
    var b = e.target && e.target.closest ? e.target.closest("[data-compact]") : null;
    if (!b) return;
    toggleCtxPop(false);
    cxCompactUIApply(conv ? conv.id : null, "");
  });
  $("ctx-close").addEventListener("click", function () { toggleCtxPop(false); focusInput(); });
  $("ctx-refresh").addEventListener("click", function () {
    var btn = this;
    btn.textContent = "读取中…";
    fetchCtxFromProps(false).then(function (v) {
      btn.textContent = "读取模型信息";
      updateCtxMonitor(); updateModelsHint();
      toast(v ? "已读取到上下文长度:" + num(v) + " token" : "服务端未返回上下文长度,仍按当前设定 " + ctxWinKNow() + "K 计",
        v ? "success" : "info", 2800);
    });
  });
  $("btn-insert-lib").addEventListener("click", function () { openLibMenu($("btn-insert-lib")); });
  $("btn-voice").addEventListener("click", toggleVoice);

  /* 拖拽与粘贴 */
  var main = $("main"), composer = $("composer");
  ["dragenter", "dragover"].forEach(function (evt) {
    main.addEventListener(evt, function (e) {
      if (!e.dataTransfer) return;
      e.preventDefault();
      composer.classList.add("drag-over");
    });
  });
  main.addEventListener("dragleave", function (e) {
    if (e.relatedTarget && main.contains(e.relatedTarget)) return;
    composer.classList.remove("drag-over");
  });
  main.addEventListener("drop", function (e) {
    e.preventDefault();
    composer.classList.remove("drag-over");
    if (e.dataTransfer && e.dataTransfer.files && e.dataTransfer.files.length) addFiles(e.dataTransfer.files);
  });
  document.addEventListener("paste", function (e) {
    if (e.target && e.target.closest && e.target.closest(".modal-mask")) return;
    var cd = e.clipboardData;
    if (!cd) return;
    if (cd.files && cd.files.length) {
      addFiles(cd.files);
      if (cd.files.length && cd.getData && !cd.getData("text/plain")) e.preventDefault();
      return;
    }
    if (cd.items) {
      for (var i = 0; i < cd.items.length; i++) {
        if (cd.items[i].kind === "file") {
          var f = cd.items[i].getAsFile();
          if (f) { addFiles([f]); e.preventDefault(); return; }
        }
      }
    }
  });

  /* 设置:标签页 */
  $$("#settings-tabs button").forEach(function (b) {
    b.addEventListener("click", function () { switchTab(b.getAttribute("data-tab")); });
  });
  /* 设置:协议 */
  $$("#proto-switch button").forEach(function (b) {
    b.addEventListener("click", function () { setProtocol(b.getAttribute("data-proto")); syncSettingsForm(); });
  });
  $$("#settings-modal [data-base]").forEach(function (b) {
    b.addEventListener("click", function () {
      $("set-base").value = b.getAttribute("data-base");
      state.settings.baseUrl = b.getAttribute("data-base");
      saveSoon();
      toast("已填入地址,记得点「保存设置」或「测试连接」", "info", 2400);
    });
  });
  $("btn-reveal-key").addEventListener("click", function () {
    var inp = $("set-key");
    var show = inp.type === "password";
    inp.type = show ? "text" : "password";
    this.innerHTML = icon(show ? "eye-off" : "eye", "sm");
  });
  $("btn-test").addEventListener("click", testConnection);
  $("btn-fetch-models-top").addEventListener("click", function () { saveSettingsFromModal(false, true); fetchModels(true, false); });
  $("btn-pick-model").addEventListener("click", function () { saveSettingsFromModal(false, true); openModelPicker(); });
  $("btn-fetch-models").addEventListener("click", function () { saveSettingsFromModal(false, true); fetchModels(true, false); });
  /* 模型名称:自绘候选浮层(替代原生 datalist),选定后立即刷新上下文窗口那一行 */
  var modelInput = $("set-model");
  modelInput.addEventListener("focus", function () { renderModelSuggest(); });
  modelInput.addEventListener("input", function () { renderModelSuggest(); });
  modelInput.addEventListener("keydown", function (e) {
    if (e.key === "Escape") { hideModelSuggest(); return; }
    if (e.key === "Enter") {
      e.preventDefault();
      var v = modelInput.value.trim();
      if (!v) { var first = document.querySelector("#model-suggest [data-model-pick]"); if (first) v = first.getAttribute("data-model-pick"); }
      hideModelSuggest();
      if (v) {
        state.settings.model = v;
        if (conv) conv.model = v;
        saveSoon(); updateTopbar();
        refreshModelCtx(v);
        renderModelsInline();
        toast("已切换模型:" + v, "success", 1800);
      }
    }
  });
  modelInput.addEventListener("blur", function () {
    /* 记下用户手填的模型名并刷新窗口信息(等一小会儿是为了让候选浮层的点击先处理) */
    setTimeout(function () {
      var v = modelInput.value.trim();
      hideModelSuggest();
      if (!v || v === state.settings.model) return;
      state.settings.model = v;
      if (conv) conv.model = v;
      saveSoon();
      refreshModelCtx(v);
    }, 180);
  });
  var modelListBtn = $("btn-model-list");
  if (modelListBtn) {
    /* mousedown 先 preventDefault:不让输入框失焦。
       否则「blur → 180ms 后 hideModelSuggest」的定时器会把这个刚展开的浮层又收回去
       —— 用户看到的就是「拉下来一下马上缩回」。 */
    modelListBtn.addEventListener("mousedown", function (e) { e.preventDefault(); });
    modelListBtn.addEventListener("click", function (e) {
      e.stopPropagation();
      if (isModelSuggestOpen()) { hideModelSuggest(); return; }
      if (document.activeElement !== modelInput) modelInput.focus();
      renderModelSuggest();
    });
  }
  var suggest = $("model-suggest");
  if (suggest) {
    /* mousedown:抢在输入框 blur 之前处理,免得浮层先被收起来 */
    suggest.addEventListener("mousedown", function (e) {
      var b = e.target && e.target.closest ? e.target.closest("[data-model-pick]") : null;
      if (!b) return;
      e.preventDefault();
      var name = b.getAttribute("data-model-pick");
      modelInput.value = name;
      hideModelSuggest();
      state.settings.model = name;
      if (conv) conv.model = name;
      saveSoon(); updateTopbar(); renderModelsInline();
      refreshModelCtx(name);
      toast("已切换模型:" + name, "success", 1800);
    });
  }
  $("btn-refresh-models").addEventListener("click", function () { fetchModels(true, false); });
  $("model-search").addEventListener("input", function () { renderModelOptions($("model-search").value); });
  $("model-search").addEventListener("keydown", function (e) {
    if (e.key !== "Enter") return;
    e.preventDefault();
    var v = $("model-search").value.trim();
    if (!v) {
      var first = document.querySelector("#model-options .model-opt");
      if (first) pickModel(first.getAttribute("data-name"));
      return;
    }
    pickModel(v);
  });
  /* 设置:表单 */
  RANGE_BIND.forEach(function (b) {
    var el = $(b[0]);
    if (!el) return;
    el.addEventListener("input", function () {
      state.settings[b[1]] = Number(el.value);
      syncRangeLabel(el);
      var mirror = $("p" + b[0].slice(3));
      if (mirror) mirror.value = el.value;
      if (b[1] === "compact") applyAppearance();
      if (b[1] === "codeWrap") applyCodeWrap();
      updateCtxMeter();
      saveSoon();
    });
  });
  SWITCH_BIND.forEach(function (b) {
    var el = $(b[0]);
    if (!el) return;
    el.addEventListener("change", function () {
      state.settings[b[1]] = !!el.checked;
      if (b[1] === "compact" || b[1] === "fx") applyAppearance();
      if (b[1] === "codeWrap") applyCodeWrap();
      if (b[1] === "showReasoning") renderChat();
      saveSoon();
    });
  });
  NUM_BIND.forEach(function (b) {
    var el = $(b[0]);
    if (!el) return;
    el.addEventListener("change", function () {
      /* 清空 / 非数字 → 默认值,越界 → 夹到区间;一律回写输入框,不留空框和脏值。
         取值口径与 mergeSettings / 保存设置同一处(numBindValue) */
      var v = numBindValue(el, b);
      state.settings[b[1]] = v;
      el.value = v;
      saveSoon();
    });
  });
  $$("#theme-switch button").forEach(function (b) {
    b.addEventListener("click", function () {
      state.settings.theme = b.getAttribute("data-theme");
      applyAppearance(); saveSoon();
    });
  });
  $$("#accent-switch .swatch").forEach(function (b) {
    b.addEventListener("click", function () {
      state.settings.accent = b.getAttribute("data-accent");
      applyAppearance(); saveSoon();
    });
  });
  /* 设置:自定义标签页图标(即时生效,与开关 / 主题色同一惯例;弹窗是 body 级节点,不碰附件拖放) */
  var favPreview = $("fav-preview");
  if (favPreview) {
    favPreview.addEventListener("click", function () { $("fav-file").click(); });
    ["dragenter", "dragover"].forEach(function (evt) {
      favPreview.addEventListener(evt, function (e) {
        if (!e.dataTransfer) return;
        e.preventDefault();
        if (e.dataTransfer.dropEffect !== undefined) e.dataTransfer.dropEffect = "copy";
        favPreview.classList.add("drop-over");
      });
    });
    favPreview.addEventListener("dragleave", function () { favPreview.classList.remove("drop-over"); });
    favPreview.addEventListener("drop", function (e) {
      e.preventDefault();
      favPreview.classList.remove("drop-over");
      var fs = e.dataTransfer && e.dataTransfer.files;
      if (fs && fs.length) applyFaviconFile(fs[0]);
    });
  }
  $("btn-fav-upload").addEventListener("click", function () { $("fav-file").click(); });
  $("fav-file").addEventListener("change", function (e) {
    if (e.target.files && e.target.files.length) applyFaviconFile(e.target.files[0]);
    e.target.value = "";
  });
  $("btn-fav-reset").addEventListener("click", function () {
    if (!state.settings.customIcon) { toast("当前就是默认图标", "info", 1800); return; }
    state.settings.customIcon = "";
    applyAppearance(); saveSoon(); syncFaviconUI();
    toast("已重置为默认图标", "success");
  });
  /* 设置:数据 */
  $("btn-export").addEventListener("click", exportAll);
  $("btn-export-md").addEventListener("click", exportCurrentMd);
  $("btn-import").addEventListener("click", function () { $("import-file").click(); });
  $("import-file").addEventListener("change", function (e) {
    importAll(e.target.files[0]);
    e.target.value = "";
  });
  $("btn-wipe").addEventListener("click", wipeAll);
  $("lib-add").addEventListener("click", function () {
    var n = $("lib-name").value.trim(), t = $("lib-text").value.trim();
    if (!n || !t) { toast("模板名称和内容都要填写", "warn"); return; }
    state.promptLib.push({ name: n, text: t });
    $("lib-name").value = ""; $("lib-text").value = "";
    saveSoon(); renderLibList(); renderPromptLibChips();
    toast("已添加模板", "success", 1600);
  });
  $("btn-diag").addEventListener("click", runDiagnostics);
  $("btn-copy-env").addEventListener("click", function () {
    copyText(envReportText(), "环境信息已复制,可直接贴给他人排查");
  });
  /* 数据面板:精确探测 / 清理历史图片 / 压缩 */
  var probeBtn = $("btn-probe-storage");
  if (probeBtn) {
    probeBtn.addEventListener("click", function () {
      probeBtn.disabled = true;
      toast("正在写入探测 localStorage 的真实上限…", "info", 2200);
      probeLocalStorageLimit().then(function (r) {
        probeBtn.disabled = false;
        renderDataPanel();
        updateStorageMeter();
        if (r && r.done) {
          toast("实测:已用 " + fmtBytes(storageBytes()) + ",还可写约 " + fmtBytes(r.freeChar), "success", 4200);
        } else {
          toast("当前浏览器不允许写入探测(可能是隐私模式)", "warn", 3600);
        }
      });
    });
  }

  $("btn-save-settings").addEventListener("click", function () { saveSettingsFromModal(true); });
  /* 系统提示词 */
  $("btn-save-system").addEventListener("click", function () {
    if (conv) {
      conv.system = $("conv-system").value;
      conv.updatedAt = Date.now();
      saveSoon();
      if ($("set-sys")) $("set-sys").value = state.settings.systemPrompt || "";
    }
    closeMask("prompt-modal");
    toast("系统提示词已保存", "success", 1800);
  });
  $("btn-clear-system").addEventListener("click", function () {
    $("conv-system").value = "";
  });

  /* 状态栏 */
  $("st-conn").addEventListener("click", function () { openSettings("model"); setTimeout(testConnection, 80); });
  $("st-ctx-wrap").addEventListener("click", function () { openSettings("gen"); });
  $("st-mcp-wrap").addEventListener("click", function () { openSettings("mcp"); });
  $("st-env-wrap").addEventListener("click", function () { openSettings("env"); });

  /* 键盘 */
  document.addEventListener("keydown", onKeyDown);
  var wasMobile = isMobile();
  window.addEventListener("resize", function () {
    var nowMobile = isMobile();
    if (nowMobile !== wasMobile) {
      wasMobile = nowMobile;
      if (nowMobile) collapseSidebar();   // 进入窄屏先收起,免得挡住整页
      else closeSidebarMobile();
      autoFitSidebar(true);               // 跨越窄屏阈值时立刻重判一次,不受 24px 阈值限制
    } else {
      autoFitSidebar();
    }
    syncSidebarBackdrop();
  });
  window.addEventListener("beforeunload", function (e) {
    if (!generating && !sqHasItems()) return;     /* 缓冲残留时同样给留页提示 */
    e.preventDefault();
    e.returnValue = "";
  });
  window.addEventListener("storage", onStorageSync);

  /* 工作区右栏 / 挂载菜单 / 上传 / 数据面板工作区区 */
  bindWsRail();
}

function onKeyDown(e) {
  var mod = e.ctrlKey || e.metaKey;
  var key = (e.key || "").toLowerCase();
  var inField = e.target && (e.target.tagName === "INPUT" || e.target.tagName === "TEXTAREA");

  if (key === "escape") {
    if (nselOpenId) { closeNsel(); return; }
    /* 斜杠浮窗优先于弹层(在 `.modal-mask.open` 判定之前):再按一次才轮到关弹层 / 停止生成 */
    if ($("slash-menu").classList.contains("open")) { slashClose(); return; }
    var anyOpen = $$(".modal-mask.open").length || popMenuEl.classList.contains("open")
      || $("params-pop").classList.contains("open") || lightboxEl.classList.contains("open")
      || $("ctx-pop").classList.contains("open");
    if (anyOpen) {
      /* 关之前给弹窗一次钩子式收尾:任务面板要停掉 1s 刷新定时器(closeMask 是裸 classList.remove) */
      if ($("tasks-modal").classList.contains("open")) closeTasksModal();
      closeAllMasks();
      /* 工作区预览的 objectURL 也要在这里回收(closeMask 没有钩子) */
      if (typeof wsPreviewCleanup === "function") wsPreviewCleanup();
      popMenuEl.classList.remove("open");
      $("params-pop").classList.remove("open");
      $("btn-params").classList.remove("on");
      lightboxEl.classList.remove("open");
      lightboxImg.removeAttribute("src");
      toggleCtxPop(false);
      return;
    }
    /* 浮窗 / 抽屉形态的右栏:Esc 与点遮罩一致地关掉它(列形态下不关,避免与既有习惯冲突) */
    if (!wsRailCollapsed() && wsRailVisible() && wsRailFormGet() !== "column") { wsRailClose(); return; }
    if ($("find-bar").classList.contains("open")) { closeFind(); return; }
    if (generating) { stopGenerating(); return; }
    /* 手动压缩(generating=false)期间的 Esc:中止压缩运行(请求与退避 sleep 都会断)。
       **不**调 stopGenerating —— 它会 denyAllToolWaits / killAllSandboxes / pvSuppressAutoLoop,
       对手动取消过重且误伤(cxCompactNow 的 finally 会把状态行恢复为「已连接」) */
    if (typeof cxRunActive === "function" && cxRunActive()) { cxAbortActive("用户取消压缩"); return; }
    return;
  }
  /* 有弹窗(任何 .modal-mask.open,含动态确认弹窗 #ask-modal-dyn)开着时,其余全局快捷键
     一律不响应:Ctrl+N / Ctrl+K / F1 … 会在确认弹窗还等着回答时新建对话、把等待确认的弹窗
     顶掉(openAskDialog 同 id 重建 ⇒ 旧弹窗按取消收尾)或切走会话,与原生 confirm() 的
     "系统模态"语义不符。放在 Esc 分支之后 —— Esc 关遮罩的既有行为不受影响 */
  if ($$(".modal-mask.open").length) return;
  if (!mod) {
    if (e.key === "F1") { e.preventDefault(); openHelp(); }
    if (e.key === "?" && !inField) { e.preventDefault(); openHelp(); }
    if (e.key === "PageDown" || e.key === "PageUp") return;
    return;
  }
  if (key === "k") { e.preventDefault(); openPalette(); return; }
  if (key === "o") {
    /* Ctrl+O:展开 / 折叠最后一张「上下文已压缩」卡片(与 Kimi 的 Ctrl-O 对齐) */
    e.preventDefault();
    var cards = elChatInner.querySelectorAll(".msg.compact-card");
    if (cards.length) {
      var last = cards[cards.length - 1];
      last.classList.toggle("expanded");
      var tg = last.querySelector(".cc-more");
      if (tg) tg.textContent = last.classList.contains("expanded") ? "收起" : "展开";
    }
    return;
  }
  if (key === "f") { e.preventDefault(); openFind(); return; }
  if (key === "m") { e.preventDefault(); openModelPicker(); return; }
  if (key === "b") { e.preventDefault(); $("btn-toggle-sidebar").click(); return; }
  if (e.key === ",") { e.preventDefault(); openSettings(); return; }
  if (key === "n" && !e.shiftKey && !e.altKey) { e.preventDefault(); newConversationUI(); return; }
  if (key === "l" && e.shiftKey) { e.preventDefault(); cycleTheme(); return; }
  if (key === "c" && e.altKey) {
    e.preventDefault();
    var last = lastAssistantMsg();
    if (last) copyText(contentToText(last.content), "已复制最后一条回答");
    return;
  }
  if (key === "p" && !e.shiftKey) { e.preventDefault(); openSettings(); return; }
}
function onStorageSync(e) {
  if (e.key !== LS_KEY) return;
  /* 工作区数据(IndexedDB)是同源共享的:另一个标签页的上传 / 删除会让本页的目录树缓存过期 */
  if (typeof wsrTreeReset === "function") {
    wsrTreeReset();
    if (wsRailOpenFlag() && !wsRailCollapsed()) renderWsRail();
  }
  /* 跨标签页的 storage 事件**一律不打断本页正在进行的生成**:
     对侧只是拨一下主题 / 外观开关这类纯噪声没有理由丢掉本页正在流式输出的回答;会话内容 /
     列表的变化(改名 / 置顶 / 删除 / 收敛)同样不该打断。设置的新值从下一轮请求自然生效 ——
     请求体每次都现取 state.settings,不靠 abort 去"立刻应用" */
  var prevSettings = JSON.stringify(state.settings);
  /* 会话列表先留一份内存副本当兜底:IDB 读失败时至少不比现在更差 */
  var fallbackConvs = state.conversations;
  state = loadState();
  var settingsChanged = JSON.stringify(state.settings) !== prevSettings;
  /* 会话本体的权威副本在 IndexedDB 时,localStorage 里**没有** conversations(stateRecord 不写),
     loadState() 给出的必然是空数组 —— 拿它覆盖内存态会让「另一个标签页一改设置,这边所有对话
     都不见了」。而"保留内存里的列表"只解决了一半:删除 / 清空 / 导入这些**方向**会让这边的列表
     变陈旧(B 显示已被删的会话、甚至把它连同新消息写回 IDB = 删除被复活)。所以 IDB 模式下
     以 IDB 为唯一权威:异步重载会话列表再渲染。 */
  if (convsInIdb()) {
    state.conversations = fallbackConvs;
    /* 版本号没有前进、设置也没变 ⇒ 这是同一批改动里的重复 / 陈旧事件(写入方会为一次改动推好几次
       版本号),不必再读一遍全库、也不必再全量重渲染 + 弹一次 toast。
       但 replaced 挂着时**不能**提前返回:它是"对侧整库替换过"的一次性标记,只有真的跑过
       mergeConvsByIdb 才会被消费 —— 提前 return 会让它滞留在内存里,等下一次无关的合并才生效,
       那一次会不必要地丢掉本页未落库的副本 */
    if (readConvsRev() <= convRevState.seen && !settingsChanged && !convRevState.replaced) return;
    syncConvsFromIdb();
    return;
  }
  finishStorageSync();
}
/* 会话列表从 IndexedDB 重载:同一批 storage 事件合并成一次(写入方是「先 setItem 再异步落 IDB」,
   留一点余量让删除/清空/导入的事务有机会先提交,否则读到的是事务前的旧列表)。
   合并口径见 mergeConvsByIdb():墓碑优先 > 本页还没落库的改动 > IDB 权威。
   窗口取 350ms 而不是更短:一次用户动作(比如删一条会话)会让写入方连推 3 个版本号,
   拉长到一个窗口里就只收敛一次 —— 反正读的都是当下已提交的 IDB 状态,合并成一次不会漏。
   activeId 在重载后仍然存在就保留当前会话,否则回落到第一条。 */
var convSyncTimer = null;
var CONV_SYNC_MERGE_MS = 350;
function syncConvsFromIdb() {
  if (convSyncTimer) clearTimeout(convSyncTimer);
  convSyncTimer = setTimeout(function () {
    convSyncTimer = null;
    pullConvsFromIdb().then(function () { finishStorageSync(); }, function () { finishStorageSync(); });
  }, CONV_SYNC_MERGE_MS);
}
function finishStorageSync() {
  conv = getConv(state.activeId) || state.conversations[0] || null;
  if (conv) state.activeId = conv.id;
  applyAppearance();
  syncSettingsForm();
  rebuildModelDatalist();
  renderChat(); renderConvList(); updateTopbar();
  updateCtxMeter(); updateStorageMeter();
  /* 「调节」浮层也随对侧改动回填:浮层开着时覆盖选择/计数就地更新,不必关掉重开 */
  syncParamTools();
  setConn(state.settings.baseUrl ? "ok" : "err", state.settings.baseUrl ? "已就绪" : "未配置地址");
  toast("已同步其他标签页的数据变更", "info", 2000);
}

/* ---- 语音输入 ---- */
/* 连续识别 + 自己判停:静音 VOICE_SILENCE_MS 没听到新内容才结束
   (浏览器自带的 stop 阈值太短,说到一半就被截断) */
var voiceRec = null, voiceOn = false, voiceTimer = null, voiceRestarts = 0;
var voiceBase = "", voiceDone = "", VOICE_SILENCE_MS = 5000;
function voiceResetTimer() {
  if (voiceTimer) clearTimeout(voiceTimer);
  voiceTimer = setTimeout(function () {
    voiceTimer = null;
    if (!voiceOn) return;
    toast("已 " + Math.round(VOICE_SILENCE_MS / 1000) + " 秒没有新的语音,输入结束", "info", 2000);
    stopVoice();
    focusInput();
  }, VOICE_SILENCE_MS);
}
function stopVoice() {
  voiceOn = false;
  if (voiceTimer) { clearTimeout(voiceTimer); voiceTimer = null; }
  var btn = $("btn-voice");
  if (btn) btn.classList.remove("rec");
  var r = voiceRec;
  voiceRec = null;
  if (r) { try { r.onend = null; r.onerror = null; r.onresult = null; r.stop(); } catch (e) {} }
}
function toggleVoice() {
  var btn = $("btn-voice");
  if (!CAP.recognition) { toast("当前浏览器不支持语音识别,该功能已自动关闭", "warn", 2600); return; }
  if (voiceOn) { stopVoice(); return; }
  var Ctor = window.SpeechRecognition || window.webkitSpeechRecognition;
  try {
    voiceRec = new Ctor();
  } catch (e) { toast("语音识别初始化失败:" + (e.message || e), "error"); return; }
  voiceRec.lang = "zh-CN";
  voiceRec.continuous = true;      // 由页面自己判停,不用浏览器的短静音阈值
  voiceRec.interimResults = true;
  voiceBase = elInput.value;
  voiceDone = "";
  voiceRestarts = 0;
  voiceRec.onresult = function (ev) {
    var interim = "";
    for (var i = ev.resultIndex; i < ev.results.length; i++) {
      var res = ev.results[i];
      var txt = res[0] ? (res[0].transcript || "") : "";
      if (res.isFinal) voiceDone += txt; else interim += txt;
    }
    elInput.value = voiceBase + voiceDone + interim;
    autoResize();
    voiceResetTimer();               // 有输入就把静音计时清零
  };
  voiceRec.onerror = function (ev) {
    var err = ev && ev.error ? ev.error : "未知";
    if (err === "no-speech" || err === "aborted") return;   // 交给 onend 重开,不算失败
    voiceOn = false;
    if (voiceTimer) { clearTimeout(voiceTimer); voiceTimer = null; }
    if (btn) btn.classList.remove("rec");
    toast("语音识别出错:" + err, "warn", 2600);
  };
  voiceRec.onend = function () {
    /* 浏览器自己收尾(超时 / 无语音)时自动续听,直到静音计时或用户手动停止 */
    if (!voiceOn) return;
    if (voiceRestarts++ > 60) { stopVoice(); return; }
    setTimeout(function () {
      if (!voiceOn || !voiceRec) return;
      try { voiceRec.start(); } catch (e) { stopVoice(); }
    }, 120);
  };
  try {
    voiceRec.start();
    voiceOn = true;
    if (btn) btn.classList.add("rec");
    voiceResetTimer();
    toast("正在聆听…(静音 " + Math.round(VOICE_SILENCE_MS / 1000) + " 秒后自动结束,再点一次可立即停止)", "info", 2600);
  } catch (e) {
    voiceOn = false;
    toast("无法启动语音识别:" + (e.message || e), "error");
  }
}

/* ---------------------------------------------------------------------------
   22. 工作区 UI:右侧栏面板 / 挂载菜单 / 上传链(单文件·批量·目录拖入)/
       下载链(单文件 + 整箱 zip)/ 申请持久化存储 / 设置 → 数据 的工作区区
   —— 面板只读;所有写操作一律走 appE 的 WS.* 内核(唯一 IDB 写入口)。
      上传的 Blob 直存 IDB(不读进内存、不转 base64),逐文件独立事务。
--------------------------------------------------------------------------- */

/* ---- 面板状态(纯运行时,不进设置) ---- */
var WS_RAIL_SEL = null;                                   /* 面板当前显示的工作区 id */
var WS_CWD = "/";                                         /* 面板当前目录 */
var WSR_LIMIT = 200, WSR_STEP = 200, WSR_LIMIT_MAX = 500; /* 单目录 200 行 + 「显示更多」 */
/* ---- 内联目录树(只读;key = 目录绝对路径) ----
   open = 展开态 / kids = 已载入的一层条目 / more = 该层已用的 limit(存在即还有下一页) / busy = 防重复点击 */
var WSR_TREE = { open: {}, kids: {}, more: {}, busy: {} };
var WSR_TREE_ORDER = [];              /* 缓存插入序(kids 淘汰用) */
var WSR_TREE_DIR_MAX = 40;            /* 缓存目录数上限 */
var WSR_TREE_KID_LIMIT = 200;         /* 每层条目上限(与 WSR_LIMIT 同量级) */
var WSR_TREE_ROW_MAX = 600;           /* 整树渲染行数上限(40 目录 × 200 项的最坏组合必须封顶) */
var WSR_TREE_DEPTH_MAX = 6;           /* 展开层级上限(再深请点进去看) */
var WS_PREVIEW_URL = null;            /* 当前预览的 objectURL(单点回收,见 wsPreviewCleanup) */
function wsrTreeReset() { WSR_TREE = { open: {}, kids: {}, more: {}, busy: {} }; WSR_TREE_ORDER = []; }
var WS_PRIME = {};                                        /* 元数据缓存补热标记 */
var WS_ZIP_MAX = 128 * 1024 * 1024;                       /* 整箱 zip 的内存硬顶 */
var WS_ZIP_MAX_ENTRIES = 65535;                           /* ZIP 的 EOCD 条目数字段是 uint16:超过会回绕成坏包 */
var WS_DEFLATE_CAP = null;                                /* CompressionStream("deflate-raw") 可用性(惰性探测) */
var WS_CRC_TABLE = null;
var WS_UPLOAD = { abort: false, running: false, rep: null, showAll: false };

/* ---- 右栏状态(`wsRailEl` / `wsRailVisible` 定义在 autoFitSidebar 那一节,与 railWidth 同组) ---- */
/* wsRailOpen 是布尔设置 —— mergeSettings 已按 !!v 归一,这里按 true 判定 */
function wsRailOpenFlag() { return state.settings.wsRailOpen === true; }
/* 用户主动开合:写意图 + 锁「这次是以什么形态打开的」+ 渲染 + 重判布局。
   ★ 顺序纪律:lockRailForm() 必须排在遮罩/按钮判据**之前** —— 遮罩判据读 wsRailFormGet(),
   排在后面的话窄窗首次打开时 RAIL_FORM 还是 ""、回落成 "column" ⇒ 遮罩不显示(D-F 落空)。
   关闭不走这里(一律 wsRailClose()),所以本函数只在 open===true 时锁型。 */
function wsRailSetOpen(open) {
  var r = wsRailEl();
  if (!r) return;
  if (!open) { wsRailClose(); return; }
  if (!wsReady()) { toast("工作区存储不可用(设置 → 数据 里查看原因)", "warn", 3600); return; }
  if (isMobile()) collapseSidebar();            /* 窄屏两块抽屉互斥,免得叠在一起 */
  RAIL_AUTO = false;
  lockRailForm(railForm());                     /* ★ 锁型先于遮罩/按钮判据 */
  r.classList.remove("collapsed");
  syncRailBackdrop();
  var tb = $("btn-ws-rail");
  if (tb) tb.classList.toggle("on", wsRailVisible());
  state.settings.wsRailOpen = true;
  saveSoon();
  /* 手动开过就算「已渲染」,免得下一次 updateCtxMeter 又渲染一遍(多一次 wsListDir 往返) */
  WS_RAIL_BOOT_RENDER = true;
  renderWsRail();
  wsRailRefit();
}
/* 自动让位(缩窄 / 进入窄屏):只收栏 + 记状态,不写意图、不重判布局(否则与 autoFitSidebar 互相递归) */
function wsRailCollapseAuto() {
  var r = wsRailEl();
  if (!r) return;
  RAIL_AUTO = true;
  clearRailForm();
  r.classList.add("collapsed");
  syncRailBackdrop();
  var tb = $("btn-ws-rail"); if (tb) tb.classList.remove("on");
}
/* 自动恢复(拉宽到能列了):只恢复列形态;意图本来就是开着的,这里不动 settings */
function wsRailExpandAuto() {
  var r = wsRailEl();
  if (!r) return;
  RAIL_AUTO = false;
  lockRailForm("column");
  r.classList.remove("collapsed");
  syncRailBackdrop();
  var tb = $("btn-ws-rail");
  if (tb) tb.classList.toggle("on", wsRailVisible());
  if (!WS_RAIL_BOOT_RENDER) { WS_RAIL_BOOT_RENDER = true; renderWsRail(); }
  else if (!$("wsr-files") || !$("wsr-files").firstChild) renderWsRail();
}
/* 手动收起:清意图 + 清自动让位标记 + 清锁定(所以是一次真正的「关闭」) */
function wsRailCollapse() {
  RAIL_AUTO = false;
  clearRailForm();
  var r = wsRailEl();
  if (r && !r.classList.contains("collapsed")) r.classList.add("collapsed");
  syncRailBackdrop();
  var tb = $("btn-ws-rail"); if (tb) tb.classList.remove("on");
  state.settings.wsRailOpen = false;
  saveSoon();
}
/* 遮罩显隐:非列形态(浮窗 / 抽屉)且开着才显示 */
function syncRailBackdrop() {
  var bd = $("ws-rail-backdrop");
  if (bd) bd.classList.toggle("show", wsRailFormGet() !== "column" && !wsRailCollapsed() && wsRailVisible());
}
function wsRailExpand() { wsRailSetOpen(true); }
function wsRailClose() { wsRailCollapse(); wsRailRefit(); }
function wsRailToggle() {
  if (wsRailCollapsed()) {
    wsRailSetOpen(true);
    if (wsRailCollapsed()) {
      /* 提示必须可落地:左栏展开时右栏保持打开需要「窗口宽 ≥ 对话区下限 + 左栏 + 右栏」 */
      var need = Math.round(wsRailMinWidth() / 10) * 10;
      toast("窗口太窄,右栏已自动收起(收起左侧栏后重试,或把窗口拖宽到约 " + need + "px 以上;" +
        "窗口更窄时点开会以浮窗形态打开)", "warn", 4600);
    }
  } else {
    wsRailClose();
  }
}
/* 接缝(启动完成 / 切会话 / 挂载变化 / 其它标签页同步)重判右栏可见性 + 挂载按钮 */
var WS_RAIL_BOOT_RENDER = false;
function wsRailSync() {
  var r = wsRailEl();
  var tb = $("btn-ws-rail");
  var cap = wsReady();
  if (r) {
    if (!cap) {
      /* 能力缺失 → 隐藏入口,面板自身写明原因(由 renderWsRail 渲染) */
      RAIL_AUTO = false;
      r.setAttribute("hidden", "");
      r.classList.add("collapsed");
      clearRailForm();
    } else {
      r.removeAttribute("hidden");
      var shown = !r.classList.contains("collapsed");     /* DOM 可见性(不是 wsRailVisible,那是"未 hidden") */
      var want = wsRailOpenFlag() && !RAIL_AUTO;
      var form = railForm();
      if (!want) {
        /* 意图=关(或处在自动让位态)⇒ 落实收起:幂等,只动 DOM 态 / 锁定,不改意图 */
        if (shown) wsRailCollapseAuto();
      } else if (!shown && !RAIL_FORM) {
        /* 当前不可见:只有列形态才自动弹出(窄窗启动 / 刷新不自动弹浮窗) */
        if (form === "column") wsRailExpandAuto();
        else { RAIL_AUTO = true; wsRailApplyForm(); }
      } else if (shown && !RAIL_FORM) {
        /* 已经可见(启动链展开 / 互斥前的遗留):把生效形态记下来,缩窄让位才有判据 */
        lockRailForm(form);
      }
      /* want && shown && RAIL_FORM → 一律不动:用户主动开的 float / drawer 必须保持
         (输入框码字、附件变化、切会话的接缝都会走到这里 —— 见 updateCtxMeter 的调用面) */
    }
  }
  var open = !!(r && cap && !r.classList.contains("collapsed"));
  if (tb) {
    if (cap) tb.removeAttribute("hidden"); else tb.setAttribute("hidden", "");
    tb.classList.toggle("on", open);
    if (cap) tb.title = "工作区面板(保持打开需窗口宽约 " + (Math.round(railColMin() / 10) * 10) +
      "px;窗口更窄时以浮窗形态打开)";
  }
  syncRailBackdrop();
  /* 刷新后 settings.wsRailOpen=true 时面板是空的:启动链上补一次渲染(只补一次) */
  if (open && !WS_RAIL_BOOT_RENDER) { WS_RAIL_BOOT_RENDER = true; renderWsRail(); }
  updateWsMountBtn();
  wsPersistBtnSync();
  wsPrimeMeta(wsMountedId());
}
/* wsContextBlock() 读的是内存元数据缓存(冷缓存返回空串):挂载/切会话时补一次热 */
function wsPrimeMeta(wsId) {
  if (!wsId || !wsReady() || WS_META_CACHE[wsId] || WS_PRIME[wsId]) return;
  WS_PRIME[wsId] = 1;
  wsMeta(wsId).then(function () {
    delete WS_PRIME[wsId];
    if (wsMountedId() === wsId) updateCtxMeter();
  }, function () { delete WS_PRIME[wsId]; });
}
function updateWsMountBtn() {
  var cap = wsReady(), cur = wsMountedId();
  var btn = $("btn-ws-mount");
  if (btn) {
    if (cap) btn.removeAttribute("hidden"); else btn.setAttribute("hidden", "");
    btn.classList.toggle("on", !!cur);
    var nm = (cur && WS_META_CACHE[cur]) ? WS_META_CACHE[cur].name : "";
    btn.title = cur
      ? ("工作区:已挂载「" + nm + "」,点击可切换或取消挂载")
      : "工作区(沙箱虚拟盘):挂载后模型可用 Read / Write / Edit / Glob / Grep / FileOps";
  }
  var rb = $("btn-wsr-mount");
  if (rb) {
    var same = !!(cur && WS_RAIL_SEL && cur === WS_RAIL_SEL);
    rb.textContent = cur ? (same ? "取消挂载" : "改挂到当前会话") : "挂载到当前会话";
    rb.classList.toggle("on", !!cur);
    rb.disabled = !cap;
  }
}
function wsRailDragClear() {
  var r = wsRailEl();
  if (r) r.classList.remove("drop-over");
  var box = $("wsr-files");
  if (box) $$(".wsr-row.drop-on", box).forEach(function (x) { x.classList.remove("drop-on"); });
}
function requireWsSel() {
  if (!wsReady()) { toast("工作区存储不可用(设置 → 数据 里查看原因)", "warn", 3600); return false; }
  if (!WS_RAIL_SEL) { toast("请先创建或选择一个工作区", "warn"); return false; }
  return true;
}
function afterWsChange() {
  wsrTreeReset();               /* 上传 / 新建目录 / 删除 / 重命名 / 移动都会改结构 ⇒ 树缓存作废 */
  renderWsRail();
  renderWsDataPanel();
  updateWsMountBtn();
  updateCtxMeter();
  if (window.__mcpRefresh) window.__mcpRefresh();    /* 工具可见性跟着挂载变,刷新 MCP 面板 */
}

/* ---- 右栏渲染 ---- */
function wsNselClear(id) {
  NSEL[id] = null;
  var h = $(id);
  if (h) h.innerHTML = "";
  if (nselOpenId === id) closeNsel();
}
function wsOnWsSwitch(v) {
  if (!v) return;
  WS_RAIL_SEL = v;
  WS_CWD = "/";
  WSR_LIMIT = 200;
  wsrTreeReset();             /* 换了工作区:目录树缓存属于上一个工作区 */
  wsSetReport(null);          /* 上一批上传的失败报告属于上一个工作区,留着会被读成当前工作区的结果 */
  renderWsRail();
}
function renderWsRail() {
  var files = $("wsr-files"), tools = $("wsr-tools"), foot = $("wsr-foot");
  var crumb = $("wsr-crumb"), info = $("wsr-info"), sub = $("wsr-sub");
  if (info) info.innerHTML = "";
  if (files) files.innerHTML = "";
  if (tools) tools.hidden = true;
  if (foot) foot.hidden = true;
  if (crumb) crumb.hidden = true;
  if (!wsReady()) {
    wsNselClear("wsr-switch");
    if (sub) sub.textContent = "不可用";
    if (files) files.innerHTML = '<div class="wsr-empty">本地大仓库的工作区存储区缺失,该功能已停用。' +
      '<div class="wsr-note">' + escapeHtml((blobStore && blobStore.note) || "可在 设置 → 数据 里查看原因") + "</div></div>";
    updateWsMountBtn();
    return;
  }
  wsList().then(function (list) {
    if (!wsReady()) return;
    if (!list.length) {
      WS_RAIL_SEL = null; WS_CWD = "/"; WSR_LIMIT = 200;
      wsSetReport(null);      /* 没有工作区了,上一批上传的失败报告不该继续挂在这里 */
      wsNselClear("wsr-switch");
      if (sub) sub.textContent = "还没有工作区";
      if (files) {
        files.innerHTML = '<div class="wsr-empty">还没有工作区。<br>' +
          "工作区是这个页面里的虚拟盘:挂载后模型可以用 <b>Read / Write / Edit / Glob / Grep / FileOps</b> " +
          "读写它,<b>碰不到你的真实磁盘</b>。" +
          '<div><button class="btn sm" data-wsr="create">' + icon("plus", "sm") + " 新建工作区</button></div></div>";
      }
      updateWsMountBtn();
      return;
    }
    var byId = {}, i;
    for (i = 0; i < list.length; i++) byId[list[i].id] = list[i];
    var sel = WS_RAIL_SEL;
    if (!sel || !byId[sel]) {
      sel = wsMountedId();
      if (!sel || !byId[sel]) sel = list[0].id;
      WS_RAIL_SEL = sel;
      WS_CWD = "/";
      WSR_LIMIT = 200;
      wsrTreeReset();      /* 面板换了工作区:目录树缓存属于上一个工作区 */
    }
    var opts = list.map(function (m) { return { v: m.id, label: m.name }; });
    var d = nselDef("wsr-switch");
    if (!d) setupNsel("wsr-switch", opts, wsOnWsSwitch);
    else { d.options = opts; d.onChange = wsOnWsSwitch; }
    setNselValue("wsr-switch", sel, true);
    renderWsInfo(byId[sel]);
    renderWsFiles(sel);
    if (tools) tools.hidden = false;
    if (foot) foot.hidden = false;
    updateWsMountBtn();
  }, function () {
    if (files) files.innerHTML = '<div class="wsr-empty">读取工作区列表失败。</div>';
  });
}
function renderWsInfo(m) {
  var box = $("wsr-info"), sub = $("wsr-sub");
  if (!box) return;
  if (!m) { box.innerHTML = ""; if (sub) sub.textContent = "—"; return; }
  var pct = m.quotaBytes ? (m.usedBytes / m.quotaBytes) * 100 : 0;
  box.innerHTML =
    '<div class="wsr-line"><b>' + escapeHtml(m.name) + "</b><span>" +
      fmtBytes(m.usedBytes) + " / " + fmtBytes(m.quotaBytes) + "</span></div>" +
    '<div class="wsr-bar' + (m.usedBytes > m.quotaBytes ? " over" : "") + '"><i style="width:' +
      Math.min(100, pct).toFixed(1) + '%"></i></div>';
  if (sub) sub.textContent = (m.fileCount || 0) + " 个文件";
}
function renderWsCrumb() {
  var c = $("wsr-crumb");
  if (!c) return;
  var parts = WS_CWD === "/" ? [] : WS_CWD.slice(1).split("/");
  var html = '<button data-wsr="go" data-wsp="/">/</button>';
  var acc = "";
  parts.forEach(function (p) {
    acc += "/" + p;
    html += '<span class="wsr-sep">/</span><button data-wsr="go" data-wsp="' + escAttr(acc) + '">' +
      escapeHtml(p) + "</button>";
  });
  c.innerHTML = html;
  c.hidden = false;
}
/* ---- 列表行渲染:一级列表 + 内联目录树(A2/A3) ---- */
function wsrUpRowHtml() {
  var up = wsPathParent(WS_CWD);
  return '<div class="wsr-row up" data-wsr="go" data-wsp="' + escAttr(up) + '" title="返回上级:' + escAttr(up) + '">' +
    icon("left", "sm") + '<span class="wsr-name">上级目录</span>' +
    '<span class="wsr-size">' + escapeHtml(up) + "</span></div>";
}
/* 一行条目 → HTML;depth>0 的树行带缩进与 data-depth(拖放落点仍靠 .dir + data-wsp) */
function wsrRowHtml(e, depth, acc) {
  acc.n++;
  var isDir = e.type === "dir";
  var path = e.path;
  var kids = isDir ? WSR_TREE.kids[path] : null;
  var open = !!(isDir && WSR_TREE.open[path]);
  /* 未加载过的目录也给箭头(展开后再按实际结果去掉,免得为"有没有子项"多跑一次读事务) */
  var canTree = isDir && depth < WSR_TREE_DEPTH_MAX && (!kids || kids.length > 0);
  var caret = canTree
    ? '<button class="wsr-caret' + (open ? " open" : "") + '" data-wsr="tree" data-wsp="' + escAttr(path) +
      '" title="' + (open ? "收起这个目录" : "就地展开这个目录") + '" aria-label="' +
      (open ? "收起目录" : "展开目录") + '">' + icon("down", "sm") + "</button>"
    : "";
  var ops = (isDir ? "" :
    '<button data-wsr="download" data-wsp="' + escAttr(path) + '" title="下载">' + icon("download", "sm") + "</button>") +
    '<button data-wsr="del" data-wsp="' + escAttr(path) + '" title="删除" class="danger">' + icon("trash", "sm") + "</button>";
  var pad = depth > 0 ? ' style="padding-left:' + (8 + 14 * depth) + 'px"' : "";
  return '<div class="wsr-row' + (isDir ? " dir" : "") + (depth > 0 ? " tree" : "") +
    '" data-depth="' + depth + '" data-wsr="' + (isDir ? "enter" : "preview") + '" data-wsp="' + escAttr(path) +
    '" title="' + escAttr(path) + '"' + pad + ">" +
    icon(isDir ? "folder" : "file", "sm") +
    '<span class="wsr-name">' + escapeHtml(e.name) + "</span>" + caret +
    '<span class="wsr-size">' + (isDir ? "" : fmtBytes(e.size || 0)) + "</span>" +
    '<span class="wsr-ops">' + ops + "</span></div>";
}
/* 一层条目(含已展开的子层)拼成 HTML;acc = 整树行数计数器(WSR_TREE_ROW_MAX 封顶) */
function wsrTreeRows(entries, depth, acc) {
  var out = "";
  for (var i = 0; i < entries.length; i++) {
    if (acc.n >= WSR_TREE_ROW_MAX) { acc.cut = true; break; }
    var e = entries[i];
    out += wsrRowHtml(e, depth, acc);
    if (e.type === "dir" && WSR_TREE.open[e.path]) {
      var kids = WSR_TREE.kids[e.path];
      if (kids && kids.length) {
        out += wsrTreeRows(kids, depth + 1, acc);
        if (WSR_TREE.more[e.path]) {
          out += '<div class="wsr-row tree" data-wsr="treemore" data-wsp="' + escAttr(e.path) +
            '" style="justify-content:center;padding-left:' + (8 + 14 * (depth + 1)) + 'px">' +
            '<span class="wsr-name" style="text-align:center;color:var(--accent)">显示更多</span></div>';
        }
      }
    }
  }
  return out;
}
/* 缓存一层条目 + LRU 淘汰(淘汰时把展开态、分页标记一起清掉,免得留下无数据的 open) */
function wsrTreeCache(path, entries, limit) {
  WSR_TREE.kids[path] = entries;
  /* limit 非空 = 这一层还有下一页(存下已用 limit,「显示更多」从它继续加) */
  if (limit != null) WSR_TREE.more[path] = limit; else delete WSR_TREE.more[path];
  var i = WSR_TREE_ORDER.indexOf(path);
  if (i > -1) WSR_TREE_ORDER.splice(i, 1);
  WSR_TREE_ORDER.push(path);
  while (WSR_TREE_ORDER.length > WSR_TREE_DIR_MAX) {
    var old = WSR_TREE_ORDER.shift();
    delete WSR_TREE.kids[old];
    WSR_TREE.open[old] = false;
    delete WSR_TREE.more[old];
  }
}
/* 展开 / 收起一个目录(未缓存则只读这一层,不递归预载) */
function wsrTreeToggle(wsId, path) {
  if (!path) return;
  if (WSR_TREE.open[path]) { WSR_TREE.open[path] = false; renderWsFiles(wsId); return; }
  if (WSR_TREE.kids[path]) { WSR_TREE.open[path] = true; renderWsFiles(wsId); return; }
  if (WSR_TREE.busy[path]) return;
  WSR_TREE.busy[path] = 1;
  wsListDir(wsId, path, { limit: WSR_TREE_KID_LIMIT }).then(function (r) {
    delete WSR_TREE.busy[path];
    if (wsIsErr(r)) { toast("展开失败:" + (r.error || r.code), "warn", 3600); return; }
    wsrTreeCache(path, r.entries, r.next_offset != null ? WSR_TREE_KID_LIMIT : null);
    WSR_TREE.open[path] = true;
    renderWsFiles(wsId);
  }, function () { delete WSR_TREE.busy[path]; toast("展开失败", "warn", 3200); });
}
/* 某一层「显示更多」:该层 limit += 200 后重载(只作用于这一层) */
function wsrTreeMore(wsId, path) {
  if (!path) return;
  var lim = (WSR_TREE.more[path] || WSR_TREE_KID_LIMIT) + WSR_STEP;
  if (WSR_TREE.busy[path]) return;
  WSR_TREE.busy[path] = 1;
  wsListDir(wsId, path, { limit: lim }).then(function (r) {
    delete WSR_TREE.busy[path];
    if (wsIsErr(r)) { toast("读取失败:" + (r.error || r.code), "warn", 3600); return; }
    wsrTreeCache(path, r.entries, r.next_offset != null ? lim : null);
    WSR_TREE.open[path] = true;
    renderWsFiles(wsId);
  }, function () { delete WSR_TREE.busy[path]; toast("读取失败", "warn", 3200); });
}
function renderWsFiles(wsId) {
  var box = $("wsr-files");
  if (!box) return;
  renderWsCrumb();
  wsListDir(wsId, WS_CWD, { limit: WSR_LIMIT }).then(function (r) {
    if (wsIsErr(r)) {
      box.innerHTML = '<div class="wsr-empty">' + escapeHtml(r.error || r.code) + "</div>";
      return;
    }
    var acc = { n: 0, cut: false };
    var html = (WS_CWD !== "/") ? wsrUpRowHtml() : "";
    if (!r.entries.length) {
      html += '<div class="wsr-empty">这个目录是空的。<br>把文件或文件夹拖进这一栏,或点工具条的上传按钮。</div>';
    } else {
      html += wsrTreeRows(r.entries, 0, acc);
      if (r.next_offset != null && WSR_LIMIT < WSR_LIMIT_MAX) {
        html += '<div class="wsr-row" data-wsr="more" style="justify-content:center">' +
          '<span class="wsr-name" style="text-align:center;color:var(--accent)">显示更多(共 ' + r.total + " 项)</span></div>";
      }
      if (acc.cut) {
        html += '<div class="wsr-row" style="justify-content:center">' +
          '<span class="wsr-name" style="text-align:center;color:var(--text-faint)">…还有更多目录未展开(点目录名进去看)</span></div>';
      }
    }
    box.innerHTML = html;
  }, function () { box.innerHTML = '<div class="wsr-empty">读取目录失败。</div>'; });
}

/* ---- 设置 → 数据:工作区区 ---- */
function renderWsDataPanel() {
  var cnt = $("ds-ws-count"), used = $("ds-ws-used"), quo = $("ds-ws-quota");
  var hint = $("ds-ws-hint"), box = $("ds-ws-list");
  if (!cnt && !box) return;
  if (!wsReady()) {
    if (cnt) cnt.textContent = "—";
    if (used) used.textContent = "—";
    if (quo) quo.textContent = "—";
    if (box) box.innerHTML = '<div class="hint" style="padding:9px 0">工作区存储不可用,该功能已关闭。</div>';
    if (hint) { hint.style.display = ""; hint.textContent = (blobStore && blobStore.note) || "本地大仓库(IndexedDB)不可用,工作区功能已关闭。"; }
    return;
  }
  wsList().then(function (list) {
    var total = 0, files = 0, i;
    for (i = 0; i < list.length; i++) { total += list[i].usedBytes || 0; files += list[i].fileCount || 0; }
    if (cnt) cnt.textContent = list.length + " / " + WS_MAX_COUNT;
    if (used) used.textContent = fmtBytes(total) + "(共 " + files + " 个文件)";
    if (quo) quo.textContent = WS_QUOTA_MIN_MB + " ~ " + WS_QUOTA_MAX_MB + " MB / 箱";
    var cur = wsMountedId();
    if (box) {
      if (!list.length) {
        box.innerHTML = '<div class="hint" style="padding:9px 0">还没有工作区</div>';
      } else {
        box.innerHTML = list.map(function (m) {
          var pct = m.quotaBytes ? (m.usedBytes / m.quotaBytes) * 100 : 0;
          var id = escAttr(m.id);
          return '<div class="rank-row">' +
            '<div class="rr-main"><span class="rr-name">' + escapeHtml(m.name) +
              (cur === m.id ? ' <span class="pm-hint">已挂载</span>' : "") + "</span>" +
              '<span class="rr-sub">' + (m.fileCount || 0) + " 个文件 · " + fmtBytes(m.usedBytes) + " / " +
              fmtBytes(m.quotaBytes) + "(" + pct.toFixed(0) + "%)</span></div>" +
            '<div class="rr-ops">' +
              '<button class="btn xs" data-wsr="pick" data-wsid="' + id + '">面板</button>' +
              '<button class="btn xs" data-wsr="mount" data-wsid="' + id + '">' +
                (cur === m.id ? "取消挂载" : "挂载") + "</button>" +
              '<button class="btn xs" data-wsr="rename" data-wsid="' + id + '">改名</button>' +
              '<button class="btn xs" data-wsr="quota" data-wsid="' + id + '">配额</button>' +
              '<button class="btn xs danger" data-wsr="drop" data-wsid="' + id + '">删除</button>' +
            "</div></div>";
        }).join("");
      }
    }
    if (hint) {
      hint.style.display = "";
      hint.textContent = list.length
        ? "工作区文件只保存在本机大仓库里,不会自动进对话上下文;在会话里挂载之后,模型才能用文件工具读写它。导出备份不含工作区文件。"
        : "工作区是这个页面里的虚拟盘:挂载后模型可以用文件工具读写它,碰不到你的真实磁盘。";
    }
  }, function () {});
}

/* ---- 事件绑定 ---- */
function bindWsRail() {
  var rail = wsRailEl();
  if (rail) {
    rail.addEventListener("click", onWsRailClick);
    /* 拖放:三个入口共用一条实现(工具条按钮 / 拖到列表区 / 拖到整栏)。
       保留 preventDefault(阻止浏览器默认的「打开文件」),不加 stopPropagation
       —— 右栏是 #main 的兄弟列,不会变成附件。拖到某个目录行上就落进那个目录 */
    ["dragenter", "dragover"].forEach(function (evt) {
      rail.addEventListener(evt, function (e) {
        if (!e.dataTransfer) return;
        e.preventDefault();
        if (e.dataTransfer.dropEffect !== undefined) e.dataTransfer.dropEffect = "copy";
        var row = (e.target && e.target.closest) ? e.target.closest(".wsr-row.dir") : null;
        $$(".wsr-row.drop-on", rail).forEach(function (x) { if (x !== row) x.classList.remove("drop-on"); });
        if (row) row.classList.add("drop-on");
        rail.classList.add("drop-over");
      });
    });
    rail.addEventListener("dragleave", function (e) {
      if (e.relatedTarget && rail.contains(e.relatedTarget)) return;
      wsRailDragClear();
    });
    rail.addEventListener("drop", function (e) {
      e.preventDefault();
      var row = (e.target && e.target.closest) ? e.target.closest(".wsr-row.dir") : null;
      var dir = row ? (row.getAttribute("data-wsp") || WS_CWD) : WS_CWD;
      /* DataTransfer 在事件回调结束后即失效 ⇒ 这里先同步快照平铺文件列表,
         供 entry 链(webkitGetAsEntry)整体读不出来时回退 */
      var snap = [], fs = e.dataTransfer && e.dataTransfer.files;
      if (fs) { for (var i = 0; i < fs.length; i++) snap.push(fs[i]); }
      wsRailDragClear();
      wsUploadFromDrop(e.dataTransfer, dir, snap);
    });
  }
  var cb = $("btn-wsr-close");
  if (cb) cb.addEventListener("click", function () { wsRailClose(); });
  var tb = $("btn-ws-rail");
  if (tb) tb.addEventListener("click", function () { wsRailToggle(); });
  var bd = $("ws-rail-backdrop");
  if (bd) bd.addEventListener("click", function () { wsRailClose(); });
  var mb = $("btn-ws-mount");
  if (mb) mb.addEventListener("click", function () { wsMountMenu(mb); });
  var nc = $("btn-ws-create");
  if (nc) nc.addEventListener("click", function () { wsCreateWorkspaceUI(); });
  var dl = $("ds-ws-list");
  if (dl) dl.addEventListener("click", onWsRailClick);
  var fi = $("ws-file");
  if (fi) fi.addEventListener("change", function (e) {
    var fs = e.target.files, arr = [];
    if (fs && fs.length) {
      for (var i = 0; i < fs.length; i++) arr.push({ __file: fs[i] });
      wsUploadStart(arr, WS_CWD);
    }
    e.target.value = "";      /* 允许再次选同一批文件 */
  });
}
function onWsRailClick(e) {
  var b = (e.target && e.target.closest) ? e.target.closest("[data-wsr]") : null;
  if (!b) return;
  var act = b.getAttribute("data-wsr");
  if (!act || act === "noop") return;
  var p = b.getAttribute("data-wsp") || "";
  var id = b.getAttribute("data-wsid") || WS_RAIL_SEL;
  e.preventDefault();
  if (act === "go" || act === "enter") { WS_CWD = p || "/"; WSR_LIMIT = 200; renderWsRail(); return; }
  if (act === "more") { WSR_LIMIT = Math.min(WSR_LIMIT_MAX, WSR_LIMIT + WSR_STEP); renderWsRail(); return; }
  if (act === "tree") { wsrTreeToggle(id, p); return; }
  if (act === "treemore") { wsrTreeMore(id, p); return; }
  if (act === "preview") { wsPreviewOpen(id, p); return; }
  if (act === "create") { wsCreateWorkspaceUI(); return; }
  if (act === "pick") {
    WS_RAIL_SEL = id; WS_CWD = "/"; WSR_LIMIT = 200;
    if (wsRailCollapsed()) wsRailExpand(); else renderWsRail();
    return;
  }
  if (act === "upload") { if (requireWsSel()) $("ws-file").click(); return; }
  if (act === "mkdir") { wsMkdirUI(id); return; }
  if (act === "refresh") { renderWsRail(); toast("已刷新", "info", 1200); return; }
  if (act === "zip") { wsZipWorkspace(id); return; }
  if (act === "recount") { wsRecountUI(id); return; }
  if (act === "rename") { wsRenameUI(id); return; }
  if (act === "quota") { wsQuotaUI(id); return; }
  if (act === "drop") { wsDropUI(id); return; }
  if (act === "download") { wsFileDownloadUI(id, p); return; }
  if (act === "del") { wsDeleteUI(id, p); return; }
  if (act === "mount") { wsMountToggleUI(id); return; }
  if (act === "persist") { wsPersistRequest(); return; }
  if (act === "copyrep") { wsCopyReport(); return; }
  if (act === "fails") { WS_UPLOAD.showAll = !WS_UPLOAD.showAll; wsShowReport(); return; }
  if (act === "cancel") { WS_UPLOAD.abort = true; wsSetProg("正在停止…(当前文件写完后停)"); return; }
}

/* ---- 挂载菜单(复用 #pop-menu + placeMenu) ---- */
function wsMountMenu(anchor) {
  if (!wsReady()) { toast("工作区存储不可用(设置 → 数据 里查看原因)", "warn", 3600); return; }
  wsList().then(function (list) {
    closeMenus();
    var cur = wsMountedId();
    var html = '<button data-wsact="none">' + icon(cur ? "x" : "check", "sm") + " 不挂载</button>";
    if (!list.length) html += '<div class="pm-hint" style="padding:8px 11px">还没有工作区</div>';
    list.forEach(function (m) {
      html += '<button data-wsact="mount" data-ws="' + escAttr(m.id) + '">' +
        icon(m.id === cur ? "check" : "folder", "sm") + "<span>" + escapeHtml(m.name) + "</span>" +
        '<span class="pm-hint">' + fmtBytes(m.usedBytes) + "</span></button>";
    });
    html += '<div class="pm-sep"></div>' +
      '<button data-wsact="manage">' + icon("sliders", "sm") + " 管理工作区…</button>" +
      '<button data-wsact="create">' + icon("plus", "sm") + " 新建工作区…</button>";
    popMenuEl.innerHTML = html;
    placeMenu(popMenuEl, anchor);
  }, function () { toast("读取工作区列表失败", "error"); });
}
function runWsMenuAction(act, wsId) {
  if (act === "manage") { openSettings("data"); return; }
  if (act === "create") { wsCreateWorkspaceUI(); return; }
  if (!conv) { toast("请先新建一个对话", "warn"); return; }
  if (act === "none") { wsMountTo(conv.id, null); return; }
  if (act === "mount") { wsMountTo(conv.id, wsId); return; }
}
function wsMountTo(convId, wsId) {
  wsMountConv(convId, wsId).then(function (r) {
    if (r && r.ok === false) { toast("挂载操作失败:" + (r.error || r.code), "error", 4200); return; }
    toast(wsId ? "已挂载工作区:模型现在可以用文件工具读写它" : "已取消挂载(文件仍然保留在工作区里)", "success", 3600);
    afterWsChange();
  });
}
function wsMountToggleUI(id) {
  id = id || WS_RAIL_SEL;
  if (!id) { toast("请先创建或选择一个工作区", "warn"); return; }
  if (!conv) { toast("请先新建一个对话", "warn"); return; }
  if (!wsReady()) { toast("工作区存储不可用(设置 → 数据 里查看原因)", "warn", 3600); return; }
  if (wsMountedId() === id) wsMountTo(conv.id, null);
  else wsMountTo(conv.id, id);
}

/* ---- 工作区增删改(确认文案 + 顺序纪律) ----
   命名 / 配额走主题化输入弹窗(原生 prompt 不跟主题、也没有内联校验);
   弹窗只做形态校验,内核的 clamp / 截断 / 重名判定照旧执行,错误就地回显 */
function wsCreateWorkspaceUI() {
  if (!wsReady()) { toast("工作区存储不可用(设置 → 数据 里查看原因)", "warn", 3600); return; }
  wsList().then(function (list) {
    if (list.length >= WS_MAX_COUNT) { toast("最多 " + WS_MAX_COUNT + " 个工作区,请先删除一个再创建", "warn", 4200); return; }
    openAskDialog({
      title: "新建工作区",
      icon: "folder",
      okText: "创建",
      fields: [
        { key: "name", label: "名称", value: "工作区 " + (list.length + 1), maxLen: WS_NAME_MAX,
          empty: "名称不能为空", hint: "最多 " + WS_NAME_MAX + " 个字符" },
        { key: "quota", label: "用量上限(MB)", type: "number", value: String(WS_QUOTA_DEF_MB),
          min: WS_QUOTA_MIN_MB, max: WS_QUOTA_MAX_MB, unit: " MB",
          hint: WS_QUOTA_MIN_MB + " ~ " + WS_QUOTA_MAX_MB + ",默认 " + WS_QUOTA_DEF_MB }
      ],
      onSubmit: function (v) {
        return wsCreate(v.name, Number(v.quota)).then(function (r) {
          if (wsIsErr(r)) return { error: "新建失败:" + (r.error || r.code) };
          WS_RAIL_SEL = r.ws.id;
          WS_CWD = "/";
          WSR_LIMIT = 200;
          wsSetReport(null);      /* 换了工作区:上一批上传的失败报告不再属于当前上下文 */
          toast("已创建工作区「" + r.ws.name + "」", "success", 3200);
          afterWsChange();
          return {};
        });
      }
    });
  });
}
function wsRenameUI(id) {
  id = id || WS_RAIL_SEL;
  if (!id) return;
  wsMeta(id).then(function (m) {
    if (!m) { toast("工作区不存在", "warn"); return; }
    openAskDialog({
      title: "重命名工作区",
      icon: "folder",
      okText: "保存",
      fields: [{ key: "name", label: "名称", value: m.name, maxLen: WS_NAME_MAX, empty: "名称不能为空" }],
      onSubmit: function (v) {
        return wsRename(id, v.name).then(function (r) {
          if (wsIsErr(r)) return { error: "重命名失败:" + (r.error || r.code) };
          toast("已重命名为「" + r.ws.name + "」", "success");
          afterWsChange();
          return {};
        });
      }
    });
  });
}
function wsQuotaUI(id) {
  id = id || WS_RAIL_SEL;
  if (!id) return;
  wsMeta(id).then(function (m) {
    if (!m) { toast("工作区不存在", "warn"); return; }
    openAskDialog({
      title: "用量上限",
      icon: "sliders",
      okText: "保存",
      fields: [{
        key: "quota", label: "用量上限(MB)", type: "number",
        value: String(Math.round(m.quotaBytes / 1048576)),
        min: WS_QUOTA_MIN_MB, max: WS_QUOTA_MAX_MB, unit: " MB",
        empty: "请填写用量上限",
        hint: WS_QUOTA_MIN_MB + " ~ " + WS_QUOTA_MAX_MB + " MB;当前用量 " + fmtBytes(m.usedBytes || 0)
      }],
      onSubmit: function (v) {
        return wsSetQuota(id, Number(v.quota)).then(function (r) {
          if (wsIsErr(r)) return { error: "修改失败:" + (r.error || r.code) };
          toast(r.over ? "已改上限,但当前用量已超额:新写入会被拒绝" : "已改上限", r.over ? "warn" : "success", 4200);
          afterWsChange();
          return {};
        });
      }
    });
  });
}
/* 删除仍被挂载的工作区:确认文案列出挂载会话数;wsDropWorkspace(force) 会
   先把这些会话的 wsId 置空并落盘、再删数据(顺序不能反) */
function wsDropUI(id) {
  id = id || WS_RAIL_SEL;
  if (!id) return;
  wsMeta(id).then(function (m) {
    if (!m) { toast("工作区不存在", "warn"); return; }
    var mounted = wsConvsMounting(id);
    var msg = "删除工作区「" + m.name + "」?\n\n其中 " + (m.fileCount || 0) + " 个文件、" +
      fmtBytes(m.usedBytes) + " 会一并删除,不可撤销。";
    if (mounted.length) msg += "\n\n⚠ 还有 " + mounted.length + " 个会话挂着它 —— 会先解除这些会话的挂载,再删数据。";
    /* 运行中的 Python 任务仍持有该工作区,删除后它们的产物回写会失败 */
    var busy = (typeof pvTasksUsingWs === "function") ? pvTasksUsingWs(id) : [];
    if (busy.length) {
      msg += "\n\n⚠ 有 " + busy.length + " 个后台 Python 任务正在写入这个工作区(" +
        busy.slice(0, 5).map(function (t) { return t.id; }).join("、") + (busy.length > 5 ? " 等" : "") +
        ")—— 删除后它们的产物会丢失,回写会失败。建议先停止这些任务(设置 → 工具与权限 里可停)。";
    }
    /* 两级确认(语义与原来的两次原生 confirm 一致;文案一字不改)。
       确认框是异步的 ⇒ 两级弹窗串联,落地动作搬进 wsDropNow();wsMeta 拿到的 m 仍是快照,
       删之前不再重复查询(要删的就是用户看到的那个工作区) */
    askConfirm({
      title: "删除工作区", icon: "trash", okText: "删除工作区", message: msg
    }, function () {
      if (!mounted.length) { wsDropNow(id, m, mounted); return; }
      askConfirm({
        title: "再次确认", icon: "warn", okText: "解除挂载并删除",
        message: "再次确认:先解除 " + mounted.length + " 个会话的挂载,然后删除整个工作区。继续?"
      }, function () { wsDropNow(id, m, mounted); });
    });
  });
}
function wsDropNow(id, m, mounted) {
  wsDropWorkspace(id, { force: mounted.length > 0 }).then(function (r) {
    if (wsIsErr(r)) { toast("删除失败:" + (r.error || r.code), "error", 4200); return; }
    if (WS_RAIL_SEL === id) { WS_RAIL_SEL = null; WS_CWD = "/"; WSR_LIMIT = 200; }
    wsSetReport(null);        /* 报告属于被删掉的那个工作区,一并清掉(否则会残留成"当前结果") */
    toast("已删除工作区「" + m.name + "」", "success", 3600);
    afterWsChange();
  });
}
function wsRecountUI(id) {
  id = id || WS_RAIL_SEL;
  if (!id) return;
  toast("正在重算用量(游标扫描文件记录)…", "info", 2200);
  wsRecount(id).then(function (r) {
    if (wsIsErr(r)) { toast("重算失败:" + (r.error || r.code), "error", 4200); return; }
    toast("已重算:" + r.fileCount + " 个文件 / " + fmtBytes(r.usedBytes), "success", 3600);
    afterWsChange();
  });
}
function wsMkdirUI(id) {
  id = id || WS_RAIL_SEL;
  if (!id) { toast("请先创建或选择一个工作区", "warn"); return; }
  var cwd = WS_CWD;
  openAskDialog({
    title: "新建文件夹",
    icon: "folder",
    okText: "创建",
    fields: [{
      key: "name", label: "文件夹名称", value: "", maxLen: 120, empty: "名称不能为空",
      placeholder: "可以带 / 一次建多层", hint: "在当前目录(" + cwd + ")下创建"
    }],
    onSubmit: function (v) {
      var np = wsNormPath(wsJoinPath(cwd, String(v.name).replace(/\\/g, "/")));
      if (wsIsErr(np)) return { error: "名称不合法:" + (np.error || np.code) };
      return wsMkdir(id, np.path, { recursive: true }).then(function (r) {
        if (wsIsErr(r)) return { error: "新建失败:" + (r.error || r.code) };
        /* 重名以前只给一条 toast,现在就地回显(弹窗保持打开,可以改个名字再来) */
        if (!r.created) return { error: "已存在同名文件夹:" + np.path };
        toast("已新建文件夹", "success", 2200);
        renderWsRail();
        return {};
      });
    }
  });
}
function wsDeleteUI(id, p) {
  id = id || WS_RAIL_SEL;
  if (!id || !p) return;
  wsStat(id, p).then(function (st) {
    if (wsIsErr(st)) { toast("文件不存在或已被删除", "warn", 3200); renderWsRail(); return; }
    var isDir = st.type === "dir";
    var extra = isDir ? "(含 " + (st.files || 0) + " 个文件、" + fmtBytes(st.size || 0) + ")"
                      : "(" + fmtBytes(st.size || 0) + ")";
    /* 主题化确认(替代原生 confirm,文案一字不改)。确认框是异步的 ⇒ 落地动作放回调里 */
    askConfirm({
      title: "删除文件", icon: "trash", okText: "删除",
      message: "删除 " + p + " " + extra + "?\n不可撤销。"
    }, function () {
      wsDelete(id, p, { recursive: isDir }).then(function (r) {
        if (wsIsErr(r)) { toast("删除失败:" + (r.error || r.code), "error", 4200); return; }
        toast("已删除 " + p, "success", 2600);
        afterWsChange();
      });
    });
  });
}

/* ---- 单文件下载(内核是 appE 的 wsFileDownload) ---- */
function wsFileDownloadUI(id, p) {
  id = id || WS_RAIL_SEL;
  if (!id || !p) return;
  toast("正在读取文件…", "info", 1600);
  wsFileDownload(id, p).then(function (r) {
    if (wsIsErr(r)) { toast("下载失败:" + (r.error || r.code), "error", 4600); return; }
    toast(r.mode === "open" ? ("已在新标签页打开 " + r.name + "(浏览器不支持直接下载)") : ("已下载 " + r.name),
      "success", 3200);
  });
}
function wsBlobDownload(blob, filename) {
  /* a[download] 不可用时 a.click() 会退化成导航到 blob URL / 落个随机名 —— 文件名丢掉却看着像成功,
     所以这里一并判失败,让调用方给出可读提示(CAP.download 与 CAP.objectUrl 同为启动期能力探测) */
  if (!CAP.objectUrl || !CAP.download) return false;
  var url = null;
  try {
    url = URL.createObjectURL(blob);
    var a = document.createElement("a");
    a.href = url; a.download = filename;
    document.body.appendChild(a); a.click(); document.body.removeChild(a);
    setTimeout(function () { try { URL.revokeObjectURL(url); } catch (e) {} }, 4000);
    return true;
  } catch (e) {
    if (url) { try { URL.revokeObjectURL(url); } catch (e2) {} }
    return false;
  }
}

/* ---- 整箱下载:自写 store-only ZIP ---- */
function wsUtf8Bytes(s) { return new TextEncoder().encode(s); }
function wsCrc32(u8) {
  if (!WS_CRC_TABLE) {
    WS_CRC_TABLE = new Int32Array(256);
    for (var n = 0; n < 256; n++) {
      var c = n;
      for (var k = 0; k < 8; k++) c = (c & 1) ? (0xEDB88320 ^ (c >>> 1)) : (c >>> 1);
      WS_CRC_TABLE[n] = c;
    }
  }
  var crc = -1;
  for (var i = 0; i < u8.length; i++) crc = (crc >>> 8) ^ WS_CRC_TABLE[(crc ^ u8[i]) & 0xFF];
  return (crc ^ -1) >>> 0;
}
function wsDeflateOk() {
  if (WS_DEFLATE_CAP !== null) return WS_DEFLATE_CAP;
  WS_DEFLATE_CAP = false;
  try {
    if (typeof window.CompressionStream === "function") {
      new window.CompressionStream("deflate-raw");
      WS_DEFLATE_CAP = true;
    }
  } catch (e) { WS_DEFLATE_CAP = false; }
  return WS_DEFLATE_CAP;
}
/* 有 CompressionStream("deflate-raw") 就压(method 8),没有/失败就原样存(method 0) */
function wsDeflate(u8) {
  if (!wsDeflateOk()) return Promise.resolve(null);
  try {
    var cs = new window.CompressionStream("deflate-raw");
    var w = cs.writable.getWriter();
    w.write(u8);
    w.close();
    return new Response(cs.readable).arrayBuffer().then(function (ab) { return new Uint8Array(ab); },
      function () { return null; });
  } catch (e) { return Promise.resolve(null); }
}
function wsZipBuild(files, onProg) {
  var chunks = [], central = [], offset = 0, i = 0, compressed = 0;
  var now = new Date();
  var dosTime = ((now.getHours() << 11) | (now.getMinutes() << 5) | Math.floor(now.getSeconds() / 2)) & 0xFFFF;
  var dosDate = ((((now.getFullYear() - 1980) & 0x7f) << 9) | ((now.getMonth() + 1) << 5) | now.getDate()) & 0xFFFF;
  function addEntry(nameBytes, raw, stored, crc, method) {
    var lh = new Uint8Array(30 + nameBytes.length), dv = new DataView(lh.buffer);
    dv.setUint32(0, 0x04034b50, true);
    dv.setUint16(4, 20, true);              /* version needed */
    dv.setUint16(6, 0x0800, true);          /* 通用位 bit 11:文件名是 UTF-8 */
    dv.setUint16(8, method, true);
    dv.setUint16(10, dosTime, true);
    dv.setUint16(12, dosDate, true);
    dv.setUint32(14, crc, true);
    dv.setUint32(18, stored.length, true);  /* 压缩后大小 */
    dv.setUint32(22, raw.length, true);     /* 原始大小(不压缩时两者相等) */
    dv.setUint16(26, nameBytes.length, true);
    lh.set(nameBytes, 30);
    chunks.push(lh, stored);
    var cd = new Uint8Array(46 + nameBytes.length), cv = new DataView(cd.buffer);
    cv.setUint32(0, 0x02014b50, true);
    cv.setUint16(4, 20, true);
    cv.setUint16(6, 20, true);
    cv.setUint16(8, 0x0800, true);
    cv.setUint16(10, method, true);
    cv.setUint16(12, dosTime, true);
    cv.setUint16(14, dosDate, true);
    cv.setUint32(16, crc, true);
    cv.setUint32(20, stored.length, true);
    cv.setUint32(24, raw.length, true);
    cv.setUint16(28, nameBytes.length, true);
    cv.setUint32(42, offset, true);
    cd.set(nameBytes, 46);
    central.push(cd);
    offset += lh.length + stored.length;
  }
  function step() {
    if (i >= files.length) return Promise.resolve();
    var f = files[i++];
    var nameBytes = wsUtf8Bytes(f.name);
    var raw = f.bytes;
    return wsDeflate(raw).then(function (dz) {
      var method = 0, data = raw;
      if (dz && dz.length < raw.length) { method = 8; data = dz; compressed++; }
      addEntry(nameBytes, raw, data, wsCrc32(raw), method);   /* CRC 按原始字节算 */
      if (onProg) onProg(i, files.length);
      return wsYield().then(step);
    });
  }
  return step().then(function () {
    var cdSize = 0, j;
    for (j = 0; j < central.length; j++) cdSize += central[j].length;
    var eocd = new Uint8Array(22), ev = new DataView(eocd.buffer);
    ev.setUint32(0, 0x06054b50, true);
    ev.setUint16(8, central.length, true);
    ev.setUint16(10, central.length, true);
    ev.setUint32(12, cdSize, true);
    ev.setUint32(16, offset, true);
    for (j = 0; j < central.length; j++) chunks.push(central[j]);
    chunks.push(eocd);
    return new Blob(chunks, { type: "application/zip" });
  });
}
function wsZipWorkspace(id) {
  id = id || WS_RAIL_SEL;
  if (!id) { toast("请先创建或选择一个工作区", "warn"); return; }
  if (!wsReady()) { toast("工作区存储不可用(设置 → 数据 里查看原因)", "warn", 3600); return; }
  if (!CAP.objectUrl) { toast("当前浏览器不能直接下载,请按文件单独下载", "warn", 4200); return; }
  if (typeof window.TextEncoder !== "function") { toast("当前浏览器不支持打包 zip(缺少 TextEncoder)", "warn", 4200); return; }
  if (WS_UPLOAD.running) { toast("上传正在进行中,稍后再打包", "warn", 3200); return; }
  wsSetProg("正在读取工作区文件…");
  wsMeta(id).then(function (m) {
    var wsName = (m && m.name) || "workspace";
    return wsOpenSession(id, { maxBytes: WS_ZIP_MAX }).then(function (r) {
      if (wsIsErr(r)) { wsSetProg(""); toast("打包失败:" + (r.error || r.code), "error", 4600); return; }
      var total = 0, remote = 0;
      (r.manifest || []).forEach(function (x) { total += x.size || 0; if (x.remote) remote++; });
      if (remote) {
        wsSetProg("");
        toast("整箱 " + fmtBytes(total) + " 超过打包上限 " + fmtBytes(WS_ZIP_MAX) + ",请按文件单独下载", "warn", 5600);
        return;
      }
      if (!r.files || !r.files.length) { wsSetProg(""); toast("这个工作区里还没有文件", "info"); return; }
      var entries = r.files.map(function (f) {
        return { name: String(f.path || "").replace(/^\/+/, ""), bytes: new Uint8Array(f.bytes) };
      });
      /* EOCD 的「本盘条目数 / 总条目数」是 uint16:条目数 > 65535 会静默回绕成坏包 —— 直接拒绝 */
      if (entries.length > WS_ZIP_MAX_ENTRIES) {
        wsSetProg("");
        toast("文件太多(" + entries.length + " 个,上限 " + WS_ZIP_MAX_ENTRIES + " 个),请按目录分批下载", "warn", 5600);
        return;
      }
      wsSetProg("正在打包 0 / " + entries.length);
      return wsZipBuild(entries, function (n, all) { wsSetProg("正在打包 " + n + " / " + all); }).then(function (blob) {
        wsSetProg("");
        var fn = wsSafeFileName(wsName) + "-" + new Date().toISOString().slice(0, 10) + ".zip";
        if (!wsBlobDownload(blob, fn)) {
          /* CAP.download / CAP.objectUrl 为假时单文件下载同样走不通,不能再建议"改用单文件下载" */
          toast("当前浏览器不支持直接下载(下载或 blob 能力被禁用),整箱导出未开始", "error", 5200);
          return;
        }
        toast("已打包 " + entries.length + " 个文件(" + fmtBytes(blob.size) + ")", "success", 4600);
      });
    });
  });
}

/* ---- 工作区文件预览(只读;复用附件预览弹窗 #file-preview-modal) ----
   全链路本地:图片走 <img src=objectURL>、办公走内嵌 OfficeKit、PDF 走内嵌 PDFKit、文本按探针给的编码解码。
   类型判定一律用 B24-1 的共享探针 wsProbeBlob(不在本段重建第二份二进制/类型判定)。
   判定段**不开弹窗**(拒绝类只给 toast),判定通过后才开弹窗并做重活。 */
function wsPreviewCleanup() {
  if (WS_PREVIEW_URL) {
    try { URL.revokeObjectURL(WS_PREVIEW_URL); } catch (e) {}
    WS_PREVIEW_URL = null;
  }
}
/* 探针结论 → 预览分支(纯映射,不读盘、不解析内容;probe.type 是中文展示串,只进文案不进判据) */
function wsPreviewKind(path, probe) {
  var suf = wsSuffixOf(path);
  probe = probe || {};
  if (PREVIEW_REJECT_EXT.indexOf(suf) > -1) return "reject";
  if (OFFICE_EXT.indexOf(suf) > -1) return "office";
  if (suf === "pdf" || String(probe.mime || "") === "application/pdf") return "pdf";
  if (PREVIEW_IMG_EXT.indexOf(suf) > -1) return "image";
  if (probe.kind === "text") return "text";
  if (String(probe.mime || "").indexOf("image/") === 0) return "image";
  return "reject";
}
function wsPreviewOpen(wsId, path) {
  var id = wsId || WS_RAIL_SEL;
  if (!id || !path) return;
  if (!wsReady()) { toast("工作区存储不可用(设置 → 数据 里查看原因)", "warn", 3600); return; }
  wsPreviewCleanup();                       /* 重开前先回收上一次的 objectURL(兜住任何关闭路径) */
  wsStat(id, path).then(function (st) {
    if (wsIsErr(st)) { toast("读取失败:" + (st.error || st.code), "warn", 3600); return; }
    if (st.type === "dir") { WS_CWD = path; WSR_LIMIT = 200; renderWsRail(); return; }
    var size = st.size || 0;
    if (size > WS_PREVIEW_MAX_BYTES) {
      toast("文件过大(" + fmtBytes(size) + "),不予预览:可下载后用本机程序打开", "warn", 5200);
      return;
    }
    wsReadBlob(id, path).then(function (rb) {
      if (wsIsErr(rb)) { toast("读取失败:" + (rb.error || rb.code), "warn", 3600); return; }
      var blob = rb.blob;
      /* mime 只作提示传入(浏览器的 application/octet-stream 不可信),不单独决定文本/二进制 */
      wsProbeBlob(blob, path, st.mime || rb.mime || "").then(function (probe) {
        var kind = wsPreviewKind(path, probe);
        var name = st.name || path.slice(path.lastIndexOf("/") + 1);
        if (kind === "reject") {
          toast("无法预览:" + (probe.type || "未知二进制") + " · " + fmtBytes(size) +
            " —— 可下载后用本机程序打开", "warn", 5600);
          return;
        }
        if (kind === "image" && !CAP.objectUrl) {
          toast("当前浏览器不支持本地图片预览(缺少 URL.createObjectURL),可下载后用本机程序查看", "warn", 5600);
          return;
        }
        wsPreviewRender(kind, name, blob, size, probe, path);
      });
    });
  }, function () { toast("读取失败", "warn", 3600); });
}
function wsPreviewRender(kind, name, blob, size, probe, path) {
  var ext = wsSuffixOf(path);
  if ((kind === "office" && !window.OfficeKit) || (kind === "pdf" && !window.PDFKit)) {
    toast("本机缺少" + (kind === "office" ? "办公文档" : "PDF") + "解析库(构建档位未内嵌),可下载后用本机程序打开", "warn", 5600);
    return;
  }
  if (kind === "image") {
    var url = URL.createObjectURL(blob);
    WS_PREVIEW_URL = url;
    openFilePreview(name, "", { kind: "image", size: size, wsPreview: true, loading: true });
    var im = new Image();
    im.onload = function () {
      openFilePreview(name, "", {
        kind: "image", size: size, wsPreview: true,
        images: [{ url: url, mime: blob.type || "image/png", label: name, w: im.naturalWidth, h: im.naturalHeight }],
        dim: im.naturalWidth + "×" + im.naturalHeight
      });
    };
    im.onerror = function () {
      closeMask("file-preview-modal");
      wsPreviewCleanup();
      toast("这张图片无法在本机解码:" + name + " —— 可下载后用本机程序查看", "warn", 5600);
    };
    im.src = url;
    return;
  }
  if (kind === "text") {
    var slice = (blob.size > WS_PREVIEW_TEXT_MAX) ? blob.slice(0, WS_PREVIEW_TEXT_MAX) : blob;
    var enc = probe.enc || "utf-8";
    wsDecodeTextBlob(slice, enc, {}).then(function (dr) {
      if (!dr || !dr.ok) {
        toast("无法按 " + wsEncName(enc) + " 解码这个文本文件:可下载后用本机程序打开", "warn", 5200);
        return;
      }
      openFilePreview(name, dr.text, {
        size: size, wsPreview: true, enc: enc,
        clipped: blob.size > WS_PREVIEW_TEXT_MAX, lossy: !!probe.lossyHint
      });
    });
    return;
  }
  var buf = null;
  openFilePreview(name, "", { kind: kind, pages: kind === "pdf" ? 1 : 0, size: size, wsPreview: true, loading: true });
  wsBlobBuffer(blob).then(function (b) {
    buf = b;
    if (kind === "office") return wsPreviewOffice(name, buf, ext, size);
    return wsPreviewPdf(name, buf, size);
  }).then(null, function () {
    openFilePreview(name, "", { kind: kind, size: size, wsPreview: true, failed: "读取文件内容失败" });
  });
}
/* 办公文档:直接调 OfficeKit.parse(不走 resolveOffice —— 它在模型不支持视觉时会丢掉图片) */
function wsPreviewOffice(name, buf, ext, size) {
  return window.OfficeKit.parse(buf, ext, {
    timeout: (window.OfficeKit.limits && window.OfficeKit.limits.timeoutMs) || 60000
  }).then(function (r) {
    if (!r || !r.ok) {
      openFilePreview(name, "", { kind: "office", size: size, wsPreview: true, failed: (r && r.error) || "解析失败" });
      return;
    }
    var images = (r.images || []).map(function (im) {
      return { mime: im.mime, data: im.data, label: im.label || "", w: im.w, h: im.h };
    });
    openFilePreview(name, r.text || "", {
      kind: "office", size: size, wsPreview: true, images: images,
      subtype: r.subtype, unit: r.unit, pages: r.pages, imgCount: images.length,
      textChars: r.textChars, clipped: r.clipped, skippedImgs: r.skippedImgs
    });
  });
}
/* PDF:首页图(最多 8 页,转成弹窗认识的 {mime,data(裸 base64),label}) + 文字,两者并发、互不影响 */
function wsPreviewPdf(name, buf, size) {
  var jobs = [];
  jobs.push(window.PDFKit.renderPages(buf, { dpi: 110, maxPages: WS_PREVIEW_PDF_PAGES, format: "image/jpeg", quality: 0.82 })
    .then(function (r) {
      if (!r || !r.ok) return null;
      return (r.images || []).map(function (im, i) {
        return { mime: "image/jpeg", data: dataUrlPayload(im.dataUrl), label: "第 " + ((im.page || (i + 1))) + " 页" };
      });
    }, function () { return null; }));
  jobs.push(window.PDFKit.extractText(buf, { maxPages: 50, maxChars: 200000 })
    .then(function (r) { return (r && r.ok) ? r : null; }, function () { return null; }));
  return Promise.all(jobs).then(function (out) {
    var images = out[0] || [], txt = out[1];
    if (!images.length && !txt) {
      openFilePreview(name, "", { kind: "pdf", size: size, wsPreview: true, failed: "解析失败或文件已损坏" });
      return;
    }
    openFilePreview(name, txt ? txt.text : "", {
      kind: "pdf", size: size, wsPreview: true, mode: "text", pages: (txt && txt.pages) || images.length,
      images: images, clipped: !!(txt && txt.truncated), pdfPages: images.length
    });
  });
}

/* ---- 申请持久化存储 ---- */
var WS_PERSIST_STATE = { checked: false, granted: false };
function wsPersistBtnSync() {
  var b = $("btn-wsr-persist");
  if (b) {
    if (WS_PERSIST_STATE.granted) {
      b.disabled = true;
      b.textContent = "已授予持久化存储";
      b.title = "浏览器已把本页数据标记为「持久化」:磁盘空间紧张时也不会被自动清理。";
    } else {
      b.disabled = false;
      b.textContent = "申请持久化存储";
      b.title = "请浏览器把本页的本地数据标记为「持久化」,尽量不被自动清理。" +
        "Chrome 106 起不再弹授权框、改为按其内部条件静默授予,未命中时立刻返回「未授予」—— 这是正常现象,不影响数据读写。";
    }
  }
  if (!WS_PERSIST_STATE.checked && navigator.storage && typeof navigator.storage.persisted === "function") {
    WS_PERSIST_STATE.checked = true;   /* 只查一次;失败静默 */
    navigator.storage.persisted().then(function (v) {
      WS_PERSIST_STATE.granted = !!v;
      wsPersistBtnSync();
    }, function () {});
  }
}
function wsPersistRequest() {
  var st = navigator.storage;
  if (!st || typeof st.persist !== "function") { toast("当前浏览器不支持申请持久化存储", "warn", 4200); return; }
  st.persist().then(function (granted) {
    WS_PERSIST_STATE.checked = true;
    WS_PERSIST_STATE.granted = !!granted;
    wsPersistBtnSync();
    toast(granted
      ? "已获得持久化存储:浏览器不会再自动清理本页数据"
      : "浏览器未授予持久化存储(正常现象:Chrome 106 起不再弹授权框,只在满足其内部条件时静默授予)。" +
        "数据仍完整保存在本机,只在磁盘空间紧张时可能被系统回收;建议偶尔用「导出全部」备份。",
      granted ? "success" : "info", 6400);
  }, function () { toast("申请持久化存储失败", "error", 4200); });
}

/* ---- 上传链:单文件与批量同一入口,Blob 直存 IDB ---- */
function wsNormalizeUpload(file, relPath) {
  var rel = String(relPath || (file && file.webkitRelativePath) || (file && file.name) || "");
  rel = rel.replace(/\\/g, "/").replace(/[\u0000-\u001f\u007f]/g, "").replace(/\/+/g, "/");
  var segs = rel.split("/").filter(function (s) { return !!s && s !== "." && s !== ".."; });
  var out = [], i;
  for (i = 0; i < segs.length && out.length < WS_DEPTH_MAX; i++) {
    var s = segs[i].replace(/[. ]+$/, "");     /* 结尾的点/空格在 Unix 语义盘里是坑 */
    if (!s) continue;
    if (s.length > WS_SEG_MAX) s = s.slice(0, WS_SEG_MAX);
    out.push(s);
  }
  if (!out.length) return { ok: false, error: "文件名不合法(去掉路径分隔符后为空)" };
  var joined = out.join("/");
  if (wsJoinPath("/", joined).length > WS_PATH_MAX) return { ok: false, error: "路径过长(超过 " + WS_PATH_MAX + " 字符)" };
  return { ok: true, rel: joined, name: out[out.length - 1] };
}
/* webkitGetAsEntry() 递归取文件,按相对路径保留目录结构;不支持则平铺。
   返回 { list: [{file, rel}], failed: 读不出来的条目数 } —— failed 让调用方能给**可操作**的
   错误提示,而不是把「一个都没解析出来」混同于「拖了个空」(旧实现是静默 resolve 空数组)。
   robust:isFile / isDirectory 两个标记都缺失、但带 .file() 的 entry 也当文件试读一次
   (旧实现只认 en.isFile === true,形状不认识的条目被静默丢掉) */
function wsCollectEntries(entries) {
  var out = [], queue = [], i, failed = 0;
  for (i = 0; i < entries.length; i++) {
    var en = entries[i];
    if (!en) { failed++; continue; }
    if (en.__file) { out.push({ file: en.__file, rel: en.__file.webkitRelativePath || en.__file.name }); continue; }
    queue.push({ entry: en, prefix: "" });
  }
  function pump() {
    if (!queue.length) return Promise.resolve({ list: out, failed: failed });
    var job = queue.shift();
    var en = job.entry;
    var rel = (job.prefix ? (job.prefix + "/" + en.name) : en.name) || "未命名项";
    if (en.isDirectory === true) {
      if (typeof en.createReader !== "function") { failed++; return pump(); }
      return new Promise(function (res) {
        var reader = en.createReader(), kids = [];
        (function more() {
          reader.readEntries(function (batch) {
            if (!batch || !batch.length) { res(kids); return; }
            for (var j = 0; j < batch.length; j++) kids.push(batch[j]);
            more();       /* readEntries 一次只给一批,要读到空数组为止 */
          }, function () { failed++; res(kids); });
        })();
      }).then(function (kids) {
        for (var j = 0; j < kids.length; j++) queue.push({ entry: kids[j], prefix: rel });
        return pump();
      });
    }
    if (typeof en.file === "function") {
      return new Promise(function (res) {
        en.file(function (f) {
          if (f) out.push({ file: f, rel: rel }); else failed++;
          res();
        }, function () { failed++; res(); });
      }).then(pump);
    }
    failed++;
    return pump();
  }
  return pump();
}
/* 拖入的落点。dt 只在事件回调里有效 ⇒ 调用方应把平铺文件列表**同步快照**后经 flatSnap 传进来;
   没有快照时退回 dt.files(本函数也是同步调用的,读得到)。 */
function wsUploadFromDrop(dt, dir, flatSnap) {
  if (!dt) return;
  if (!WS_RAIL_SEL) { toast("请先创建并选择一个工作区,再拖入文件", "warn", 4200); return; }
  var entries = [], flat = false, fileItems = 0, i;
  var flatFiles = (flatSnap && flatSnap.length) ? flatSnap
    : ((dt.files && dt.files.length) ? Array.prototype.slice.call(dt.files) : []);
  var items = dt.items;
  if (items && items.length) {
    for (i = 0; i < items.length; i++) {
      var it = items[i];
      if (!it || it.kind !== "file") continue;
      fileItems++;
      var en = null;
      if (typeof it.webkitGetAsEntry === "function") {
        try { en = it.webkitGetAsEntry(); } catch (e) { en = null; }
      }
      if (en) { entries.push(en); continue; }
      flat = true;
      var f = it.getAsFile ? it.getAsFile() : null;
      if (f) entries.push({ __file: f });
    }
  }
  if (!entries.length && flatFiles.length) {
    flat = true;
    for (i = 0; i < flatFiles.length; i++) entries.push({ __file: flatFiles[i] });
  }
  if (!entries.length) {
    /* 明明拖来了文件项,却一个都没拿到(来源受限 / 内置浏览器):给可操作提示,不再静默 */
    if (fileItems) toast("拖入的文件没能读出来(浏览器或来源限制),请改用「上传」按钮选择文件", "warn", 5200);
    return;
  }
  if (flat) toast("当前浏览器不支持整目录拖入,已按文件名平铺上传", "info", 4600);
  wsUploadStart(entries, dir || WS_CWD, flatFiles);
}
function wsUploadStart(entries, dir, flatFiles) {
  if (!wsReady()) { toast("工作区存储不可用(设置 → 数据 里查看原因)", "warn", 3600); return; }
  if (!WS_RAIL_SEL) { toast("请先创建并选择一个工作区", "warn"); return; }
  if (WS_UPLOAD.running) { toast("还有一批上传正在进行(可先点「取消」)", "warn", 3600); return; }
  var wsId = WS_RAIL_SEL;
  var snap = (flatFiles && flatFiles.length) ? flatFiles : [];
  wsSetReport(null);
  wsSetProg("正在读取待上传的文件…");
  wsCollectEntries(entries).then(function (res) {
    var list = (res && res.list) || [], failed = (res && res.failed) || 0;
    if (!list.length && snap.length) {
      /* entry 链一条都读不出来(浏览器 / 来源限制):回退 drop 时的平铺快照,照旧传上去 */
      toast("已按文件名平铺上传(拖入的目录结构读不出来)", "info", 4600);
      list = [];
      for (var i = 0; i < snap.length; i++) list.push({ file: snap[i], rel: snap[i].name });
      failed = 0;
    }
    if (!list.length) {
      wsSetProg("");
      toast(failed
        ? "拖入的 " + failed + " 个条目没能读出来(浏览器或来源限制),请改用「上传」按钮选择文件"
        : "没有检测到可上传的文件", "warn", 5200);
      return;
    }
    if (failed) toast("有 " + failed + " 个条目读不出来,已跳过", "warn", 4200);
    wsUploadRun(wsId, list, dir || WS_CWD);
  }, function () { wsSetProg(""); toast("读取待上传文件失败", "error", 4200); });
}
function wsUploadRun(wsId, list, dir) {
  var items = [], fails = [], i;
  for (i = 0; i < list.length; i++) {
    var x = list[i];
    var n = wsNormalizeUpload(x.file, x.rel);
    if (!n.ok) { fails.push({ name: x.rel || "?", code: "EINVAL", msg: n.error }); continue; }
    var np = wsNormPath(wsJoinPath(dir || "/", n.rel));
    if (wsIsErr(np)) { fails.push({ name: n.rel, code: np.code || "EINVAL", msg: np.error || "路径不合法" }); continue; }
    items.push({ file: x.file, name: n.rel, path: np.path });
  }
  if (!items.length) {
    WS_UPLOAD.rep = { ok: 0, skip: 0, fail: fails.length, fails: fails, skipped: [], total: list.length, aborted: false };
    wsSetProg("");
    wsShowReport();
    toast("上传完成:成功 0 · 跳过 0 · 失败 " + fails.length, "error", 5200);
    return;
  }
  /* 冲突一次性三选:跳过 / 覆盖 / 重命名(默认,取 name(1).ext) */
  wsSetProg("正在检查冲突…");
  var idx = 0;
  function scan() {
    if (idx >= items.length) return Promise.resolve();
    var it = items[idx++];
    return wsStat(wsId, it.path).then(function (st) {
      if (st && st.ok) it.exists = true;
      else if (st && st.code && st.code !== "ENOENT") { it.bad = true; fails.push({ name: it.name, code: st.code, msg: st.error || "同名路径不可用" }); }
      return scan();
    }, function () { return scan(); });
  }
  scan().then(function () {
    /* 扫描阶段已经判死的条目(bad)从待写清单里剔除:留着的话 wsUploadWrite 会再写一次(多半又失败),
       失败报告里出现重复条目、total 也偏大 —— 它们的真实原因在 scan 时已经记进 fails 了 */
    items = items.filter(function (it) { return !it.bad; });
    var conflicts = items.filter(function (it) { return it.exists; });
    if (!conflicts.length) return wsUploadWrite(wsId, items, fails, "none");
    var head = conflicts.slice(0, 6).map(function (c) { return "· " + c.name; }).join("\n");
    if (conflicts.length > 6) head += "\n· …还有 " + (conflicts.length - 6) + " 个";
    return wsAskChoice("上传冲突", "目标目录里有 " + conflicts.length + " 个同名项:\n\n" + head,
      [{ v: "skip", label: "跳过这些" }, { v: "overwrite", label: "覆盖" },
       { v: "rename", label: "重命名(默认)", def: true }]).then(function (m) {
      return wsUploadWrite(wsId, items, fails, m || "rename");
    });
  });
}
function wsFreeName(wsId, path) {
  var slash = path.lastIndexOf("/"), dot = path.lastIndexOf(".");
  var base = path, ext = "";
  if (dot > slash + 1) { base = path.slice(0, dot); ext = path.slice(dot); }
  if (base.length + ext.length + 8 > WS_PATH_MAX) base = base.slice(0, Math.max(1, WS_PATH_MAX - ext.length - 8));
  var i = 1;
  function tryOne() {
    if (i > 999) return Promise.resolve(base + "(" + Date.now() + ")" + ext);
    var cand = base + "(" + i + ")" + ext;
    return wsStat(wsId, cand).then(function (st) {
      if (st && st.ok) { i++; return tryOne(); }
      return cand;
    });
  }
  return tryOne();
}
function wsUploadWrite(wsId, items, fails, mode) {
  WS_UPLOAD.running = true;
  WS_UPLOAD.abort = false;
  var queue = items.slice(), total = items.length, done = 0, okN = 0, skipN = 0, skipped = [];
  wsSetProg("0 / " + total);
  function put(it, path) {
    /* Blob 直存 IDB(不读进内存、不转 base64);同 wsId 天然经 wsLock 串行 */
    return wsWriteBlob(wsId, path, it.file, { mode: "overwrite", mime: it.file.type || "" }).then(function (r) {
      if (r && r.ok) { okN++; return; }
      fails.push({ name: it.name, code: (r && r.code) || "EIO", msg: (r && r.error) || "写入失败" });
    }, function (e) {
      fails.push({ name: it.name, code: "EIO", msg: String((e && e.message) || e) });
    });
  }
  function one(it) {
    if (mode === "skip") {
      return wsStat(wsId, it.path).then(function (st) {
        if (st && st.ok) { skipN++; skipped.push(it.name); return; }
        return put(it, it.path);
      });
    }
    if (mode === "rename") {
      return wsStat(wsId, it.path).then(function (st) {
        if (st && st.ok) return wsFreeName(wsId, it.path).then(function (p) { return put(it, p); });
        return put(it, it.path);
      });
    }
    return put(it, it.path);   /* none / overwrite */
  }
  function step() {
    if (WS_UPLOAD.abort || !queue.length) return Promise.resolve();
    var it = queue.shift();
    return one(it).then(function () {
      done++;
      wsSetProg(done + " / " + total + (WS_UPLOAD.abort ? "(已取消,停止中…)" : ""));
      return wsYield();       /* 让出主线程:大批量上传时界面不卡 */
    }).then(step);
  }
  /* 收尾只此一处:成功与异常两条路径都要复位 running —— 只写成功链的话,一旦 wsStat / IDB
     读事务 reject,running 会永远卡在 true,后面每一次上传都被「还有一批上传正在进行」挡死 */
  function settle(stepErr) {
    WS_UPLOAD.running = false;
    /* 整批异常**无条件**记进失败报告:原来只在"一个文件都没失败"时才记,于是"前 3 个文件失败 +
       第 4 个抛异常"的报告里只有 3 条,展开也看不出上传为什么断了 */
    if (stepErr) {
      fails.push({ name: "这一批", code: "EIO", msg: "上传过程出错了:" + String((stepErr && stepErr.message) || stepErr) });
    }
    var left = queue.length;
    WS_UPLOAD.rep = {
      ok: okN, skip: skipN, fail: fails.length, fails: fails, skipped: skipped,
      total: total, left: left, aborted: WS_UPLOAD.abort
    };
    wsSetProg("");
    wsShowReport();
    toast("上传" + (stepErr ? "中断" : "完成") + ":成功 " + okN + " · 跳过 " + skipN + " · 失败 " + fails.length +
      (left ? "(还有 " + left + " 个未上传)" : ""),
      (fails.length || left) ? "warn" : "success", 5600);
    afterWsChange();
  }
  return step().then(function () { settle(null); }, function (e) { settle(e); });
}
function wsSetProg(text) {
  var el = $("wsr-prog");
  if (!el) return;
  if (!text) { el.hidden = true; el.innerHTML = ""; return; }
  el.innerHTML = "<span>" + escapeHtml(text) + "</span>" +
    (WS_UPLOAD.running ? ' <button data-wsr="cancel">取消</button>' : "");
  el.hidden = false;
}
function wsSetReport(rep) {
  WS_UPLOAD.rep = rep;
  WS_UPLOAD.showAll = false;
  wsShowReport();
}
function wsShowReport() {
  var el = $("wsr-report");
  if (!el) return;
  var rep = WS_UPLOAD.rep;
  if (!rep) { el.hidden = true; el.innerHTML = ""; return; }
  var html = '<div class="wsr-head-line">成功 ' + rep.ok + " · 跳过 " + rep.skip + " · 失败 " + rep.fail +
    (rep.aborted ? "(已取消,已写入的不回滚)" : "") + "</div>";
  var fs = rep.fails || [];
  if (fs.length) {
    var show = WS_UPLOAD.showAll ? fs : fs.slice(0, 3);
    html += show.map(function (f) {
      return '<div class="wsr-fail">· ' + escapeHtml(f.name) + " — " + escapeHtml(f.msg) +
        "(" + escapeHtml(f.code) + ")</div>";
    }).join("");
    if (fs.length > 3) {
      html += '<button data-wsr="fails">' +
        (WS_UPLOAD.showAll ? "收起" : ("展开全部 " + fs.length + " 条失败")) + "</button> ";
    }
  }
  if (rep.skipped && rep.skipped.length) {
    html += '<div class="wsr-skip">跳过(同名):' + escapeHtml(rep.skipped.slice(0, 3).join("、")) +
      (rep.skipped.length > 3 ? " 等 " + rep.skipped.length + " 个" : "") + "</div>";
  }
  if (fs.length) html += '<div><button data-wsr="copyrep">复制报告</button></div>';
  el.innerHTML = html;
  el.hidden = false;
}
function wsReportText() {
  var rep = WS_UPLOAD.rep;
  if (!rep) return "";
  var lines = ["上传报告", "成功 " + rep.ok + " · 跳过 " + rep.skip + " · 失败 " + rep.fail +
    (rep.aborted ? "(用户取消,已写入的不回滚)" : "") + (rep.left ? "(还有 " + rep.left + " 个未上传)" : "")];
  (rep.fails || []).forEach(function (f) { lines.push("失败:" + f.name + " — " + f.msg + "(" + f.code + ")"); });
  (rep.skipped || []).forEach(function (n) { lines.push("跳过(同名):" + n); });
  return lines.join("\n");
}
function wsCopyReport() { copyText(wsReportText(), "上传报告已复制"); }

/* ---- 通用三选弹窗(一次性问清,不逐文件弹) ---- */
function wsAskChoice(title, message, options) {
  return new Promise(function (resolve) {
    var mask = document.createElement("div");
    mask.className = "modal-mask open";
    var btns = options.map(function (o, i) {
      return '<button class="btn' + (o.def ? " primary" : "") + '" data-i="' + i + '">' + escapeHtml(o.label) + "</button>";
    }).join("");
    mask.innerHTML = '<div class="modal narrow"><div class="modal-head"><h2>' + escapeHtml(title) + "</h2></div>" +
      '<div class="modal-body"><div class="hint multi">' + escapeHtml(message) + "</div></div>" +
      '<div class="modal-foot">' + btns + "</div></div>";
    document.body.appendChild(mask);
    var defIdx = 0, settled = false;
    options.forEach(function (o, i) { if (o.def) defIdx = i; });
    function done(i) {
      if (settled) return;
      settled = true;
      document.removeEventListener("keydown", onKey, true);
      if (mask.parentNode) mask.parentNode.removeChild(mask);
      resolve(options[i] ? options[i].v : null);
    }
    function onKey(e) {
      if (e.key !== "Escape") return;
      e.stopImmediatePropagation();    /* 别让全局 Esc 顺手关掉后面的设置弹窗 */
      done(defIdx);
    }
    document.addEventListener("keydown", onKey, true);
    mask.addEventListener("click", function (e) {
      var b = (e.target && e.target.closest) ? e.target.closest("button[data-i]") : null;
      if (b) { done(parseInt(b.getAttribute("data-i"), 10)); return; }
      if (e.target === mask) done(defIdx);
    });
  });
}

/* ---------------------------------------------------------------------------
   17.9 通用输入弹窗(替代原生 prompt:主题化 + 内联校验)
   spec = { title, icon, okText, message, onSubmit(values),
            fields: [{ key, label, hint, value, placeholder, maxLen,
                       type: "text"|"number", min, max, unit, empty }] }
   · message 可选:渲染成正文提示段;fields 为空时就是纯确认弹窗(如「新建对话」清草稿确认);
   · 校验只做「输入形态」这一层(空值 / 长度 / 数字范围);内核自己的规则
     (配额 clamp、路径规范化、名称截断)照旧执行,不因为有了这层就省略;
   · onSubmit 返回 Promise 时保持打开:resolve 出 { error } 就地显示错误,否则关闭;
     返回别的东西(或不返回)= 调用方已处理完,直接关闭。
   · 只能经 ✕ / 取消 / Esc 关闭(点遮罩不关,与设置类弹窗一致,避免误触丢掉输入)。
--------------------------------------------------------------------------- */
function askDialogErr(mask, msg) {
  var el = mask ? mask.querySelector(".note.err") : null;
  if (!el) return;
  el.textContent = msg || "";
  el.classList.toggle("show", !!msg);
}
function askDialogValues(mask, fields) {
  var out = {};
  fields.forEach(function (f) {
    var el = mask.querySelector("#ask-f-" + f.key);
    out[f.key] = el ? el.value : "";
  });
  return out;
}
function askDialogCheck(fields, values) {
  for (var i = 0; i < fields.length; i++) {
    var f = fields[i];
    var v = String(values[f.key] == null ? "" : values[f.key]).trim();
    if (!v) return f.empty || ((f.label || "输入") + "不能为空");
    if (f.maxLen && v.length > f.maxLen) return (f.label || "输入") + "最多 " + f.maxLen + " 个字符";
    if (f.type === "number") {
      var n = Number(v);
      if (!isFinite(n)) return (f.label || "输入") + "必须是数字";
      if (f.min != null && n < f.min) return (f.label || "输入") + "不能小于 " + f.min + (f.unit || "");
      if (f.max != null && n > f.max) return (f.label || "输入") + "不能大于 " + f.max + (f.unit || "");
    }
  }
  return "";
}
function openAskDialog(spec) {
  spec = spec || {};
  var fields = spec.fields || [];
  var old = document.getElementById("ask-modal-dyn");
  /* 同 id 重建:必须先让旧实例走 close() 收尾(DOM + capture Esc 监听器 + settled 一起清),
     只摘 DOM 会在 document 上留下旧实例的 Esc 监听器,吞掉下一次 Esc —— 入口是异步的
     (先 wsList()/wsMeta() 再开弹窗),双击同一按钮就会先后开出两个弹窗,踩到这个残留 */
  if (old) {
    if (typeof old.__askClose === "function") old.__askClose();
    else if (old.parentNode) old.parentNode.removeChild(old);
  }
  var mask = document.createElement("div");
  mask.id = "ask-modal-dyn";
  mask.className = "modal-mask open on-top";     /* on-top:从设置面板里打开时也要压在最上层 */
  mask.setAttribute("role", "dialog");
  mask.setAttribute("aria-modal", "true");
  var body = "";
  fields.forEach(function (f) {
    /* type="text" 必须显式写上:应用的控件样式选择器是 `.field input[type="text"]`(要求属性存在),
       少了它这个输入框吃不到任何样式,落到 UA 的 `input{background-color:field}` ——
       本机 Chrome(深色系统偏好)把 field 解析成 #3B3B3B,浅色主题下就是「深底 + 深字」,对比度 ≈1.6:1 */
    body += '<div class="field"><label for="ask-f-' + escAttr(f.key) + '"></label>' +
      '<input id="ask-f-' + escAttr(f.key) + '" type="text" autocomplete="off" spellcheck="false" /></div>';
  });
  mask.innerHTML = '<div class="modal narrow">' +
    '<div class="modal-head"><h2>' + icon(spec.icon || "edit") + ' <span class="ask-title"></span></h2>' +
    '<button class="icon-btn" data-ask="cancel" aria-label="关闭">' + icon("x") + '</button></div>' +
    '<div class="modal-body">' + (spec.message ? '<div class="ask-msg hint multi"></div>' : '') +
    '<div class="ask-fields">' + body + '</div><div class="note err"></div></div>' +
    '<div class="modal-foot"><button class="btn grow primary" data-ask="ok"></button>' +
    '<button class="btn grow" data-ask="cancel">取消</button></div></div>';
  mask.querySelector(".ask-title").textContent = spec.title || "输入";
  if (spec.message) mask.querySelector(".ask-msg").textContent = spec.message;
  var okBtn = mask.querySelector('button[data-ask="ok"]');
  okBtn.textContent = spec.okText || "确定";
  fields.forEach(function (f, i) {
    var inp = mask.querySelector("#ask-f-" + f.key);
    var wrap = inp.parentNode;
    wrap.querySelector("label").textContent = f.label || "";
    if (f.type === "number") {
      inp.type = "number";
      if (f.min != null) inp.min = String(f.min);
      if (f.max != null) inp.max = String(f.max);
    }
    inp.value = (f.value == null ? "" : String(f.value));
    if (f.placeholder) inp.placeholder = f.placeholder;
    if (f.maxLen) inp.maxLength = f.maxLen;
    if (f.hint) {
      var h = document.createElement("div");
      h.className = "hint";
      h.textContent = f.hint;
      wrap.appendChild(h);
    }
    inp.addEventListener("keydown", function (e) {
      if (e.key === "Enter" && !e.isComposing && e.keyCode !== 229) { e.preventDefault(); submit(); }
    });
    if (!i) setTimeout(function () { try { inp.focus(); inp.select(); } catch (e) {} }, 40);
  });
  var settled = false;
  function close() {
    if (settled) return;
    settled = true;
    document.removeEventListener("keydown", onKey, true);
    if (mask.parentNode) mask.parentNode.removeChild(mask);
  }
  mask.__askClose = close;   /* 供下一次 openAskDialog 收尾旧实例(见函数开头的 old 处理) */
  function submit() {
    if (okBtn.disabled) return;
    var values = askDialogValues(mask, fields);
    var err = askDialogCheck(fields, values);
    if (err) { askDialogErr(mask, err); return; }
    askDialogErr(mask, "");
    var r = null;
    try { r = spec.onSubmit ? spec.onSubmit(values) : null; }
    catch (e) { askDialogErr(mask, String((e && e.message) || e)); return; }
    if (!r || typeof r.then !== "function") { close(); return; }
    okBtn.disabled = true;
    okBtn.textContent = "处理中…";
    r.then(function (res) {
      if (res && res.error) {
        okBtn.disabled = false;
        okBtn.textContent = spec.okText || "确定";
        askDialogErr(mask, res.error);
        return;
      }
      close();
    }, function (e) {
      okBtn.disabled = false;
      okBtn.textContent = spec.okText || "确定";
      askDialogErr(mask, "操作失败:" + ((e && e.message) || e));
    });
  }
  function onKey(e) {
    /* 长按 Enter 的键盘自动重复(repeat=true)必须吞掉默认动作:两级确认(清空全部 / 删除工作区)
       的**第二级**弹窗是在第一级的确认回调里同步打开的,并且同样把「确定」自动聚焦 ——
       不吞的话,还按着 Enter 的人会在第二级弹窗刚出现时被自动重复的按键直接点过去,
       「两次确认」只按了一次键就被连过(原生 confirm() 是系统模态、页面收不到重复 keydown,
       没有这条路径 —— 属迁移引入的语义差异)。只吞重复帧,首次按下照旧 ⇒ 单击 / 单回车不受影响。
       实测:Enter 在聚焦按钮上的默认动作挂在 keypress 上,keydown 被 preventDefault 后
       连 keypress 都不会生成(CDP 注入的 autoRepeat 帧同样如此)—— 所以这一句就够。
       没选「延迟 250ms 再聚焦 + 期间 disabled」:那条路会把用户已经决定的快速回车也一并吞掉,
       还要和 submit() 里 Promise 分支的 okBtn.disabled 状态纠缠,改动面反而更大 */
    if (e.key === "Enter" && e.repeat) { e.preventDefault(); return; }
    if (e.key !== "Escape") return;
    e.stopImmediatePropagation();    /* 别让全局 Esc 顺手关掉后面的设置弹窗 */
    close();
  }
  document.addEventListener("keydown", onKey, true);
  mask.addEventListener("click", function (e) {
    var b = (e.target && e.target.closest) ? e.target.closest("button[data-ask]") : null;
    if (!b) return;
    if (b.getAttribute("data-ask") === "ok") submit();
    else close();
  });
  document.body.appendChild(mask);
}
/* 主题化确认框:替代原生 confirm() —— 原生框不跟主题、和主题化弹窗并排时风格割裂。
   · 语义与原版等价:点「确定」才执行 run(),取消 / ✕ / Esc 一律不执行(与 confirm 返回 false 相同);
   · confirm() 打开即聚焦按钮、回车确认 —— 这里也把「确定」聚焦上(Enter → 确认,Esc 仍然是取消);
   · 异步代价:run() 在用户点击之后才跑,凡是「确认后要动的东西」都必须在 run() 里按 id 重新取
     (弹窗开着时用户可能切走 / 删掉目标 / 对侧同步过来),见各调用点的注释。 */
function askConfirm(spec, run) {
  spec = spec || {};
  openAskDialog({
    title: spec.title || "确认",
    icon: spec.icon || "warn",
    okText: spec.okText || "确定",
    message: spec.message || "",
    fields: [],
    onSubmit: function () { run(); }
  });
  var ok = document.querySelector("#ask-modal-dyn button[data-ask='ok']");
  if (ok) setTimeout(function () { try { ok.focus(); } catch (e) {} }, 40);
}
