    });
  }, function () { toast("读取失败", "warn", 3600); });
}
function wsPreviewRender(kind, name, blob, size, probe, path) {
  var ext = wsSuffixOf(path);
  if ((kind === "office" && !window.OfficeKit) || (kind === "pdf" && !window.PDFKit)) {
    toast("本机缺少" + (kind === "office" ? "办公文档" : "PDF") + "解析库(构建档位未内嵌),可下载后用本机程序打开", "warn", 5600);
    return;
  }
  if (kind === "image") {
    var url = URL.createObjectURL(blob);
    WS_PREVIEW_URL = url;
    openFilePreview(name, "", { kind: "image", size: size, wsPreview: true, loading: true });
    var im = new Image();
    im.onload = function () {
      openFilePreview(name, "", {
        kind: "image", size: size, wsPreview: true,
        images: [{ url: url, mime: blob.type || "image/png", label: name, w: im.naturalWidth, h: im.naturalHeight }],
        dim: im.naturalWidth + "×" + im.naturalHeight
      });
    };
    im.onerror = function () {
      closeMask("file-preview-modal");
      wsPreviewCleanup();
      toast("这张图片无法在本机解码:" + name + " —— 可下载后用本机程序查看", "warn", 5600);
    };
    im.src = url;
    return;
  }
  if (kind === "text") {
    var slice = (blob.size > WS_PREVIEW_TEXT_MAX) ? blob.slice(0, WS_PREVIEW_TEXT_MAX) : blob;
    var enc = probe.enc || "utf-8";
    wsDecodeTextBlob(slice, enc, {}).then(function (dr) {
      if (!dr || !dr.ok) {
        toast("无法按 " + wsEncName(enc) + " 解码这个文本文件:可下载后用本机程序打开", "warn", 5200);
        return;
      }
      openFilePreview(name, dr.text, {
        size: size, wsPreview: true, enc: enc,
        clipped: blob.size > WS_PREVIEW_TEXT_MAX, lossy: !!probe.lossyHint
      });
    });
    return;
  }
  var buf = null;
  openFilePreview(name, "", { kind: kind, pages: kind === "pdf" ? 1 : 0, size: size, wsPreview: true, loading: true });
  wsBlobBuffer(blob).then(function (b) {
    buf = b;
    if (kind === "office") return wsPreviewOffice(name, buf, ext, size);
    return wsPreviewPdf(name, buf, size);
  }).then(null, function () {
    openFilePreview(name, "", { kind: kind, size: size, wsPreview: true, failed: "读取文件内容失败" });
  });
}
/* 办公文档:直接调 OfficeKit.parse(不走 resolveOffice —— 它在模型不支持视觉时会丢掉图片) */
function wsPreviewOffice(name, buf, ext, size) {
  return window.OfficeKit.parse(buf, ext, {
    timeout: (window.OfficeKit.limits && window.OfficeKit.limits.timeoutMs) || 60000
  }).then(function (r) {
    if (!r || !r.ok) {
      openFilePreview(name, "", { kind: "office", size: size, wsPreview: true, failed: (r && r.error) || "解析失败" });
      return;
    }
    var images = (r.images || []).map(function (im) {
      return { mime: im.mime, data: im.data, label: im.label || "", w: im.w, h: im.h };
    });
    openFilePreview(name, r.text || "", {
      kind: "office", size: size, wsPreview: true, images: images,
      subtype: r.subtype, unit: r.unit, pages: r.pages, imgCount: images.length,
      textChars: r.textChars, clipped: r.clipped, skippedImgs: r.skippedImgs
