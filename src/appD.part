    ["界面语言", (nav.language || "") + ((nav.languages && nav.languages.length > 1) ? "(" + nav.languages.join(",") + ")" : "")],
    ["时区 / 本地时间", safeGet(function () { return Intl.DateTimeFormat().resolvedOptions().timeZone; }, "—") + " · " + new Date().toString()],
    ["在线 / 网络", yn(nav.onLine) + (net ? " · " + net : " · 浏览器未提供详情")],
    ["Cookie / 请勿追踪", yn(nav.cookieEnabled) + " / " + (nav.doNotTrack || nav.msDoNotTrack || "未设置")],
