    ["站点总配额", quota],
    ["持久化存储", pers],
    ["附件库 (IndexedDB)", !bl ? "读取中…" : (bl.ok ? bl.count + " 个 / " + fmtBytes(bl.chars) : "不可用(附件只能留在对话里)")],
