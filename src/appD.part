var CORS_PROBE_TIMEOUT_MS = 12000;   /* 每条探针自己的上限(四条并行发出;只在用户手动触发时跑) */
var CORS_PROBE_BODY_MAX = 400;       /* 只读响应体前若干字符,用于识别「服务端不解析 text/plain」 */
var CORS_FAMILY_TEXT = {
  preflight: {
    label: "预检被拒(OPTIONS 未过)",
    advice: "服务端没有正确处理 OPTIONS 预检(或预检响应缺 Access-Control-Allow-* 头)。三条出路:① 让服务端放行 OPTIONS(返回 204 且带允许的头);② 改用同源反向代理;③ 无鉴权时打开「预检规避兼容模式」(改发简单请求,不再触发预检)。"
  },
  acao: {
    label: "实际响应无 ACAO",
    advice: "服务端连实际响应都没带 Access-Control-Allow-Origin(错误响应最容易漏),所以连不带自定义头的简单请求也被浏览器拦下。按诊断面板「CORS 分层」段列出的头补齐(重点:4xx/5xx 响应也要带),或改用同源反向代理。"
  },
  net: {
    label: "网络不可达",
    advice: "浏览器根本没能把请求发出去(地址 / 端口写错、服务没启动,或网络 / DNS 不通)。确认地址与端口正确、服务已启动;地址是本机端口(localhost / 127.0.0.1)时,浏览器只会在运行本页的这台机器上找服务 —— 服务在别的机器上要换成它的 IP。"
  },
  timeout: {
    label: "服务端未在超时内回话",
    /* 这份文案有三条消费路径:诊断面板的结论行(corsProbeLines)与开关的拒绝 note(setCorsBypass)——
       红 / 绿两条 note 当下看不到面板 ⇒ 定位语不许写「诊断面板里」,改成三条路径都成立的「去哪里看矩阵」。
       断言只引用矩阵标记(「标 ✗(超时) 的探针」),**不得**写成「四条都没等到」(混合态下与矩阵矛盾)。 */
    advice: "标 ✗(超时) 的探针在 " + Math.round(CORS_PROBE_TIMEOUT_MS / 1000) + " 秒内没等到响应(可能只有其中几条):连接建立了但不回话(服务端卡死 / 过载 / 正在装载模型时很常见)。这一态分不出 CORS 卡在哪一层,「预检规避兼容模式」也要等它回话才能验证 —— 等服务端恢复响应后再重跑;四探针矩阵在 设置 → 环境 → 运行自检 的「CORS 分层」段。"
  },
  textplain: {
    label: "服务端不解析 text/plain",
    advice: "服务端能收到请求,但拒收 text/plain 请求体(4xx)。「预检规避兼容模式」在它这里无效,请关闭该模式,改由服务端修 CORS 或走同源反向代理。"
  },
  ok: { label: "正常", advice: "四类请求都能读到响应,跨域没有问题。" },
  unknown: { label: "未能判定", advice: "先到 设置 → 模型 填好 Base URL 再重试。" }
