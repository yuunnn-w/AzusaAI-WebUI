  });
}
/* 处理并应用一张用户图片(点击选择 / 拖放共用);成功后即时生效并落盘 */
function applyFaviconFile(file) {
  toast("正在处理图片…", "info", 1200);
  prepareFavicon(file).then(function (dataUri) {
    state.settings.customIcon = dataUri;
    applyAppearance(); saveSoon(); syncFaviconUI();
    toast("标签页图标已更新", "success");
  }).catch(function (e) {
    syncFaviconUI();
    toast(e && e.message ? e.message : "图标处理失败", "error", 3600);
  });
}
/* 同步「设置 → 外观」的图标预览与状态文案(预览块始终显示当前生效的图标) */
function syncFaviconUI() {
  var img = $("fav-preview-img"), cur = $("fav-cur");
  if (!img || !cur) return;
  var custom = state.settings.customIcon || "";
  var can = canvasOK();
  img.src = custom || DEFAULT_FAVICON;
  if (!can) cur.textContent = "当前浏览器不支持图片处理,无法自定义图标";
  else cur.textContent = custom ? ("自定义图标(" + fmtBytes(custom.length) + ")") : "默认图标(青色小猫)";
  var up = $("btn-fav-upload");
  if (up) up.disabled = !can;
}

/* ---- 模型视觉能力:服务端清单自报 → 探测 → 手动覆盖 ---- */
var VISION_PROBE_IMG = "data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAYAAAAfFcSJAAAADUlEQVR42mP8z8DwHwAFAAH/q842iQAAAABJRU5ErkJggg==";
function visionState(model) {
  var force = state.settings.visionForce;
  if (force === "yes") return { vision: true, src: "manual" };
  if (force === "no") return { vision: false, src: "manual" };
  var bag = state.settings.modelVision || {};
  var m = String(model == null ? effectiveModel() : model).trim();
  var rec = (m && Object.prototype.hasOwnProperty.call(bag, m)) ? bag[m] : null;
  if (!rec) return { vision: null, src: "" };
  return { vision: !!rec.vision, src: rec.src || "", at: rec.at || 0 };
}
function setVision(model, vision, src) {
  var m = String(model || "").trim();
  if (!m) return;
  if (!state.settings.modelVision) state.settings.modelVision = {};
  state.settings.modelVision[m] = { vision: !!vision, src: src || "probe", at: Date.now() };
  saveSoon();
}
function visionLabel(model) {
  var v = visionState(model);
  if (v.src === "manual") return v.vision ? "已手动指定:支持图像" : "已手动指定:不支持图像";
  if (v.vision === true) return v.src === "models" ? "支持图像(服务端清单声明)" : "支持图像(探测通过)";
  if (v.vision === false) return v.src === "models" ? "不支持图像(服务端清单声明)" : "不支持图像(探测未通过)";
  return "未知(尚未探测,图片按原图发送)";
}
/* 探测:发一张 1×1 的图 + 最多 1 token,不报错就认为服务端吃得下图片 */
async function probeModelVision(model, quiet) {
  var m = String(model || "").trim() || effectiveModel();
  if (!m) return { ok: false, error: "没有模型名" };
  var proto = state.settings.protocol;
  var url = apiUrl(proto === "anthropic" ? "messages" : "chat/completions");
  if (!url) return { ok: false, error: "未配置 Base URL" };
  var body;
  if (proto === "anthropic") {
    body = {
      model: m, max_tokens: 1, messages: [{
        role: "user", content: [
          { type: "image", source: { type: "base64", media_type: "image/png", data: dataUrlPayload(VISION_PROBE_IMG) } },
          { type: "text", text: "hi" }
        ]
      }]
    };
  } else {
    body = {
      model: m, max_tokens: 1, stream: false, messages: [{
        role: "user", content: [
          { type: "image_url", image_url: { url: VISION_PROBE_IMG } },
          { type: "text", text: "hi" }
        ]
      }]
    };
  }
  var to = timeoutSignal(25000);
  var out = { ok: false, error: "" };
  try {
    var res = await fetch(url, { method: "POST", headers: headersFor(), body: JSON.stringify(body), signal: to.signal });
    var txt = await res.text();
    if (res.ok) {
      setVision(m, true, "probe");
      out = { ok: true, vision: true };
    } else {
      setVision(m, false, "probe");
      out = { ok: true, vision: false, error: "HTTP " + res.status + (txt ? ":" + safeJson(txt, 150) : "") };
    }
  } catch (e) {
    out = { ok: false, error: friendlyError(e, url).split("\n")[0] };
  } finally {
    to.abort();
  }
  if (!quiet) {
    if (out.ok && out.vision) toast("「" + m + "」支持图像输入,已打标", "success", 2600);
    else if (out.ok) toast("「" + m + "」不支持图像输入,图片将改用 OCR 提取文字" + (out.error ? "(" + out.error + ")" : ""), "warn", 4800);
    else toast("图像输入探测失败:" + out.error, "warn", 3600);
  }
  renderVisionHint();
  updateModelsHint();
  return out;
}
/* 选模型 / 拉到模型清单后自动探测一次(1 小时内不重复) */
function ensureModelVision(model, force) {
  var m = String(model || "").trim() || effectiveModel();
  if (!m) return;
  var st = visionState(m);
  if (st.src === "manual" || st.src === "models") return;
  if (!force && st.src === "probe" && Date.now() - (st.at || 0) < 3600 * 1000) return;
  if (!apiUrl("")) return;
  probeModelVision(m, !force);
}

/* ---- PDF / OCR 设置读取 ---- */
function pdfMaxPages() {
  var v = Number(state.settings.pdfMaxPages);
  if (!isFinite(v) || v <= 0) v = 10;
  return Math.max(1, Math.min(50, Math.round(v)));
}
function pdfDpi() {
  var v = Number(state.settings.pdfDpi);
  if (!isFinite(v) || v <= 0) v = 150;
  return Math.max(72, Math.min(300, Math.round(v)));
}
function pdfMode() { return state.settings.pdfMode === "image" ? "image" : "text"; }
function ocrLangs() {
  var v = String(state.settings.ocrLangs || "");
  return (v === "eng" || v === "chi_sim" || v === "chi_sim+eng") ? v : "chi_sim+eng";
}
function pdfKitReady() { return !!(window.PDFKit && window.PDFKit.available); }
function ocrReady() { return !!(window.OCRKit && window.OCRKit.available); }

function resolvePdf(file) {
  if (!pdfKitReady()) {
    return Promise.reject(new Error(file.name + ":PDF 解析库不可用(" +
      ((window.PDFKit && window.PDFKit.why) || "缺少必要能力") + ")"));
  }
  var mode = pdfMode();
  if (mode === "image" && visionState().vision === false) {
    mode = "text";
    toast("当前模型不支持图像输入,这份 PDF 已改用纯文本模式", "info", 3400);
  }
  return readAs(file, "buffer").then(function (buf) {
    if (mode === "image") {
      return PDFKit.renderPages(buf, { dpi: pdfDpi(), maxPages: pdfMaxPages(), format: "image/jpeg", quality: 0.86 })
        .then(function (r) {
          if (!r || !r.ok) throw new Error(file.name + ":PDF 渲染失败(" + ((r && r.error) || "未知") + ")");
          if (!r.images || !r.images.length) throw new Error(file.name + ":没有渲染出任何页面");
          return {
            id: uid(), kind: "pdf", name: file.name, size: file.size, mode: "image",
            pages: r.pages || r.images.length, clipped: !!r.truncated,
            images: r.images.map(function (im) {
              return {
                mime: (String(im.dataUrl || "").match(/^data:([^;,]+)/) || [])[1] || "image/jpeg",
                data: dataUrlPayload(im.dataUrl || ""), w: im.width || 0, h: im.height || 0
              };
            })
          };
        });
    }
    return PDFKit.extractText(buf, { maxChars: ATTACH_TEXT_MAX, maxPages: 200 }).then(function (r) {
      if (!r || !r.ok) throw new Error(file.name + ":PDF 文本抽取失败(" + ((r && r.error) || "未知") + ")");
      var t = String(r.text || "").trim();
      if (!t) {
        throw new Error(file.name + ":这份 PDF 里没有可提取的文字(可能是扫描件),可在 设置 → 附件 中改用「图片模式」");
      }
      return {
        id: uid(), kind: "pdf", name: file.name, size: file.size, mode: "text",
        pages: r.pages || 1, text: t, clipped: !!r.truncated
      };
    });
  });
}

function resolveImage(file, ext, inMime) {
  return readAs(file, "data").then(function (dataUrl) {
    if (typeof dataUrl !== "string" || dataUrl.indexOf("data:") !== 0) throw new Error(file.name + ":读取图片失败");
    return transcodeImage(dataUrl, inMime).then(function (r) {
      var att = {
        id: uid(), kind: "image", name: file.name, size: file.size,
        mime: r.mime, data: r.data, w: r.w, h: r.h, scaled: r.scaled
      };
      return maybeOcrImage(att);
    });
  });
}
/* 模型不支持视觉时:用内嵌的 Tesseract.js 把字识别出来再发,而不是把图丢给模型 */
function maybeOcrImage(att) {
  if (visionState().vision !== false) return Promise.resolve(att);   // 支持 / 未知 → 直接按图片发
  if (!ocrReady()) {
    return Promise.reject(new Error(att.name + ":当前模型不支持图像输入,且本浏览器的 OCR 引擎不可用(" +
      ((window.OCRKit && window.OCRKit.why) || "缺少 Web Worker / WebAssembly") + ")"));
  }
  toast("正在用 OCR 识别「" + att.name + "」里的文字…", "info", 2600);
  return OCRKit.recognize("data:" + att.mime + ";base64," + att.data, { langs: ocrLangs() }).then(function (r) {
    if (!r || !r.ok) throw new Error(att.name + ":OCR 识别失败(" + ((r && r.error) || "未知") + ")");
    att.ocr = String(r.text || "").trim() || "(未识别出文字)";
    att.ocrConfidence = r.confidence || 0;
    return att;
  });
}

/* ---- 办公文档附件(doc / docx / ppt / pptx / xls / xlsx)----
   解析全在本机内嵌的 OfficeKit 里完成(worker 优先,无 Worker 时降级主线程):
   docx 取文本 + 正文引用的图像;xlsx/xls 转多表 CSV(+ 表内图像);pptx 取文本 + 图像;
   doc/ppt 只取文本(老格式无纯 JS 图像方案,如实降级)。 */
/* 办公图片被跳过的一次性提示:按会话记(convId → 已提示过一次)。
   新会话 = 新键,遇到同样情况会照常提示;切回提示过的会话不再重复打扰 */
var officeVisionToastShown = {};
function isOfficeExt(ext) { return OFFICE_EXT.indexOf(ext) > -1; }
function isMacroExt(ext) { return MACRO_EXT.indexOf(ext) > -1; }
function officeReady() { return !!(window.OfficeKit && window.OfficeKit.available); }
/* 主线程降级模式的准入上限从 OfficeKit 的导出里读(单一来源 = officekit.src.js 的 MAIN_THREAD_CAP,
   经 limits.mainThreadSizeCap 暴露)——这里不再存同值副本:以前两处同值但无任何机制锁在一起,
   改一处就会静默不同步。worker 模式与普通附件同为 ATTACH_MAX_BYTES */
function officeSizeCap() {
  var ok = window.OfficeKit;
  if (ok && ok.mode === "main-thread" && ok.limits) return ok.limits.mainThreadSizeCap;
  return ATTACH_MAX_BYTES;
}
/* 附件 chip / 消息卡片 / 预览弹窗统一的摘要文案:
   DOCX · 7,040 字 · 2 图 ｜ PPTX · 9 页 · 1 图 ｜ PPT · 文本 4,676 字 ｜ XLSX · 9 表 · 1 图 */
function officeBrief(f) {
  if (!f) return "";
  var label = String(f.subtype || "").toUpperCase() || "办公文档";
  var out = [label];
  if (f.unit === "页" && f.pages) out.push(num(f.pages) + " 页");
  else if (f.unit === "表" && f.pages) out.push(num(f.pages) + " 表");
  else out.push("文本 " + num(f.textChars || (f.text ? String(f.text).length : 0)) + " 字");
  if (f.imgCount) out.push(num(f.imgCount) + " 图");
  if (f.clipped) out.push("已截断");
  return out.join(" · ");
}
function resolveOffice(file, ext, hooks) {
  if (!officeReady()) {
    return Promise.reject(new Error(file.name + ":办公文档解析库不可用(" +
      ((window.OfficeKit && window.OfficeKit.why) || "缺少必要能力") + ")"));
  }
  var cap = officeSizeCap();
  if (file.size > cap) {
    return Promise.reject(new Error(file.name + ":超过 " + fmtBytes(cap) + " 上限,已跳过"
      + (cap === ATTACH_MAX_BYTES ? "" : "(当前是主线程降级模式)")));
  }
  var dropImages = visionState().vision === false;
  var onProgress = hooks && hooks.onProgress;
  return readAs(file, "buffer").then(function (buf) {
    return window.OfficeKit.parse(buf, ext, {
      timeout: (window.OfficeKit.limits && window.OfficeKit.limits.timeoutMs) || 60000,
      onProgress: onProgress
    });
  }).then(function (r) {
    if (!r || !r.ok) throw new Error(file.name + ":" + ((r && r.error) || "解析失败"));
    var rawImgs = r.images || [];
    var images = [];
    if (!dropImages) {
      rawImgs.forEach(function (im) {
        images.push({ mime: im.mime, data: im.data, bytes: im.bytes, label: im.label, page: im.page });
      });
    }
    var text = String(r.text || "").trim();
    if (!text && !images.length) {
      throw new Error(file.name + ":没有提取到可发送的内容(空文档或只有图像且当前模型不支持图像)");
    }
    var att = {
      id: uid(), kind: "office", subtype: r.subtype || ext, name: file.name, size: file.size, mime: "",
      mode: images.length ? "both" : "text",
      text: text, textChars: r.textChars || text.length, clipped: !!r.clipped,
      images: images, imgCount: images.length,
      skippedImgs: (r.skippedImgs || 0) + (dropImages ? rawImgs.length : 0),
      pages: r.pages || 0, unit: r.unit || ""
    };
    if (att.subtype === "doc" || att.subtype === "ppt") {
      att.degraded = "老格式只提取文字(不支持图像提取)";
    }
    if (dropImages && rawImgs.length) {
      att.degraded = "当前模型不支持图像输入,只发送了文字";
      var ocid = (conv && conv.id) ? String(conv.id) : "";
      if (!Object.prototype.hasOwnProperty.call(officeVisionToastShown, ocid)) {
        officeVisionToastShown[ocid] = true;
        toast("当前模型不支持图像输入,办公文档里的图片已跳过(只发送文字)", "info", 3600);
      }
    }
    return att;
  });
}

function prepareAttachment(file, hooks) {
  return new Promise(function (resolve, reject) {
    if (!file) { reject(new Error("无效文件")); return; }
    if (file.size > ATTACH_MAX_BYTES) {
      reject(new Error(file.name + ":超过 " + fmtBytes(ATTACH_MAX_BYTES) + " 上限,已跳过")); return;
    }
    if (!file.size) { reject(new Error(file.name + ":空文件,已跳过")); return; }
    var ext = extOf(file.name);
    var mime = (file.type || "").toLowerCase();
    if (/^image\//.test(mime) || IMAGE_EXT.indexOf(ext) > -1) {
      resolveImage(file, ext, mimeOfImage(file, ext)).then(resolve, reject);
      return;
    }
    if (mime === "application/pdf" || ext === "pdf") { resolvePdf(file).then(resolve, reject); return; }
    if (isOfficeExt(ext)) { resolveOffice(file, ext, hooks).then(resolve, reject); return; }
    if (isMacroExt(ext)) {
      reject(new Error(file.name + ":暂不支持宏格式(." + ext + "),请另存为 .docx / .xlsx / .pptx 后重试"));
      return;
    }
    if (isBlockedExt(ext)) {
      reject(new Error(file.name + ":不支持 ." + ext + " 这类文件,只接受纯文本 / 图片 / PDF / 办公文档(doc/docx/ppt/pptx/xls/xlsx)"));
      return;
    }
    /* 其余(纯文本后缀 / 无后缀 / 未知后缀):一律交给共享内容探针判定。
       后缀与 mime 只是提示(wsProbeTextHint),不再"先认定是文本"也不再看乱码 ——
       GBK/GB18030、UTF-16 的文本会被正确解码;判不出文本的按二进制拒收并报出类型。 */
    wsProbeBlob(file, file.name, mime).then(function (probe) {
      if (probe.kind !== "text") {
        reject(new Error(file.name + ":" + attachTextRejectText(probe)));
        return;
      }
      if (probe.lossyHint) {
        reject(new Error(file.name + ":文本编码无法在本机解码(缺少对应的解码器),请先转成 UTF-8 后重试"));
        return;
      }
      return wsDecodeTextBlob(file, probe.enc || "utf-8", { strict: false }).then(function (dr) {
        if (!dr || !dr.ok) {
          reject(new Error(file.name + ":按 " + wsEncName(probe.enc) + " 解码失败,请先转成 UTF-8 后重试"));
          return;
        }
        var text = String(dr.text == null ? "" : dr.text);
        /* 探针只采样首 8 KB + 末 512 B:窗外的 NUL 会在解码后露出来 ⇒ 与 Read 的消费侧守卫同口径,
           仍按二进制拒收(旧实现同样会拒,别让这类文件变成"带 NUL 的乱码正文"发给模型) */
        if (text.indexOf("\u0000") > -1) {
          reject(new Error(file.name + ":采样窗之外仍含 NUL 字节,按二进制处理,无法作为文本读取"));
          return;
        }
        if (!text) { reject(new Error(file.name + ":内容为空")); return; }
        var clipped = text.length > ATTACH_TEXT_MAX;
        var att = {
          id: uid(), kind: "text", name: file.name, size: file.size,
          text: clipped ? text.slice(0, ATTACH_TEXT_MAX) : text, clipped: clipped
        };
        /* 编码注记:只对非 UTF-8 记(旧数据没有这个字段 = 按 UTF-8,无需迁移、不动 IDB 结构) */
        if (probe.enc && probe.enc !== "utf-8") att.enc = probe.enc;
        resolve(att);
      });
    }).then(undefined, function (e) {
      reject(e && e.message ? e : new Error(file.name + ":读取失败(" + ((e && e.message) || e) + ")"));
    });
  });
}
/* 附件文本分支的拒收文案:类型取自共享探针(probe.type 是给人看的中文串:PNG 图片 / ZIP 压缩包…),
   再给三条出路(与工作区 Read 的 EBINARY 同口径) */
function attachTextRejectText(probe) {
  var t = (probe && probe.type) || "未知二进制";
  return "无法作为文本读取(检测到" + t + "),只接受纯文本 / 图片 / PDF / 办公文档;" +
    "内容确实是文本的文件请另存为 .txt / .md 后重试,或先转成 UTF-8";
}
function attachSizeOf(a) {
  if (!a) return 0;
  if (a.kind === "image") return String(a.data || "").length;
  if (a.kind === "pdf") {
    if (a.mode === "image") {
      var n = 0;
      (a.images || []).forEach(function (im) { n += String(im.data || "").length; });
      return n;
    }
    return String(a.text || "").length;
  }
  if (a.kind === "office") {
    var m = String(a.text || "").length;
    (a.images || []).forEach(function (im) { m += String(im.data || "").length; });
    return m;
  }
  return String(a.text || "").length;
}
function draftAttachBytes() {
  var n = 0;
  draftFiles.forEach(function (f) { n += attachSizeOf(f); });
  return n;
}
/* 附件按 token 粗算:文本走四桶估算,一张图 ≈900,PDF / 办公文档的图片模式按张数累加 */
function draftAttachTokens(f) {
  if (!f) return 0;
  if (f.kind === "text") return estimateTokens(f.text);
  if (f.kind === "pdf" && f.mode === "image") return 900 * ((f.images && f.images.length) || 1);
  if (f.kind === "office" && f.mode === "both") {
    return estimateTokens(f.text) + 900 * ((f.images && f.images.length) || 1);
  }
  if (f.kind === "pdf" || f.kind === "office") return estimateTokens(f.text);
  return 900;
}
/* 预览弹窗的 token 读数与草稿环 / 上下文用量浮层**同一口径**(上一段那个函数):
   图片模式下正文是空的,只对 text 估算会显示「约 0 tokens」,与浮层里的 ≈N×900 自相矛盾。
   这里把正文补进对象再走同一个函数 —— 900/页 的算法全库只有一份 */
function previewAttachTokens(f, text) {
  var t = (text == null) ? "" : String(text);
  if (!f || !f.kind) return estimateTokens(t);
  if (typeof f.text === "string") return draftAttachTokens(f);
  var o = {};
  for (var k in f) { if (Object.prototype.hasOwnProperty.call(f, k)) o[k] = f[k]; }
  o.text = t;
  return draftAttachTokens(o);
}
/* 办公文档解析中的占位(解析耗时可感知,先给一个可移除的「解析中」chip;
   占位不进 draftFiles,既有预算 / 排序逻辑零改动) */
var pendingOffice = [];
function pendingOfficeRemove(ph) {
  var i = pendingOffice.indexOf(ph);
  if (i > -1) pendingOffice.splice(i, 1);
  ph.cancelled = true;
  if (window.OfficeKit && window.OfficeKit.cancelCurrent) window.OfficeKit.cancelCurrent();
  renderAttachBar();
}
/* 清空输入区草稿:文字 + 已解析的附件 + 还在解析中的占位。
   占位必须连带取消解析 —— 只清 draftFiles 的话,解析完成回调会把它推进新会话的附件条
   (「新建对话」把上一轮的附件带进新会话,就是这么发生的)。
   发送路径不受影响:doSend/sendMessage 先取走 draftFiles 再建会话(newConversation({keepDraft:true})) */
function clearDraft() {
  elInput.value = "";
  draftFiles = [];
  while (pendingOffice.length) pendingOfficeRemove(pendingOffice[0]);
  autoResize();
  renderAttachBar();
  updateCtxMeter();
}
var OFFICE_PHASE_TEXT = {
  started: "开始解析…", extracting: "提取内容…", parsing: "解析中…", done: "即将完成…"
};
function addFiles(fileList) {
  var files = Array.prototype.slice.call(fileList || []);
  if (!files.length) return;
  /* 「解析中」的办公文件已经占了 chip 位(见 renderAttachBar 的 N / 10 计数),
     这里必须把 pendingOffice 一起减掉,否则连拖两次就能挂超过 10 个 */
  var room = MAX_DRAFT_FILES - draftFiles.length - pendingOffice.length;
  if (room <= 0) {
    toast("一条消息最多放 " + MAX_DRAFT_FILES + " 个附件,请先发送或移除一些", "warn", 3600);
    return;
  }
  var skipped = 0;
  if (files.length > room) { skipped = files.length - room; files = files.slice(0, room); }
  var errs = [];
  /* 按输入顺序占位:prepareAttachment 是异步的,谁先完成不确定 ——
     直接 push 会让「一次拖进来的多个附件」顺序随机(图文交错就乱了) */
  var results = new Array(files.length);
  var tasks = files.map(function (f, i) {
    var ext = extOf(f.name);
    if (!isOfficeExt(ext)) {
      return prepareAttachment(f).then(function (a) { results[i] = a; },
        function (e) { results[i] = null; errs.push(e.message || String(e)); });
    }
    var ph = { name: f.name, size: f.size, phase: "started", cancelled: false };
    pendingOffice.push(ph);
    renderAttachBar();
    var hooks = { onProgress: function (phase) { ph.phase = phase; renderAttachBar(); } };
    return prepareAttachment(f, hooks).then(function (a) {
      var k = pendingOffice.indexOf(ph);
      if (k > -1) pendingOffice.splice(k, 1);
      if (!ph.cancelled) results[i] = a;
      renderAttachBar();
    }, function (e) {
      var k = pendingOffice.indexOf(ph);
      if (k > -1) pendingOffice.splice(k, 1);
      results[i] = null;
      if (!ph.cancelled) errs.push(e.message || String(e));
      renderAttachBar();
    });
  });
  Promise.all(tasks).then(function () {
    var used = draftAttachBytes(), added = 0, any = false;
    for (var i = 0; i < results.length; i++) {
      var a = results[i];
      if (!a) continue;
      /* 回收循环不再敢信上游的 room:两次 addFiles 交错时(前一次的解析还没完),
         只有在这里兜底判一次,才能保证真的不超过 10 个 */
      if (draftFiles.length >= MAX_DRAFT_FILES) {
        errs.push(a.name + ":一条消息最多放 " + MAX_DRAFT_FILES + " 个附件,已跳过");
        continue;
      }
      var budget = attachMsgMaxBytes();
      if (used + added + attachSizeOf(a) > budget) {
        errs.push(a.name + ":超过单条消息 " + fmtBytes(budget) + " 的附件总量上限(可在 设置 → 附件 里调大)");
        continue;
      }
      added += attachSizeOf(a);
      draftFiles.push(a);
      any = true;
    }
    if (any) { renderAttachBar(); updateCtxMeter(); }
    if (skipped) errs.push("一次最多 " + MAX_DRAFT_FILES + " 个附件," + skipped + " 个未加入");
    if (errs.length) toast(errs.slice(0, 3).join("\n"), "error", 5200);
  });
}

/* ---- 附件条的拖拽排序(HTML5 DnD,桌面端;触屏用不到也无妨) ---- */
var attachDragFrom = -1;
function bindAttachDrag(chip, i) {
  chip.addEventListener("dragstart", function (e) {
    attachDragFrom = i;
    chip.classList.add("dragging");
    if (e.dataTransfer) {
      try { e.dataTransfer.effectAllowed = "move"; e.dataTransfer.setData("text/plain", String(i)); } catch (er) {}
    }
  });
  chip.addEventListener("dragend", function () {
    attachDragFrom = -1;
    var all = $("attach-bar").children;
    for (var k = 0; k < all.length; k++) {
      all[k].className = all[k].className.replace(/\s*(dragging|drag-over)/g, "");
    }
  });
  chip.addEventListener("dragover", function (e) {
    if (attachDragFrom < 0) return;
    e.preventDefault();
    e.stopPropagation();
    if (e.dataTransfer) { try { e.dataTransfer.dropEffect = "move"; } catch (er) {} }
    chip.classList.add("drag-over");
  });
  chip.addEventListener("dragleave", function () { chip.classList.remove("drag-over"); });
  chip.addEventListener("drop", function (e) {
    if (attachDragFrom < 0) return;
    e.preventDefault();
    e.stopPropagation();
    var from = attachDragFrom;
    attachDragFrom = -1;
    if (from === i || from < 0 || from >= draftFiles.length) { renderAttachBar(); return; }
    var item = draftFiles.splice(from, 1)[0];
    draftFiles.splice(i, 0, item);
    renderAttachBar();
    updateCtxMeter();
  });
}
function renderAttachBar() {
  var bar = $("attach-bar");
  if (!bar) return;
  while (bar.firstChild) bar.removeChild(bar.firstChild);
  bar.classList.toggle("has-files", draftFiles.length > 0 || pendingOffice.length > 0);
  pendingOffice.forEach(function (ph) {
    var chip = document.createElement("div");
    chip.className = "attach-chip pending";
    chip.title = "正在本机解析,点 × 可取消并移除";
    chip.innerHTML = '<span class="ac-ico">' + icon("file", "sm") + "</span>" +
      '<span class="ac-main"><span class="ac-name" title="' + escAttr(ph.name) + '">' + escapeHtml(ph.name) + "</span>" +
      '<span class="ac-sub">' + escapeHtml((String(ph.name).split(".").pop() || "").toUpperCase()
        + " · " + (OFFICE_PHASE_TEXT[ph.phase] || "解析中…")) + "</span></span>" +
      '<button class="ac-rm" title="取消并移除" aria-label="取消解析">' + icon("x", "sm") + "</button>";
    chip.querySelector(".ac-rm").addEventListener("click", function (e) {
      e.stopPropagation();
      pendingOfficeRemove(ph);
    });
    bar.appendChild(chip);
  });
  draftFiles.forEach(function (f, i) {
    var chip = document.createElement("div");
    chip.className = "attach-chip" + (f.kind === "image" ? " is-img" : "");
    chip.setAttribute("data-idx", String(i));
    chip.setAttribute("draggable", "true");
    chip.title = "点击预览 · 拖动可调整顺序";
    var ico = f.kind === "image"
      ? '<img src="data:' + f.mime + ";base64," + f.data + '" alt="" />'
      : '<span class="ac-ico">' + icon(f.kind === "pdf" ? "file" : "file", "sm") + "</span>";
    var sub = f.kind === "image"
      ? ((f.w && f.h) ? f.w + "×" + f.h : "图片") + (f.scaled ? " · 已缩放" : "")
      : f.kind === "pdf"
        ? "PDF · " + (f.pages || 1) + " 页 · " + (f.mode === "image" ? "图片模式" : "文本模式")
        : f.kind === "office"
          ? officeBrief(f) + (f.degraded ? " · " + f.degraded : "")
          : fmtBytes(f.size) + (f.enc ? " · " + wsEncName(f.enc) + "(已转码显示)" : "") +
            (f.clipped ? " · 已截断" : "");
    if (f.ocr) sub += " · OCR";
    chip.innerHTML = ico +
      '<span class="ac-main"><span class="ac-name" title="' + escAttr(f.name) + '">' + escapeHtml(f.name) + "</span>" +
      '<span class="ac-sub">' + escapeHtml(sub) + "</span></span>" +
      '<button class="ac-rm" title="移除" aria-label="移除附件">' + icon("x", "sm") + "</button>";
    chip.querySelector(".ac-rm").addEventListener("click", function (e) {
      e.stopPropagation();
      draftFiles.splice(i, 1);
      renderAttachBar();
      updateCtxMeter();
    });
    chip.addEventListener("click", function () { previewAttachment(f); });
    bindAttachDrag(chip, i);
    bar.appendChild(chip);
  });
  /* 末尾跟一个「N / 10」计数,提示还能放几个 */
  if (draftFiles.length || pendingOffice.length) {
    var cnt = document.createElement("span");
    cnt.className = "attach-count";
    cnt.textContent = (draftFiles.length + pendingOffice.length) + " / " + MAX_DRAFT_FILES;
    cnt.title = "最多 " + MAX_DRAFT_FILES + " 个附件 · 单条消息总量上限 " + fmtBytes(attachMsgMaxBytes());
    bar.appendChild(cnt);
  }
}
/* 附件预览:图片走灯箱,文本 / PDF / 办公文档走弹窗(弹窗只能点 ✕ 关) */
function previewAttachment(f) {
  if (!f) return;
  if (f.kind === "image") { openLightbox("data:" + f.mime + ";base64," + f.data, f.name); return; }
  if ((f.kind === "pdf" || f.kind === "office") && f.images && f.images.length) {
    openFilePreview(f.name, f.text || "", f);
    return;
  }
  openFilePreview(f.name, f.text || "", f);
}

/* ---- 一轮用户消息的协议组装:文件/图片在前,问题在后 ---- */
function attachMetaOf(f) {
  var m = {
    id: f.id, kind: f.kind, name: f.name, size: f.size, mime: f.mime || "",
    pages: f.pages || 0, clipped: !!f.clipped, w: f.w || 0, h: f.h || 0,
    mode: f.mode || "", ocrOnly: f.ocr ? 1 : 0, ocrText: f.ocr || "",
    subtype: f.subtype || "", unit: f.unit || "", imgCount: f.imgCount || 0,
    skippedImgs: f.skippedImgs || 0, degraded: f.degraded || "", textChars: f.textChars || 0,
    enc: f.enc || ""        /* 非 UTF-8 文本附件的原始编码(旧数据为空 = 按 UTF-8) */
  };
  if (f.ext) m.blob = f.id;      // payload 在 IndexedDB 里,消息里只留这个键
  return m;
}
/* data 为空字符串表示 payload 已经外置到 IndexedDB(attach.blob 是它的键),
   渲染与发送时再从内存缓存/IndexedDB 取回来 —— 消息本体(存 localStorage 的那份)就很小了 */
function imagePartFor(proto, mime, data, attach) {
  var p = proto === "anthropic"
    ? { type: "image", source: { type: "base64", media_type: mime || "image/png", data: data || "" } }
    : { type: "image_url", image_url: { url: data ? ("data:" + (mime || "image/png") + ";base64," + data) : "" } };
  if (attach) p.attach = attach;
  return p;
}
function attachmentParts(f, proto) {
  var out = [];
  if (f.kind === "image") {
    out.push(imagePartFor(proto, f.mime, f.ext ? "" : f.data, attachMetaOf(f)));
    return out;
  }
  if (f.kind === "pdf") {
    if (f.mode === "image" && f.images && f.images.length) {
      var meta = attachMetaOf(f);
      f.images.forEach(function (im, i) {
        var m = {};
        for (var k in meta) if (Object.prototype.hasOwnProperty.call(meta, k)) m[k] = meta[k];
        m.page = i + 1;
        if (im.ext) m.blob = f.id + "-p" + (i + 1);
        out.push(imagePartFor(proto, im.mime, im.ext ? "" : im.data, m));
      });
      return out;
    }
    out.push({
      type: "text",
      attach: attachMetaOf(f),
      text: "文件:" + f.name + "(PDF · 共 " + (f.pages || 1) + " 页" + (f.clipped ? " · 已截断" : "") + ")\n\n" + (f.text || "")
    });
    return out;
  }
  if (f.kind === "office") {
    /* 图像在前、文本在后(与「文件在前、问题在后」的既有约定一致);
       文本不加代码围栏,保证 unwrapFileText() 能还原正文 */
    if (f.mode === "both" && f.images && f.images.length) {
      var ometa = attachMetaOf(f);
      f.images.forEach(function (im, i) {
        var m = {};
        for (var k in ometa) if (Object.prototype.hasOwnProperty.call(ometa, k)) m[k] = ometa[k];
        m.page = i + 1;                        /* 键位用序号(与 externalizeFiles 的 -pN 对齐) */
        m.label = im.label || ("图 " + (i + 1));
        if (im.ext) m.blob = f.id + "-p" + (i + 1);
        out.push(imagePartFor(proto, im.mime, im.ext ? "" : im.data, m));
      });
    }
    if (f.text) {
      var info = String(f.subtype || "").toUpperCase();
      if (f.unit === "页" && f.pages) info += " · 共 " + f.pages + " 页";
      else if (f.unit === "表" && f.pages) info += " · 共 " + f.pages + " 表";
      else info += " · 文本 " + f.textChars + " 字";
      if (f.imgCount) info += " · " + f.imgCount + " 图";
      if (!f.imgCount && (f.subtype === "doc" || f.subtype === "ppt")) info += " · 仅文本";
      if (f.clipped) info += " · 已截断";
      out.push({
        type: "text",
        attach: attachMetaOf(f),
        text: "文件:" + f.name + "(" + info + ")\n\n" + f.text
      });
    }
    return out;
  }
  var body = String(f.text || "");
  var fence = body.indexOf("```") > -1 ? "````" : "```";
  var tinfo = [f.enc ? ("编码 " + wsEncName(f.enc) + " · 已转码显示") : "", f.clipped ? "内容过长 · 已截断" : ""]
    .filter(Boolean).join(" · ");
  out.push({
    type: "text",
    attach: attachMetaOf(f),
    text: "文件:" + f.name + (tinfo ? "(" + tinfo + ")" : "") + "\n" +
      fence + "\n" + body + "\n" + fence
  });
  return out;
}
/* 把草稿附件的 payload 写进 IndexedDB:成功才标记 ext(消息里不再带 base64);
   失败就保持原样(内联进 localStorage),不会丢数据 */
function externalizeFiles(files) {
  var list = files || [];
  if (!list.length) return Promise.resolve(0);
  return blobDb().then(function (db) {
    if (!db) return 0;
    var jobs = [];
    list.forEach(function (f) {
      if (!f) return;
      if (f.kind === "image" && f.data) {
        jobs.push(blobPut(f.id, f.mime, f.data).then(function (ok) { if (ok) f.ext = true; }));
      } else if (f.kind === "pdf" && f.mode === "image" && f.images) {
        f.images.forEach(function (im, i) {
          if (!im.data) return;
          var key = f.id + "-p" + (i + 1);
          jobs.push(blobPut(key, im.mime, im.data).then(function (ok) { if (ok) im.ext = true; }));
        });
      } else if (f.kind === "office" && f.images) {
        f.images.forEach(function (im, i) {
          if (!im.data) return;
          var key = f.id + "-p" + (i + 1);
          jobs.push(blobPut(key, im.mime, im.data).then(function (ok) { if (ok) im.ext = true; }));
        });
      }
    });
    return Promise.all(jobs).then(function (r) { return r.length; });
  }, function () { return 0; });
}
function buildUserContent(text, files) {
  var proto = state.settings.protocol;
  var parts = [];
  (files || []).forEach(function (f) {
    var ps = attachmentParts(f, proto);
    for (var i = 0; i < ps.length; i++) parts.push(ps[i]);
  });
  /* 文件/图片在前、问题在后:多数多模态模型按这个顺序训练 */
  if (text && text.trim()) parts.push({ type: "text", text: text });
  if (!parts.length) return "";
  if (parts.length === 1 && parts[0].type === "text" && !parts[0].attach) return parts[0].text;
  return parts;
}

/* ---- 附件设置面板(设置 → 附件) ---- */
var PDF_MODE_OPTIONS = [
  { v: "text", label: "纯文本", desc: "用 pdf.js 抽出文字再发送(默认,省 token)" },
  { v: "image", label: "图片", desc: "每页按设置的分辨率渲染成图片发送(需模型支持图像输入)" }
];
var OCR_LANG_OPTIONS = [
  { v: "chi_sim+eng", label: "中文 + 英文", desc: "默认,中英混排的图片都能认" },
  { v: "chi_sim", label: "仅中文", desc: "只加载中文模型" },
  { v: "eng", label: "仅英文", desc: "只加载英文模型,体积最小" }
];
var VISION_FORCE_OPTIONS = [
  { v: "auto", label: "自动", desc: "先看服务端模型清单,再自动探测(默认)" },
  { v: "yes", label: "强制支持", desc: "不探测,图片一律按原图发送" },
  { v: "no", label: "强制不支持", desc: "图片一律走 OCR,只发文字给模型" }
];
function initAttachSelects() {
  setupNsel("set-pdfmode", PDF_MODE_OPTIONS, function (v) {
    state.settings.pdfMode = v === "image" ? "image" : "text";
    saveSoon();
    renderAttachPanel();
  });
  setupNsel("set-ocrlangs", OCR_LANG_OPTIONS, function (v) {
    state.settings.ocrLangs = v;
    saveSoon();
    renderAttachPanel();
  });
  var resampleOpts = [];
  for (var rk in RESAMPLE_PRESETS) {
    if (Object.prototype.hasOwnProperty.call(RESAMPLE_PRESETS, rk)) {
      resampleOpts.push({ v: rk, label: RESAMPLE_PRESETS[rk].label, desc: RESAMPLE_PRESETS[rk].desc });
    }
  }
  setupNsel("set-resample", resampleOpts, function (v) {
    state.settings.imgResample = RESAMPLE_PRESETS[v] ? v : "spline";
    saveSoon();
    renderAttachPanel();
  });
  setupNsel("set-visionforce", VISION_FORCE_OPTIONS, function (v) {
    state.settings.visionForce = (v === "yes" || v === "no") ? v : "auto";
    saveSoon();
    renderVisionHint();
    updateCtxMeter();
  });
  var b = $("btn-vision-probe");
  if (b) b.addEventListener("click", function () {
    var m = effectiveModel();
    if (!m) { toast("先选择模型", "warn"); return; }
    saveSettingsFromModal(false, true);
    toast("正在探测「" + m + "」是否支持图像输入…", "info", 2600);
    probeModelVision(m, false);
  });
}
function renderVisionHint() {
  var name = effectiveModel();
  var el = $("set-vision-state");
  if (el) el.textContent = (name ? name + " : " : "") + visionLabel(name);
  var oc = $("set-ocr-state");
  if (oc) {
    oc.textContent = ocrReady()
      ? "引擎可用(Tesseract.js " + escapeHtml(window.OCRKit.version || "?") + ",已内嵌:" +
        escapeHtml((window.OCRKit.langs || []).join(" / ")) + ")。模型不支持视觉时,图片会自动 OCR 后只发文字。"
      : "引擎不可用:" + ((window.OCRKit && window.OCRKit.why) || "缺少 Web Worker / WebAssembly / Blob");
  }
  var libs = $("attach-libs");
  if (libs) {
    libs.innerHTML =
      "<dt>pdf.js</dt><dd>" + (pdfKitReady()
        ? "可用(" + escapeHtml(window.PDFKit.version || "?") + ")"
        : "不可用:" + escapeHtml((window.PDFKit && window.PDFKit.why) || "未加载")) + "</dd>" +
      "<dt>Tesseract.js</dt><dd>" + (ocrReady()
        ? "可用(" + escapeHtml(window.OCRKit.version || "?") + ")"
        : "不可用:" + escapeHtml((window.OCRKit && window.OCRKit.why) || "未加载")) + "</dd>" +
      "<dt>办公解析</dt><dd>" + (officeReady()
        ? "可用(" + escapeHtml(window.OfficeKit.version || "?") + ",模式 " + escapeHtml(window.OfficeKit.mode || "?") + ")"
        : "不可用:" + escapeHtml((window.OfficeKit && window.OfficeKit.why) || "未加载")
          + "(doc/docx/ppt/pptx/xls/xlsx 附件会被拒绝)") + "</dd>" +
      "<dt>Canvas / FileReader</dt><dd>" + (canvasOK() && CAP.fileReader ? "可用" : "不可用(图片会被原样发送)") + "</dd>" +
      "<dt>Web Worker</dt><dd>" + (CAP.worker ? "可用" : "不可用(库会降级到主线程运行)") + "</dd>";
  }
}
function renderAttachPanel() {
  setNselValue("set-resample", imgResampleMode(), true);
  var maxEl = $("set-imgmax");
  if (maxEl) {
    maxEl.value = String(imgMaxSide());
    syncRangeLabel(maxEl);
  }
  var amEl = $("set-attachmax");
  if (amEl) {
    amEl.value = String(Math.round(attachMsgMaxBytes() / 1048576));
    syncRangeLabel(amEl);
  }
  var kvA = $("kv-attach-max");
  if (kvA) kvA.textContent = fmtBytes(attachMsgMaxBytes()) + "(本地存储与请求都算它)";
  var kvI = $("kv-img-max");
  if (kvI) kvI.textContent = imgMaxSide() + " px,超出自动下采样(" + (RESAMPLE_PRESETS[imgResampleMode()] || {}).label + ")";
  setNselValue("set-pdfmode", pdfMode(), true);
  setNselValue("set-ocrlangs", ocrLangs(), true);
  setNselValue("set-visionforce", state.settings.visionForce || "auto", true);
  var pages = $("set-pdfpages");
  if (pages) {
    pages.value = String(pdfMaxPages());
    syncRangeLabel(pages);
  }
  var dpi = $("set-pdfdpi");
  if (dpi) {
    dpi.value = String(pdfDpi());
    syncRangeLabel(dpi);
  }
  renderVisionHint();
}
/* ---- 上下文压缩:自动路径的入口(appD 侧;压缩内核在 appE §28) ----
   · 去重:同一水位不重复压(CX_LEDGER.lastAfter,等价 Kimi lastCompactedTokenCount)
   · 限流:本 turn 内最多自动压缩 1 次(CX_LEDGER.round,防"压完又满→再压"成环)
     (计数在 sendMessage 开头复位;溢出恢复 cxOverflowRecover 共用同一个计数器)
   · 降噪:ECOMPACT_SMALL / NOSPACE **不 toast、不写状态行**(根本没进压缩流程),
     只按 CX_LEDGER.warned 的 5 个百分点步长提示一次 —— cxPlanFor 落水位档并给出 warnFresh
   · **不吞 ECOMPACT_ABORT**:原样返回给发送链,由它决定放弃本次发送
   返回形状统一 {ok, code, compacted, text} */
async function cxAutoBeforeSend(tf) {
  if (!cxEnabled() || !tf || !Array.isArray(tf.messages)) return null;
  var s = ctxSnapshot(tf);
  var pct = s.win > 0 ? (s.used / s.win * 100) : 0;
  if (pct < cxTriggerPct()) return null;
  var L = cxLedger(tf.id);
  if (L.lastAfter > 0 && s.used <= L.lastAfter) return null;   /* 没长过就不再压 */
  if ((L.round || 0) >= 1) return null;
  L.round = (L.round || 0) + 1;
  var r = await cxCompactNow(tf, { source: "auto", mode: "auto" });
  if (r && r.ok) {
    L.lastAfter = ctxSnapshot(tf).used;
    toast("上下文已自动压缩:丢弃 " + (r.dropped || 0) + " 条较早的消息" +
      (r.released ? "(释放 " + r.released + " 个附件)" : "") +
      ",约 " + num(r.before) + " → " + num(r.after) + " tok(重要中间结论建议落到工作区文件)" +
      (Number(r.after) > Number(r.before) ? "（本次摘要比被丢弃内容更长，属正常）" : ""),
      "info", 6000);
    return { ok: true, code: "", compacted: true, text: "" };
  }
  var code = (r && r.code) || "ECOMPACT_FAIL";
  if (code === "ECOMPACT_ABORT" || code === "ECOMPACT_BUSY") {
    return { ok: false, code: code, compacted: false, text: "" };
  }
  if (code === "ECOMPACT_SMALL" || code === "ECOMPACT_NOSPACE") {
    /* 同一水位档只提示一次(水位涨幅不足 5 个百分点 ⇒ 静默),绝不逐轮刷 toast */
    if (r && r.warnFresh) {
      var realUsers = 0, i;
      for (i = 0; i < tf.messages.length; i++) if (cxIsRealUser(tf.messages[i])) realUsers++;
      toast("自动压缩未生效:" + cxCodeText(code, realUsers <= 1) , "warn", 6400);
    }
    return { ok: false, code: code, compacted: false, text: "" };
  }
  toast("自动压缩失败:" + cxCodeText(code, false, r && r.note) + " —— 本轮照常继续", "warn", 6000);
  return { ok: false, code: code, compacted: false, text: "" };
}
/* 轮次之间的检查点:同一判定(去重 / 限流 / 降噪一致) */
async function cxAutoBetweenRounds(tf) {
  var r = await cxAutoBeforeSend(tf);
  return r || { ok: false, code: "", compacted: false, text: "" };
}
/* ---- 生成中的待发送缓冲区(内存 · 单槽 · 多项 · 按会话归属) ----
   用户原话:Agent 循环工作期间回车 → 文本进缓冲区(输入框上方浮窗),本轮(含全部工具轮)结束后
   立即自动发送并继续对话;循环结束前可召回(编辑按钮 / ↑)或丢弃。条目不持久化(刷新即失,与 Kimi
   的内存队列对齐)。同一时刻只有一个在飞 send(模块级 generating 是全局单飞)⇒ 只留一个会话槽。
   item = { id, convId, text, at };convId = **入队时**那条会话 —— 生成期间允许切走会话,
   缓冲消息必须落回它入队时那一条(读侧见 sendMessage 的 opts.bufItem.convId)。 */
var SQ = { convId: "", items: [] };
var genConvId = "";        /* 在飞 send 的归属会话:sendMessage 同步段写;finally 里**先清再 flush** */
function sqHasItems() { return !!(SQ && SQ.items && SQ.items.length); }
function sqHasFor(convId) { return !!(convId && SQ.convId === convId && SQ.items.length); }
/* 上下文用量环:把缓冲文本当成"待发送草稿"的一部分,文本从输入框移进缓冲时读数不跳变 */
function sqDraftTokens(c) {
  if (!c || !conv || c.id !== conv.id || !sqHasItems()) return 0;
  var n = 0, i;
  for (i = 0; i < SQ.items.length; i++) n += estimateTokens(SQ.items[i].text || "");
  return n;
}
/* 生成中回车 → 入队(唯一入口;空文本不动作,保持"空 Enter 无效果") */
function sqEnqueueFromInput() {
  var text = elInput.value.trim();
  if (!text) return;
  /* 只有"入队时那条会话"能入队:生成期间切走后回车不该悄悄塞进别人的队列 */
  if (!conv || conv.id !== genConvId) {
    toast("另一条会话正在生成中,本条消息未发送", "warn", 4200);
    return;
  }
  if (pendingOffice.length) {
    toast("办公文档还在本机解析中,完成后才能发送(点附件上的 ✕ 可取消)", "warn", 3600);
    return;
  }
  if (draftFiles.length) {   /* v1 不支持附件入队(文本与附件都不动,不产生半截状态) */
    toast("生成中:带附件的消息请等本轮结束后再发送(文字与附件都保留在输入框)", "warn", 4600);
    return;
  }
  /* 槽与条目在同一个同步段写入,convId 用同一个值(I2 强化:每项 convId 恒 = SQ.convId) */
  SQ.convId = genConvId;
  SQ.items.push({ id: uid(), convId: genConvId, text: text, at: Date.now() });
  elInput.value = "";
  autoResize();
  updateCtxMeter();
  sqRender();
  focusInput();
}
/* 早退回队(幂等):同一 item 重复调用只放回一次,防"交接期异常 → 重复发送" */
function sqRestoreBuf(item) {
  if (!item || !item.id) return;
  for (var i = 0; i < SQ.items.length; i++) if (SQ.items[i].id === item.id) { sqRender(); return; }
  if (!SQ.convId) SQ.convId = item.convId || "";
  SQ.items.unshift(item);
  sqRender();
}
/* 召回(编辑按钮 & ↑ 共用):严格镜像 Kimi 的"编辑器完全为空"判定(D4,不 trim) */
function sqRecall(itemId) {
  if (elInput.value.length !== 0) {
    toast("输入框里还有内容,先清空再召回(避免覆盖草稿)", "warn", 3600);
    return;
  }
  var i, it = null;
  for (i = 0; i < SQ.items.length; i++) if (SQ.items[i].id === itemId) { it = SQ.items[i]; break; }
  if (!it) return;
  SQ.items.splice(i, 1);
  elInput.value = it.text;
  autoResize();
  updateCtxMeter();
  sqRender();
  focusInput();
}
function sqDiscard(itemId) {
  for (var i = 0; i < SQ.items.length; i++) {
    if (SQ.items[i].id === itemId) { SQ.items.splice(i, 1); break; }
  }
  updateCtxMeter();
  sqRender();
}
/* 残留态(未生成但队列非空)的手动恢复路径:唯一入口 = 空 Enter(hint 明示) */
function sqSendableIdle() {
  return !generating && sqHasItems() && !!conv && conv.id === SQ.convId &&
    !elInput.value.trim() && !draftFiles.length;
}
function sqSendHead() {
  if (generating || !sqSendableIdle()) return;
  var it = SQ.items.shift();
  sqRender();
  sendMessage(it.text, { bufItem: it });
}
/* 回合结束后的自动发送:取队首 1 条,**同步**调 sendMessage(不 await、不 catch —— 错误在
   sendMessage 既有链路里 toast)。它的同步段会把 generating 置回 true ⇒ 紧随的 pvNotifyCheck()
   命中 "if (generating) return" 自动让位(缓冲是用户内容,优先于 E12 自动续跑) */
function sqFlushAfterTurn(endedConvId) {
  if (generating) return;
  if (!sqHasItems()) return;
  if (SQ.convId !== endedConvId) return;
  if (!getConv(SQ.convId)) {                 /* 目标会话已删(或整库替换拿走):整槽丢弃 */
    SQ.items = []; SQ.convId = "";
    sqRender();
    toast("该对话已被删除,待发送消息已丢弃", "warn", 5000);
    return;
  }
  if (!effectiveModel().trim() || !apiUrl("")) {   /* 廉价前置校验:不出队、留待用户动作 */
    sqRender();
    toast("待发送消息已保留:配置好模型 / Base URL 后按 Enter 或召回发送", "warn", 5200);
    return;
  }
  var it = SQ.items.shift();                 /* 交接即出队 */
  sqRender();
  sendMessage(it.text, { bufItem: it });
}
function sqHintText() {
  if (!generating && sqHasItems()) return "按 Enter 立即发送";
  if ((typeof ASK_WAITS !== "undefined" && ASK_WAITS && Object.keys(ASK_WAITS).length) ||
      (typeof TOOL_WAITS !== "undefined" && TOOL_WAITS && Object.keys(TOOL_WAITS).length)) {
    return "正在等你回答 / 放行,之后自动发送";
  }
  if (typeof CX_RUN !== "undefined" && CX_RUN && CX_RUN.phase !== "idle") return "压缩完成后自动发送";
  return "本轮结束后自动发送 · Esc 不取消待发送 · ↑ 召回最后一条 · 可编辑 / 丢弃";
}
/* 浮窗渲染(清空重建;调用点 = 入队/召回/丢弃/交接 + renderChat 两个出口) */
function sqRender() {
  var box = $("send-queue"), rows = $("send-queue-rows"), hint = $("send-queue-hint");
  if (!box || !rows || !SQ || !SQ.items) return;
  var show = SQ.items.length > 0 && !!conv && conv.id === SQ.convId;   /* I6:只在归属会话可见 */
  while (rows.firstChild) rows.removeChild(rows.firstChild);           /* 先清空:隐藏时不留残留 DOM */
  if (!show) {
    box.classList.remove("open");
    box.setAttribute("hidden", "");
    return;
  }
  SQ.items.forEach(function (it) {
    var row = document.createElement("div");
    row.className = "sq-row";
    row.setAttribute("role", "listitem");
    row.setAttribute("data-id", it.id);
    var t = document.createElement("span");
    t.className = "sq-text";
    t.textContent = it.text;             /* 一律 textContent:缓冲文本可能含标签 */
    t.title = it.text;
    row.appendChild(t);
    var be = document.createElement("button");
    be.className = "sq-btn"; be.type = "button";
    be.setAttribute("data-sq-act", "edit");
    be.setAttribute("aria-label", "编辑这条待发送消息");
    be.innerHTML = icon("edit", "sm");
    row.appendChild(be);
    var bd = document.createElement("button");
    bd.className = "sq-btn"; bd.type = "button";
    bd.setAttribute("data-sq-act", "discard");
    bd.setAttribute("aria-label", "丢弃这条待发送消息");
    bd.innerHTML = icon("trash", "sm");
    row.appendChild(bd);
    rows.appendChild(row);
  });
  if (!rows.__sqBound) {                /* 事件委托一次绑定(先例 = ctx-pop 的 click 委托) */
    rows.__sqBound = true;
    rows.addEventListener("click", function (e) {
      var btn = (e.target && e.target.closest) ? e.target.closest("[data-sq-act]") : null;
      if (!btn) return;
      var row = btn.closest(".sq-row");
      var id = row ? row.getAttribute("data-id") : "";
      if (!id) return;
      if (btn.getAttribute("data-sq-act") === "edit") sqRecall(id); else sqDiscard(id);
    });
  }
  if (hint) hint.textContent = sqHintText();
  box.classList.add("open");
  box.removeAttribute("hidden");
}
function doSend() {
  if (generating) return;
  /* 办公文档还在本机解析:这时候发出去要么把附件静默漏掉、要么按了没反应 —— 明确挡住并说明 */
  if (pendingOffice.length) {
    toast("办公文档还在本机解析中,完成后才能发送(点附件上的 ✕ 可取消)", "warn", 3600);
    return;
  }
  var text = elInput.value.trim();
  if (!text && !draftFiles.length) return;
  if (!conv) { if (!newConversation({ keepDraft: true })) return; }
  var files = draftFiles;
  draftFiles = [];
  renderAttachBar();
  elInput.value = "";
  autoResize();
  sendMessage(text, { files: files });
}

/* ---- 参数浮层 ---- */
var PARAM_DEFS = [
  { key: "temperature", id: "p-temp", out: "p-temp-v", min: -1, max: 2, fmt: function (v) { return v < 0 ? "不发送" : v.toFixed(2); } },
  { key: "topP", id: "p-topp", out: "p-topp-v", min: -1, max: 1, fmt: function (v) { return v < 0 ? "不发送" : v.toFixed(2); } },
  { key: "maxTokens", id: "p-maxtok", out: "p-maxtok-v", min: 0, max: 393216, fmt: function (v) { return fmtTok(v); } },
  { key: "freqPenalty", id: "p-reppen", out: "p-reppen-v", min: 0, max: 2, fmt: function (v) { return v === 0 ? "不启用" : v.toFixed(2); } }
];
function syncEffortInputs() {
  var v = state.settings.reasoningEffort || "";
  setNselValue("set-reff", v, true);
  setNselValue("p-reff", v, true);
}
function syncParamInputs() {
  PARAM_DEFS.forEach(function (d) {
    var el = $(d.id), out = $(d.out);
    if (!el) return;
    el.value = state.settings[d.key];
    if (out) out.textContent = d.fmt(Number(state.settings[d.key]));
  });
  syncEffortInputs();
  syncCtxWinInputs();
}
/* 上下文长度(手动设定)的两个控件:输入区浮层 + 设置面板各一组,显示态与取值同源。
   forceEl = 刚提交完的那个输入框(它可能仍持有焦点,必须回写 clamp 后的值) */
function syncCtxWinInputs(forceEl) {
  var on = ctxWinManualOn();
  var v = ctxWinKNow();
  [["p-ctxwin-field", "p-ctxwin", "p-ctxwin-n"], ["set-ctxwin-field", "set-ctxwin", "set-ctxwin-n"]].forEach(function (ids) {
    var box = $(ids[0]);
    if (box) box.style.display = on ? "" : "none";
    var r = $(ids[1]);
    if (r && Number(r.value) !== v) r.value = v;
    var n = $(ids[2]);
    if (n && (n === forceEl || (Number(n.value) !== v && document.activeElement !== n))) n.value = v;
  });
}
/* 手调上下文长度的**唯一写入口**:clamp → 写设置 → 两处控件同步 → 用量环 / 来源文案即时刷新。
   服务端给了窗口长度时计算路径根本不看这个值(ctxWindowFor 先判 server),控件也已隐藏 */
function setCtxWinK(v, src) {
  var k = clampNum(v, CTX_WIN_K_MIN, CTX_WIN_K_MAX, DEFAULT_SETTINGS.ctxWinK);
  state.settings.ctxWinK = k;
  saveSoon();
  syncCtxWinInputs(src);
  updateModelsHint();
  updateCtxMonitor();
  return k;
}
/* K 输入框的取值(与设置面板数字输入 numBindValue 同一口径):
   `input[type=number]` 会把非数字串消毒成 ""(清空、输入 'abc' 都是这个结果),而 Number("")=0
   是"合法数字" ⇒ 直接 clamp 会把清空动作钉到**最小值** 8K。所以空串与非数字都回默认值,
   只有真数字才按区间夹(4→8、2048→1024) */
function ctxWinKFromInput(el) {
  var raw = el ? String(el.value == null ? "" : el.value).trim() : "";
  if (raw === "" || !isFinite(Number(raw))) return DEFAULT_SETTINGS.ctxWinK;
  return clampNum(Number(raw), CTX_WIN_K_MIN, CTX_WIN_K_MAX, DEFAULT_SETTINGS.ctxWinK);
}
/* 四个输入框(两组 × 滑块 + K 输入框):滑块即时生效;输入框失焦 / 回车(change)生效。
   范围与步进取自常量,HTML 里的 min/max/step 只是初始值 */
function initCtxWinInputs() {
  [["p-ctxwin", "p-ctxwin-n"], ["set-ctxwin", "set-ctxwin-n"]].forEach(function (ids) {
    var r = $(ids[0]), n = $(ids[1]);
    if (r) {
      r.min = String(CTX_WIN_K_MIN); r.max = String(CTX_WIN_K_MAX); r.step = String(CTX_WIN_K_STEP);
      r.addEventListener("input", function () { setCtxWinK(Number(r.value)); });
    }
    if (n) {
      n.min = String(CTX_WIN_K_MIN); n.max = String(CTX_WIN_K_MAX); n.step = String(CTX_WIN_K_STEP);
      n.addEventListener("change", function () { setCtxWinK(ctxWinKFromInput(n), n); });
    }
  });
}
function initParamInputs() {
  PARAM_DEFS.forEach(function (d) {
    var el = $(d.id);
    if (!el) return;
    el.addEventListener("input", function () {
      state.settings[d.key] = Number(el.value);
      $(d.out).textContent = d.fmt(Number(el.value));
      var mirror = $("set-" + d.key.toLowerCase());
      if (mirror) { mirror.value = el.value; syncRangeLabel(mirror); }
      saveSoon();
    });
  });
  initCtxWinInputs();
  $("p-reset").addEventListener("click", function () {
    PARAM_DEFS.forEach(function (d) { state.settings[d.key] = DEFAULT_SETTINGS[d.key]; });
    state.settings.reasoningEffort = DEFAULT_SETTINGS.reasoningEffort;
    state.settings.ctxWinK = DEFAULT_SETTINGS.ctxWinK;
    syncParamInputs(); syncSettingsForm(); saveSoon();
    toast("已恢复默认生成参数", "success", 1600);
  });
  $("p-close").addEventListener("click", function () { $("params-pop").classList.remove("open"); $("btn-params").classList.remove("on"); });
}
function toggleParamsPop() {
  var pop = $("params-pop"), btn = $("btn-params");
  var open = !pop.classList.contains("open");
  $("pop-menu").classList.remove("open");
  syncParamInputs();
  syncParamTools();      /* 「工具」分组的开关态 / 可用数 / prefill 提示 */
  pop.classList.toggle("open", open);
  btn.classList.toggle("on", open);
  if (open) placePopover(pop, btn, { align: "left", width: 320 });
}
/* ---- 提示词模板 ---- */
function openLibMenu(anchor) {
  closeMenus();
  var menu = $("pop-menu");
  var items = state.promptLib.map(function (t) {
    var pv = t.text.replace(/\s+/g, " ").slice(0, 34);
    return '<button data-libtext="' + escAttr(t.text) + '" title="' + escAttr(t.text) + '">' +
      icon("book", "sm") + "<span>" + escapeHtml(t.name) + "</span></button>";
  }).join("");
  if (!items) items = '<div class="pm-hint" style="padding:8px 11px">模板库为空</div>';
  menu.innerHTML = items +
    '<div class="pm-sep"></div><button data-libact="manage">' + icon("sliders", "sm") + " 管理模板…</button>";
  placeMenu(menu, anchor);
}
function placeMenu(menu, anchor) {
  menu.classList.add("open");
  var r = menu.getBoundingClientRect();
  var a = anchor.getBoundingClientRect();
  var x = a.left, y = a.top - r.height - 8;
  if (y < 8) y = a.bottom + 8;
  if (x + r.width > window.innerWidth - 8) x = window.innerWidth - r.width - 8;
  if (x < 8) x = 8;
  menu.style.left = x + "px";
  menu.style.top = y + "px";
}
/* 浮层贴着触发按钮:优先放正上方(与「插入提示词模板」菜单同一套做法),
   上面放不下才翻到下方;太高时自身滚动,保证始终贴着按钮且不出屏。
   左右按 align 对齐按钮的两侧。调用前浮层必须已显示。 */
function placePopover(pop, anchor, opts) {
  if (!pop || !anchor) return;
  opts = opts || {};
  var w = Math.round(opts.width || pop.offsetWidth || 320);
  var gap = 10;
  pop.style.maxHeight = "none";
  pop.style.overflowY = "visible";
  var h = Math.round(pop.offsetHeight || 0);
  var a = anchor.getBoundingClientRect();
  var vw = window.innerWidth, vh = window.innerHeight;
  var spaceAbove = a.top - gap - 10;
  var spaceBelow = vh - a.bottom - gap - 10;
  var useAbove = spaceAbove >= Math.min(h, opts.preferAbove || 220);
  var avail = useAbove ? spaceAbove : spaceBelow;
  var cap = Math.max(160, Math.min(Math.round(vh * 0.8), avail));
  if (h > cap) {
    pop.style.maxHeight = cap + "px";
    pop.style.overflowY = "auto";
  }
  var drawH = Math.min(h, cap);
  var y = useAbove ? (a.top - gap - drawH) : (a.bottom + gap);
  if (y + drawH > vh - 10) y = vh - drawH - 10;
  if (y < 10) y = 10;
  var x = (opts.align === "right") ? (a.right - w) : a.left;
  if (x + w > vw - 10) x = vw - w - 10;
  if (x < 10) x = 10;
  pop.style.position = "fixed";
  pop.style.right = "auto";
  pop.style.bottom = "auto";
  pop.style.width = w + "px";
  pop.style.left = Math.round(x) + "px";
  pop.style.top = Math.round(y) + "px";
  pop.setAttribute("data-placement", useAbove ? "top" : "bottom");
}
function repositionPops() {
  if ($("params-pop").classList.contains("open")) {
    placePopover($("params-pop"), $("btn-params"), { align: "left", width: 320 });
  }
  if ($("ctx-pop").classList.contains("open")) {
    placePopover($("ctx-pop"), $("ctx-meter"), { align: "right", width: 344 });
  }
}

/* ---------------------------------------------------------------------------
   15. API 层(OpenAI 兼容 / Anthropic Messages)
--------------------------------------------------------------------------- */
function apiUrl(path) {
  var b = (state.settings.baseUrl || "").trim().replace(/\/+$/, "");
  if (!b) return "";
  if (/\/(v1|api\/v1)$/.test(b)) return b + (path ? "/" + path : "");
  return b + "/v1/" + path;
}
function headersFor(withBody) {
  var h = { "Accept": "text/event-stream, application/json" };
  if (withBody !== false) h["Content-Type"] = "application/json";
  var key = (state.settings.apiKey || "").trim();
  if (state.settings.protocol === "openai") {
    if (key) h["Authorization"] = "Bearer " + key;
  } else {
    if (key) h["x-api-key"] = key;
    h["anthropic-version"] = "2023-06-01";
    h["anthropic-dangerous-direct-browser-access"] = "true";
  }
  return h;
}
function errText(e) {
  if (!e) return "未知错误";
  if (e.name === "AbortError") return "请求已取消";
  return e.message || String(e);
}
function friendlyError(e, url) {
  var msg = errText(e);
  if (e && e.name === "AbortError") return "已超时或已取消";
  if (/Failed to fetch|NetworkError|Load failed/i.test(msg)) {
    msg = "无法连接到服务器(网络不可达、地址错误或被跨域策略拦截)";
  } else if (/ERR_CONNECTION_REFUSED|ECONNREFUSED|拒绝/i.test(msg)) {
    msg = "连接被拒绝:请确认服务已启动,且地址与端口正确";
  }
  return msg + (url ? "\n目标地址:" + url : "");
}
function safeJson(text, limit) {
  if (!text) return "";
  return text.length > (limit || 400) ? text.slice(0, limit || 400) + "…" : text;
}

/* ---- 工具媒体进请求的三种装配(单一来源;§3.4/§3.8.3) ----
   · trimToolMediaForRequest:聊天轮软护栏(非破坏性;摘要请求不调用);
   · stripToolMediaForWire:结构类 4xx 降级(noToolMedia)时去掉 media(工具文本照发);
   · expandToolMediaForOpenAI:OpenAI 兼容形态,按工具轮分组插一条合成 user(只进请求体)。
   常量(TOOL_MEDIA_CHAT_*)在 appE(本段之后)⇒ 只在函数体内取,不在模块级读。 */
function trimToolMediaForRequest(list) {
  var keepN = TOOL_MEDIA_CHAT_KEEP_ITEMS, maxBytes = TOOL_MEDIA_CHAT_MAX_BYTES;
  var idx = [], i, j;
  for (i = 0; i < list.length; i++) {
    var m = list[i];
    if (m && m.role === "tool" && m.media && m.media.length) idx.push(i);
  }
  if (!idx.length) return list;
  var keepFrom = Math.max(0, idx.length - keepN);      /* 只裁**更早**的:当前工具轮的图永不被裁 */
  var cut = {}, bytes = 0, any = false;
  for (i = idx.length - 1; i >= 0; i--) {
    var it = list[idx[i]], sz = 0;
    for (j = 0; j < it.media.length; j++) sz += String((it.media[j] && it.media[j].data) || "").length;
    if (i >= keepFrom && bytes + sz <= maxBytes) { bytes += sz; continue; }
    cut[idx[i]] = true; any = true;
  }
  if (!any) return list;
  var out = list.slice();
  for (var k in cut) {
    if (!Object.prototype.hasOwnProperty.call(cut, k)) continue;
    var src = out[k], copy = {}, key;
    for (key in src) if (Object.prototype.hasOwnProperty.call(src, key) && key !== "media") copy[key] = src[key];
    copy.content = String(src.content == null ? "" : src.content) + "\n[图像已省略:超出请求体积上限,需要时可重新读取]";
    out[k] = copy;
  }
  return out;
}
function stripToolMediaForWire(list) {
  var out = [], changed = false, i, key;
  for (i = 0; i < list.length; i++) {
    var m = list[i];
    if (m && m.role === "tool" && m.media && m.media.length) {
      var copy = {};
      for (key in m) if (Object.prototype.hasOwnProperty.call(m, key) && key !== "media") copy[key] = m[key];
      out.push(copy); changed = true;
    } else out.push(m);
  }
  return changed ? out : list;
}
/* OpenAI 兼容:tool 消息 content 只认字符串 ⇒ 把同一工具轮(连续 role==="tool" 段)的媒体合并成
   **一条**合成 user 消息,插在该段最后一条 tool 之后(跨段不合并 ⇒ 不产出 tool→user→tool 交错)。
   非破坏性:带 media 的项浅拷贝并删掉内部 media 字段(msgList 与 payload 共享对象,就地删会把
   下一轮的图也删掉);合成消息只在请求体里存在:不落盘、不进界面、文案写明「这不是用户的新提问」。 */
function expandToolMediaForOpenAI(list) {
  var out = [], i;
  for (i = 0; i < list.length; i++) {
    var m = list[i];
    if (!m || m.role !== "tool" || !m.media || !m.media.length) { out.push(m); continue; }
    var j = i, media = [], paths = [];
    while (j < list.length && list[j] && list[j].role === "tool") {
      var src = list[j];
      if (src.media && src.media.length) {
        var copy = {}, key;
        for (key in src) if (Object.prototype.hasOwnProperty.call(src, key) && key !== "media") copy[key] = src[key];
        out.push(copy);
        for (var k = 0; k < src.media.length; k++) {
          var im = src.media[k] || {};
          media.push(im);
          if (im.path) paths.push(im.path);
          else if (im.label) paths.push(im.label);
        }
      } else out.push(src);
      j++;
    }
    if (media.length) {
      var parts = [{ type: "text", text: "以下是 Read 工具读取的 " + media.length + " 个文件" +
        (paths.length ? "(" + paths.join("、") + ")" : "") + "的图片内容,请据此继续完成任务(这不是用户的新提问)" }];
      for (var q = 0; q < media.length; q++) parts.push(imagePartFor("openai", media[q].mime, media[q].data, null));
      out.push({ role: "user", content: parts });
    }
    i = j - 1;
  }
  return out;
}
/* 结构类 4xx 分类器(与 b25 cxIsOverflowError 同范式:显式状态码集合 + 显式正则):
   只匹配「消息/工具结构」类报文,不误伤配额 / 鉴权 / 模型不存在(那三类走既有失败路径) */
function isToolMediaStructureError(err) {
  if (!err) return false;
  var st = Number(err.__httpStatus);
  if (st !== 400 && st !== 422) return false;
  return /tool_call|tool_calls|tool_use|tool_result|tool role|messages\[\d+\]|Invalid.*(tool|content|message)|content.*(type|must)|unexpected.*(role|content)/i.test(String(err.message || ""));
}

/* 组装将要发送的消息(带上下文裁剪)。
   opts(缺省 undefined ⇒ 既有行为逐字节不变):
     noCap : true = 绕过「携带历史条数上限(ctxMsgs)」截断 —— **仅压缩请求用**
            (摘要输入必须是完整历史;聊天轮不传,语义不变) */
function payloadMessages(baseList, opts) {
  if (!conv && !baseList) return { list: [], truncated: false, tokens: 0 };
  var noCap = !!(opts && opts.noCap === true);
  var src = baseList || conv.messages;
  var all = [];
  for (var i = 0; i < src.length; i++) {
    var m = src[i];
    if (m.error) continue;
    /* 工具结果:必须回传,否则模型会因为缺少 tool_call 的应答而报错。
       media(内联图片)是**payload 项内部字段**:不落盘、不进 wire,由 openai 分支的
       expandToolMediaForOpenAI / anthropic 分支按规范各自展开(见 §3.4) */
    if (m.role === "tool") {
      var tItem = {
        role: "tool",
        content: m.content || (m.status === "wait" ? "用户尚未确认执行" : "工具未执行"),
        tool_call_id: m.toolCallId,
        name: m.toolName
      };
      if (m.media && m.media.length) tItem.media = m.media;
      all.push(tItem);
      continue;
    }
    if (m.streaming) continue;
    var hasCalls = m.role === "assistant" && m.toolCalls && m.toolCalls.length;
    if (!hasCalls && m.role === "assistant" && !contentToText(m.content).trim()) continue;
    if (m.role === "user" && !contentToText(m.content).trim() && typeof m.content === "string") continue;
    var item = { role: m.role, content: protocolContent(m.content, state.settings.protocol) };
    if (hasCalls) item.tool_calls = apiToolCalls(m.toolCalls);
    all.push(item);
  }
  var s = state.settings;
  var list = all, truncated = false;
  if (!noCap && s.ctxMsgs > 0 && list.length > s.ctxMsgs) {
    list = list.slice(list.length - s.ctxMsgs);
    truncated = true;
    /* 截断后开头若是孤立的工具结果:只补一条说明**修不好结构** —— 服务端会因为
       「找不到对应的 tool_call / tool_use」直接 400(Anthropic 更严格),而且
       history-union 只能保住 body.tools 里的定义、保不住消息结构。
       所以这里把开头这些「已经没有对应调用」的 tool 消息一并丢掉,再用一句说明交代省略
       (复现:ctxMsgs=2 + 末两条为 tool/user 时,截断后 payload 首条就是 role:"tool") */
    var orphan = false;
    while (list.length && list[0].role === "tool") { list = list.slice(1); orphan = true; }
    if (orphan) list = [{ role: "user", content: "(较早的工具调用记录已因历史条数限制被省略)" }].concat(list);
  }
  var tokens = 0;
  list.forEach(function (m) {
