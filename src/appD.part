      });
    }
  });
  return { list: list, truncated: truncated, tokens: tokens };
}
/* Anthropic Messages:要求首条为 user、角色交替,工具调用要转成 tool_use / tool_result 块 */
function normalizeAnthropic(list) {
  var out = [];
  function pushMsg(role, content) {
    out.push({ role: role, content: content });
  }
  for (var i = 0; i < list.length; i++) {
    var m = list[i];
    if (m.role === "tool") {
      var tMedia = (m.media && m.media.length) ? m.media : null;
      var tContent = typeof m.content === "string" ? m.content : contentToText(m.content);
      var blk;
      if (tMedia) {
        /* Anthropic 原生形态:tool_result.content 是内容块数组(文本 + image 块) */
        var tBlocks = [];
        if (tContent) tBlocks.push({ type: "text", text: tContent });
        for (var ti = 0; ti < tMedia.length; ti++) {
          tBlocks.push(imagePartFor("anthropic", tMedia[ti].mime, tMedia[ti].data, null));
        }
        blk = { type: "tool_result", tool_use_id: m.tool_call_id || "", content: tBlocks };
      } else {
        blk = { type: "tool_result", tool_use_id: m.tool_call_id || "", content: tContent };
      }
      var prev = out[out.length - 1];
      if (prev && prev.role === "user" && prev.__toolResults) prev.content.push(blk);
      else {
        pushMsg("user", [blk]);
        out[out.length - 1].__toolResults = true;
      }
      continue;
    }
    if (m.role === "assistant" && m.tool_calls && m.tool_calls.length) {
      var blocks = [];
      var txt = contentToText(m.content);
      if (txt && txt.trim()) blocks.push({ type: "text", text: txt });
      m.tool_calls.forEach(function (tc) {
        var input = {};
        try {
          input = JSON.parse(tc.function.arguments || "{}");
        } catch (e) { input = {}; }
        if (!input || typeof input !== "object" || Array.isArray(input)) input = { value: input };
        blocks.push({ type: "tool_use", id: tc.id, name: tc.function.name, input: input });
      });
      pushMsg("assistant", blocks);
      continue;
    }
    pushMsg(m.role, m.content);
  }
  /* 合并相邻同角色 */
  var merged = [];
  for (var k = 0; k < out.length; k++) {
    var cur = out[k], last = merged[merged.length - 1];
    if (last && last.role === cur.role) {
      var aIsArr = Array.isArray(last.content), bIsArr = Array.isArray(cur.content);
      if (aIsArr && bIsArr) last.content = last.content.concat(cur.content);
      else if (aIsArr) last.content.push({ type: "text", text: contentToText(cur.content) });
      else if (bIsArr) last.content = [{ type: "text", text: contentToText(last.content) }].concat(cur.content);
      else last.content = contentToText(last.content) + "\n\n" + contentToText(cur.content);
      if (cur.__toolResults) last.__toolResults = true;
    } else {
      merged.push({ role: cur.role, content: cur.content, __toolResults: cur.__toolResults });
    }
  }
  while (merged.length && merged[0].role !== "user") merged.shift();
  /* Anthropic 不允许最后一条是 assistant(除非它就是 tool_use 那一轮) */
  while (merged.length && merged[merged.length - 1].role === "assistant") merged.pop();
  if (!merged.length) merged.push({ role: "user", content: "……" });
  return merged.map(function (m) { return { role: m.role, content: m.content }; });
}
function applySampling(body, proto) {
  var s = state.settings;
  // 约定:值为负 = 不发送该参数,交给服务端默认值
  var t = Number(s.temperature);
  if (t >= 0) body.temperature = proto === "anthropic" ? clamp(t, 0, 1) : clamp(t, 0, 2);
  var p = Number(s.topP);
  if (p >= 0) body.top_p = clamp(p, 0, 1);
  var mt = maxTokensFor(proto);
  if (mt > 0) body.max_tokens = mt;
  if (proto === "openai") {
    if (Number(s.freqPenalty) > 0) body.frequency_penalty = clamp(Number(s.freqPenalty), 0, 2);
    if (Number(s.presencePenalty) > 0) body.presence_penalty = clamp(Number(s.presencePenalty), 0, 2);
  }
}
/* 最大输出 token:0 表示不发送。Anthropic 协议必须带 max_tokens,未设置时按 256K */
function maxTokensFor(proto) {
  var v = Math.round(Number(state.settings.maxTokens) || 0);
  if (v <= 0) return proto === "anthropic" ? ANTHROPIC_DEFAULT_MAXTOK : 0;
  return clamp(v, 1, MAX_TOK_LIMIT);
}
/* 思考强度挡位映射:
   OpenAI 兼容协议 → reasoning_effort(low / medium / high / max,由服务端校验)
   Anthropic Messages → output_config.effort(自适应思考下整体 token 投入挡位) */
function applyReasoningEffort(body, proto) {
  var lv = state.settings.reasoningEffort;
  if (EFFORT_LEVELS.indexOf(lv) === -1) return;
  if (proto === "openai") body.reasoning_effort = lv;
  else body.output_config = { effort: lv };
}
/* 请求体组装(聊天轮**与压缩请求**的唯一来源;禁止另写第二份 —— sys / 采样 / 工具三处口径
   一经分叉必然漂移)。
   opts(缺省 undefined ⇒ 既有行为逐字节不变):
     maxTokens : number  最大输出覆盖,OpenAI / Anthropic 都恒写(压缩请求用,写死见下)
     summary   : true    压缩请求标记(仅:sys 链改用 pvTaskBlockText 只读变体;不触发其它分支) */
function buildBody(list, model, stream, targetConv, opts) {
  var s = state.settings;
  /* 请求体的「上下文部分」(system / 工作区 / 工具集)一律按**目标会话**取:
     targetConv 缺省 = 模块级 conv(既有行为不变);发送链显式传"发起这次生成时"那条会话。
     生成期间允许切走会话,而 buildBody 是每轮都调一次(含工具续轮)—— 缺省读 conv 就会把
     另一条会话的 system / 工作区 / 工具集拼进这一轮的请求体(消息历史已按发起会话取,
     见 sendMessage 的 tf / payloadMessages),同一份请求里两套会话口径 = 请求体混搭 */
  var c = targetConv || conv;
  var sys = ((c && c.system) || s.systemPrompt || "").trim();
  /* 工作区上下文是「临时拼接」——只进本次请求,不写回 conv.system。
     注意既有分支是「sys 为空就不写 system」,所以拼接后 sys 非空即会自动带上 */
  var wsCtx = wsContextBlock(c);
  if (wsCtx) sys = sys ? (sys + "\n\n" + wsCtx) : wsCtx;
  /* 后台任务的完成提醒走同一条 sys 拼接链(临时拼接,不写回 conv.system、不改 conv.messages)。
     每轮请求都调一次 → "生成中"时新完成的会在下一轮 tool-loop 自然带上;注入一次即 notified:true。
     压缩请求(summary:true)一律改用只读变体 pvTaskBlockText:文本逐字节相同、但不登记在途通知
     (压缩请求没有配套的 pvNotifyCommit / pvNotifyRollback,登记会打乱完成回流链) */
  var taskCtx = (opts && opts.summary === true) ? pvTaskBlockText(c) : pvTaskBlock(c);
  if (taskCtx) sys = sys ? (sys + "\n\n" + taskCtx) : taskCtx;
  /* 外部 MCP 服务器的 instructions —— 默认不注入,只有 mcpInjectInstructions=true
     且外部工具**在本会话生效**、服务器已连接时才拼进 sys(与工作区块并列;
     生效态含会话级覆盖) */
  var mcpCtx = mcpInstructionsBlock(c);
  if (mcpCtx) sys = sys ? (sys + "\n\n" + mcpCtx) : mcpCtx;
  /* 上下文用量接近窗口上限时的系统提醒(与 pvTaskBlock / wsContextBlock 同范式:
     只读、无副作用、每轮现算;取数一律用传入的会话 —— 生成期间切走后描述的是**发起会话**) */
  var cxCtx = cxContextBlock(c);
  if (cxCtx) sys = sys ? (sys + "\n\n" + cxCtx) : cxCtx;
  var body = { model: model, messages: list };
  /* 请求装配层的两条媒体纪律(§3.4 / §3.8.3):
     · 聊天轮软护栏:非摘要请求先过 trimToolMediaForRequest(摘要请求由 b25 的 cxSummaryMedia 阶梯
       + 32 MiB 闸管,避免两套裁剪互相打架);
     · noToolMedia(结构类 4xx 降级,见 sendMessage 的工具轮):本次去掉 media(工具文本照发)。
     两者都**非破坏性**(只浅拷贝被改动的 payload 项)—— msgList 跨轮复用同一批对象。 */
  var wire = list;
  if (!(opts && opts.summary === true)) wire = trimToolMediaForRequest(list);
  if (opts && opts.noToolMedia) wire = stripToolMediaForWire(wire);
  if (s.protocol === "openai") {
    if (sys) body.messages = [{ role: "system", content: sys }].concat(expandToolMediaForOpenAI(wire));
    else body.messages = expandToolMediaForOpenAI(wire);
    body.stream = !!stream;
    /* 要求服务端在流式末尾回 usage,才能拿到真实的 completion_tokens */
    if (stream) body.stream_options = { include_usage: true };
    applySampling(body, "openai");
    /* 压缩请求的输出预算覆盖必须写在 applySampling **之后**:applySampling 会先按 maxTokensFor
       写一次 max_tokens,覆盖写在前面会被它盖掉。压缩请求恒写(注意:聊天轮的 OpenAI 分支在
       maxTokens<=0 时不写 max_tokens,所以"恒写"是压缩请求独有的新行为,只由 opts.maxTokens 触发) */
    if (opts && opts.maxTokens > 0) body.max_tokens = Math.round(opts.maxTokens);
    applyReasoningEffort(body, "openai");
    applyToolsToBody(body, "openai", c);
  } else {
    body.messages = normalizeAnthropic(wire);
    body.max_tokens = maxTokensFor("anthropic");
    body.stream = !!stream;
    if (sys) body.system = sys;
    applySampling(body, "anthropic");
    if (opts && opts.maxTokens > 0) body.max_tokens = Math.round(opts.maxTokens);
    applyReasoningEffort(body, "anthropic");
    applyToolsToBody(body, "anthropic", c);
  }
  return body;
}
function endpointFor() {
  return state.settings.protocol === "openai" ? apiUrl("chat/completions") : apiUrl("messages");
}
function createSSEParser(onEvent) {
  var buf = "";
  function emit(block) {
    var lines = block.split("\n"), data = [];
    for (var j = 0; j < lines.length; j++) {
      var ln = lines[j];
      if (!ln || ln.charAt(0) === ":") continue;
      if (ln.indexOf("data:") === 0) data.push(ln.slice(5).replace(/^ /, ""));
    }
    if (data.length) onEvent(data.join("\n"));
  }
  return function (chunk, isFinal) {
    if (chunk) buf += chunk.replace(/\r\n/g, "\n").replace(/\r/g, "\n");
    var parts = buf.split("\n\n");
    buf = parts.pop();
    for (var i = 0; i < parts.length; i++) emit(parts[i]);
    if (isFinal && buf.trim()) { emit(buf); buf = ""; }
  };
}

/* 发送按钮(无参):一律由 genCur() 派生 —— 它作用的是「当前查看的会话」 */
function updateSendButton() {
  var g = genCur();
  elSend.classList.toggle("stop", !!g);
  elSend.innerHTML = icon(g ? "stop" : "send");
  elSend.title = g ? "停止生成(Ctrl+X)"
    : (genCount() > 0 ? "发送(Enter)(其他会话仍在生成)" : "发送(Enter)");
  elSend.setAttribute("aria-label", g ? "停止生成" : "发送");
}
/* 停止生成:只作用于**当前查看的会话**(G5)。Ctrl+X / Ctrl+Esc / 发送按钮共用一个入口 */
function stopGenerating() {
  if (!conv || !genOn(conv.id)) return;
  abortGen(conv.id, "用户停止生成");
  /* D-5 裁决:停止生成**不杀**后台 Python 任务(任务继续跑、产物照常回写工作区);
     任务的中止只有一条手动收口 = 任务弹窗(/tasks),这里只如实告知 */
  if (typeof pvRunningList === "function" && pvRunningList().length) {
    toast("已停止本次生成;后台 Python 任务仍在运行(可在任务弹窗 /tasks 里停止)", "info", 4200);
  }
}

async function sendMessage(text, opts) {
  opts = opts || {};
  /* 走到这里文字 / 附件已在调用方手上(编辑、重发、工具回填等),不能被清草稿动作清掉 */
  if (!conv && !newConversation({ keepDraft: true })) { if (opts.bufItem) sqRestoreBuf(opts.bufItem); return; }
  /* 这一轮的归宿:生成期间允许切走会话(selectConv 会改写模块级 conv),收尾一律落到
     **发起这次生成时**那条会话上(见 finally 与 commit 的第二参数)。
     派生链 = 显式目标 > 缓冲条目归属 > 当前会话:自动续跑(pvNotifyCheck)必须走显式目标 ——
     它在"用户已切走"之后才发起,只认当前会话会把 A 的完成回流发进 B(缺陷 D / I12)。
     注:入口忙碌门必须在派生**之后**才成立(实现注记 S-6) */
  var sendConvId = (opts.targetConvId && getConv(opts.targetConvId)) ? opts.targetConvId
    : ((opts.bufItem && opts.bufItem.convId && getConv(opts.bufItem.convId)) ? opts.bufItem.convId : conv.id);
  /* 防重入:按**发起会话**判 —— 别的会话在生成不挡这一条(超限/异常由 genNew 的 !g 分支兜底:
     转缓冲或如实拒绝,不静默丢消息) */
  if (genOn(sendConvId)) { if (opts.bufItem) sqRestoreBuf(opts.bufItem); return; }
  function sendTarget() { return getConv(sendConvId) || conv; }
  /* commit / finishRoundStats 必须在**函数级作用域**里声明(整体 IIFE 是 "use strict" ⇒ 块内
     函数声明只属于那个块):catch / finally 在 try 块之外也要调用它们(收尾链)。 */
  /* target 缺省 = 当前会话;收尾按「发起这次生成时」那条会话传进来(用户可能在生成期间切走)。
     返回值 = 是否真的写回目标:未命中(目标里已经没有这条消息)时调用方据此如实提示 */
  function commit(msg, target) {
    /* target / conv 为 null = 这条会话在生成期间被收敛/整库替换拿走了(见 finally 里的兜底说明):
       这里再取一次空值兜底,免得 catch 分支的 commit 先抛、把真正的报错也顶掉 */
    var c = target || conv;
    if (!msg || !c) return false;
    var i = -1;
    for (var k = 0; k < c.messages.length; k++) if (c.messages[k].id === msg.id) { i = k; break; }
    if (i < 0) return false;
    c.messages[i] = msg;
    return true;
  }
  /* 一轮结束:算时长、token、速度,并按实测反推估算系数 */
  function finishRoundStats() {
    asst.streaming = false;
    var dur = (Date.now() - startedAt) / 1000;
    asst.duration = dur;
    /* token 数:只认服务端 usage;取不到才按文本长度估算并标 ≈ */
    if (asst.tokens == null) {
      var estTok = estimateTokens(contentToText(asst.content)) + estimateTokens(asst.reasoning || "");
      if (estTok > 0) { asst.tokens = estTok; asst.exactTokens = false; }
    }
    /* 速度:用客户端实测的「首字 → 最后一帧」吞吐 —— 这才是用户真正感知到的输出速度。
       不用服务端 timings.predicted_per_second:它只覆盖纯解码窗口,
       不含首字延迟与 prompt 处理,数值会明显偏高(实测服务端自称 82,端到端只有 71)。 */
    var decodeSec = (firstTokenAt && lastTokenAt > firstTokenAt)
      ? (lastTokenAt - firstTokenAt) / 1000 : 0;
    if (decodeSec < 0.3) decodeSec = dur;
    if (asst.tokens != null && decodeSec > 0.05) {
      asst.speed = asst.tokens / decodeSec;
      asst.exactSpeed = !!asst.exactTokens;
    } else if (!asst.speed) {
      asst.speed = null;
      asst.exactSpeed = false;
    }
    asst.thinkMs = firstTokenAt ? (firstTokenAt - startedAt) : asst.thinkMs;
    /* 用这次服务端给的真实 token 数,反推「字符→token」的偏差倍数并按模型记住 */
    if (asst.exactTokens && asst.tokens > 20 && (estCjk + estLatin + estDigit + estSym) > 0 && asst.model) {
      var rawEst = estCjk * TOK_PER_CJK + estLatin * TOK_PER_LATIN +
        estDigit * TOK_PER_DIGIT + estSym * TOK_PER_SYM;
      if (rawEst > 10) {
        var k = asst.tokens / rawEst;
        if (k > 0.4 && k < 2.5) {
          var prevK = tokCalibFor(asst.model) === 1 ? 0 : tokCalibFor(asst.model);
          var newK = prevK ? (prevK * 0.5 + k * 0.5) : k;
          if (!state.settings.tokCalib || typeof state.settings.tokCalib !== "object") state.settings.tokCalib = {};
          state.settings.tokCalib[asst.model] = newK;
        }
      }
    }
  }
  var model = effectiveModel().trim();
  if (!model) {
    toast("请先选择或输入模型名称", "warn");
    openSettings("model");
    if (opts.bufItem) sqRestoreBuf(opts.bufItem);
    return;
  }
  if (!apiUrl("")) {
    toast("请先在设置中填写 Base URL", "warn");
    openSettings("model");
    if (opts.bufItem) sqRestoreBuf(opts.bufItem);
    return;
  }
  var useStream = !!state.settings.stream && CAP.stream;

  /* 先立刻进入「生成中」状态(注册表记录),再去做磁盘活 ——
     否则等 IndexedDB 的那几十毫秒里,界面还是「可以再点一次发送」的样子。
     ctrl 的创建点就在 genNew 这一拍(不再是首次请求前):压缩窗口内按 Ctrl+X 也必须可中止 */
  var g = genNew(sendConvId);
  if (!g) {
    /* 并发已达上限(D-1=B):转入该会话的待发送缓冲,等任一会话收尾后由 genDrop 的唤醒补发。
       带附件 / 重生成 / 自动续跑这类无法入缓冲的路径:如实拒绝并保全用户内容(不静默丢)。
       注:doSend 恒传 `files`(可能为空数组)⇒ 判据看**实际长度**,不是字段存在性 */
    var hadFiles = !!(opts.files && opts.files.length);
    if (opts.bufItem) sqRestoreBuf(opts.bufItem);
    else if (text && !hadFiles && !opts.skipUserMsg && !opts.intoMsg && !opts.history && sqPush(sendConvId, text)) {
      sqRender();
      toast("并发会话已达上限,本条消息已转入待发送,待空出槽位后自动发送", "info", 5200);
    } else if (text && hadFiles && !opts.skipUserMsg && !opts.intoMsg && !opts.history) {
      elInput.value = text;
      draftFiles = opts.files.slice();
      renderAttachBar();
      autoResize();
      updateCtxMeter();
      toast("并发会话已达上限,本条消息未发送(草稿已还回输入框)", "warn", 5200);
    } else {
      toast(opts.skipUserMsg ? "并发会话已达上限,本次自动续跑已推迟(提醒会随下一次请求带上)"
        : "并发会话已达上限,本条消息未发送", "warn", 5200);
    }
    updateSendButton();
    return;
  }
  var roundStarted = false;       /* 消息已落库 / asst 已建 ⇒ 收尾走完整链(R10 结构保证) */
  try {
    updateSendButton();
    syncParamInputs();

    /* 附件 payload 可能外置在 IndexedDB 里:先把这轮要用到的读回内存,再组装请求。
       这里传的是**发起时会话**的消息数组(此刻 conv 可能已被切走 —— 附件 hydrate 必须落回发起会话) */
    await hydrateAttachments((getConv(sendConvId) || conv).messages);
    if (opts.files) await externalizeFiles(opts.files);

    /* 这两次 await 也是"用户可能切走 / 删会话"的窗口(附件大时更长):按**发起这次生成时**的 id
       重取目标 —— 下面所有写入(用户消息 / 助手占位 / updatedAt / 落盘)一律落它,落进"当前会话"
       就是往另一条会话里塞内容。目标确已消失(被删 / 被整库替换拿走)时**收手**:这条消息根本
       不发出去,如实告知(finally 的 genDrop 会解开「生成中」,不留幽灵) */
    var tf = getConv(sendConvId);
    if (!tf) {
      genDrop(sendConvId);                             /* 先复位再回队:放回时的 hint 依赖该顺序 */
      if (opts.bufItem) sqRestoreBuf(opts.bufItem);    /* 缓冲消息回队首:一定不丢文本 */
      toast("这条对话已被清空或删除,本条消息没有发送", "warn", 5000);
      return;
    }

  /* ---- 上下文压缩:本 turn 的自动压缩计数复位 + 发送前自动压缩 ----
     压缩自持 CX_RUN.ctrl(整段运行的运行级 ctrl);本轮请求的中断器已在 genNew 建好 ⇒
     这个窗口里按 Ctrl+X 两条都会被中止(abortGen → ctrl.abort + cxAbortActiveOf,见 §7.6 V-1)。
     重生成 / 编辑重发路径(opts.history)按历史截取组装请求,不做自动压缩 */
  g.regen = !!opts.history;
  if (!opts.history) {
    cxLedger(tf.id).round = 0;
    cxLedger(tf.id).ovfCount = 0;      /* U-4 借鉴-1:溢出恢复额度与 round 同一处按 turn 复位 */
    if (cxEnabled()) {
      var pre = await cxAutoBeforeSend(tf);
      if (pre && pre.code === "ECOMPACT_ABORT") {
        /* 缓冲消息不经输入框:先复位记录再放回队首 —— sqRestoreBuf 内部 sqRender 的 hint
           依赖该顺序(否则短暂显示"下一轮工具结果后自动发送"的残留态);非缓冲路径仍走下面"草稿还回输入框" */
        if (opts.bufItem) {
          genDrop(sendConvId);
          sqRestoreBuf(opts.bufItem);
          toast("已取消:压缩被中止,本条消息未发送(已放回待发送队列)", "info", 4200);
          return;
        }
        /* 用户按 Ctrl+X 取消了这次压缩 ⇒ **放弃本次发送**(否则"停不掉的压缩 + 照发"是最坏的组合)。
           草稿必须还回去:doSend 在调 sendMessage 之前就清空了 elInput / draftFiles,而且不 await 它 ——
           不还就等于把用户的正文与附件吞掉。自动续跑路径(skipUserMsg)下 text === null,
           那条路径**不能**碰输入框/附件条(用户此刻可能正在打字) */
        genDrop(sendConvId);
        setConnFor(sendConvId, "ok", "已连接");
        if (text) {
          elInput.value = text;
          draftFiles = opts.files || [];
          renderAttachBar();
          autoResize();
          updateCtxMeter();
          focusInput();
          toast("已取消:压缩被中止,本条消息未发送(草稿已还回输入框)", "info", 4200);
        } else {
          toast("已取消:压缩被中止,本条消息未发送", "info", 4200);
        }
        return;
      }
    }
  }

  /* 发送冲突:手动压缩正在跑 ⇒ 中止它并如实登记(不阻塞本次发送) */
  if (pre && pre.code === "ECOMPACT_BUSY" && CX_RUN.phase !== "idle" && CX_RUN.source === "manual" &&
      CX_RUN.convId === tf.id) {
    cxAbortActive("用户发送新消息");
    cxFailRecord(tf.id, "ECOMPACT_BUSY", "cancelledBySend", "你发送了新消息,正在进行的压缩已中止", "manual", "", 0);
  }

  var userContent = opts.skipUserMsg ? null : buildUserContent(text, opts.files);
  if (!opts.skipUserMsg) {
    tf.messages.push({ id: uid(), role: "user", content: userContent, createdAt: Date.now() });
    tf.updatedAt = Date.now();
    autoTitle(tf.id);
    /* 用户真实发了一条消息 → 空闲自动续跑的连续次数复位(重新生成与自动续跑不算) */
    if (typeof pvAutoLoopReset === "function") pvAutoLoopReset(tf.id);
  }
  var asst;
  /* 这一轮生成里所有消息(工具调用轮 / 工具结果 / 后续正文)共用一个 turnId,
     渲染时会合并成同一个气泡、同一个头像 */
  var turnId = uid();
  if (opts.intoMsg) {
    /* 就地重新生成:复用已有消息与 DOM,清空后重新流式写入 */
    asst = opts.intoMsg;
    var oldTurn = asst.turnId;
    if (oldTurn) {
      /* 清掉上一次生成留下的工具消息,免得算进新的一轮 */
      tf.messages = tf.messages.filter(function (m) { return !(m.turnId === oldTurn && m.role === "tool"); });
    }
    asst.turnId = turnId;
    asst.toolCalls = null;
    asst.content = ""; asst.reasoning = ""; asst.error = null;
    asst.streaming = true; asst.stopped = false; asst.truncated = false;
    asst.finishReason = null; asst.tokens = null; asst.speed = null;
    asst.duration = null; asst.thinkMs = null;
    asst.exactTokens = false; asst.exactSpeed = false;
    asst.model = model; asst.createdAt = Date.now();
    asst.reasoningOpen = true;
  } else {
    asst = {
      id: uid(), role: "assistant", content: "",
      model: model, createdAt: Date.now(), streaming: true, turnId: turnId
    };
    tf.messages.push(asst);
  }
  tf.updatedAt = Date.now();
  trimConversation(tf);
  saveState(true);
  /* 视图只在"发起会话此刻就是当前会话"时才动:切走时只写数据,免得聊天区显示原会话、
     侧栏却高亮另一条(后续每一帧的流式重绘都靠下面的 curMsgEl —— 不在当前会话上就给 null,走安全空路径) */
  if (tf === conv) {
    renderChat();
    scrollToBottom(true);
    updateCtxMeter();
  }

  /* 流式气泡元素**每帧重解**(不再是发起时的一次性快照 —— 切走再切回后旧快照已离开 DOM,
     会造成"切回后气泡冻结";复用既有 msgElementFor,外面套"仅发起会话 = 当前视图"的守卫)。
     仅在需要绘帧时解析,缓存只作同帧去重(元素被重绘替换后 contains 为假 ⇒ 自动重解) */
  var msgElCache = null, msgElCacheId = "";
  function curMsgEl() {
    if (sendConvId !== conv.id) { msgElCache = null; msgElCacheId = ""; return null; }
    if (msgElCache && msgElCacheId === asst.id && document.body.contains(msgElCache)) return msgElCache;
    msgElCacheId = asst.id;
    msgElCache = msgElementFor(asst.id);
    return msgElCache;
  }
  var ctrl = g.ctrl;
  var startedAt = Date.now();
  var firstTokenAt = 0, lastTokenAt = 0;
  var estCjk = 0, estLatin = 0, estDigit = 0, estSym = 0, tokEst = 0;
  var srvPredSpeed = 0;    // 服务端自称的解码速度(只用于排查展示,不参与主数字)
  var srvPredictedN = 0;
  var promptTokens = null; // 服务端给出的 prompt token 数(上下文真实用量)
  var cachedTokens = null; // 其中命中缓存的 token 数(prompt_tokens_details.cached_tokens)
  var roundFinish = "";    // 本次请求的 finish_reason / stop_reason
  var turnCalls = [];      // 流式期间累积的 tool_calls
  var SPEED_WIN_MS = 3000;     // 滑动窗口 3 秒(离线对比过 2/3/5/10s,见 README)
  var SPEED_MIN_SPAN = 1500;   // 窗口内至少攒够 1.5 秒样本才用「窗口速率」
  var SPEED_EMA = 0.15;        // 指数平滑系数
  var speedWin = [], smoothSpeed = 0, lastSpeedAt = 0;
  var calibK = tokCalibFor(model);   // 该模型上一次实测反推的换算倍数

  /* 每一轮(一次请求)开始前把本轮的统计量清零 */
  function resetRound() {
    startedAt = Date.now();
    firstTokenAt = 0; lastTokenAt = 0;
    estCjk = 0; estLatin = 0; estDigit = 0; estSym = 0; tokEst = 0;
    srvPredSpeed = 0; srvPredictedN = 0;
    promptTokens = null; cachedTokens = null; roundFinish = "";
    turnCalls = [];
    speedWin = []; smoothSpeed = 0; lastSpeedAt = 0;
  }
  /* 流式期间按字符累计再折算 token。
     逐个 chunk 调 estimateTokens 会因为 Math.ceil 把每个小碎片都进位,总量偏高 20% 以上。 */
  function addEstimate(text) {
    var cs = countScript(text);
    estCjk += cs[0]; estLatin += cs[1]; estDigit += cs[2]; estSym += cs[3];
    tokEst = (estCjk * TOK_PER_CJK + estLatin * TOK_PER_LATIN +
              estDigit * TOK_PER_DIGIT + estSym * TOK_PER_SYM) * calibK;
  }

  setConnFor(sendConvId, "busy", "请求中…");

  function touch() {
    var now = Date.now();
    if (!firstTokenAt) {
      firstTokenAt = now;
      asst.thinkMs = firstTokenAt - startedAt;
    }
    lastTokenAt = now;
    speedWin.push({ t: now, tok: tokEst });
    var cut = now - SPEED_WIN_MS;
    while (speedWin.length > 4 && speedWin[0].t < cut) speedWin.shift();
    if (now - lastSpeedAt < 200) return;   // 限频:最多每 200ms 重算一次
    lastSpeedAt = now;
    if (sendConvId === conv.id) updateCtxMonitor();   // 输入区用量环:只服务当前视图(I4)
    var r = windowSpeed(now);
    if (r != null) {
      smoothSpeed = smoothSpeed > 0 ? (smoothSpeed * (1 - SPEED_EMA) + r * SPEED_EMA) : r;
      asst.speed = smoothSpeed;
    }
  }
  /* 速度估计:
     1) 窗口内样本做最小二乘拟合,斜率即 tokens/ms。
        比「首尾两点相减」稳得多 —— llama.cpp 会把多个 token 合并进一个 chunk,
        首尾取样很容易落在突发块的边界上,读数就会几十个百分点地跳。
     2) 样本还不够长时,退回「首字之后的累计平均」,并且太早(不足 1.5s)先不出数,
        免得开头第一个大块把速度顶到很高。 */
  function windowSpeed(now) {
    var n = speedWin.length;
    if (n < 3) return null;
    if ((speedWin[n - 1].t - speedWin[0].t) >= SPEED_MIN_SPAN) {
      var t0 = speedWin[0].t, sx = 0, sy = 0, sxx = 0, sxy = 0, i, x;
      for (i = 0; i < n; i++) {
        x = speedWin[i].t - t0;          // 用相对时间,避免大数相减丢精度
        sx += x; sy += speedWin[i].tok; sxx += x * x; sxy += x * speedWin[i].tok;
      }
      var den = n * sxx - sx * sx;
      if (den > 0) {
        var slope = (n * sxy - sx * sy) / den;   // tokens / ms
        if (slope > 0) return slope * 1000;
      }
    }
    var sinceFirst = firstTokenAt ? (now - firstTokenAt) / 1000 : 0;
    if (sinceFirst < 1.5) return null;
    return tokEst / sinceFirst;
  }
  /* 个别服务端不认 stream_options / tools;被拒时去掉相应字段重试一次 */
  async function doFetch(b) {
    var r = await fetch(endpointFor(), {
      method: "POST", headers: headersFor(), body: JSON.stringify(b), signal: ctrl.signal
    });
    function strip(srcBody, keys) {
      var o = {};
      for (var k in srcBody) {
        if (Object.prototype.hasOwnProperty.call(srcBody, k) && keys.indexOf(k) === -1) o[k] = srcBody[k];
      }
      return o;
    }
    if (!r.ok && b && b.stream_options && (r.status === 400 || r.status === 422 || r.status === 500)) {
      try { await r.text(); } catch (e) {}
      r = await fetch(endpointFor(), {
        method: "POST", headers: headersFor(),
        body: JSON.stringify(strip(b, ["stream_options"])), signal: ctrl.signal
      });
    }
    if (!r.ok && b && b.tools && b.tools.length
        && [400, 404, 405, 422, 500, 501].indexOf(r.status) > -1) {
      try { await r.text(); } catch (e) {}
      var b2 = strip(b, ["tools", "tool_choice"]);
      var r2 = await fetch(endpointFor(), {
        method: "POST", headers: headersFor(), body: JSON.stringify(b2), signal: ctrl.signal
      });
      if (r2.ok) {
        toast("服务端不支持工具调用(tools 被拒),本次已去掉工具重试", "warn", 5000);
        toolLogPush("err", "服务端拒绝 tools 参数,本次请求已降级为无工具模式");
        return r2;
      }
      return r2;
    }
    return r;
  }

  /* 跑一轮:发一次请求,把结果写进 asst,返回本轮请求的工具调用 */
  async function runTurn(list) {
    resetRound();
    /* 上下文部分(system / 工作区 / 工具集)按**发起这次生成时**那条会话来组装 —— 生成期间
       用户可能已经切走,模块级 conv 已是另一条:buildBody 缺省读它就会把两套会话口径混进
       同一份请求(消息历史走 list/tf,目标走 sendTarget();目标已消失时退回当前会话,
       与"收手前的最后一轮"一致) */
    var body = buildBody(list, model, useStream, sendTarget(), mediaOff ? { noToolMedia: true } : undefined);
    var res = await doFetch(body);
    if (!res.ok) {
      var detail = "";
      try {
        var j = await res.json();
        detail = (j.error && (j.error.message || j.error.type)) || j.message || safeJson(JSON.stringify(j), 300);
      } catch (e2) {
        try { detail = safeJson(await res.text(), 300); } catch (e3) { detail = ""; }
      }
      var he = new Error("HTTP " + res.status + (detail ? ":" + detail : ""));
      he.__httpStatus = res.status;   /* cxIsOverflowError 的判据来源(溢出恢复据此触发) */
      throw he;
    }
    /* 后台任务完成通知的提交时点**不在这里**:2xx 只说明响应头回来了,服务端完全可能先回 200、
       再在 SSE 流里发 {"error":…}(页面会先 commit、后解析抛错 ⇒ 通知被当成"模型收到过"而吞掉)。
       真正的提交点放在本轮**解析成功**之后(函数末尾,流正常收尾 / 非流式 JSON 解析 + 内容检查都过了)。 */

    if (!useStream) {
      /* 先落「非流式」标记:后面的解析/取字段若抛错,这条回复也不会被当成「生成中」 */
      asst.streaming = false;
      var jr = await res.json();
      if (state.settings.protocol === "openai") {
        var ch = (jr.choices && jr.choices[0]) || {};
        var m0 = ch.message || {};
        asst.content = typeof m0.content === "string" ? m0.content : contentToText(m0.content);
        asst.reasoning = m0.reasoning_content || m0.reasoning || "";
        asst.tokens = jr.usage && jr.usage.completion_tokens;
        asst.exactTokens = asst.tokens != null;
        if (jr.usage && jr.usage.prompt_tokens != null) promptTokens = jr.usage.prompt_tokens;
        if (jr.usage && jr.usage.prompt_tokens_details && jr.usage.prompt_tokens_details.cached_tokens != null) {
          cachedTokens = jr.usage.prompt_tokens_details.cached_tokens;
        }
        if (jr.timings && jr.timings.predicted_per_second) srvPredSpeed = jr.timings.predicted_per_second;
        if (jr.timings && jr.timings.predicted_n != null) srvPredictedN = jr.timings.predicted_n;
        asst.truncated = asst.truncated || ch.finish_reason === "length";
        roundFinish = ch.finish_reason || "";
        /* 非流式响应的 tool_calls[] 里每项都是完整调用、不带 index —— 不按数组下标补的话,
           一条消息里的多个调用会全部落进 collectToolCalls 的 slot 0 被拼成一个
           (流式分片自带 index,不受影响)。纯文本回复不带这个字段 */
        if (m0.tool_calls) {
          m0.tool_calls.forEach(function (tc, i) { if (tc && typeof tc.index !== "number") tc.index = i; });
          collectToolCalls(m0.tool_calls);
        }
      } else {
        /* 有的兼容代理会把 content 直接给成字符串(协议上应是块数组);不做这层归一的话
           下面三处 (jr.content || []).filter/forEach 会抛 TypeError,整条回复变成「请求失败」 */
        var cbs = Array.isArray(jr.content) ? jr.content
          : (typeof jr.content === "string" ? [{ type: "text", text: jr.content }] : []);
        asst.content = cbs.filter(function (b) { return b && b.type === "text"; })
          .map(function (b) { return b.text || ""; }).join("");
        asst.reasoning = cbs.filter(function (b) { return b && b.type === "thinking"; })
          .map(function (b) { return b.thinking || ""; }).join("");
        asst.tokens = jr.usage && jr.usage.output_tokens;
        asst.exactTokens = asst.tokens != null;
        if (jr.usage && jr.usage.input_tokens != null) promptTokens = jr.usage.input_tokens;
        if (jr.usage && jr.usage.cache_read_input_tokens != null) cachedTokens = jr.usage.cache_read_input_tokens;
        asst.truncated = asst.truncated || jr.stop_reason === "max_tokens";
        roundFinish = jr.stop_reason || "";
        cbs.forEach(function (b) {
          if (b && b.type === "tool_use") {
            turnCalls.push({ id: b.id || "", name: b.name || "", argsText: JSON.stringify(b.input || {}) });
          }
        });
      }
      asst.model = jr.model || model;
      asst.streaming = false;
      commit(asst, sendTarget());     /* 写回发起这次生成的那条会话(生成期间可能已切走) */
      paintMsg(curMsgEl());
    } else {
      var acc = "", accReason = "";
      var reader = res.body.getReader();
      var decoder = new TextDecoder("utf-8");
      var anthropicBlock = null;
      var parser = createSSEParser(function (dataStr) {
        if (dataStr === "[DONE]") return;
        var j;
        try { j = JSON.parse(dataStr); } catch (e) { return; }
        if (j.error) throw new Error((j.error && j.error.message) || "服务端返回错误");
        if (j.type === "error") throw new Error((j.error && j.error.message) || "服务端返回错误");
        if (state.settings.protocol === "openai") {
          var choice = (j.choices && j.choices[0]) || {};
          var d = choice.delta || {};
          var r = d.reasoning_content || d.reasoning;
          if (r) { accReason += r; addEstimate(r); touch(); }
          if (typeof d.content === "string" && d.content) { acc += d.content; addEstimate(d.content); touch(); }
          else if (Array.isArray(d.content)) {
            d.content.forEach(function (p) { if (p && p.type === "text" && p.text) { acc += p.text; addEstimate(p.text); } });
            touch();
          }
          if (d.tool_calls) collectToolCalls(d.tool_calls);
          if (choice.finish_reason) roundFinish = choice.finish_reason;
          if (j.model) asst.model = j.model;
          if (j.usage && j.usage.completion_tokens != null) {
            asst.tokens = j.usage.completion_tokens;
            asst.exactTokens = true;
          }
          if (j.usage && j.usage.prompt_tokens != null) promptTokens = j.usage.prompt_tokens;
          if (j.usage && j.usage.prompt_tokens_details && j.usage.prompt_tokens_details.cached_tokens != null) {
            cachedTokens = j.usage.prompt_tokens_details.cached_tokens;
          }
          if (j.timings && j.timings.predicted_per_second) srvPredSpeed = j.timings.predicted_per_second;
          if (j.timings && j.timings.predicted_n != null) srvPredictedN = j.timings.predicted_n;
          if (j.timings && j.timings.predicted_n != null && !asst.exactTokens) {
            asst.tokens = j.timings.predicted_n; asst.exactTokens = true;
          }
        } else {
          if (j.type === "message_start" && j.message) {
            if (j.message.model) asst.model = j.message.model;
            if (j.message.usage && j.message.usage.output_tokens != null) asst.tokens = j.message.usage.output_tokens;
          } else if (j.type === "content_block_start" && j.content_block) {
            /* Anthropic 的工具调用:content_block_start 给 id / name,后面用 input_json_delta 拼参数 */
            if (j.content_block.type === "tool_use") {
              anthropicBlock = { id: j.content_block.id || "", name: j.content_block.name || "", argsText: "" };
              turnCalls.push(anthropicBlock);
            } else anthropicBlock = null;
          } else if (j.type === "content_block_delta") {
            var dd = j.delta || {};
            if (dd.type === "text_delta" && dd.text) { acc += dd.text; addEstimate(dd.text); touch(); }
            else if (dd.type === "thinking_delta" && dd.thinking) { accReason += dd.thinking; addEstimate(dd.thinking); touch(); }
            else if (dd.type === "input_json_delta" && anthropicBlock) {
              anthropicBlock.argsText += (dd.partial_json || "");
            }
          } else if (j.type === "content_block_stop") {
            anthropicBlock = null;
          } else if (j.type === "message_delta") {
            if (j.delta && j.delta.stop_reason) roundFinish = j.delta.stop_reason;
            if (j.usage && j.usage.output_tokens != null) {
              asst.tokens = j.usage.output_tokens;
              asst.exactTokens = true;
            }
            if (j.usage && j.usage.input_tokens != null) promptTokens = j.usage.input_tokens;
            if (j.usage && j.usage.cache_read_input_tokens != null) cachedTokens = j.usage.cache_read_input_tokens;
          }
        }
        asst.content = acc;
        asst.reasoning = accReason;
        commit(asst, sendTarget());     /* 每帧都按发起会话写回,切走后也落在原会话上 */
        scheduleRender(curMsgEl());     /* 每帧重解元素:切回当前会话后气泡继续增长(缺陷 A 的修法) */
      });

      while (true) {
        var rd = await reader.read();
        if (rd.done) break;
        parser(decoder.decode(rd.value, { stream: true }));
      }
      parser(decoder.decode(), true);
      asst.content = acc;
      asst.reasoning = accReason;
      asst.streaming = false;
      if (roundFinish === "length" || roundFinish === "max_tokens") asst.truncated = true;
      else if (roundFinish && roundFinish !== "stop" && roundFinish !== "end_turn" && roundFinish !== "tool_calls"
        && roundFinish !== "tool_use") asst.finishReason = roundFinish;
      commit(asst, sendTarget());     /* 写回发起这次生成的那条会话(生成期间可能已切走) */
      paintMsg(curMsgEl());
    }

    if (!contentToText(asst.content).trim() && !asst.reasoning && !turnCalls.length) {
      throw new Error("服务端返回了空内容。可能是模型不支持当前请求格式,或上下文被截断。");
    }
    asst.error = null;
    setConnFor(sendConvId, "ok", "已连接");
    finishRoundStats();
    /* 本轮解析成功(流正常收尾 / 非流式 JSON 解析 + 内容检查都过了)⇒ 请求体里登记的后台任务
       完成通知才算"模型确实收到过"。失败/中止/流内报错都会走到外层 catch 的 pvNotifyRollback */
    pvNotifyCommit(sendConvId);
    return { calls: turnCalls };
  }
  /* OpenAI 的 tool_calls 是按 index 分片下发的,按片拼接 */
  function collectToolCalls(list) {
    if (!list) list = [];   // 服务端不带这个字段(纯文本回复)时按「没有工具调用」处理
    for (var i = 0; i < list.length; i++) {
      var tc = list[i] || {};
      var idx = (typeof tc.index === "number") ? tc.index : 0;
      var slot = turnCalls[idx];
      if (!slot) slot = turnCalls[idx] = { id: "", name: "", argsText: "" };
      if (tc.id) slot.id = tc.id;
      var fn = tc.function || {};
      if (fn.name) slot.name += fn.name;
      if (typeof fn.arguments === "string") slot.argsText += fn.arguments;
      else if (fn.arguments && typeof fn.arguments === "object") slot.argsText += JSON.stringify(fn.arguments);
    }
    /* 过滤掉只有空壳的项 */
    turnCalls = turnCalls.filter(function (c) { return c && c.name; });
  }

  /* 消息已落库、asst 占位已建:从这里起收尾走完整链(R10 结构保证:genDrop 必被覆盖) */
  roundStarted = true;
  /* 请求体的消息历史也按**发起时会话**取:这两个 await 之后用户可能已经切走,
     payloadMessages() 缺省读的是模块级 conv(= 当前会话)—— 那会把另一条会话的历史发出去。
     工具轮之后的续答走 msgList(本地累积),不受这里影响 */
  var payload = payloadMessages(opts.history || tf.messages);
  var msgList = payload.list.slice();
  asst.truncated = payload.truncated;
    /* 结构类 4xx 降级开关(§3.4):本次 send 内生效,不落盘 —— 置 true 后本轮的请求体不再带工具媒体 */
    var mediaOff = false;
    toolBeginTurn(sendConvId);
    while (true) {
      toolBeginTurn(sendConvId);       // 「每轮最多调用次数」按轮计(记在**该会话**的 GEN 记录上)
      /* 轮次之间:上下文已经接近窗口上限就自动压缩一次(关着就整段跳过) */
      if (!opts.history && !opts.intoMsg) {
        var btw = await cxAutoBetweenRounds(getConv(sendConvId) || tf);
        if (btw && btw.compacted) {
          /* 压缩把 conv.messages 换掉了(splice + 重插),本地 msgList 必须**重建** ——
             它不是 conv.messages 的别名,而是 payload 出来的本地对象数组 */
          var pmB = payloadMessages((getConv(sendConvId) || tf).messages);
          msgList = pmB.list.slice();
          asst.truncated = pmB.truncated;
        }
      }
      var turn;
      try {
        turn = await runTurn(msgList);
      } catch (turnErr) {
        /* 溢出恢复:服务端报「上下文超长」→ 压缩一次 → 重跑本轮(本 turn 最多 1 次)。
           不是溢出错误就原样抛出,交给外层 catch 走既有失败路径 */
        var tgtOvf = getConv(sendConvId) || tf;
        if (cxIsOverflowError(turnErr) && await cxOverflowRecover(tgtOvf)) {
          var pmO = payloadMessages(tgtOvf.messages);
          msgList = pmO.list.slice();
          continue;
        }
        /* 结构类 4xx(该服务端不接受工具结果里的图片)⇒ **去掉 media 重试一次**(§3.4):
           工具文本照发,仅图片不随本次结果发送;整次 send 只此一次,不做次数循环。
           复位路径三条:自动降级(本次)/ 换模型或 visionForce:"no" / 删消息或压缩 */
        if (!mediaOff && isToolMediaStructureError(turnErr)) {
          var listHasMedia = false, mi0, mm0;
          for (mi0 = 0; mi0 < msgList.length; mi0++) {
            mm0 = msgList[mi0];
            if (mm0 && mm0.role === "tool" && mm0.media && mm0.media.length) { listHasMedia = true; break; }
          }
          if (listHasMedia) {
            mediaOff = true;
            toast("该服务端不接受工具结果中的图片,已去掉图片重试(文本结果照常发送)", "warn", 5000);
            toolLogPush("err", "服务端拒绝工具结果中的图片(结构类 4xx),本次已去掉图片重试");
            continue;
          }
        }
        throw turnErr;
      }
      var calls = turn.calls || [];
      if (!calls.length) break;
      /* 这一轮的产物就是「工具调用」:记在消息上,再逐个执行 */
      asst.toolCalls = calls.map(function (c) {
        return { id: c.id, name: c.name, argsText: c.argsText, args: parseToolArgs(c.argsText) };
      });
      commit(asst, sendTarget());
      genSetPhase(sendConvId, "tools");      /* 徽标:工具执行中(进入工具执行那一刻) */
      syncVariant(asst);
      msgList.push({ role: "assistant", content: asst.content, tool_calls: apiToolCalls(asst.toolCalls) });
      /* 工具轮里的每一次写入都落到**发起这次生成时**那条会话上(用户可能在生成期间切走:
         模块级 conv 已经是另一条会话了 —— 拿它 push 会让工具消息与续答落进别人的会话,
         视图重绘也只在"发起会话就是当前会话"时才做,免得聊天区与侧栏高亮对不上)。
         发起会话确已消失(被删 / 被整库替换拿走)时不再往"当前会话"里塞东西:收手,
         如实结果由 finally 统一给 —— 那里 commit 未命中会提示"本次回答没有保存" */
      var tf = getConv(sendConvId);
      if (!tf) break;
      /* 视图要不要动 = "发起会话此刻是不是当前会话"(每个重绘点各自重算:await 期间用户可能
         又切回来 —— 一次性算好的值会变陈旧,切回来的人就看不到工具卡片与新气泡的更新) */
      var lostTarget = false;
      if (tf === conv) redrawMessage(asst);
      for (var ci = 0; ci < asst.toolCalls.length; ci++) {
        var tc = asst.toolCalls[ci];
        var tmsg = {
          id: uid(), role: "tool", createdAt: Date.now(), turnId: turnId,
          toolName: tc.name, toolCallId: tc.id, argsText: tc.argsText, args: tc.args,
          status: "pending", content: ""
        };
        tf.messages.push(tmsg);
        /* 卡片要立刻出现在同一个气泡里:整组重绘一次(只在发起会话就是当前会话时才动视图) */
        if (tf === conv) { redrawMessage(asst); scrollToBottom(); }
        /* 工具执行也按**发起会话**归属(权限门 / 工作区 / Python 任务都读它,见 appE ctxConv):
           生成期间切走后,不能改成按"当前会话"执行或拒绝 */
        await toolRun({ id: tc.id, function: { name: tc.name, arguments: tc.argsText } }, tmsg, tf);
        /* 工具跑的时候会话也可能被删掉(await 之后重新确认一次):不再往下写、也不落盘 */
        if (!getConv(sendConvId)) { lostTarget = true; break; }
        saveState(true);
        msgList.push({
          role: "tool", content: tmsg.content || "工具未执行",
          tool_call_id: tmsg.toolCallId, name: tmsg.toolName,
          media: mediaOff ? undefined : tmsg.media
        });
      }
      /* ★ 工具触发的压缩唯一应用点:此刻本轮**所有**工具结果都已写入 tf.messages,
         所以 [Compact, 其它] 与 [其它, Compact] 两种顺序都不会把摘要插进
         「assistant(tool_calls)」与它的 tool 结果之间(协议配对安全)。
         ★ 必须 await:cxApplyPending 是 async,漏掉 await 时 ap.ok 恒 undefined ⇒
         不重建 msgList ⇒ 被"彻底删除"的消息会在余下每一轮继续发给模型 */
      var ap = await cxApplyPending(tf);
      if (ap && ap.ok) {
        var pmA = payloadMessages(tf.messages);
        msgList = pmA.list.slice();
        asst.truncated = pmA.truncated;
      }
      if (lostTarget) break;
      if (ctrl.signal.aborted) break;
      /* ★ 工具轮边界插入:生成期间入队的缓冲消息在「工具结果写入后、下一次模型请求前」
         逐条作为 user 消息补进会话 —— 下一轮请求立刻带上(中途补充需求)。
         没插到的(例如这是最后一轮)留在队里,由 finally 的 sqFlushAfterTurn 兜底发送 */
      sqInsertAtToolBoundary(sendConvId, tf, msgList);
      /* 继续生成:同一 turnId 的新助手消息,渲染时会并进同一个气泡 */
      asst = {
        id: uid(), role: "assistant", content: "", model: model,
        createdAt: Date.now(), streaming: true, turnId: turnId
      };
      tf = getConv(sendConvId);
      if (!tf) break;                       /* 工具轮跑完才发现会话没了:同样收手,交给 finally 如实提示 */
      tf.messages.push(asst);
      tf.updatedAt = Date.now();
      saveState(true);
      if (tf === conv) {
        renderChat();
        scrollToBottom(true);
      }
      /* 视图不在发起会话上时不动聊天区:后续流式重绘由 curMsgEl 每帧按当前视图重解(或给 null 走空路径) */
      setConnFor(sendConvId, "busy", "已回填工具结果,继续生成…");
    }
  } catch (err) {
    /* 走到这里说明这一轮请求没有成功(中止 / 网络错误 / 4xx):
       把在途的后台任务完成通知回滚成"未通知",下次请求会重新带上 ——
       否则一次失败(或请求还没发出去就被 Ctrl+X)就把完成回流信息永久吞掉。
       已经 2xx 过的那次提交是空集,这里重复调用无副作用 */
    pvNotifyRollback(sendConvId);
    if (!roundStarted) {
      /* 前置段(附件 hydrate / 压缩窗口)的意外异常:如实提示并回队,不留半截状态(R10 结构保证的后半) */
      if (opts.bufItem) sqRestoreBuf(opts.bufItem);
      toast("发送未能完成:" + friendlyError(err, endpointFor()), "error", 5200);
    } else if (err && err.name === "AbortError") {
      asst.stopped = true;
      commit(asst, sendTarget());
      setConnFor(sendConvId, "ok", "已连接");
      toast("已停止生成", "info", 1500);
    } else {
      asst.error = friendlyError(err, endpointFor()) +
        (mediaOff ? "\n可在 设置→模型 把该模型的图像能力设为\"不支持\"(或删除/压缩含图片的工具消息)后重试" : "");
      asst.streaming = false;
      commit(asst, sendTarget());
      setConnFor(sendConvId, "err", "请求失败");
      toast("请求失败:" + String(asst.error).split("\n")[0], "error", 4200);
    }
  } finally {
    /* 收尾唯一出口,必须是**第一句**:记录先消失,后面的 UI 刷新才能读到"不在生成"
       (I11 结构保证:进入 try 即已有记录;genDrop 会一并触发缓冲唤醒,返回是否已补发) */
    var wakeSent = genDrop(sendConvId);
    if (!roundStarted) {
      /* 前置段早退(目标会话消失 / 压缩被中止 / 意外异常):只复位按钮,不碰未建出的回合状态 */
      updateSendButton();
    } else {
    /* 兜底:正常路径已在 runTurn 里算过,这里只处理出错/中断的情形,重复调用无副作用 */
    finishRoundStats();
    var dur = asst.duration || ((Date.now() - startedAt) / 1000);
    syncVariant(asst);   // 本轮结果写回当前分支
    /* 用服务端真实 usage 记录上下文水位(输入/输出/缓存),供输入区用量环显示。
       目标会话显式传 sendConvId:读模块级 conv 会把读数记进"当前视图"(缺陷 B) */
    recordUsage(sendConvId, asst.model || model, promptTokens, asst.exactTokens ? asst.tokens : null, cachedTokens, asst.id);
    denyToolWaitsOf(sendConvId);       // 只拒**该会话**的等待项;别会话的放行卡不受影响(缺陷 C)
    updateSendButton();
    /* 这一轮的写回与落盘按**发起这次生成时**那条会话来(见 sendTarget):
       · 会话可能在生成期间被合并/整库替换拿了去(对侧删除 / 清空 → 见 mergeConvsByIdb);
       · 用户也可能在生成期间切走(selectConv 会改写模块级 conv)。
       旧代码拿 state.activeId 重取目标:切走后 conv 已是**另一条**会话 ⇒ commit(asst) 在那里
       找不到这条消息、静默 no-op,却照样把那条会话的 updatedAt 刷新成结束时刻 —— 组合
       「生成中切走 + 原会话被擦除」时就是静默丢答、连一句"没保存"都没有。
       模块级 conv 有意不动:渲染 / 后续操作继续跟着当前活动会话,免得聊天区与侧栏高亮对不上。
       目标确已消失(commit 未命中)时如实 toast —— 这次回答确实没落盘。 */
    var target = sendTarget();
    var saved = commit(asst, target);
    if (saved) target.updatedAt = Date.now();
    /* 生成结果必须落盘:否则刷新后只剩一个空的助手消息(saveState 落的是整份列表,含 target)。
       未命中也照落一次:这一轮可能在别的会话里留下了内容(工具消息 / 续答 / 中途落盘的改动),
       以及本轮学到的东西(例如 tokCalib 校准值);不落反而把这些一起丢了 */
    saveState(true);
    if (!saved) toast("这条对话已被清空或删除,本次回答没有保存", "warn", 5000);
    if (sendConvId === conv.id) cancelRender();   /* F:只清"当前视图"的待绘帧(别的会话收尾不得掐帧) */
    if (sendConvId === conv.id) renderChat();     /* I4:聊天区只重绘当前会话 */
    renderConvList();                             /* 徽标是全局重绘,任何时刻都要跟着记录同拍 */
    updateStorageMeter();
    LASTSTATS[sendConvId] = { tokens: asst.tokens, speed: asst.speed, duration: dur, model: asst.model,
                  exactTokens: asst.exactTokens, exactSpeed: asst.exactSpeed, promptTokens: promptTokens,
                  srvSpeed: srvPredSpeed, srvTokens: srvPredictedN };
    if (sendConvId === conv.id) {
      updateTopbar();        /* 顶栏 / 状态栏 / 用量环都是"当前视图"的读数(别的会话端不刷新) */
      updateCtxMeter();
      updateStatusBar();
    }
    if (asst.error) focusInput();
    /* 本轮归属结束:先 flush 本会话的缓冲(genDrop 的唤醒若已补发过 ⇒ 本次让位,一次收尾至多补一发);
       flush 内新 sendMessage 的同步段会按它自己的目标会话建记录,不受此处顺序影响 */
    sqFlushAfterTurn(sendConvId, wakeSent);
    /* 本轮生成已结束。若期间有后台任务跑完(且这一轮没机会注入),空闲时自动续跑一次(按**本会话**)。
       注意:上面若真发出了缓冲消息,此刻该会话已回到生成中 ⇒ 这里自然让位(不抢发) */
    try { pvNotifyCheck(sendConvId); } catch (e2) {}
    }
  }
}
/* ---- 分支(alternates):同一条助手消息可以有多个生成结果 ---- */
var VARIANT_FIELDS = ["content", "reasoning", "model", "createdAt", "tokens", "speed",
  "duration", "thinkMs", "stopped", "error", "truncated", "finishReason",
  "exactTokens", "exactSpeed", "toolCalls"];
function snapshotVariant(msg) {
  var v = {};
  for (var i = 0; i < VARIANT_FIELDS.length; i++) v[VARIANT_FIELDS[i]] = msg[VARIANT_FIELDS[i]];
  return v;
}
function applyVariant(msg, v) {
  for (var i = 0; i < VARIANT_FIELDS.length; i++) msg[VARIANT_FIELDS[i]] = v[VARIANT_FIELDS[i]];
  msg.streaming = false;
  msg.reasoningOpen = true;   // 切换分支时保持展开
}
function ensureAlts(msg) {
  if (!Array.isArray(msg.alternates)) { msg.alternates = [snapshotVariant(msg)]; msg.altIndex = 0; }
  return msg.alternates;
}
function syncVariant(msg) {
  if (!msg || !Array.isArray(msg.alternates)) return;
  var i = typeof msg.altIndex === "number" ? msg.altIndex : 0;
  if (i < 0 || i >= msg.alternates.length) return;
  msg.alternates[i] = snapshotVariant(msg);
}
function switchAlt(msg, dir) {
  if (genOn(conv && conv.id)) { toast("生成进行中,暂时无法切换分支", "warn"); return; }
  var n = Array.isArray(msg.alternates) ? msg.alternates.length : 0;
  if (n < 2) return;
  syncVariant(msg);
  msg.altIndex = ((msg.altIndex || 0) + dir + n) % n;
  applyVariant(msg, msg.alternates[msg.altIndex]);
  redrawMessage(msg);
  if (conv) conv.updatedAt = Date.now();
  renderConvList(); updateTopbar(); updateCtxMeter(); updateStorageMeter(); saveSoon();
  if (conv) LASTSTATS[conv.id] = { tokens: msg.tokens, speed: msg.speed, duration: msg.duration, model: msg.model,
                exactTokens: msg.exactTokens, exactSpeed: msg.exactSpeed };
  updateStatusBar();
  toast("分支 " + (msg.altIndex + 1) + " / " + n, "info", 1200);
}
/* 只重绘这一条消息(同一条 turnId 的整组合并重绘),避免整屏重排导致滚动位置丢失 */
function redrawMessage(msg) {
  var el = msgElementFor(msg.id);
  if (!el) { renderChat(); return; }
  var host = el.classList && el.classList.contains("msg") ? el : el.closest(".msg");
  if (!host || !host.parentNode) { renderChat(); return; }
  var group = conv ? groupOfMsg(msg.id) : null;
  /* 压缩产物有独立气泡(不是普通 user/assistant):重建时走同一条构造路径 */
  var fresh = msg.compact
    ? (msg.compact === "summary" ? makeCxCardEl(msg) : makeCompactEl(msg))
    : (group ? makeGroupEl(group) : makeMsgEl(msg, false, followingToolMsgs(msg)));
  host.parentNode.replaceChild(fresh, host);
}

/* 裁剪的目标会话可显式传进来:发消息时用户可能已经切走,那时要裁的是**发起时会话**而不是当前会话
   (默认仍取模块级 conv,其它调用点行为不变) */
function trimConversation(target) {
  var c = target || conv;
  if (!c) return;
  var over = c.messages.length - MAX_MSGS_PER_CONV;
  if (over > 0) {
    /* 丢弃区间走统一原语(收集附件键 + splice),再按全库引用重算释放 ——
       否则被裁掉的那些消息的附件会一直留在附件库里等下一次 gc 才回收 */
    var r = cxDropMessages(c, 0, over - 1);
    var p = cxReleasePlan(r.keys);
    if (p.todo.length) cxReleaseBlobs(p.todo);
  }
}

/* ---- 重试 / 重新生成 / 编辑 ---- */
/* 取该消息之前、以 user 结尾的历史(用于重新生成) */
function historyBefore(msg) {
  var idx = -1;
  for (var i = 0; i < conv.messages.length; i++) if (conv.messages[i].id === msg.id) { idx = i; break; }
  if (idx < 0) return null;
  var list = conv.messages.slice(0, idx);
  while (list.length && list[list.length - 1].role !== "user") list.pop();
  return list.length ? list : null;
}
function canSend() {
  if (!effectiveModel().trim()) {
    toast("请先选择或输入模型名称", "warn"); openSettings("model"); return false;
  }
  if (!apiUrl("")) { toast("请先在设置中填写 Base URL", "warn"); openSettings("model"); return false; }
  return true;
}
async function retryFromError(msg) {
  if (genOn(conv && conv.id) || !conv || !canSend()) return;
  var history = historyBefore(msg);
  if (!history) { toast("上下文不足,请重新发送问题", "warn"); return; }
  await sendMessage("", { skipUserMsg: true, intoMsg: msg, history: history });
}
async function regenerate(msg) {
  if (genOn(conv && conv.id) || !conv || !canSend()) return;
  var history = historyBefore(msg);
  if (!history) { toast("没有可重新生成的问题", "warn"); return; }
  /* 把当前结果存成一个分支,再就地新开一个空分支重新生成;
     后续消息不再被删除,可通过 ‹ n/N › 在分支间切换 */
  var alts = ensureAlts(msg);
  syncVariant(msg);
  alts.push({ content: "", reasoning: "", model: effectiveModel().trim(), createdAt: Date.now() });
  msg.altIndex = alts.length - 1;
  msg.content = ""; msg.reasoning = ""; msg.error = null; msg.truncated = false;
  msg.stopped = false; msg.reasoningOpen = true;
  await sendMessage("", { skipUserMsg: true, intoMsg: msg, history: history });
}
function startEdit(msgEl, msg) {
  if (genOn(conv && conv.id)) { toast("生成进行中,暂时无法编辑", "warn"); return; }
  var contentEl = msgEl.querySelector(".msg-body > .msg-content");
  if (!contentEl) return;
  /* 带附件的消息:文件 / 图片只能增删,内容不能改;文字部分照常编辑 */
  var parts = Array.isArray(msg.content)
    ? msg.content.slice()
    : [{ type: "text", text: contentToText(msg.content) }];
  var fileParts = [], textParts = [];
  for (var i = 0; i < parts.length; i++) {
    if (parts[i] && parts[i].attach) fileParts.push(parts[i]);
    else if (parts[i] && parts[i].type === "text") textParts.push(parts[i].text || "");
  }
  var box = document.createElement("div");
  box.className = "edit-box";
  box.innerHTML = '<div class="edit-files"></div>' +
    "<textarea></textarea>" +
    '<div class="edit-actions">' +
    '<button class="btn sm grow" data-edit="addfile">' + icon("clip", "sm") + " 添加附件</button>" +
    '<span class="edit-hint"><kbd>Ctrl</kbd>+<kbd>Enter</kbd> 保存</span>' +
    '<button class="btn primary sm" data-edit="save">保存并重新生成</button>' +
    '<button class="btn sm" data-edit="cancel">取消</button></div>' +
    '<input type="file" multiple style="display:none" />';
  contentEl.parentNode.replaceChild(box, contentEl);
  var ta = box.querySelector("textarea");
  ta.value = textParts.join("\n");
  autoGrow(ta);
  ta.addEventListener("input", function () { autoGrow(ta); });

  var filesBox = box.querySelector(".edit-files");
  var picker = box.querySelector('input[type="file"]');
  function renderFiles() {
    while (filesBox.firstChild) filesBox.removeChild(filesBox.firstChild);
    var seen = {};
    fileParts.forEach(function (p) {
      var a = p.attach || {};
      if (a.id && seen[a.id]) return;
      if (a.id) seen[a.id] = 1;
      var chip = document.createElement("span");
      chip.className = "edit-chip";
      chip.innerHTML = icon("file", "sm") +
        '<span class="ec-name" title="' + escAttr(a.name || "附件") + '">' + escapeHtml(a.name || "附件") +
        (a.kind === "image" ? "(图片)" : "") + "</span>" +
        '<button class="ec-rm" title="移除该附件" aria-label="移除该附件">' + icon("x", "sm") + "</button>";
      chip.querySelector(".ec-rm").addEventListener("click", function () {
        for (var k = fileParts.length - 1; k >= 0; k--) {
          var ia = fileParts[k].attach || {};
          if (ia.id === a.id) fileParts.splice(k, 1);
        }
        renderFiles();
      });
      chip.style.cursor = "pointer";
      chip.title = "点击预览";
      chip.addEventListener("click", function (e) {
        if (e.target && e.target.closest && e.target.closest(".ec-rm")) return;
        var texts = [], images = [];
        fileParts.forEach(function (q) {
          var ia = q.attach || {};
          if (ia.id !== a.id) return;
          if (q.type === "text" && q.text) texts.push(q.text);
          if (q.type === "image_url" && q.image_url) images.push(q.image_url.url);
          if (q.type === "image" && q.source) images.push("data:" + q.source.media_type + ";base64," + q.source.data);
        });
        previewAttachmentPayload(a, { texts: texts, images: images });
      });
      filesBox.appendChild(chip);
    });
  }
  renderFiles();
  box.querySelector('[data-edit="addfile"]').addEventListener("click", function () { picker.click(); });
  /* 编辑里的附件是异步的(办公文档解析、payload 外置进附件库):这一批**进 fileParts 之前**
     必须挡住「保存并重新生成」,否则刚挂上的附件会跟着这次编辑一起丢掉 */
  var pendingAdd = 0;
  picker.addEventListener("change", function () {
    var list = Array.prototype.slice.call(picker.files || []);
    picker.value = "";
    if (!list.length) return;
    var ids = {}, n = 0;
    fileParts.forEach(function (p) { if (p.attach && p.attach.id && !ids[p.attach.id]) { ids[p.attach.id] = 1; n++; } });
    var room = MAX_DRAFT_FILES - n - pendingAdd;
    if (room <= 0) { toast("一条消息最多 " + MAX_DRAFT_FILES + " 个附件", "warn", 3200); return; }
    list = list.slice(0, room);
    var pend = 0;
    list.forEach(function (f) { if (isOfficeExt(extOf(f.name))) pend++; });
    pendingAdd += list.length;
    if (pend) { toast("正在本机解析办公文档,解析完成前不能保存", "info", 3600); }
    Promise.all(list.map(function (f) {
      return prepareAttachment(f).then(function (a) { return a; },
        function (e) { toast(e.message || String(e), "error", 4200); return null; });
    }))
      .then(function (atts) {
        /* 与发送路径同构:新附件的 payload 先外置进附件库(externalizeFiles;成功才标记 ext,
           失败自动退回内联,不丢数据),再按外置结果组装部件 —— 不这么做的话,新挂的图片 /
           办公图像会把 base64 直接内联进这条消息记录,每次落盘都要重写这一大块 */
        var got = atts.filter(function (a) { return !!a; });
        return externalizeFiles(got).then(function () {
          atts.forEach(function (a) {
            if (!a) return;
            var ps = attachmentParts(a, state.settings.protocol);
            for (var k = 0; k < ps.length; k++) fileParts.push(ps[k]);
          });
          renderFiles();
        });
      })
      /* 占位在"部件真的进了 fileParts"之后才释放(失败路径同样释放,免得永久挡住保存) */
      .then(function () { pendingAdd = Math.max(0, pendingAdd - list.length); },
            function () { pendingAdd = Math.max(0, pendingAdd - list.length); });
  });

  ta.focus();
  try { ta.setSelectionRange(ta.value.length, ta.value.length); } catch (e) {}
  function save() {
    if (pendingAdd > 0) { toast("附件还在解析 / 写出中,请稍候再保存", "warn", 3200); return; }
    var v = ta.value.trim();
    if (!v && !fileParts.length) { toast("内容不能为空", "warn"); return; }
    /* 附件在前、文字在后 */
    var out = fileParts.slice();
    if (v) out.push({ type: "text", text: v });
    msg.content = (out.length === 1 && out[0].type === "text" && !out[0].attach) ? out[0].text : out;
    var idx = -1;
    for (var i2 = 0; i2 < conv.messages.length; i2++) if (conv.messages[i2].id === msg.id) { idx = i2; break; }
    conv.messages = conv.messages.slice(0, idx + 1);
    conv.updatedAt = Date.now();
    renderChat(); saveState(true);
    sendMessage("", { skipUserMsg: true });
  }
  box.querySelector('[data-edit="save"]').addEventListener("click", save);
  box.querySelector('[data-edit="cancel"]').addEventListener("click", function () { renderChat(); });
  ta.addEventListener("keydown", function (e) {
    if (e.key === "Enter" && (e.ctrlKey || e.metaKey)) { e.preventDefault(); save(); }
    /* 带 Ctrl/Cmd 的 Esc(中断主键是 Ctrl+X,这是历史别名)放行给全局中断路径:不当作「取消编辑」 */
    if (e.key === "Escape" && !e.ctrlKey && !e.metaKey) renderChat();
  });
}
function autoGrow(ta) {
  ta.style.height = "auto";
  ta.style.height = Math.min(ta.scrollHeight, 420) + "px";
}

/* ---------------------------------------------------------------------------
   16. 聊天区交互(事件委托)
--------------------------------------------------------------------------- */
function refreshAfterMutation(opts) {
  opts = opts || {};
  if (opts.render !== false) renderChat();
  renderConvList();
  updateTopbar();
  updateCtxMeter();
  updateStorageMeter();
  saveSoon();
}
function msgFromEvent(e) {
  var wrap = e.target.closest ? e.target.closest(".msg") : null;
  if (!wrap || !conv) return null;
  var id = wrap.getAttribute("data-msg-last") || wrap.getAttribute("data-id");
  var msg = findMsg(id);
  return { el: wrap, msg: msg, group: msg ? groupOfMsg(msg.id) : null };
}
/* 合并气泡里的整轮文本(复制 / 引用用):把这一轮各段正文接起来 */
function groupText(group) {
  if (!group || group.length < 2) return null;
  var out = [];
  for (var i = 0; i < group.length; i++) {
    if (group[i].role !== "assistant") continue;
    var t = contentToText(group[i].content);
    if (t && t.trim()) out.push(t);
  }
  return out.length ? out.join("\n\n") : null;
}

elChatInner.addEventListener("click", function (e) {
  var t = e.target;

  var rHead = t.closest ? t.closest(".reasoning-head") : null;
  if (rHead) {
    var rBox = rHead.closest(".reasoning");
    var ctx = msgFromEvent(e);
    var open = rBox.classList.contains("collapsed");
    rBox.classList.toggle("collapsed", !open);
    rBox.classList.toggle("open", open);
    if (ctx && ctx.msg) { ctx.msg.reasoningOpen = open; saveSoon(); }
    return;
  }

  var codeBtn = t.closest ? t.closest("[data-code]") : null;
  if (codeBtn) {
    var pre = codeBtn.closest("pre");
    var codeEl = pre ? pre.querySelector("code") : null;
    if (!codeEl) return;
    var codeAct = codeBtn.getAttribute("data-code");
    if (codeAct === "copy") {
      copyText(codeEl.textContent, "已复制该代码块");
    } else if (codeAct === "run") {
      openCodeRun(codeEl.textContent, codeBtn.getAttribute("data-mime") || "text/html");
    } else if (codeAct === "expand") {
      var expanded = pre.classList.toggle("expanded");
      codeBtn.textContent = expanded ? "收起" : "展开全部";
    } else {
      var wrapped = pre.classList.toggle("wrapped");
      codeBtn.textContent = wrapped ? "不换行" : "自动换行";
    }
    return;
  }

  var btn = t.closest ? t.closest("[data-act]") : null;
  if (!btn) return;
  var ctx2 = msgFromEvent(e);
  if (!ctx2 || !ctx2.msg) return;
  var msg = ctx2.msg, act = btn.getAttribute("data-act");
  var gtext = groupText(ctx2.group);

  if (act === "copy") {
    copyText(gtext ? gtext : messagePlainText(msg), "已复制纯文本");
  } else if (act === "copy-md") {
    copyText(gtext ? gtext
      : (typeof msg.content === "string" ? msg.content : contentToText(msg.content)), "已复制 Markdown 源码");
  } else if (act === "quote") {
    var qsrc = gtext || contentToText(msg.content);
    var quoted = qsrc.split("\n").map(function (l) { return "> " + l; }).join("\n");
    var prefix = (msg.role === "user" ? "关于我上面的内容:\n" : "关于你上面的回答:\n") + quoted + "\n\n";
    elInput.value = elInput.value ? prefix + elInput.value : prefix;
    autoResize(); focusInput();
    toast("已引用到输入框", "success", 1500);
  } else if (act === "speak") {
    speakMessage(msg, btn);
  } else if (act === "edit") {
    startEdit(ctx2.el, msg);
  } else if (act === "regenerate") {
    regenerate(msg);
  } else if (act === "retry") {
    retryFromError(msg);
  } else if (act === "alt-prev") {
    switchAlt(msg, -1);
  } else if (act === "alt-next") {
    switchAlt(msg, 1);
  } else if (act === "cut") {
    if (genOn(conv && conv.id)) { toast("生成进行中,请稍后再试", "warn"); return; }
    var cutIds = {};
    (ctx2.group || [msg]).forEach(function (m) { cutIds[m.id] = 1; });
    var idx = -1;
    for (var i = 0; i < conv.messages.length; i++) if (conv.messages[i].id === msg.id || cutIds[conv.messages[i].id]) { idx = i; break; }
    if (idx < 0) return;
    var n = conv.messages.length - idx;
    /* 确认框是异步的:先把它要删的东西定死(会话 id + 下标 + 条数),用户确认后按 id 重新取会话 ——
       弹窗开着时切走 / 删掉当前会话都不会删错对象 */
    var cutConvId = conv.id, cutIdx = idx, cutN = n;
    askConfirm({
      title: "删除消息", icon: "scissors", okText: "删除",
      message: "将删除这条消息及其后的 " + n + " 条消息,继续吗?"
    }, function () {
      var cc = getConv(cutConvId);
      if (!cc) return;
      cc.messages = cc.messages.slice(0, cutIdx);
      cc.updatedAt = Date.now();
      refreshAfterMutation();
      toast("已删除 " + cutN + " 条消息", "success");
    });
  } else if (act === "delete") {
    if (genOn(conv && conv.id)) { toast("生成进行中,请稍后再试", "warn"); return; }
    var delIds = {};
    (ctx2.group || [msg]).forEach(function (m) { delIds[m.id] = 1; });
    conv.messages = conv.messages.filter(function (m) { return !delIds[m.id]; });
    conv.updatedAt = Date.now();
    refreshAfterMutation();
    toast(ctx2.group ? "已删除这一轮(含工具调用)" : "已删除该消息", "success", 1500);
  }
});

/* ---- 朗读 ---- */
/* 播放状态以这里为准(speakingEl = 正在读的那颗按钮;speakingMsgId 记它属于哪条消息);
   synth.speaking / pending 只作辅助 —— speak() 返回到真正开声前两者都是假,只看它们会把
   "正在读"误判成"没在读",再点同一颗按钮就变成从头重读（旧实现先把 speakingEl 置空再判
   "是不是同一颗按钮",判断恒假）。 */
var speakingEl = null, speakingMsgId = null;
/* 复位:移除 .on(高亮与图标脉冲动画随类消失)。按钮所属消息可能已被重绘移除,
   在游离节点上 classList 依然安全,不抛错 */
function speakReset() {
  if (speakingEl && speakingEl.classList) speakingEl.classList.remove("on");
  speakingEl = null; speakingMsgId = null;
}
function speakMessage(msg, btn) {
  if (!CAP.speech) { toast("当前浏览器不支持语音合成", "warn"); return; }
  var synth = window.speechSynthesis;
  if (speakingEl || synth.speaking || synth.pending) {
    /* 同一条消息(同一颗按钮,或重绘后的新按钮)= 停止朗读;
       别的消息的按钮 = 停当前这条,继续往下读新的 */
    var same = speakingEl === btn || (speakingMsgId != null && !!msg && msg.id === speakingMsgId);
    try { synth.cancel(); } catch (e0) {}
    speakReset();
    if (same) return;
  }
  var text = contentToText(msg.content).trim();
  if (!text) { toast("没有可朗读的内容", "warn"); return; }
  if (text.length > 4000) text = text.slice(0, 4000) + "……(内容过长,仅朗读前 4000 字)";
  var u = new SpeechSynthesisUtterance(text);
  u.lang = /[\u4e00-\u9fff]/.test(text) ? "zh-CN" : "en-US";
  u.rate = 1.05;
  u.onend = u.onerror = function () {
    /* 换读别的消息后,旧 utterance 的回调还会到(speakingEl 已指向新按钮)⇒ 只认当前这颗 */
    if (speakingEl === btn) speakReset();
  };
  speakReset();   /* 理论上前面已复位;防旧节点残留 .on */
  speakingEl = btn;
  speakingMsgId = (msg && msg.id != null) ? msg.id : null;
  btn.classList.add("on");
  try { synth.speak(u); } catch (e) {
    toast("朗读失败:" + (e.message || e), "error");
    if (speakingEl === btn) speakReset();
  }
}

/* ---- 图片预览 ---- */
/* ---------------------------------------------------------------------------
   空间自管理
   · 打开时自动整理(搬附件 / 回收无用记录),不需要用户点按钮
   · 快满时在首页弹「清理空间」,勾选 + 确认后才动数据 —— 不做无感删除
--------------------------------------------------------------------------- */

/* ---- 空间用量 ---- */
function storageUsage() {
  var est = (navigator.storage && navigator.storage.estimate) ? navigator.storage.estimate() : null;
  if (!est) return Promise.resolve(null);
  return new Promise(function (resolve) {
    var done = false;
    setTimeout(function () { if (!done) { done = true; resolve(null); } }, 3000);
    est.then(function (r) {
      if (done) return;
      done = true;
      resolve({ usage: (r && r.usage) || 0, quota: (r && r.quota) || 0 });
    }, function () { if (!done) { done = true; resolve(null); } });
  });
}
/* ---- 保护范围:最近 N 个对话永远不参与清理/自动整理 ---- */
function cleanKeepRecent() {
  var v = Number(state.settings.cleanKeepRecent);
  if (!isFinite(v) || v <= 0) v = 30;
  return Math.max(10, Math.min(100, Math.round(v)));
}
/* 按更新时间的新旧排序(新的在前),取最近 N 个的 id 作为保护集 */
function rankedConvs() {
  return state.conversations.slice().sort(function (a, b) {
    return (b.updatedAt || 0) - (a.updatedAt || 0) || (b.createdAt || 0) - (a.createdAt || 0);
  });
}
function protectedConvIds(n) {
  n = Math.max(0, n == null ? cleanKeepRecent() : n);
  var out = {};
  rankedConvs().slice(0, n).forEach(function (c) { out[c.id] = 1; });
  return out;
}
function isProtectedConv(id, n) {
  return !!protectedConvIds(n)[id];
}
function eligibleConvs() {
  var keep = protectedConvIds();
  return rankedConvs().filter(function (c) { return !keep[c.id]; });
}

/* 当前可释放的量(给弹窗里的估算用) */
function spaceEstimates() {
  var attachChars = 0, attachCount = 0, compressChars = 0, oldConvChars = 0;
  var bd = storageBreakdown().list;
  var keep = cleanKeepRecent();
  var eligible = eligibleConvs();
  var eligibleIds = {};
  eligible.forEach(function (c) { eligibleIds[c.id] = 1; });
  state.conversations.forEach(function (c) {
    if (!eligibleIds[c.id]) return;                  // 受保护的对话:一个字节都不算进清理范围
    var hasBlob = referencedConvBlobs(c);
    attachChars += hasBlob.chars;
    attachCount += hasBlob.count;
    if (c.messages.length > 80) compressChars += Math.round(bytesOfMessages(c) * (c.messages.length - 80) / c.messages.length);
  });
  bd.forEach(function (x) { if (eligibleIds[x.id]) oldConvChars += x.n; });
  return { attachChars: attachChars, attachCount: attachCount, compressChars: compressChars,
           oldConvChars: oldConvChars, convCount: state.conversations.length,
           keep: keep, eligible: eligible.length };
}
function bytesOfMessages(c) {
  var n = 0;
  (c.messages || []).forEach(function (m) {
    try { n += JSON.stringify(m).length; } catch (e) {}
  });
  return n;
}
function referencedConvBlobs(c) {
  var keys = {}, count = 0, chars = 0;
  (c.messages || []).forEach(function (m) {
    if (!Array.isArray(m.content)) return;
    m.content.forEach(function (p) {
      if (p && p.attach && p.attach.blob && !keys[p.attach.blob]) {
        keys[p.attach.blob] = 1;
        count++;
        var rec = blobMemo(p.attach.blob);
        if (rec && rec.data) chars += rec.data.length;
      }
    });
  });
  return { count: count, chars: chars };
}

/* ---- 清理空间弹窗 ---- */
var spacePicked = { attach: false, compress: false, oldconv: false };
function spaceOptionsHtml(est) {
  function est1(txt) { return '<span class="so-est">' + txt + '</span>'; }
  var guard = "只作用于「最近 " + est.keep + " 个对话」之外那 " + est.eligible + " 个较早的对话;最近 " + est.keep + " 个原样不动。";
  var items = [
    { key: "attach", title: "清理附件数据",
      desc: "把较早对话里的图片 / PDF 原数据删掉(文字都留着)。以后看不到原图,内容与对话不受影响。" + guard,
      est: est.attachCount ? ("约可释放 " + fmtBytes(est.attachChars) + " · " + est.attachCount + " 个附件") : "这些对话里没有可清理的附件" },
    { key: "compress", title: "压缩较早的消息",
      desc: "把较早的对话压到最近 80 条消息,更早的删掉(无法撤销)。" + guard,
      est: est.compressChars ? ("约可释放 " + fmtBytes(est.compressChars)) : "这些对话都不超过 80 条" },
    { key: "oldconv", title: "删除最早的对话",
      desc: "把「最近 " + est.keep + " 个」之外的 " + est.eligible + " 个较早对话整段删除(无法撤销)。",
      est: est.eligible ? ("约可释放 " + fmtBytes(est.oldConvChars) + " · " + est.eligible + " 个对话") : "当前对话都还在保护范围内" }
  ];
  return items.map(function (it) {
    return '<label class="space-opt" data-opt="' + it.key + '">' +
      '<input type="checkbox" data-space="' + it.key + '" />' +
      '<span class="so-main"><span class="so-title">' + it.title + '</span>' +
      '<span class="so-desc">' + it.desc + '<br />' + est1(it.est) + '</span></span></label>';
  }).join("");
}
function openSpaceDialog(reason, usage) {
  var m = $("space-modal");
  if (!m) return;
  spacePicked = { attach: false, compress: false, oldconv: false };
  syncSpaceKeep();
  var est = spaceEstimates();
  $("space-actions").innerHTML = spaceOptionsHtml(est);
  var warn = $("space-warn");
  if (reason === "auto" || reason === "full") {
    warn.className = "note show";
    warn.textContent = (reason === "full"
      ? "⚠ 空间已满,新数据暂时存不进去了。"
      : "⚠ 存储空间快用满了。") + "下面勾选后才会清理,不做任何无感删除。";
  } else {
    warn.className = "note";
    warn.textContent = "";
  }
  var kv = [];
  kv.push(["对话", num(state.conversations.length) + " 个 / " + num(totalMsgs()) + " 条消息"]);
  if (usage && usage.quota) {
    kv.push(["浏览器已用", fmtBytes(usage.usage) + " / " + fmtBytes(usage.quota) +
      "(" + (usage.usage / usage.quota * 100).toFixed(1) + "%)"]);
  }
  kv.push(["设置占用", fmtBytes(storageBytes())]);
  kv.push(["附件占用", est.attachCount ? (est.attachCount + " 个 / " + fmtBytes(est.attachChars)) : "无"]);
  $("space-kv").innerHTML = kv.map(function (x) {
    return "<dt>" + escapeHtml(x[0]) + "</dt><dd>" + escapeHtml(x[1]) + "</dd>";
  }).join("");
  $("space-run").disabled = true;
  $("space-run").textContent = "执行清理";
  openMask("space-modal");
}
/* 滑块 = 「最近 N 个对话原样保留」:改了立刻重算估算与文案 */
function syncSpaceKeep() {
  var el = $("space-keep");
  var v = cleanKeepRecent();
  if (el) el.value = String(v);
  var outv = $("space-keep-v");
  if (outv) outv.textContent = v + " 个对话";
  var hint = $("space-keep-hint");
  if (hint) {
    var est2 = spaceEstimates();
    hint.textContent = "最近 " + v + " 个对话的任何数据都不会被动(自动整理也一样);只有更早的 " +
      est2.eligible + " 个对话在清理范围内。";
  }
}
function reRenderSpaceOptions() {
  $("space-actions").innerHTML = spaceOptionsHtml(spaceEstimates());
  spacePicked = { attach: false, compress: false, oldconv: false };
  var run = $("space-run");
  if (run) run.disabled = true;
}
function spaceRun() {
  var picked = [];
  ["attach", "compress", "oldconv"].forEach(function (k) { if (spacePicked[k]) picked.push(k); });
  if (!picked.length) { toast("先勾选要清理的内容", "warn", 2600); return; }
  var btn = $("space-run");
  btn.disabled = true;
  btn.textContent = "正在清理…";
  var lsBefore = storageBytes();
  var done = [];
  var p = Promise.resolve();
  var keepIds = protectedConvIds();          /* 最近 N 个:一个字节都不动 */
  picked.forEach(function (k) {
    p = p.then(function () {
      if (k === "attach") {
        var n = stripAttachmentData(true, keepIds);
        done.push("清理图片 " + n + " 张");
      } else if (k === "compress") {
        var removed = 0;
        state.conversations.forEach(function (c) {
          if (keepIds[c.id]) return;
          if (c.messages.length > 80) {
            var drop = c.messages.length - 80;
            /* 与「精简历史」同一口径:丢弃区间走统一原语 + 释放(该流程末尾本就有 gcBlobs()
               自愈,这里只为「立即释放」一致) */
            var rr = cxDropMessages(c, 0, drop - 1);
            var pp = cxReleasePlan(rr.keys);
            if (pp.todo.length) cxReleaseBlobs(pp.todo);
            removed += drop;
            c.messages.forEach(function (m) { delete m.speed; delete m.thinkMs; });
            c.updatedAt = Date.now();
          }
        });
        done.push("精简掉 " + removed + " 条较早的消息");
        saveState(true);
      } else {
        var drop = state.conversations.filter(function (c) { return !keepIds[c.id]; });
        if (drop.length) {
          var dropIds = drop.map(function (c) { return c.id; });
          /* 只保留保护范围内的(N 个最近的),其余整段删除 */
          markConvsGone(dropIds);            /* 删除意图先立墓碑:对侧的未落库副本不得把它们写回来 */
          state.conversations = state.conversations.filter(function (c) { return !!keepIds[c.id]; });
          if (!conv || dropIds.indexOf(conv.id) > -1) {
            conv = state.conversations[0] || null;
            state.activeId = conv ? conv.id : null;
          }
          if (typeof pvAutoLoopPurge === "function") pvAutoLoopPurge();   /* 会话被清理掉 ⇒ 自动续跑计数跟着收敛 */
          saveState(true);
          return convsDel(dropIds).then(function () { return gcBlobs(); });
        }
        done.push("没有超出保护范围的对话");
      }
    });
  });
  p.then(function () { return gcBlobs(); }).then(function () {
    renderChat(); renderConvList(); updateTopbar(); updateCtxMeter(); updateStorageMeter();
    storageProbe.done = false;
    probeLocalStorageLimit().then(function () {
      renderDataPanel();
      var lsAfter = storageBytes();
      btn.textContent = "执行清理";
      btn.disabled = false;
      toast("清理完成:" + (done.join("、") || "没有变化") +
        "。设置占用 " + fmtBytes(lsBefore) + " → " + fmtBytes(lsAfter), "success", 5200);
      closeMask("space-modal");
    });
  });
}
function initSpaceUI() {
  var run = $("space-run");
  if (run) run.addEventListener("click", spaceRun);
  var cancel = $("space-cancel");
  if (cancel) cancel.addEventListener("click", function () { closeMask("space-modal"); });
  var close = $("space-close");
  if (close) close.addEventListener("click", function () { closeMask("space-modal"); });
  var ex = $("space-export");
  if (ex) ex.addEventListener("click", function () { exportAll(); });
  var acts = $("space-actions");
  if (acts) {
    acts.addEventListener("change", function (e) {
      var t = e.target;
      if (!t || !t.getAttribute || !t.getAttribute("data-space")) return;
      spacePicked[t.getAttribute("data-space")] = !!t.checked;
      var any = spacePicked.attach || spacePicked.compress || spacePicked.oldconv;
      if (run) run.disabled = !any;
    });
  }
  var keepEl = $("space-keep");
  if (keepEl) {
    keepEl.addEventListener("input", function () {
      state.settings.cleanKeepRecent = Math.max(10, Math.min(100, Number(keepEl.value) || 30));
      syncSpaceKeep();
      reRenderSpaceOptions();
      saveSoon();
    });
  }
  var btn = $("btn-space");
  if (btn) {
    btn.addEventListener("click", function () {
      saveSettingsFromModal(false, true);
      storageUsage().then(function (u) { openSpaceDialog("manual", u); });
    });
  }
}

/* ---- 启动流程:装会话 → 自动整理 → 看看空间够不够 ---- */
function bootStorage() {
  return blobDb().then(function (db) {
    if (!db) {
      /* 大仓库或会话区不可用:退回「全部放 localStorage」的老布局(会话一条都不动),如实告知 */
      convStoreReady = false;
      /* 本页的列表就是记录里那一份(loadState 已经按它采纳):整库替换在这里就算生效了。
         replaced 是给"合并"用的一次性标记,留着只会在下一次无关的合并里发作(见下面 IDB 分支) */
      convRevState.replaced = false;
      toast("本机大仓库(IndexedDB)不可用,数据将存在 localStorage(约 5MB):" + (blobStore.note || ""), "warn", 6800);
      return false;
    }
    if (pendingConvs) {
      /* 旧库自动搬家:先写成功,再让 localStorage 瘦身。
         写进去的只有没被墓碑判死的那些(convsPutAll → convsWritable),内存副本按同一口径收敛 ——
         否则界面上会留下一条"写不进去也点不开"的幽灵条目(旧库版本同理) */
      state.conversations = convsWritable(state.conversations);
      /* 与上面两个分支同理:本页的列表就是记录里那一份(loadState 已经按它采纳),
         整库替换在这一步就算生效了 —— replaced 是给"合并"用的一次性标记,留着只会在
         下一次无关的合并里发作(见下面 IDB 分支的长注释)。即便随后的 convsPutAll 失败
         (这些会话在内存里仍是"未落库"),替换语义也已经由记录里那份列表体现 */
      convRevState.replaced = false;
      return convsPutAll(pendingConvs).then(function (ok) {
        if (ok) {
          pendingConvs = null;
          autoTidyStat = { migratedConvs: state.conversations.length, moved: 0, removed: 0 };
          saveState(true);
        } else {
          toast("会话搬去大仓库失败,继续用 localStorage 保存", "warn", 5200);
        }
        return ok;
      });
    }
    /* 读 IDB 之前先取一次记录版本号(同样的理由)—— 读完再取会把"这次快照之后才写进去的
       版本号"算成已经收敛过,那条事件就被去重挡掉(启动瞬间正好对上对侧写入时会陈旧) */
    var revAtRead = readConvsRev();
    return convsGetAll().then(function (list) {
      if (list && list.length) {
        /* 采纳 IDB 的列表时同样按墓碑优先:记录里已有墓碑、库里还留着那条(删除的 IDB 事务没落地)
           ⇒ 采纳它就会显示一条"永不落库也点不开"的幽灵条目。这里与写清单
           用同一个判据(convsWritable),库里那份由 pullConvsFromIdb → convsDel(m.gone) 回收 */
        state.conversations = convsWritable(list.map(sanitizeConv));
        /* 记下权威副本的长相:之后 mergeConvsByIdb 才能区分"这条本页改过、还没落库"与"这条只是
           从 IDB 读进来的" —— 分不清就会两边各说各话(对侧的改名 / 删除永远收敛不过来) */
        markConvsSeen(state.conversations);
        if (!getConv(state.activeId)) state.activeId = state.conversations[0] ? state.conversations[0].id : null;
      }
      /* 采纳完 IDB 的列表就在这里把会话指纹对齐一次(不 bump 版本号):这份列表对侧早就知道,
         不该被当成"会话变了"再推一个版本逼对侧重读全库。
         之后任何真实改动都会与这个指纹不同 ⇒ 正常 bump */
      convRevState.sig = convsFingerprint(state.conversations);
      /* 内存副本的版本号一起对齐(与 pullConvsFromIdb 尾部同口径):上面采纳的这份列表就是
         revAtRead 那一刻的 IDB 真相。不对齐的话,启动后第一笔落盘会因 peer > sync 再整库
         pull 一次,把开机窗口里还没落盘的改动(指纹看不见的字段)整表替换掉 */
      convRevState.sync = Math.max(convRevState.sync, convRevState.peer, revAtRead);
      convRevState.seen = Math.max(convRevState.seen, revAtRead);
      /* **整库替换(清空全部 / 导入)在启动这一步就算处理完了**:记录里的 convsWiped 比本页新时
         loadState 会挂上 replaced,而上面采纳的这份列表就是替换后的真相(空列表也是真相)。
         不在这里消费掉它,它就一直挂着 —— 等到**下一次无关的合并**才发作,而那时本页已经有
         用户在本次打开里新建、还没落库的会话:整表被丢 ⇒ conv = null ⇒ sendMessage 收尾抛
         TypeError,气泡停在「正在生成…」且这条消息永不落盘(「清空全部 → 刷新 → 首发」稳定复现)。
         合并自身的判据也一并收窄,见 appA 的 convWipedAway */
      convRevState.replaced = false;
      return true;
    });
  }).then(function (ok) {
    if (!ok) return false;
    /* 自动整理:内联附件搬进附件库 + 回收没人引用的附件记录 */
    return migrateAttachmentsToIdb().then(function (r1) {
      var moved = (r1 && r1.moved) || 0;
      return gcBlobs().then(function (r2) {
        var removed = (r2 && r2.removed) || 0;
        if (moved || removed) {
          autoTidyStat = { moved: moved, removed: removed, freed: (r2 && r2.freed) || 0,
                           migratedConvs: autoTidyStat ? autoTidyStat.migratedConvs : 0 };
          saveState(true);
          if (typeof renderDataPanel === "function") renderDataPanel();
        }
        return true;
      });
    });
  });
}
/* 打开后、以及每次保存之后:空间快满就提醒(只在同一个会话里提醒一次) */
var spaceWarned = false;
function checkSpaceAuto() {
  storageUsage().then(function (u) {
    if (!u || !u.quota) return;
    var pct = u.usage / u.quota;
    if (pct >= 0.85 && !spaceWarned) {
      spaceWarned = true;
      openSpaceDialog("auto", u);
    }
  });
}

/* ---- 图片灯箱:只能点 ✕ 关(点别处不关);滚轮缩放 + 左键拖拽 + 双击复位 ---- */
var lightboxEl = $("lightbox"), lightboxImg = $("lightbox-img");
var lbScale = 1, lbX = 0, lbY = 0, lbDrag = null;
function lbIsOpen() { return !!(lightboxEl && lightboxEl.classList.contains("open")); }
function lbApply() {
  if (!lightboxImg) return;
  lightboxImg.style.transform = "translate(" + lbX + "px," + lbY + "px) scale(" + lbScale + ")";
  var z = $("lb-zoom");
  if (z) z.textContent = Math.round(lbScale * 100) + "%";
}
function openLightbox(src, name) {
  if (!lightboxEl || !lightboxImg || !src) return;
  lightboxImg.setAttribute("src", src);
  lightboxImg.alt = name || "图片预览";
  lbScale = 1; lbX = 0; lbY = 0;
  lightboxEl.classList.add("open");
  lightboxImg.style.transform = "none";
  lbApply();
}
function closeLightbox() {
  if (!lightboxEl) return;
  lightboxEl.classList.remove("open");
  lbDrag = null;
  if (lightboxImg) {
    lightboxImg.classList.remove("dragging");
    lightboxImg.removeAttribute("src");
  }
  lbScale = 1; lbX = 0; lbY = 0;
}
function lbZoomAt(mx, my, factor) {
  var next = Math.min(8, Math.max(0.15, lbScale * factor));
  if (next === lbScale) return;
  var L = lightboxImg.offsetLeft, T = lightboxImg.offsetTop;
  var k = next / lbScale;
  lbX = mx - L - k * (mx - L - lbX);
  lbY = my - T - k * (my - T - lbY);
  lbScale = next;
  lbApply();
}
if (lightboxEl) {
  lightboxEl.addEventListener("wheel", function (e) {
    if (!lbIsOpen()) return;
    e.preventDefault();
    var r = lightboxEl.getBoundingClientRect();
    lbZoomAt(e.clientX - r.left, e.clientY - r.top, e.deltaY < 0 ? 1.12 : 1 / 1.12);
  });
  lightboxEl.addEventListener("mousedown", function (e) {
    if (!lbIsOpen() || e.button !== 0) return;
    if (e.target && e.target.closest && e.target.closest(".lb-close")) return;
    e.preventDefault();
    lbDrag = { x: e.clientX, y: e.clientY, ox: lbX, oy: lbY };
    lightboxImg.classList.add("dragging");
  });
  lightboxEl.addEventListener("dblclick", function (e) {
    if (!lbIsOpen()) return;
    if (e.target && e.target.closest && e.target.closest(".lb-close")) return;
    lbScale = 1; lbX = 0; lbY = 0;
    lbApply();
  });
  var lbClose = $("lb-close");
  if (lbClose) lbClose.addEventListener("click", function (e) { e.stopPropagation(); closeLightbox(); });
}
document.addEventListener("mousemove", function (e) {
  if (!lbDrag) return;
  lbX = lbDrag.ox + (e.clientX - lbDrag.x);
  lbY = lbDrag.oy + (e.clientY - lbDrag.y);
  lbApply();
});
document.addEventListener("mouseup", function () {
  if (!lbDrag) return;
  lbDrag = null;
  if (lightboxImg) lightboxImg.classList.remove("dragging");
});
/* 气泡里的图片:点开进灯箱(附件预览弹窗里的页面缩略图同样走灯箱) */
elChatInner.addEventListener("click", function (e) {
  var img = e.target && e.target.closest ? e.target.closest(".msg-content img") : null;
  if (!img || (e.target.closest && e.target.closest("[data-act]"))) return;
  openLightbox(img.getAttribute("src"), img.getAttribute("alt"));
});

/* ---- 附件预览弹窗(文本 / PDF;只能点 ✕ 关) ---- */
function unwrapFileText(t) {
  var s = String(t == null ? "" : t);
  var m = /^[\s\S]*?\n(`{3,})\n([\s\S]*?)\n\1\s*$/.exec(s);
  if (m) return m[2];
  var m2 = /^文件:[^\n]*\n\n([\s\S]*)$/.exec(s);
  if (m2) return m2[1];
  return s;
}
function openFilePreview(name, text, f) {
  var m = $("file-preview-modal");
  if (!m) return;
  f = f || {};
  var meta = [];
  if (f.loading) {
    meta.push("读取中…(可随时关闭)");
  } else if (f.failed) {
    meta.push("无法预览:" + f.failed);
  } else if (f.kind === "pdf") {
    meta.push("PDF · 共 " + (f.pages || 1) + " 页");
    if (!f.wsPreview) meta.push(attachModeLabel(f));
    if (f.pdfPages) meta.push("预览渲染前 " + f.pdfPages + " 页");
    /* 非视觉模型下的图文融合注记(含「N 图已本机 OCR」与预算/失败注记;视觉路径没有这个字段) */
    if (f.degraded) meta.push(f.degraded);
  } else if (f.kind === "image") {
    meta.push("图片" + (f.dim ? " · " + f.dim : "") + " · " + fmtBytes(f.size || 0));
  } else if (f.kind === "office") {
    meta.push(officeBrief(f));
    if (!f.wsPreview) meta.push(attachModeLabel(f));
    if (f.degraded) meta.push(f.degraded);
    /* README 承诺过「跳过 N 张」:chip 上只显示收下的张数,被跳过(图表 / EMF / 超限)的数量在这里露出 */
    if (Number(f.skippedImgs) > 0) meta.push("跳过 " + num(Number(f.skippedImgs)) + " 张图(图表 / 不支持的格式或超限)");
  } else {
    meta.push("纯文本 · " + fmtBytes(f.size || String(text || "").length));
    if (f.enc) meta.push(wsEncName(f.enc));
  }
  if (f.clipped) meta.push("超过上限的部分已截断");
  if (f.lossy) meta.push("解码时替换了少量非法字节");
  if (f.ocr) meta.push("内容是 OCR 识别结果");
  /* 口径与草稿 token 环 / 上下文浮层一致:图片模式下按张数 ×900 计,不是按正文长度。
     工作区文件预览不是附件、不参与任何请求 ⇒ 不算 token */
  if (!f.wsPreview) meta.push("约 " + num(previewAttachTokens(f, text)) + " tokens(估算)");
  $("fp-title").textContent = name || "附件预览";
  $("fp-meta").textContent = meta.join(" · ");
  var pre = $("fp-body");
  pre.textContent = String(text == null ? "" : text);
  pre.style.display = pre.textContent ? "" : "none";
  var box = $("fp-images");
  while (box.firstChild) box.removeChild(box.firstChild);
  var imgs = f.images || [];
  imgs.forEach(function (im, i) {
    var img = document.createElement("img");
    /* 三种来源:裸地址字符串(附件水合出来的 data: URL / 工作区预览的 objectURL)、
       {mime,data}(base64 裸串,office 与 PDF 页)、{url}(objectURL) */
    img.src = typeof im === "string" ? im
      : (im && im.url ? im.url : ("data:" + ((im && im.mime) || "image/jpeg") + ";base64," + ((im && im.data) || "")));
    /* PDF 图片模式按页给标签;office 的图没有页码(pptx 的库不暴露),退回序号 */
    var lb = (im && im.label) || (f.kind === "pdf" ? ("第 " + (i + 1) + " 页") : ("图 " + (i + 1)));
    img.alt = lb;
    img.title = lb + (im && im.w ? " · " + im.w + "×" + im.h : "");
    box.appendChild(img);
  });
  box.style.display = imgs.length ? "" : "none";
  openMask("file-preview-modal");
}
var fpImages = $("fp-images");
if (fpImages) {
  fpImages.addEventListener("click", function (e) {
    var img = e.target && e.target.closest ? e.target.closest("img") : null;
    if (img) openLightbox(img.getAttribute("src"), img.getAttribute("alt"));
  });
}
var fpClose = $("fp-close");
if (fpClose) fpClose.addEventListener("click", function () {
  closeMask("file-preview-modal");
  if (typeof wsPreviewCleanup === "function") wsPreviewCleanup();   /* 回收工作区预览的 objectURL */
});
var fpCopy = $("fp-copy");
if (fpCopy) {
  fpCopy.addEventListener("click", function () {
    copyText($("fp-body").textContent || "", "已复制附件内容");
  });
}
/* 从气泡里的部件还原出可预览的附件(卡片点击时用)。
   一次性守卫(depth):attach.blob 指向的记录在库里不存在时,blobGet 会 resolve(null) 且不写 memo,
   原来"再调一次自己"就变成**无界递归**(每次一轮 IDB 读、预览永不打开、主线程持续空转;
   悬垂引用可由「导入旧备份 / 手改备份 / 附件库被清过」产生,importAll 不校验 attach.blob)。
   现在最多重入一层:第二次读回来仍然缺 → 直接给可读降级提示并 return。 */
function previewAttachmentMissing(meta) {
  toast(meta && meta.kind === "image"
    ? "这张图片的数据不在本机了(附件库里没有这条记录)"
    : "这个附件的数据不在本机了(只剩下了请求记录)", "warn", 3600);
}
function previewAttachmentPayload(meta, payload, depth) {
  if (!meta) return;
  payload = payload || {};
  depth = Number(depth) || 0;
  /* 还没进内存的外置 payload:先读回来再开弹窗(图片/PDF 页都要用) */
  var need = [];
  if (meta.blob && !blobMemo(meta.blob)) need.push(meta.blob);
  if (payload.stubs && payload.stubs.length) {
    payload.stubs.forEach(function (k) {
      if (k && !blobMemo(k) && need.indexOf(k) === -1) need.push(k);
    });
  }
  if (need.length) {
    if (depth >= 1) { previewAttachmentMissing(meta); return; }   /* 读回来还是缺 ⇒ 记录真的不在本机 */
    Promise.all(need.map(function (k) { return blobGet(k); })).then(function () {
      previewAttachmentPayload(meta, payload, depth + 1);
    }, function () {
      previewAttachmentPayload(meta, payload, depth + 1);
    });
    return;
  }
  if (String(meta.id || "").indexOf("legacy-pdf-") === 0) {
    toast("这是早期版本内联保存的 PDF,只留下了请求记录,内容无法再预览", "info", 3600);
    return;
  }
  /* 到这里 payload 都在内存里了:按点击时刻解析出真正可用的地址 */
  var imgs = [];
  (payload.imgs || []).forEach(function (p) {
    var url = uploadedSrc(p);
    if (!url) return;
    var mm = /^data:([^;,]+)/.exec(url);
    imgs.push({
      mime: mm ? mm[1] : ((p.attach && p.attach.mime) || "image/png"),
      data: url.replace(/^data:[^,]*,/, ""),
      label: (p.attach && p.attach.label) || ""
    });
  });
  if (meta.kind === "image") {
    if (imgs.length) openLightbox("data:" + imgs[0].mime + ";base64," + imgs[0].data, meta.name);
    else toast("这张图片的数据不在本机了", "warn", 3200);
    return;
  }
  openFilePreview(meta.name, unwrapFileText((payload.texts || []).join("\n\n")), {
    kind: meta.kind, size: meta.size, pages: meta.pages, mode: meta.mode,
    /* P3-3:预览面也必须带上档位/图源 ⇒ attachModeLabel 的取词(页图/表格图/降级)不会退化 */
    srcMode: meta.srcMode, renderSrc: meta.renderSrc,
    clipped: meta.clipped, images: imgs, ocr: !!meta.ocrOnly,
    subtype: meta.subtype, unit: meta.unit, imgCount: meta.imgCount,
    skippedImgs: meta.skippedImgs, textChars: meta.textChars, degraded: meta.degraded,
    ocrImgs: meta.ocrImgs
  });
}

/* ---------------------------------------------------------------------------
   17. 弹层管理
--------------------------------------------------------------------------- */
function openMask(id) {
  var m = $(id);
  if (!m) return;
  closeMenus();
  m.classList.add("open");
  var f = m.querySelector("input:not([type=hidden]),textarea,select,button.primary");
  if (f) setTimeout(function () { try { f.focus(); } catch (e) {} }, 60);
}
function closeMask(id) {
  var m = $(id);
  if (m) m.classList.remove("open");
}
function closeAllMasks() {
  $$(".modal-mask.open").forEach(function (m) { m.classList.remove("open"); });
}
function closeMenus() {
  $("pop-menu").classList.remove("open");
  $("params-pop").classList.remove("open");
  $("btn-params").classList.remove("on");
  WS_CTX = null;      /* 工作区右键菜单的上下文跟着菜单一起失效(唯一写入口见 wsCtxOpenMenu) */
}
$$(".modal-mask").forEach(function (mask) {
  focusTrap(mask);
  mask.addEventListener("click", function (e) {
    // 带 data-noclose 的弹窗(设置、系统提示词)点遮罩不关,只能经 ✕ / 关闭按钮 / 普通 Esc 退出,避免误触丢失编辑
    // (带 Ctrl/Cmd 的 Esc 走全局中断路径,不关窗;见 onKeyDown 的 Esc 分支)
    if (mask.hasAttribute("data-noclose")) return;
    if (e.target === mask) { closeMask(mask.id); if (mask.id === "tasks-modal") closeTasksModal(); }
  });
});
$$("[data-close]").forEach(function (b) {
  b.addEventListener("click", function () {
    var m = b.closest(".modal-mask");
    if (m) { closeMask(m.id); if (m.id === "tasks-modal") closeTasksModal(); }
  });
});
/* 点击别处收起浮层。必须放过「打开按钮」自身,否则按钮刚打开就被这一下关掉 */
document.addEventListener("click", function (e) {
  var t = e.target;
  if (!t || !t.closest) return;
  /* 挂在 body 上的自绘浮层(自绘下拉 / 模型候选)不在宿主容器里:
     点它们的选项时不能连带把宿主浮层也关掉,否则「在参数浮层里选思考强度」会把整个参数浮层收走 */
  var inLayer = !!(t.closest("#nsel-pop") || t.closest("#model-suggest"));
  if (!inLayer && !t.closest("#pop-menu") && !t.closest("[data-menu-opener]")) {
    wsCtxCloseMenu();      /* 同一条路径:去 .open + 清 WS_CTX(右键菜单上下文不残留) */
  }
  if (!inLayer && !t.closest("#params-pop") && !t.closest("#btn-params")) {
    $("params-pop").classList.remove("open");
    $("btn-params").classList.remove("on");
  }
  if (!inLayer && !t.closest("#ctx-pop") && !t.closest("#ctx-meter")) toggleCtxPop(false);
  /* 斜杠浮窗:点输入框自身(继续编辑)或浮窗内不算「外点」;点别处即收起 */
  if (!t.closest("#slash-menu") && !t.closest("#input") && $("slash-menu").classList.contains("open")) slashClose();
  if (!t.closest("#nsel-pop") && !t.closest(".nsel")) closeNsel();
  if (!t.closest("#model-suggest") && !t.closest("#set-model") && !t.closest("#btn-model-list")) hideModelSuggest();
});

/* ---------------------------------------------------------------------------
   17.5 主题化下拉控件(替代原生 select,配色随主题)
   浮层挂在 body 末尾并 position:fixed,避免被弹窗的滚动容器裁掉
--------------------------------------------------------------------------- */
var NSEL = {}, nselOpenId = null;
function nselDef(id) {
  return Object.prototype.hasOwnProperty.call(NSEL, id) ? NSEL[id] : null;
}
function setupNsel(id, options, onChange) {
  var host = $(id);
  if (!host) return;
  NSEL[id] = { el: host, options: options || [], onChange: onChange || null, value: "", hl: 0 };
  host.innerHTML = '<button type="button" class="nsel-btn" aria-haspopup="listbox" aria-expanded="false">' +
    '<span class="nsel-val"></span>' + icon("down", "sm nsel-arrow") + "</button>";
  var btn = host.querySelector(".nsel-btn");
  btn.addEventListener("click", function (e) { e.stopPropagation(); toggleNsel(id); });
  btn.addEventListener("keydown", function (e) {
    var d = nselDef(id);
    if (!d) return;
    var open = nselOpenId === id;
    /* 带 Ctrl/Cmd 的 Esc(中断主键是 Ctrl+X,这是历史别名)放行给全局中断路径:浮窗开着也不接管、更不 stopPropagation */
    if (e.key === "Escape" && !e.ctrlKey && !e.metaKey) { if (open) { e.stopPropagation(); closeNsel(); } return; }
    if (e.key === "ArrowDown" || e.key === "ArrowUp") {
      e.preventDefault();
      if (!open) { openNsel(id); return; }
      moveNsel(d, e.key === "ArrowDown" ? 1 : -1);
      return;
    }
    if ((e.key === "Enter" || e.key === " ") && open) {
      e.preventDefault();
      var o = d.options[d.hl];
      closeNsel();
      if (o) setNselValue(id, o.v);
    }
  });
  renderNsel(id);
}
function nselValue(id) {
  var d = nselDef(id);
  return d ? d.value : "";
}
/* quiet=true 时不触发 onChange(用于表单回填) */
function setNselValue(id, v, quiet) {
  var d = nselDef(id);
  if (!d) return;
  var ok = false;
  for (var i = 0; i < d.options.length; i++) if (d.options[i].v === v) ok = true;
  d.value = ok ? String(v) : (d.options.length ? d.options[0].v : "");
  for (var k = 0; k < d.options.length; k++) if (d.options[k].v === d.value) d.hl = k;
  renderNsel(id);
  if (!quiet && d.onChange) d.onChange(d.value);
}
function renderNsel(id) {
  var d = nselDef(id);
  if (!d) return;
  var cur = null, i;
  for (i = 0; i < d.options.length; i++) if (d.options[i].v === d.value) cur = d.options[i];
  var val = d.el.querySelector(".nsel-val");
  if (val) {
    /* 选项可带自有 tag 覆盖芯片文本:tag 为空串 = 正常样式但不渲染芯片
       (标题已含"开 / 关"这类信息时,避免收起态再挂一颗值芯片);无 tag 属性 = 旧口径
       (值非空渲染值芯片,值为空走 nsv-none 灰样式) */
    var tagOv = !!(cur && Object.prototype.hasOwnProperty.call(cur, "tag"));
    if (cur && (tagOv || cur.v)) {
      var chip = tagOv ? cur.tag : cur.v;
      val.innerHTML = escapeHtml(cur.label) +
        (chip ? '<span class="nsv-tag">' + escapeHtml(chip) + "</span>" : "");
    } else {
      val.innerHTML = '<span class="nsv-none">' + escapeHtml(cur ? cur.label : "—") + "</span>";
    }
  }
  d.el.querySelector(".nsel-btn").setAttribute("aria-expanded", nselOpenId === id ? "true" : "false");
  if (nselOpenId === id) renderNselPop(id);
}
function renderNselPop(id) {
  var d = nselDef(id), pop = $("nsel-pop");
  if (!d || !pop) return;
  pop.innerHTML = d.options.map(function (o, i) {
    return '<button type="button" role="option" aria-selected="' + (o.v === d.value ? "true" : "false") +
      '" class="nsel-opt' + (o.v === d.value ? " sel" : "") + (i === d.hl ? " hl" : "") +
      '" data-nsel-v="' + escAttr(o.v) + '">' + icon("check", "sm nso-tick") +
      '<span class="nso-main"><b>' + escapeHtml(o.label) + "</b>" +
      (o.desc ? '<span class="nso-desc">' + escapeHtml(o.desc) + "</span>" : "") + "</span></button>";
  }).join("");
}
function placeNsel(host, pop) {
  var r = host.getBoundingClientRect();
  var w = Math.max(200, Math.round(r.width));
  pop.style.width = w + "px";
  var h = pop.offsetHeight, vh = window.innerHeight;
  var below = vh - r.bottom - 8;
  var top = (below >= Math.min(h, 180)) ? r.bottom + 6 : Math.max(8, r.top - h - 6);
  if (top + h > vh - 8) top = Math.max(8, vh - h - 8);
  pop.style.top = Math.round(top) + "px";
  pop.style.left = Math.round(Math.max(8, Math.min(r.left, window.innerWidth - w - 8))) + "px";
}
function openNsel(id) {
  var d = nselDef(id);
  if (!d) return;
  if (nselOpenId && nselOpenId !== id) closeNsel();
  nselOpenId = id;
  var i;
  for (i = 0; i < d.options.length; i++) if (d.options[i].v === d.value) d.hl = i;
  d.el.classList.add("open");
  renderNselPop(id);
  var pop = $("nsel-pop");
  pop.classList.add("open");
  placeNsel(d.el, pop);
}
function closeNsel() {
  var d = nselOpenId ? nselDef(nselOpenId) : null;
  if (d) {
    d.el.classList.remove("open");
    var b = d.el.querySelector(".nsel-btn");
    if (b) b.setAttribute("aria-expanded", "false");
  }
  nselOpenId = null;
  var pop = $("nsel-pop");
  if (pop) pop.classList.remove("open");
}
function toggleNsel(id) {
  if (nselOpenId === id) closeNsel(); else openNsel(id);
}
function moveNsel(d, dir) {
  var n = d.options.length;
  if (!n) return;
  d.hl = (d.hl + dir + n) % n;
  renderNselPop(nselOpenId);
  var pop = $("nsel-pop");
  var hl = pop.querySelector(".nsel-opt.hl");
  if (hl && hl.scrollIntoView) { try { hl.scrollIntoView({ block: "nearest" }); } catch (e) {} }
}
function bindNselPop() {
  var pop = $("nsel-pop");
  if (!pop) return;
  pop.addEventListener("click", function (e) {
    var t = e.target;
    var b = t && t.closest ? t.closest("[data-nsel-v]") : null;
    if (!b) return;
    var id = nselOpenId, v = b.getAttribute("data-nsel-v");
    closeNsel();
    if (id) setNselValue(id, v);
  });
}
/* 思考强度选项(空字符串 = 不发送) */
var EFFORT_OPTIONS = [
  { v: "", label: "不发送", desc: "交由服务端决定(推荐,默认)" },
  { v: "low", label: "low", desc: "最省 token,适合简单任务" },
  { v: "medium", label: "medium", desc: "速度与质量的平衡" },
  { v: "high", label: "high", desc: "复杂推理(多数服务端的默认档)" },
  { v: "max", label: "max", desc: "不限 token 投入" }
];
function initEffortSelects() {
  var on = function (v) {
    state.settings.reasoningEffort = EFFORT_LEVELS.indexOf(v) === -1 ? "" : v;
    setNselValue("p-reff", state.settings.reasoningEffort, true);
    setNselValue("set-reff", state.settings.reasoningEffort, true);
    saveSoon();
  };
  setupNsel("set-reff", EFFORT_OPTIONS, on);
  setupNsel("p-reff", EFFORT_OPTIONS, on);
  bindNselPop();
  window.addEventListener("resize", function () {
    if (nselOpenId) closeNsel();
    repositionPops();     // 输入区两个浮层跟着按钮重新贴边
  });
}

/* ---------------------------------------------------------------------------
   18. 设置面板
--------------------------------------------------------------------------- */
var RANGE_FMT = {
  "set-temp": function (v) { return Number(v) < 0 ? "不发送" : Number(v).toFixed(2); },
  "set-topp": function (v) { return Number(v) < 0 ? "不发送" : Number(v).toFixed(2); },
  "set-reppen": function (v) { return Number(v) === 0 ? "不启用" : Number(v).toFixed(2); },
  "set-presence": function (v) { return Number(v) === 0 ? "不启用" : Number(v).toFixed(2); },
  "set-maxtok": function (v) {
    if (Number(v) > 0) return fmtTok(v);
    return state.settings.protocol === "anthropic" ? "自动 → 256K" : "自动";
  },
  "set-ctxmsgs": function (v) { return Number(v) === 0 ? "不限制" : v + " 条"; },
  "set-pdfpages": function (v) { return Number(v) + " 页"; },
  "set-pdfdpi": function (v) { return Number(v) + " DPI"; },
  "set-imgmax": function (v) { return Number(v) + " px"; },
  "set-attachmax": function (v) { return Number(v) + " MB"; }
};
function syncRangeLabel(input) {
  var out = $(input.id + "-v");
  if (!out) return;
  var f = RANGE_FMT[input.id];
  out.textContent = f ? f(input.value) : input.value;
}
var RANGE_BIND = [
  ["set-temp", "temperature"], ["set-topp", "topP"], ["set-maxtok", "maxTokens"],
  ["set-reppen", "freqPenalty"], ["set-presence", "presencePenalty"],
  ["set-ctxmsgs", "ctxMsgs"], ["set-pdfpages", "pdfMaxPages"], ["set-pdfdpi", "pdfDpi"],
  ["set-imgmax", "imgMaxSide"], ["set-attachmax", "attachMsgMaxMb"]
];
var SWITCH_BIND = [
  ["set-stream", "stream"], ["set-autoscroll", "autoscroll"], ["set-show-reasoning", "showReasoning"],
  ["set-auto-sync", "autoSync"], ["set-compact", "compact"], ["set-fx", "fx"], ["set-codewrap", "codeWrap"],
  /* 工具联网开关从工具卡片抽离到面板级:面板级布尔设置,走这张表即可同步 + 绑定 */
  ["set-tool-net", "toolNet"]
];
/* 数字输入设置(设置 ↔ DOM 双向绑定;clamp 区间与 mergeSettings 里那三行逐字一致)。
   兜底值一律取 DEFAULT_SETTINGS —— 与 mergeSettings 的第三参同源(广播枢纽,不另存一份副本) */
var NUM_BIND = [
  ["set-ws-session-bytes", "wsSessionBytesMb", 1, 256],
  ["set-ws-session-wback", "wsSessionWbackMb", 16, 4096],
  ["set-ws-session-files", "wsSessionFiles", 100, 20000]
];
/* 数字输入的统一取值(读取点与提交点必须同一口径):
   `input[type=number]` 会把非数字串消毒成 ""(清空、输入 'abc' 都是这个结果),而 Number("")=0
   是"合法数字" ⇒ 直接 clampNum 会把脏输入钉到**最小值**(1 / 16 / 100)并落盘,而不是回到默认值。
   所以空串与非数字都映射到 DEFAULT_SETTINGS,越界才夹到区间。 */
function numBindValue(el, b) {
  var raw = el ? String(el.value == null ? "" : el.value).trim() : "";
  if (raw === "" || !isFinite(Number(raw))) return DEFAULT_SETTINGS[b[1]];
  return clampNum(Number(raw), b[2], b[3], DEFAULT_SETTINGS[b[1]]);
}
function syncSettingsForm() {
  var s = state.settings;
  $("set-base").value = s.baseUrl || "";
  $("set-key").value = s.apiKey || "";
  $("set-model").value = s.model || "";
  $("set-sys").value = s.systemPrompt || "";
  syncEffortInputs();
  RANGE_BIND.forEach(function (b) {
    var el = $(b[0]);
    if (!el) return;
    el.value = s[b[1]];
    syncRangeLabel(el);
  });
  SWITCH_BIND.forEach(function (b) {
    var el = $(b[0]);
    if (el) el.checked = !!s[b[1]];
  });
  NUM_BIND.forEach(function (b) {
    var el = $(b[0]);
    if (el) el.value = clampNum(s[b[1]], b[2], b[3], DEFAULT_SETTINGS[b[1]]);
  });
  $$("#proto-switch button").forEach(function (b) {
    b.classList.toggle("active", b.getAttribute("data-proto") === s.protocol);
  });
  $("proto-hint").innerHTML = s.protocol === "openai"
    ? "POST <code>{base}/v1/chat/completions</code>"
    : "POST <code>{base}/v1/messages</code>(需 <code>max_tokens</code>,首条必须为 user)";
  updateModelsHint();
  renderModelsInline();
  renderAttachPanel();
  syncFaviconUI();
  syncCtxWinInputs();
  syncCorsBypassUI();
  if (window.__mcpRefresh) window.__mcpRefresh();
}
function openSettings(tab) {
  syncSettingsForm();
  openMask("settings-modal");
  switchTab(tab || "model");
}
function switchTab(name) {
  if (name === "conn") name = "model";   // 「连接」已合并进「模型」,旧入口自动改道
  $$("#settings-tabs button").forEach(function (b) {
    b.classList.toggle("active", b.getAttribute("data-tab") === name);
  });
  $$("[data-panel]").forEach(function (p) {
    p.classList.toggle("active", p.getAttribute("data-panel") === name);
  });
  if (name === "env") renderEnvPanel();
  else if (name === "data") { renderDataPanel(); renderLibList(); }
  else if (name === "attach") renderAttachPanel();
  else if (name === "mcp" && window.__mcpRefresh) window.__mcpRefresh();
}
function saveSettingsFromModal(close, quiet) {
  var s = state.settings;
  s.baseUrl = $("set-base").value.trim();
  s.apiKey = $("set-key").value.trim();
  s.model = $("set-model").value.trim();
  s.systemPrompt = $("set-sys").value;
  var reffEl = $("set-reff");
  if (reffEl) {
    var rv = nselValue("set-reff");
    s.reasoningEffort = EFFORT_LEVELS.indexOf(rv) === -1 ? "" : rv;
  }
  RANGE_BIND.forEach(function (b) {
    var el = $(b[0]);
    if (el) s[b[1]] = Number(el.value);
  });
  SWITCH_BIND.forEach(function (b) {
    var el = $(b[0]);
    if (el) s[b[1]] = !!el.checked;
  });
  NUM_BIND.forEach(function (b) {
    var el = $(b[0]);
    if (el) s[b[1]] = numBindValue(el, b);
  });
  /* 预检规避兼容模式:以开关的**生效态**落盘(门控不满足时开关是置灰 + 未勾选的 ⇒ 一并关掉,
     不留"存着 true 但用不上"的僵尸状态;详见 setCorsBypass 的注释与 CORS 分层节) */
  var cbe = $("set-cors-bypass");
  if (cbe) s.corsPreflightBypass = !!cbe.checked && corsBypassGate().ok;
  if (conv && s.model) conv.model = s.model;
  applyAppearance();
  saveState(true);
  /* 落盘用的是**生效态**(上面那行),开关 UI 也要按生效态回刷 —— 否则「勾选态下填上 Key + 任一保存并保持打开入口」
     会出现「复选框显示开着、实际是关着」的不一致(请求行为本身用 corsBypassOn() 每次重算,一直是对的) */
  syncCorsBypassUI();
  updateTopbar();
  rebuildModelDatalist();
  syncParamInputs();
  if (window.__mcpRefresh) window.__mcpRefresh();
  if (close) { closeMask("settings-modal"); if (!quiet) toast("设置已保存", "success"); }
}

/* ---- 协议 ---- */
function setProtocol(proto) {
  state.settings.protocol = proto === "anthropic" ? "anthropic" : "openai";
  $$("#proto-switch button").forEach(function (b) {
    b.classList.toggle("active", b.getAttribute("data-proto") === state.settings.protocol);
  });
  $("proto-hint").innerHTML = state.settings.protocol === "openai"
    ? "POST <code>{base}/v1/chat/completions</code>"
    : "POST <code>{base}/v1/messages</code>(需 <code>max_tokens</code>,首条必须为 user)";
  elProtoBadge.className = "badge " + state.settings.protocol;
  elProtoBadge.textContent = state.settings.protocol === "openai" ? "OPENAI" : "ANTHROPIC";
  rebuildModelDatalist();
  syncCorsBypassUI();   /* 协议是「预检规避兼容模式」的门控条件之一 ⇒ 切协议即刷新开关可用性 */
  saveSoon();
}

/* ---- 模型 ---- */
/* 模型候选的主题化浮层(原生 datalist 弹层无法跟主题配色,所以自己画一个) */
function allModelNames() {
  return allModelOptions();
}
function renderModelSuggest(kw) {
  var box = $("model-suggest"), inp = $("set-model");
  if (!box || !inp) return;
  var k = String(kw == null ? inp.value : kw).trim().toLowerCase();
  var opts = allModelNames().filter(function (o) { return !k || o.name.toLowerCase().indexOf(k) > -1; });
  var cur = inp.value.trim();
  box.innerHTML = opts.length
    ? opts.map(function (o) {
      return '<button type="button" data-model-pick="' + escAttr(o.name) + '"' +
        (o.name === cur ? ' class="on"' : "") + '><span class="ms-name">' + escapeHtml(o.name) +
        '</span><span class="ms-src">' + escapeHtml(o.src) + "</span></button>";
    }).join("")
    : '<div class="ms-empty">暂无候选,可直接输入模型名后点「拉取模型列表」</div>';
  box.classList.add("open");
  placeDropdown(box, inp);
}
function hideModelSuggest() {
  var box = $("model-suggest");
  if (box) box.classList.remove("open");
}
function isModelSuggestOpen() {
  var box = $("model-suggest");
  return !!(box && box.classList.contains("open"));
}
/* 浮层贴在触发元素的正下方(下方放不下就翻上去),宽度与触发元素对齐 */
function placeDropdown(el, anchor) {
  var r = anchor.getBoundingClientRect();
  var w = Math.round(r.width);
  el.style.width = Math.max(180, w) + "px";
  var h = el.offsetHeight;
  var y = r.bottom + 6;
  if (y + h > window.innerHeight - 10) y = Math.max(10, r.top - h - 6);
  el.style.left = Math.round(Math.max(8, Math.min(r.left, window.innerWidth - Math.max(180, w) - 8))) + "px";
  el.style.top = Math.round(y) + "px";
}
/* 上下文窗口的来源:server = 服务端报告过这个模型(实测值,手动设定不参与);
   manual = 服务端没给窗口长度,但用户手动设过(≠ 默认值时);
   default = 服务端列表里有它,也没手动调过,按默认 256K;
   unlisted = 服务端根本没有这个模型名(比如手填的自定义名),只能按默认 256K 估算 */
function ctxWindowSrcLevel(model) {
  if (ctxWindowSrc(model) === "server") return "server";
  if (ctxWinKNow() !== DEFAULT_SETTINGS.ctxWinK) return "manual";
  return isListedModel(model) ? "default" : "unlisted";
}
/* 窗口来源的文案(浮窗来源行 / 设置面板提示行 / 提示 toast 共用这一处,避免各写一份漂移) */
function ctxWinSrcLabel(lvl, model) {
  if (lvl === "server") return "服务端返回";
  if (lvl === "manual") {
    return "手动设定(" + ctxWinKNow() + "K" +
      (isListedModel(model) ? " · 服务端没给窗口长度" : " · 服务端没有这个模型") + ")";
  }
  if (lvl === "unlisted") return "默认 " + DEFAULT_SETTINGS.ctxWinK + "K(未确认)";
  return "默认 " + DEFAULT_SETTINGS.ctxWinK + "K";
}
function ctxWinSrcTitle(lvl) {
  if (lvl === "server") return "上下文窗口来自服务端返回的模型信息";
  if (lvl === "manual") return "服务端没有给出该模型的窗口长度,按「上下文长度」的手动设定(" + ctxWinKNow() + "K)估算";
  if (lvl === "unlisted") return "服务端没有这个模型的信息,只能按默认 " + DEFAULT_SETTINGS.ctxWinK + "K 估算";
  return "服务端没有给出该模型的窗口长度,按默认 " + DEFAULT_SETTINGS.ctxWinK + "K 估算";
}
function refreshModelCtx(model) {
  updateModelsHint();
  var m = String(model || "").trim() || effectiveModel();
  if (!m) return;
  ensureModelVision(m);       // 顺带确认图像输入能力(内部有去重,不会反复发请求)
  if (ctxMetaFor(m)) return;
  fetchCtxFromProps(true, m).then(function () {
    updateModelsHint();
    updateCtxMonitor();
  });
}
function rebuildModelDatalist() {
  /* 原生 datalist 已移除:候选改用 #model-suggest 浮层,这里只刷新提示文案 */
  updateModelsHint();
}
function updateModelsHint() {
  var n = (state.fetchedModels || []).length;
  var el = $("models-hint");
  if (el) {
    if (!n) el.textContent = "尚未获取模型列表。填写 Base URL 后点右侧 ↻ 拉取,或直接输入模型名。";
    else el.textContent = "已获取 " + n + " 个模型:" + state.fetchedModels.slice(0, 6).join("、") + (n > 6 ? " …" : "");
  }
  var ch = $("ctx-window-hint");
  if (ch) {
    var m = (($("set-model") && $("set-model").value) || effectiveModel() || "").trim();
    var win = ctxWindowFor(m);
    var lvl = m ? ctxWindowSrcLevel(m) : "none";
    var srcTxt = lvl === "none" ? "" : ("来源:" + ctxWinSrcLabel(lvl, m));
    ch.innerHTML = (m ? "当前模型 <b>" + escapeHtml(m) + "</b> 的上下文窗口:" : "尚未选择模型。默认窗口:") +
      "<b>" + num(win) + "</b> tokens(" + fmtCtxNum(win) + ")" +
      (srcTxt ? "·" + srcTxt : "") +
      ' <a href="#" id="ctx-window-refresh" style="color:var(--accent)">重新读取</a>';
    var a = $("ctx-window-refresh");
    if (a) a.addEventListener("click", function (e) {
      e.preventDefault();
      var target = (($("set-model") && $("set-model").value) || effectiveModel() || "").trim();
      fetchCtxFromProps(false, target).then(function (v) {
        updateModelsHint(); updateCtxMonitor();
        if (v) toast("已读取到上下文长度:" + num(v), "success", 2600);
        else if (!isListedModel(target) && !ctxMetaFor(target)) {
          toast("服务端没有「" + target + "」这个模型的信息,继续按当前设定 " + ctxWinKNow() + "K 估算", "warn", 3600);
        } else {
          toast("服务端未提供该模型的上下文长度,继续按当前设定 " + ctxWinKNow() + "K 估算", "info", 3000);
        }
      });
    });
  }
  /* 模型名 / 模型清单 / 服务端窗口一变,「上下文长度」控件的显示条件可能就变了 */
  syncCtxWinInputs();
}
function allModelOptions() {
  var map = {}, out = [];
  (state.fetchedModels || []).forEach(function (m) {
    if (typeof m === "string" && m.trim() && !map[m.trim()]) { map[m.trim()] = 1; out.push({ name: m.trim(), src: "服务器" }); }
  });
  return out;
}
function renderModelsInline() {
  var box = $("models-inline");
  if (!box) return;
  var opts = allModelOptions();
  if (!opts.length) {
    box.innerHTML = '<div class="hint" style="padding:10px 0">暂无数据</div>';
    return;
  }
  box.innerHTML = opts.map(function (o) {
    return '<button class="model-opt' + (o.name === state.settings.model ? " selected" : "") +
      '" data-name="' + escAttr(o.name) + '"><span class="mo-name">' + escapeHtml(o.name) +
      '</span><span class="mo-src">' + escapeHtml(o.src) + "</span>" +
      (o.name === state.settings.model ? icon("check", "sm") : "") + "</button>";
  }).join("");
  box.querySelectorAll(".model-opt").forEach(function (b) {
    b.addEventListener("click", function () { pickModel(b.getAttribute("data-name")); });
  });
}
function pickModel(name) {
  state.settings.model = name;
  if (conv) conv.model = name;
  $("set-model").value = name;
  saveSoon();
  updateTopbar();
  renderModelsInline();
  closeMask("model-modal");
  hideModelSuggest();
  refreshModelCtx(name);      // 切换模型后立刻刷新上下文窗口那一行
  ensureModelVision(name);    // 顺手确认这个模型吃不吃图片
  toast("已切换模型:" + name, "success", 1800);
}
function renderModelOptions(filter) {
  var box = $("model-options");
  var kw = (filter || "").toLowerCase();
  var opts = allModelOptions().filter(function (o) { return !kw || o.name.toLowerCase().indexOf(kw) > -1; });
  $("model-count").textContent = "共 " + allModelOptions().length + " 个模型";
  if (!opts.length) {
    box.innerHTML = '<div class="hint" style="padding:16px;text-align:center">' +
      (kw ? "没有匹配的模型。可直接按 Enter 使用「" + escapeHtml(filter) + "」" : "暂无模型,请点击下方「刷新」") + "</div>";
    return;
  }
  box.innerHTML = opts.map(function (o) {
    return '<button class="model-opt' + (o.name === effectiveModel() ? " selected" : "") +
      '" data-name="' + escAttr(o.name) + '"><span class="mo-name">' + escapeHtml(o.name) +
      '</span><span class="mo-src">' + escapeHtml(o.src) + "</span>" +
      (o.name === effectiveModel() ? icon("check", "sm") : "") + "</button>";
  }).join("");
  box.querySelectorAll(".model-opt").forEach(function (b) {
    b.addEventListener("click", function () { pickModel(b.getAttribute("data-name")); });
  });
}
function openModelPicker() {
  closeMenus();
  $("model-search").value = "";
  renderModelOptions("");
  openMask("model-modal");
  setTimeout(function () { try { $("model-search").focus(); } catch (e) {} }, 60);
  if (!(state.fetchedModels && state.fetchedModels.length)) fetchModels(false, true);
}
/* 从服务端返回的模型条目里挖上下文长度
   llama.cpp → data[].meta.n_ctx(实测 262144);其它服务端字段名五花八门,都试一遍。
   `n_ctx` / `n_ctx_train` 也直接认:llama.cpp 的 /props 把窗口放在
   default_generation_settings.n_ctx(顶层也可能有),旧候选表只认 meta.n_ctx ⇒ /props 那条
   读取链在「服务端不回 total_slots」时静默拿不到值 */
function extractCtxLen(m) {
  var cands = [
    m.n_ctx, m.n_ctx_train,
    m.meta && m.meta.n_ctx, m.meta && m.meta.n_ctx_train,
    m.context_length, m.context_window, m.max_context_length, m.max_context_tokens,
    m.max_input_tokens, m.details && m.details.context_length,
    m.top_provider && m.top_provider.context_length,
    m.limits && m.limits.max_context_window_tokens
  ];
  for (var i = 0; i < cands.length; i++) {
    var v = Number(cands[i]);
    if (isFinite(v) && v >= 512) return Math.round(v);
  }
  return 0;
}
function propsUrl() {
  var b = (state.settings.baseUrl || "").trim().replace(/\/+$/, "");
  if (!b) return "";
  return b.replace(/\/v1$/, "") + "/props";
}
/* 模型名归一化:去掉目录与扩展名,便于和服务端自报的名字比对 */
function baseModelName(v) {
  var s = String(v == null ? "" : v).trim();
  if (!s) return "";
  s = s.replace(/\\/g, "/");
  var i = s.lastIndexOf("/");
  if (i > -1) s = s.slice(i + 1);
  s = s.replace(/\.(gguf|safetensors|bin|pt|onnx|model)$/i, "");
  return s.toLowerCase();
}
function sameModelName(a, b) {
  var x = baseModelName(a), y = baseModelName(b);
  if (!x || !y) return false;
  return x === y;
}
/* 这个模型名是不是服务端在 /v1/models 里列出来的 */
function isListedModel(name) {
  var m = String(name || "").trim();
  if (!m) return false;
  var list = state.fetchedModels || [];
  for (var i = 0; i < list.length; i++) {
    if (list[i] === m || sameModelName(list[i], m)) return true;
  }
  return false;
}
/* 从 /props 里挖出「服务端当前加载的模型叫什么」 */
function propsModelName(j) {
  if (!j || typeof j !== "object") return "";
  var gens = j.default_generation_settings || {};
  var cands = [j.model_path, gens.model, gens.model_path, j.model, j.model_name, j.id,
    (j.model_info && (j.model_info.name || j.model_info.model_path))];
  for (var i = 0; i < cands.length; i++) {
    var s = String(cands[i] == null ? "" : cands[i]).trim();
    if (s) return s;
  }
  return "";
}
/* llama.cpp 的 /props 会报 n_ctx —— 但它报的是「服务端当前加载的那个模型」。
   所以只有确认服务端认识的模型名时才记录,绝不把别人的窗口挂到你手填的名字上。 */
async function fetchCtxFromProps(silent, modelName) {
  var url = propsUrl();
  var want = String(modelName || "").trim() || effectiveModel();
  if (!url) return 0;
  var to = timeoutSignal(8000);
  try {
    var res = await fetch(url, { headers: headersFor(false), signal: to.signal });
    if (!res.ok) return 0;
    var j = await res.json();
    var v = extractCtxLen(j) ||
      extractCtxLen(j.default_generation_settings || {}) ||
      Number(j.n_ctx) || Number(j.total_slots && j.default_generation_settings && j.default_generation_settings.n_ctx);
    v = Number(v);
    if (!isFinite(v) || v < 512) return 0;
    var id = propsModelName(j);
    if (id && !sameModelName(id, want)) {
      if (!silent) toast("服务端当前加载的是「" + id + "」,和「" + want + "」不是同一个模型,已忽略", "warn", 4200);
      return 0;
    }
    if (!id && !isListedModel(want)) {
      if (!silent) toast("服务端没有列出「" + want + "」这个模型,无法确认它的上下文长度", "warn", 4200);
      return 0;
    }
    setModelCtx(want, v, "server");
    saveSoon();
    return v;
  } catch (e) {
    if (!silent) toast("读取模型信息失败:" + friendlyError(e, url).split("\n")[0], "warn", 3600);
    return 0;
  } finally {
    to.abort();
  }
}
async function fetchModels(showToast, silent) {
  var url = apiUrl("models");
  if (!url) { if (!silent) toast("请先填写 Base URL", "warn"); return; }
  if (!silent) setConnFor(null, "busy", "拉取模型中…");
  var to = timeoutSignal(12000);
  try {
    var res = await fetch(url, { headers: headersFor(false), signal: to.signal });
    if (!res.ok) throw new Error("HTTP " + res.status + " " + safeJson(await res.text(), 200));
    var j = await res.json();
    var list = [], seen = {};
    function push(v) {
      v = String(v == null ? "" : v).trim();
      if (v && !seen[v]) { seen[v] = 1; list.push(v); }
    }
    /* 顺便把服务端给出的上下文窗口记下来,按模型名存;能看出视觉能力的也一并记下 */
    function scan(m) {
      if (!m || typeof m !== "object") return;
      var ctx = extractCtxLen(m);
      var v = modelVisionFlag(m);
      var names = [m.id, m.name, m.model];
      for (var i = 0; i < names.length; i++) {
        var nm = String(names[i] == null ? "" : names[i]).trim();
        if (!nm) continue;
        if (ctx) setModelCtx(nm, ctx, "server");
        if (v !== null) setVision(nm, v, "models");
      }
    }
    if (Array.isArray(j.data)) { j.data.forEach(scan); j.data.forEach(function (m) { if (m) push(m.id || m.name || m.model); }); }
    if (Array.isArray(j.models)) { j.models.forEach(scan); j.models.forEach(function (m) { if (m) push(m.name || m.model || m.id); }); }
    if (!list.length) throw new Error("响应中没有模型数据");
    state.fetchedModels = list;
    /* 服务端把模型列表说清楚了:顺手清掉之前误记成「服务端返回」、但服务端并不认识的模型窗口 */
    var bag = state.settings.modelCtx;
    if (bag) {
      var dropped = 0;
      for (var mk in bag) {
        if (!Object.prototype.hasOwnProperty.call(bag, mk)) continue;
        var known = false;
        for (var li = 0; li < list.length; li++) {
          if (list[li] === mk || sameModelName(list[li], mk)) { known = true; break; }
        }
        if (!known) { delete bag[mk]; dropped++; }
      }
      if (dropped) toolLogPush("dim", "已清理 " + dropped + " 条服务端不认识的模型窗口记录");
    }
    rebuildModelDatalist();
    saveState(true);
    renderModelsInline();
    if ($("model-modal").classList.contains("open")) renderModelOptions($("model-search").value);
    setConnFor(null, "ok", "已连接");
    if (!silent) toast("已获取 " + list.length + " 个模型", "success");
    /* 列表没带上下文长度时,再问一次 /props(非 llama.cpp 服务会 404,静默忽略) */
    if (!ctxMetaFor(effectiveModel())) await fetchCtxFromProps(true);
    ensureModelVision(effectiveModel());   // 清单没写视觉能力时自动探一次
  } catch (e) {
    setConnFor(null, "err", "拉取模型失败");
    if (showToast) toast("获取模型列表失败:" + friendlyError(e, url).split("\n")[0], "error", 4200);
  } finally {
    to.abort();
    updateCtxMonitor();
    updateModelsHint();
  }
}

/* ---- 连接测试 ---- */
async function testConnection() {
  saveSettingsFromModal(false, true);
  var box = $("test-result");
  box.className = "note show";
  box.textContent = "正在测试连接…";
  setConnFor(null, "busy", "测试中…");
  var url = state.settings.protocol === "openai" ? apiUrl("models") : apiUrl("messages");
  var t0 = Date.now();
  var to = timeoutSignal(20000);
  try {
    var detail = "";
    if (state.settings.protocol === "openai") {
      var r = await fetch(apiUrl("models"), { headers: headersFor(false), signal: to.signal });
      var ms = Date.now() - t0;
      if (r.ok) {
        var j = await r.json();
        var n = (j.data || j.models || []).length;
        detail = "✅ 连接成功 · " + ms + " ms · 返回 " + n + " 个模型";
      } else {
        var txt = safeJson(await r.text(), 200);
        throw new Error("HTTP " + r.status + (txt ? ":" + txt : ""));
      }
    } else {
      if (!effectiveModel()) throw new Error("请先选择模型");
      var r2 = await fetch(apiUrl("messages"), {
        method: "POST", headers: headersFor(), signal: to.signal,
        body: JSON.stringify({ model: effectiveModel(), max_tokens: 8, messages: [{ role: "user", content: "ping" }] })
      });
      var ms2 = Date.now() - t0;
      var j2 = await r2.json();
      if (!r2.ok) throw new Error("HTTP " + r2.status + ":" + safeJson(JSON.stringify(j2), 220));
      var out = (j2.content || []).filter(function (b) { return b.type === "text"; })
        .map(function (b) { return b.text; }).join("");
      detail = "✅ 连接成功 · " + ms2 + " ms · 模型回复:" + (out || "(空响应)").slice(0, 40);
    }
    box.className = "note show ok";
    box.textContent = detail;
    setConnFor(null, "ok", "已连接");
  } catch (e) {
    box.className = "note show err";
    box.textContent = "❌ " + friendlyError(e, url);
    setConnFor(null, "err", "连接失败");
  } finally {
    to.abort();
  }
}

/* ---- 环境面板 ---- */
var ENV_CHECKS = [
  ["Promise / fetch", function () { return typeof Promise === "function" && typeof fetch === "function"; }],
  ["流式读取 (ReadableStream)", function () { return CAP.stream; }],
  ["中途停止 (AbortController)", function () { return CAP.abort; }],
  ["剪贴板 API", function () { return CAP.clipboard; }],
  ["语音合成(朗读)", function () { return CAP.speech; }],
  ["语音识别(语音输入)", function () { return CAP.recognition; }],
  ["跨标签页通信 (BroadcastChannel)", function () { return CAP.broadcast; }],
  ["工具沙箱 (Web Worker)", function () { return CAP.worker; }],
  ["Blob 下载", function () { return CAP.objectUrl; }],
  ["Markdown 引擎 (marked)", function () { return hasMarked; }],
  ["HTML 净化 (DOMPurify)", function () { return hasPurify; }],
  ["语法高亮 (highlight.js)", function () { return hasHljs; }],
  ["公式渲染 (KaTeX)", function () { return hasKatex; }],
  ["本地存储 (localStorage)", function () {
    try { localStorage.setItem("__t", "1"); localStorage.removeItem("__t"); return true; } catch (e) { return false; }
  }]
];
/* ---- 环境面板:把能查到的信息都摊开,方便排故与上报(只读;任何异常都降级成「—」) ---- */
function safeGet(fn, dflt) {
  try { var v = fn(); return (v === undefined || v === null) ? dflt : v; } catch (e) { return dflt; }
}
function kvHtml(pairs) {
  return pairs.map(function (p) {
    var v = p[1];
    if (v === undefined || v === null || v === "") v = "—";
    return "<dt>" + escapeHtml(p[0]) + "</dt><dd" + (p[2] ? " class='" + p[2] + "'" : "") + ">" + escapeHtml(String(v)) + "</dd>";
  }).join("");
}
function yn(v) { return v ? "是" : "否"; }
function msgTotal() {
  var n = 0;
  state.conversations.forEach(function (c) { n += (c.messages || []).length; });
  return n;
}
/* WebGL/WebGL2 与显卡型号(某些浏览器屏蔽型号,拿不到就留空) */
function glInfo() {
  var out = { webgl: false, webgl2: false, vendor: "", renderer: "", maxTex: "" };
  var c = safeGet(function () { return document.createElement("canvas"); }, null);
  if (!c || !c.getContext) return out;
  var g2 = safeGet(function () { return c.getContext("webgl2"); }, null);
  out.webgl2 = !!g2;
  var g = g2 || safeGet(function () { return c.getContext("webgl") || c.getContext("experimental-webgl"); }, null);
  if (!g) return out;
  out.webgl = true;
  var dbg = safeGet(function () { return g.getExtension("WEBGL_debug_renderer_info"); }, null);
  if (dbg) {
    out.vendor = String(safeGet(function () { return g.getParameter(dbg.UNMASKED_VENDOR_WEBGL); }, "") || "");
    out.renderer = String(safeGet(function () { return g.getParameter(dbg.UNMASKED_RENDERER_WEBGL); }, "") || "");
  }
  if (!out.renderer) out.renderer = String(safeGet(function () { return g.getParameter(g.RENDERER); }, "") || "");
  out.maxTex = safeGet(function () { return g.getParameter(g.MAX_TEXTURE_SIZE); }, "");
  return out;
}
function envSysPairs() {
  var nav = navigator;
  var uad = nav.userAgentData || null;
  var conn = nav.connection || nav.mozConnection || nav.webkitConnection || null;
  var brands = (uad && uad.brands) ? uad.brands.map(function (b) { return b.brand + " " + b.version; }).join(" / ") : "";
  var net = "";
  if (conn) {
