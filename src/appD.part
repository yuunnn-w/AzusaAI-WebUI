  }
  var buf = [], cur = null, no = 0;
  /* 段 = 「cur 这个锚行 + 它之前累积的正文」:锚行落在段尾(交错时 = 正文之后接该段的图 ⇒ 与文档序一致);
     flush 一律清掉 cur,免得尾段错挂到上一个锚上 */
  function flush() {
    var body = buf.join("\n").replace(/\s+$/, "");
    if (cur) out.segs.push({ key: cur.key, head: cur.head, text: body, images: [] });
    else if (body) out.segs.push({ key: "", head: "", text: body, images: [] });
