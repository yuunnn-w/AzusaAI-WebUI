  if (!models || !chat) { out.error = "未配置 Base URL"; return Promise.resolve(out); }
  var settled = false;   /* 兜底可能先胜出:此后 probe 链仍在跑,写入一律丢弃(交出去的读数不许事后被改) */
  var body = JSON.stringify({ model: out.model, messages: [{ role: "user", content: "ping" }], max_tokens: 1, stream: false });
