function corsFamilyText(fam) { return CORS_FAMILY_TEXT[fam] || CORS_FAMILY_TEXT.unknown; }
function corsFamilyAdvice(fam) { return corsFamilyText(fam).advice; }
/* 服务端指引(诊断面板与 docs/DEVELOPMENT.md 用;含 file:// 下 Origin=null 与「错误响应也要带头」两条) */
function corsServerGuideText() {
  return [
    "服务端需要补的响应头(缺哪条补哪条;补齐后浏览器就不再拦):",
    "· Access-Control-Allow-Origin: *   (从 file:// 打开时浏览器发的 Origin 是 null,用 * 最省事)",
    "· Access-Control-Allow-Headers: Content-Type, Authorization, x-api-key, anthropic-version, anthropic-dangerous-direct-browser-access",
    "· Access-Control-Allow-Methods: POST, GET, OPTIONS",
    "· OPTIONS 预检直接返回 204(不要 500、也不要只在 200 里回 JSON)",
    "· 错误响应(4xx/5xx)同样要带 Access-Control-Allow-Origin —— nginx 用 add_header ... always;,",
    "  Apache / 自研网关在 500 与 ErrorDocument 分支也要补(只给 200 加头是最常见的漏点)",
    "另一条路:让页面与接口同源(同源反向代理把 /v1 转到后端),浏览器就不做跨域检查"
  ];
}
/* 兼容模式的双条件门控(协议 × 是否有 Key):两条都是「必然无效」的死路,不是保守估计 */
function corsBypassGate() {
  if (state.settings.protocol === "anthropic") {
    return { ok: false, reason: "该模式仅对 OpenAI 兼容协议有效:Anthropic 协议必须带 anthropic-version 与 anthropic-dangerous-direct-browser-access 两个自定义头(与有没有 Key 无关),一发就是非简单请求 ⇒ 必然无效。" };
  }
  if (String(state.settings.apiKey || "").trim()) {
    return { ok: false, reason: "该模式要求不带任何自定义头,而 API Key 会变成 Authorization(OpenAI)或 x-api-key(Anthropic)⇒ 必然无效。请先清空 API Key,或让服务端放行预检。" };
  }
