      var url = "";
      try { url = c.toDataURL(format, qs[j]); } catch (e) { continue; }
      if (!url || String(url).indexOf("data:") !== 0) continue;
      var payload = dataUrlPayload(url);
      var bytes = Math.round(payload.length * 3 / 4);
      if (bytes > hardMax) continue;                    /* 单张硬顶:超过即不采 */
      return {
