          try { dataUrl = (q == null) ? canvas.toDataURL(encMime) : canvas.toDataURL(encMime, q); }
          catch (e3) { continue; }
          if (!dataUrl || dataUrl.indexOf("data:") !== 0) continue;
          var payload = dataUrlPayload(dataUrl);
          var bytes = Math.round(payload.length * 3 / 4);
          if (bytes > hardMax) continue;                       /* 单张硬顶:超过即不采 */
          if (!best || bytes < best.bytes) best = { mime: encMime, data: payload, w: cw, h: chh, bytes: bytes };
          if (bytes <= budget) break;
        }
        if (best && best.bytes <= budget) break;
      }
      if (!best) throw new Error("ENCODE");
      if (best.bytes >= size && best.w >= w0 && best.h >= h0) {   /* 压不动:回退原字节(仍受硬顶约束) */
        /* 但源 mime 不在 SAFE 集时**不回退**:交付 mime 必须收敛到 {png,jpeg} ∪ SAFE_IMG_MIME,
           宁可交付略大的重编码,也不把下游(接口/模型侧)不认的格式递出去(best ≤ hardMax,见上循环) */
        if (SAFE_IMG_MIME[mimeIn]) {
          if (size > hardMax) throw new Error("HUGE");
          return origBytes(w0, h0);
        }
      }
      if (best.bytes > hardMax) throw new Error("HUGE");
      return { ok: true, mime: best.mime, data: best.data, w: best.w, h: best.h, bytes: best.bytes,
               srcW: w0, srcH: h0, scaled: (best.w < w0 || best.h < h0) };
    }).then(function (r) {
      if (url) { try { URL.revokeObjectURL(url); } catch (e4) {} }
      return r;
    }, function (e) {
      if (url) { try { URL.revokeObjectURL(url); } catch (e4) {} }
      var msg = wsMsg(e);
      if (msg.indexOf("PIXEL:") === 0) {
        return fail("图片像素过大(" + msg.slice(6) + "),超过本工具的图片处理上限;可用 ExecutePython(已装 Pillow)先缩小/裁剪,再 Read 那份小图");
      }
      if (msg === "HUGE") {
        return fail("已按最大压缩仍超出本工具图片上限(" + fmtBytes(hardMax) + ");请先裁剪/缩小后再 Read(可用 ExecutePython 的 Pillow)");
      }
      if (msg === "ENCODE" || /无法解码|尺寸无效/.test(msg)) {
        /* 解不开的常见是 TIFF(浏览器 <img> 不支持):文案里点名,并给出 Pillow 逃生舱 */
        var label = (/tiff?/i.test(mimeIn) || /\.tiff?$/i.test(String(opts.path || ""))) ? "TIFF" : "";
        return fail("浏览器无法解码这张图片(" + (label || mimeIn || "未知格式") + ");可用 ExecutePython 的 Pillow 转成 PNG/JPEG 后再 Read");
      }
      return fail("图片处理失败:" + msg);
    });
  });
}

/* ---- 自定义标签页图标(设置 → 外观):解码 → 居中剪方 → ≤FAVICON_MAX_SIDE(不放大)→ PNG ----
   用户原始文件(含 SVG 里的脚本)全程只经过 FileReader → <img> → canvas → toDataURL,
   既不落库也不进 DOM;超 FAVICON_DATA_MAX 时依次降 128 / 96px 重试,仍超则拒收(不落库) */
function faviconDraw(img, sw, sh, side, size) {
  var c = document.createElement("canvas");
  c.width = c.height = size;
  var x = c.getContext("2d");
  if (x.imageSmoothingEnabled !== undefined) x.imageSmoothingEnabled = true;
  if (x.imageSmoothingQuality !== undefined) x.imageSmoothingQuality = "high";
  x.drawImage(img, Math.round((sw - side) / 2), Math.round((sh - side) / 2), side, side, 0, 0, size, size);
  return c.toDataURL("image/png");
}
function prepareFavicon(file) {
  return new Promise(function (resolve, reject) {
    if (!file) { reject(new Error("没有选择图片")); return; }
    if (file.size > FAVICON_SRC_MAX) {
      reject(new Error("图片超过 " + fmtBytes(FAVICON_SRC_MAX) + ",请换一张更小的")); return;
    }
    var ext = extOf(file.name), mime = (file.type || "").toLowerCase();
    if (!/^image\//.test(mime) && IMAGE_EXT.indexOf(ext) === -1) {
      reject(new Error("请选择图片文件(PNG / JPEG / GIF / WebP / SVG 等)")); return;
    }
    if (!canvasOK()) { reject(new Error("当前浏览器不支持图片处理,无法生成图标")); return; }
    readAs(file, "data").then(loadImageEl).then(function (img) {
      var w = img.naturalWidth || img.width, h = img.naturalHeight || img.height;
      if (!w || !h) throw new Error("浏览器无法解码这张图片");
      var side = Math.min(w, h);
      var target = Math.max(1, Math.min(FAVICON_MAX_SIDE, side));   // 不放大:小图保持原尺寸
      var out = faviconDraw(img, w, h, side, target);
      var floors = [128, 96];
      for (var i = 0; i < floors.length && out.length > FAVICON_DATA_MAX; i++) {
        var t = Math.min(floors[i], target);
        if (t >= target) continue;
        target = t; out = faviconDraw(img, w, h, side, target);
      }
      if (out.length > FAVICON_DATA_MAX) throw new Error("图片过于复杂,处理后仍超过存储上限,请换一张更简单的图片");
      resolve(out);
    }).catch(reject);
  });
}
/* 处理并应用一张用户图片(点击选择 / 拖放共用);成功后即时生效并落盘 */
function applyFaviconFile(file) {
  toast("正在处理图片…", "info", 1200);
  prepareFavicon(file).then(function (dataUri) {
    state.settings.customIcon = dataUri;
    applyAppearance(); saveSoon(); syncFaviconUI();
    toast("标签页图标已更新", "success");
  }).catch(function (e) {
    syncFaviconUI();
    toast(e && e.message ? e.message : "图标处理失败", "error", 3600);
  });
}
/* 同步「设置 → 外观」的图标预览与状态文案(预览块始终显示当前生效的图标) */
function syncFaviconUI() {
  var img = $("fav-preview-img"), cur = $("fav-cur");
  if (!img || !cur) return;
  var custom = state.settings.customIcon || "";
  var can = canvasOK();
  img.src = custom || DEFAULT_FAVICON;
  if (!can) cur.textContent = "当前浏览器不支持图片处理,无法自定义图标";
  else cur.textContent = custom ? ("自定义图标(" + fmtBytes(custom.length) + ")") : "默认图标(青色小猫)";
  var up = $("btn-fav-upload");
  if (up) up.disabled = !can;
  dskSyncUI();
}

/* ================= 桌面快捷方式(.url + 自定义 .ico):需求 8 =================
   `.html` 文件**本身**的图标由系统按「扩展名 → 文件类型 → 注册表图标」决定,网页无法改写它;
   可行通道 = 生成 Windows 原生 InternetShortcut(.url),其 IconFile 指向我们按内容哈希命名的 .ico。
   三条通道:① 两次下载(.ico / .url;主干,永远可用) ② showDirectoryPicker 一键写入(能力 + 协议
   双门控,不支持则按钮 hidden) ③ 手动方式(界面文案兜底,任何浏览器可用)。
   格式契约:.url 恰 4 行、CRLF;内容全 ASCII ⇒ UTF-8(无 BOM),含非 ASCII ⇒ UTF-16LE + BOM;
   IconFile **必须是绝对路径**(同目录相对名实测无效);路径含控制字符或方括号 ⇒ 拒绝生成。
   命名 `<base>-icon-<crc8>.ico`(crc8 = ICO 内容的 CRC32 十六进制)⇒ 换图标即换文件名,天然绕开
   资源管理器图标缓存。不新增设置项 / 不新增 IDB 存储区 / 不动 schema / 不暴露任何全局接口。 */
var DSK_ICO_SIZES = [16, 32, 48, 64, 128, 256];   /* ≤128 写 DIB 条目,256 写 PNG 条目 */
var DSK_ICO_DIB_MAX = 128;
/* SVG 源的预光栅化边长 = 最大档尺寸(不再放大,已够各档下采样)。 */
var DSK_ICO_RASTER_SIDE = 256;
var DSK_URL_NAME_EXT = ".url";
/* 图标文件名缓存:src 一旦**尝试过**(含失败)就记下 —— 否则 dskSyncUI() → 后台构建 → 完成后再进
   dskSyncUI() 会自我重入成死循环。 */
var DSK_ICON_CACHE = { src: null, name: "" };
var DSK_ICON_PENDING = null;

function dskSrcDataUri() { return state.settings.customIcon || DEFAULT_FAVICON; }
function dskSrcLabel() {
  var custom = state.settings.customIcon || "";
  return custom ? ("自定义图标(" + fmtBytes(custom.length) + ")") : "默认图标(青色小猫)";
}
/* file:// 的 pathname/host → Windows 路径。百分号解码失败(畸形转义) ⇒ 整体放弃、返回 null,
   由调用方给出可读原因;host 非空 = UNC(``file://server/share/a.html`` → ``\\server\share\a.html``)。 */
function dskPathToWin(pathname, host) {
  if (!pathname || typeof pathname !== "string") return null;
  var raw = pathname.split("/"), out = [], i, s;
  for (i = 0; i < raw.length; i++) {
    s = raw[i];
    if (!s) continue;
    try { s = decodeURIComponent(s); } catch (e) { return null; }
    if (!s) continue;
    out.push(s);
  }
  if (!out.length) return null;
  var joined = out.join("\\");
  var h = String(host == null ? "" : host);
  return h ? ("\\\\" + h + "\\" + joined) : joined;
}
function dskDirOfWinPath(p) {
  var s = String(p == null ? "" : p);
  var i = s.lastIndexOf("\\");
  return i < 0 ? "" : s.slice(0, i);
}
/* 本页文件名去扩展名(即 .ico / .url 的名字前缀);非 file:// 或解析异常 ⇒ 固定兜底名。
   方括号与控制字符会毁掉 Windows 文件名,一并换成下划线。 */
function dskBaseName() {
  var name = "azusa-webui";
  try {
    if (String(location.protocol) === "file:") {
      var parts = String(location.pathname || "").split("/");
      var last = parts.length ? parts[parts.length - 1] : "";
      last = last.replace(/\.html?$/i, "");
      if (last) {
        try { last = decodeURIComponent(last); } catch (e) { last = ""; }
        last = last.replace(/[\\\/:*?"<>|\x00-\x1f\x7f]/g, "_");
        if (last) name = last;
      }
    }
  } catch (e2) {}
  return name;
}
/* 8 位小写十六进制、前导零补齐(= 32 位 CRC32 的十六进制)。ES5 口径:不用 padStart。 */
function dskCrc8Hex(bytes) {
  var h = (wsCrc32(bytes) >>> 0).toString(16);
  return ("0000000" + h).slice(-8);
}
function dskIconFileName(icoBytes) { return dskBaseName() + "-icon-" + dskCrc8Hex(icoBytes) + ".ico"; }
function dskShortcutFileName() { return dskBaseName() + DSK_URL_NAME_EXT; }
/* -> { text, asciiOnly } | null(null = 卫生检查拒绝)。IconFile 里的 CR/LF/控制字符或方括号可以伪造
   出额外的 `.url` 行(行注入) ⇒ 直接拒绝,由调用方提示改用「手动方式」。 */
function dskShortcutText(href, iconPath) {
  var h = String(href == null ? "" : href);
  var ico = String(iconPath == null ? "" : iconPath);
  if (!h || !ico) return null;
  if (/[\x00-\x1f\x7f\[\]]/.test(ico)) return null;
  if (/[\x00-\x1f\x7f]/.test(h)) return null;
  var text = "[InternetShortcut]\r\nURL=" + h + "\r\nIconFile=" + ico + "\r\nIconIndex=0\r\n";
  return { text: text, asciiOnly: !/[^\x00-\x7F]/.test(text) };
}
/* 全 ASCII ⇒ UTF-8 无 BOM;含非 ASCII(中文用户名 / 中文目录)⇒ UTF-16LE + BOM。
   实测:ANSI / UTF-8 都解析不了中文路径,UTF-16 可以(逐字节手写,不借 TextEncoder 的转码)。 */
function dskShortcutBytes(text) {
  var s = String(text == null ? "" : text);
  if (!/[^\x00-\x7F]/.test(s)) return new TextEncoder().encode(s);
  var out = new Uint8Array(s.length * 2 + 2);
  out[0] = 0xFF; out[1] = 0xFE;
  for (var i = 0; i < s.length; i++) {
    var c = s.charCodeAt(i);
    out[2 + i * 2] = c & 0xFF;
    out[2 + i * 2 + 1] = (c >>> 8) & 0xFF;
  }
  return out;
}
/* 源图规格化 —— **SVG 源必须先过这里**。SVG 源没有可信的位图固有尺寸(默认小猫实测
   naturalWidth/Height = 150×150),而「显式源矩形」的 9 参 drawImage 对 SVG 源在 Chromium(实测
   122)下是:先按【目标尺寸】光栅化,再把源矩形按【固有尺寸】坐标系解释 ⇒ 图案只占左上角
   s²/固有边长 个像素(实测六档 16→4 / 32→49 / 48→247 / 64→742 / 128→11455,只有 256 正常)。
   对策 = 先按最大档边长把 SVG 光栅化成**真正的位图**(矢量源在这一步按该尺寸重绘,不失真),
   之后一律走位图源的既有路径 —— 位图源的 9 参(含中心裁方)实测正确。
   非 SVG(用户自定义位图图标)原样返回 ⇒ 那条路径字节级不变(不回归)。
   非方形 SVG 按固有宽高比放进 n×n,再由 dskIcoDraw 走中心裁方,与位图源同口径。 */
function dskIconSource(img) {
  var src = "";
  try { src = String(dskSrcDataUri() || ""); } catch (e) { src = ""; }
  if (!/^data:image\/svg\+xml/i.test(src)) return img;
  var iw = img.naturalWidth || img.width || 0;
  var ih = img.naturalHeight || img.height || 0;
  var n = DSK_ICO_RASTER_SIDE, cw = n, ch = n;
  if (iw > 0 && ih > 0 && iw !== ih) {
    if (iw > ih) ch = Math.max(1, Math.round(n * ih / iw));
    else cw = Math.max(1, Math.round(n * iw / ih));
  }
  var c = document.createElement("canvas");
  c.width = cw; c.height = ch;
  var g = c.getContext("2d");
  if (g.imageSmoothingEnabled !== undefined) g.imageSmoothingEnabled = true;
  if (g.imageSmoothingQuality !== undefined) g.imageSmoothingQuality = "high";
  g.clearRect(0, 0, cw, ch);
  g.drawImage(img, 0, 0, cw, ch);   /* 4 参 = 整幅 → 目标尺寸;对 SVG 源这才是正确形态 */
  return c;
}
/* ---- ICO(ICONDIR):6 条目(16/32/48/64/128 = DIB,256 = PNG) ----
   取中心正方区域再缩放(与既有 faviconDraw 同口径)⇒ 无论源图宽高比如何都不会被拉伸。
   ⚠️ 本函数只对**位图源**正确;SVG 源必须先经 dskIconSource() 光栅化(见其注释)。 */
function dskIcoDraw(img, size) {
  var iw = img.naturalWidth || img.width || size;
  var ih = img.naturalHeight || img.height || size;
  var side = Math.min(iw, ih) || size;
  var dx = Math.round((iw - side) / 2), dy = Math.round((ih - side) / 2);
  var c = document.createElement("canvas");
  c.width = c.height = size;
  var g = c.getContext("2d");
  if (g.imageSmoothingEnabled !== undefined) g.imageSmoothingEnabled = true;
  if (g.imageSmoothingQuality !== undefined) g.imageSmoothingQuality = "high";
  g.clearRect(0, 0, size, size);
  g.drawImage(img, dx, dy, side, side, 0, 0, size, size);
  return c;
}
/* DIB 条目 = BITMAPINFOHEADER(40B) + XOR 位图(自下而上 BGRA,alpha 直存) + AND 掩码(自下而上,
   每行 ((w+31)>>5)*4 字节,alpha==0 置 1) */
function dskIcoDibEntry(img, size) {
  var c = dskIcoDraw(img, size);
  var px = c.getContext("2d").getImageData(0, 0, size, size).data;
  var maskRow = ((size + 31) >> 5) * 4, xorLen = size * size * 4, maskLen = maskRow * size;
  var out = new Uint8Array(40 + xorLen + maskLen), dv = new DataView(out.buffer);
  dv.setUint32(0, 40, true);            /* biSize */
  dv.setInt32(4, size, true);           /* biWidth */
  dv.setInt32(8, size * 2, true);       /* biHeight = 2×高度(XOR + AND 两张图叠放) */
  dv.setUint16(12, 1, true);            /* biPlanes */
  dv.setUint16(14, 32, true);           /* biBitCount = 32bpp BGRA */
  /* biCompression / biSizeImage / xppm / yppm / clrUsed / clrImportant 全 0(Uint8Array 已置零) */
  var o = 40, row, col, i;
  for (row = size - 1; row >= 0; row--) {
    for (col = 0; col < size; col++) {
      i = (row * size + col) * 4;
      out[o] = px[i + 2]; out[o + 1] = px[i + 1]; out[o + 2] = px[i]; out[o + 3] = px[i + 3];
      o += 4;
    }
  }
  var m = 40 + xorLen;
  for (row = 0; row < size; row++) {
    var sy = size - 1 - row;
    for (col = 0; col < size; col++) {
      if (px[(sy * size + col) * 4 + 3] === 0) out[m + row * maskRow + (col >> 3)] |= (0x80 >> (col & 7));
    }
  }
  return out;
}
function dskIcoPngEntry(img, size) {
  var c = dskIcoDraw(img, size);
  var b64 = String(c.toDataURL("image/png")).split(",")[1] || "";
  var bin = atob(b64), out = new Uint8Array(bin.length);
