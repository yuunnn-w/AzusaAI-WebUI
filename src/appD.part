/* 附件用词(单一取词点):"PDF"/"文档"/"演示文稿"/"表格" —— 按 kind/subtype 取,别硬编码 PDF */
function attachKindWord(f) {
  if (!f) return "附件";
  if (f.kind === "pdf") return "PDF";
  if (f.kind === "image") return "图片";
  var st = String(f.subtype || "").toLowerCase();
  if (st === "docx" || st === "doc") return "文档";
  if (st === "pptx" || st === "ppt") return "演示文稿";
  if (st === "xlsx" || st === "xls") return "表格";
  return "办公文档";
}
/* 渲染分辨率读数(唯一来源):"150 DPI" 这串字样只在这里拼,五处调用方不再各自写 pdfDpi() */
function renderDpiText() { return pdfDpi() + " DPI"; }
/* 附件模式文案的唯一来源(方案 §2.7-①;五处共用:chip / 气泡卡片 / 预览 meta / office 预览分支 /
   请求体头部信息行)。判据只看「实际发了什么」(mode/images/ocrImgs/renderSrc)+「用户选的档」(srcMode),
   **不重读设置**;降级原因(why)与一次性 toast 由 decideAttachPlan 给,这里只描述发送形态。 */
function attachModeLabel(f) {
  if (!f) return "";
  var src = f.srcMode || f.mode;
  var what = attachKindWord(f);
  /* 图片张数:**气泡卡片 / 预览面拿到的是 attachMetaOf 元数据**(没有 images 数组,只有 imgCount)
     ⇒ 一律回退 imgCount(P1-1:漏了它就会把"混合"说成"该格式不支持图片档") */
  var nImg = (f.images && f.images.length) ? f.images.length : (Number(f.imgCount) || 0);
  function imgWord() {                 /* 图从哪来(单一取词点) */
    return f.renderSrc === "pages" ? "页图" : (f.renderSrc === "drawn" ? "表格图" : "图");
  }
  if (f.mode === "image") {
    if (f.renderSrc === "drawn") return "图片模式(本机绘制的表格图,已按图片发给模型;仅数据网格,不含原表格式)";
    return "图片模式(" + renderDpiText() + ",已按图片发给模型)";
  }
  if (f.mode === "both" && nImg) {
    return "混合模式(文字 + " + nImg + " 张" + imgWord() + "按序发送)";
  }
  if (f.ocrImgs) {
    if (src === "text") return "纯文本模式(这份" + what + "没有文字层,图片已本机 OCR)";
    return "混合模式(图片已本机 OCR 后按原序插入)";
  }
