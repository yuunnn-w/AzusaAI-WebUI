  if (src === "text" && !hasText && nImg) {
    var r5 = renderFor(false);
    return mk(nonVis ? "text" : "both", nonVis ? "ocr" : "send", r5, "noimage",
      nonVis ? ("这份" + word + "只有图片,已改用本机 OCR 提取图片内容")
