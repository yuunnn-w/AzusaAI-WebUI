    ["屏幕方向", safeGet(function () { return screen.orientation && screen.orientation.type; }, mq("(orientation: portrait)") === "是" ? "竖屏" : "横屏")],
    ["深色偏好 / 减少动效", mq("(prefers-color-scheme: dark)") + " / " + mq("(prefers-reduced-motion: reduce)")],
    ["Canvas 2D", canvasOK() ? "可用" : "不可用"],
    ["WebGL", gl.webgl ? (gl.webgl2 ? "可用(WebGL2)" : "可用(WebGL1)") : "不可用"],
