  return out;
}
function dskIcoBuildBytes(img) {
  var entries = [], i, n = DSK_ICO_SIZES.length;
  var src = dskIconSource(img);   /* SVG 源先光栅化成位图(一次),再走既有的位图路径 */
  for (i = 0; i < n; i++) {
    entries.push(DSK_ICO_SIZES[i] <= DSK_ICO_DIB_MAX ? dskIcoDibEntry(src, DSK_ICO_SIZES[i])
                                                     : dskIcoPngEntry(src, DSK_ICO_SIZES[i]));
  }
  var head = 6 + 16 * n, total = head;
  for (i = 0; i < n; i++) total += entries[i].length;
  var out = new Uint8Array(total), dv = new DataView(out.buffer);
  dv.setUint16(0, 0, true);            /* reserved */
  dv.setUint16(2, 1, true);            /* type = 1(图标) */
  dv.setUint16(4, n, true);            /* count */
  var off = head;
  for (i = 0; i < n; i++) {
    var e = 6 + i * 16, sz = DSK_ICO_SIZES[i];
    out[e] = sz >= 256 ? 0 : sz;       /* 目录项宽/高:256 用 0 表示 */
    out[e + 1] = sz >= 256 ? 0 : sz;
    /* out[e+2] colors / out[e+3] reserved 保持 0 */
    dv.setUint16(e + 4, 1, true);      /* planes */
    dv.setUint16(e + 6, 32, true);     /* bitCount */
    dv.setUint32(e + 8, entries[i].length, true);
    dv.setUint32(e + 12, off, true);
    off += entries[i].length;
  }
  var p = head;
  for (i = 0; i < n; i++) { out.set(entries[i], p); p += entries[i].length; }
  return out;
}
function dskIconBuild() {
  var kind = state.settings.customIcon ? "custom" : "default";
  return loadImageEl(dskSrcDataUri()).then(function (img) {
    var bytes = dskIcoBuildBytes(img);
    return { bytes: bytes, name: dskIconFileName(bytes), srcKind: kind };
  });
}
/* showDirectoryPicker 的门控(能力探测;协议门另在 dskState 里)。 */
function dskCanPick() {
  try { return typeof window.showDirectoryPicker === "function"; } catch (e) { return false; }
}
/* 单一状态源:UI、文案、按钮可用性、写入通道可见性都从它读。 */
function dskState() {
  var proto = "", href = "", pathname = "", host = "";
  try {
    proto = String(location.protocol || "");
    href = String(location.href || "");
    pathname = String(location.pathname || "");
    host = String(location.host || "");
  } catch (e) {}
  var base = dskBaseName();
  var isFile = (proto === "file:");
  var iconName = (DSK_ICON_CACHE.src === dskSrcDataUri() && DSK_ICON_CACHE.name) ? DSK_ICON_CACHE.name : "";
  var dir = "", ok = false, reason = "", nonAscii = false;
  if (!isFile) {
    reason = "桌面快捷方式只对 file:// 打开的单文件版本有效(当前协议:" + (proto || "未知") + ")";
  } else {
    var full = dskPathToWin(pathname, host);
    dir = full ? dskDirOfWinPath(full) : "";
    if (!dir) {
      reason = "无法从当前地址解析出本机路径,请改用「手动方式」";
    } else {
      /* crc8 只含十六进制字符 ⇒ 用占位名判 nonAscii 与用真实名**等价**,不必等图标构建完成 */
      var probe = dskShortcutText(href, dir + "\\" + (iconName || (base + "-icon-00000000.ico")));
      if (!probe) reason = "当前路径含不允许的字符,请改用「手动方式」";
      else { ok = true; nonAscii = !probe.asciiOnly; }
    }
  }
  return {
    ok: ok, reason: reason, dir: dir, href: href, base: base,
    iconName: iconName, iconReady: !!iconName,
    urlName: base + DSK_URL_NAME_EXT,
    srcLabel: dskSrcLabel(),
    canWrite: ok && dskCanPick(),
    nonAscii: nonAscii
  };
}
function dskHintText(st, iconName) {
  var dir = st.dir || "(本页所在文件夹)";
  var s = "";
  s += "① 先把 " + st.base + ".html 放到最终位置(如桌面)再生成。② 下载 .ico 与 .url。" +
       "③ 把两个文件都放到 " + dir + "。④ 把 " + st.urlName + " 拖到桌面。⑤ 图标没变就按 F5。\n";
  s += "图标会引用 " + dir + "\\" + iconName + " —— 请把 .ico 留在该文件夹里(换文件夹就把 .ico 一起搬过去)。\n";
  if (st.canWrite) s += "本浏览器支持直接写入:点「写入文件夹…」选中 " + dir + ",两个文件一次写好(也可以只用下载)。\n";
  s += "`.html` 文件本身的图标由系统按文件类型决定,网页无法改写它;桌面上带自定义图标的是 `.url` 快捷方式。\n";
  s += "手动方式(任何浏览器都行):下载 .ico → 右键 `.html`「发送到 → 桌面快捷方式」→ 右键该快捷方式「属性 → 更改图标」→ 选中 .ico。\n";
  s += "最干净的放法:`.html` 与 `.ico` 放进一个文件夹,桌面只留 `.url`。\n";
  s += "若下载后的文件名变成 `.download`(新版 Chrome 把 `.url` 当危险扩展名改名),手动改回 `.url` 即可;" +
       "`.url` 双击由系统默认浏览器打开(不一定是本浏览器)。";
  return s;
}
/* 图标文件名的后台预热(文件名的 crc8 来自 ICO 内容 ⇒ 必须先渲染一次) */
function dskEnsureIconName() {
  var src = dskSrcDataUri();
  if (DSK_ICON_CACHE.src === src) return;
  if (DSK_ICON_PENDING === src) return;
  DSK_ICON_PENDING = src;
  dskIconBuild().then(function (r) {
    DSK_ICON_PENDING = null;
    DSK_ICON_CACHE = { src: src, name: r.name };
    dskSyncUI();
  }).catch(function () {
    DSK_ICON_PENDING = null;
    DSK_ICON_CACHE = { src: src, name: "" };
    dskSyncUI();
  });
}
/* 状态行 + 步骤文案 + 按钮可用性(幂等;由 syncFaviconUI 在启动/改图标时调用) */
function dskSyncUI() {
  var st = dskState();
  var el = $("dsk-state"), hint = $("dsk-hint");
  if (!el) return;
  var iconName = st.iconReady ? st.iconName : (st.base + "-icon-<crc8>.ico");
  var lines = [];
  if (!st.ok) lines.push(st.reason);
  else if (st.nonAscii) lines.push("当前路径含中文等非 ASCII 字符:快捷方式按 UTF-16LE+BOM 编码,若不生效请改用「手动方式」。");
  lines.push("图标来源:" + st.srcLabel + ";快捷方式将引用 " + (st.dir ? (st.dir + "\\" + iconName) : "—") + "。");
  el.textContent = lines.join("\n");
  if (hint) hint.textContent = dskHintText(st, iconName);
  var bIco = $("btn-dsk-ico"), bUrl = $("btn-dsk-url"), bWr = $("btn-dsk-write");
  if (bIco) bIco.disabled = !st.ok;
  if (bUrl) bUrl.disabled = !st.ok;
  if (bWr) { bWr.hidden = !st.canWrite; bWr.disabled = !st.ok; }
  dskEnsureIconName();
}
function dskDownloadIco() {
  dskIconBuild().then(function (r) {
    DSK_ICON_CACHE = { src: dskSrcDataUri(), name: r.name };
    if (!wsBlobDownload(new Blob([r.bytes], { type: "image/x-icon" }), r.name)) {
      toast("当前浏览器不支持下载,无法导出图标", "error", 4200); return;
    }
    dskSyncUI();
    toast("已下载 " + r.name, "success");
  }).catch(function (e) {
    toast((e && e.message) ? e.message : "图标生成失败", "error", 4200);
  });
}
function dskDownloadUrl() {
  var st = dskState();
  if (!st.ok) { toast(st.reason || "当前环境下无法生成快捷方式", "error", 4200); return; }
  dskIconBuild().then(function (r) {
    DSK_ICON_CACHE = { src: dskSrcDataUri(), name: r.name };
    var sc = dskShortcutText(st.href, st.dir + "\\" + r.name);
    if (!sc) { toast("路径含不允许的字符,请改用「手动方式」", "error", 4600); return; }
    if (!wsBlobDownload(new Blob([dskShortcutBytes(sc.text)], { type: "application/internet-shortcut" }), st.urlName)) {
      toast("当前浏览器不支持下载,无法导出快捷方式", "error", 4200); return;
    }
    dskSyncUI();
    toast(sc.asciiOnly ? ("已下载 " + st.urlName) : ("已下载 " + st.urlName + "(UTF-16 编码,适配中文路径)"), "success");
  }).catch(function (e) {
    toast((e && e.message) ? e.message : "快捷方式生成失败", "error", 4200);
  });
}
/* 一键写入(门 1-A 的增强通道)。showDirectoryPicker **必须在用户手势的同一个任务里**调用 ——
   中间隔一次 await 会耗尽 transient activation,选择器直接被拒(NotAllowedError)。 */
function dskWriteFile(dir, name, bytes) {
  return dir.getFileHandle(name, { create: true }).then(function (fh) {
    return fh.createWritable();
  }).then(function (w) {
    return w.write(bytes).then(function () { return w.close(); }, function (e) {
      try { w.abort(); } catch (e2) {}
      throw e;
    });
  });
}
function dskWriteToFolder() {
  if (!dskCanPick()) { toast("当前浏览器不支持直接写入文件夹,请改用下载方式", "warn", 4200); return; }
  var st = dskState();
  if (!st.ok) { toast(st.reason || "当前环境下无法生成快捷方式", "error", 4200); return; }
  var pick = null;
  try { pick = window.showDirectoryPicker({ id: "dsk-write", mode: "readwrite", startIn: "desktop" }); }
  catch (e) { toast("打开文件夹选择器失败:" + ((e && e.message) ? e.message : e), "error", 4600); return; }
  pick.then(function (dir) {
    return dskIconBuild().then(function (r) {
      DSK_ICON_CACHE = { src: dskSrcDataUri(), name: r.name };
      /* IconFile 恒为**本页所在目录**的绝对路径 —— File System Access API 不暴露所选目录的完整
         路径,相对名又不生效,所以只有这一条永远正确的写法;所选目录不同时下面给显式提示。 */
      var sc = dskShortcutText(st.href, st.dir + "\\" + r.name);
      if (!sc) throw new Error("路径含不允许的字符,请改用「手动方式」");
      var sameDir = String((dir && dir.name) || "") === String(st.dir.split("\\").pop() || "");
      return dskWriteFile(dir, r.name, r.bytes).then(function () {
        return dskWriteFile(dir, st.urlName, dskShortcutBytes(sc.text));
      }).then(function () {
        dskSyncUI();
        if (sameDir) toast("已写入 2 个文件;把 " + st.urlName + " 拖到桌面即可", "success", 4600);
        else toast("已写入 2 个文件;图标需放在 " + st.dir + " 才生效(请把 " + r.name + " 移过去)", "warn", 7000);
      });
    });
  }).catch(function (e) {
    if (e && e.name === "AbortError") { toast("已取消写入", "info", 1600); return; }
    toast((e && e.message) ? ("写入失败:" + e.message) : "写入失败", "error", 4600);
  });
}

/* ---- 模型视觉能力:服务端清单自报 → 探测 → 手动覆盖 ---- */
var VISION_PROBE_IMG = "data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAYAAAAfFcSJAAAADUlEQVR42mP8z8DwHwAFAAH/q842iQAAAABJRU5ErkJggg==";
/* 探测受阻(HTTP 层 / 被跨域拦)的模型 → {why, at}:只存内存、不落盘 —— 它不是能力结论,
   不能写进 state.settings.modelVision(那里是「支持 / 不支持图像」的判据,会驱动 OCR 融合)。
   用途:① 状态文案如实写「未知(探测受阻:…)」;② 探测去重照旧(1 小时内不重复发请求)。 */
var VISION_PROBE_BLOCKED = {};
function visionState(model) {
  var force = state.settings.visionForce;
  if (force === "yes") return { vision: true, src: "manual" };
  if (force === "no") return { vision: false, src: "manual" };
  var bag = state.settings.modelVision || {};
  var m = String(model == null ? effectiveModel() : model).trim();
  var rec = (m && Object.prototype.hasOwnProperty.call(bag, m)) ? bag[m] : null;
  if (!rec) return { vision: null, src: "" };
  return { vision: !!rec.vision, src: rec.src || "", at: rec.at || 0 };
}
function setVision(model, vision, src) {
  var m = String(model || "").trim();
  if (!m) return;
  delete VISION_PROBE_BLOCKED[m];   /* 有了能力结论(清单 / 探测 / 手动)就不再是「探测受阻」态 */
  if (!state.settings.modelVision) state.settings.modelVision = {};
  state.settings.modelVision[m] = { vision: !!vision, src: src || "probe", at: Date.now() };
  saveSoon();
}
function visionLabel(model) {
  var v = visionState(model);
  if (v.src === "manual") return v.vision ? "已手动指定:支持图像" : "已手动指定:不支持图像";
  if (v.vision === true) return v.src === "models" ? "支持图像(服务端清单声明)" : "支持图像(探测通过)";
  if (v.vision === false) return v.src === "models" ? "不支持图像(服务端清单声明)" : "不支持图像(探测未通过)";
  var blk = VISION_PROBE_BLOCKED[String(model == null ? effectiveModel() : model).trim()];
  if (blk) return "未知(探测受阻:" + blk.why + ")";
  return "未知(尚未探测,图片按原图发送)";
}
/* 非 2xx 是否算「模型明确说吃不下图片」(只有它才允许落 setVision(false))。
   依据(C 批审查 P3-6):兼容模式下这个探测体的 Content-Type 是 text/plain,服务端可能以 415/400
   这类「请求形状不收」拒绝,或因 CORS 被浏览器拦成不可读 —— 把它读成「不支持图像输入」是假结论。
   四条全过才算能力判据:
   ① 4xx(5xx = 服务端自身出错,与能力无关;被 CORS 拦掉时压根到不了这里);
   ② 响应体非空(空体没有任何能力判据);
   ③ 体里没有「请求形状 / 解析」类字样(text/plain、unsupported media、parse error、无法解析 …)
      —— 判据**不能**宽到「出现 content-type 就算形状问题」:真实的能力错误长这样
      「Invalid content type. image_url is only supported by certain models.」,放宽会把真结论也挡掉;
   ④ 体里点名图像(image / vision / multimodal / 图片 / 图像)。
   不过判据 ⇒ 调用方按「未知(探测受阻:…)」处理,不写否定结论。 */
function visionProbeSaysUnsupported(status, txt) {
  if (!(status >= 400 && status < 500)) return false;
  var t = String(txt || "");
  if (!t) return false;
  if (/text\/plain|unsupported media|invalid json|malformed json|parse error|failed to parse|无法解析|解析失败|不支持的请求体/i.test(t)) return false;
  return /image|vision|multimodal|图片|图像/i.test(t);
}
/* 探测:发一张 1×1 的图 + 最多 1 token,不报错就认为服务端吃得下图片 */
async function probeModelVision(model, quiet) {
  var m = String(model || "").trim() || effectiveModel();
  if (!m) return { ok: false, error: "没有模型名" };
  var proto = state.settings.protocol;
  var url = apiUrl(proto === "anthropic" ? "messages" : "chat/completions");
  if (!url) return { ok: false, error: "未配置 Base URL" };
  var body;
  if (proto === "anthropic") {
    body = {
      model: m, max_tokens: 1, messages: [{
        role: "user", content: [
          { type: "image", source: { type: "base64", media_type: "image/png", data: dataUrlPayload(VISION_PROBE_IMG) } },
          { type: "text", text: "hi" }
        ]
      }]
    };
  } else {
    body = {
      model: m, max_tokens: 1, stream: false, messages: [{
        role: "user", content: [
          { type: "image_url", image_url: { url: VISION_PROBE_IMG } },
          { type: "text", text: "hi" }
        ]
      }]
    };
  }
  var to = timeoutSignal(25000);
  var out = { ok: false, error: "" };
  try {
    var res = await fetch(url, { method: "POST", headers: headersFor(), body: JSON.stringify(body), signal: to.signal });
    var txt = await res.text();
    if (res.ok) {
      setVision(m, true, "probe");
      out = { ok: true, vision: true };
    } else {
      var why = "HTTP " + res.status + (txt ? ":" + safeJson(txt, 150) : "");
      if (visionProbeSaysUnsupported(res.status, txt)) {
        setVision(m, false, "probe");
        out = { ok: true, vision: false, error: why };
      } else {
        /* 探测受阻(HTTP 层 / 形状不收):**不**写 vision=false,改记「未知」并保留去重时戳 */
        VISION_PROBE_BLOCKED[m] = { why: why, at: Date.now() };
        out = { ok: false, blocked: true, error: why };
      }
    }
  } catch (e) {
    out = { ok: false, error: friendlyError(e, url).split("\n")[0] };
  } finally {
    to.abort();
  }
  if (!quiet) {
    if (out.ok && out.vision) toast("「" + m + "」支持图像输入,已打标", "success", 2600);
    else if (out.ok) toast("「" + m + "」不支持图像输入,图片将改用 OCR 提取文字" + (out.error ? "(" + out.error + ")" : ""), "warn", 4800);
    else if (out.blocked) toast("「" + m + "」图像能力未知(探测受阻:" + out.error + "),图片将按原图发送", "warn", 5200);
    else toast("图像输入探测失败:" + out.error, "warn", 3600);
  }
  renderVisionHint();
  updateModelsHint();
  return out;
}
/* 选模型 / 拉到模型清单后自动探测一次(1 小时内不重复) */
function ensureModelVision(model, force) {
  var m = String(model || "").trim() || effectiveModel();
  if (!m) return;
  var st = visionState(m);
  if (st.src === "manual" || st.src === "models") return;
  if (!force && st.src === "probe" && Date.now() - (st.at || 0) < 3600 * 1000) return;
  var blk = VISION_PROBE_BLOCKED[m];
  if (!force && blk && Date.now() - (blk.at || 0) < 3600 * 1000) return;   /* 受阻态同样 1 小时内不重复发请求 */
  if (!apiUrl("")) return;
  probeModelVision(m, !force);
}

/* ---- PDF / OCR 设置读取 ---- */
function pdfMaxPages() {
  var v = Number(state.settings.pdfMaxPages);
  if (!isFinite(v) || v <= 0) v = 10;
  return Math.max(1, Math.min(50, Math.round(v)));
}
function pdfDpi() {
  var v = Number(state.settings.pdfDpi);
  if (!isFinite(v) || v <= 0) v = 150;
  return Math.max(72, Math.min(300, Math.round(v)));
}
/* 附件图片策略(三档;唯一读取入口):缺键 / 非法值一律「混合」(方案 §2.3 / D15:单键三值、默认 both) */
function attachImgMode() {
  var v = state.settings.attachImgMode;
  return (v === "text" || v === "image" || v === "both") ? v : "both";
}
function ocrLangs() {
  var v = String(state.settings.ocrLangs || "");
  return (v === "eng" || v === "chi_sim" || v === "chi_sim+eng") ? v : "chi_sim+eng";
}
function pdfKitReady() { return !!(window.PDFKit && window.PDFKit.available); }
function ocrReady() { return !!(window.OCRKit && window.OCRKit.available); }

/* ---- 附件通用三档:判定枢纽 · 文案 · 按锚切段 · 图片档取图 ----
   口径唯一来源 = specs/b31-attach-modes-plan.md v2.3 的 §2.2/§2.4/§2.6/§2.7。
   本段全是纯函数:不读 DOM、不写状态、不改既有调用点 —— 接线按方案 §3 的 S3…S6b 逐步进行
   (本步只落函数本体;「暂不调用」是刻意的,便于逐格比对方案的矩阵)。 */

/* 渲染能力表(唯一来源;✅ D10/D11/D12 已拍板):
   "pages" = 逐页渲染成页图 · "drawn" = 本机自绘表格图(canvas,零新库) · false = 没有可信的离线渲染器 */
var ATT_DOCX_RENDER_READY = true;   /* S7(docx 渲染器批)已落地=true;真正可用还要求库在位(docxRenderReady)—— 唯一开关,别处不得另判 */
function docxRenderReady() { return !!(window.RenderKit && window.RenderKit.available === true); }
function attachRenderCap(kind, subtype) {
  if (kind === "pdf") return "pages";
  if (kind === "office") {
    var st = String(subtype || "").toLowerCase();
    if (st === "xlsx" || st === "xls") return "drawn";
    if (st === "docx") return (ATT_DOCX_RENDER_READY && docxRenderReady()) ? "pages" : false;
  }
  return false;   /* pptx(D11 本批排除)/ doc / ppt / 图片附件:没有渲染能力 ⇒ 走降级并如实说明 */
}

/* 通用附件模式判定(纯函数;**判定顺序 FIRST-MATCH,唯一实现,别处不许重推**;方案 §2.4)
   o = { kind:"pdf"|"office"|"image", subtype, srcMode:"text"|"image"|"both",
         vision:true|false|null, hasText:bool, imgCount:number,
         hasTextLayer:bool(PDF 专有;缺省 = true), cap:"pages"|"drawn"|false(缺省 = 查能力表) }
   → { send:"text"|"both"|"image",   // 实际发送形态 ⇒ 直接落 att.mode
       images:"send"|"ocr"|"none",   // 图怎么处理:进消息 / 交本机 OCR / 不涉及
       render:"pages"|"embedded"|"drawn"|"none",   // 图从哪来
       why:"vision"|"scan"|"norender"|"noimg"|"noimage"|"",   // 降级原因(给文案与注记)
       toast:""|"…" }
   硬不变量(方案 §2.1 的骨架):**真的发了图才可能是 image/both** ⇒ images==="ocr" 时 send 恒为 "text"。 */
function decideAttachPlan(o) {
  o = o || {};
  var src = o.srcMode;
  if (src !== "text" && src !== "image" && src !== "both") src = "both";    /* ⓪ 缺省/非法 ⇒ both(D15) */
  var nonVis = (o.vision === false);                  /* true / null 都按「可发图」(未知按项目既有口径) */
  var hasText = !!o.hasText;
  var hasLayer = (o.hasTextLayer === undefined) ? true : !!o.hasTextLayer;   /* 非 PDF 一律当有文字层 */
  var cap = (o.cap === undefined || o.cap === null) ? attachRenderCap(o.kind, o.subtype) : (o.cap || false);
  var nImg = Number(o.imgCount) || 0;
  var word = attachKindWord(o);
  /* 图从哪来:D12 —— 自绘表格图只在「图片档」出现,混合/升档一律用文档内嵌图(避免与 CSV 文本重复计费) */
  function renderFor(imageMode) {
    if (!cap) return "embedded";
    if (!imageMode && cap === "drawn") return "embedded";
    return cap;
  }
  function toastNoRender(sendMode) {
    return word + "暂不支持图片档(本机没有可信的离线渲染器):已改用「"
      + (sendMode === "both" ? "混合" : "纯文本") + "」";
  }
  function toastVision() {
    return "当前模型不支持图像输入;这份" + word + "已按「混合」处理:图片内容由本机 OCR 提取后随文字发送(原图未发送)";
  }
  function toastScan(render) {
    var tail = nonVis ? "图片内容由本机 OCR 提取" : (render === "drawn" ? "表格图随文字发送" : "页图随文字发送");
    return "这份" + word + "没有文字层,已改用「混合」:" + tail;
  }
  function mk(send, images, render, why, toast) {
    return { send: (images === "ocr" ? "text" : send), images: images, render: render, why: why, toast: toast || "" };
  }
  /* ① 图片档 + 本格式没有渲染能力 ⇒ 降级(有内嵌图 ⇒ 混合,否则纯文本),如实说清
     ⚠️ 非视觉 + 有内嵌图这一子例必须发**与其余非视觉路径同一句**的 toastVision 口径(P2-1):
     它实际走下面的 `"ocr"` 腿(图不发送、内容靠本机 OCR 随文字发)⇒ 再说「已改用「纯文本」」
     就会与 chip/信息行的「混合模式(图片已本机 OCR 后按原序插入)」在同一串里自相矛盾 */
  if (src === "image" && !cap) {
    if (!nImg) return mk("text", "none", "none", "norender", toastNoRender("text"));
    return mk(nonVis ? "text" : "both", nonVis ? "ocr" : "send", "embedded", "norender",
      nonVis ? toastVision() : toastNoRender("both"));
  }
  /* ② 图片档 + 非视觉 ⇒ 自动改档为「混合」:就地 OCR,原图不发(D2) */
  if (src === "image" && nonVis) return mk("text", "ocr", renderFor(true), "vision", toastVision());
  /* ③ 图片档 + 有渲染能力 ⇒ 逐页渲染页图 / xlsx|.xls 自绘表格图(D12) */
  if (src === "image") return mk("image", "send", renderFor(true), "", "");
  /* ④ 纯文本档 + 没有文字层(PDF 专有)+ 有图 ⇒ 升档,images 随视觉分流(D1) */
  if (src === "text" && !hasLayer && nImg) {
