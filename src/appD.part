        if (st && st.ok) { skipN++; skipped.push(it.name); return; }
        return put(it, it.path);
      });
    }
    if (mode === "rename") {
      return wsStat(wsId, it.path).then(function (st) {
        if (st && st.ok) return wsFreeName(wsId, it.path).then(function (p) { return put(it, p); });
        return put(it, it.path);
      });
