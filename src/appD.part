    corsProbeReq(models, { method: "GET", headers: { "Accept": "application/json" } }),
    corsProbeReq(models, { method: "GET", headers: corsProbeAppHeaders(false) }),
    corsProbeReq(chat, { method: "POST", headers: { "Content-Type": "text/plain;charset=UTF-8", "Accept": "text/event-stream, application/json" }, body: body }),
    corsProbeReq(chat, { method: "POST", headers: corsProbeAppHeaders(), body: body })
  ]).then(function (rs) {
    if (settled) return true;
    out.p1 = rs[0]; out.p2 = rs[1]; out.p3 = rs[2]; out.p4 = rs[3];
    if (corsProbeReadable(out.p1) && corsProbeReadable(out.p2) && corsProbeReadable(out.p3) && corsProbeReadable(out.p4)) return true;
    return corsReachProbe(models).then(function (reach) { if (!settled) out.reach = reach; return true; },
      function () { if (!settled) out.reach = null; return true; });
  }).then(function () { return true; });
  /* 外层兜底:某条探针因宿主异常(例如没有真 AbortController)永不 settle 时,整体也必须收敛 ——
     开关与诊断面板两条消费路径都不允许停在「正在探测…」。兜底胜出后这个定时器必须清掉(否则每次探测留一个)。
     注:该分支已被真实触发过一次(C2 复查、悬挂服务端下重复探测);「probe 链为何 >36 s 仍未到终态」的根因
     **未定位**(`?`;见 shared/progress/netdocs-C3-done.md),但结果有界、可见、文案如实。 */
  var guardTimer = null;
  var guard = new Promise(function (resolve) { guardTimer = setTimeout(function () { resolve(false); }, CORS_PROBE_TIMEOUT_MS * 3); });
  return Promise.race([probe, guard]).then(function (done) {
