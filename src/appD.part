
/* ---------------------------------------------------------------------------
   13. 会话管理
--------------------------------------------------------------------------- */
var elConvList = $("conv-list"), elConvTitle = $("conv-title");
var elModelName = $("model-name"), elProtoBadge = $("proto-badge");

function effectiveModel() { return (conv && conv.model) || state.settings.model || ""; }
function getConv(id) {
  for (var i = 0; i < state.conversations.length; i++) {
    if (state.conversations[i].id === id) return state.conversations[i];
  }
  return null;
}
/* opts.keepDraft = true 用于「发送路径上补建会话」:文字 / 附件已经在调用方手上,
   不能被这里的清草稿动作清掉(doSend / sendMessage 的 !conv 分支) */
function newConversation(opts) {
  if (generating) { toast("正在生成中,请先停止当前回答", "warn"); return null; }
  conv = {
    id: uid(),
    title: "新对话",
    system: state.settings.systemPrompt || "",
    model: "",
    pinned: false,
    createdAt: Date.now(),
    updatedAt: Date.now(),
    messages: []
  };
  state.conversations.unshift(conv);
  state.activeId = conv.id;
  /* 新建对话 = 干净的输入区:上一轮的文字与待发附件(含解析中的占位)不跟着走 */
  if (!(opts && opts.keepDraft)) clearDraft();
  saveSoon();
  renderChat();
  renderConvList();
  updateTopbar();
  closeSidebarMobile();
  focusInput();
  return conv;
}
/* 新建对话的三个入口(命令面板 / 侧栏按钮 / Ctrl+N)统一走这里:输入区非空(文字 / 已解析附件 /
   解析中的占位)时先确认一次 —— newConversation() 会把这些全部清掉,且草稿不按会话保留,
   误触 Ctrl+N 就再也找不回来。空草稿直接新建;发送路径的补建会话不受影响(见 newConversation 的 keepDraft) */
function newConversationUI() {
  var dirty = !!(elInput.value.trim() || draftFiles.length || pendingOffice.length);
  if (generating || !dirty) { newConversation(); return; }   /* 生成中由 newConversation 自己提示,它也不清草稿 */
  openAskDialog({
    title: "新建对话",
    icon: "plus",
    okText: "清空并新建",
    message: "新建对话会清空当前草稿与待发附件,是否继续?",
    fields: [],
    onSubmit: function () { newConversation(); }
  });
}
function selectConv(id) {
  if (generating && conv && conv.id === id) return;
  conv = getConv(id);
  state.activeId = id;
  saveSoon();
  if (typeof pvAutoLoopPurge === "function") pvAutoLoopPurge();   /* 自动续跑计数跟着会话列表收敛 */
  /* 压缩账本同源收敛:只清「已不存在的会话」的条目。**不在这里精确清当前会话** ——
     那会打掉 CX_LEDGER.lastAfter 去重:切走再切回同一水位就会重复压一次,白花一次摘要请求 */
  if (typeof cxPurgeLedger === "function") cxPurgeLedger();
  if (typeof closeTasksModal === "function") closeTasksModal();   /* /tasks 面板只描述打开的会话 */
  renderChat();
  renderConvList();
  updateTopbar();
  closeSidebarMobile();
  closeFind();
}
function deleteConv(id, skipConfirm) {
  var c = getConv(id);
  if (!c) return;
  if (skipConfirm) { deleteConvNow(id); return; }
  /* 确认框改成主题化弹窗(原生 confirm 不跟主题):它是**异步**的,用户在弹窗开着时
     可能已经切走 / 删掉这条,所以真正动手前按 id 再取一次 */
  askConfirm({
    title: "删除对话", icon: "trash", okText: "删除",
    message: "确定删除对话「" + c.title + "」吗?此操作不可撤销。"
  }, function () { if (getConv(id)) deleteConvNow(id); });
}
function deleteConvNow(id) {
  /* 先把删除意图记成墓碑再落盘:这样紧随其后的记录写就带着它,对侧收到事件时已经知道
     "这条是被删掉的",不会用自己的未落库副本把它顶回来(convsDel 落地后还会再记一次) */
  markConvsGone([id]);
  state.conversations = state.conversations.filter(function (x) { return x.id !== id; });
  if (state.activeId === id) {
    conv = state.conversations[0] || null;
    state.activeId = conv ? conv.id : null;
  }
  saveState(true);
  /* 会话记录与它的附件一起收拾掉(附件回收靠「没有被引用的记录」判断) */
  convsDel([id]).then(function () { return gcBlobs(); }).then(function () { renderDataPanel(); });
  if (typeof pvAutoLoopPurge === "function") pvAutoLoopPurge();   /* 顺手收掉这张会话的自动续跑计数 */
  if (typeof cxForgetConv === "function") cxForgetConv(id);       /* 压缩账本精确清一条(含待应用的 pending) */
  renderChat(); renderConvList(); updateTopbar(); updateStorageMeter();
  toast("对话已删除", "success");
}
function renameConv(id, title) {
  var c = getConv(id);
  if (!c) return;
  c.title = String(title || "").trim().slice(0, 120) || c.title;
  c.updatedAt = Date.now();
  saveSoon(); renderConvList(); updateTopbar();
}
function duplicateConv(id) {
  var c = getConv(id);
  if (!c) return;
  var copy = JSON.parse(JSON.stringify(c));
  copy.id = uid();
  copy.title = c.title + "(副本)";
  copy.createdAt = Date.now();
  copy.updatedAt = Date.now();
  copy.pinned = false;
  copy.messages.forEach(function (m) { m.id = uid(); m.streaming = false; });
  state.conversations.unshift(copy);
  saveSoon(); renderConvList();
  toast("已复制对话", "success");
}
function togglePin(id) {
  var c = getConv(id);
  if (!c) return;
  c.pinned = !c.pinned;
  saveSoon(); renderConvList();
  toast(c.pinned ? "已置顶" : "已取消置顶", "success", 1400);
}
function clearConvMessages(id) {
  var c = getConv(id);
  if (!c) return;
  if (!c.messages.length) { toast("这个对话还没有消息", "warn"); return; }
  /* 忙碌门:生成中清空会让正在回填的那一轮无处落笔(也把上下文与请求体错位),先挡住 */
  if (generating) { toast("正在生成中,请先按 Esc 停止再清空", "warn", 3600); return; }
  if (typeof CX_RUN !== "undefined" && CX_RUN && CX_RUN.phase !== "idle") {
    toast("正在压缩上下文中,请稍候再清空", "warn", 3600); return;
  }
  /* 确认框是异步的:真正清空前按 id 再取一次(弹窗开着时用户可能已经切走 / 删掉) */
  askConfirm({
    title: "清空消息", icon: "eraser", okText: "清空",
    message: "确定清空该对话的全部消息吗?这会连同它们的附件一起立即释放(不可撤销)。" +
      "系统提示词保留;后台任务继续运行、工作区文件不受影响。建议先「导出全部(JSON)」备份。"
  }, function () { clearConvMessagesNow(id); });
}
function clearConvMessagesNow(id) {
  var c = getConv(id);
  if (!c) return;
  if (!c.messages.length) return;
  /* 丢弃区间改走统一原语:收集附件键 → splice → 全库引用重算 → 释放
     (顺序:先移除再释放 —— 此刻引用集里已经没有它们了,而仍被别的会话/消息引用的键会保留) */
  var r = cxDropMessages(c, 0, c.messages.length - 1);
  var p = cxReleasePlan(r.keys);
  if (p.todo.length) cxReleaseBlobs(p.todo);
  if (typeof cxForgetConv === "function") cxForgetConv(id);
  c.updatedAt = Date.now();
  saveSoon();
  if (conv && conv.id === id) renderChat();
  renderConvList(); updateTopbar(); updateStorageMeter();
  toast("已清空上下文" + (p.todo.length ? "(释放 " + p.todo.length + " 个附件)" : ""), "success");
}
function autoTitle(convId) {
  var c = getConv(convId);
  if (!c || c.title !== "新对话") return;
  for (var i = 0; i < c.messages.length; i++) {
    if (c.messages[i].role === "user") {
      var t = contentToText(c.messages[i].content).replace(/\s+/g, " ").trim().slice(0, 30);
      if (t) { c.title = t; renderConvList(); updateTopbar(); }
      return;
    }
  }
}
function convPreview(c) {
  if (c.title !== "新对话" && c.title) return c.title;
  for (var i = 0; i < c.messages.length; i++) {
    if (c.messages[i].role === "user") {
      var t = contentToText(c.messages[i].content).replace(/\s+/g, " ").trim();
      if (t) return t.slice(0, 40);
    }
  }
  return "空对话";
}
function convGroupLabel(ts) {
  var now = new Date();
  var startToday = new Date(now.getFullYear(), now.getMonth(), now.getDate()).getTime();
  var d = new Date(ts);
  var startDay = new Date(d.getFullYear(), d.getMonth(), d.getDate()).getTime();
  var diff = Math.round((startToday - startDay) / 86400e3);
  if (diff <= 0) return "今天";
  if (diff === 1) return "昨天";
  if (diff < 7) return "近 7 天";
  if (diff < 30) return "近 30 天";
  return "更早";
}
function hlMatch(text, kw) {
  var t = String(text == null ? "" : text);
  if (!kw) return escapeHtml(t);
  var lower = t.toLowerCase(), lk = kw.toLowerCase(), out = "", i = 0, guard = 0;
  while (guard++ < 200) {
    var p = lower.indexOf(lk, i);
    if (p === -1) break;
    out += escapeHtml(t.slice(i, p)) + "<mark>" + escapeHtml(t.slice(p, p + lk.length)) + "</mark>";
    i = p + lk.length;
  }
  out += escapeHtml(t.slice(i));
  return out;
}
function renderConvList() {
  while (elConvList.firstChild) elConvList.removeChild(elConvList.firstChild);
  var kw = convSearchKw;
  var list = state.conversations.slice();
  if (kw) {
    list = list.filter(function (c) {
      if (c.title && c.title.toLowerCase().indexOf(kw) > -1) return true;
      for (var i = 0; i < c.messages.length; i++) {
        if (contentToText(c.messages[i].content).toLowerCase().indexOf(kw) > -1) return true;
        if (c.messages[i].reasoning && c.messages[i].reasoning.toLowerCase().indexOf(kw) > -1) return true;
      }
      return false;
    });
  }
  if (!list.length) {
    var empty = document.createElement("div");
    empty.className = "conv-empty";
    empty.innerHTML = kw ? "没有匹配的对话<br><br>试试别的关键词" : "还没有对话<br><br>点击上方「新建对话」开始";
    elConvList.appendChild(empty);
    return;
  }
  var pinned = list.filter(function (c) { return c.pinned; })
                   .sort(function (a, b) { return b.updatedAt - a.updatedAt; });
  var normal = list.filter(function (c) { return !c.pinned; })
                   .sort(function (a, b) { return b.updatedAt - a.updatedAt; });
  var lastGroup = null;
  function addGroup(title) {
    var g = document.createElement("div");
    g.className = "conv-group";
    g.textContent = title;
    elConvList.appendChild(g);
  }
  function addItem(c) {
    var item = document.createElement("div");
    item.className = "conv-item" + (c.id === state.activeId ? " active" : "") + (c.pinned ? " pinned" : "");
    item.setAttribute("data-id", c.id);
    item.setAttribute("role", "option");
    item.title = c.title;
    var n = c.messages.length;
    item.innerHTML =
      '<span class="ci-pin">' + icon("pin", "sm") + "</span>" +
      '<span class="ci-icon">' + icon("chat", "sm") + "</span>" +
      '<span class="ci-main"><span class="ci-title">' + hlMatch(convPreview(c), kw) + "</span>" +
      '<span class="ci-sub">' + escapeHtml(timeAgo(c.updatedAt)) + (c.model ? " · " + escapeHtml(c.model) : "") + "</span></span>" +
      (n ? '<span class="ci-msgs">' + n + "</span>" : "") +
      '<button class="ci-menu" data-menu-opener title="更多操作" aria-label="更多操作">' + icon("down", "sm") + "</button>";
    elConvList.appendChild(item);
  }
  if (pinned.length) {
    addGroup("已置顶");
    pinned.forEach(addItem);
  }
  lastGroup = null;
  normal.forEach(function (c) {
    var g = convGroupLabel(c.updatedAt);
    if (g !== lastGroup) { lastGroup = g; addGroup(g); }
    addItem(c);
  });
}
function updateTopbar() {
  var main = elConvTitle.querySelector(".t-main");
  var sub = $("conv-sub");
  if (main) main.textContent = conv ? conv.title : "新对话";
  if (sub) sub.textContent = conv ? (conv.messages.length + " 条消息" + (conv.pinned ? " · 已置顶" : "")) : "";
  var m = effectiveModel();
  elModelName.textContent = m || "未设置模型";
  elModelName.className = "m-name" + (m ? "" : " empty");
  elModelName.title = m || "";
  elProtoBadge.className = "badge " + state.settings.protocol;
  elProtoBadge.textContent = state.settings.protocol === "openai" ? "OPENAI" : "ANTHROPIC";
  $("status-bar").style.setProperty("--x", "0");
  updateStatusBar();
}
function updateStatusBar() {
  var m = effectiveModel();
  $("st-model").textContent = m || "未设置模型";
  $("st-model-wrap").className = "st" + (m ? "" : " warn");
  var stats = lastStats;
  $("st-last").textContent = stats
    ? (stats.tokens != null ? (stats.exactTokens ? "" : "≈") + stats.tokens + " tok" : "") +
      (stats.speed ? (stats.tokens != null ? " · " : "") + (stats.exactSpeed ? "" : "≈") +
        stats.speed.toFixed(1) + " tok/s" : "") +
      (stats.duration ? " · " + stats.duration.toFixed(1) + "s" : "")
    : "暂无生成";
  var tip = ["最近一次生成统计"];
  if (stats) {
    if (stats.promptTokens != null) tip.push("服务端输入 token:" + num(stats.promptTokens));
    if (stats.srvTokens) tip.push("服务端计数:" + num(stats.srvTokens) + " tok");
    if (stats.srvSpeed) tip.push("服务端自称解码速度:" + stats.srvSpeed.toFixed(1) + " tok/s");
    if (stats.srvSpeed && stats.exactSpeed) tip.push("界面速度按端到端实测(略低于纯解码速度)");
  }
  if (!stats || !stats.exactTokens || !stats.exactSpeed) tip.push("带 ≈ 的数值是按文本长度估算,不是服务端返回值");
  $("st-last-wrap").title = tip.join(" · ");
  var degraded = (ENV.soft || []).length;
  $("st-env").textContent = browserShort() + (degraded ? " · " + degraded + " 项降级" : " · 全部可用");
  $("st-env-wrap").className = "st" + (degraded ? " warn" : " ok");
  updateMcpStatus();
}
function browserShort() {
  var ua = navigator.userAgent || "";
  var m = /(Edg|OPR|Chrome|Firefox|Version)\/(\d+)/.exec(ua);
  if (m) {
    var name = m[1] === "Edg" ? "Edge" : m[1] === "OPR" ? "Opera"
      : m[1] === "Version" ? "Safari" : m[1];
    return name + " " + m[2];
  }
  return "未知浏览器";
}
function convToMarkdown(c) {
  var out = ["# " + c.title, ""];
  out.push("- 创建:" + fmtDateTime(c.createdAt));
  out.push("- 更新:" + fmtDateTime(c.updatedAt));
  out.push("- 模型:" + (c.model || state.settings.model || "—"));
  out.push("");
  if (c.system) { out.push("> **系统提示词**:"); out.push("> " + c.system.replace(/\n/g, "\n> ")); out.push(""); }
  c.messages.forEach(function (m) {
    out.push(m.role === "user" ? "## 你" : "## AI");
    out.push("");
    if (m.reasoning) {
      out.push("<details><summary>思考过程</summary>", "", m.reasoning, "", "</details>", "");
    }
    if (m.error) out.push("> ⚠ 请求失败:" + m.error, "");
    out.push(contentToText(m.content), "");
  });
  return out.join("\n");
}

/* ---------------------------------------------------------------------------
   14. 输入区 / 附件 / 参数
--------------------------------------------------------------------------- */
var elInput = $("input"), elSend = $("btn-send");
function focusInput() { try { elInput.focus(); } catch (e) {} }
function autoResize() {
  elInput.style.height = "auto";
  elInput.style.height = Math.min(elInput.scrollHeight, 260) + "px";
}
function updateHint() {
  var h = $("composer-hint");
  var deg = [];
  if (!CAP.stream) deg.push("非流式");
  if (!CAP.clipboard) deg.push("剪贴板受限");
  if (!CAP.recognition) deg.push("无语音输入");
  h.innerHTML = '<kbd>Enter</kbd> 发送 · <kbd>Shift</kbd>+<kbd>Enter</kbd> 换行 · 支持粘贴 / 拖拽· 附件'
    + (deg.length ? ' <span style="color:var(--warning)">· ' + escapeHtml(deg.join(" / ")) + "</span>" : "");
}

var IMAGE_EXT = ["png", "jpg", "jpeg", "gif", "webp", "bmp", "avif", "svg", "ico", "tif", "tiff"];
var TEXT_EXT = ["txt", "md", "markdown", "json", "jsonl", "py", "js", "mjs", "cjs", "ts", "jsx", "tsx",
  "html", "htm", "css", "scss", "less", "c", "cpp", "cc", "h", "hpp", "java", "go", "rs", "rb",
  "php", "sh", "bat", "cmd", "ps1", "yaml", "yml", "toml", "ini", "cfg", "conf", "csv", "tsv",
  "xml", "sql", "log", "env", "vue", "svelte", "rst", "tex", "lua", "r", "kt", "swift", "pl",
  "gitignore", "properties", "gradle", "dockerfile", "makefile", "mk", "srt", "vtt", "diff", "patch"];
/* 明确拒绝的类型:直接报出「不支持 .xxx」,而不是含混的「看起来是二进制」 */
var BLOCKED_EXT = ["exe", "msi", "dll", "com", "scr", "cpl", "sys", "lnk",
  "odt", "ods", "odp", "rtf", "zip", "rar", "7z", "tar", "gz", "bz2", "xz", "zst",
  "iso", "img", "vhd", "dmg", "apk", "ipa", "jar", "war", "class", "bin", "so", "dylib", "o", "a",
  "lib", "pdb", "mp3", "mp4", "mkv", "avi", "mov", "wmv", "flv", "wav", "flac", "aac", "ogg", "m4a",
  "ttf", "otf", "woff", "woff2", "eot", "psd", "ai", "sketch", "epub", "mobi", "azw3", "db", "sqlite",
  "sqlite3", "mdb", "dat", "pak", "crx", "xpi", "deb", "rpm", "pkg", "torrent"];
/* 办公文档:doc/docx/ppt/pptx/xls/xlsx 由内嵌的 OfficeKit 本地解析(文本 / 图像 / CSV);
   宏格式(.docm/.xlsm/.pptm 等)不做转换,单独拒收并给专门文案 */
var OFFICE_EXT = ["docx", "xlsx", "xls", "pptx", "doc", "ppt"];
var MACRO_EXT = ["docm", "dotm", "xlsm", "xltm", "pptm", "potm"];
/* 未被服务端明确支持的图片类型会在浏览器里重编码成 PNG/JPEG 再发 */
var SAFE_IMG_MIME = { "image/png": 1, "image/jpeg": 1, "image/gif": 1, "image/webp": 1 };
/* 工作区文件预览的「显示白名单」——与上面的**发送白名单**(IMAGE_EXT / SAFE_IMG_MIME)是两回事:
   显示白名单 ⊃ 发送白名单(bmp / svg / ico / avif 本机能显示,但发送仍只认那四种);
   tif / tiff 浏览器 <img> 不解码,显式拒绝(下载后本机看)—— 这三张表各管各的,不得互相改写。
   TEXT_EXT / OFFICE_EXT 只参与预览分类,不参与发送判定。 */
var PREVIEW_IMG_EXT = ["png", "jpg", "jpeg", "gif", "webp", "bmp", "svg", "ico", "avif"];
var PREVIEW_REJECT_EXT = ["tif", "tiff"];
var WS_PREVIEW_MAX_BYTES = 50 * 1024 * 1024;   /* 超过就不预览(可下载后本机看) */
var WS_PREVIEW_TEXT_MAX = 524288;              /* 文本预览只读前 512 KB */
var WS_PREVIEW_PDF_PAGES = 8;                  /* PDF 预览最多渲染前 8 页(限成本) */
var ATTACH_MAX_BYTES = 50 * 1024 * 1024;      // 单个文件上限 50MB
var MAX_DRAFT_FILES = 10;                     // 一条消息最多 10 个附件
var ATTACH_TEXT_MAX = 131072;                 // 单个文本文件读取上限(128K 字符)
/* 图片最长边上限 / 重采样算法 / 单条消息附件上限都改成设置项了(见 imgMaxSide() 等) */
var LEGACY_PDF_MIME = "application/pdf";      // 旧数据里的 pdf 部件(不再整文件内联)
function extOf(name) {
  var p = String(name).split(".");
  return p.length > 1 ? p[p.length - 1].toLowerCase() : "";
}
function isBlockedExt(ext) { return BLOCKED_EXT.indexOf(ext) > -1; }
/* 服务端模型清单里有没有直接声明「支持图像输入」:
   兼容 OpenAI / Ollama / llama.cpp 几种常见写法,认不出来返回 null */
function modelVisionFlag(m) {
  if (!m || typeof m !== "object") return null;
  var i;
  if (Array.isArray(m.capabilities)) {
    for (i = 0; i < m.capabilities.length; i++) {
      var c = String(m.capabilities[i] || "").toLowerCase();
      if (c === "multimodal" || c === "vision" || c === "image" || c === "image_input") return true;
    }
    /* llama.cpp 的 router 只给 completion / multimodal;只有 completion 就明确表示不支持 */
    if (m.capabilities.length) return false;
  }
  if (Array.isArray(m.input_modalities)) {
    for (i = 0; i < m.input_modalities.length; i++) {
      if (String(m.input_modalities[i] || "").toLowerCase().indexOf("image") > -1) return true;
    }
    return false;
  }
  var meta = m.meta || m.details || {};
  if (typeof m.vision === "boolean") return m.vision;
  if (typeof meta.vision === "boolean") return meta.vision;
  if (typeof meta.has_vision === "boolean") return meta.has_vision;
