    for (i = 0; i < rows.length && i < 3; i++) {
      var cells = rows[i].getElementsByTagNameNS(NS.w, "tc"), row = [];
      for (j = 0; j < cells.length; j++) { row.push(wTextsOf(cells[j])); }
