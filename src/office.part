      }
    }
    progress(opts, "build");
    var i, imgs = ni.images, n0 = nextMediaIndex(pkg.entries, "docx");
    var hasRels = has(pkg.entries, PART.documentRels);
    var rm = { ok: true, map: {} };
    if (hasRels) {
