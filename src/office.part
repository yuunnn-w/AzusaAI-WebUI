    var xf = elA(doc, "xfrm");
    var off = elA(doc, "off"); nAttr(off, "x", "0"); nAttr(off, "y", "0");
    var ext = elA(doc, "ext"); nAttr(ext, "cx", String(cx)); nAttr(ext, "cy", String(cy));
    xf.appendChild(off); xf.appendChild(ext);
