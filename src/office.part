      if (!tree) { return fail("EOFFICE", ent.part + " 缺少 p:spTree"); }
      hostId = nextShapeId(doc);
      tree.appendChild(pptxGraphicFrame(doc, hostId, "Chart " + hostId, chartRid));
      return { ok: true, value: { id: hostId } };
    });
    if (!sw.ok) { return sw; }
