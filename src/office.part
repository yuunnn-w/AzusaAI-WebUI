      steps.push("新增 " + media[i] + "(" + imgs[i].bytes.length + " B," + imgs[i].kind + ")"
        + (imgs[i].px ? " 源 " + imgs[i].px.w + " x " + imgs[i].px.h + " px" : "")
        + " → 版心内 " + plan0.plans[i].cx + " x " + plan0.plans[i].cy + " EMU;关系 " + rids[i]);
    }
