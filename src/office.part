    while (i + 8 < n) {
      if (u8[i] !== 0xff) { i++; continue; }
      m = u8[i + 1];
      if (m === 0xff) { i++; continue; }
      if (m === 0x01 || (m >= 0xd0 && m <= 0xd9)) { i += 2; continue; }
