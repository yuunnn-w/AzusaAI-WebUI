    var ids = [];
    var sw = mutatePart(pkg.entries, ent.part, function (doc) {
      var tree = pptxSpTree(doc);
      if (!tree) { return fail("EOFFICE", ent.part + " 缺少 p:spTree"); }
      for (var k = 0; k < imgs.length; k++) {
