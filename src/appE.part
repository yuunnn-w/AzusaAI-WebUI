/* 工作区事务:先取元数据(顺带给出 ENOENT),再把 env 交给 fn */
function wsTx(wsId, mode, fn) {
  /* 三区不齐(wsStoreReady=false)→ 工作区功能整体关闭:统一回 EWSREADY,而不是让它掉进 ENOENT */
  if (!wsReady()) return Promise.resolve(wsErr("EWSREADY", WS_NOTE_READY));
  return wsDb().then(function (db) {
    if (!db) return wsErr("EWSREADY", WS_NOTE_READY);
    return new Promise(function (resolve) {
      var tx, env = null, done = false;
      function finish(r) { if (done) return; done = true; resolve(r); }
      try { tx = db.transaction([IDB_WS, IDB_WSF], mode); }
      catch (e) { finish(wsErr("EIO", "无法打开工作区存储事务:" + wsMsg(e))); return; }
      function fail(res) {
        env = env || {};
        env.fail = res;
        try { tx.abort(); } catch (e) {}
        finish(res);
      }
      tx.oncomplete = function () {
        if (env && env.meta) WS_META_CACHE[wsId] = env.meta;
        finish(env && env.out ? env.out : { ok: true });
      };
      tx.onerror = function () { finish(env && env.fail ? env.fail : wsTxFail(tx)); };
      tx.onabort = function () { finish(env && env.fail ? env.fail : wsTxFail(tx)); };
      var st, rq;
      try { st = tx.objectStore(IDB_WS); } catch (e) { finish(wsErr("EIO", wsMsg(e))); return; }
      rq = st.get(wsId);
      rq.onsuccess = function () {
        var meta = rq.result;
        if (!meta) { fail(wsErr("ENOENT", "工作区不存在或已被删除")); return; }
        if (!meta.tree || meta.tree.t !== "d") meta.tree = wsNewDir();
        env = { db: db, tx: tx, store: st, fstore: tx.objectStore(IDB_WSF), meta: meta, out: null, fail: null };
        var r;
        try { r = fn(env); } catch (e) { fail(wsErr("EIO", wsMsg(e))); return; }
        if (r && typeof r.then === "function") {
          r.then(function (res) {
            if (res && res.ok === false) { fail(res); return; }
            env.out = res || { ok: true };
          }, function (e) { fail(wsIsErr(e) ? e : wsErr("EIO", wsMsg(e))); });
        } else if (r && r.ok === false) fail(r);
        else env.out = r || { ok: true };
      };
      rq.onerror = function () { finish(wsTxFail(tx)); };
    });
  });
}
function wsReadTx(wsId, fn) { return wsTx(wsId, "readonly", fn); }
function wsWriteTx(wsId, fn) { return wsTx(wsId, "readwrite", fn); }
/* 同 wsId 的写操作串行(tree + usedBytes 是读改写,并发必丢文件) */
function wsLock(wsId, fn) {
  var key = String(wsId || "");
  var L = WS_LOCKS[key];
  if (!L) L = WS_LOCKS[key] = { chain: null };
  var prev = L.chain || Promise.resolve();
  var run = prev.then(function () { return fn(); }, function () { return fn(); });
  L.chain = run.then(function () {}, function () {});
  return run;
}
/* 按 fileId 直接取文件记录(只开 wsfiles 区,不重复拉元数据树) */
function wsFileRec(wsId, fileId) {
  return wsStoreTx(IDB_WSF, "readonly", function (tx) {
    return wsReqP(tx.objectStore(IDB_WSF).get(fileId)).then(function (rec) { return { ok: true, rec: rec || null }; });
  }).then(function (r) { return wsIsErr(r) ? null : (r.rec || null); });
}
/* 按 ws 索引遍历本工作区的全部/部分文件记录 */
function wsIndexCursor(env, cb) {
  var idx;
  try { idx = env.fstore.index("ws"); }
  catch (e) { return Promise.resolve(wsErr("EIO", "wsfiles 缺少 ws 索引:" + wsMsg(e))); }
  return new Promise(function (resolve, reject) {
    var rq;
    try { rq = idx.openCursor(IDBKeyRange.only(env.meta.id)); }
    catch (e) { reject(e); return; }
    rq.onsuccess = function () {
      var cur = rq.result;
      if (!cur) { resolve({ ok: true }); return; }
      var stop = false;
      try { stop = cb(cur) === false; } catch (e) { reject(e); return; }
      if (stop) { resolve({ ok: true }); return; }
      cur.continue();
    };
    rq.onerror = function () { reject(rq.error || new Error("游标遍历失败")); };
  });
}
function wsIndexDeleteAll(env, pathPrefix) {
  var n = 0;
  return wsIndexCursor(env, function (cur) {
    var rec = cur.value;
    if (!rec) return;
    if (pathPrefix && rec.path !== pathPrefix && String(rec.path).indexOf(pathPrefix + "/") !== 0) return;
    n++;
    try { cur.delete(); } catch (e) {}
  }).then(function (r) { return wsIsErr(r) ? r : { ok: true, removed: n }; });
}

/* ---- 元数据视图 ---- */
function wsMetaView(m) {
  return {
    id: m.id, name: m.name, quotaBytes: m.quotaBytes, usedBytes: m.usedBytes,
    fileCount: m.fileCount || 0, rev: m.rev || 0, createdAt: m.createdAt, updatedAt: m.updatedAt
  };
}
function wsReady() { return wsStoreReady === true; }
/* 当前挂载的工作区 id;c 显式传入时按那条会话取(请求体组装用:生成期间可能已切走,
   见 buildBody 的 targetConv),缺省 = 模块级 conv(UI 显示点的既有行为不变) */
function wsMountedId(c) {
  if (typeof c === "undefined") c = conv;
  if (!c || typeof c.wsId !== "string" || !c.wsId) return null;
  return c.wsId;
}
function wsConvsMounting(wsId) {
  var ids = [];
  if (!wsId) return ids;
  state.conversations.forEach(function (c) {
    if (c && c.id && c.wsId === wsId) ids.push(c.id);
  });
  return ids;
}
function wsPersistConv(c) {
  if (!c) return Promise.resolve(false);
  if (convsInIdb()) {
    /* IDB 模式下这条路径不写 localStorage(免得为一次挂载重写整份记录):事务落地后补推一次
       版本号,否则对侧看不到挂载状态的变化(与"会话内容变更必发 storage 事件"同一口径) */
    return convsPutAll([c]).then(function (ok) { if (ok) broadcastConvsChange(); return ok; });
  }
  saveState(true);
  return Promise.resolve(true);
}
/* 挂载/取消挂载:只改 conv.wsId 并落盘(不做存在性查询;悬垂引用由 WS.* 的 ENOENT 兜底) */
function wsMountConv(convId, wsId) {
  var c = getConv(convId);
  if (!c) return Promise.resolve(wsErr("ENOENT", "会话不存在"));
  if (wsId == null || wsId === "") {
    c.wsId = null;
    return wsPersistConv(c).then(function (ok) {
      return ok ? { ok: true, wsId: null } : wsErr("EIO", "挂载状态写入失败");
    });
  }
  if (!wsReady()) return Promise.resolve(wsErr("EWSREADY", WS_NOTE_READY));
  return wsMeta(wsId).then(function (m) {
    if (!m) return wsErr("ENOENT", "工作区不存在或已被删除");
    c.wsId = m.id;
    return wsPersistConv(c).then(function (ok) {
      if (!ok) return wsErr("EIO", "挂载状态写入失败");
      return { ok: true, wsId: m.id };
    });
  });
}

function wsList() {
  if (!wsReady()) return Promise.resolve([]);
  return wsStoreTx(IDB_WS, "readonly", function (tx) {
    return wsReqP(tx.objectStore(IDB_WS).getAll()).then(function (arr) {
      var list = (Array.isArray(arr) ? arr : []).map(wsMetaView);
      list.sort(function (a, b) { return (b.updatedAt || 0) - (a.updatedAt || 0); });
      return { ok: true, list: list };
    });
  }).then(function (r) { return wsIsErr(r) ? [] : r.list; });
}
function wsMeta(wsId) {
  if (!wsReady()) return Promise.resolve(null);
  return wsStoreTx(IDB_WS, "readonly", function (tx) {
    return wsReqP(tx.objectStore(IDB_WS).get(wsId)).then(function (m) {
      if (m) WS_META_CACHE[m.id] = m;
      return { ok: true, meta: m || null };
    });
  }).then(function (r) { return wsIsErr(r) ? null : (r.meta ? wsMetaView(r.meta) : null); });
}
function wsCreate(name, quotaMB) {
  if (!wsReady()) return Promise.resolve(wsErr("EWSREADY", WS_NOTE_READY));
  var nm = String(name == null ? "" : name).replace(/[\u0000-\u001f\u007f]/g, "").trim();
  if (nm.length > WS_NAME_MAX) nm = nm.slice(0, WS_NAME_MAX);
  var qmb = clampNum(quotaMB, WS_QUOTA_MIN_MB, WS_QUOTA_MAX_MB, WS_QUOTA_DEF_MB);
  return wsStoreTx(IDB_WS, "readwrite", function (tx) {
    var st = tx.objectStore(IDB_WS);
    return wsReqP(st.getAllKeys()).then(function (keys) {
      keys = Array.isArray(keys) ? keys : [];
      if (keys.length >= WS_MAX_COUNT) {
        return wsErr("ELIMIT", "最多 " + WS_MAX_COUNT + " 个工作区,请先删除一个再创建");
      }
      var at = Date.now();
      var rec = {
        id: "ws" + uid(), name: nm || ("工作区 " + (keys.length + 1)),
        quotaBytes: qmb * 1024 * 1024, usedBytes: 0, fileCount: 0, rev: 1,
        createdAt: at, updatedAt: at, tree: wsNewDir()
      };
      st.put(rec, rec.id);
      return { ok: true, ws: wsMetaView(rec) };
    });
  });
}
function wsRename(wsId, name) {
  var nm = String(name == null ? "" : name).replace(/[\u0000-\u001f\u007f]/g, "").trim();
  if (!nm) return Promise.resolve(wsErr("EINVAL", "工作区名称不能为空"));
  if (nm.length > WS_NAME_MAX) nm = nm.slice(0, WS_NAME_MAX);
  return wsLock(wsId, function () {
    return wsWriteTx(wsId, function (env) {
      env.meta.name = nm;
      env.meta.rev = (env.meta.rev || 0) + 1;
      env.meta.updatedAt = Date.now();
      env.store.put(env.meta, env.meta.id);
      return { ok: true, ws: wsMetaView(env.meta) };
    });
  });
}
function wsSetQuota(wsId, quotaMB) {
  var qmb = clampNum(quotaMB, WS_QUOTA_MIN_MB, WS_QUOTA_MAX_MB, WS_QUOTA_DEF_MB);
  return wsLock(wsId, function () {
    return wsWriteTx(wsId, function (env) {
      env.meta.quotaBytes = qmb * 1024 * 1024;
      env.meta.rev = (env.meta.rev || 0) + 1;
      env.meta.updatedAt = Date.now();
      env.store.put(env.meta, env.meta.id);
      return { ok: true, ws: wsMetaView(env.meta), over: env.meta.usedBytes > env.meta.quotaBytes };
    });
  });
}
/* 重算用量:游标扫 wsfiles 的 ws 索引(O(n),手动触发);只改 usedBytes/fileCount */
function wsRecount(wsId) {
  return wsLock(wsId, function () {
    return wsWriteTx(wsId, function (env) {
      var files = 0, bytes = 0;
      return wsIndexCursor(env, function (cur) {
        var rec = cur.value;
        if (rec) { files++; bytes += (typeof rec.size === "number" ? rec.size : 0); }
      }).then(function (r) {
        if (wsIsErr(r)) return r;
        env.meta.fileCount = files;
        env.meta.usedBytes = bytes;
        env.meta.rev = (env.meta.rev || 0) + 1;
        env.meta.updatedAt = Date.now();
        env.store.put(env.meta, env.meta.id);
        return { ok: true, usedBytes: bytes, fileCount: files, quotaBytes: env.meta.quotaBytes };
      });
    });
  });
}
/* 删除工作区:先把还挂着它的会话解除挂载并落盘,再删数据(顺序不能反) */
function wsDropWorkspace(wsId, opts) {
  opts = opts || {};
  var mounted = wsConvsMounting(wsId);
  if (mounted.length && !opts.force) {
    return Promise.resolve(wsErr("EMOUNTED", "该工作区还被 " + mounted.length + " 个会话挂载,请先取消挂载(或强制删除)"));
  }
  var list = [];
  mounted.forEach(function (id) { var c = getConv(id); if (c) { c.wsId = null; list.push(c); } });
  var un = list.length ? wsPersistConvList(list) : Promise.resolve(true);
  return un.then(function () {
    return wsStoreTx([IDB_WS, IDB_WSF], "readwrite", function (tx) {
      var st = tx.objectStore(IDB_WS), fs = tx.objectStore(IDB_WSF);
      return wsReqP(st.get(wsId)).then(function (meta) {
        if (!meta) return wsErr("ENOENT", "工作区不存在或已被删除");
        var env = { meta: meta, fstore: fs };
        return wsIndexDeleteAll(env, null).then(function (r) {
          if (wsIsErr(r)) return r;
          st.delete(wsId);
          delete WS_META_CACHE[wsId];
          return { ok: true, removedFiles: r.removed };
        });
      });
    });
  });
}
function wsPersistConvList(list) {
  if (convsInIdb()) {
    return convsPutAll(list).then(function (ok) { if (ok) broadcastConvsChange(); return ok; });
  }
  saveState(true);
  return Promise.resolve(true);
}

/* ---- 文件系统 ---- */
function wsListDir(wsId, path, opts) {
