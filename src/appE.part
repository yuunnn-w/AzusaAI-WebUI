       d.dest[d.destLen++] = d.source[d.sourceIndex++];

     /* make sure we start next block on a byte boundary */
     d.bitcount = 0;

     return TINF_OK;
   }

   /* inflate stream from source to dest */
   function tinf_uncompress(source, dest) {
