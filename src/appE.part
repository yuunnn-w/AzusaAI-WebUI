  if (wsProbeHasNul(head) || (tail && wsProbeHasNul(tail))) {
    res.why = "nul"; res.type = hint || "未知二进制"; return res;
  }
  /* 判据 6:UTF-8 严格解码(精确尾部修剪),两段都要过 */
  var t6h = wsUtf8SegText(head);
  var t6t = tail ? wsUtf8SegText(tail) : "";
  if (t6h != null && t6t != null && !wsTextCtlBad(t6h) && !(tail && wsTextCtlBad(t6t))) {
    return wsProbeAsText(res, "utf-8", "utf8");
  }
  /* 判据 7:文本暗示(后缀 / text mime / 无后缀且样本 ≥16 B)+ GB18030 严格解码
     (人工截断端容错)+ 控制字符比 */
  if (wsProbeTextHint(suf, mime) || (!suf && head.length >= WS_GBK_MIN_SAMPLE)) {
    var g7h = wsGbDecodeSeg(head, !whole);
    var g7t = tail ? wsGbDecodeSeg(tail, false) : { ok: true, text: "" };
    if (g7h.ok && g7t.ok && !wsTextCtlBad(g7h.text) && !(tail && wsTextCtlBad(g7t.text))) {
