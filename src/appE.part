          if (!rec || !rec.blob) return wsErr("EIO", "文件内容缺失,复制中止:" + a.path, a.path);
          try {
            env.fstore.put({
              id: plan[i].newId, ws: env.meta.id, path: plan[i].path,
              size: plan[i].size, mime: rec.mime || plan[i].mime, blob: rec.blob, at: Date.now()
            }, plan[i].newId);
          } catch (e) { return wsErr("EIO", wsMsg(e)); }
        }
        tp.ch[wsPathName(b.path)] = clone;
        env.meta.usedBytes = (env.meta.usedBytes || 0) + total;
        env.meta.fileCount = (env.meta.fileCount || 0) + plan.length;
        env.meta.rev = (env.meta.rev || 0) + 1;
        env.meta.updatedAt = Date.now();
        env.store.put(env.meta, env.meta.id);
        return { ok: true, path: b.path, copiedFiles: plan.length, bytes: total, usedBytes: env.meta.usedBytes };
      });
    });
  });
}
function wsCountOccur(text, sub) {
  var n = 0, i = 0;
  if (!sub) return 0;
  for (;;) {
    var at = text.indexOf(sub, i);
    if (at === -1) break;
    n++;
    i = at + sub.length;
  }
  return n;
}
/* 原子读改写(Edit 工具的落点):wsLock 串起「读文本 → 校验替换 → 同一事务落盘」。
   注意:blob 解码不是 IDB 请求,若放进写事务里会让事务提前提交(put 报
   "transaction has finished"),所以解码必须发生在写事务之外 —— 一致性由 wsLock 保证:
   同一 workspace 的写(工具写 / 上传 / 回写)全都走这把锁,不会与本次读改写交错。
   写路径零宽容(方案 §4-S4-①):只接受 UTF-8;非 UTF-8 / 含非法字节 / 含 NUL 一律
   EINVAL 拒写,拒绝发生在写事务之前(目标文件字节不变)。 */
function wsEditText(wsId, path, opts) {
  opts = opts || {};
  var np = wsNormPath(path);
  if (wsIsErr(np)) return Promise.resolve(np);
  path = np.path;
  var oldText = String(opts.oldText == null ? "" : opts.oldText);
  var newText = String(opts.newText == null ? "" : opts.newText);
  var all = !!opts.replaceAll;
  if (!oldText) return Promise.resolve(wsErr("EINVAL", "old_string 不能为空(需要给出要被替换的原文)", path));
  if (oldText === newText) return Promise.resolve(wsErr("EINVAL", "old_string 与 new_string 完全相同,没有要做的修改:" + path, path));
  return wsLock(wsId, function () {
    return wsReadBlob(wsId, path).then(function (r) {
      if (wsIsErr(r)) return r;
      if ((r.size || 0) > EDIT_READ_MAX) {
        return wsErr("E2BIG", "文件过大(" + fmtBytes(r.size) + " > " + fmtBytes(EDIT_READ_MAX) + "),请改用 ExecutePython 处理", path);
      }
      return wsProbeBlob(r.blob, r.path, r.mime).then(function (pr) {
        /* 两道门:① 非文本(二进制) ② 非 UTF-8(或严格解码失败) */
        if (!pr || pr.kind !== "text") {
          return wsErr("EINVAL", "这不是文本文件(二进制),Edit 不能修改:" + path + (pr && pr.type ? "(" + pr.type + ")" : ""), path);
        }
        if (pr.enc !== "utf-8") {
          return wsErr("EINVAL", "本工具只接受 UTF-8 文本;该文件是 " + wsEncName(pr.enc) + ",请先转码为 UTF-8(Read 只读不写,不受此限):" + path, path);
        }
        return wsDecodeTextBlob(r.blob, "utf-8", { strict: true, noTrim: true }).then(function (dr) {
          if (!dr.ok) {
            return wsErr("EINVAL", "本工具只接受 UTF-8 文本;该文件含非法字节(或不完整),请先转码为 UTF-8(Read 只读不写,不受此限):" + path, path);
          }
          var text = String(dr.text == null ? "" : dr.text);
          /* 承接现网「任意 NUL 即拒」并与 Read/Grep 的消费侧守卫对称:采样窗之外的 NUL 也不放行 */
          if (text.indexOf("\u0000") !== -1) {
            return wsErr("EINVAL", "文件含 NUL 字节(二进制或含原始 NUL 的文本),Edit 不能修改:" + path, path);
          }
          return wsEditApply(wsId, path, r, text, oldText, newText, all);
        });
      });
    });
  });
}
/* 匹配与写回:纯 CRLF 文件在 LF 视图里匹配、再按 CRLF 写回(Kimi edit.md 口径,字节除被替换段外不变);
   混合行尾走原字面路径(不做任何行尾转换——Read 已把 \r 渲染成可见两字符,old_string 应写真实回车) */
function wsEditApply(wsId, path, r, text, oldText, newText, all) {
  var style = wsLineEndingStyle(text);
  var work = text, toCrlf = false;
  if (style === "crlf" && wsCountOccur(text, oldText) === 0) {
    work = text.split("\r\n").join("\n");
    toCrlf = true;
  }
  var n = wsCountOccur(work, oldText);
  if (!n) return Promise.resolve(wsErr("ENOTFOUND", "old_string 在文件里匹配不到(请核对原文;它必须与文件里的字符完全一致):" + path, path));
  if (n > 1 && !all) {
    return Promise.resolve(wsErr("EAMBIG", "old_string 匹配到 " + n + " 处,replace_all=false 时要求唯一(请给出更多上下文,或改用 replace_all:true):" + path, path));
  }
  /* 用函数形式替换:new_string 里的 $ 不会被当成特殊模式 */
  var next = all ? work.split(oldText).join(newText) : work.replace(oldText, function () { return newText; });
  /* 写回 CRLF 前先把 new_string 自带的 CRLF 归一到 LF,再整体展开(避免出现 \r\r\n) */
  if (toCrlf) next = next.split("\r\n").join("\n").split("\n").join("\r\n");
  var blob = new Blob([next], { type: r.mime || "text/plain" });
  if (blob.size > WS_WRITE_MAX) {
    return Promise.resolve(wsErr("E2BIG", "替换后文件超过 " + fmtBytes(WS_WRITE_MAX) + "(本次 " + fmtBytes(blob.size) + ")", path));
  }
  return wsWriteTx(wsId, function (env) {
    var node = wsTreeGet(env.meta.tree, path);
    if (!node || node.t !== "f") return wsErr("ENOENT", "文件已被移动或删除:" + path, path);
    var put = wsPutFile(env, path, node, blob, r.mime || "text/plain");
    if (wsIsErr(put)) return put;
    put.replacements = all ? n : 1;
    put.lineEnding = (style === "crlf") ? "crlf" : "lf";
    return put;
  });
}

/* ---- 会话挂载:快照桥的装载侧 ---- */
function wsOpenSession(wsId, opts) {
  opts = opts || {};
  /* 默认值来自唯一常量(不在这里重写数字) */
  var defBytes = clampNum(state.settings.wsSessionBytesMb, 1, 256, Math.round(WS_SESSION_BYTES / 1048576)) * 1048576;
  var maxBytes = opts.maxBytes ? clampNum(opts.maxBytes, 1024, 1073741824, defBytes) : defBytes;
  var include = Array.isArray(opts.include) ? opts.include : null;
  return wsReadTx(wsId, function (env) {
    var all = wsTreeAllFiles(env.meta.tree, "/", []);
    var cand = all.filter(function (f) {
      if (!include || !include.length) return true;
      /* 用绝对路径做匹配面:/big/* 与 *.txt 两种写法都能命中(裸名会回落到 basename 再试) */
      for (var i = 0; i < include.length; i++) if (wsGlobMatch(String(include[i]), f.path, f.name)) return true;
      return false;
    });
    cand.sort(function (x, y) { return (y.node.at || 0) - (x.node.at || 0); });
    var manifest = [], plan = [], total = 0;
    cand.forEach(function (f) {
      var sz = f.node.size || 0;
      var remote = (total + sz > maxBytes);
      manifest.push({ path: f.path, size: sz, mtime: f.node.at || 0, mime: f.node.mime || "", remote: remote });
      if (!remote) { total += sz; plan.push({ path: f.path, node: f.node }); }
    });
    /* manifestOnly:增量补载要先看清单再决定读哪些字节,
       这一步不读 blob、不进内存 → 不预载任何文件 */
    if (opts.manifestOnly) {
      return { ok: true, manifest: manifest, loaded: [], wsId: env.meta.id, rev: env.meta.rev, maxBytes: maxBytes };
    }
    var reads = plan.map(function (p) { return wsReqP(env.fstore.get(p.node.id)); });
    return Promise.all(reads).then(function (recs) {
      var out = [];
      for (var i = 0; i < plan.length; i++) {
        if (recs[i] && recs[i].blob) out.push({ path: plan[i].path, blob: recs[i].blob, size: recs[i].size, mime: recs[i].mime });
      }
      return { ok: true, manifest: manifest, loaded: out, wsId: env.meta.id, rev: env.meta.rev, maxBytes: maxBytes };
    });
  }).then(function (r) {
    if (wsIsErr(r)) return r;
    return Promise.all(r.loaded.map(function (f) { return wsBlobBuffer(f.blob); })).then(function (bufs) {
      var files = [];
      r.loaded.forEach(function (f, i) { files.push({ path: f.path, bytes: bufs[i], size: f.size, mime: f.mime }); });
      return { ok: true, manifest: r.manifest, files: files, wsId: r.wsId, rev: r.rev, maxBytes: r.maxBytes };
    });
  });
}
/* 上下文注入段:只在「已挂载 ∧ 有文件工具处于 active」时给内容;
   接线到 buildBody 由调用方负责。元数据不在内存缓存里时返回空串(不猜)。
   c 显式传入时按那条会话取挂载状态(请求体组装传发起会话,见 buildBody 的 targetConv) */
function wsContextBlock(c) {
  if (!wsReady() || !state.settings.toolsEnabled) return "";
  var wsId = wsMountedId(c);
  if (!wsId) return "";
  if (!wsHasActiveFileTool(c)) return "";
  var m = WS_META_CACHE[wsId];
  if (!m || !m.tree) return "";
  var head = "【工作区】当前会话挂载了工作区「" + m.name + "」(已用 " + fmtBytes(m.usedBytes) + " / " + fmtBytes(m.quotaBytes) +
    ")。文件读写用 Read / Write / Edit / Glob / Grep / FileOps,根目录为 `/`。" + WS_PATH_DUAL_NOTE;
  var files = wsTreeAllFiles(m.tree, "/", []);
  files.sort(function (a, b) { return (b.node.at || 0) - (a.node.at || 0); });
  var lines = [];
  for (var i = 0; i < files.length && i < 30; i++) {
    /* 按后缀给二进制文件打标记(同步判定,不读内容、零 IDB 成本):模型少走弯路 */
    lines.push("- " + files[i].path + " (" + fmtBytes(files[i].node.size || 0) + ")" +
      (wsProbeBinarySuffix(wsSuffixOf(files[i].path)) ? " [二进制]" : ""));
  }
  return head + (lines.length ? "\n当前文件(按最近修改排序,最多 30 条;超出请用 Glob):\n" + lines.join("\n") : "");
}
function wsHasActiveFileTool(c) {
  var list = activeTools(c);
  for (var i = 0; i < list.length; i++) if (list[i].needsWorkspace) return true;
  return false;
}

/* ---- pyodide 资产缓存(pyocache 区;固定键) ---- */
var PY_CACHE_FIXED = { "asm.wasm": 1, "stdlib.zip": 1, "lock.json": 1 };
function pyCacheKeyOk(name) { return !!PY_CACHE_FIXED[name] || String(name).indexOf("wheel:") === 0; }
function pyCacheGet(name) {
  if (!pyCacheReady) return Promise.resolve(null);
  return wsStoreTx(IDB_PYC, "readonly", function (tx) {
    return wsReqP(tx.objectStore(IDB_PYC).get(String(name))).then(function (v) { return { ok: true, rec: v || null }; });
  }).then(function (r) { return wsIsErr(r) ? null : (r.rec || null); });
}
function pyCachePut(name, bytes, opts) {
  opts = opts || {};
  if (!pyCacheReady) return Promise.resolve(wsErr("EWSREADY", "运行时缓存区(pyocache)不可用"));
  var key = String(name == null ? "" : name);
  if (!pyCacheKeyOk(key)) return Promise.resolve(wsErr("EINVAL", "缓存键不在固定集合里:" + key));
  var blob = wsToBlob(bytes, "application/octet-stream");
  if (!blob) return Promise.resolve(wsErr("EINVAL", "缓存内容必须是二进制(Blob / ArrayBuffer)"));
  var rec = {
    name: key, bytes: blob, size: blob.size, gz: !!opts.gz,
    sha256: typeof opts.sha256 === "string" ? opts.sha256 : "", at: Date.now()
  };
  return wsStoreTx(IDB_PYC, "readwrite", function (tx) {
    tx.objectStore(IDB_PYC).put(rec, key);
    return { ok: true, name: key, size: rec.size };
  });
}
function pyCacheClear() {
  if (!pyCacheReady) return Promise.resolve(wsErr("EWSREADY", "运行时缓存区(pyocache)不可用"));
  return wsStoreTx(IDB_PYC, "readwrite", function (tx) {
    var st = tx.objectStore(IDB_PYC);
    return wsReqP(st.getAllKeys()).then(function (keys) {
      keys = Array.isArray(keys) ? keys : [];
      for (var i = 0; i < keys.length; i++) { try { st.delete(keys[i]); } catch (e) {} }
      return { ok: true, removed: keys.length };
    });
  });
}
function pyCacheStats() {
  if (!pyCacheReady) return Promise.resolve(wsErr("EWSREADY", "运行时缓存区(pyocache)不可用"));
  return wsStoreTx(IDB_PYC, "readonly", function (tx) {
    var st = tx.objectStore(IDB_PYC);
    return new Promise(function (resolve, reject) {
      var items = [], bytes = 0, rq;
      try { rq = st.openCursor(); } catch (e) { reject(e); return; }
      rq.onsuccess = function () {
        var cur = rq.result;
        if (!cur) { resolve({ ok: true, count: items.length, bytes: bytes, names: items }); return; }
        var v = cur.value || {};
        items.push({ name: cur.key, size: v.size || 0, gz: !!v.gz, at: v.at || 0 });
        bytes += v.size || 0;
        cur.continue();
      };
      rq.onerror = function () { reject(rq.error || new Error("遍历失败")); };
    });
  });
}

/* ===========================================================================
   6 个文件工具的实现(只经 WS.* 与工作区打交道;错误码原样带回)
   =========================================================================== */
/* 统一的工具壳:总开关 / 就绪 / 挂载 三道防御性再校验 + 路径入参规范化 */
function wsToolRun(name, args, ctx, impl) {
  var t0 = Date.now();
  /* E1:误把 Python 容器路径(/workspace/…)当工作区路径用时的定向纠错 —— 只在错误路径上加一句
     提示,不改任何语义。确指半句(「你要的可能是 /x」)只在「去掉前缀后的路径确实存在」时给:
     存在性判定走 WS_META_CACHE 的目录树(同步、零 IDB 成本;写回点 = wsReadTx 的 tx.oncomplete);
     缓存缺失/陈旧时只给泛化口径提醒(宁可少说,不说错)。覆盖面:只在错误带 res.path 时生效。 */
  function pathDualHint(res, wsId) {
    if (!res || res.code !== "ENOENT" || typeof res.path !== "string") return res;
    var p = res.path;
    if (p !== "/workspace" && p.indexOf("/workspace/") !== 0) return res;
    var rest = p.slice("/workspace".length);
    var alt = (rest && rest.charAt(0) === "/") ? rest : (rest ? "/" + rest : "/");
    var cache = (wsId && WS_META_CACHE[wsId]) || null;
    var exists = !!(cache && cache.tree && alt !== "/" && wsTreeGet(cache.tree, alt));
    var note = " —— 路径口径提醒:工作区工具用 / 开头的根路径" +
      (exists ? "(你要的可能是 " + alt + ")" : "") +
      ";/workspace 只出现在 Python 解释器里(" + p + ")。两者指向同一份文件。";
    return { ok: false, code: res.code, error: String(res.error || "操作失败") + note, path: res.path };
  }
  function fail(res) {
    return { ok: false, error: wsErrText(pathDualHint(res, wsId)), logs: [], ms: Date.now() - t0 };
  }
  if (!state.settings.toolsEnabled) {
    return Promise.resolve(fail(wsErr("EINVAL", "模型工具调用已关闭(设置 → MCP 工具)")));
  }
  if (!wsReady()) return Promise.resolve(fail(wsErr("EWSREADY", WS_NOTE_READY)));
  /* 工作区归属 = 发起这次调用的会话(见 toolRun/ctxConv);缺省 = 当前会话 */
  var wsId = wsMountedId(ctxConv(ctx));
  if (!wsId) return Promise.resolve(fail(wsErr("ENOENT", "当前会话还没有挂载工作区(在右栏「工作区」里挂载后再试)")));
  var tool = AGENT_TOOL_MAP[name];
  var paths = (tool && tool.wsPathArgs) || [];
  var a = {}, k;
  for (k in (args || {})) if (Object.prototype.hasOwnProperty.call(args, k)) a[k] = args[k];
  for (var i = 0; i < paths.length; i++) {
    var key = paths[i], v = a[key];
    if (v === undefined || v === null || v === "") continue;   /* 必填由各工具自己校验 */
    var np = wsNormPath(String(v));
    if (wsIsErr(np)) return Promise.resolve(fail(np));
    a[key] = np.path;
  }
  return Promise.resolve().then(function () {
    return impl(wsId, a, ctx);
  }).then(function (res) {
    if (wsIsErr(res)) return fail(res);
    if (!res || typeof res !== "object") return { ok: false, error: "工具没有返回结果", logs: [], ms: Date.now() - t0 };
    if (res.ms == null) res.ms = Date.now() - t0;
    /* 写类工具(scope="write":Write / Edit / FileOps —— 也只有这三个走 wsToolRun)落盘后
       把右栏刷一遍:否则模型刚写进去的文件在右栏列表里看不见,要用户手点一次刷新。
       只在这个粒度上刷 —— 下沉到 wsWriteText 之类内核的话,脚本批量落盘会变成每次一个全量重渲染。
       ExecutePython 不过这里(它走 pyToolRun),它的刷新点在 pyWriteBack(前台 + 后台两条路共用)。
       (下一轮请求的【工作区】上下文不走这里:WS_META_CACHE 由写事务自己更新,本来就是新的) */
    if (res.ok !== false && tool && tool.scope === "write" && typeof afterWsChange === "function") {
      try { afterWsChange(); } catch (e) {}
    }
    return res;
  }, function (e) {
    return { ok: false, error: "工作区操作异常:" + wsMsg(e), logs: [], ms: Date.now() - t0 };
  });
}
function wsErrText(res) {
  return String((res && res.error) || "操作失败") + "(错误码 " + ((res && res.code) || "EIO") + ")";
}
/* 行尾三态(Kimi line-endings.ts 同式):有孤立 CR、或 CRLF 与 LF 混用 → mixed */
function wsLineEndingStyle(text) {
  var hasCrLf = false, hasLf = false, hasLoneCr = false, c, i;
  for (i = 0; i < text.length; i++) {
    c = text.charCodeAt(i);
    if (c === 13) {
      if (text.charCodeAt(i + 1) === 10) { hasCrLf = true; i++; }
      else hasLoneCr = true;
    } else if (c === 10) hasLf = true;
  }
  if (hasLoneCr || (hasCrLf && hasLf)) return "mixed";
  if (hasCrLf) return "crlf";
  return "lf";
}
function wsIsHighSurrogate(ch) {
  var c = ch.charCodeAt(0);
  return c >= 0xd800 && c <= 0xdbff;
}
/* EBINARY 文案(读路径专用;Edit 的拒写走 EINVAL):路径 + 类型 + 三条出路(§3.2)。
   注意 ③ 是本批新增的真实可行路径:工作区文件可由 ExecutePython 解包/转码后写回,再 Read */
function wsBinaryErr(path, type, size, extra, mime) {
  return wsErr("EBINARY",
    "「" + path + "」不是 Read 能直接读的内容(" + (type || "未知二进制") + (mime ? ", " + mime : "") + ", " + fmtBytes(size || 0) + ")。" +
    (extra || "") +
    "Read 现在支持:纯文本 / 图片(png·jpg·gif·webp·bmp·avif·ico) / 办公文档(doc·docx·ppt·pptx·xls·xlsx) / PDF。" +
    "这份文件属于其它二进制,请不要重试。next_step: ① 需要字节 → 用 ExecutePython 以 open(\"/workspace/x.zip\",\"rb\") 读取(容器内路径以 /workspace/ 开头);" +
    "② 取走/搬动 → 右栏「下载」或 FileOps;③ 需要里面的内容 → 先用 ExecutePython 解包(标准库 zipfile 可用;解出来的文件写进工作区)再 Read 那些文件。",
    path);
}

/* ---- Read 的图片 / 文档路径(§3.2–§3.7):判定 / 预算 / OCR / 媒体注记 ---- */
/* 可解码图片后缀(比 IMAGE_EXT 严:不含 svg —— svg 永远按文本读)。
   含 tif/tiff:真 TIFF 在浏览器里解不开,但要进图片路径才能拿到「无法解码 + Pillow 转换」的
   可读错误(判据 (a) 的 mime 可能被上传时记录的非 image mime 盖住,后缀这层必须兜住) */
var WS_READ_IMG_EXT = ["png", "jpg", "jpeg", "gif", "webp", "bmp", "avif", "ico", "tif", "tiff"];
/* 图片判定(§3.2):(a) magic 命中且 mime 是 image/* —— 单独看 suffix/mime 会被
   「上传时记录 mime=image/* 但内容不是图」骗到;(b) 否则后缀 ∈ 可解码集合(fit 会统一重编码) */
function wsImgKindOf(probe, path) {
  if (!probe) return false;
  if (probe.why === "magic" && /^image\//i.test(String(probe.mime || ""))) return true;
  return WS_READ_IMG_EXT.indexOf(wsSuffixOf(path)) > -1;
}
/* office / pdf 判定(§3.2 路 2/3):后缀优先;magic 只在「后缀不是 pdf」时兜底 */
function wsDocKindOf(path, probe) {
  var suf = wsSuffixOf(path);
  if (suf === "pdf") return "pdf";
  if (probe && probe.why === "magic" && probe.mime === "application/pdf") return "pdf";
  if (OFFICE_EXT.indexOf(suf) > -1) return "office";
  return "";
}
function wsMimeShort(mime) {
  var t = String(mime || "").toLowerCase();
  if (t === "image/png") return "PNG";
  if (t === "image/jpeg") return "JPEG";
  if (t === "image/gif") return "GIF";
  if (t === "image/webp") return "WebP";
  if (t === "image/bmp") return "BMP";
  if (t === "image/avif") return "AVIF";
  if (t === "image/tiff") return "TIFF";
  if (t === "image/x-icon" || t === "image/vnd.microsoft.icon") return "ICO";
  return t || "图片";
}
/* base64 → Blob(媒体重新 fit / OCR 的输入;解析失败返回 null,调用方按「跳过这一张」处理) */
function wsBase64Blob(b64, mime) {
  try {
    var bin = atob(String(b64 || ""));
    var u8 = new Uint8Array(bin.length);
    for (var i = 0; i < bin.length; i++) u8[i] = bin.charCodeAt(i);
    return new Blob([u8], { type: mime || "application/octet-stream" });
  } catch (e) { return null; }
}
/* 媒体状态行(单一文案来源;§3.8.2):
   [image /a.png · PNG · 1024×768 · 210.4 KB · 已随本次结果附带 1 张(原图 4096×3072,已按工具图片上限缩放)] */
function wsMediaNote(items, extra) {
  var arr = items || [], n = arr.length, first = arr[0] || {};
  var segs = ["image" + (n > 1 ? (" ×" + n) : (" " + (first.path || "")))];
  if (first.mime) segs.push(wsMimeShort(first.mime));
  if (first.w && first.h) segs.push(first.w + "×" + first.h + (n > 1 ? "(首张)" : ""));
  if (first.bytes) segs.push(fmtBytes(first.bytes) + (n > 1 ? "(首张)" : ""));
  segs.push("已随本次结果附带 " + n + " 张" + (first.scaled
    ? ("(原图 " + (first.srcW || "?") + "×" + (first.srcH || "?") + ",已按工具图片上限缩放)")
    : "(原图字节,未重编码)"));
  if (extra) segs.push(String(extra));
  return "[" + segs.join(" · ") + "]";
}
/* 工具侧唯一的视觉判定(§3.3/§3.12):true = 可以发图片。
   取值按**发起调用的会话**(ctxConv(ctx)),与工作区归属 / ctx.conv 同一口径。
   **有意不用 effectiveModel()**:它读模块级 conv(生成期间切走会话会读到错模型),后来者不要改回去。 */
function toolVisionCanImage(convLike) {
  var m = (convLike && convLike.model) || state.settings.model || "";
  return visionState(m).vision !== false;
}
/* OCR 的唯一出口(§3.6):可用性 → 总预算 → 文案。dataUrl 用「按工具图片上限缩放后」的画布
   (与附件 maybeOcrImage 完全同形);timeout = 本次剩余预算(多页共享一个 deadline) */
function wsOcrTextOf(dataUrl, opts) {
  opts = opts || {};
  if (!ocrReady()) {
    return Promise.resolve({ ok: false, error: "本机 OCR 引擎不可用(" +
      ((window.OCRKit && window.OCRKit.why) || "缺少 Web Worker / WebAssembly") + ")" });
  }
  var ms = clampNum(opts.remainingMs, 1000, READ_OCR_TIMEOUT_MS, READ_OCR_TIMEOUT_MS);
  return window.OCRKit.recognize(dataUrl, { langs: ocrLangs(), timeout: ms }).then(function (r) {
    if (!r || !r.ok) {
      var err = String((r && r.error) || "未知");
      if (/超时/.test(err)) {
        return { ok: false, error: "OCR 超时(整次 Read 的 OCR 预算 " + Math.round(ms / 1000) + " 秒):可换更小的图,或用 ExecutePython 先裁剪后再 Read" };
      }
      return { ok: false, error: "OCR 识别失败(" + err + ")" };
    }
    return { ok: true, text: String(r.text || "").trim(), confidence: r.confidence,
             ms: r.ms || 0, version: (window.OCRKit && window.OCRKit.version) || "" };
  }, function (e) { return { ok: false, error: "OCR 识别失败(" + wsMsg(e) + ")" }; });
}
/* OCR 状态行(§3.6 示例):[OCR /scan.png · PNG · 1280×720 · 识别 412 字 · chi_sim+eng · 置信度 82.4% · 本机 Tesseract.js 7.0.0 · 可能有识别误差] */
function wsOcrLead(path, mime, w, h, text, o) {
  return "OCR " + path + " · " + wsMimeShort(mime) + " · " + w + "×" + h +
    " · 识别 " + String(text).length + " 字 · " + ocrLangs() +
    " · 置信度 " + ((o && typeof o.confidence === "number") ? (o.confidence.toFixed(1) + "%") : "未知") +
    " · 本机 Tesseract.js " + ((o && o.version) || "") + " · 可能有识别误差";
}
/* 图片路径:视觉可发 → fit 后作为媒体附带;非视觉 → 对缩放后的画布做 OCR,只回文本(对 Agent 无感) */
function wsReadImageResult(wsId, r, args, ctx) {
  var path = r.path;
  var sig = ctx && ctx.signal;
  if (sig && sig.aborted) return Promise.resolve(wsErr("EBINARY", "生成已中止,本次读取没有执行", path));
  return wsImgFitForModel(r.blob, r.mime, { path: path }).then(function (f) {
    if (!f.ok) return wsErr("EBINARY", f.error, path);
    if (!toolVisionCanImage(ctxConv(ctx))) {
      /* 非视觉:OCR 输入 = fit 后的画布(不与原图纠缠),整次 Read 一个总预算 */
      var remain = Math.min(READ_OCR_TIMEOUT_MS, toolLimit("timeoutMs"));
      return wsOcrTextOf("data:" + f.mime + ";base64," + f.data, { remainingMs: remain }).then(function (o) {
        if (!o.ok) return wsErr("EBINARY", o.error, path);
        if (!o.text) {
          return wsErr("EBINARY", "「" + path + "」在本机 OCR 里没有识别到文字,而当前模型不支持图像输入 —— 这张图的内容无法读取" +
            "(可换支持视觉的模型,或用 ExecutePython 处理)", path);
        }
        return wsLinePageResult(o.text, args, {
          lead: wsOcrLead(path, f.mime, f.w, f.h, o.text, o), stats: false, size: r.size, mtime: r.at
        });
      });
    }
    var item = {
      kind: "image", mime: f.mime, data: f.data, w: f.w, h: f.h, bytes: f.bytes,
      path: path, label: "", from: "image", srcW: f.srcW, srcH: f.srcH, scaled: !!f.scaled
    };
    return { ok: true, text: wsMediaNote([item], ""), media: [item] };
  });
}
/* 把候选图片(office 图 / PDF 页图)按预算 fit 成可交付媒体项:
   调用方已按张数截断;这里再按累计字节(READ_MEDIA_TOTAL_BYTES)取舍,fit 不过的整张丢弃 */
function wsFitCands(cands) {
  var out = [], total = 0, i = 0;
  function step() {
    if (i >= cands.length) return Promise.resolve();
    var c = cands[i] || {};
    var blob = wsBase64Blob(c.data, c.mime);
    if (!blob) { i++; return step(); }
    return wsImgFitForModel(blob, c.mime, {}).then(function (f) {
      if (f.ok && (total + f.bytes) <= READ_MEDIA_TOTAL_BYTES) {
        total += f.bytes;
        out.push({
          kind: "image", mime: f.mime, data: f.data, w: f.w, h: f.h, bytes: f.bytes,
          path: c.path || "", label: c.label || "", from: c.from || "office-image",
          srcW: f.srcW, srcH: f.srcH, scaled: !!f.scaled
        });
      }
      i++;
      return step();
    });
  }
  return step().then(function () { return { media: out, bytes: total, skipped: cands.length - out.length }; });
}
/* 逐张 OCR(共享一个总预算 deadline;页间查 ctx.signal.aborted;文本累加到工具结果预算即停) */
function wsOcrCands(cands, args, ctx, r, text, info) {
  var sig = ctx && ctx.signal;
  var deadline = Date.now() + Math.min(READ_OCR_TIMEOUT_MS, toolLimit("timeoutMs"));
  var budgetChars = Math.max(512, toolLimit("maxOut") - 512);
  var parts = [], acc = 0, done = 0, stopped = 0, aborted = false;
  var base = String(text == null ? "" : text).trim();
  if (base) { parts.push(base); acc += base.length; }
  function step() {
    if (done >= cands.length) return Promise.resolve();
    if (sig && sig.aborted) { aborted = true; return Promise.resolve(); }
    if (Date.now() >= deadline) { stopped = cands.length - done; return Promise.resolve(); }
    if (acc >= budgetChars) { stopped = cands.length - done; return Promise.resolve(); }
    var c = cands[done] || {};
    var remain = Math.max(1000, deadline - Date.now());
    var blob = wsBase64Blob(c.data, c.mime);
    if (!blob) { done++; return step(); }
    return wsImgFitForModel(blob, c.mime, {}).then(function (f) {
      if (!f.ok) { done++; return step(); }
      return wsOcrTextOf("data:" + f.mime + ";base64," + f.data, { remainingMs: remain }).then(function (o) {
        done++;
        if (o.ok && o.text) {
          var seg = (cands.length > 1 ? ("【" + (c.label || ("第 " + done + " 页")) + "】\n") : "") + o.text;
          parts.push(seg);
          acc += seg.length;
        } else if (!o.ok && /超时/.test(String(o.error || ""))) {
          stopped = cands.length - done;
          return Promise.resolve();
        }
        return step();
      });
    });
  }
  return step().then(function () {
    if (!parts.length) {
      if (aborted) return wsErr("EBINARY", "生成已中止,本次读取没有完成", r.path);
      return wsErr("EBINARY", "「" + r.path + "」里的图片在本机 OCR 里没有识别到文字,而当前模型不支持图像输入 —— " +
        "内容无法读取(可换支持视觉的模型,或用 ExecutePython 处理)", r.path);
    }
    var info2 = (info || []).slice();
    if (info2.indexOf("没有可读文本,已改用 OCR") < 0 && !base) info2.push("本机 OCR 识别(可能有误差)");
    if (stopped > 0) info2.push("还有 " + stopped + " 页未识别");
    if (aborted) info2.push("生成已中止,结果不完整");
    return wsLinePageResult(parts.join("\n\n"), args, {
      lead: info2.join(" · ") + " · OCR", stats: false, size: r.size, mtime: r.at
    });
  });
}
/* 文档(office)结果收尾:text 走分页内核;图片按视觉能力附带或丢弃(§3.7.2/§3.6 混合场景) */
function wsDocumentPack(o) {
  var text = String(o.text == null ? "" : o.text);
  var cands = (o.cands || []).slice();
  var info = (o.info || []).slice();
  var vision = toolVisionCanImage(ctxConv(o.ctx));
  if (!cands.length) {
    return Promise.resolve(wsLinePageResult(text, o.args, { lead: info.join(" · "), size: o.r.size, mtime: o.r.at }));
  }
  if (o.ocr) return wsOcrCands(cands.slice(0, READ_MEDIA_MAX_IMAGES), o.args, o.ctx, o.r, text, info);
  if (!vision) {
    /* 与附件 resolveOffice 的 dropImages 同语义:非视觉丢图,文本照给 */
    if (text.trim()) info.push(cands.length + " 图已跳过(当前模型不支持图像输入)");
    return Promise.resolve(wsLinePageResult(text, o.args, { lead: info.join(" · "), size: o.r.size, mtime: o.r.at }));
  }
  var lim = Math.min(cands.length, READ_MEDIA_MAX_IMAGES);
  var skipped = cands.length - lim;
  if (skipped) info.push("另有 " + skipped + " 图超出单次上限未附带(可用 ExecutePython 逐张拆出来再 Read)");
  return wsFitCands(cands.slice(0, lim)).then(function (out) {
    if (out.media.length) info.push(out.media.length + " 图已附带");
    else if (skipped < cands.length) info.push("图片均超出单张体积上限,未附带");
    var res = wsLinePageResult(text, o.args, { lead: info.join(" · "), size: o.r.size, mtime: o.r.at });
    if (out.media.length) res.media = out.media;
    return res;
  });
}
/* office 六格式(§3.7.2):与 wsPreviewOffice 同一调用式(直接调 OfficeKit.parse,不走 resolveOffice) */
function wsReadOfficeResult(wsId, r, args, ctx) {
  var path = r.path;
  if (!officeReady()) {
    return Promise.resolve(wsErr("EBINARY", "「" + path + "」需要办公文档解析库,但它当前不可用(" +
      ((window.OfficeKit && window.OfficeKit.why) || "缺少必要能力") + ")", path));
  }
  var cap = officeSizeCap();
  if (r.size > cap) {
    return Promise.resolve(wsErr("EBINARY", "「" + path + "」超过 " + fmtBytes(cap) + " 上限,已跳过" +
      (cap === ATTACH_MAX_BYTES ? "" : "(当前是主线程降级模式)"), path));
  }
  var capMs = Math.min((window.OfficeKit.limits && window.OfficeKit.limits.timeoutMs) || 60000, toolLimit("timeoutMs"));
  return readAs(r.blob, "buffer").then(function (buf) {
    return window.OfficeKit.parse(buf, wsSuffixOf(path), { timeout: capMs, onProgress: null });
  }, function (e) { return { ok: false, error: wsMsg(e) }; }).then(function (o) {
    if (!o || !o.ok) return wsErr("EBINARY", wsDocErrText(path, o), path);
    var subtype = String(o.subtype || wsSuffixOf(path)).toUpperCase();
    var text = String(o.text || "");
    var info = ["file " + path, subtype];
    if (o.unit === "页" && o.pages) info.push("共 " + o.pages + " 页");
    else if (o.unit === "表" && o.pages) info.push("共 " + o.pages + " 表");
    if (o.subtype === "doc" || o.subtype === "ppt") info.push("仅文本(老格式无图像提取)");
    if (o.clipped) info.push("clipped");
    var cands = [];
    (o.images || []).forEach(function (im) {
      cands.push({ mime: im.mime || "image/png", data: im.data || "", label: im.label || "",
                   from: "office-image", path: path });
    });
    var haveText = !!text.trim();
    if (haveText && !cands.length) return wsDocumentPack({ text: text, cands: [], info: info, args: args, ctx: ctx, r: r });
    if (!haveText && !cands.length) {
      return wsErr("EBINARY", "「" + path + "」没有可读的文本内容(可能是纯图片文档,且没有可提取的图片)", path);
    }
    if (!haveText) info.push(toolVisionCanImage(ctxConv(ctx))
      ? "没有可读文本,改附图片" : "没有可读文本,已改用 OCR(当前模型不支持图像输入)");
    return wsDocumentPack({
      text: text, cands: cands, info: info, args: args, ctx: ctx, r: r,
      ocr: !haveText && !toolVisionCanImage(ctxConv(ctx))
    });
  });
}
/* PDF(§3.7.3):文本优先(不读 pdfMode() 设置 —— Read 的契约是「读内容」);
   无文字层 ⇒ 视觉发页图 / 非视觉 OCR;页数上限 = min(pdfMaxPages(), READ_PDF_IMG_MAX_PAGES) */
function wsReadPdfResult(wsId, r, args, ctx) {
  var path = r.path;
  if (!window.PDFKit || !window.PDFKit.available) {
    return Promise.resolve(wsErr("EBINARY", "「" + path + "」需要 PDF 解析库,但它当前不可用(" +
      ((window.PDFKit && window.PDFKit.why) || "缺少必要能力") + ")", path));
  }
  return wsBlobBuffer(r.blob).then(function (buf) {
    return window.PDFKit.extractText(buf, { maxChars: ATTACH_TEXT_MAX, maxPages: 200 }).then(function (o) {
      if (!o || !o.ok) return wsErr("EBINARY", "「" + path + "」PDF 文本抽取失败(" + ((o && o.error) || "未知") + ")", path);
      var text = String(o.text || "");
      /* 「有文字层」的判据要排除 pdf.js 的分页标记(否则扫描件会拿到只有 "----- 第 N 页 -----" 的假文本) */
      var realText = text.replace(/^[-\s]*第\s*\d+\s*页[-\s]*$/gm, "").trim();
      if (realText) {
        var info = ["file " + path, "PDF", "共 " + (o.pages || 1) + " 页",
                    "文本 " + num(o.chars != null ? o.chars : text.length) + " 字符"];
        if (o.truncated) info.push("已截断");
        return wsLinePageResult(text, args, { lead: info.join(" · "), size: r.size, mtime: r.at });
      }
      var maxPages = Math.min(pdfMaxPages(), READ_PDF_IMG_MAX_PAGES);
      return window.PDFKit.renderPages(buf, { dpi: pdfDpi(), maxPages: maxPages, format: "image/jpeg", quality: 0.86 })
        .then(function (pr) {
          if (!pr || !pr.ok || !pr.images || !pr.images.length) {
            return wsErr("EBINARY", "「" + path + "」没有文字层,且渲染页图失败(" + ((pr && pr.error) || "未知") + ")", path);
          }
          var cands = [];
          pr.images.forEach(function (im, i) {
            cands.push({
              mime: (String(im.dataUrl || "").match(/^data:([^;,]+)/) || [])[1] || "image/jpeg",
              data: dataUrlPayload(im.dataUrl || ""), label: "第 " + (im.page || (i + 1)) + " 页",
              from: "pdf-page", path: path
            });
          });
          var info = ["file " + path, "PDF", "共 " + (pr.pages || cands.length) + " 页",
                      "没有文字层,已改用前 " + Math.min(cands.length, maxPages) + " 页图片"];
          return wsDocumentPack({
            text: "", cands: cands, info: info, args: args, ctx: ctx, r: r,
            ocr: !toolVisionCanImage(ctxConv(ctx))
          });
        });
    });
  }, function (e) { return wsErr("EBINARY", "「" + path + "」PDF 读取失败:" + wsMsg(e), path); });
}
function wsReadDocResult(wsId, r, args, ctx) {
  if (wsDocKindOf(r.path, r.probe) === "pdf") return wsReadPdfResult(wsId, r, args, ctx);
  return wsReadOfficeResult(wsId, r, args, ctx);
}
/* office 失败文案:errorKind → 可读中文(复用 officekit.src.js 的 MSG 口径,不新造词) */
function wsDocErrText(path, o) {
  var kind = (o && o.errorKind) || "";
  var m = {
    "too-big": "文件过大", "zip-bomb": "文件疑似 ZIP 炸弹(压缩比异常)", "encrypted": "文件已加密(需要密码)",
    "corrupt": "文件已损坏", "unsupported": "不支持的格式", "timeout": "解析超时",
    "cancelled": "解析被取消", "worker": "解析线程异常"
  };
  return "「" + path + "」解析失败:" + ((o && o.error) || "未知错误") + (m[kind] ? "(" + m[kind] + ")" : "") +
    ";文件可能已损坏或受密码保护";
}
/* Read 的类型路由(§3.2;顺序即优先级):1 文本(现状,输出逐字节不变,svg 也在这里)
   → 2/3 office/PDF → 4 图片(视觉直读 / 非视觉 OCR)→ 5 宏格式沿用既有拒绝 → 5 其余二进制(新文案) */
function wsReadTool(wsId, args, ctx) {
  if (!args.path) return Promise.resolve(wsErr("EINVAL", "path 必填(工作区绝对路径,例如 /notes/a.md)"));
  /* column_offset 只用于正向读(Kimi readTool.ts:198-199 同口径) */
  if (args.column_offset != null && typeof args.line_offset === "number" && args.line_offset < 0) {
    return Promise.resolve(wsErr("EINVAL", "column_offset 只用于正向读,不能与负数 line_offset 同时给出"));
  }
  return wsReadBlob(wsId, args.path).then(function (r) {
    if (wsIsErr(r)) return r;
    return wsProbeBlob(r.blob, r.path, r.mime).then(function (pr) {
      r.probe = pr;
      if (pr && pr.kind === "text") return wsReadTextResult(r, args, pr);
      if (wsDocKindOf(r.path, pr)) return wsReadDocResult(wsId, r, args, ctx);
      if (wsImgKindOf(pr, r.path)) return wsReadImageResult(wsId, r, args, ctx);
      var suf = wsSuffixOf(r.path);
      if (isMacroExt(suf)) {
        return wsErr("EBINARY", "「" + r.path + "」是宏格式(." + suf + "),暂不支持转换;请另存为 .docx / .xlsx / .pptx 后再 Read", r.path);
      }
      return wsBinaryErr(r.path, (pr && pr.type) || "未知二进制", r.size, "", (pr && pr.mime) || "");
    });
  });
}

/* 抽自 wsReadTextResult 的渲染内核(§3.7.1):文本 → 行号视图 + 分页 + truncated/next_* 坐标 + 状态行。
   重构判据:既有文本读的**输出逐字节不变**(见 progress 的回归装置:请求体差分 + 源码切片 harness)。
   meta = {lead(状态行前缀:office/PDF/OCR 用), size, mtime, enc, tailNote, truncatedExtra, stats} */
function wsLinePageResult(text, args, meta) {
  meta = meta || {};
  var size = meta.size || 0, enc = meta.enc || "";
  var style = wsLineEndingStyle(text);
  var view = text, i;
  if (style === "crlf") {
    var arr = text.split("\n");
    for (i = 0; i < arr.length; i++) if (arr[i].charAt(arr[i].length - 1) === "\r") arr[i] = arr[i].slice(0, -1);
    view = arr.join("\n");
  } else if (style === "mixed") {
    view = text.split("\r").join("\\r");
  }
  var lines = view.split("\n");
  var total = lines.length;
  if (total > 1 && lines[total - 1] === "" && /\n$/.test(view)) total--;
  var start = 1;
  if (typeof args.line_offset === "number" && isFinite(args.line_offset) && args.line_offset !== 0) {
    start = args.line_offset < 0 ? (total + 1 + Math.floor(args.line_offset)) : Math.floor(args.line_offset);
    if (start < 1) start = 1;
  }
  var col = Math.max(0, clampNum(args.column_offset, 0, 100000000, 0));
  var want = args.n_lines == null ? 0 : clampNum(args.n_lines, 1, 1000000, 0);
  var maxReq = clampNum(args.max_chars, 1, READ_MAX_CHARS, READ_DEFAULT_CHARS);
  /* 有效上限还受结果预算约束:状态行(整段)必须活着,模型才能翻页 */
  var maxChars = Math.min(maxReq, Math.max(256, toolLimit("maxOut") - 256));
  var out = [], used = 0, shownTo = start - 1, truncated = false, nextCol = null;
  for (var ln = start; ln <= total; ln++) {
