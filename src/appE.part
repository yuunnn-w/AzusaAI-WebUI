  if (d.t === "ready") {
    slot.phase = "ready";
    slot.loaded = (d.loadedPackages && typeof d.loadedPackages === "object") ? d.loadedPackages : {};
    /* 硬失败态一旦置上就不能被"某个 slot 起来"抹掉(载荷本身坏掉时每个 slot 都会失败);
       原因同理:error 态下不清 reason,否则 pyNotReadyReason() 会退化回兜底文案 */
    if (PY_STATE.phase !== "error") { PY_STATE.phase = "ready"; PY_STATE.reason = ""; }
