      result: String(d.result == null ? "" : d.result),
      files: Array.isArray(d.files) ? d.files : [],
      deletes: Array.isArray(d.deletes) ? d.deletes : [],
      ms: Number(d.ms) || 0,
      error: String(d.error == null ? "" : d.error),
      traceback: String(d.traceback == null ? "" : d.traceback),
