/* 装载进度的重绘节流(worker 每包一条消息;终态更新绕过节流直调 pyStateSync):
   中间进度只重绘状态行(轻),不刷 MCP 面板等重面 */
var PY_STAGE_AT = 0, PY_STAGE_TIMER = null;
function pyStageTick() {
  var now = Date.now(), wait = PY_STAGE_THROTTLE_MS - (now - PY_STAGE_AT);
  if (wait <= 0) {
    PY_STAGE_AT = now;
    try { renderPyRunState(); } catch (e) {}
    return;
  }
  if (PY_STAGE_TIMER) return;
  PY_STAGE_TIMER = setTimeout(function () {
    PY_STAGE_TIMER = null;
    PY_STAGE_AT = Date.now();
    try { renderPyRunState(); } catch (e) {}
  }, wait);
}
function pyOnWorkerMsg(ev, slot) {
  var d = ev && ev.data;
