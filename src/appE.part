}
function wsProbeAsText(res, enc, why) {
  res.kind = "text";
  res.enc = enc;
  res.why = why;
  return res;
}
/* 探针入口:两次 slice(head + tail)后同步判定 */
function wsProbeBlob(blob, name, mime) {
  var size = blob ? blob.size : 0;
  var whole = size <= WS_PROBE_SAMPLE_BYTES + WS_PROBE_TAIL_BYTES;
  var headBlob = whole ? blob : blob.slice(0, WS_PROBE_SAMPLE_BYTES);
  var tailBlob = whole ? null : blob.slice(size - WS_PROBE_TAIL_BYTES);
  return Promise.all([
    wsBlobBuffer(headBlob),
    tailBlob ? wsBlobBuffer(tailBlob) : Promise.resolve(null)
  ]).then(function (bufs) {
    var head = new Uint8Array(bufs[0] || new ArrayBuffer(0));
    var tail = bufs[1] ? wsTrimStartCont(new Uint8Array(bufs[1])) : null;
    return wsProbeJudge(head, tail, whole, name, mime);
