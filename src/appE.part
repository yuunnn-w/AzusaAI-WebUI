/* 探针判定(同步):head = 首段(head 段,>8704 B 时为前 8192 B)、tail = 末段(已跳悬垂续字节)、
   whole = 是否整份(≤8704 B) */
function wsProbeJudge(head, tail, whole, name, mime) {
