  "    buf = (data.byteOffset === 0 && data.byteLength === data.buffer.byteLength)",
  "      ? data.buffer : data.buffer.slice(data.byteOffset, data.byteOffset + data.byteLength);",
  "    outFiles.push({ path: wrel, data: buf });",
