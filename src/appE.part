function pyWrapSources() { return { code: pyWrapFor("code"), script: pyWrapFor("script") }; }

function pyStripSourceMap(s) {
  return String(s == null ? "" : s).replace(/^[ \t]*\/\/[#@][ \t]*sourceMappingURL=.*$/gm, "");
}
function buildPyodideWorkerSrc(assets) {
  return PY_WORKER_HEAD
    + "\n/* ---- pyodide.asm.mjs(改写后的工厂:_createPyodideModule + 全局赋值)---- */\n"
    + "(function () {\n\"use strict\";\n" + assets.core.asmJs + "\n})();\n"
    + "\n/* ---- pyodide.js(官方 classic 构建产物,原样;只去掉 sourceMappingURL 注释)---- */\n"
    + "(function () {\n\"use strict\";\n" + pyStripSourceMap(assets.core.pyodideJs) + "\n})();\n"
    + "\n/* ---- 执行包装器的 Python 源码(主线程生成,JSON 内联;见 pyWrapFor)---- */\n"
    + "var __PY_WRAP = " + JSON.stringify(pyWrapSources()) + ";\n"
    + "\n/* ---- 输出/节流限额(主线程常量是唯一权威)---- */\n"
    + "var __PY_LIMITS = " + JSON.stringify({ out: PY_OUT_CAP, model: PY_MODEL_TAIL, msgMs: PY_MSG_MIN_MS, msgBytes: PY_MSG_MIN_BYTES }) + ";\n"
    + PY_WORKER_TAIL;
}

/* ---- 解释器池:取用 / 启动 / 停止 / 空闲回收 ----
   池的上限是「最多 2 个未完成任务」,实现上就等于「最多 2 个活 slot」:
   一个任务独占一个 slot 直到终态,slot 死了立刻从池里摘掉 */
function pySlotAcquire() {
  var s = pySlotReadyFree();
  if (s) return Promise.resolve(s);
  if (PY_POOL.length >= PV_POOL_MAX) return null;      /* 池满 → 调用方回 EBUSY */
  s = pySlotNew();
  PY_POOL.push(s);
  return pyBootWorker(s).then(function () { return s; }, function (e) {
    pySlotKill(s, "Python 运行时启动失败");
    throw e;
  });
}
function pyHardFail(reason) {
  PY_STATE.phase = "error";
  PY_STATE.reason = reason || "Python 运行时加载失败";
