}
/* 编码显示名(状态行注记与错误文案共用) */
function wsEncName(enc) {
  if (enc === "utf-16le") return "UTF-16 LE";
  if (enc === "utf-16be") return "UTF-16 BE";
  if (enc === "gb18030") return "GB18030";
  return String(enc || "utf-8").toUpperCase();
}
function wsToBlob(v, mime) {
  if (wsBlobOf(v)) return v;
  if (v instanceof ArrayBuffer) return new Blob([v], { type: mime || "application/octet-stream" });
  if (window.Uint8Array && v instanceof window.Uint8Array) return new Blob([v], { type: mime || "application/octet-stream" });
  return null;
}

/* ---- 事务与请求 ---- */
function wsDb() { return blobDb(); }
function wsReqP(rq) {
  return new Promise(function (resolve, reject) {
    rq.onsuccess = function () { resolve(rq.result); };
    rq.onerror = function () { reject(rq.error || new Error("存储请求失败")); };
  });
}
function wsTxFail(tx) {
  var err = tx && tx.error;
  var name = (err && err.name) || "";
  if (name === "QuotaExceededError" || name === "QUOTA_EXCEEDED_ERR") {
    return wsErr("ENOSPC", "浏览器存储配额已满,本次写入被拒绝(可在「清理空间」里释放,或调小工作区配额)");
  }
  return wsErr("EIO", "工作区存储事务失败:" + (name || (err && err.message) || "未知错误"));
}
/* 单区/多区事务的通用外壳:fn(tx) 返回结果对象或 Promise;ok:false 即中止事务 */
function wsStoreTx(stores, mode, fn) {
  return wsDb().then(function (db) {
    if (!db) return wsErr("EWSREADY", WS_NOTE_READY);
    return new Promise(function (resolve) {
      var done = false, out = null;
      function finish(r) { if (done) return; done = true; resolve(r); }
      var tx;
      try { tx = db.transaction(stores, mode); }
      catch (e) { finish(wsErr("EIO", "无法打开工作区存储事务:" + wsMsg(e))); return; }
      tx.oncomplete = function () { finish(out || { ok: true }); };
      tx.onerror = function () { finish(out || wsTxFail(tx)); };
      tx.onabort = function () { finish(out || wsTxFail(tx)); };
      var r;
      try { r = fn(tx); } catch (e) { out = wsErr("EIO", wsMsg(e)); try { tx.abort(); } catch (e2) {} finish(out); return; }
      if (r && typeof r.then === "function") {
        r.then(function (res) {
          if (res && res.ok === false) { out = res; try { tx.abort(); } catch (e) {} finish(res); return; }
          out = res || { ok: true };
        }, function (e) {
          out = wsIsErr(e) ? e : wsErr("EIO", wsMsg(e));
          try { tx.abort(); } catch (e2) {}
          finish(out);
        });
      } else if (r && r.ok === false) { out = r; try { tx.abort(); } catch (e) {} finish(r); }
      else out = r || { ok: true };
    });
  });
