function wsWriteTool(wsId, args) {
  if (!args.path) return Promise.resolve(wsErr("EINVAL", "path 必填(工作区绝对路径)"));
  if (typeof args.content !== "string") return Promise.resolve(wsErr("EINVAL", "content 必填且必须是字符串"));
