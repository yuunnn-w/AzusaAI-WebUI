           /* repeat code length 0 for 3-10 times (read 3 bits) */
           for (length = tinf_read_bits(d, 3, 3); length; --length) {
             lengths[num++] = 0;
           }
           break;
         case 18:
           /* repeat code length 0 for 11-138 times (read 7 bits) */
           for (length = tinf_read_bits(d, 7, 11); length; --length) {
