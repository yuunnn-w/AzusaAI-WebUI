  {
    name: "AskUser",
    title: "向用户提问",
    scope: "read",
    icon: "chat",
    desc: "向用户提出 1–4 个带选项的问题,用户可点选项或自己输入,提交后把全部回答返回给你。适合动手前确认需求、或在多条合理路线之间让用户拍板。",
    modelDesc: [
      "向用户提问,并在用户提交后拿到全部回答。适合:收集用户的偏好与取舍、澄清含糊的指令、在几条合理实现路线之间让用户拍板、把候选方案摆成选项让用户挑。",
      "",
      "- 什么时候**不要**用:能从上下文或工作区推断出来的就别问;不影响结果的小决定别问;过度使用会打断用户。只有当「用户的输入真的会改变你的下一步」时才用。",
      "- 每次 1–4 个问题;同一次调用内**问题文本必须唯一**,每个问题内**选项标签必须唯一**(违反会被拒绝,请改写后重新调用)。",
      "- 每题 2–4 个有区分度的选项;标签尽量简短(1–5 个词),把权衡与细节写进 `description`;**不要自己加「其他」**(系统会自动提供自定义输入)。",
      "- 有推荐项时把它放**第一位**,并在标签末尾加「(推荐)」。",
      "- `multi_select:true` 表示可以多选;回答里多选项以逗号分隔。",
      "- 结果格式:`{\"answers\":{\"<问题原文>\":\"<选中的标签 / 用户自述>\"}}`。用户跳过后是 `{\"answers\":{},\"note\":\"…\"}` —— **不得**把跳过当作选择了推荐项,也不要重复问同一个问题(确实需要就在正文里直接说明并继续)。",
      "- 用户作答期间你的生成是挂起的(页面在等用户点提交);不要在等待期间臆造答案。"
    ].join("\n"),
    defaultPerm: "allow",
    inputSchema: {
      type: "object",
      properties: {
        questions: {
          type: "array",
          minItems: 1,
          maxItems: 4,
          description: "要问用户的问题(1–4 个;问题文本必须唯一)",
          items: {
            type: "object",
            properties: {
              question: { type: "string", description: "问题全文(会原样作为 answers 的键,必须唯一)" },
              header: { type: "string", description: "题头小标签(可选,≤12 字,例如「实现路线」)" },
              options: {
                type: "array",
                minItems: 2,
                maxItems: 4,
                description: "2–4 个有区分度的选项;不要自带「其他」(系统会自动提供自定义输入)",
                items: {
                  type: "object",
                  properties: {
                    label: { type: "string", description: "选项标签(1–5 词,简洁)" },
                    description: { type: "string", description: "这个选项的说明与权衡(可选)" }
                  },
                  required: ["label"],
                  additionalProperties: false
                }
              },
              multi_select: { type: "boolean", description: "是否可多选(默认 false)" }
            },
            required: ["question", "options"],
            additionalProperties: false
          }
        }
      },
      required: ["questions"],
      additionalProperties: false
    },
    annotations: { readOnlyHint: true, destructiveHint: false, requiresNetwork: false },
    run: function (args, ctx) { return askUserRun(args, ctx); }
  }
];

/* ---- 工具改名兼容层(唯一权威;命名规范与改名表见下) ----
   只有「已经发布过」的名字需要别名;内部函数名一律不改:
   runJsInSandbox / sandboxSource / SANDBOX_LIVE / killAllSandboxes 等保持原样 */
var TOOL_ALIAS = { run_js: "ExecuteJavaScript" };
function toolCanonName(n) { return TOOL_ALIAS[n] || n; }
/* 历史名定义:仅用于「下发给服务端」,不替换注册表里的对象(浅拷贝)。
   旧会话历史里写着 run_js,而注册表已经改叫 ExecuteJavaScript —— 直接下发现名会被服务端
   当成「未声明的工具调用」(旧会话在新版下重新 400),所以按历史名出一个等价定义 */
function aliasToolDef(histName) {
  var t = findTool(histName);
  if (!t || t.name === histName) return t;
  return { name: histName, modelDesc: t.modelDesc, inputSchema: t.inputSchema };
}
/* 工具描述的求值出口(下发给模型前的唯一读取点):modelDesc 允许是**函数** —— 需要运行期数据的
   描述(PythonPackages / ExecutePython 的档位口径与探索指引,见各自 modelDesc);字符串形式原样返回 */
function toolModelDesc(t) {
  if (!t) return "";
  return typeof t.modelDesc === "function" ? t.modelDesc() : t.modelDesc;
}
/* 历史「外部」工具的最小占位定义(有意偏离「查不到则跳过」:占位只补结构已知的名字形态,不虚构定义)。
   名字形态本身就是结构已知的(来自历次连接的 mcp__<server>__<tool>),但连接被重置 / 重新
   打开页面后 mcpState 已清空、注册表里查不到它 —— 照「查不到则跳过、不虚构定义」处理,
   历史里那条 tool_calls 就成了「未声明的工具调用」(Anthropic 更严格,直接 400)。
   故对这个形态补一个**最小**定义:只有名字 + 一句「当前未连接」的说明 + 宽松 schema,
   不声称任何行为与参数;它只负责让请求在协议上保持合法。
   其它解析不到的怪名仍按同一原则跳过 —— 不虚构定义。 */
var MCP_HIST_NAME_RE = /^mcp__[A-Za-z0-9_-]+__[A-Za-z0-9_-]+$/;
function mcpHistoryPlaceholder(name) {
  if (!MCP_HIST_NAME_RE.test(String(name || ""))) return null;
  return {
    name: name,
    modelDesc: "历史上用过的外部工具(当前未连接):这条调用来自此前连接过的 MCP 服务器," +
      "本次会话里它不可用;需要它请在 设置 → MCP 工具 里重新连接服务器。",
    inputSchema: { type: "object", properties: {}, additionalProperties: true }
  };
}
var AGENT_TOOL_MAP = {};
var AGENT_TOOL_MAP_LC = {};
/* 唯一的索引重建入口(替代原先的一次性 forEach):
   调用时机 = 初始化后;外部 MCP 的 tools/list 刷新后再调一次。
   · 小写兜底表:模型偶发把 Read 写成 read 时不至于「未知工具」(名字在大小写不敏感下唯一,无歧义)
   · 别名键:只进 map,【不】进 AGENT_TOOLS 数组 —— 面板计数与分组渲染用数组,别名不该被算成工具 */
function rebuildToolIndex() {
  AGENT_TOOL_MAP = {};
  AGENT_TOOL_MAP_LC = {};
  AGENT_TOOLS.forEach(function (t) {
    AGENT_TOOL_MAP[t.name] = t;
    AGENT_TOOL_MAP_LC[t.name.toLowerCase()] = t;
  });
  /* 外部工具(已 sanitize 的 mcp__<server>__<tool> 全名)追加注册:
     与内部工具重名时 console.warn 后忽略(前缀隔离下不应发生) */
  mcpTools().forEach(function (t) {
    if (AGENT_TOOL_MAP[t.name]) {
      if (typeof console !== "undefined") console.warn("[mcp] 工具名冲突,已忽略:" + t.name);
      return;
    }
    AGENT_TOOL_MAP[t.name] = t;
    AGENT_TOOL_MAP_LC[t.name.toLowerCase()] = t;
  });
  for (var a in TOOL_ALIAS) {
    if (!Object.prototype.hasOwnProperty.call(TOOL_ALIAS, a)) continue;
    var target = AGENT_TOOL_MAP[TOOL_ALIAS[a]];
    if (target) {
      AGENT_TOOL_MAP[a] = target;
      AGENT_TOOL_MAP_LC[a.toLowerCase()] = target;
    }
  }
}
rebuildToolIndex();

/* ---- 协议适配 ---- */
/* 工具查找的唯一入口(精确名 → 大小写兜底) */
function findTool(name) {
  return AGENT_TOOL_MAP[name] || AGENT_TOOL_MAP_LC[String(name || "").toLowerCase()] || null;
}
/* 从即将发送的 body 里采集历史出现过的工具名(唯一实现):
   · OpenAI 分支 body 已是 tool_calls[] 线格式,Anthropic 分支已是 normalizeAnthropic()
     产出的 content[] + tool_use 块 —— 两种形态都带 name,一处实现覆盖双协议
   · 额外取 role==="tool" 的 name:历史按条数截断后可能留下孤儿工具结果 */
function historyToolNames(body) {
  var names = [], seen = {};
  var msgs = (body && body.messages) || [];
  function add(n) { if (n && typeof n === "string" && !seen[n]) { seen[n] = 1; names.push(n); } }
  for (var i = 0; i < msgs.length; i++) {
    var m = msgs[i];
    if (m && m.tool_calls) {
      for (var j = 0; j < m.tool_calls.length; j++) {
        var f = m.tool_calls[j] && m.tool_calls[j].function;
        if (f) add(f.name);
      }
    }
    if (m && m.role === "tool") add(m.name);
    if (m && Object.prototype.toString.call(m.content) === "[object Array]") {
      for (var k = 0; k < m.content.length; k++) {
        var b = m.content[k];
        if (b && b.type === "tool_use") add(b.name);
      }
    }
  }
  return names;
}
/* 送模型的定义 = 当前启用的 ∪ 历史里出现过的
   (已关闭的历史工具也保留定义,否则历史里的工具调用会变成「未声明的工具调用」)
   可见性取**目标会话**的生效态(targetConv 缺省 = 当前会话):会话覆盖了外部工具体系
   或挂载了不同工作区时,下发的 tools[] 跟着那条会话走(与 buildBody 取 system / 工作区的
   会话口径一致 —— 生成期间切走后,续轮请求体不能混搭两套口径) */
function toolDefsForRequest(body, targetConv) {
  var seen = {}, defs = [];
  activeTools(targetConv).forEach(function (t) {
    if (seen[t.name]) return; seen[t.name] = 1;
    defs.push(t);
  });
  historyToolNames(body).forEach(function (n) {
    /* 历史名经别名/大小写兜底解析,并按历史名下发定义;
       解析不到时,对结构已知的 mcp__<server>__<tool> 补最小占位(见 mcpHistoryPlaceholder) */
    var t = aliasToolDef(n) || mcpHistoryPlaceholder(n);
    if (!t || seen[n]) return; seen[n] = 1;
    defs.push(t);
  });
  return defs;
}
function apiToolDefs(proto, body, targetConv) {
  return toolDefsForRequest(body, targetConv).map(function (t) {
    var d = toolModelDesc(t);   /* 描述在这里求值(可能是函数:见 toolModelDesc) */
    if (proto === "anthropic") {
      return { name: t.name, description: d, input_schema: t.inputSchema };
    }
    return { type: "function", function: { name: t.name, description: d, parameters: t.inputSchema } };
  });
}
function applyToolsToBody(body, proto, targetConv) {
  var defs = apiToolDefs(proto, body, targetConv);   /* 数据源 = body:history-union 在这里按实际发送内容取历史工具名 */
  if (!defs.length) return false;
  body.tools = defs;
  if (proto === "openai") body.tool_choice = "auto";
  return true;
}
/* 助手消息里记录的 toolCalls → 协议格式(送模型时用) */
function apiToolCalls(list) {
  return (list || []).map(function (c) {
    return {
      id: c.id || ("call_" + Math.random().toString(36).slice(2, 10)),
      type: "function",
      function: { name: c.name || "", arguments: c.argsText || "{}" }
    };
  });
}
function parseToolArgs(text) {
  var s = String(text == null ? "" : text).trim();
  if (!s) return {};
  try {
    var v = JSON.parse(s);
    return (v && typeof v === "object") ? v : { value: v };
  } catch (e) {
    return { __raw: s };
  }
}

/* ---- 工具卡片通用化(供 appC 的 renderToolCard 消费) ----
   三处原先都写死「只有 JS 沙箱一种工具」,文件工具一弹卡就会显示错误的「浏览器沙箱」文案、
   Python 代码也会被按 JavaScript 高亮。这里一律按 name 判定,不新增工具定义字段。
   历史记录里的旧名(run_js)同样能解析,不改历史数据 */
function toolDisplayName(n) {
  var t = findTool(n);
  return (t && t.source !== "external" && t.title) ? t.title : (n || "tool");
}
/* 大小写变体(如模型下发 executejavascript)也要套用同一套判定 —— 与 toolDisplayName 同口径:
   先经 findTool() 拿到注册表里的规范名,拿不到才回落到别名表 */
function toolCanonOf(name) {
  var t = findTool(name);
  return t ? t.name : toolCanonName(name);
}
function toolArgLang(name) {
  var canon = toolCanonOf(name);
  if (canon === "ExecutePython") return "python";
  if (canon === "ExecuteJavaScript") return "javascript";
  return "json";
}
function toolApprovalNote(name) {
  var canon = toolCanonOf(name);
  if (canon === "ExecuteJavaScript") {
    return "这段代码将在浏览器沙箱(独立线程,无页面数据、默认无网络)里执行,需要你放行。";
  }
  if (canon === "ExecutePython") {
    return "这段代码将在页面的 Python 解释器(独立线程,无页面数据)里执行,需要你放行。";
  }
  var t = findTool(name);
  if (t && t.needsWorkspace) {
    return "该操作将在你挂载的工作区(会话内的虚拟盘,不动你的电脑文件)里执行,需要你放行。";
  }
  /* 外部 MCP:放行前明确告知「这次调用会出到那台服务器」 */
  if (t && t.source === "external") {
    return "这次调用会发往外部 MCP 服务器「" + (t.server || "外部服务器") + "」(在你配置的地址上运行),需要你放行。";
  }
  return "需要你放行后才会执行这次工具调用。";
}

/* ---------------------------------------------------------------------------
   沙箱:Worker 源码。代码内嵌在 worker 脚本里执行,不经过 eval,
   网络与外围能力在运行用户代码之前就被替换成抛错的桩函数。
--------------------------------------------------------------------------- */
var SANDBOX_HEAD = [
  "'use strict';",
  "var __logs = [], __MAXLOG = 120, __logsDropped = 0, __LOG_ENTRY_MAX = 4096;",
  "function __str(v) {",
  "  if (typeof v === 'string') return v;",
  "  if (v === undefined) return 'undefined';",
  "  if (v === null) return 'null';",
  "  if (typeof v === 'function') return '[function ' + (v.name || 'anonymous') + ']';",
  "  if (v instanceof Error) return (v.name || 'Error') + ': ' + v.message;",
  "  try { return JSON.stringify(v); } catch (e) { return String(v); }",
  "}",
  "function __push(level, args) {",
  "  var parts = [], i, s;",
  "  for (i = 0; i < args.length; i++) parts.push(__str(args[i]));",
  "  s = (level === 'log' ? '' : '[' + level + '] ') + parts.join(' ');",
  "  /* 单条过长 → 留尾;条数超上限 → 丢最早并计数(留尾语义 + 计数,不再静默留头) */",
  "  if (s.length > __LOG_ENTRY_MAX) s = '…(+' + (s.length - __LOG_ENTRY_MAX) + ' 字符)' + s.slice(s.length - __LOG_ENTRY_MAX);",
  "  if (__logs.length >= __MAXLOG) { __logs.shift(); __logsDropped++; }",
  "  __logs.push(s);",
  "}",
  "function __bind() {",
  "  try {",
  "    console.log = function () { __push('log', arguments); };",
  "    console.info = console.log;",
  "    console.warn = function () { __push('warn', arguments); };",
  "    console.error = function () { __push('error', arguments); };",
  "  } catch (e) {}",
  "}",
  "__bind();",
  "function __block(name, msg) {",
  "  var boom = function () { throw new Error(msg); };",
  "  try { Object.defineProperty(self, name, { value: boom, writable: true, configurable: true }); }",
  "  catch (e) { try { self[name] = boom; } catch (e2) {} }",
  "}",
  "if (!__ALLOW_NET__) {",
  "  var __netMsg = '沙箱已禁用网络请求(fetch / XMLHttpRequest / WebSocket),本次调用被阻止,请改用离线方式完成该步骤。(开关位置:设置 → MCP 工具 → 允许联网)';",
  "  __block('fetch', __netMsg);",
  "  __block('XMLHttpRequest', __netMsg);",
  "  __block('WebSocket', __netMsg);",
  "  __block('EventSource', __netMsg);",
  "  __block('importScripts', __netMsg);",
  "  __block('indexedDB', __netMsg);",
  "  __block('BroadcastChannel', __netMsg);",
  "  __block('SharedWorker', __netMsg);",
  "  try { Object.defineProperty(navigator, 'sendBeacon', { value: function () { throw new Error(__netMsg); }, configurable: true }); } catch (e) {}",
  "}",
  "var __NAME = '__SANDBOX_ID__';",
  "var __t0 = Date.now();",
  "function __done(v) { postMessage({ __sb: __NAME, ok: true, result: __str(v), logs: __logs, logsDropped: __logsDropped, ms: Date.now() - __t0 }); }",
  "function __fail(e) {",
  "  var msg = (e && (e.name ? e.name + ': ' + e.message : e.message)) || String(e);",
  "  postMessage({ __sb: __NAME, ok: false, error: msg, logs: __logs, logsDropped: __logsDropped, ms: Date.now() - __t0 });",
  "}"
].join("\n");
var SANDBOX_TAIL = [
  "",
  "Promise.resolve()",
  "  .then(function () { return (async function () {",
  "__USER_CODE__",
  "  })(); })",
  "  .then(function (v) { __done(v); }, function (e) { __fail(e); });"
].join("\n");

/* 只用来给代码做语法体检:new Function 只编译不执行 */
function sandboxSyntaxError(code) {
  try {
    /* eslint-disable no-new-func */
    new Function("return (async function () {\n" + code + "\n})");
    return "";
  } catch (e) {
    return (e && e.message) ? e.message : "语法错误";
  }
}
function sandboxSource(id, code, allowNet) {
  var head = SANDBOX_HEAD.replace("__ALLOW_NET__", allowNet ? "true" : "false")
    .replace("__SANDBOX_ID__", id);
  return head + SANDBOX_TAIL.replace("__USER_CODE__", function () { return code; });
}
/* 运行代码:独立线程 + 硬超时 + 输出上限。返回 {ok, text, error, logs, logsDropped, ms} */
/* 正在运行的沙箱(停止生成 / 关闭页面时一并销毁,避免后台空转) */
var SANDBOX_LIVE = [];
function killAllSandboxes(reason) {
  var list = SANDBOX_LIVE.slice();
  SANDBOX_LIVE.length = 0;
  for (var i = 0; i < list.length; i++) {
    try { list[i].finish({ ok: false, error: reason || "已被用户中止", logs: [] }); } catch (e) {}
  }
}
function runJsInSandbox(code, opts) {
  opts = opts || {};
  var timeoutMs = Math.max(200, Number(opts.timeoutMs) || toolLimit("timeoutMs"));
  return new Promise(function (resolve) {
    var t0 = Date.now();
    var syn = sandboxSyntaxError(code);
    if (syn) {
      resolve({ ok: false, error: "代码存在语法错误:" + syn, logs: [], ms: 0 });
      return;
    }
    if (!CAP.worker) {
      resolve({ ok: false, error: "当前浏览器不支持 Web Worker,沙箱不可用(该功能已自动关闭)", logs: [], ms: 0 });
      return;
    }
    var id = "sb" + Date.now().toString(36) + Math.random().toString(36).slice(2, 8);
    var url = "";
    try {
      url = URL.createObjectURL(new Blob([sandboxSource(id, code, !!state.settings.toolNet)],
        { type: "text/javascript" }));
    } catch (e) {
      resolve({ ok: false, error: "无法创建沙箱:" + ((e && e.message) || e), logs: [], ms: 0 });
      return;
    }
    var w = null, done = false, timer = null;
    function finish(res) {
      if (done) return;
      done = true;
      if (timer) clearTimeout(timer);
      try { if (w) w.terminate(); } catch (e) {}
      try { URL.revokeObjectURL(url); } catch (e) {}
      var ix = SANDBOX_LIVE.indexOf(entry);
      if (ix > -1) SANDBOX_LIVE.splice(ix, 1);
      res.ms = Date.now() - t0;
      resolve(res);
    }
    var entry = { finish: finish };
    SANDBOX_LIVE.push(entry);
    try {
      w = new Worker(url);
    } catch (e) {
      finish({ ok: false, error: "无法启动沙箱线程:" + ((e && e.message) || e), logs: [] });
      return;
    }
    timer = setTimeout(function () {
      finish({ ok: false, error: "执行超时(超过 " + timeoutMs + " ms),沙箱已被强制销毁", logs: [], logsDropped: 0 });
    }, timeoutMs);
    w.onmessage = function (e) {
      var d = e && e.data;
      if (!d || d.__sb !== id) return;   // 只认本次运行的沙箱消息
      finish({ ok: !!d.ok, text: d.ok ? String(d.result == null ? "" : d.result) : "",
        error: d.ok ? "" : String(d.error || "执行失败"), logs: Array.isArray(d.logs) ? d.logs : [],
        logsDropped: Number(d.logsDropped) || 0 });
    };
    w.onerror = function (e) {
      finish({ ok: false, error: "沙箱执行失败:" + ((e && e.message) || "未知错误"), logs: [], logsDropped: 0 });
    };
  });
}

/* ---- 结果整理 ---- */
/* 统一裁剪器:留尾 + 段首注记。cap **计入注记** ⇒ 返回文本长度严格 ≤ cap。
   为什么留尾:输出/返回值/错误的关键信息在末尾(开头多是被刷掉的过程)。
   短而关键的行(档位提示/工作区回写/并发冲突/装载摘要)不进这里 —— 它们是"注记区",不参与裁剪。 */
function clipTailNote(text, cap, label) {
  var t = String(text == null ? "" : text);
  cap = Math.max(0, Math.floor(Number(cap) || 0));
  if (t.length <= cap) return { text: t, cut: false };
  var n = t.length - cap, note = "", keep = 0, i;
  /* 注记自身占位 ⇒ "已截断 N 字符"里的 N 要迭代两次才收敛(差值只在注记长度上) */
  for (i = 0; i < 2; i++) {
    note = "…(" + String(label || "内容") + " 已截断 " + n + " 字符,只保留末尾)\n";
    keep = Math.max(0, cap - note.length);
    n = t.length - keep;
  }
  note = "…(" + String(label || "内容") + " 已截断 " + n + " 字符,只保留末尾)\n";
  keep = Math.max(0, cap - note.length);
  return { text: note + t.slice(t.length - keep), cut: true };
}
/* JS 沙箱 console 的留尾视图(主线程侧唯一的"丢条说明"来源,不重复报):
   入参 logs = 沙箱回传数组(可能头部带一条沙箱自己的丢弃说明),dropped = 沙箱环形丢弃条数,
   keep = 本次保留窗口(成功 60 / 失败 20)。说明只在真的丢了时报一条。 */
function jsConsoleTail(logs, dropped, keep) {
  var arr = [], i, head = "";
  if (Array.isArray(logs)) for (i = 0; i < logs.length; i++) arr.push(String(logs[i]));
  if (arr.length && /已丢弃最早的/.test(arr[0])) head = arr.shift();
  var total = arr.length + (Number(dropped) || 0);
  var shown = (keep > 0 && arr.length > keep) ? arr.slice(arr.length - keep) : arr;
  var omitted = total - shown.length, note = "";
  if (omitted > 0) note = "…(console 只保留最后 " + shown.length + " 条;省略更早的 " + omitted + " 条)";
  else if (head) note = head;
  if (note) shown.unshift(note);
  return shown;
}
function toolResultText(res, toolName) {
  var max = toolLimit("maxOut");
  var o = { tool: toolName, ok: !!res.ok };
  if (res.taskId) {
    o.task_id = res.taskId;
    if (res.status) o.status = res.status;
    if (res.exitCode != null) o.exitCode = res.exitCode;
  }
  /* 非执行器族(Read / Grep / Glob / Write / Edit / FileOps / PythonPackages / 外部 MCP…):
     逐字节保持"留头 + 尾注"的既有行为 —— 它们是分页/结构化检查类工具,整体翻转会把
     状态行(Grep 摘要在顶、Read 状态行在尾、Glob next_offset 在后)打乱。 */
  if (!RESULT_TAIL_TOOLS[toolName]) {
    if (res.ok) {
      if (res.text !== "" && res.text != null) o.result = res.text;
      if (res.logs && res.logs.length) o.console = res.logs.slice(0, 60);
    } else {
      o.error = res.error || "执行失败";
      if (res.logs && res.logs.length) o.console = res.logs.slice(0, 20);
    }
    var s0;
    try { s0 = JSON.stringify(o, null, 1); } catch (e) { s0 = String(o); }
    if (s0.length > max) s0 = s0.slice(0, max) + "\n…(结果超长已截断,原始长度 " + s0.length + " 字符)";
    return s0;
  }
  /* 执行器族:留尾;注记(res.notes)不裁剪且序列化在最末 ⇒ 必然存活 */
  if (res.ok) {
    if (res.text !== "" && res.text != null) o.result = res.text;
    if (res.logs && res.logs.length) o.console = jsConsoleTail(res.logs, res.logsDropped, 60);
  } else {
    o.error = res.error || "执行失败";
    if (res.logs && res.logs.length) o.console = jsConsoleTail(res.logs, res.logsDropped, 20);
  }
  if (res.notes && res.notes.length) {
    o.notes = [];
    for (var i = 0; i < res.notes.length; i++) o.notes.push(String(res.notes[i]));
  }
  var s;
  try { s = JSON.stringify(o, null, 1); } catch (e) { s = String(o); }
  if (s.length > max) {
    /* 正文是按同一 max 装配的,走到这里说明是估算误差:先把可裁字段压一次,再整体留尾 */
    var over = s.length - max, c;
    if (o.result && over > 0) { c = clipTailNote(o.result, Math.max(0, o.result.length - over), "返回"); o.result = c.text; }
    if (o.error && over > 0) { c = clipTailNote(o.error, Math.max(0, o.error.length - over), "错误"); o.error = c.text; }
    try { s = JSON.stringify(o, null, 1); } catch (e2) { s = String(o); }
    if (s.length > max) s = clipTailNote(s, max, "工具结果").text;
  }
  return s;
}

/* ---- 用户放行 ---- */
function askToolApproval(msgId) {
  return new Promise(function (resolve) { TOOL_WAITS[msgId] = resolve; });
}
function resolveToolApproval(msgId, act) {
  var r = TOOL_WAITS[msgId];
  if (!r) return;
  delete TOOL_WAITS[msgId];
  r(act);
}
function denyAllToolWaits() {
  var keys = [];
  for (var k in TOOL_WAITS) if (Object.prototype.hasOwnProperty.call(TOOL_WAITS, k)) keys.push(k);
  for (var i = 0; i < keys.length; i++) {
    var r = TOOL_WAITS[keys[i]];
    delete TOOL_WAITS[keys[i]];
    try { r("deny"); } catch (e) {}
  }
}

/* ---- AskUser:向用户提问(卡片里的逐题表单,提交后把全部回答还给模型) ----
   与「用户放行」同层的第二类等待:ASK_WAITS 按 msgId 存 resolver,卡片上的按钮触发结算。
   一次工具轮里只可能有一张待答卡(调用侧顺序 await toolRun,见 appD 的 for…await);
   结果契约与 Kimi 一致:{answers:{<问题原文>:<选项标签 / 用户自述>}};跳过 = 空 answers + note。
   防滥用上限:每轮调用次数受 toolLimits.maxCalls 约束(toolRun 统一计数,不另设专属上限)、
   同会话同时只有一张待答卡、用户随时可「跳过」、Ctrl+Alt+Esc/停止经 ctx.signal 结算为 aborted、
   刷新/关页后由 askUserSweepStale() 把没人等的残卡收敛掉。 */
var ASK_WAITS = {};          /* msgId → resolve(out);空表 = 页面上没有任何人在等答案 */
var ASK_DRAFT = {};          /* msgId → {sel:{i:idx|[idx]}, text:{i:string}, other:{i:bool}}(纯内存,结算即清) */
var ASK_MAX_Q = 4, ASK_MAX_OPT = 4, ASK_MIN_OPT = 2;
var ASK_HEADER_MAX = 12;     /* 题头小标签的长度上限(Kimi 同口径) */
var ASK_TEXT_MAX = 2000;     /* 单题自定义回答的长度上限 */
var ASK_SKIP_NOTE = "用户跳过了这次提问,没有作答。不要把跳过当作选择了推荐项;如果确实需要这个信息,请在正文里直接说明并继续。";

function askUserCard(m) {
  return !!(m && m.role === "tool" && toolCanonOf(m.toolName) === "AskUser");
}
function askUserPending(m) {
  /* 审批卡也是 status="wait",但它等的是「放行」不是「作答」⇒ 必须排除(渲染分支共用这一条判据) */
  return askUserCard(m) && m.status === "wait" && !m.needsApproval;
}
/* 参数校验与归一化(问题文本唯一、题内选项标签唯一、长度截断) */
function askUserNormalize(args) {
  var qs = args && args.questions;
  if (!qs || typeof qs.length !== "number" || !qs.length) return { ok: false, error: "缺少 questions(需要 1–4 个问题)" };
  if (qs.length > ASK_MAX_Q) return { ok: false, error: "一次最多 " + ASK_MAX_Q + " 个问题(收到 " + qs.length + " 个)" };
  var out = [], seenQ = {}, i, j, q, text, opts, optsOut, seenO, o, lb;
  for (i = 0; i < qs.length; i++) {
    q = qs[i] || {};
    text = String(q.question == null ? "" : q.question).trim();
    if (!text) return { ok: false, error: "第 " + (i + 1) + " 个问题缺少 question 文本" };
    if (Object.prototype.hasOwnProperty.call(seenQ, text)) {
      return { ok: false, error: "问题文本必须唯一:「" + safeJson(text, 40) + "」出现了两次" };
    }
    seenQ[text] = true;
    opts = q.options;
    if (!opts || typeof opts.length !== "number" || opts.length < ASK_MIN_OPT || opts.length > ASK_MAX_OPT) {
      return { ok: false, error: "第 " + (i + 1) + " 个问题需要 " + ASK_MIN_OPT + "–" + ASK_MAX_OPT +
        " 个选项(收到 " + ((opts && opts.length) || 0) + " 个)" };
    }
    optsOut = []; seenO = {};
    for (j = 0; j < opts.length; j++) {
      o = opts[j] || {};
      lb = String(o.label == null ? "" : o.label).trim();
      if (!lb) return { ok: false, error: "第 " + (i + 1) + " 个问题的第 " + (j + 1) + " 个选项缺少 label" };
      if (Object.prototype.hasOwnProperty.call(seenO, lb)) {
        return { ok: false, error: "第 " + (i + 1) + " 个问题里选项标签重复:「" + safeJson(lb, 30) + "」" };
      }
      seenO[lb] = true;
      optsOut.push({ label: lb, description: String(o.description == null ? "" : o.description).trim() });
    }
    out.push({
      question: text,
      header: String(q.header == null ? "" : q.header).trim().slice(0, ASK_HEADER_MAX),
      options: optsOut,
      multi: !!q.multi_select
    });
  }
  return { ok: true, qs: out };
}
/* 卡片上的题面:优先用本次调用存下的归一化结果;刷新后 askQs 会丢 ⇒ 从 args 重算(重算不落盘任何东西) */
function askUserQsOf(m) {
  if (m && m.askQs && m.askQs.length) return m.askQs;
  var n = askUserNormalize((m && m.args) || {});
  return n.ok ? n.qs : [];
}
function askUserDraftOf(msgId) {
  var d = ASK_DRAFT[msgId];
  if (!d) { d = { sel: {}, text: {}, other: {}, cur: 0 }; ASK_DRAFT[msgId] = d; }
  return d;
}
/* 单题答案:自定义回答优先 —— 单选时覆盖所选项,多选时与所选项并列(逗号分隔) */
function askUserAnswerOf(q, d, i) {
  if (!q) return "";
  var sel = (d && d.sel) ? d.sel[i] : null;
  var txt = String((d && d.text) ? (d.text[i] || "") : "").trim();
  if (!q.multi) return txt || ((typeof sel === "number" && q.options[sel]) ? q.options[sel].label : "");
  var arr = (sel && typeof sel === "object") ? sel : [];
  var lbs = [], k;
  for (k = 0; k < arr.length; k++) if (q.options[arr[k]]) lbs.push(q.options[arr[k]].label);
  if (txt) lbs.push(txt);
  return lbs.join(", ");
}
/* 逐题答案的纯文本形态(卡片回显的 title,便于鼠标悬停看全文) */
function askUserAnswersText(m) {
  var list = (m && m.askAnswers) || [];
  if (!list.length) return "";
  return list.map(function (a) { return a.q + " → " + (a.answer || "未作答"); }).join("\n");
}
/* 结算的唯一收口(幂等):submit / skip / abort 三条出口都从这里走 */
function askUserResolve(msgId, act) {
  var r = ASK_WAITS[msgId];
  if (!r) return;                                  /* 已结算 / 无人等待(刷新后的残卡) */
  var m = findMsg(msgId);
  var d = ASK_DRAFT[msgId] || { sel: {}, text: {}, other: {} };
  if (act === "submit") {
    var qs = askUserQsOf(m), answers = {}, list = [], i, a;
    for (i = 0; i < qs.length; i++) {
      a = askUserAnswerOf(qs[i], d, i);
      if (!a) return;                              /* 未作答不结算(调用方已先给出提示) */
      answers[qs[i].question] = a;
      list.push({ q: qs[i].question, answer: a });
    }
    /* 结算即收起详情:头部状态行与「已回答」摘要已足够回执,表单/回显不再默认占屏
       (toolOpen=false 随消息落盘 ⇒ 历史重绘与刷新后的默认态同样是收起) */
    if (m) { m.askAnswers = list; m.toolOpen = false; }
    r({ ok: true, text: JSON.stringify({ answers: answers }) });
    return;
  }
  if (act === "skip") {
    if (m) { m.askAnswers = []; m.toolOpen = false; }
    r({ ok: true, text: JSON.stringify({ answers: {}, note: ASK_SKIP_NOTE }) });
    return;
  }
  if (m) m.toolOpen = true;
  r({ ok: false, aborted: true, error: "用户中止了这次生成,这次提问没有回答" });
}
function askUserRun(args, ctx) {
  var n = askUserNormalize(args);
  var msg = ctx && ctx.msg;
  if (!n.ok) {
    return Promise.resolve({ ok: false, error: "提问格式不合法:" + n.error + "。请改写后重新调用。" });
  }
  if (!msg) return Promise.resolve({ ok: false, error: "提问失败:没有可用的消息上下文" });
  var msgId = msg.id;
  ASK_DRAFT[msgId] = { sel: {}, text: {}, other: {}, cur: 0 };   /* cur = 多题轮播的当前题号 */
  msg.askQs = n.qs;                 /* 卡片题面;结算时清掉(临时字段) */
  msg.askAnswers = null;            /* 重跑同一张卡片时不留上一次的回显 */
  msg.toolOpen = true;              /* 待答卡片必须展开 */
  msg.status = "wait";              /* 此路径下 needsApproval 必为 false(toolRun 放行后已清) */
  redrawToolCard(msg);
  /* 卡片刚加上逐题表单(变高):立刻粘底,否则整张卡可能落在可视区之下,用户要手动滚才看得到问题。
     走既有 scrollToBottom(非 force)——它尊重聊天区的粘底语义,用户手动上滚时不抢 */
  if (ctxConv(ctx) === conv) scrollToBottom();
  /* 提问发生在别的会话里(用户切走了):一次性提示,别让它在后台静默等 */
  if (ctxConv(ctx) !== conv) toast("另一条会话在等你回答一个问题", "info", 4200);
  return new Promise(function (resolve) {
    var settled = false, onAbort = null;
    function finish(out) {
      if (settled) return;
      settled = true;
      delete ASK_WAITS[msgId];
      delete ASK_DRAFT[msgId];
      if (onAbort && ctx && ctx.signal && ctx.signal.removeEventListener) {
        try { ctx.signal.removeEventListener("abort", onAbort); } catch (e) {}
      }
      msg.askQs = null;
      resolve(out);
    }
    ASK_WAITS[msgId] = finish;
    var sig = ctx && ctx.signal;
    if (sig && sig.aborted) { finish(askUserAbortOut()); return; }
    if (sig && sig.addEventListener) {
      onAbort = function () { finish(askUserAbortOut()); };
      try { sig.addEventListener("abort", onAbort); } catch (e) {}
    }
  });
}
function askUserAbortOut() {
  return { ok: false, aborted: true, error: "用户中止了本次生成,这次提问没有回答" };
}
/* 刷新/关页后残留的「等待中」卡片没人等了 ⇒ 启动装载完成后收敛一次(只在启动链末端调用;
   禁止挂 updateCtxMeter / wsRailSync 这类热路径 —— 每次 input 都扫全量消息是无谓开销) */
var ASK_SWEEP_TRIES = 0;
function askUserSweepStale() {
  var changed = 0, i, j, m, el;
  for (i = 0; i < state.conversations.length; i++) {
    var ms = (state.conversations[i] && state.conversations[i].messages) || [];
    for (j = 0; j < ms.length; j++) {
      m = ms[j];
      if (!m || m.role !== "tool" || m.status !== "wait") continue;
      if (!m.needsApproval && !askUserCard(m)) continue;
      if (m.needsApproval) { m.needsApproval = false; m.content = "页面已刷新,这次工具调用没有执行"; }
      else { m.askQs = null; m.content = "页面已刷新,这次提问没有提交"; }
      m.status = "aborted";
      /* 卡片在当前会话里才需要就地重绘(不在 DOM 里的会话切过去时自然按新状态渲染) */
      el = document.querySelector('#chat-inner .tool-card[data-id="' + cssEscape(m.id) + '"]');
      if (el) redrawToolCard(m);
      changed++;
    }
  }
  if (changed) saveSoon();
  /* 自检重做:启动后的**第一笔落盘**会做一次"写前加固"(从 IDB 重读并整表替换
     state.conversations),这次替换会把上面刚改的内存改动一起丢掉 —— 只收敛一次的话,
     卡片会停在"DOM 已中止、消息仍 wait"的半截状态。
     所以只在本轮真有改动时补一轮自检(条件驱动 + 上限 3 轮,不是常驻轮询,也不挂热路径);
     重做成功后再跑一轮必然 changed=0 → 计数归零,自动停下 */
  if (changed && ASK_SWEEP_TRIES < 3) {
    ASK_SWEEP_TRIES++;
    setTimeout(askUserSweepStale, 1200);
  } else if (!changed) {
    ASK_SWEEP_TRIES = 0;
  }
  return changed;
}
/* 卡片交互:选项 / 自定义回答 / 提交 / 跳过 —— 只改 ASK_DRAFT 与局部 DOM(不整卡重绘,避免光标丢失) */
function askUserCardOf(node) { return (node && node.closest) ? node.closest(".tool-card") : null; }
function askUserSyncQ(card, m, i, d, focus) {
  var qs = askUserQsOf(m), q = qs[i];
  var box = card ? card.querySelector('.ask-q[data-ask-q="' + i + '"]') : null;
  if (box && q) {
    var opts = box.querySelectorAll(".ask-opt"), sel = d.sel[i], k;
    for (k = 0; k < opts.length; k++) {
      var key = String(opts[k].getAttribute("data-ask-opt") || "").split(":")[1];
      var on;
      if (key === "other") on = !!d.other[i] || !!String(d.text[i] || "").trim();
      else if (q.multi) on = !!(sel && typeof sel === "object" && sel.indexOf(Number(key)) > -1);
      else on = sel === Number(key);
      opts[k].classList.toggle("on", on);
    }
    var ta = box.querySelector(".ask-ta");
    if (ta) {
      var show = !!d.other[i] || !!String(d.text[i] || "").trim();
      if (ta.hidden === show) {
        ta.hidden = !show;
        if (show && focus) { try { ta.focus(); } catch (e) {} }
      }
    }
  }
  askUserHintInto(card, m);
}
function askUserHintInto(card, m) {
  var hint = card ? card.querySelector(".ask-hint") : null;
  if (!hint) return;
  var qs = askUserQsOf(m), d = askUserDraftOf(m.id), miss = [], i;
  for (i = 0; i < qs.length; i++) if (!askUserAnswerOf(qs[i], d, i)) miss.push(i + 1);
  hint.textContent = miss.length ? ("还有 " + miss.length + " 题未作答:第 " + miss.join("、") + " 题") : "";
}
/* 轮播切到指定题(「←/→」与「单选自动前进」共用;只动 d.cur 与题面 DOM,
   草稿(选中 + 自定义输入)不碰 ⇒ 切回来原样保留) */
function askUserGoto(card, m, nxt) {
  var qs = askUserQsOf(m), n = qs.length, d = askUserDraftOf(m.id);
  if (nxt < 0 || nxt >= n) return false;          /* 端点:按钮已禁用,这里再兜一道 */
  d.cur = nxt;
  var wrap = card ? card.querySelector(".ask-qwrap") : null;
  if (wrap) askUserFillQ(wrap, m, qs, d);
  askUserHintInto(card, m);
  return true;
}
function askUserClickOpt(btn) {
  var card = askUserCardOf(btn);
  if (!card) return;
  var id = card.getAttribute("data-id");
  var m = findMsg(id);
  if (!m || !askUserPending(m)) return;
  var parts = String(btn.getAttribute("data-ask-opt") || "").split(":");
  var i = Number(parts[0]), key = parts[1];
  var qs = askUserQsOf(m), q = qs[i];
  if (!q) return;
  var d = askUserDraftOf(id);
  var picked = false;
  if (key === "other") {
    d.other[i] = !d.other[i];                     /* 「其他」要等自定义输入,不自动前进 */
  } else {
    var j = Number(key);
    if (q.multi) {
      var arr = (d.sel[i] && typeof d.sel[i] === "object") ? d.sel[i] : [];
      var k = arr.indexOf(j);
      if (k > -1) arr.splice(k, 1);
      else { arr.push(j); arr.sort(function (a, b) { return a - b; }); }
      d.sel[i] = arr;                             /* 多选不自动前进(还要继续勾) */
    } else {
      d.sel[i] = (d.sel[i] === j) ? null : j;     /* 再点一次 = 取消这道题的作答 */
      picked = d.sel[i] === j;                    /* 只有"这次点成了选中"才前进 */
    }
  }
  askUserSyncQ(card, m, i, d, key === "other" && !!d.other[i]);
  /* 多题轮播 + 单选题(非最后一题):点选即自动跳下一题,省掉一次「→」点击。
     不自动前进的四种情形:多选(还要继续勾)、最后一题(无处可跳)、
     「其他」(要等自定义输入)、「再点一次取消」(答案被清空,留在原题) */
  if (picked && i < qs.length - 1) askUserGoto(card, m, i + 1);
  /* 单题 + 单选:点选项即**自动提交**(用户 2026-09-15 追加)。走与「提交回答」完全相同的
     提交路径与守卫(askUserAct("submit") → 未作答检查 → askUserResolve),不另写一条结算链;
     多选 / 多题 / 「其他」自定义输入的行为不变;再点一次取消选中时不提交(picked=false) */
  if (picked && qs.length === 1 && !q.multi) askUserAct(id, "submit");
}
function askUserTextInput(ta) {
  var card = askUserCardOf(ta);
  if (!card) return;
  var id = card.getAttribute("data-id");
  var m = findMsg(id);
  if (!m || !askUserPending(m)) return;
  var i = Number(ta.getAttribute("data-ask-ta"));
  var d = askUserDraftOf(id);
  var v = String(ta.value == null ? "" : ta.value);
  if (v.length > ASK_TEXT_MAX) { v = v.slice(0, ASK_TEXT_MAX); ta.value = v; }
  d.text[i] = v;
  askUserSyncQ(card, m, i, d);
}
function askUserAct(id, act) {
  var m = findMsg(id);
  if (!m || !askUserPending(m)) return;
  var qs = askUserQsOf(m), d = askUserDraftOf(id), i;
  /* 多题轮播:←/→ 只换当前题(草稿都在 ASK_DRAFT,切回来已答状态与自定义输入原样) */
  if (act === "prev" || act === "next") {
    var n = qs.length;
    if (n < 2) return;
    var cur = askUserCurOf(d, n);
    askUserGoto(document.querySelector('#chat-inner .tool-card[data-id="' + cssEscape(id) + '"]'),
      m, act === "prev" ? cur - 1 : cur + 1);
    return;
  }
  if (act === "submit") {
    var miss = [];
    for (i = 0; i < qs.length; i++) if (!askUserAnswerOf(qs[i], d, i)) miss.push(i + 1);
    if (miss.length) {
      var card = document.querySelector('#chat-inner .tool-card[data-id="' + cssEscape(id) + '"]');
      if (card) {
        askUserHintInto(card, m);
        var hint = card.querySelector(".ask-hint");
        if (hint) hint.textContent = "请先回答全部问题:还有第 " + miss.join("、") + " 题没有作答";
      }
      toast("还有 " + miss.length + " 题没有作答(可以点「跳过」)", "warn", 3000);
      return;
    }
  }
  askUserResolve(id, act);
}

function toolLogPush(kind, text) {
  TOOL_LOG.push({ t: Date.now(), kind: kind, text: text });
  /* 只保留最近 100 条,超出丢掉最早的 */
  if (TOOL_LOG.length > TOOL_LOG_MAX) TOOL_LOG.splice(0, TOOL_LOG.length - TOOL_LOG_MAX);
  renderToolLog();
}
function renderToolLog() {
  var box = $("mcp-log");
  if (!box) return;
  box.innerHTML = TOOL_LOG.length
    ? TOOL_LOG.map(function (l) {
      return '<div class="cl-' + l.kind + '">[' + fmtTime(l.t) + "] " + escapeHtml(l.text) + "</div>";
    }).join("")
    : '<div class="cl-dim">暂无调用记录。</div>';
  box.scrollTop = box.scrollHeight;
}

/* 拒绝文案:原因 → 修改去处,四条路径各自指向正确的开关位置(唯一一份措辞)。
   旧文案四种情况共用一句"(设置 → MCP 工具)"—— 会话覆盖为关时那条路径根本不在那里
   (在输入区的「调节」浮层),用户会找不到地方改,所以拆开写。
   targetConv 缺省 = 当前会话;执行侧传发起调用的会话(见 toolRun/ctxConv) */
function toolDenyText(t, targetConv) {
  var c = (typeof targetConv === "undefined") ? conv : targetConv;
  if (toolPermOf(t.name) === "deny") {
    return "工具 " + t.name + " 的权限为「禁止」,本次调用未执行,请改用其它方式回答。(开关位置:设置 → MCP 工具 → 工具与权限)";
  }
  if (t.source === "external") {
    if (extToolsOverride(c) === false) {
      return "本会话把外部 MCP 工具覆盖为「关」,工具 " + t.name + " 不生效,请改用其它方式回答。" +
        "(开关位置:输入框上方「调节」浮层的「工具 → 本会话覆盖」)";
    }
    return "外部 MCP 工具总开关为关,工具 " + t.name + " 不生效,请改用其它方式回答。" +
      "(开关位置:设置 → MCP 工具 → 外部 MCP 服务器;也可在「调节」浮层的「本会话覆盖」里只为本会话打开)";
  }
  return "模型工具调用总开关为关,工具 " + t.name + " 不生效,请改用其它方式回答。" +
    "(开关位置:设置 → MCP 工具;输入框上方「调节」浮层的「工具 → 内部工具」同为其入口)";
}

/* ---------------------------------------------------------------------------
   执行一次工具调用(由 sendMessage 的循环驱动)
   tmsg:会话里的工具消息,状态会被就地更新,界面据此渲染卡片
   targetConv:发起这次工具调用的会话(缺省 = 当前会话)。执行门(权限 / 总开关 / 外部工具
     生效态 / 工作区归属 / Python 任务归属)一律按它判 —— A 发起的调用,即使用户已切到 B,
     也按 A 的权限与挂载执行或拒绝,拒绝文案指向的也是 A 的上下文(与组装侧 targetConv 同口径)
--------------------------------------------------------------------------- */
/* 工具**执行侧**的会话归属:ctx.conv 由 toolRun 注入(见下),缺省 = 模块级 conv
   (既有"直接调用某工具实现"的路径不变) */
function ctxConv(ctx) {
  var c = ctx && ctx.conv;
  return c ? c : conv;
}
async function toolRun(call, tmsg, targetConv) {
  var name = (call && call.function && call.function.name) || (call && call.name) || "";
  var argsText = (call && call.function && call.function.arguments) || (call && call.argsText) || "{}";
  var tool = findTool(name);
  var t0 = Date.now();
  var tc = targetConv || conv;      /* 执行侧会话:缺省 = 当前会话(既有行为) */
  tmsg.status = "running";
  tmsg.needsApproval = false;
  if (!tool) {
    tmsg.status = "error";
    tmsg.content = "未知工具:" + name + "(可用的工具:" +
      (activeTools(tc).map(function (t) { return t.name; }).join(", ") || "当前没有可用的工具") + ")";
    tmsg.ms = Date.now() - t0;
    toolLogPush("err", "未知工具 " + name);
    return tmsg;
  }
  if (!toolSupported(tool)) {
    tmsg.status = "error";
    tmsg.content = "当前浏览器不支持该工具所需的运行环境,已拒绝执行";
    toolLogPush("err", tool.name + " 运行环境不可用");
    return tmsg;
  }
  if (TOOL_TURN.used >= toolLimit("maxCalls")) {
    tmsg.status = "error";
    tmsg.content = "已达到本轮工具调用次数上限(" + toolLimit("maxCalls") + " 次),请直接根据现有信息作答";
    toolLogPush("err", "超出调用次数上限,已拒绝 " + tool.name);
    return tmsg;
  }
  TOOL_TURN.used++;
  var perm = toolPermOf(tool.name);
  /* history-union 后,总开关关闭时请求里仍会带历史工具定义:模型若再调用,一律按「禁用」拒绝。
     外部工具走自己的生效态(只开外部 MCP、关内部工具时外部工具必须能执行;
     会话级覆盖优先于全局总开关 —— 覆盖为关时即使全局开着也不执行) */
  var gateOn = (tool.source === "external") ? extToolsOn(tc)
                                            : !!state.settings.toolsEnabled;
  if (perm === "deny" || !gateOn) {
    tmsg.status = "denied";
    tmsg.content = toolDenyText(tool, tc);
    toolLogPush("err", "已按权限拒绝 " + tool.name);
    return tmsg;
  }
  if (perm === "ask") {
    tmsg.status = "wait";
    tmsg.needsApproval = true;
    redrawToolCard(tmsg);
    toolLogPush("in", "等待用户放行:" + tool.name + "(" + safeJson(JSON.stringify(tmsg.args || {}), 220) + ")");
    var act = await askToolApproval(tmsg.id);
    tmsg.needsApproval = false;
    if (abortCtrl && abortCtrl.signal && abortCtrl.signal.aborted) act = "deny";
    if (act !== "once" && act !== "always") {
      tmsg.status = "denied";
      tmsg.content = "用户拒绝了这次工具调用,请不要重试,直接说明无法执行并给出你能给出的答案";
      tmsg.ms = Date.now() - t0;
      toolLogPush("err", "用户拒绝 " + tool.name);
      redrawToolCard(tmsg);
      return tmsg;
    }
    if (act === "always") {
      setToolPerm(tool.name, "allow");
      toast("已允许 " + tool.name + " 自动执行(可在 设置 → MCP 工具 改回)", "info", 3000);
      if (window.__mcpRefresh) window.__mcpRefresh();
    }
  }
  tmsg.status = "running";
  redrawToolCard(tmsg);
  var out;
  try {
    /* 统一签名 ctx = { msg, signal },另加可选 conv = 发起这次调用的会话
       (执行侧会话归属的唯一来源,见 ctxConv;缺省 = 当前会话)。signal 是生成中请求的
       abortCtrl.signal;非生成路径给永不 abort 的占位信号 */
    out = await tool.run(tmsg.args || {}, {
      msg: tmsg,
      signal: (abortCtrl && abortCtrl.signal) || NO_ABORT_SIGNAL,
      conv: tc
    });
  } catch (e) {
    out = { ok: false, error: (e && (e.message || e)) || "执行异常", logs: [], ms: Date.now() - t0 };
  }
  if (!out || typeof out !== "object") out = { ok: false, error: "工具没有返回结果", logs: [] };
  tmsg.ms = Date.now() - t0;
  tmsg.logs = out.logs || [];
  /* 被中止(AbortSignal)与「执行失败」要分开显示:外部 MCP 调用可以被 Ctrl+Alt+Esc 中断 */
  tmsg.status = out.ok ? "ok" : (out.aborted ? "aborted" : "error");
  tmsg.content = toolResultText(out, tool.name);
  /* 工具读取的图片等内联媒体:挂在消息上(m.media),不进 resultText(不复制字节) */
  if (out.ok && out.media && out.media.length) tmsg.media = out.media.slice();
  else if (!out.ok) delete tmsg.media;
  /* resultText 会随消息落盘,必须封顶:外部 MCP 服务器可能返回任意大的正文,
     而 content 只经 toolResultText 的 maxOut 截断 —— 两条路径都要有上限,否则会撑爆会话记录 */
  var rt = out.ok ? String(out.text == null ? "" : out.text) : String(out.error || "");
  if (out.ok && out.media && out.media.length) rt += "\n(已附带 " + out.media.length + " 张图片)";
  var rtCap = toolLimit("maxOut") * 2;
  /* 落盘副本与展示同向:执行器族留尾,其余工具保持"留头 + 尾注"(逐字节不变) */
  tmsg.resultText = rt.length > rtCap
    ? (RESULT_TAIL_TOOLS[tool.name]
      ? clipTailNote(rt, rtCap, "工具结果").text
      : (rt.slice(0, rtCap) + "…(已截断,原始 " + rt.length + " 字符)"))
    : rt;
  redrawToolCard(tmsg);
  toolLogPush(out.ok ? "ok" : "err",
    tool.name + (out.ok ? " 返回:" : " 失败:") + safeJson(tmsg.resultText || tmsg.content, 400));
  updateMcpStatus();
  return tmsg;
}

/* ---------------------------------------------------------------------------
   设置面板
--------------------------------------------------------------------------- */
function permBtn(name, val, label, cur) {
  return '<button type="button" data-perm="' + val + '" data-tool="' + escAttr(name) + '"' +
    (cur === val ? ' class="on"' : "") + ">" + label + "</button>";
}
function toolLimitFmt(key, v) {
  v = Number(v);
  if (key === "timeoutMs") {
    var min = v / 60000;
    return (min >= 10 || min % 1 === 0 ? min.toFixed(0) : min.toFixed(1)) + " 分钟";
  }
  if (key === "maxCalls") return v + " 次";
  return fmtCtxNum(v) + " 字符";
}
var TOOL_LIMIT_INPUTS = [
  ["set-tool-timeout", "timeoutMs"], ["set-tool-calls", "maxCalls"], ["set-tool-out", "maxOut"]
];
function syncToolLimitInputs() {
  TOOL_LIMIT_INPUTS.forEach(function (b) {
    var el = $(b[0]), out = $(b[0] + "-v");
    if (!el) return;
    var v = toolLimit(b[1]);
    el.value = v;
    if (out) out.textContent = toolLimitFmt(b[1], v);
  });
}
function renderMcpPanel() {
  var st = $("mcp-state");
  if (!st) return;
  var on = !!state.settings.toolsEnabled;
  st.className = "mcp-state" + (on ? " on" : "");
  $("mcp-enabled").checked = on;
  /* 「当前浏览器可用」= 本机能力齐备。工作区三区缺失时那 6 个文件工具在本机用不了
     (挂载也救不回来),不能算进这个数,否则与「已启用」互相矛盾 */
  var usable = AGENT_TOOLS.filter(function (t) {
    if (t.needsWorkspace && !wsReady()) return false;
    if (t.name in PY_TOOL_NAMES && !pyReady()) return false;   /* Python 工具族的运行期门 */
    return toolSupported(t);
  }).length;
  $("mcp-title").textContent = on ? "模型工具调用已开启" : "模型工具调用已关闭";
  $("mcp-sub").textContent = on
    ? "已启用 " + activeTools(conv).length + " / " + AGENT_TOOLS.length + " 个工具(" +
      usable + " 个在当前浏览器可用)。每次请求都会带上 tools 定义。"
    : "默认关闭。开启后,对话中的模型可以调用下面的工具处理信息后再作答。";
  /* 联网开关已从工具卡片抽离到面板级:面板重绘时同步它的勾选态 */
  var netEl = $("set-tool-net");
  if (netEl) netEl.checked = !!state.settings.toolNet;
  /* 上下文压缩:自动开关与阈值的勾选态/读数同步(唯一权威 = state.settings) */
  var cxAutoEl = $("set-compact-auto");
  if (cxAutoEl) cxAutoEl.checked = state.settings.compactAuto !== false;
  var cxPctEl = $("set-compact-pct");
  if (cxPctEl) {
    cxPctEl.value = String(cxTriggerPct());
    var cxOut = $("set-compact-pct-v");
    if (cxOut) cxOut.textContent = cxTriggerPct() + "%";
  }
  var box = $("mcp-tools");
  if (box) {
    /* 分组渲染:组标题复用既有 .sec-title 样式;分组按工具的能力面推导
       (需要工作区的 = 文件 / PY_TASK_NAMES 里的 = 任务 / 其余 = 代码执行),不新增工具字段。
       分组口径:「文件(6)/代码执行(2)/任务(5)/外部 MCP」——
       内部工具与外部 MCP 工具分成两段标题(外部段按 source 单独渲染) */
    var groups = [
      { key: "file", title: "文件", list: [] },
      { key: "exec", title: "代码执行", list: [] },
      { key: "ctx", title: "上下文", list: [] },
      { key: "task", title: "任务", list: [] }
    ];
    AGENT_TOOLS.forEach(function (t) {
      if (t.needsWorkspace) groups[0].list.push(t);
      else if (t.name === "Compact") groups[2].list.push(t);
      else if (t.name in PY_TASK_NAMES) groups[3].list.push(t);
      else groups[1].list.push(t);
    });
    var html = "";
    /* 存储降级原因(如「数据库里没有工作区存储区」)必须让用户看得见 —— appA 的 blobStore.note
       原先只在「大仓库整体不可用」的回退态显示,工作区缺区的场景里它是死数据 */
    if (blobStore.note) html += '<div class="tr-need">' + escapeHtml(blobStore.note) + "</div>";
    groups.forEach(function (g) {
      if (!g.list.length) return;
      html += '<div class="sec-title">' + escapeHtml(g.title) + "（" + g.list.length + "）</div>";
      g.list.forEach(function (t) { html += toolRowHtml(t); });
    });
    /* 外部 MCP 工具段:内部/外部**两段标题恒在** —— 没开启或没连上时也保留标题并写明
       原因与入口(否则用户不知道有「外部工具」这一项,也不知道去哪开)。
       工具行(annotations 徽标 + 三态权限 + 「全部禁用」)统一渲染在下面的「外部 MCP 服务器」
       区块里(**只有一套控件**,不在两处各画一份权限按钮);这里给分组标题与指引 */
    var cfg = mcpServerCfg();
    var extOverride = extToolsOverride(conv);          /* null = 跟随全局 */
    var extOn = (extOverride === null) ? !!state.settings.externalToolsEnabled : extOverride;
    var extN = mcpState.rawTools.length;
    html += '<div class="sec-title">外部 MCP 工具' + (cfg ? "（" + escapeHtml(cfg.name) + "）" : "") +
      "（" + (extOn ? extN : 0) + "）</div>";
    if (!cfg) {
      html += '<div class="tr-need">没有可用的服务器配置</div>';
    } else if (!extOn) {
      html += '<div class="tr-need">' + (extOverride === false
        ? "本会话已覆盖为关闭(全局默认开着也只对别的会话生效):在「调节」浮层的「本会话覆盖」里改成"
          + "「跟随全局」或「本会话开」后,这里会列出服务器上的工具"
        : "未开启:打开下面「外部 MCP 服务器」区块的总开关后,这里会列出服务器上的工具") + "</div>";
    } else if (mcpState.phase !== "ready") {
      html += '<div class="tr-need">' +
        escapeHtml(mcpState.phase === "connecting" ? "正在连接服务器…"
          : (mcpState.lastErr || "尚未连接:在下面的「外部 MCP 服务器」区块点「测试连接」")) + "</div>";
    } else if (!extN) {
      html += '<div class="tr-need">服务器没有返回任何工具(在服务器侧启用工具后点「重新读取工具列表」)</div>';
    } else {
      html += '<div class="tr-need">工具行(权限与说明)见下面的「外部 MCP 服务器」区块:已启用 ' +
        mcpActiveTools().length + " / " + extN + " 个</div>";
    }
    box.innerHTML = html;
  }
  renderMcpServers();
  syncToolLimitInputs();
  renderToolLog();
  updateMcpStatus();
}
/* 单个工具行(权限三按钮 + 工具自有开关;需要工作区的工具额外写明真实的可见性前提) */
function toolRowHtml(t) {
  var perm = toolPermOf(t.name);
  /* Python 工具族的"不可用"是运行期状态(载荷/解压能力),不是静态能力表的缺失:
     这时也要按 disabled 渲染,并写真实原因 */
  var pyOff = (t.name in PY_TOOL_NAMES) && !pyReady();
  var ok = toolSupported(t) && !pyOff;
  var opts = toolOptionsHtml(t);
  var need = "";
  if (pyOff) need += '<span class="tr-need">' + escapeHtml(pyNotReadyReason() || "Python 运行时不可用") + "</span>";
  if (t.needsWorkspace) {
    /* 三区不齐(或大仓库不可用)时,挂载也救不回来 → 必须写真实原因,不能再说"挂载后可用" */
    need = !wsReady()
      ? '<span class="tr-need">本地大仓库的工作区存储区缺失,该工具已停用(设置 → 数据 里查看)</span>'
      : (wsMountedId() ? "" : '<span class="tr-need">需在会话里挂载工作区后可用</span>');
  }
  /* 能力缺失的原因按 cap 分写:外部工具缺的是 fetch,不是 Web Worker */
  var capWhy = (t.cap === "fetch")
    ? "当前浏览器不支持 fetch,外部 MCP 工具已停用"
    : "当前浏览器缺少 Web Worker / Blob 支持,该工具会自动跳过";
  return '<div class="tool-row' + (ok ? "" : " disabled") + '">' +
    '<span class="tr-main"><span class="tr-name">' + escapeHtml(t.title) +
    ' <code>' + escapeHtml(t.name) + "</code>" +
    (t.source === "external" ? mcpAnnotationsBadge(t.annotations) : "") +
    '<span class="tr-scope ' + (t.scope === "write" ? "write" : "read") + '">' +
    (t.scope === "write" ? "可写" : "只读") + "</span></span>" +
    '<span class="tr-desc">' + escapeHtml(t.desc) + "</span>" +
    need +
    (ok || pyOff ? "" : '<span class="tr-need">' + escapeHtml(capWhy) + "</span>") +
    "</span>" +
    '<span class="tr-side"><span class="tr-perm">' + permBtn(t.name, "ask", "询问", perm) +
    permBtn(t.name, "allow", "允许", perm) + permBtn(t.name, "deny", "禁止", perm) + "</span>" +
    (opts ? '<span class="tr-opts">' + opts + "</span>" : "") + "</span></div>";
}
/* 外部工具的 annotations 徽标(工具名 + annotations 徽标);
   服务器通常不返回 annotations → 返回空串,不占位 */
function mcpAnnotationsBadge(a) {
  if (!a || typeof a !== "object") return "";
  var out = "";
  if (a.readOnlyHint) out += '<span class="tr-scope read">只读</span>';
  if (a.destructiveHint) out += '<span class="tr-scope write">有破坏性</span>';
  if (a.requiresNetwork) out += '<span class="tr-scope read">联网</span>';
  return out;
}
/* 工具自己的配置项(定义在工具的 options 里),渲染在该工具那一行的权限下方 */
function toolOptionsHtml(t) {
  if (!t.options || !t.options.length) return "";
  return t.options.map(function (o) {
    var v = !!o.get();
    return '<label class="tr-opt" title="' + escAttr(o.title || o.label) + '">' +
      escapeHtml(o.label) +
      '<span class="switch sm"><input type="checkbox" data-tool-opt="' + escAttr(o.key) +
      '" data-tool="' + escAttr(t.name) + '"' + (v ? " checked" : "") + ' /><span class="slider"></span></span>' +
      "</label>";
  }).join("");
}
function toolOption(t, key) {
  if (!t || !t.options) return null;
  for (var i = 0; i < t.options.length; i++) if (t.options[i].key === key) return t.options[i];
  return null;
}
function updateMcpStatus() {
  var el = $("st-mcp"), wrap = $("st-mcp-wrap");
  if (!el || !wrap) return;
  /* 可见性旁路:开关状态与计数一律从 mcpStatusInfo() 派生,
     不在这里自己早退 —— 否则「只开外部 MCP」时状态栏会谎报「工具关闭」 */
  var info = mcpStatusInfo(conv);
  var n = info.activeCount;
  el.textContent = info.on
    ? ("工具 " + n + " 个" + (TOOL_TURN.used ? " · 本次 " + TOOL_TURN.used + " 次" : ""))
    : "工具关闭";
  wrap.className = "st" + (info.on ? (n ? " ok" : " warn") : "");
  wrap.title = info.on
    ? "模型工具调用" + info.text + ":" + (activeTools(conv).map(function (t) { return t.name; }).join("、") || "没有可用工具") +
      "\n本轮已调用 " + TOOL_TURN.used + " 次(点击打开设置)"
    : "模型工具调用已关闭(点击打开设置)";
}
window.__mcpRefresh = renderMcpPanel;

function bindMcpUI() {
  var en = $("mcp-enabled");
  if (en) {
    en.addEventListener("change", function () {
      state.settings.toolsEnabled = !!en.checked;
      saveSoon();
      renderMcpPanel();
      toast(state.settings.toolsEnabled ? "模型工具调用已开启" : "模型工具调用已关闭",
        state.settings.toolsEnabled ? "success" : "info", 2600);
    });
  }
  /* 上下文压缩:自动开关 / 阈值 / 立即压缩 */
  var cxAuto = $("set-compact-auto");
  if (cxAuto) {
    cxAuto.addEventListener("change", function () {
      state.settings.compactAuto = !!cxAuto.checked;
      saveSoon();
      toast(state.settings.compactAuto ? "已开启自动压缩(接近窗口上限时自动压缩一次)" : "已关闭自动压缩(仍可让模型调用 Compact 工具)",
        "info", 3200);
    });
  }
  var cxPctEl = $("set-compact-pct");
  if (cxPctEl) {
    cxPctEl.addEventListener("input", function () {
      state.settings.compactTriggerPct = clampNum(cxPctEl.value, CX_TRIGGER_MIN, CX_TRIGGER_MAX, CX_TRIGGER_DEF);
      var out = $("set-compact-pct-v");
      if (out) out.textContent = state.settings.compactTriggerPct + "%";
      saveSoon();
    });
  }
  var cxBtn = $("btn-compact-now");
  if (cxBtn) {
    cxBtn.addEventListener("click", function () { cxCompactUIApply(conv ? conv.id : null, ""); });
  }
  var tools = $("mcp-tools");
  if (tools) {
    tools.addEventListener("click", function (e) {
      var b = e.target && e.target.closest ? e.target.closest("[data-perm]") : null;
      if (!b) return;
      setToolPerm(b.getAttribute("data-tool"), b.getAttribute("data-perm"));
      renderMcpPanel();
      toast("权限已更新:" + b.getAttribute("data-tool") + " → " +
        (b.getAttribute("data-perm") === "ask" ? "每次询问" : b.getAttribute("data-perm") === "allow" ? "自动允许" : "禁止"),
        "success", 1800);
    });
    /* 工具自己的配置项(如 FileOps 的「允许删除 / 允许覆盖」) */
    tools.addEventListener("change", function (e) {
      var el = e.target;
      if (!el || !el.getAttribute || !el.getAttribute("data-tool-opt")) return;
      var t = AGENT_TOOL_MAP[el.getAttribute("data-tool")];
      var opt = toolOption(t, el.getAttribute("data-tool-opt"));
      if (!opt) return;
      opt.set(!!el.checked);
      saveSoon();
      toast(opt.label + ":" + (el.checked ? "已开启" : "已关闭"), "info", 1800);
    });
  }
  TOOL_LIMIT_INPUTS.forEach(function (b) {
    var el = $(b[0]);
    if (!el) return;
    el.addEventListener("input", function () {
      if (!state.settings.toolLimits || typeof state.settings.toolLimits !== "object") state.settings.toolLimits = {};
      state.settings.toolLimits[b[1]] = Number(el.value);
      var out = $(b[0] + "-v");
      if (out) out.textContent = toolLimitFmt(b[1], el.value);
      saveSoon();
    });
  });
  var clr = $("tool-log-clear");
  if (clr) clr.addEventListener("click", function () {
    TOOL_LOG = [];
    renderToolLog();
    toast("已清空调用记录", "info", 1500);
  });
  /* 外部 MCP 服务器区块 + 「调节」浮层的工具分组 */
  bindMcpServersUI();
  /* 对话里的放行卡片 + 卡片展开/收起 */
  elChatInner.addEventListener("click", function (e) {
    var t = e.target;
    if (!t || !t.closest) return;
    var tog = t.closest("[data-tool-toggle]");
    if (tog) {
      var id = tog.getAttribute("data-tool-toggle");
      var msg = findMsg(id);
      if (!msg) return;
      msg.toolOpen = !toolCardOpen(msg);
      redrawToolCard(msg);
      saveSoon();
      return;
    }
    /* AskUser 卡片:选项 / 提交 / 跳过(与放行卡片同一层委托,不新增监听器) */
    var ao = t.closest("[data-ask-opt]");
    if (ao) { askUserClickOpt(ao); return; }
    var aa = t.closest("[data-ask-act]");
    if (aa) {
      var acard = aa.closest(".tool-card");
      if (acard) askUserAct(acard.getAttribute("data-id"), aa.getAttribute("data-ask-act"));
      return;
    }
    var b = t.closest("[data-tool-act]");
    if (!b) {
      /* 卡片任务行上的「停止」按钮 —— 与 `/tasks` 弹窗**同一个入口**(见 pvStopTaskFromUI):
         两条路径各写一份就会各有一套收尾判定,那正是漂移源 */
      var st = t.closest("[data-task-stop]");
      if (st) pvStopTaskFromUI(st.getAttribute("data-task-stop"));
      return;
    }
    var card = b.closest(".tool-card");
    if (!card) return;
    resolveToolApproval(card.getAttribute("data-id"), b.getAttribute("data-tool-act"));
  });
  /* AskUser 卡片里的自定义输入:textarea 的键入不进 click 委托,input 事件单独接一层
     (只写草稿 + 局部刷新选中态,不重绘卡片 —— 重绘会丢光标) */
  elChatInner.addEventListener("input", function (e) {
    var t = e.target;
    if (t && t.closest && t.closest("[data-ask-ta]")) askUserTextInput(t);
  });
}

/* ---------------------------------------------------------------------------
   23. 初始化
--------------------------------------------------------------------------- */
function renderCompatScreen() {
  var ul = $("compat-list");
  if (!ul) return;
  ul.innerHTML = (ENV.critical || []).map(function (m) { return "<li>" + escapeHtml(m) + "</li>"; }).join("");
}
function init() {
  if (!ENV.ok) renderCompatScreen();
  applyAppearance();
  setProtocol(state.settings.protocol);
  initEffortSelects();
  initAttachSelects();
  initParamInputs();
  bindUI();
  bindMcpUI();
  bindPyTaskUI();
  initSpaceUI();
  syncSettingsForm();
  rebuildModelDatalist();
  renderLibList();
  updateHint();
  /* 首屏占位:会话还没从大仓库装回来,先按空库渲染(无会话 → 欢迎页) */
  renderChat();

  /* 会话本体在大仓库(IndexedDB)里:先装回来,再做自动整理,然后才渲染。
     装不回来也不阻塞界面 —— 用空库继续跑,只影响旧数据可见性 */
  bootStorage().then(function () {
    finishInit();
    /* 存储真的可用:把落盘记录里的 convsInIdb 诊断字段对齐(只改这一个字段,不重写会话正文) */
    alignConvsMarker();
  }, function () {
    finishInit();
  });
}

function finishInit() {
  conv = getConv(state.activeId) || state.conversations[0] || null;
  if (conv) state.activeId = conv.id;
  renderChat();
  /* 附件 payload 可能外置在 IndexedDB:预热当前会话,读到东西就再渲染一次
     (warmBlobs 返回的是「这次真正读到几条」,所以不会反复触发重绘) */
  warmBlobs().then(function (n) {
    if (n > 0) { renderChat(); if (typeof updateCtxMonitor === "function") updateCtxMonitor(); }
  }, function () {});
  renderConvList();
  updateTopbar();
  updateCtxMeter();
  updateStorageMeter();
  updateMcpStatus();

  if (storageBroken) {
    toast("浏览器禁用了本地存储,数据只能保留在内存中", "warn", 5000);
  }
  if (!state.settings.baseUrl) {
    setConn("err", "未配置地址");
  } else {
    setConn("ok", "已就绪");
    if (state.settings.autoSync) setTimeout(function () { fetchModels(false, true); }, 800);
  }
  updateStatusBar();
  autoFitSidebar();
  if (isMobile()) collapseSidebar();
  syncSidebarBackdrop();
  updateStorageMeter();
  if (!CAP.stream) toast("当前浏览器不支持流式读取,已自动切换为非流式输出", "info", 4200);
  /* 版本号唯一权威 = APP_VERSION(appA):把 <meta name="version"> 同步过来,
     head.part 里那份不再是独立编辑点(关于弹窗的版本显示也从这个常量取) */
  try {
    var _mv = document.querySelector('meta[name="version"]');
    if (_mv) _mv.setAttribute("content", APP_VERSION);
  } catch (e) {}
  /* 刷新/关页后残留的「等待中」卡片(AskUser 提问 / 待放行)已经没人等了 ⇒ 收敛一次。
     只在这里调一次:启动链末端(会话已从 IndexedDB 装回、renderChat 已能工作),不挂热路径 */
  askUserSweepStale();
  /* 启动完成标记(自动化测试与用户自查都用得上:页面到底加载完没有) */
  try { document.documentElement.setAttribute("data-boot", "done"); } catch (e) {}
  /* 空间快满就提醒(不自动删任何东西) */
  checkSpaceAuto();
  /* Python 运行时状态行首次渲染;解码能力探测在这里落到界面上 */
  renderPyRunState();
  /* Python 任务设置区(后台超时 / 停止生成是否杀后台 / 任务小结) */
  renderPyTaskSettings();
  updateTaskStatus();
}

/* ---------------------------------------------------------------------------
   24. 工作区(沙箱虚拟盘)内核 —— 唯一 IDB 写入口
   · 三区:workspaces(元数据 + 目录树) / wsfiles(文件本体,Blob) / pyocache(pyodide 资产缓存)
   · 路径:仅 / 分隔;拒绝 \、空段、. 与 ..、控制字符、段尾空格与点;单段 ≤128、总长 ≤512、深度 ≤32
   · 并发:同 wsId 的写操作经 wsLock 串行(tree 与 usedBytes 是读改写);跨 wsId 可并发
   · 就绪:IDB v3(appA 一次建齐三区);wsStoreReady 为假 → 本模块整体关闭,文件工具也不出可见性门
   · 内存:只缓存元数据(含目录树);文件内容一律按需读
--------------------------------------------------------------------------- */
var WS_MAX_COUNT = 10;
var WS_QUOTA_MIN_MB = 50, WS_QUOTA_MAX_MB = 512, WS_QUOTA_DEF_MB = 256;
var WS_NAME_MAX = 40;
var WS_PATH_MAX = 512, WS_SEG_MAX = 128, WS_DEPTH_MAX = 32;
var WS_WRITE_MAX = 1024 * 1024;                 // 单次工具写 1 MB(E2BIG)
var WS_READ_DEF = 16384;                        // 字节读默认窗口(旧口径)
var WS_LIST_DEF = 100, WS_LIST_MAX = 500;
var WS_SESSION_BYTES = 16 * 1024 * 1024;        // ① 会话预载默认上限(运行值取 settings.wsSessionBytesMb)
var WS_SESSION_WBACK = 256 * 1024 * 1024;       // ④ 每会话回写默认硬顶(取 settings.wsSessionWbackMb)
var WS_SESSION_FILES = 2000;                    // ④ 每会话回写文件数默认(取 settings.wsSessionFiles)
var READ_DEFAULT_CHARS = 16000, READ_MAX_CHARS = 65536;
/* ---- Read 的多媒体预算(单一权威;口径 = Kimi ReadMedia 对齐 + 我们自己的像素/字节双门) ----
   只服务 Read 的图片/文档路径:附件侧仍走 transcodeImage + ATTACH_*(两条口径各管各的) */
var READ_IMG_MAX_EDGE = 2000;                    /* 交付最长边上限(= Kimi MAX_IMAGE_EDGE_PX) */
var READ_IMG_BYTE_BUDGET = 256 * 1024;           /* 自动压缩的尽力目标(= Kimi READ_IMAGE_BYTE_BUDGET) */
var READ_IMG_DECODE_MAX_PX = 40 * 1000 * 1000;   /* 像素护栏(第一道):尺寸头嗅探后再决定要不要解码 */
var READ_IMG_DECODE_MAX = 32 * 1024 * 1024;      /* 字节护栏(第二道):与像素门**取与** */
var READ_IMG_HARD_MAX = 1024 * 1024;             /* 单张硬顶 = 单次总量(压不动即报错,不发原图) */
var READ_MEDIA_MAX_IMAGES = 4;                   /* 单次调用交付张数上限(office 图 / PDF 页图) */
var READ_MEDIA_TOTAL_BYTES = 1024 * 1024;        /* 单次调用交付总字节(== 单张硬顶) */
var READ_PDF_IMG_MAX_PAGES = 4;                  /* 无文字层 PDF 的渲染页数上限(与 pdfMaxPages() 取小) */
var READ_OCR_TIMEOUT_MS = 120000;                /* **整次 Read** 的 OCR 总预算(多页共享,不再是每页独立) */
var TOOL_MEDIA_CHAT_KEEP_ITEMS = 8;              /* 聊天轮软护栏:最近 N 条带媒体工具项 */
var TOOL_MEDIA_CHAT_MAX_BYTES = 8 * 1024 * 1024; /* 聊天轮软护栏:累计 data 字符量上限(≈8 MiB) */
var EDIT_READ_MAX = 2 * 1024 * 1024;            // Edit 可编辑文件上限
var GLOB_MAX_ENTRIES = 500, GLOB_MAX_DEPTH = 8;
var GREP_MAX_FILES = 500, GREP_MAX_SCAN_BYTES = 32 * 1024 * 1024;
var FILEOPS_MAX_FILES = 1000;
/* 只服务实现的内部常量(不进契约) */
var WS_READ_BYTE_CAP = 4 * 1024 * 1024;         // Read 文本窗口上限(超出只读一段,避免灌爆内存)
var WS_GREP_FILE_CAP = 4 * 1024 * 1024;         // Grep 单文件读取上限
var WS_GREP_MS = 5000;                          // Grep 时长上限
var WS_GREP_YIELD = 25;                         // Grep 每 N 个文件让出主线程(文件间)
var WS_GREP_LINE_CHK = 256;                     // 单文件内每 N 行查一次时长上限(文件内也能及时收手)
var WS_GREP_YIELD_MS = 12;                      // 单文件内让出主线程的间隔(真的占过 ~12ms 才让,避免空转)
var WS_GREP_PATTERN_MAX = 500;                  // pattern 长度上限(模型自供输入,防超长模式每行都付高代价)
var WS_NOTE_READY = "本地大仓库(IndexedDB)不可用或工作区存储区缺失,工作区功能已关闭";

/* 已载入的工作区元数据(含目录树):给同步的 wsContextBlock() 与挂载预热用;文件内容不进内存 */
var WS_META_CACHE = {};
/* 同 wsId 的写锁(串行链);跨 wsId 可并发 */
var WS_LOCKS = {};

function wsErr(code, error, path) {
  var e = { ok: false, code: code, error: error };
  if (path != null) e.path = path;
  return e;
}
function wsIsErr(v) { return !!(v && v.ok === false && v.code); }
function wsMsg(e) { return String((e && (e.message || e)) || e || "未知错误"); }
function wsBlobOf(v) { return !!(v && typeof v.size === "number" && typeof v.slice === "function"); }
function wsYield() { return new Promise(function (r) { setTimeout(r, 0); }); }

/* ---- 路径模型 ---- */
function wsJoinPath(dir, name) { return (dir === "/" ? "" : dir) + "/" + name; }
function wsPathParent(p) { var i = String(p).lastIndexOf("/"); return i <= 0 ? "/" : String(p).slice(0, i); }
function wsPathName(p) { return String(p).slice(String(p).lastIndexOf("/") + 1); }
/* 先规范化再前缀比对(不做字符串层面的 .. 判断);返回 {ok,path} 或 Err(EINVAL) */
function wsNormPath(p) {
  if (typeof p !== "string" || !p) return wsErr("EINVAL", "路径不能为空");
  if (p.charAt(0) !== "/") return wsErr("EINVAL", "路径必须以 / 开头(工作区根目录是 /)");
  if (p.indexOf("\\") !== -1) return wsErr("EINVAL", "路径里不能有反斜杠 \\,工作区只用 / 分隔");
  var s = p;
  while (s.length > 1 && s.charAt(s.length - 1) === "/") s = s.slice(0, -1);
  if (s === "/") return { ok: true, path: "/" };
  if (s.length > WS_PATH_MAX) return wsErr("EINVAL", "路径过长(上限 " + WS_PATH_MAX + " 字符)");
  var segs = s.slice(1).split("/");
  if (segs.length > WS_DEPTH_MAX) return wsErr("EINVAL", "目录层级过深(上限 " + WS_DEPTH_MAX + " 层)");
  for (var i = 0; i < segs.length; i++) {
    var g = segs[i];
    if (!g) return wsErr("EINVAL", "路径里有空段(连续的 /)");
    if (g === "." || g === "..") return wsErr("EINVAL", "路径里不能出现 . 或 ..");
    if (g === "__proto__") return wsErr("EINVAL", "名称不能是 __proto__");
    if (/[\u0000-\u001f\u007f]/.test(g)) return wsErr("EINVAL", "路径里不能有控制字符");
    if (g.length > WS_SEG_MAX) return wsErr("EINVAL", "单段名称过长(上限 " + WS_SEG_MAX + " 字符)");
    if (/[ .]$/.test(g)) return wsErr("EINVAL", "名称结尾不能是空格或点");
  }
  return { ok: true, path: "/" + segs.join("/") };
}

/* ---- 目录树(存在 workspaces 记录里的 tree) ---- */
function wsNewDir() { return { t: "d", ch: Object.create(null) }; }
function wsTreeChild(node, name) {
  if (!node || node.t !== "d" || !node.ch) return null;
  return Object.prototype.hasOwnProperty.call(node.ch, name) ? node.ch[name] : null;
}
function wsTreeGet(tree, path) {
  if (!tree || tree.t !== "d") return null;
  if (path === "/") return tree;
  var segs = String(path).slice(1).split("/"), n = tree;
  for (var i = 0; i < segs.length; i++) {
    n = wsTreeChild(n, segs[i]);
    if (!n) return null;
  }
  return n;
}
/* 逐段建目录(幂等);中途撞上文件 → ENOTDIR */
function wsTreeMkdirs(tree, path) {
  if (path === "/") return { ok: true, created: 0 };
  var segs = String(path).slice(1).split("/"), n = tree, created = 0;
  for (var i = 0; i < segs.length; i++) {
    var c = wsTreeChild(n, segs[i]);
    if (!c) { c = wsNewDir(); n.ch[segs[i]] = c; created++; }
    else if (c.t !== "d") return wsErr("ENOTDIR", "「/" + segs.slice(0, i + 1).join("/") + "」不是目录");
    n = c;
  }
  return { ok: true, created: created };
}
function wsTreeFiles(node, cb) {
  if (!node || node.t !== "d" || !node.ch) return;
  for (var k in node.ch) {
    if (!Object.prototype.hasOwnProperty.call(node.ch, k)) continue;
    var c = node.ch[k];
    if (c.t === "d") wsTreeFiles(c, cb);
    else cb(c, k);
  }
}
function wsTreeSizeInfo(node) {
  var n = 0, b = 0;
  wsTreeFiles(node, function (f) { n++; b += f.size || 0; });
  return { files: n, bytes: b };
}
/* 子树里所有文件(带绝对路径与相对路径) */
function wsTreeAllFiles(tree, base, out) {
  out = out || [];
  var root = wsTreeGet(tree, base);
  if (!root || root.t !== "d") return out;
  var skip = base === "/" ? 1 : base.length + 1;
  (function walk(node, prefix) {
    for (var k in node.ch) {
      if (!Object.prototype.hasOwnProperty.call(node.ch, k)) continue;
      var c = node.ch[k], p = wsJoinPath(prefix, k);
      if (c.t === "d") walk(c, p);
      else out.push({ path: p, rel: p.slice(skip), name: k, node: c });
    }
  })(root, base);
  return out;
}

/* ---- 名字模式(* ? ** {a,b};用于 Glob 的 pattern 与 Grep 的 glob) ---- */
function wsReEsc(s) { return String(s).replace(/[.*+?^${}()|[\]\\]/g, function (c) { return "\\" + c; }); }
function wsGlobRe(pattern) {
  var s = String(pattern), out = "^", i = 0;
  while (i < s.length) {
    var ch = s.charAt(i);
    if (ch === "*") {
      if (s.charAt(i + 1) === "*") {
        i += 2;
        if (s.charAt(i) === "/") { i++; out += "(?:.*/)?"; }
        else out += ".*";
      } else { i++; out += "[^/]*"; }
    } else if (ch === "?") { i++; out += "[^/]"; }
    else if (ch === "{") {
      var close = s.indexOf("}", i);
      if (close === -1) { out += "\\{"; i++; }
      else {
        out += "(?:" + s.slice(i + 1, close).split(",").map(wsReEsc).join("|") + ")";
        i = close + 1;
      }
    } else { out += wsReEsc(ch); i++; }
  }
  return new RegExp(out + "$");
}
function wsGlobMatch(pattern, rel, base) {
  if (!pattern) return true;
  var re;
  try { re = wsGlobRe(pattern); } catch (e) { return false; }
  if (re.test(rel)) return true;
  if (String(pattern).indexOf("/") === -1 && re.test(base)) return true;
  return false;
}

/* ---- Blob 读写小工具 ---- */
function wsBlobBuffer(blob) {
  return new Promise(function (resolve, reject) {
    if (!blob) { resolve(new ArrayBuffer(0)); return; }
    if (typeof blob.arrayBuffer === "function") { blob.arrayBuffer().then(resolve, reject); return; }
    try {
      var fr = new FileReader();
      fr.onload = function () { resolve(fr.result); };
      fr.onerror = function () { reject(fr.error || new Error("读取失败")); };
      fr.readAsArrayBuffer(blob);
    } catch (e) { reject(e); }
  });
}
function wsBlobText(blob) {
  return new Promise(function (resolve, reject) {
    if (!blob) { resolve(""); return; }
    if (typeof blob.text === "function") { blob.text().then(resolve, reject); return; }
    try {
      var fr = new FileReader();
      fr.onload = function () { resolve(String(fr.result == null ? "" : fr.result)); };
      fr.onerror = function () { reject(fr.error || new Error("读取失败")); };
      fr.readAsText(blob, "utf-8");
    } catch (e) { reject(e); }
  });
}
/* ---- 内容探针(唯一的「这个 blob 是不是文本 / 是什么文本」判定出口) ----
   广播枢纽:Read / Grep / Edit 共用同一份判定,文件预览与附件解析链路按同一接口复用;
   禁止各调用点自建副本。分层判据见方案 §2.2 表 2;采样 = 首 8 KB + 末 512 B
   (≤ 8704 B 时即整份),两段各自校验、不拼接;只对已在内存里的 Blob 做两次 slice,
   无新增 IDB 往返,解码量 ≤ 8704 B/次。 */
var WS_PROBE_HEAD_BYTES = 512;       /* magic / BOM / NUL 布局样本(Kimi MEDIA_SNIFF_BYTES 同值) */
var WS_PROBE_SAMPLE_BYTES = 8192;    /* 内容样本·首段(与旧实现同量级,成本不增) */
var WS_PROBE_TAIL_BYTES = 512;       /* 内容样本·末段(两段各自校验,不做字节拼接) */
var WS_TEXT_CTL_RATIO_MAX = 0.3;     /* 控制字符比上限(超过即二进制;Kimi / Rust 同值) */
var WS_UTF16_MIN_ZEROS = 2;          /* 无 BOM UTF-16 方向判定的最小 NUL 数(Kimi MIN_ZERO_BYTES_FOR_UTF16) */
var WS_UTF16_DENSITY_DIV = 64;       /* 4b 密度下限分母:dom ≥ min(8, ⌊units/64⌋) */
var WS_GBK_MIN_SAMPLE = 16;          /* 走 GB18030 回退前所需的最小样本(无后缀文件) */
/* magic 签名表(17 条,全部锚定偏移 0;WebP 另看偏移 8 处)。命中分级见 wsProbeJudge 判据 1;
   不得增删签名(新增会让复现样本表失效) */
var WS_MAGIC_SIGS = [
  { b: [0x89, 0x50, 0x4e, 0x47, 0x0d, 0x0a, 0x1a, 0x0a], t: "PNG 图片", m: "image/png" },
  { b: [0xff, 0xd8, 0xff], t: "JPEG 图片", m: "image/jpeg" },
  { b: [0x47, 0x49, 0x46, 0x38], t: "GIF 图片", m: "image/gif" },
  { b: [0x42, 0x4d], t: "BMP 图片", m: "image/bmp" },
  { b: [0x49, 0x49, 0x2a, 0x00], t: "TIFF 图片", m: "image/tiff" },
  { b: [0x4d, 0x4d, 0x00, 0x2a], t: "TIFF 图片", m: "image/tiff" },
  { b: [0x52, 0x49, 0x46, 0x46], b2: [0x57, 0x45, 0x42, 0x50], o2: 8, t: "WebP 图片", m: "image/webp" },
  { b: [0x25, 0x50, 0x44, 0x46], t: "PDF 文档", m: "application/pdf" },
  { b: [0x50, 0x4b, 0x03, 0x04], t: "ZIP 压缩包(可能是 docx/xlsx/pptx)", m: "application/zip" },
  { b: [0xd0, 0xcf, 0x11, 0xe0], t: "OLE2 复合文档(可能是 doc/xls/ppt)", m: "application/x-ole-storage" },
  { b: [0x52, 0x61, 0x72, 0x21], t: "RAR 压缩包", m: "application/vnd.rar" },
  { b: [0x37, 0x7a, 0xbc, 0xaf], t: "7z 压缩包", m: "application/x-7z-compressed" },
  { b: [0x1f, 0x8b], t: "gzip 压缩包", m: "application/gzip" },
  { b: [0x7f, 0x45, 0x4c, 0x46], t: "可执行文件(ELF)", m: "application/x-elf" },
  { b: [0x4d, 0x5a], t: "可执行文件(PE)", m: "application/x-msdownload" },
  { b: [0x00, 0x61, 0x73, 0x6d], t: "WebAssembly 模块", m: "application/wasm" },
  { b: [0x53, 0x51, 0x4c, 0x69, 0x74, 0x65, 0x20, 0x66, 0x6f, 0x72, 0x6d, 0x61, 0x74, 0x20, 0x33, 0x00], t: "SQLite 数据库", m: "application/vnd.sqlite3" }
];
/* 后缀归一化:小写 + 去前导点(与 extOf() 及五张后缀表同口径:都不带点) */
function wsSuffixNorm(suf) {
  var s = String(suf == null ? "" : suf).toLowerCase();
  while (s.charAt(0) === ".") s = s.slice(1);
  return s;
}
function wsSuffixOf(name) {
  var s = String(name == null ? "" : name).toLowerCase();
  var i = s.lastIndexOf("/");
  var base = i >= 0 ? s.slice(i + 1) : s;
  var d = base.lastIndexOf(".");
  if (d < 0 || d === base.length - 1) return "";
  return base.slice(d + 1);
}
/* 二进制后缀早退(判据 2):BLOCKED_EXT ∪ IMAGE_EXT ∪ OFFICE_EXT ∪ MACRO_EXT ∪ {pdf,pyc,wasm};
   .svg 归文本侧(可读其 XML 源码) */
function wsProbeBinarySuffix(suf) {
  suf = wsSuffixNorm(suf);
  if (!suf || suf === "svg") return false;
  if (suf === "pdf" || suf === "pyc" || suf === "wasm") return true;
  return BLOCKED_EXT.indexOf(suf) > -1 || IMAGE_EXT.indexOf(suf) > -1 ||
    OFFICE_EXT.indexOf(suf) > -1 || MACRO_EXT.indexOf(suf) > -1;
}
/* 文本暗示(判据 7 的第一道门):文本后缀 / text 系 mime;无后缀的「采样 ≥16 B」由 wsProbeJudge 叠 */
function wsProbeTextHint(suf, mime) {
  suf = wsSuffixNorm(suf);
  if (suf) return TEXT_EXT.indexOf(suf) > -1;
  return /^text\//i.test(String(mime || ""));
}
/* 精确尾部修剪(Kimi classifyTextSample 同算法):只在末尾确实存在「不完整但前缀合法」的
   多字节序列时,从该序列起点截断 —— 取代旧的 subarray(0, len-3) 盲剪(根因) */
function wsUtf8TrimEnd(u8) {
  var end = u8.length, i, j, b, exp, ok;
  for (i = Math.max(0, u8.length - 3); i < u8.length; i++) {
    b = u8[i];
    exp = (b >= 0xc2 && b <= 0xdf) ? 2 : (b >= 0xe0 && b <= 0xef) ? 3 : (b >= 0xf0 && b <= 0xf4) ? 4 : 0;
    if (exp === 0 || i + exp <= u8.length) continue;
    ok = true;
    for (j = i + 1; j < u8.length; j++) if (u8[j] < 0x80 || u8[j] > 0xbf) { ok = false; break; }
    if (ok) { end = i; break; }
  }
  return end;
}
/* 段首悬垂续字节:末段从多字节字符中间开始时,跳过首 1–3 个续字节 */
function wsTrimStartCont(u8) {
  var k = 0;
  while (k < u8.length && k < 3 && (u8[k] & 0xc0) === 0x80) k++;
  return u8.subarray(k);
}
function wsProbeHasNul(u8) {
  for (var i = 0; i < u8.length; i++) if (u8[i] === 0) return true;
  return false;
}
/* 控制字符比(Kimi classifyTextSample 同式):TAB / LF / CR 不计,其余 <0x20 与 0x7F–0x9F 计;
   超 30% 即判二进制;代理对按一个码点计 */
function wsTextCtlBad(text) {
  var bad = 0, total = 0, i, cp, lo;
  for (i = 0; i < text.length; i++) {
    cp = text.charCodeAt(i);
    if (cp >= 0xd800 && cp <= 0xdbff && i + 1 < text.length) {
      lo = text.charCodeAt(i + 1);
      if (lo >= 0xdc00 && lo <= 0xdfff) i++;
    }
    total++;
    if (cp === 9 || cp === 10 || cp === 13) continue;
    if (cp < 32 || (cp >= 0x7f && cp <= 0x9f)) bad++;
  }
  return total > 0 && (bad / total) > WS_TEXT_CTL_RATIO_MAX;
}
/* 按编码解码字节(严格 / 宽松两态);TextDecoder 不支持该编码 → why:"unsupported" */
function wsDecodeBytes(u8, enc, strict) {
  var td;
  try { td = new window.TextDecoder(enc, { fatal: !!strict }); }
  catch (e) { return { ok: false, why: "unsupported" }; }
  try { return { ok: true, text: td.decode(u8), lossy: !strict }; }
  catch (e2) { return { ok: false, why: "invalid" }; }
}
/* 按探针给的编码解码一个 Blob(strict=true 非法即失败;cut=true 视末端为人工截断端,
   仅此情形允许 GB18030 退 ≤3 字节重试;noTrim=true 不做 UTF-8 尾部修剪 —— Edit 写路径用:
   「含非法字节」必须原样暴露为失败,不得静默吞尾) */
function wsDecodeTextBlob(blob, enc, opts) {
  opts = opts || {};
  var strict = !!opts.strict, cut = !!opts.cut, noTrim = !!opts.noTrim;
  return wsBlobBuffer(blob).then(function (buf) {
    var u8 = new Uint8Array(buf || new ArrayBuffer(0));
    if (enc === "utf-8") {
      var end = noTrim ? u8.length : wsUtf8TrimEnd(u8);
      return wsDecodeBytes(u8.subarray(0, end), "utf-8", strict);
    }
    if (enc === "utf-16le" || enc === "utf-16be") {
      if ((u8.length % 2) === 1) u8 = u8.subarray(0, u8.length - 1);   /* 偶数字节对齐 */
      return wsDecodeBytes(u8, enc, strict);
    }
    if (enc === "gb18030") {
      var r = wsDecodeBytes(u8, "gb18030", strict);
      if (!r.ok && r.why === "invalid" && cut) {
        for (var k = 1; k <= 3 && u8.length > k; k++) {
          r = wsDecodeBytes(u8.subarray(0, u8.length - k), "gb18030", strict);
          if (r.ok) break;
        }
      }
      return r;
    }
    return { ok: false, why: "unsupported" };
  });
}
/* GB18030 严格解码 + 人工截断端容错(判据 7 的第二步;真实文件末端不允许丢字节) */
function wsGbDecodeSeg(u8, cut) {
  var r = wsDecodeBytes(u8, "gb18030", true);
  if (!r.ok && r.why === "invalid" && cut) {
    for (var k = 1; k <= 3 && u8.length > k; k++) {
      r = wsDecodeBytes(u8.subarray(0, u8.length - k), "gb18030", true);
      if (r.ok) break;
    }
  }
  return r;
}
/* 段内 UTF-8 严格校验(精确尾部修剪):成功返回文本,失败返回 null */
function wsUtf8SegText(u8) {
  var r = wsDecodeBytes(u8.subarray(0, wsUtf8TrimEnd(u8)), "utf-8", true);
  return r.ok ? r.text : null;
}
/* magic 命中(首个命中即返回);weak = 长度 ≤2 B 且字节全在 0x20–0x7E(仅 BMP / PE) */
function wsProbeMagic(u8) {
  var i, j, s, ok;
  for (i = 0; i < WS_MAGIC_SIGS.length; i++) {
    s = WS_MAGIC_SIGS[i];
