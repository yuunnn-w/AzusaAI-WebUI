    ok = true;
    for (j = 0; j < s.b.length; j++) if (u8[j] !== s.b[j]) { ok = false; break; }
    if (!ok) continue;
    if (s.b2) {
      if (u8.length < s.o2 + s.b2.length) continue;
      ok = true;
      for (j = 0; j < s.b2.length; j++) if (u8[s.o2 + j] !== s.b2[j]) { ok = false; break; }
