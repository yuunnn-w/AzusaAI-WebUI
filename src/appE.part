function wsEditTool(wsId, args) {
  if (!args.path) return Promise.resolve(wsErr("EINVAL", "path 必填(工作区绝对路径)"));
  if (typeof args.old_string !== "string" || !args.old_string) return Promise.resolve(wsErr("EINVAL", "old_string 必填且不能为空"));
  if (typeof args.new_string !== "string") return Promise.resolve(wsErr("EINVAL", "new_string 必填(可以为空串,表示删除)"));
