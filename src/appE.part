})();
function pyB64Decode(str) {
  if (typeof atob === "function") {
    var bin = atob(str);
    var n2 = bin.length, out2 = new Uint8Array(n2), i2;
    for (i2 = 0; i2 < n2; i2++) out2[i2] = bin.charCodeAt(i2);
    return out2;
  }
  /* 兜底:纯查表实现(环境没有 atob 时,理论上不会发生) */
  var n = str.length, pad = 0;
  if (n && str.charCodeAt(n - 1) === 61) pad++;
  if (n > 1 && str.charCodeAt(n - 2) === 61) pad++;
  var out = new Uint8Array(((n / 4) | 0) * 3 - pad);
  var o = 0, buf = 0, bits = 0, i, v;
  for (i = 0; i < n; i++) {
    v = PY_B64[str.charCodeAt(i)];
    if (v < 0) continue;
    buf = (buf << 6) | v;
    bits += 6;
    if (bits >= 8) { bits -= 8; out[o++] = (buf >> bits) & 255; }
  }
  return o === out.length ? out : out.subarray(0, o);
}
/* 文本段转义还原:只在确有转义时动手(无条件还原会把 `/<\/script/`
   这类合法字面量里的 `\/` 也吃掉,而构建期的 `new Function` 体检是在转义前做的) */
function pyUnescapeInline(s) {
  var a = "<" + "\\/script", b = "<" + "\\!--";
  if (s.indexOf(a) < 0 && s.indexOf(b) < 0) return s;
  return s.split(a).join("<" + "/script").split(b).join("<" + "!--");
}

/* ---- 载荷解码(消费侧) ----
   帧解析只用帧头 len;段 id 与文件名一一对应,加载器按 indexURL + file_name 取段。
   返回 { ok, meta, core:{asmJs,pyodideJs,lockJson}, bins:{文件名→Uint8Array}, wheelNames[] } */
/* 两个 slot 同时冷启动时,**同一批 ArrayBuffer 只能给一个消费者** ——
   slot-1 的 postMessage(transfer) 会把缓冲 detach,slot-2 再 transfer 就抛
   "An ArrayBuffer is detached and could not be cloned."。
   修法 = 消费互斥:同一时刻只有一个消费者"持有"这批缓冲,后来者等前一个 release 后**重新解码**
   (拿到一份全新缓冲)。内存曲线不变 —— 等待者是串行的,任何时刻只有一份解码结果在主线程。 */
var PY_ASSETS_TAKE = null;      /* 当前被独占的那次解码(同一个 promise 对象 = 持有令牌) */
var PY_ASSETS_WAIT = [];        /* 等 release 的唤醒函数 */
var PY_ASSETS_ERR = "";         /* 载荷级硬失败(记住后不再反复重解码,与 pyHardFail 的"锁死"同语义) */
var PY_ASSETS_WAIT_MS = 120000; /* 等前一个消费者释放的上限 */
var PY_ASSETS_WAIT_MSG = "等待另一个解释器释放 Python 载荷超时(超过 120 秒),本次启动已放弃,请重试";

function pyAssetsWaitRelease() {
  return new Promise(function (resolve, reject) {
    var done = false, timer = null;
    function wake() { if (done) return; done = true; if (timer) clearTimeout(timer); resolve(); }
    function giveUp() { if (done) return; done = true; if (timer) clearTimeout(timer); reject(new Error(PY_ASSETS_WAIT_MSG)); }
    timer = setTimeout(giveUp, PY_ASSETS_WAIT_MS);
    PY_ASSETS_WAIT.push(wake);
  });
}
/* 放掉持有权并唤醒等待者(幂等;只有"当前持有者"调用才真正放掉) */
function pyAssetsRelease(holder) {
  if (holder && PY_ASSETS_TAKE && PY_ASSETS_TAKE !== holder) return;
  PY_ASSETS_TAKE = null;
  var w = PY_ASSETS_WAIT;
  PY_ASSETS_WAIT = [];
  for (var i = 0; i < w.length; i++) { try { w[i](); } catch (e) {} }
}
/* 取一份可独占(可 transfer)的载荷缓冲:已有消费者在用时排队等待,而不是共享同一批 ArrayBuffer */
function pyAssetsTake() {
  if (PY_ASSETS_ERR) return Promise.reject(new Error(PY_ASSETS_ERR));
  if (PY_ASSETS_TAKE) return pyAssetsWaitRelease().then(function () { return pyAssetsTake(); });
  var p = pyAssetsDecode().then(function (r) {
    if (!r || !r.ok) {
      PY_ASSETS_ERR = (r && r.reason) || "Python 载荷解析失败";
      pyAssetsRelease(p);
    }
    return r;
  }, function (e) {
    PY_ASSETS_ERR = wsMsg(e);
    pyAssetsRelease(p);
    throw e;
  });
  PY_ASSETS_TAKE = p;
  return p;
}

async function pyAssetsDecode() {
  var el = pyAssetsEl();
  if (!el) return { ok: false, reason: "页面里没有内嵌的 Python 载荷(构建时缺少 src/pyodide.part)" };
  var text = "";
  try { text = el.textContent || ""; } catch (e) { text = ""; }
  if (!text) return { ok: false, reason: "Python 载荷为空" };
  var p = 0, n = text.length;
  function nextLine() {
    var q = text.indexOf("\n", p);
    var s = text.slice(p, q < 0 ? n : q);
    p = (q < 0 ? n : q + 1);
    return s;
  }
  var head = nextLine();
  while (head === "" && p < n) head = nextLine();
  var hm = /^;;;PYODIDE-PART\s+(\d+)\s+(\d+)$/.exec(head);
  if (!hm) return { ok: false, reason: "载荷帧头不合法(第 1 行)" };
  var count = parseInt(hm[2], 10);
  if (!isFinite(count) || count <= 0) return { ok: false, reason: "载荷声明的段数为 0" };
  var metaLine = nextLine();
  var meta = null;
  try { meta = JSON.parse(metaLine.slice(";;;PYODIDE-META ".length)); } catch (e) { meta = null; }
  if (!meta || !meta.sections || !meta.sections.length) return { ok: false, reason: "载荷 META 不合法" };
  var core = { asmJs: "", pyodideJs: "", lockJson: "" };
  var bins = {}, wheelNames = [], i, sm, len, body, id, kind, sec;
  for (i = 0; i < count; i++) {
    sm = /^;;;PYODIDE-SECTION (\S+) (text|b64gz) (\d+)$/.exec(nextLine());
    if (!sm) return { ok: false, reason: "第 " + (i + 1) + " 段的段头不合法" };
    id = sm[1]; kind = sm[2]; len = parseInt(sm[3], 10);
    body = text.slice(p, p + len);
    if (body.length !== len) return { ok: false, reason: "段 " + id + " 的正文长度与帧头不符" };
    p += len;
    if (text.charAt(p) !== "\n") return { ok: false, reason: "段 " + id + " 的正文未按帧头长度对齐" };
    p += 1;
    if (kind === "text") {
      sec = pyUnescapeInline(body);
      if (id === "pyodide.asm.mjs") core.asmJs = sec;
      else if (id === "pyodide.js") core.pyodideJs = sec;
      else if (id === "pyodide-lock.min.json") core.lockJson = sec;
    } else {
      try {
        bins[id] = await pyDecodeGz(pyB64Decode(body));
      } catch (e) {
        return { ok: false, reason: "段 " + id + " 解码失败:" + wsMsg(e) };
      }
      if (/\.whl$/.test(id)) wheelNames.push(id);
    }
    if ((i & 15) === 15) await pyYield();      /* 别把主线程连续占死 */
  }
  if (!core.asmJs || !core.pyodideJs || !core.lockJson) {
    return { ok: false, reason: "载荷缺少核心段(asm / pyodide.js / 剪裁锁)" };
  }
  if (!bins["pyodide.asm.wasm"] || !bins["python_stdlib.zip"]) {
    return { ok: false, reason: "载荷缺少核心二进制段(asm.wasm / python_stdlib.zip)" };
  }
  return { ok: true, meta: meta, core: core, bins: bins, wheelNames: wheelNames, count: count };
}

/* ---- worker 源码(HEAD:影子桩 + 内存路由) ----
   整段字符串是**要在 worker 里执行的源码**,不是页面代码本身。 */
var PY_WORKER_HEAD = [
  "/* pyodide worker —— 由 appE 的 buildPyodideWorkerSrc() 拼装(影子桩 + 内存路由) */",
  "var __pyNet = false;",
  "var __pyBlobs = Object.create(null);        /* 文件名 → Uint8Array */",
  "var __pyMsg = \"Python 运行时已禁用网络(可在 设置 → MCP 工具 里打开「允许联网」)\";",
  "var __pyOrig = {",
  "  fetch: (typeof self.fetch === \"function\") ? self.fetch.bind(self) : null,",
  "  XMLHttpRequest: self.XMLHttpRequest,",
  "  WebSocket: self.WebSocket,",
  "  EventSource: self.EventSource,",
  "  indexedDB: self.indexedDB,",
  "  BroadcastChannel: self.BroadcastChannel,",
  "  SharedWorker: self.SharedWorker,",
  "  sendBeacon: (self.navigator && self.navigator.sendBeacon) ? self.navigator.sendBeacon.bind(self.navigator) : null",
  "};",
  "/* ① 影子化 importScripts —— pyodide 用「能不能 importScripts」判定 classic worker,",
  "   真 classic worker 会命中它的硬检查并直接 throw。",
  "   换成抛错函数后 isClassicWorker() 返回 false;而 typeof 探针仍是 \"function\"(与真 classic worker 同值)",
  "   (pyodide.asm.mjs 里 importScripts 2 处 + pyodide.js 里 2 处,均已核对) */",
  "try {",
  "  Object.defineProperty(self, \"importScripts\", {",
  "    value: function () { throw new Error(\"worker 内已禁用 importScripts(单文件离线运行)\"); },",
  "    writable: true, configurable: true",
  "  });",
  "} catch (e) {",
  "  try { self.importScripts = function () { throw new Error(\"worker 内已禁用 importScripts\"); }; } catch (e2) {}",
  "}",
  "function __pyBlock(name, value) {",
  "  try { Object.defineProperty(self, name, { value: value, writable: true, configurable: true }); }",
  "  catch (e) { try { self[name] = value; } catch (e2) {} }",
  "}",
  "function __pyStub() { throw new Error(__pyMsg); }",
  "/* 关网桩列表与 appE 的 __block 同强度(同等强度、非硬隔离):",
  "   RTCPeerConnection / WebTransport / CacheStorage.add() / 嵌套 new Worker() 等非常规出网通道不在其列 */",
  "function __pySetNet(on) {",
  "  __pyNet = !!on;",
  "  var i, names = [\"XMLHttpRequest\", \"WebSocket\", \"EventSource\", \"indexedDB\", \"BroadcastChannel\", \"SharedWorker\"];",
  "  for (i = 0; i < names.length; i++) __pyBlock(names[i], __pyNet ? __pyOrig[names[i]] : __pyStub);",
  "  try {",
  "    Object.defineProperty(self.navigator, \"sendBeacon\", { value: __pyNet ? __pyOrig.sendBeacon : __pyStub, configurable: true });",
  "  } catch (e) {}",
  "}",
  "/* ② self.fetch 内存路由:wasm / stdlib / *.whl 命中内存,未命中按本次 run 的 net 放行或 reject */",
  "function __pyMime(name) {",
  "  var s = String(name);",
  "  if (s.slice(-5) === \".wasm\") return \"application/wasm\";",
  "  if (s.slice(-5) === \".json\") return \"application/json\";",
  "  if (s.slice(-4) === \".zip\" || s.slice(-4) === \".whl\") return \"application/zip\";",
  "  if (s.slice(-4) === \".mjs\" || s.slice(-3) === \".js\") return \"text/javascript\";",
  "  return \"application/octet-stream\";",
  "}",
  "function __pyRouter(input, init) {",
  "  var url = \"\";",
  "  try { url = String(input && input.url ? input.url : input); } catch (e) { url = \"\"; }",
  "  var path = url, q = path.indexOf(\"?\"), h = path.indexOf(\"#\");",
  "  if (q >= 0) path = path.slice(0, q);",
  "  if (h >= 0) path = path.slice(0, h);",
  "  var name = path.slice(path.lastIndexOf(\"/\") + 1);",
  "  try { name = decodeURIComponent(name); } catch (e) {}",
  "  if (Object.prototype.hasOwnProperty.call(__pyBlobs, name)) {",
  "    return Promise.resolve(new Response(__pyBlobs[name], { status: 200, headers: { \"Content-Type\": __pyMime(name) } }));",
  "  }",
  "  if (__pyNet && __pyOrig.fetch) return __pyOrig.fetch(input, init);",
  "  return Promise.reject(new Error(__pyMsg + \"(请求:\" + url + \")\"));",
  "}",
  "self.fetch = __pyRouter;",
  ""
].join("\n");

/* ---- worker 源码(TAIL:会话胶水 —— loadPyodide + run + 差分) ---- */
var PY_WORKER_TAIL = [
  "/* ---- 会话胶水(init / run;code|script 双模式 + argv/cwd/stdin/exitCode/增量输出)---- */",
  "var __PY_INDEX_URL = \"https://pyodide.invalid/\";        /* 内存路由专用伪地址,永不出网 */",
  "var __PY_PKG_URL = \"https://pyodide.invalid/pkgs/\";",
  "var __PY_OUT_CAP = __PY_LIMITS.out;",       /* ① 环形缓冲/流 */
  "var __PY_MODEL_CAP = __PY_LIMITS.model;",   /* ② 回给模型/流 */
  "var __PY_MSG_MS = __PY_LIMITS.msgMs, __PY_MSG_BYTES = __PY_LIMITS.msgBytes;",   /* 增量 out 节流 */
  "var __PY_MOUNT = \"/workspace\";",
  "var __pyPy = null;",
  "var __pyOut = null;",
  "var __pyRunId = \"\";",
  "/* ---- 首用全量装载(唯一路径)的 worker 侧状态 ---- */",
  "var __PY_ALL_PKGS = [];        /* 本档全部包名:init 时从 a.lockJson(档位剪裁锁)解析 */",
  "var __pyLoadMs = 0;            /* 本次 run 的装载耗时(0 = 本次未装载) */",
  "var __pyLoadAtt = 0;           /* 本次 run 的装载尝试数(= 本次 pending 数) */",
  "var __pyLoadN = 0;             /* 本次 run 的装载成功数(不含失败项) */",
  "var __pyLoadFailed = [];       /* 本次 run 装载失败的包名(只报包名,不报原因) */",
  "var __pyLoadDegraded = false;  /* 本次 run 是否退回旧行为(锁清单不可读时的防御路径) */",
  "var __pyOutHold = false;       /* 装载期间拒收 stdout/stderr:装载自诊断不进脚本输出语义面 */",
  "var __pyPend = { stdout: \"\", stderr: \"\" };",
  "var __pyLastPost = { stdout: 0, stderr: 0 };",
  "var NL = String.fromCharCode(10);",
  "function __pyOutReset() {",
  "  __pyOut = { stdout: [], stderr: [], n: { stdout: 0, stderr: 0 }, dropped: { stdout: 0, stderr: 0 } };",
  "  __pyPend = { stdout: \"\", stderr: \"\" };",
  "  __pyLastPost = { stdout: 0, stderr: 0 };",
  "  /* TextDecoder({stream:true}) 的半个多字节序列会在 __pyDec 里跨 run 残留,",
  "     下一次 run 的第一段写会被拼成乱码(仅 buffer.write 的截断路径可达)。每次 run 开始重建解码器。 */",
  "  __pyDec = {};",
  "}",
  "function __pyTrim(stream) {",
  "  var o = __pyOut, joined = o[stream].join(\"\");",
  "  if (joined.length > __PY_OUT_CAP) {",
  "    o.dropped[stream] += joined.length - __PY_OUT_CAP;",
  "    o[stream] = [joined.slice(joined.length - __PY_OUT_CAP)];",
  "    o.n[stream] = __PY_OUT_CAP;",
  "  } else {",
  "    o[stream] = [joined];",
  "    o.n[stream] = joined.length;",
  "  }",
  "}",
  "/* 增量输出(out 消息):按行批量回调后累积 + 节流(≥200ms 或 ≥4KB)再 postMessage,",
  "   避免逐行发消息造成消息风暴 */",
  "function __pyPost(stream, force) {",
  "  var t = __pyPend[stream];",
  "  if (!t) return;",
  "  var now = Date.now();",
  "  if (!force && t.length < __PY_MSG_BYTES && (now - __pyLastPost[stream]) < __PY_MSG_MS) return;",
  "  __pyPend[stream] = \"\";",
  "  __pyLastPost[stream] = now;",
  "  try { self.postMessage({ t: \"out\", id: __pyRunId, stream: stream, text: t }); } catch (e) {}",
  "}",
  "function __pyPostAll() { __pyPost(\"stdout\", true); __pyPost(\"stderr\", true); }",
  "/* 输出写入器:走 setStdout/setStderr 的 write 接口(每次写都到我们手里,不经行缓冲)。",
  "   为什么不用 batched:它只把「到最后一个换行为止」的内容交出来,无换行的残段(sp.print(x, end=\"\"))",
  "   会滞留在 pyodide 的 JS 缓冲里 —— 既丢本次 run 的输出,又会在下一次 run 第一次写换行时吐出(错配)。",
  "   字节 → 文本用 TextDecoder({stream:true}) 处理被切开的多字节序列;没有 TextDecoder 时退化为逐字节。 */",
  "var __pyDec = {};",
  "/* 注意:pyodide 把**整个 options 对象**当作 writer 用(streams.ts 的 `setOps(opts as Writer)`),",
  "   所以这里要返回「写函数本身」,不能包成 `{write: fn}` */",
  "function __pyWriter(stream) {",
  "  return function (buf) {",
  "    var n = (buf && buf.length) ? buf.length : 0;",
  "    if (!n) return n;",
  "    var dec = __pyDec[stream], s = \"\", i;",
  "    if (dec === undefined) {",
  "      dec = null;",
  "      try { if (typeof TextDecoder === \"function\") dec = new TextDecoder(\"utf-8\"); } catch (e) { dec = null; }",
  "      __pyDec[stream] = dec;",
  "    }",
  "    try {",
  "      if (dec) s = dec.decode(buf, { stream: true });",
  "      else { for (i = 0; i < n; i++) s += String.fromCharCode(buf[i]); }",
  "    } catch (e) { s = \"\"; }",
  "    if (s) __pyPush(stream, s);",
  "    return n;",
  "  };",
  "}",
  "/* 仅用于 loadPyodide 的 init 期默认输出(第一次 run 起就被 __pyWriter 整体替换) */",
  "function __pyStdoutCb(s) { __pyPush(\"stdout\", String(s == null ? \"\" : s) + NL); }",
  "function __pyStderrCb(s) { __pyPush(\"stderr\", String(s == null ? \"\" : s) + NL); }",
  "function __pyPush(stream, text) {",
  "  if (__pyOutHold) return;    /* 装载期间:装载自诊断不进脚本输出 */",
  "  if (!__pyOut) __pyOutReset();",
  "  var s = String(text == null ? \"\" : text), o = __pyOut;",
  "  o[stream].push(s);",
  "  o.n[stream] += s.length;",
  "  if (o.n[stream] > __PY_OUT_CAP * 2) __pyTrim(stream);",
  "  __pyPend[stream] += s;",
  "  __pyPost(stream, false);",
  "}",
  "/* 三级截断的 ②:环形缓冲已是 64KB 的尾部 → 回模型只留末尾 8KB,并写明截断量。",
  "     返回 {text, cut, dropped}:cut = 本流是否发生截断或丢弃,主线程据此决定要不要加截断提示 */",
  "function __pyOutText(stream) {",
  "  __pyTrim(stream);",
  "  var o = __pyOut, t = o[stream].join(\"\"), note = \"\", cut = false;",
  "  if (o.dropped[stream] > 0) {",
  "    note = \"…(输出较大,已丢弃最早的 \" + Math.round(o.dropped[stream] / 1024) + \" KB)\";",
  "    cut = true;",
  "  }",
  "  if (t.length > __PY_MODEL_CAP) {",
  "    note += (note ? NL : \"\") + \"…(已截断 \" + Math.round((t.length - __PY_MODEL_CAP) / 1024) + \" KB;需要完整结果请让脚本写进 /workspace/ 下的文件后用 Read 回读)\";",
  "    t = t.slice(t.length - __PY_MODEL_CAP);",
  "    cut = true;",
  "  }",
  "  return { text: note ? note + NL + t : t, cut: cut, dropped: o.dropped[stream] };",
  "}",
  "function __pyErrText(e) {",
  "  if (!e) return \"未知错误\";",
  "  if (e.message) return String(e.message);",
  "  return String(e);",
  "}",
  "function __pyJspi() {",
  "  try { return typeof WebAssembly.promising === \"function\"; } catch (e) { return false; }",
  "}",
  "/* 生效的 JSPI 开关:以主线程探测值为准(worker 自己的探针在\"测试桩只删页面侧\"时会失真) */",
  "var __pyJspiFlag = false;",
  "/* 可读性增强:底层报错来自 pyodide/emscripten 原生层(我们桩函数的文案会被它们翻译成 errno),",
  "   这里只**追加**一句指向设置的提示,不改变原始错误 */",
  "function __pyHint(text) {",
  "  var t = String(text == null ? \"\" : text).toLowerCase();",
  "  if (!t) return \"\";",
  "  /* 判据只用网络专有 token —— 不要用宽泛的 errno 区间:emscripten 的 20–29 里混着",
  "     EEXIST=20 / EFBIG=22 / EMFILE=24 / EINVAL=28 / EIO=29 等**本地**错误(ENOENT=44),",
  "     纯本地错误被追加\"已禁用联网\"会误导模型;23 在本栈里对应 \"Host is unreachable\" */",
  "  if (!__pyNet && /host is unreachable|network is unreachable|enode?tunreach|urlerror|urlopen error|failed to fetch|networkerror|connection refused|errno 23\\b/.test(t)) {",
  "    return \"(当前已禁用工具联网:如需让 Python 联网,请在 设置 → MCP 工具 → 工具与权限 里打开「允许联网」)\";",
  "  }",
  "  if (!__pyJspiFlag && /cannot be called from a running event loop|no running event loop|stack switching/.test(t)) {",
  "    return \"(当前浏览器没有 JSPI,`asyncio.run` 等栈切换路径不可用;普通代码不受影响)\";",
  "  }",
  "  /* 相对导入与 `python -m` 明确不支持 → 给可读的替代做法(不给空实现) */",
  "  if (/attempted relative import|no known parent package|cannot be directly executed|cannot be run as a module/.test(t)) {",
