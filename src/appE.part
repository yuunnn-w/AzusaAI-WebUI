  var hit = wsProbeMagic(head512);
  var hint = hit ? hit.type : "";
  var res = {
    ok: true, kind: "binary", enc: "", type: hint, why: "",
    mime: String(mime || "") || (hit ? hit.mime : ""),
    sample: head.length + (tail ? tail.length : 0), lossyHint: false
  };
  /* 判据 1:magic。① 文本后缀不早退、② 弱签名只记名、③ 其余强签名 ∧ 非文本后缀 → 早退 */
  if (hit && !sufIsText && !hit.weak) { res.why = "magic"; return res; }
  /* 判据 2:二进制后缀早退(在 NUL 布局之前,防"UTF-16 假象把 .exe 判成文本";.svg 归文本侧) */
  if (wsProbeBinarySuffix(suf)) { res.why = "suffix"; res.type = hint || "未知二进制"; return res; }
  /* 判据 3:BOM(权威信号,不做二次校验) */
  if (head.length >= 2 && head[0] === 0xff && head[1] === 0xfe) return wsProbeAsText(res, "utf-16le", "bom");
  if (head.length >= 2 && head[0] === 0xfe && head[1] === 0xff) return wsProbeAsText(res, "utf-16be", "bom");
  if (head.length >= 3 && head[0] === 0xef && head[1] === 0xbb && head[2] === 0xbf) return wsProbeAsText(res, "utf-8", "bom");
  /* 判据 4a:无 BOM NUL 布局·方向(Kimi 纯奇偶性:一侧必须为 0,另一侧 ≥2) */
  var i, zo = 0, ze = 0, dir = "";
  for (i = 0; i < head512.length; i++) if (head512[i] === 0) { if (i % 2 === 1) zo++; else ze++; }
  if (ze === 0 && zo >= WS_UTF16_MIN_ZEROS) dir = "utf-16le";
  else if (zo === 0 && ze >= WS_UTF16_MIN_ZEROS) dir = "utf-16be";
  if (dir) {
    /* 4b:全样本(head 段)自洽(借用 Rust 的比值当校验,不借其方向映射) */
    var zoH = 0, zeH = 0;
    for (i = 0; i < head.length; i++) if (head[i] === 0) { if (i % 2 === 1) zoH++; else zeH++; }
    var dom = (dir === "utf-16le") ? zoH : zeH;
    var units = Math.floor(head.length / 2);
    if (Math.min(zoH, zeH) * 4 <= Math.max(zoH, zeH) && dom >= WS_UTF16_MIN_ZEROS &&
        dom >= Math.min(8, Math.floor(units / WS_UTF16_DENSITY_DIV))) {
      /* 4c:按方向对同一段严格解码无损 ∧ 控制字符比 ≤ 30% */
      var d4 = wsDecodeBytes(head, dir, true);
