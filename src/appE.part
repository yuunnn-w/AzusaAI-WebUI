  if (i >= 0) PY_POOL.splice(i, 1);
  PY_STATE.loadProg = null;     /* 终态:装载进度不残留 */
  var w = slot.w;
  slot.w = null; slot.phase = "idle"; slot.taskId = null;
  slot.paths = {}; slot.wsId = null; slot.loaded = {};
