/* ---- worker 源码拼装(buildPyodideWorkerSrc) ----
   顺序:影子桩/内存路由(HEAD) → asm 工厂 → pyodide.js → 会话胶水(TAIL)。
   两段上游代码各自包进 `(function () { "use strict"; … })()`:
   它们原本是 ESM(顶层恒为 strict),直接摊平成 classic 脚本会变成 sloppy 模式;
   包一层既保住 strict 语义,又让内部的顶层声明不污染 worker 全局。 */
/* ---- 执行包装器(Python 源码)----
   由主线程生成、经 JSON 内联进 worker 脚本(`__PY_WRAP`),不做手工转义 —— 用户代码/路径里的
   引号、反斜杠、非 BMP 字符一律走 pyodide 的 globals.set(JS 值 → Python 对象)。
   包装的目的:① SystemExit → exitCode 语义;② 未捕获异常也拿到 exitCode/首行类型;
   ③ 统一裁掉我们自己的栈帧,让 traceback 只留用户代码部分。
   用户代码仍然跑在 pyodide 的共享 globals 里(与 runPythonAsync 同语义,最后一行表达式照常返回)。 */
function pyWrapFor(mode) {
  /* 注:本函数里**不出现裸的 `名字(` 形态**(Python 内置一律写成 `_kimi_bi.名字(`、模块成员一律
     `模块.成员(`)——`scripts/lint.js` 的启发式会把源码里任何「标识符 + (」当函数调用,
     而这些 Python 源码是内嵌在 JS 字符串里的。全部写成成员访问形态既等价又不会误报。 */
  var head = [
    "import sys as _kimi_sys, os as _kimi_os, json as _kimi_json, traceback as _kimi_tb, builtins as _kimi_bi",
    "",
    "_kimi_st = {\"ok\": True, \"exit\": 0, \"err\": \"\", \"tb\": \"\", \"result\": \"\"}",
    "try:",
    "    _kimi_sys.argv = [_kimi_argv0] + _kimi_bi.list(_kimi_args)",
    "    _kimi_os.chdir(_kimi_cwd)",
    "    if _kimi_dir:",
    "        _kimi_sys.path.insert(0, _kimi_dir)"
  ];
  var hook;
  if (mode === "script") {
    /* 首选 runpy.run_path(唯一裁决);runpy 不可用时兜底 compile + exec */
    hook = [
      "    runpy = None",
      "    try:",
      "        import runpy",
      "    except Exception:",
      "        runpy = None",
      "    if runpy is not None:",
      "        runpy.run_path(_kimi_path, run_name=\"__main__\")",
      "    else:",
      "        _kimi_rd = _kimi_bi.open(_kimi_path, \"r\", encoding=\"utf-8\")",
      "        try:",
      "            _kimi_body = _kimi_rd.read()",
      "        finally:",
      "            _kimi_rd.close()",
      "        _kimi_bi.exec(_kimi_bi.compile(_kimi_body, _kimi_path, \"exec\"), {\"__name__\": \"__main__\", \"__file__\": _kimi_path, \"__builtins__\": _kimi_bi})"
    ];
  } else {
    hook = [
      "    _kimi_base = None",
      "    try:",
      "        import _pyodide._base as _kimi_base",
      "    except Exception as _kimi_ie:",
      "        _kimi_base = None",
      "        _kimi_sys.stderr.write(\"[执行器] 无法载入 eval_code_async,退化为普通 exec 方式(最后一行表达式的值不再返回):\" + _kimi_bi.str(_kimi_ie) + _kimi_bi.chr(10))",
      "    if _kimi_base is None:",
      "        _kimi_bi.exec(_kimi_bi.compile(_kimi_src, \"<exec>\", \"exec\"), _kimi_bi.globals())",
      "    else:",
      "        _kimi_st[\"result\"] = await _kimi_base.eval_code_async(_kimi_src, _kimi_bi.globals(), return_mode=\"last_expr\")"
    ];
  }
  var tail = [
    "except SystemExit as _kimi_e:",
    "    _kimi_c = _kimi_e.code",
    "    if _kimi_c is None:",
    "        _kimi_c = 0",
    "    if _kimi_bi.isinstance(_kimi_c, int):",
    "        _kimi_st[\"exit\"] = _kimi_bi.int(_kimi_c)",
    "    else:",
    "        _kimi_sys.stderr.write(_kimi_bi.str(_kimi_c) + _kimi_bi.chr(10))",
    "        _kimi_st[\"exit\"] = 1",
    "    _kimi_st[\"ok\"] = (_kimi_st[\"exit\"] == 0)",
    "    if not _kimi_st[\"ok\"]:",
    "        _kimi_st[\"err\"] = \"SystemExit: \" + _kimi_bi.str(_kimi_st[\"exit\"])",
    "        _kimi_st[\"tb\"] = _kimi_st[\"err\"]",
    "except BaseException as _kimi_e:",
    "    _kimi_st[\"ok\"] = False",
    "    _kimi_st[\"exit\"] = 1",
    "    _kimi_lines = _kimi_tb.format_exc().splitlines()",
    "    _kimi_keep = 1",
    "    while _kimi_keep < _kimi_bi.len(_kimi_lines):",
    "        _kimi_l = _kimi_lines[_kimi_keep]",
    "        if _kimi_l.lstrip().startswith(\"File \"):",
    "            _kimi_parts = _kimi_l.split(_kimi_bi.chr(34))",
    "            _kimi_f = _kimi_parts[1] if _kimi_bi.len(_kimi_parts) > 1 else \"\"",
    "            if _kimi_f == \"<kimi-run>\" or _kimi_f == \"<frozen runpy>\" or _kimi_f.endswith(\"_base.py\"):",
    "                _kimi_keep += 1",
    "                continue",
    "            break",
    "        _kimi_keep += 1",
    "    _kimi_st[\"tb\"] = _kimi_bi.chr(10).join(_kimi_lines[0:1] + _kimi_lines[_kimi_keep:])",
    "    _kimi_msg = _kimi_bi.str(_kimi_e)",
    "    if _kimi_bi.chr(10) in _kimi_msg:",
    "        _kimi_msg = _kimi_msg.split(_kimi_bi.chr(10))[0]",
    "    _kimi_st[\"err\"] = _kimi_bi.type(_kimi_e).__name__ + \": \" + _kimi_msg",
    "_kimi_json.dumps(_kimi_st)"
  ];
  return head.concat(hook, tail).join("\n");
