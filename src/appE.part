  if (u8[0] !== 31 || u8[1] !== 139 || u8[2] !== 8) throw new Error("不是 gzip 数据");
  var flg = u8[3], p = 10, n = u8.length;
  if (flg & 4) p += 2 + (u8[p] | (u8[p + 1] << 8));           /* FEXTRA */
  if (flg & 8) { while (p < n && u8[p] !== 0) p++; p++; }     /* FNAME */
  if (flg & 16) { while (p < n && u8[p] !== 0) p++; p++; }    /* FCOMMENT */
  if (flg & 2) p += 2;                                        /* FHCRC */
  var isize = (u8[n - 4] | (u8[n - 3] << 8) | (u8[n - 2] << 16) | (u8[n - 1] << 24)) >>> 0;
  if (!isize) throw new Error("gzip 尾部声明的原始长度无效");
  var out = new Uint8Array(isize);
  var got = pyTinyInflateRaw(u8.subarray(p, n - 8), out);
  if (!got || got.length !== isize) {
    throw new Error("解压长度不符(帧头声明 " + isize + ",实得 " + (got ? got.length : 0) + ")");
  }
