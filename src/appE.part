  return new Promise(function (resolve, reject) {
    var rs;
    try {
      rs = new Response(new Blob([u8])).body.pipeThrough(new DecompressionStream("gzip"));
    } catch (e) { reject(e); return; }
    new Response(rs).arrayBuffer().then(function (buf) {
      resolve(new Uint8Array(buf));
    }, reject);
  }).then(null, function (e) {
    if (!PY_INFLATE.js) throw e;
    PY_INFLATE.dsFailed = true;          /* 记一笔:说明这条链正在用 JS 兜底 */
    return pyGunzip(u8);
  });
}
