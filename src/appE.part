}
/* 销毁全部解释器(硬失败 / worker 崩溃时用) */
function pyKillWorker(reason) {
  var had = PY_POOL.length > 0, i;
  for (i = PY_POOL.length - 1; i >= 0; i--) pySlotKill(PY_POOL[i], reason);
