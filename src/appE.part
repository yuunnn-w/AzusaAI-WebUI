
/* ============================================================================
   22. MCP 工具框架(给「对话中的模型」调用)
   · 注册表:AGENT_TOOLS,字段与 MCP 的 tools/list 对齐(name / description / inputSchema)
   · 权限:总开关 + 每个工具三态(询问 / 允许 / 禁止),执行前可弹卡片让用户放行
   · 资源:轮次与次数上限、执行超时、输出与代码长度上限、沙箱联网开关
   · 沙箱:Web Worker 独立线程 + 无 DOM + 网络桩函数,死循环可被 terminate 硬杀
   · 审计:调用记录只留在内存里
   说明:页面不对外暴露任何接口(window / postMessage / BroadcastChannel / HTTP 都没有),
   只有设置页与页面自身的代码能配置它,只有对话里的模型能触发调用。
   ============================================================================ */
var TOOL_TURN = { used: 0 };
var TOOL_WAITS = {};
var TOOL_LOG = [];
var TOOL_LOG_MAX = 100;
/* 工具 run(args, ctx) 的统一签名里 ctx.signal 取「生成中请求的 abortCtrl.signal」;
   不在生成中的路径没有 abortCtrl,给一个永不 abort 的等价物,免得每个工具都要写
   `ctx && ctx.signal && ...` 的层层判空 */
var NO_ABORT_SIGNAL = {
  aborted: false,
  reason: undefined,
  addEventListener: function () {},
  removeEventListener: function () {},
  throwIfAborted: function () {}
};

function toolBeginTurn() { TOOL_TURN.used = 0; }
function toolTurnCount() { return TOOL_TURN.used; }
function toolLimit(key) {
  var l = state.settings.toolLimits || {};
  var d = { timeoutMs: 600000, maxCalls: 50, maxOut: 16384 };
  var v = Number(l[key]);
  return isFinite(v) && v > 0 ? v : d[key];
}
function toolSupported(t) { return !t || !t.cap || !!CAP[t.cap]; }
/* 工具权限:显式设置优先,否则用工具自己声明的 defaultPerm(默认 allow)。
   首行先做「旧名 → 现名」归一:改名前用户存的键(run_js)仍能查到现在的工具,
   否则模型拿旧名调用时权限会回落到 defaultPerm,把用户设的「禁止」绕过去 */
function toolPermOf(name) {
  name = toolCanonName(name);
  var p = state.settings.toolPerms ? state.settings.toolPerms[name] : null;
  if (p === "allow" || p === "deny" || p === "ask") return p;
  var t = findTool(name);
  return (t && t.defaultPerm) ? t.defaultPerm : "allow";
}
function setToolPerm(name, v) {
  if (!state.settings.toolPerms || typeof state.settings.toolPerms !== "object") state.settings.toolPerms = {};
  state.settings.toolPerms[name] = (v === "allow" || v === "deny") ? v : "ask";
  saveSoon();
}
/* ---- 外部 MCP 工具的开关粒度:全局默认 + 会话级覆盖 ----
   三级语义:`conv.extToolsEnabled === true/false` = 本会话覆盖;缺字段 = 跟随全局
   `settings.externalToolsEnabled`。覆盖值随会话持久化(IDB convs 区),所以 c 省略时按
   **当前会话**取 —— 与 conv.system 同一口径(请求体每轮现取当前会话);会话列表 / 连接自检
   这类旁路显示点把会话显式传进来,就不会读到别人的覆盖值 */
function extToolsOverride(c) {
  if (typeof c === "undefined") c = conv;
  if (!c) return null;
  if (c.extToolsEnabled === true) return true;
  if (c.extToolsEnabled === false) return false;
  return null;
}
/* 外部 MCP 工具的**生效态**(唯一判定出口):会话覆盖优先,否则全局总开关 */
function extToolsOn(c) {
  var o = extToolsOverride(c);
  return (o === null) ? !!state.settings.externalToolsEnabled : o;
}
/* 写会话级覆盖;v === null = 回到「跟随全局」(**删字段**,不是写 false ——
   写 false 就成了永久覆盖,之后全局开关再也影响不到这条会话) */
function setConvExtTools(v) {
  if (!conv) return false;
  if (v === null) delete conv.extToolsEnabled;
  else conv.extToolsEnabled = !!v;
  saveSoon();
  return true;
}
/* 可见性:总开关 → 外部工具另门(source)→ 工作区门(needsWorkspace)→ 权限三态 → 能力门。
   needsWorkspace 的工具(6 个文件工具)要求「当前会话已挂载工作区」且「工作区存储三区齐备」;
   两个判定都是同步的(wsMountedId 只读 conv.wsId,wsReady 只读一个布尔),不给启动链引入 async 前置 */
function activeTools(c) {
  var list = [];
  if (state.settings.toolsEnabled) {
    AGENT_TOOLS.forEach(function (t) {
      if (t.source === "external") return;   /* 外部工具走 extToolsOn(),见本函数末尾的接入点 */
      /* Python 工具族(ExecutePython + 任务类)的运行期就绪门 —— 唯一门:
         环境不支持时整套一起优雅隐藏;cap 不设、toolSupported 不改 */
      if (t.name in PY_TOOL_NAMES && !pyReady()) return;
      /* 工作区门按**传入的那条会话**判:请求体组装传发起会话时,文件工具的可见性
         必须跟着发起会话的挂载状态,不能偷看当前会话 */
      if (t.needsWorkspace && (!wsMountedId(c) || !wsReady())) return;
      if (toolPermOf(t.name) === "deny") return;
      if (!toolSupported(t)) return;
      list.push(t);
    });
  }
  if (extToolsOn(c)) list = list.concat(mcpActiveTools());
  return list;
}
function toolsEnabledNow() { return !!state.settings.toolsEnabled; }
/* 可见性派生的唯一出口:状态栏 / 环境面板 / 连接自检 / 命令面板四处共用。
   四处原先各自按 toolsEnabled 早退 → 以后「只开外部 MCP」时它们会全部显示「工具关闭」,
   与请求里实际带了工具自相矛盾;统一改从这里取,就不再各写一份口径 */
function mcpStatusInfo(c) {
  var internalOn = !!state.settings.toolsEnabled;
  var extOverride = extToolsOverride(c);              /* null = 跟随全局 */
  var externalOn = (extOverride === null) ? !!state.settings.externalToolsEnabled : extOverride;
  var act = activeTools(c);
  var internalActive = 0, externalActive = 0;
  act.forEach(function (t) {
    if (t.source === "external") externalActive++;
    else internalActive++;
  });
  var on = internalOn || externalOn;
  var text;
  if (!on) text = "已关闭";
  else if (externalOn) text = "已开启(内部 " + internalActive + " 个 / 外部 " + externalActive + " 个)";
  else text = "已开启(" + act.length + " 个)";
  if (extOverride !== null) text += " · 本会话覆盖为" + (extOverride ? "开" : "关");
  return {
    on: on, internalOn: internalOn, externalOn: externalOn, extOverride: extOverride,
    activeCount: act.length, totalCount: AGENT_TOOLS.length, text: text
  };
}

/* ---- 工具定义(与 MCP tools/list 同构) ---- */
/* 工作区路径口径的唯一权威句子(广播枢纽:6 个文件工具 + Python/JS 两个执行工具共用)。
   成本:随【工作区】块每轮进 system(≈90–110 汉字 ⇒ ≈100–130 token/请求,跨所有已挂载工作区的会话)。
   ★ 只在函数体内 / 数组字面量里引用(分段顺序 appA→…→appE,本常量在 appE 顶部求值) */
var WS_PATH_DUAL_NOTE =
  "路径口径:工作区工具(Read/Write/Edit/Glob/Grep/FileOps)用 / 开头的根路径(如 /a.png);Python 解释器里同一份数据挂载在 /workspace(如 /workspace/a.png)。";
/* 任务类工具 modelDesc 的公共尾段(「modelDesc 必含」的六个要点);写一次、四处引用
   (广播枢纽:改一处即四处同步)。必须在 AGENT_TOOLS 之前求值 —— 数组字面量里有 concat。 */
var PV_TASK_COMMON = [
  "- 后台任务**完成时会自动通知你**(页面空闲时会自动回到对话继续),所以**不要空转轮询** —— 只在确实需要进度时用 TaskOutput。",
  "- WaitFor 的**等超时不是错误**:它只表示「还在跑」,可以再等。",
  "- 停止(或超时)**就是销毁解释器**:变量、已导入的包、未回写的产物都会丢;下次执行要重新启动。",
  "- 解释器里**没有 pip / micropip**,装不了任何清单之外的包;可用的包用 PythonPackages 查。",
  "- script 模式与真实 python 同语义:`cwd` 决定相对路径基准(默认工作区根 `/`),`sys.argv = [容器内脚本绝对路径, ...args]`;容器内路径以 `/workspace/` 开头(工作区工具用 `/` 开头的根路径,两者指向同一份文件)。",
  "- `description` **必填**(缺失会被拒绝):请写明任务用途与预期产物。"
].join("\n");
var AGENT_TOOLS = [
  {
    name: "ExecuteJavaScript",
    title: "浏览器 JS 沙箱",
    scope: "read",
    icon: "terminal",
    cap: "worker",
    desc: "在页面的隔离沙箱里运行一段 JavaScript,把 return 的结果取回来。适合精确计算、数据转换、文本与日期处理、正则匹配等需要可靠结果的任务。沙箱是独立线程,没有 DOM、没有页面数据、默认也没有网络。",
    modelDesc: [
      "在当前浏览器的一个隔离沙箱(Web Worker 线程)里运行一段 JavaScript,并把结果返回给你。",
      "",
      "- 这是浏览器内的沙箱,不是宿主文件系统:它读不到用户电脑上的文件,也读不到工作区文件(沙箱里**没有** `/workspace` —— 那是 Python 解释器的挂载点);要读写文件请用工作区工具(Read / Write / Edit / Glob / Grep / FileOps)。",
      "- 用法:把要算的东西写进去,用 `return` 返回结果。例如:`const a = 12 * 34 + 5; return a;`。",
      "- 可用:ES 内置对象(Math、JSON、Date、RegExp、Array、Object、Map、Set、TypedArray、TextEncoder/TextDecoder 等)、Promise 与 async/await;`console.log` 的输出会一起返回。",
      "- 不可用:`document` / `window` / DOM / `localStorage`(沙箱里没有页面环境),以及 `fetch` / `XMLHttpRequest` / `WebSocket` / `importScripts`(默认禁用网络,调用会抛错)。",
      "- 限制:默认 5 秒超时,超时会被强制终止;返回内容有长度上限,超出时**保留末尾**并注明截断量;`console` 日志只保留**最后 120 条**,超出会注明丢弃条数。被截断时请收敛输出。",
      "- 当你需要精确计算、批量文本处理、日期运算、正则匹配、编码转换或验证一段逻辑时,请调用它,**不要凭记忆口算**。"
    ].join("\n"),
    defaultPerm: "allow",
    inputSchema: {
      type: "object",
      properties: {
        code: { type: "string", description: "要执行的 JavaScript 代码。用 return 返回结果,支持 await。" }
      },
      required: ["code"],
      additionalProperties: false
    },
    annotations: { readOnlyHint: true, destructiveHint: false, requiresNetwork: true },
    run: function (args) {
      var code = String((args && args.code) || "");
      code = code
        .split("```javascript").join("")
        .split("```js").join("")
        .split("```").join("");
      if (!code.trim()) return { ok: false, error: "code 为空", logs: [], ms: 0 };
      return runJsInSandbox(code, { timeoutMs: toolLimit("timeoutMs") });
    }
  },
  /* ---- 以下 6 个是「工作区(沙箱虚拟盘)」文件工具 ----
     只作用于本会话挂载的虚拟盘,不碰用户磁盘;路径一律经 wsNormPath 规范化。
     入参 / 默认权限按既定设计;描述首句统一写明边界(防止模型把它们当宿主文件系统)。 */
  {
    name: "Read",
    title: "读取工作区文件",
    scope: "read",
    icon: "file",
    desc: "只能访问本会话挂载的工作区(虚拟盘),不能访问你的磁盘。按行读取文本文件(可分行分页、可续读超长行);也支持图片与办公文档 / PDF(模型支持图像时直读,不支持时自动 OCR);其它二进制一律拒绝并报出类型。",
    modelDesc: [
      "只能访问本会话挂载的工作区(虚拟盘),不能访问你的磁盘。",
      WS_PATH_DUAL_NOTE,
      "",
      "- 读取工作区里的一个文本文件,按行返回;每行前缀是该文件里的行号(格式「行号[制表符]内容」)。",
      "- 能读什么:纯文本 / 图片(png·jpg·gif·webp·bmp·avif·ico)/ 办公文档(doc·docx·ppt·pptx·xls·xlsx)/ PDF。svg 按文本读(它的 XML 源码可读);tif/tiff 本机浏览器解不开,会提示你先转换。",
      "- 图片与文档按本机能力处理:模型支持图像输入时直接把图交给你;不支持时自动改用本机 OCR 只回文本 —— **你不需要做任何额外操作**。读一张图至少占约 1000 token(实测口径),请按需读取,不要反复读同一张。",
      "- 关键参数:`path` 必填(以 `/` 开头的绝对路径);`line_offset` 从第几行开始(1 起,负数 = 从文件末尾倒数);`n_lines` 省略 = 读到文件末尾;`max_chars` 默认 16000、上限 65536;`column_offset` 只在正向读使用(与负数 `line_offset` 同时给出会直接报错)。",
      "- 返回末尾有一行状态:`[total 总行数 · shown 显示范围 · eof 是否到末尾 · size 字节数 · mtime 修改时间]`(办公文档 / PDF 的状态行前面还有 file / 页数 / 图数 / 是否截断;OCR 的状态行以 OCR 开头并给出置信度,可能有个别识别误差);被截断时另有 `truncated`、`next_line_offset` 与(超长行场景)`next_column_offset`。",
      "- 只读文本文件:按 UTF-8 / UTF-16 LE·BE / GB18030 自动识别并转码显示,非 UTF-8 时状态行会注明实际编码。文件里只要含 NUL 字节都按二进制处理(采样窗之外的 NUL 也会被拒)。",
      "- 其它二进制(压缩包 / 可执行文件 / 音视频 / 字体 / 数据库等)一律拒绝:返回错误并说明它是什么类型,**不返回任何内容**,请不要重试。需要字节用 ExecutePython 以 \"rb\" 读取(例如 `open(\"/workspace/x.png\",\"rb\").read()`,容器内路径以 /workspace/ 开头);要取走文件用右栏「下载」或 FileOps;要里面的内容可以先用 ExecutePython 解包/转码、把结果写进工作区,再 Read 那些新文件。",
      "- 要改文件用 Edit(`old_string` 必须取自本工具输出去掉行号后的原文;纯 CRLF 文件请用 LF 书写;混合行尾时本工具把 \\r 显示成两个字符,`old_string` 里请写对应的真实回车);要看目录结构用 Glob;要按内容找位置用 Grep。"
    ].join("\n"),
    defaultPerm: "allow",
    inputSchema: {
      type: "object",
      properties: {
        path: { type: "string", description: "工作区里的绝对路径,以 / 开头,例如 /notes/a.md;支持文本 / 图片 / 办公文档 / PDF(目录请用 Glob)" },
        line_offset: { type: "integer", description: "起始行号(1 起);负数表示从文件末尾倒数(-1 = 最后一行)" },
        n_lines: { type: "integer", minimum: 1, description: "最多返回多少行;省略表示读到文件末尾" },
        max_chars: { type: "integer", minimum: 1, maximum: 65536, description: "本次返回的最大字符数(默认 16000,超过上限 65536 会被压到 65536)" },
        column_offset: { type: "integer", minimum: 0, description: "正向读时从首个返回行的第几个字符开始(默认 0,用于续读被截断的超长行);与负数 line_offset 同时给出会报错" }
      },
      required: ["path"],
      additionalProperties: false
    },
    annotations: { readOnlyHint: true, destructiveHint: false, requiresNetwork: false },
    needsWorkspace: true,
    wsPathArgs: ["path"],
    run: function (args, ctx) { return wsToolRun("Read", args, ctx, wsReadTool); }
  },
  {
    name: "Write",
    title: "写入工作区文件",
    scope: "write",
    icon: "file",
    desc: "只能访问本会话挂载的工作区(虚拟盘),不能访问你的磁盘。新建/覆盖/追加写文件,父目录自动创建,单次最多 1 MB。",
    modelDesc: [
      "只能访问本会话挂载的工作区(虚拟盘),不能访问你的磁盘。",
      WS_PATH_DUAL_NOTE,
      "",
      "- 把文本写进工作区文件;父目录不存在会自动创建(不用先建目录)。",
      "- 关键参数:`path`、`content` 必填;`mode` = `overwrite`(默认,整份覆盖)/ `append`(追加到文件末尾,不自动补换行)/ `create`(只新建,目标已存在报 `EEXIST`)。",
      "- 只写文本:不要用本工具创建二进制后缀的文件(如 `/a.zip`、`/a.exe`,会被拒绝);要产出二进制请用 ExecutePython(例如 `open(\"/workspace/x.bin\",\"wb\")` 写入)。",
      "- 限制:单次写入不超过 1 MB(`E2BIG`);文件总量不能超过工作区剩余配额(`ENOSPC`)。",
      "- 只改文件里的其中一段请用 Edit(不必重发全文);写完想确认内容请用 Read。"
    ].join("\n"),
    defaultPerm: "allow",
    inputSchema: {
      type: "object",
      properties: {
        path: { type: "string", description: "工作区里的绝对路径,以 / 开头" },
        content: { type: "string", description: "要写入的完整文本(单次 ≤1 MB)" },
        mode: { type: "string", enum: ["overwrite", "append", "create"], description: "写入方式(默认 overwrite)" }
      },
      required: ["path", "content"],
      additionalProperties: false
    },
    annotations: { readOnlyHint: false, destructiveHint: true, requiresNetwork: false },
    needsWorkspace: true,
    wsPathArgs: ["path"],
    run: function (args, ctx) { return wsToolRun("Write", args, ctx, wsWriteTool); }
  },
  {
    name: "Edit",
    title: "编辑工作区文件",
    scope: "write",
    icon: "file",
    desc: "只能访问本会话挂载的工作区(虚拟盘),不能访问你的磁盘。把文件里的一段原文精确替换成新内容(局部修改,不必重发全文);只接受 UTF-8 文本,非 UTF-8 请先转码。",
    modelDesc: [
      "只能访问本会话挂载的工作区(虚拟盘),不能访问你的磁盘。",
      WS_PATH_DUAL_NOTE,
      "",
      "- 把文件里出现的 `old_string` 精确替换成 `new_string`(局部修改,不必重发全文)。",
      "- 只接受 UTF-8 文本:文件是 GB18030 / UTF-16 / 含非法字节 / 含 NUL 字节(含采样窗之外的 NUL)时会被拒绝 —— 非 UTF-8 的会提示先转码为 UTF-8(Read 只读不写,不受此限)。",
      "- `old_string` 必须取自 Read 工具输出的「去行号」原文(把行号前缀去掉后原样复制,含缩进与换行),否则会匹配不到。",
      "- 行尾:纯 CRLF 文件里 Read 显示的是 LF 视图,`old_string` 直接用 LF 书写,本工具写回时保持 CRLF;混合行尾时 Read 把 `\\r` 显示成两个字符,`old_string` 里请写对应的真实回车;本工具不做行尾转换。",
      "- `old_string` 与 `new_string` 完全相同会被拒绝(没有要做的修改)。",
      "- `replace_all=false` 时 `old_string` 必须唯一:多处匹配报 `EAMBIG`(请给出更多上下文,或改用 `replace_all:true`);一处都没匹配到报 `ENOTFOUND`。",
      "- 限制:可编辑文件不超过 2 MB(超出请改用 ExecutePython);替换后文件不超过 1 MB。写入在同一事务内完成(原子的读改写),不会与其它写入互相覆盖。"
    ].join("\n"),
    defaultPerm: "allow",
    inputSchema: {
      type: "object",
      properties: {
        path: { type: "string", description: "工作区里的绝对路径,以 / 开头" },
        old_string: { type: "string", minLength: 1, description: "要被替换的原文(取自 Read 输出去掉行号后的文本)" },
        new_string: { type: "string", description: "替换成的新文本;空串表示删除 old_string" },
        replace_all: { type: "boolean", description: "是否替换全部命中(默认 false,只允许唯一命中)" }
      },
      required: ["path", "old_string", "new_string"],
      additionalProperties: false
    },
    annotations: { readOnlyHint: false, destructiveHint: true, requiresNetwork: false },
    needsWorkspace: true,
    wsPathArgs: ["path"],
    run: function (args, ctx) { return wsToolRun("Edit", args, ctx, wsEditTool); }
  },
  {
    name: "Glob",
    title: "列出工作区文件",
    scope: "read",
    icon: "folder",
    desc: "只能访问本会话挂载的工作区(虚拟盘),不能访问你的磁盘。按名字模式列出工作区里的文件与目录(目录也会列出)。",
    modelDesc: [
      "只能访问本会话挂载的工作区(虚拟盘),不能访问你的磁盘。",
      WS_PATH_DUAL_NOTE,
      "",
      "- 按名字模式列出工作区里的文件与目录;目录也会作为条目返回(`type=dir`),可以逐层浏览目录结构。",
      "- 关键参数:`pattern` 支持 `*`(单层任意字符)、`?`(单层任意一个字符)、`**`(任意层)、`{a,b}`,空串 = 全部;`path` 默认 `/`;`depth` 1..8、默认 1;`head_limit` 默认 100、上限 500(旧名 `limit` 仍可用);`offset` 翻页;`sort` = `name`|`modified`|`size`(目录恒排在前面)。",
      "- 返回里带 `shown` / `total` / `next_offset`;`next_offset` 非空时用 `offset` 继续翻页。",
      "- 要按文件内容检索请用 Grep;要读某个文件的原文请用 Read。"
    ].join("\n"),
    defaultPerm: "allow",
    inputSchema: {
      type: "object",
      properties: {
        pattern: { type: "string", description: "名字模式(* ? ** {a,b});空串=全部" },
        path: { type: "string", description: "从哪个目录开始列出(默认 /)" },
        depth: { type: "integer", minimum: 1, maximum: 8, description: "递归层数(默认 1)" },
        head_limit: { type: "integer", minimum: 1, maximum: 500, description: "最多返回多少条(默认 100);与 limit 同时给出时以本参数为准" },
        limit: { type: "integer", minimum: 1, maximum: 500, description: "旧名:等价于 `head_limit`(保留兼容);两者同时给出时以 `head_limit` 为准" },
        offset: { type: "integer", minimum: 0, description: "翻页偏移(默认 0)" },
        sort: { type: "string", enum: ["name", "modified", "size"], description: "排序方式(默认 name)" }
      },
      required: [],
      additionalProperties: false
    },
    annotations: { readOnlyHint: true, destructiveHint: false, requiresNetwork: false },
    needsWorkspace: true,
    wsPathArgs: ["path"],
    run: function (args, ctx) { return wsToolRun("Glob", args, ctx, wsGlobTool); }
  },
  {
    name: "Grep",
    title: "检索工作区内容",
    scope: "read",
    icon: "search",
    desc: "只能访问本会话挂载的工作区(虚拟盘),不能访问你的磁盘。在工作区文件内容里做正则检索,输出命中文件/命中行/命中数三种形态。",
    modelDesc: [
      "只能访问本会话挂载的工作区(虚拟盘),不能访问你的磁盘。",
      WS_PATH_DUAL_NOTE,
      "",
      "- 在工作区文件的内容里做正则检索,默认只返回命中的文件列表。",
      "- 关键参数:`pattern` 必填;`path` 默认 `/`,可以是目录也可以是单个文件;`glob` 只检索名字匹配的文件;`case_insensitive`;`context_lines` 0..5、默认 0;`multiline` 默认 false(逐行匹配);`output_mode` = `files_with_matches`(默认)/ `content`(命中行)/ `count_matches`(每文件命中数);`head_limit` 默认 100;`offset` 翻页。",
      "- 文本按 Read 的同一套探针识别编码(UTF-8 / UTF-16 LE·BE / GB18030 都能检索);二进制与超大文件会跳过,摘要里分别计数。",
      "- 限制:单次最多扫 500 个文件 / 32 MB / 5 秒,超过会返回 `truncated` 并提示收敛 `pattern` 或指定更小的 `path`。",
      "- 要按文件名找文件请用 Glob;要读某个文件请用 Read。"
    ].join("\n"),
    defaultPerm: "allow",
    inputSchema: {
      type: "object",
      properties: {
        pattern: { type: "string", description: "正则表达式(必填)" },
        path: { type: "string", description: "从哪个目录或哪个文件开始检索(默认 /)" },
        glob: { type: "string", description: "只检索名字匹配该模式的文件(可选)" },
        case_insensitive: { type: "boolean", description: "忽略大小写(默认 false)" },
        context_lines: { type: "integer", minimum: 0, maximum: 5, description: "命中行的上下文行数(默认 0)" },
        multiline: { type: "boolean", description: "允许正则跨行匹配(默认 false)" },
        output_mode: { type: "string", enum: ["files_with_matches", "content", "count_matches"], description: "输出形态(默认 files_with_matches)" },
        head_limit: { type: "integer", minimum: 1, description: "最多返回多少条(默认 100)" },
        offset: { type: "integer", minimum: 0, description: "翻页偏移(默认 0)" }
      },
      required: ["pattern"],
      additionalProperties: false
    },
    annotations: { readOnlyHint: true, destructiveHint: false, requiresNetwork: false },
    needsWorkspace: true,
    wsPathArgs: ["path"],
    run: function (args, ctx) { return wsToolRun("Grep", args, ctx, wsGrepTool); }
  },
  {
    name: "FileOps",
    title: "管理工作区文件",
    scope: "write",
    icon: "folder",
    desc: "只能访问本会话挂载的工作区(虚拟盘),不能访问你的磁盘。移动/复制/删除/新建目录,删目录默认需要 recursive。",
    modelDesc: [
      "只能访问本会话挂载的工作区(虚拟盘),不能访问你的磁盘。",
      WS_PATH_DUAL_NOTE,
      "",
      "- 用 `action` 指定操作:`move`(移动/改名)、`copy`(复制文件或整目录)、`delete`(删除文件或目录)、`mkdir`(新建目录)。",
      "- 关键参数:`action`、`source` 必填;`target` 在 `move`/`copy` 必填,必须是**完整目标路径**(要把文件放进已存在的目录请写全,例如 `/docs/a.md`);`overwrite` 默认 false;`recursive` 默认 false。",
      "- 语义:`move` 默认不覆盖已存在的目标(要覆盖请传 `overwrite:true`),目录与文件不能互相覆盖(报 `EINVAL`);`copy` 复制目录需要 `recursive:true`;`delete` 删非空目录必须传 `recursive:true`(否则报 `ENOTEMPTY`);`mkdir` 在 `recursive:true` 时幂等(已存在返回 `created:false`),`recursive:false` 且父目录不存在报 `ENOENT`。",
      "- 限制:单次调用最多影响 1000 个文件(超出请分批);删除目录是同一事务内的级联删除,不会留下「目录树里没了、文件还在」。",
      "- 要写/改文件内容请用 Write 与 Edit;本工具只管文件与目录本身。"
    ].join("\n"),
    defaultPerm: "allow",
    inputSchema: {
      type: "object",
      properties: {
        action: { type: "string", enum: ["move", "copy", "delete", "mkdir"], description: "要执行的操作" },
        source: { type: "string", description: "源路径(所有 action 必填)" },
        target: { type: "string", description: "目标路径(move / copy 必填)" },
        overwrite: { type: "boolean", description: "目标已存在时是否覆盖(默认 false)" },
        recursive: { type: "boolean", description: "目录操作是否递归(默认 false)" }
      },
      required: ["action", "source"],
      additionalProperties: false
    },
    annotations: { readOnlyHint: false, destructiveHint: true, requiresNetwork: false },
    needsWorkspace: true,
    wsPathArgs: ["source", "target"],
    /* 这个工具自己的两个子开关:关掉后对应操作直接拒绝(渲染在它这一行的权限下方) */
    options: [
      {
        key: "del",
        label: "允许删除",
        title: "关闭后 FileOps 的 delete 操作一律拒绝",
        get: function () { return state.settings.toolOpsAllowDelete !== false; },
        set: function (v) { state.settings.toolOpsAllowDelete = !!v; }
      },
      {
        key: "ovw",
        label: "允许覆盖",
        title: "关闭后 FileOps 遇到已存在的目标一律报 EEXIST",
        get: function () { return state.settings.toolOpsAllowOverwrite !== false; },
        set: function (v) { state.settings.toolOpsAllowOverwrite = !!v; }
      }
    ],
    run: function (args, ctx) { return wsToolRun("FileOps", args, ctx, wsFileOpsTool); }
  },
  /* ---- Python 解释器(pyodide 314.0.6 / CPython 3.14.2,内嵌在页面里) ----
     不设 cap:cap 是"静态能力表"查询(toolSupported 会变成恒真),运行期就绪由
     activeTools() 里的 pyReady() 门控;不设 needsWorkspace:未挂载工作区也能跑,
     只是看不到文件(与 6 个文件工具的区别就在这里) */
  {
    name: "ExecutePython",
    title: "Python 解释器",
    scope: "write",
    icon: "terminal",
    desc: "在页面内置的 Python 解释器(pyodide / CPython 3.14.2)里运行代码或工作区里的 .py 脚本,把输出、退出码与结果取回来。适合数据处理、科学计算、文本与表格处理等需要可靠结果的任务。解释器跑在独立线程里,没有页面数据;只能访问本会话挂载的工作区(虚拟盘)。",
    /* 档位口径与「探索指引」随档:modelDesc 存**函数**(与 PythonPackages 同款机制,下发前经
       toolModelDesc 求值)—— 档位名 / 预置包数来自载荷元数据段,写死会在轻档撒谎;
       探索指引(读源码 / 枚举已装包 / 截断对策)与真机实测一致
       (真机实测:源码可读、大对象只回尾部、200 行/片全见;
       文案仅陈述实测成立的做法) */
    modelDesc: function () {
      var prof = pyProfileInfo();
      return [
        "在页面内置的 Python 解释器(Pyodide,CPython 3.14.2)里执行代码或工作区里的 .py 脚本,把 stdout / stderr、退出码与(代码模式)最后一行表达式的值返回给你。",
        WS_PATH_DUAL_NOTE + "容器内 cwd 默认 /workspace,script 与 args 的路径同样按容器口径。",
        "",
        "**两种用法(二选一)**",
        "- `code` = 内联代码(等价 `python -c \"...\"`);`script` = 工作区里的 .py 路径(等价 `python /lib/x.py`,必须以 .py 结尾)。两个都填或都不填会被拒绝。",
        "- script 模式与真实 python 同语义:`cwd` 决定相对路径基准(默认工作区根 `/`),`sys.argv = [容器内脚本绝对路径, ...args]`,`__name__ = \"__main__\"`,`__file__` = 容器内绝对路径;脚本所在目录会加入 `sys.path`(同目录的 .py 会被一并装载,可 import)。注意 `sys.argv[0]` / `__file__` 是容器内路径(`/workspace/...`)。",
        "- 不支持相对导入(`from . import x`)与 `python -m`;要复用同目录的代码请直接 import 模块名。",
        "",
        "**环境与探索**",
        "- 没有 pip / micropip,不能安装任何包:只能用页面预先内置的包(本档 = " + pyProfileZh(prof) + " · 预置包 " + prof.packages + " 个;用 PythonPackages 查清单)。预置包**直接 import 即可** —— 本档全部预置包会在**首次执行前自动装载到位**(无需声明任何参数;装载时间不计入脚本超时);用不了的库请换等价写法;本档被裁掉的包在 import 失败时会附一句换档提示。",
        "- 想确认某个包/对象怎么用,可像真实 Python 一样读它的源码(两模式都可):import 后取模块 `__file__` 用 `open()` 读,或 `inspect.getsource(模块/类/函数)`(只有裸名 `__file__` 需要 script 模式);纯 .py(含 zip 里的标准库)能读出来,扩展模块(.so)会报 `source code not available`,属正常。`help(对象)` 也可用:小对象完整,大对象只回尾部 8KB。",
        "- 想枚举环境里的包:`importlib.metadata.distributions()`(已安装清单,含版本)、`importlib.metadata.version(\"名\")`、`pkgutil.iter_modules()` —— 看的是「已安装/已装载」视角;本档的预置全集(含还没 import 的)用 PythonPackages 查。",
        "",
        "**边界**",
        "- 只能访问本会话挂载的工作区(虚拟盘,根目录 `/`),看不到你的磁盘,也不能执行宿主程序;读写工作区文件用 Read / Write / Edit / Glob / Grep / FileOps。",
        "- 需要二进制文件(图片/压缩包/办公文档等)的字节时,直接用 `open(\"/workspace/...\",\"rb\").read()` 读取并处理;这类文件不要用 Read(Read 只读文本,二进制会被拒)。",
        "- 当前浏览器没有 JSPI 时,`asyncio.run` / `loop.run_until_complete` 这类栈切换路径不可用(普通同步代码不受影响,可用 asyncio 的其它写法)。",
        "- 关网时(设置 → MCP 工具 里关闭「允许联网」)Python 侧的网络调用会失败并给出提示;开网时的请求也受浏览器 CORS 约束。",
        "",
        "**输出与截断**",
        "- `description` 必填:写明这次执行的任务用途与预期产物(缺失或空串会被拒绝)。",
        "- 输出过大时**保留末尾**并注明截断量(stdout/stderr 各 8KB;整体再按结果长度上限裁尾部 —— 档位提示/工作区回写/并发冲突等短注记不受影响)。需要完整内容时,让脚本把结果写进工作区文件(如 `/workspace/out.txt`)再用 Read 回读,或按 ≤200 行分片 print(单片约 5KB、总量 ≤8KB 才能完整看到)。",
        "",
        "**后台任务**",
        "- 长任务请用 `run_in_background=true`:立刻返回 `task_id`,执行在后台继续跑;完成时**会自动通知你**(空闲时自动回到对话),所以**不要反复轮询**。要看进度用 TaskOutput(task_id),要阻塞等它结束用 WaitFor(timeout_ms ≤60000,等超时**不是错误**),要停它用 TaskStop;后台任务有独立的超时上限(设置里可配,默认 30 分钟)。",
        "- 停止生成或超时都会直接销毁解释器:变量与导入全部丢失,下次执行要重新启动(约几秒);已经写进工作区的产物不受影响。",
        "- TaskStop 与超时一样是直接销毁解释器:① 变量与已导入的包全丢;② 下次执行要重新启动并重装包;③ 未回写的产物丢失。停止生成(Ctrl+Alt+Esc)只中止前台执行,**不会**杀后台任务(除非在设置里打开「停止生成时也终止后台任务」);同时最多 2 个未完成任务,第 3 个会被拒绝(`EBUSY`),请先 TaskStop 或用 WaitFor。",
        "- 任务只活在当前页面:刷新或关闭页面后任务与记录**全部消失**(没有失联历史);长任务请让脚本把中间结果写进工作区文件。"
      ].join("\n");
    },
    defaultPerm: "allow",
    inputSchema: {
      type: "object",
      properties: {
        code: { type: "string", description: "内联 Python 代码(可多行)。与 script 二选一。想看结果请用 print(...)。" },
        script: { type: "string", description: "工作区里的 .py 路径,如 /lib/run.py(等价 python /lib/run.py)。与 code 二选一。" },
        args: { type: "array", items: { type: "string" }, description: "命令行参数,写入 sys.argv[1:]。script 模式最常用。" },
        stdin: { type: "string", description: "喂给 sys.stdin 的文本(≤64KB);不传则 stdin 立即为 EOF(不会挂起等待输入)。" },
        cwd: { type: "string", description: "相对路径的基准目录(工作区路径,默认 /=工作区根)。影响 open(\"x\") 的解析结果。" },
        files: { type: "array", items: { type: "string" }, description: "额外强制预载的工作区文件或 glob;缺省按会话预载规则(≤16MB,最近修改优先)。" },
        timeout_ms: { type: "number", description: "本次执行上限(毫秒,默认取设置里的工具超时);首次执行的预置包装载时间不计入。" },
        run_in_background: { type: "boolean", description: "true = 立刻返回 task_id 并在后台继续跑(long-running),完成后会自动通知你;缺省(或 false)= 阻塞到执行结束再返回完整结果。" },
        description: { type: "string", description: "任务描述(必填):这次执行要做什么、预期产物是什么。" }
      },
      required: ["description"],
      additionalProperties: false
    },
    annotations: { readOnlyHint: false, destructiveHint: true, requiresNetwork: true },
    run: function (args, ctx) { return pyToolRun(args, ctx); }
  },
  /* ---- 预置包清单(只读)----
     三段数据源:① 已加载 = worker 回报的 loadedPackages
                 ② 已预置未加载 = 载荷里那份剪裁锁的 packages
                 ③ 不可用 = 构建期剔除项的小常量表
     不设 needsWorkspace:没挂载工作区也能查;scope 只读、默认 allow */
  {
    name: "PythonPackages",
    title: "Python 预置包",
    scope: "read",
    icon: "terminal",
    desc: "查 Python 解释器里能用的包:已经加载了哪些、预置了哪些还没加载、哪些不可用或本档未内置(附原因)。不需要工作区。",
    /* 档位口径必须随档(包数由载荷决定):这里存**函数**,下发时求值(见 toolModelDesc)——
       写死 151/99/33 会在名单被上游改动之后撒谎 */
    modelDesc: function () {
      var prof = pyProfileInfo();
      return [
        "查询页面内置 Python 解释器的包清单,分三段返回:",
        "- ① 已加载:本次会话已经 import 过/显式加载过的包,带版本。",
        "- ② 已预置未加载:随页面一起内置、import 即用。发行名与 import 名不同的项会附「(import: bs4)」式提示;`query` 对**发行名与 import 名**都能匹配(大小写不敏感,例:`query=\"bs4\"` 命中 beautifulsoup4)。",
        "- ③ 不可用:已知在浏览器内跑不起来的包,以及本档未内置的包(附分组原因)。",
        "",
        "- 预置包数量随「档位」变化(本档 = " + pyProfileZh(prof) + " · 预置包 " + prof.packages + " 个 wheel),**同一份代码在不同档位下能用的包不同** —— ③ 段给出的就是本档真实口径;要某个本档没有的包,只能换完整版产物。",
        "- 没有 pip / micropip,不能安装任何清单之外的包;预置包直接 import 即可(执行前会自动装载,无需任何参数)。",
        "- `query` 可选:按发行名或 import 名做子串过滤,用于在长清单里定位(例:`query=\"pdf\"`、`query=\"bs4\"`)。② 段**默认一次给全**(三档都能一次列完);清单极长时按 `offset`/`limit` 分页(`offset` 相对 **query 过滤后**的集合,`limit` 上限 " + PY_PKG_LIMIT_MAX + "),尾部会给出下一页的 `offset`。①②③ 三段共用一次调用的长度预算,超预算时按整行裁剪并在段尾注明。"
      ].join("\n");
    },
    defaultPerm: "allow",
    inputSchema: {
      type: "object",
      properties: {
        query: { type: "string", description: "可选的过滤词:按发行名或 import 名做子串匹配(大小写不敏感;如 bs4 可查到 beautifulsoup4)。" },
        offset: { type: "integer", minimum: 0, description: "分页起点(相对 query 过滤后的集合,默认 0);② 段一次列不完时用尾部给出的下一页 offset。" },
        limit: { type: "integer", minimum: 1, maximum: 300, description: "本次最多列多少条(默认 0 = 按长度预算给全)。" }
      },
      required: [],
      additionalProperties: false
    },
    annotations: { readOnlyHint: true, destructiveHint: false, requiresNetwork: false },
    run: function (args, ctx) { return pyPackagesTool(args, ctx); }
  },
  /* ---- Python 任务类(5 个;全部 cap 不设、defaultPerm 全 allow) ----
     可见性走 PY_TOOL_NAMES(与 ExecutePython 同一道运行期门)。
     modelDesc 的公共尾段 PV_TASK_COMMON 六个要点是"必含项",写一次、四处引用
     (广播枢纽:改一处即四处同步) */
  {
    name: "TaskList",
    title: "任务列表",
    scope: "read",
    icon: "activity",
    desc: "列出本会话里由 Python 解释器跑过的任务(前台 + 后台):task_id、状态、描述、已用时。只列表,不含输出。",
    modelDesc: [
