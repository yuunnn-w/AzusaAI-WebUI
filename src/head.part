<title>AzusaAI WebUI · 单文件对话终端</title>
<script>
/* ============================================================
   环境自检(ES5 语法,必须在任何现代语法代码之前运行)
   目的:旧浏览器上不再白屏,而是给出明确、可读的提示
   —— 检测失败时给 <html> 加 legacy 类,CSS 负责切换显示
============================================================ */
(function (w, d) {
  var missing = [], soft = [];
  function has(name, ok) { if (!ok) missing.push(name); }
  has("Promise", typeof w.Promise === "function");
  has("fetch", typeof w.fetch === "function");
  has("JSON", typeof w.JSON === "object" && typeof w.JSON.parse === "function");
  has("DOM 查询 (querySelector)", !!d.querySelector && !!d.documentElement.classList);
  has("Object.assign", typeof Object.assign === "function");
  var a = [];
  has("Array.prototype.find", typeof a.find === "function");
  has("Array.prototype.findIndex", typeof a.findIndex === "function");
  has("Array.prototype.includes", typeof a.includes === "function");
  has("String.prototype.includes", typeof String.prototype.includes === "function");
  // 软依赖:缺失只降级,不阻断
  if (typeof w.AbortController !== "function") soft.push("AbortController(无法中途停止生成)");
  if (typeof w.TextDecoder !== "function") soft.push("TextDecoder(自动降级为非流式输出)");
  if (typeof w.ReadableStream !== "function") soft.push("ReadableStream(自动降级为非流式输出)");
  if (!(w.navigator && w.navigator.clipboard)) soft.push("剪贴板 API(自动降级为旧式复制)");
  if (typeof w.BroadcastChannel !== "function") soft.push("BroadcastChannel(MCP 跨标签页传输关闭)");
  if (!(w.speechSynthesis && typeof w.speechSynthesis.speak === "function")) soft.push("语音合成(朗读功能关闭)");
  if (!(w.SpeechRecognition || w.webkitSpeechRecognition)) soft.push("语音识别(语音输入关闭)");
  if (!(w.matchMedia && w.matchMedia("(prefers-color-scheme: light)").matches !== undefined)) soft.push("matchMedia(跟随系统主题不可用)");
  // flex gap 支持检测(缺失时用外边距兜底)
  var noFlexGap = false;
  try {
    var probe = d.createElement("div");
    probe.style.cssText = "display:flex;gap:1px";
    noFlexGap = !(probe.style.gap || probe.style.rowGap);
  } catch (e) { noFlexGap = true; }
  w.__ENV__ = { critical: missing, soft: soft, noFlexGap: noFlexGap, ok: missing.length === 0 };
  if (missing.length) {
    d.documentElement.className += " legacy";
  } else if (noFlexGap) {
    d.documentElement.className += " no-flexgap";
  }
})(window, document);
</script>
<style>
/* ============================================================================
   1. 设计令牌
   ============================================================================ */
:root {
  --font-ui: "Segoe UI", -apple-system, BlinkMacSystemFont, "PingFang SC", "Hiragino Sans GB",
             "Microsoft YaHei", "Noto Sans CJK SC", Roboto, Helvetica, Arial, sans-serif;
  --font-mono: "Cascadia Code", "JetBrains Mono", Consolas, "SF Mono", Menlo, "DejaVu Sans Mono", monospace;
  --r-xs: 6px;  --r-sm: 9px;  --r-md: 13px;  --r-lg: 18px;  --r-xl: 24px;
  --sidebar-w: 278px;
  --topbar-h: 58px;
  --status-h: 28px;
  --content-w: 900px;
  --ease: cubic-bezier(.22,.61,.36,1);
  --fs: 14.5px;
  --code-lines: 10;   /* 代码块在气泡内最多显示多少行,超出后块内滚动 */
  --think-lines: 10;  /* 思考过程最多显示多少行,超出后自身滚动 */
  /* 密度令牌:默认值 = 上面各处的原字面量(逐像素不变),紧凑模式统一覆盖(见第 14 节末) */
  --d-msg-y: 17px;    /* .msg 上下内边距 */
  --d-msg-gap: 14px;  /* .msg 头像与正文的间距 */
  --d-avatar: 32px;   /* .avatar 边长 */
  --d-chat-t: 20px;   /* #chat-inner 上内边距 */
  --d-chat-x: 22px;   /* #chat-inner 左右内边距 */
  --d-chat-b: 30px;   /* #chat-inner 下内边距 */
  --d-block: .58em;   /* .msg-content p 上下外边距 */
  --d-li: .26em;      /* .msg-content li 上下外边距 */
  --d-conv-y: 9px;    /* .conv-item 上下内边距 */
  --d-input-y: 6px;   /* #input-area 上内边距 */
  /* 小字号文本压在"accent 实色底"上时用的底色(左栏「新建对话」、.btn.primary 主按钮):
     正文门槛是 4.5:1,深色主题的浅 accent + 深 ink 本来就够(10.4–12.7);浅色主题的 accent
     偏亮,白字只有 3.05–4.09 ⇒ 那 12 个浅色预设里各自指定加深过的 --accent-fill 系列 */
  --accent-fill: var(--accent);
  --accent-fill-2: var(--accent-2);
}
/* ---- 主题色预设(马卡龙色系,data-accent 切换;深浅色各一套以保证对比度) ----
   除 --accent* 外,背景极光、网格线与各类强调底色都会由 --accent-rgb 派生,
   因此换色时整页配色一起变化。                                             */
html[data-accent="mint"]     { --accent:#8ee6c2; --accent-2:#b6f2da; --accent-rgb:142,230,194; --accent-ink:#062b1e; }
html[data-accent="sakura"]   { --accent:#ffb3c7; --accent-2:#ffd2dd; --accent-rgb:255,179,199; --accent-ink:#310713; }
html[data-accent="lavender"] { --accent:#c4b3f7; --accent-2:#dcd2fb; --accent-rgb:196,179,247; --accent-ink:#170a35; }
html[data-accent="sky"]      { --accent:#9dd2ff; --accent-2:#c6e4ff; --accent-rgb:157,210,255; --accent-ink:#04192f; }
html[data-accent="peach"]    { --accent:#ffc4a1; --accent-2:#ffdcc6; --accent-rgb:255,196,161; --accent-ink:#2e1203; }
html[data-accent="lemon"]    { --accent:#ffe49c; --accent-2:#fff0c6; --accent-rgb:255,228,156; --accent-ink:#2c2100; }
html[data-accent="matcha"]   { --accent:#c4e98e; --accent-2:#dcf5bc; --accent-rgb:196,233,142; --accent-ink:#18240a; }
html[data-accent="lilac"]    { --accent:#e4b8e9; --accent-2:#f0d6f3; --accent-rgb:228,184,233; --accent-ink:#2c0e31; }
html[data-accent="aqua"]     { --accent:#9ee9e1; --accent-2:#c5f4ee; --accent-rgb:158,233,225; --accent-ink:#032320; }
html[data-accent="coral"]    { --accent:#ffa9b9; --accent-2:#ffcbd4; --accent-rgb:255,169,185; --accent-ink:#2e0610; }
html[data-accent="taro"]     { --accent:#cab7ed; --accent-2:#e0d4f6; --accent-rgb:202,183,237; --accent-ink:#170c2f; }
html[data-accent="cream"]    { --accent:#ffd9a9; --accent-2:#ffe9cb; --accent-rgb:255,217,169; --accent-ink:#2c1b01; }
html[data-theme="light"][data-accent="mint"]     { --accent:#3aa583; --accent-2:#2d8a6c; --accent-rgb:58,165,131;  --accent-ink:#ffffff; --accent-fill:#2b7b62; --accent-fill-2:#226751; }
html[data-theme="light"][data-accent="sakura"]   { --accent:#db5a80; --accent-2:#c1446a; --accent-rgb:219,90,128;  --accent-ink:#ffffff; --accent-fill:#b54a6a; --accent-fill-2:#9f3858; }
html[data-theme="light"][data-accent="lavender"] { --accent:#6f5cd2; --accent-2:#5b48bd; --accent-rgb:111,92,210;  --accent-ink:#ffffff; --accent-fill:#6f5cd2; --accent-fill-2:#5b48bd; }
html[data-theme="light"][data-accent="sky"]      { --accent:#2f80d2; --accent-2:#256bb4; --accent-rgb:47,128,210;  --accent-ink:#ffffff; --accent-fill:#2971b9; --accent-fill-2:#215e9f; }
html[data-theme="light"][data-accent="peach"]    { --accent:#db7433; --accent-2:#c1601f; --accent-rgb:219,116,51;  --accent-ink:#ffffff; --accent-fill:#a95927; --accent-fill-2:#954a18; }
html[data-theme="light"][data-accent="lemon"]    { --accent:#a8841a; --accent-2:#8d6d0e; --accent-rgb:168,132,26;  --accent-ink:#ffffff; --accent-fill:#896b15; --accent-fill-2:#73590b; }
html[data-theme="light"][data-accent="matcha"]   { --accent:#6d9c25; --accent-2:#588219; --accent-rgb:109,156,37;  --accent-ink:#ffffff; --accent-fill:#55791d; --accent-fill-2:#446513; }
html[data-theme="light"][data-accent="lilac"]    { --accent:#a955b5; --accent-2:#8f439a; --accent-rgb:169,85,181;  --accent-ink:#ffffff; --accent-fill:#9e4fa9; --accent-fill-2:#863f90; }
html[data-theme="light"][data-accent="aqua"]     { --accent:#2b9c93; --accent-2:#218078; --accent-rgb:43,156,147;  --accent-ink:#ffffff; --accent-fill:#227b74; --accent-fill-2:#1a655f; }
html[data-theme="light"][data-accent="coral"]    { --accent:#dc4a63; --accent-2:#c23750; --accent-rgb:220,74,99;   --accent-ink:#ffffff; --accent-fill:#c04157; --accent-fill-2:#aa3046; }
html[data-theme="light"][data-accent="taro"]     { --accent:#7b60c5; --accent-2:#664bad; --accent-rgb:123,96,197;  --accent-ink:#ffffff; --accent-fill:#785ec0; --accent-fill-2:#6449a9; }
html[data-theme="light"][data-accent="cream"]    { --accent:#c38422; --accent-2:#a56d12; --accent-rgb:195,132,34;  --accent-ink:#ffffff; --accent-fill:#95651a; --accent-fill-2:#7e530e; }

/* ---- 深色主题 ---- */
html[data-theme="dark"] {
  --bg: #070b14;
  --bg-2: #0a1018;
  --surface: #0f1720;
  --surface-2: #141d29;
  --surface-3: #1b2634;
  --glass: linear-gradient(180deg, rgba(var(--accent-rgb),.055), rgba(var(--accent-rgb),.015)), rgba(19,28,40,.74);
  --border: rgba(var(--accent-rgb),.15);
  --border-2: rgba(var(--accent-rgb),.085);
  --text: #e8eef7;
  --text-dim: #9fb0c6;
  --text-faint: #6b7f99;
  --code-bg: #060a11;
  --inline-code-bg: rgba(255,255,255,.075);
  --code-head-bg: rgba(255,255,255,.035);
  --user-bubble: linear-gradient(135deg, rgba(var(--accent-rgb),.40), rgba(var(--accent-rgb),.20)), var(--surface-2);
  /* AI 气泡:同一套主题色,只把浓度降下来,保证与用户气泡一眼同族、又有区分 */
  --ai-bubble: linear-gradient(135deg, rgba(var(--accent-rgb),.15), rgba(var(--accent-rgb),.05)), var(--surface-2);
  --ai-bubble-border: rgba(var(--accent-rgb),.30);
  --user-bubble-border: rgba(var(--accent-rgb),.55);
  --user-bubble-text: #eaf6ff;
  --danger: #ff6b7d; --danger-rgb: 255,107,125;
  --success: #34d399; --success-rgb: 52,211,153;
  --warning: #fbbf24; --warning-rgb: 251,191,36;
  /* 语义色的「第二端点」:渐变条/强调竖条的收尾色,以及压在警告底色上的文字色。
     深浅两套各自取值(与 --danger/--success/--warning 同处),换主题时一起变 */
  --danger-2: #ff9aa8; --success-2: #5fd39b; --warning-2: #fcd34d; --warning-ink: #1a1300;
  --shadow-1: 0 1px 2px rgba(0,0,0,.4);
  --shadow-2: 0 10px 34px rgba(0,0,0,.5);
  --shadow-3: 0 26px 70px rgba(0,0,0,.62);
  --grid-line: rgba(var(--accent-rgb),.07);
  --scrollbar: rgba(150,180,220,.22);
  --scrollbar-hover: rgba(150,180,220,.38);
  /* 背景极光由主题色派生,换了主题色整片背景一起变 */
  --aurora-1: rgba(var(--accent-rgb),.24);
  --aurora-2: rgba(var(--accent-rgb),.17);
  --aurora-3: rgba(var(--accent-rgb),.11);
  --overlay: rgba(3,6,12,.72);
}
/* ---- 浅色主题 ---- */
html[data-theme="light"] {
  --bg: #f4f6fa;
  --bg-2: #ffffff;
  --surface: #ffffff;
  --surface-2: #f2f5f9;
  --surface-3: #e7ecf4;
  --glass: linear-gradient(180deg, rgba(var(--accent-rgb),.05), rgba(var(--accent-rgb),.015)), rgba(255,255,255,.84);
  --border: rgba(var(--accent-rgb),.22);
  --border-2: rgba(var(--accent-rgb),.13);
  --text: #101a2b;
  --text-dim: #55677f;
  --text-faint: #8394a9;
  --code-bg: #f6f8fb;
  --inline-code-bg: rgba(16,32,64,.07);
  --code-head-bg: rgba(16,32,64,.035);
  --user-bubble: linear-gradient(135deg, rgba(var(--accent-rgb),.26), rgba(var(--accent-rgb),.13)), #ffffff;
  --user-bubble-border: rgba(var(--accent-rgb),.46);
  --user-bubble-text: #0b1a2b;
  /* AI 气泡:日间同样要有,白底 + 更淡的主题色(缺了这组会让背景变透明) */
  --ai-bubble: linear-gradient(135deg, rgba(var(--accent-rgb),.16), rgba(var(--accent-rgb),.05)), #ffffff;
  --ai-bubble-border: rgba(var(--accent-rgb),.34);
  --danger: #d92d43; --danger-rgb: 217,45,67;
  --success: #0f9d63; --success-rgb: 15,157,99;
  --warning: #b45309; --warning-rgb: 180,83,9;
  /* 语义色的「第二端点」(见深色主题同名令牌的说明):日间用同族更深一档的收尾色,
     压在警告底色上的文字改为白色(深色主题那套 #1a1300 在白底主题下对比度不足) */
  --danger-2: #ff8195; --success-2: #2fbc86; --warning-2: #e09b2d; --warning-ink: #ffffff;
  --shadow-1: 0 1px 2px rgba(16,32,64,.07);
  --shadow-2: 0 10px 30px rgba(16,32,64,.13);
  --shadow-3: 0 26px 60px rgba(16,32,64,.18);
  --grid-line: rgba(var(--accent-rgb),.09);
  --scrollbar: rgba(40,70,110,.25);
  --scrollbar-hover: rgba(40,70,110,.42);
  --aurora-1: rgba(var(--accent-rgb),.30);
  --aurora-2: rgba(var(--accent-rgb),.21);
  --aurora-3: rgba(var(--accent-rgb),.14);
  --overlay: rgba(20,32,52,.42);
}

/* ============================================================================
   2. 基础重置
   ============================================================================ */
* { margin: 0; padding: 0; box-sizing: border-box; }
html, body { height: 100%; }
html { font-size: var(--fs); }
/* 桌面端收起的右栏(#ws-rail.collapsed)用负 margin-right 让它滑出屏幕:盒子本身仍是 340px 宽、
   被摆在视口右侧之外,于是被计进文档的横向滚动宽度 —— 1280 / 1024 视口下顶栏右侧一排按钮会被推出可视区。
   在滚动容器(html)上横向 clip 收住这类溢出:clip 不建立滚动容器,所以纵向滚动与 sticky 行为不变。
   兼容性:`overflow: clip` 需要 Chrome/Edge ≥ 90、Safari ≥ 16 —— 更旧的内核忽略这条声明,
   退化成修复前的样子(只是横向溢出,不影响功能),不是新的故障。 */
html { overflow-x: clip; }
body {
  font-family: var(--font-ui);
  background: var(--bg);
  color: var(--text);
  overflow: hidden;
  line-height: 1.62;
  -webkit-font-smoothing: antialiased;
  -webkit-text-size-adjust: 100%;
  text-rendering: optimizeLegibility;
}
button { font: inherit; color: inherit; background: none; border: none; cursor: pointer; }
input, textarea, select { font: inherit; color: inherit; }
a { color: var(--accent); }
svg { display: block; }
img { border: 0; }
::selection { background: rgba(var(--accent-rgb),.32); color: var(--text); }
:focus-visible { outline: 2px solid rgba(var(--accent-rgb),.75); outline-offset: 2px; border-radius: 4px; }
::-webkit-scrollbar { width: 10px; height: 10px; }
::-webkit-scrollbar-thumb {
  background: var(--scrollbar); border-radius: 8px;
  border: 2px solid transparent; background-clip: content-box;
}
::-webkit-scrollbar-thumb:hover { background: var(--scrollbar-hover); background-clip: content-box; }
::-webkit-scrollbar-track, ::-webkit-scrollbar-corner { background: transparent; }
* { scrollbar-color: var(--scrollbar) transparent; scrollbar-width: thin; }
.icon { width: 18px; height: 18px; stroke: currentColor; fill: none;
        stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; flex: none; }
.icon.fill { fill: currentColor; stroke: none; }
.icon.sm { width: 15px; height: 15px; }
.icon.lg { width: 22px; height: 22px; }
.sr-only { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
#svg-sprite { position: absolute; width: 0; height: 0; overflow: hidden; }
[hidden] { display: none !important; }

/* ============================================================================
   3. 背景氛围(极光 + 网格)
   ============================================================================ */
.bg-layer { position: fixed; inset: 0; pointer-events: none; z-index: 0; }
#bg-aurora { overflow: hidden; opacity: 1; transition: opacity .4s; }
#bg-aurora span {
  position: absolute; display: block; border-radius: 50%;
  filter: blur(80px); will-change: transform;
}
#bg-aurora span:nth-child(1) { width: 46vw; height: 46vw; left: -8vw; top: -14vw; background: var(--aurora-1); animation: drift1 26s var(--ease) infinite alternate; }
#bg-aurora span:nth-child(2) { width: 40vw; height: 40vw; right: -10vw; top: 4vh; background: var(--aurora-2); filter: blur(80px) hue-rotate(38deg); animation: drift2 32s var(--ease) infinite alternate; }
#bg-aurora span:nth-child(3) { width: 38vw; height: 38vw; left: 26vw; bottom: -18vw; background: var(--aurora-3); filter: blur(80px) hue-rotate(-42deg); animation: drift3 38s var(--ease) infinite alternate; }
@keyframes drift1 { to { transform: translate3d(6vw, 5vh, 0) scale(1.15); } }
@keyframes drift2 { to { transform: translate3d(-7vw, 8vh, 0) scale(1.1); } }
@keyframes drift3 { to { transform: translate3d(4vw, -6vh, 0) scale(1.18); } }
#bg-grid {
  background-image:
    linear-gradient(to right, var(--grid-line) 1px, transparent 1px),
    linear-gradient(to bottom, var(--grid-line) 1px, transparent 1px);
  background-size: 46px 46px;
  mask-image: radial-gradient(ellipse 90% 75% at 50% 40%, #000 20%, transparent 100%);
  -webkit-mask-image: radial-gradient(ellipse 90% 75% at 50% 40%, #000 20%, transparent 100%);
}
html[data-fx="off"] #bg-aurora, html[data-fx="off"] #bg-grid { display: none; }
html[data-fx="off"] * { animation: none !important; transition: none !important; }
@media (prefers-reduced-motion: reduce) {
  #bg-aurora span { animation: none !important; }
  * { scroll-behavior: auto !important; }
}
html[data-motion="reduce"] #bg-aurora span { animation: none !important; }
html[data-motion="reduce"] * { animation-duration: .01ms !important; transition-duration: .01ms !important; }

/* ============================================================================
   4. 应用骨架
   ============================================================================ */
#app { position: relative; z-index: 1; display: flex; height: 100vh; height: 100dvh; }
html.legacy #app { display: none; }

/* ---- 旧浏览器提示页 ---- */
#compat-screen {
  display: none; position: fixed; inset: 0; z-index: 9999;
  align-items: center; justify-content: center; padding: 24px;
  background: var(--bg); overflow: auto;
}
html.legacy #compat-screen { display: flex; }
#compat-screen .cs-card {
  max-width: 620px; width: 100%; padding: 30px 32px;
  background: var(--surface); border: 1px solid var(--border);
  border-radius: var(--r-lg); box-shadow: var(--shadow-2);
}
#compat-screen h1 { font-size: 20px; margin-bottom: 10px; display: flex; align-items: center; gap: 10px; }
#compat-screen p { color: var(--text-dim); font-size: 13.5px; margin-bottom: 14px; }
#compat-screen ul { margin: 0 0 16px 20px; color: var(--text); font-size: 13.5px; }
#compat-screen li { margin: 4px 0; }
#compat-screen .cs-note { font-size: 12.5px; color: var(--text-faint); }
#compat-screen code { font-family: var(--font-mono); background: var(--surface-2); padding: 1px 6px; border-radius: 5px; font-size: 12.5px; }

/* ============================================================================
   5. 侧边栏
   ============================================================================ */
#sidebar {
  width: var(--sidebar-w); min-width: var(--sidebar-w);
  display: flex; flex-direction: column; position: relative;
  background: var(--glass);
  border-right: 1px solid var(--border-2);
  backdrop-filter: blur(16px) saturate(1.3);
  -webkit-backdrop-filter: blur(16px) saturate(1.3);
  transition: margin-left .26s var(--ease);
}
#sidebar.collapsed { margin-left: calc(-1 * var(--sidebar-w)); }
.side-head { display: flex; align-items: center; gap: 11px; padding: 15px 15px 11px; }
.side-head .logo {
  width: 36px; height: 36px; border-radius: 11px; flex: none;
  display: flex; align-items: center; justify-content: center;
  color: var(--accent-ink); position: relative;
  background: linear-gradient(135deg, var(--accent), var(--accent-2));
  box-shadow: 0 4px 16px rgba(var(--accent-rgb),.4), inset 0 1px 0 rgba(255,255,255,.32);
}
.side-head .logo .icon { width: 22px; height: 22px; stroke-width: 1.7; }
.side-head .brand { min-width: 0; flex: 1; }
.side-head { padding-right: 9px; }
.side-head .side-close { width: 30px; height: 30px; }
.side-head .brand b {
  display: block; font-size: 14.5px; font-weight: 700; letter-spacing: .2px;
  background: linear-gradient(100deg, var(--text), var(--accent-2));
  -webkit-background-clip: text; background-clip: text; -webkit-text-fill-color: transparent;
  white-space: nowrap;
}
.side-head .brand small { display: block; font-size: 10.5px; color: var(--text-faint); letter-spacing: .3px; }

.side-actions { padding: 3px 12px 10px; display: flex; flex-direction: column; gap: 8px; }
.btn-new {
  display: flex; align-items: center; justify-content: center; gap: 8px;
  width: 100%; padding: 10px 12px; border-radius: var(--r-sm);
  font-size: 13.5px; font-weight: 600; color: var(--accent-ink);
  /* 底色用 --accent-fill:小字号白字压在 accent 上要过 AA 4.5:1(浅色主题的 accent 偏亮) */
  background: linear-gradient(135deg, var(--accent-fill), var(--accent-fill-2));
  border: 1px solid transparent;
  box-shadow: 0 4px 18px rgba(var(--accent-rgb),.3);
  transition: transform .16s var(--ease), box-shadow .16s, filter .16s;
}
.btn-new:hover { transform: translateY(-1px); box-shadow: 0 8px 24px rgba(var(--accent-rgb),.42); filter: brightness(1.06); }
.btn-new:active { transform: translateY(0) scale(.99); }

.search-wrap { position: relative; }
.search-wrap .icon { position: absolute; left: 10px; top: 50%; transform: translateY(-50%);
                     color: var(--text-faint); pointer-events: none; }
.search-wrap input {
  width: 100%; height: 36px; padding: 0 30px 0 33px;
  border-radius: var(--r-sm); border: 1px solid var(--border);
  background: var(--surface); font-size: 12.5px; outline: none;
  transition: border-color .16s, box-shadow .16s;
}
.search-wrap input:focus { border-color: var(--accent); box-shadow: 0 0 0 3px rgba(var(--accent-rgb),.13); }
.search-wrap input::placeholder { color: var(--text-faint); }
.search-wrap .clear {
  position: absolute; right: 5px; top: 50%; transform: translateY(-50%);
  width: 24px; height: 24px; border-radius: 7px; display: none;
  align-items: center; justify-content: center; color: var(--text-faint);
}
.search-wrap .clear:hover { background: var(--surface-3); color: var(--text); }
.search-wrap.has-value .clear { display: flex; }

#conv-list { flex: 1; overflow-y: auto; overflow-x: hidden; padding: 0 8px 10px; overscroll-behavior: contain; }
.conv-group {
  padding: 13px 9px 5px; font-size: 10.5px; font-weight: 700;
  color: var(--text-faint); letter-spacing: .8px; text-transform: uppercase;
  display: flex; align-items: center; gap: 6px;
}
.conv-group::after { content: ""; flex: 1; height: 1px; background: var(--border-2); }
.conv-item {
  position: relative; display: flex; align-items: center; gap: 8px;
  padding: var(--d-conv-y) 10px; margin-bottom: 2px; border-radius: var(--r-sm);
  color: var(--text-dim); cursor: pointer; user-select: none;
  border: 1px solid transparent;
  transition: background .14s, color .14s, border-color .14s;
}
.conv-item:hover { background: var(--surface-2); color: var(--text); }
.conv-item.active {
  background: rgba(var(--accent-rgb),.12); color: var(--text);
  border-color: rgba(var(--accent-rgb),.3);
}
.conv-item.active::before {
  content: ""; position: absolute; left: -1px; top: 9px; bottom: 9px;
  width: 3px; border-radius: 0 3px 3px 0; background: var(--accent);
  box-shadow: 0 0 10px rgba(var(--accent-rgb),.8);
}
.conv-item .ci-icon { flex: none; color: var(--text-faint); }
.conv-item.active .ci-icon, .conv-item:hover .ci-icon { color: var(--accent); }
.conv-item .ci-main { flex: 1; min-width: 0; }
.conv-item .ci-title {
  display: block; font-size: 13.5px; font-weight: 500;
  overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
}
.conv-item .ci-sub {
  display: block; font-size: 11px; color: var(--text-faint); margin-top: 1px;
  overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
}
.conv-item .ci-msgs { flex: none; font-size: 10px; font-family: var(--font-mono); color: var(--text-faint); }
/* 生成中徽标(b30):该会话处于生成态时出现;四态文案由 appD 的 genPhaseText 派生
   (生成中 / 工具执行中 / 等你操作 / 停止中)。颜色只用主题变量(--accent / --warning),
   深浅两组自动跟随;紧凑模式字号收一档 */
.conv-item .ci-gen {
  flex: none; display: inline-flex; align-items: center; gap: 3px;
  font-size: 10px; line-height: 1; color: var(--accent); white-space: nowrap;
}
.conv-item .ci-gen i {
  width: 6px; height: 6px; border-radius: 50%; background: var(--accent); flex: none;
  animation: pulse 1.1s ease-in-out infinite;
}
.conv-item .ci-gen.warn { color: var(--warning); }
.conv-item .ci-gen.warn i { background: var(--warning); }
html[data-density="compact"] .conv-item .ci-gen { font-size: 9px; }
.conv-item .ci-pin { flex: none; color: var(--accent); display: none; }
.conv-item.pinned .ci-pin { display: block; }
.conv-item .ci-menu {
  flex: none; width: 22px; height: 22px; border-radius: 6px; opacity: 0;
  display: flex; align-items: center; justify-content: center; color: var(--text-faint);
}
.conv-item:hover .ci-menu, .conv-item .ci-menu:focus { opacity: 1; }
.conv-item .ci-menu:hover { background: var(--surface-3); color: var(--text); }
.conv-item mark { background: rgba(var(--accent-rgb),.28); color: inherit; border-radius: 3px; padding: 0 2px; }
.conv-empty { padding: 34px 16px; text-align: center; color: var(--text-faint); font-size: 12.5px; line-height: 1.9; }

.side-foot { border-top: 1px solid var(--border-2); padding: 8px; }
.side-foot-row { display: flex; gap: 6px; margin-bottom: 4px; }
.foot-btn {
  flex: 1; display: flex; align-items: center; justify-content: center; gap: 7px;
  padding: 8px 6px; border-radius: var(--r-sm); font-size: 12.5px;
  color: var(--text-dim); border: 1px solid transparent;
  transition: background .14s, color .14s, border-color .14s;
}
.foot-btn:hover { background: var(--surface-2); color: var(--text); border-color: var(--border-2); }
.foot-btn.wide { flex: none; width: 100%; justify-content: flex-start; padding: 9px 11px; gap: 10px; }
.foot-btn.accent { color: var(--accent); }
.conn-status {
  display: flex; align-items: center; gap: 8px; padding: 6px 11px 3px;
  font-size: 11.5px; color: var(--text-faint);
}
.conn-dot {
  width: 7px; height: 7px; border-radius: 50%; flex: none;
  background: var(--text-faint); transition: background .3s, box-shadow .3s;
}
.conn-dot.ok { background: var(--success); box-shadow: 0 0 8px rgba(var(--success-rgb),.9); }
.conn-dot.err { background: var(--danger); box-shadow: 0 0 8px rgba(var(--danger-rgb),.9); }
.conn-dot.busy { background: var(--warning); animation: pulse 1.1s ease-in-out infinite; }
@keyframes pulse { 50% { opacity: .3; } }

/* ============================================================================
   6. 主区域 / 顶栏
   ============================================================================ */
#main { flex: 1; display: flex; flex-direction: column; min-width: 0; position: relative; }
#topbar {
  height: var(--topbar-h); flex: none; display: flex; align-items: center; gap: 9px;
  padding: 0 13px; border-bottom: 1px solid var(--border-2); z-index: 12;
  background: var(--glass);
  backdrop-filter: blur(16px) saturate(1.3);
  -webkit-backdrop-filter: blur(16px) saturate(1.3);
}
.icon-btn {
  width: 34px; height: 34px; border-radius: var(--r-sm); flex: none;
  display: flex; align-items: center; justify-content: center;
  color: var(--text-dim); border: 1px solid transparent;
  transition: background .14s, color .14s, border-color .14s, transform .14s;
}
.icon-btn:hover { background: var(--surface-2); color: var(--text); border-color: var(--border-2); }
.icon-btn:active { transform: scale(.94); }
.icon-btn.on { color: var(--accent); background: rgba(var(--accent-rgb),.12); border-color: rgba(var(--accent-rgb),.3); }

.title-wrap { flex: 1; min-width: 0; }
#conv-title {
  font-weight: 600; font-size: 14.5px; cursor: pointer;
  overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
  display: flex; align-items: center; gap: 7px;
}
#conv-title .t-sub { font-size: 11px; color: var(--text-faint); font-weight: 400; flex: none; }
#conv-title:hover { color: var(--accent); }

.badge {
  flex: none; font-size: 10px; font-weight: 800; letter-spacing: .6px;
  padding: 3px 9px; border-radius: 999px; border: 1px solid;
  text-transform: uppercase; font-family: var(--font-mono);
}
.badge.openai { color: #10b981; border-color: rgba(16,185,129,.45); background: rgba(16,185,129,.11); }
.badge.anthropic { color: #e0865f; border-color: rgba(224,134,95,.45); background: rgba(224,134,95,.12); }
html[data-theme="light"] .badge.openai { color: #047857; border-color: rgba(4,120,87,.4); background: rgba(4,120,87,.09); }
html[data-theme="light"] .badge.anthropic { color: #b45309; border-color: rgba(180,83,9,.4); background: rgba(180,83,9,.09); }

.model-chip {
  display: flex; align-items: center; gap: 7px; max-width: 250px;
  height: 32px; padding: 0 8px 0 11px; border-radius: 999px;
  background: var(--surface); border: 1px solid var(--border);
  transition: border-color .16s, box-shadow .16s;
}
.model-chip:hover { border-color: rgba(var(--accent-rgb),.55); }
.model-chip .icon { color: var(--text-faint); }
.model-chip .m-name {
  font-size: 12px; font-family: var(--font-mono);
  overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
  max-width: 150px; color: var(--text-dim);
}
.model-chip .m-name.empty { color: var(--warning); }
.model-chip .m-caret { color: var(--text-faint); }

/* ============================================================================
   7. 聊天区
   ============================================================================ */
#chat { flex: 1; overflow-y: auto; overflow-x: hidden; position: relative; overscroll-behavior: contain; }
#chat-inner { max-width: var(--content-w); margin: 0 auto; padding: var(--d-chat-t) var(--d-chat-x) var(--d-chat-b); }

/* 紧凑模式:密度令牌统一覆盖见第 14 节末「紧凑模式(密度令牌)」;这两条是消息区正文口径 */
html[data-density="compact"] .msg { padding: var(--d-msg-y) 0; }
html[data-density="compact"] .msg-content { font-size: 14px; }
/* 触屏设备没有 hover:操作条与菜单按钮常显 */
@media (hover: none) {
  .msg-actions { opacity: 1; }
  .conv-item .ci-menu { opacity: .8; }
  .conv-item .ci-menu:hover { opacity: 1; }
}

.msg { display: flex; gap: var(--d-msg-gap); padding: var(--d-msg-y) 0; position: relative; }
.msg + .msg { border-top: 1px solid var(--border-2); }
.msg.enter { animation: msgIn .34s var(--ease); }
@keyframes msgIn { from { opacity: 0; transform: translateY(10px); } }
.avatar {
  width: var(--d-avatar); height: var(--d-avatar); border-radius: 10px; flex: none;
  display: flex; align-items: center; justify-content: center;
  color: #fff; position: relative;
}
.avatar .icon { width: 17px; height: 17px; stroke-width: 2; }
.avatar.user { background: linear-gradient(135deg, var(--accent), var(--accent-2)); color: var(--accent-ink);
               box-shadow: 0 3px 12px rgba(var(--accent-rgb),.34); }
.avatar.assistant {
  background: var(--surface-3); color: var(--accent);
  border: 1px solid rgba(var(--accent-rgb),.5);
  box-shadow: 0 3px 12px rgba(var(--accent-rgb),.16);
}
/* 生成中:呼吸发光(替代原先旋转的方块描边) */
.avatar.assistant.thinking { animation: aiBreathe 1.8s ease-in-out infinite; }
@keyframes aiBreathe {
  0%, 100% { box-shadow: 0 0 0 0 rgba(var(--accent-rgb),.55), 0 3px 12px rgba(16,185,129,.30); }
  70%      { box-shadow: 0 0 0 10px rgba(var(--accent-rgb),0), 0 3px 22px rgba(var(--accent-rgb),.6); }
}
.avatar.assistant.thinking::after {
  content: ""; position: absolute; inset: 0; border-radius: 10px;
  background: radial-gradient(circle at 50% 50%, rgba(255,255,255,.42), rgba(255,255,255,0) 70%);
  animation: aiGlowPulse 1.8s ease-in-out infinite; pointer-events: none;
}
@keyframes aiGlowPulse { 0%, 100% { opacity: .22; } 50% { opacity: .75; } }
@keyframes spin { to { transform: rotate(360deg); } }
.msg-body { flex: 1; min-width: 0; }
.msg-meta { display: flex; align-items: center; gap: 8px; margin-bottom: 5px; font-size: 11.5px; color: var(--text-faint); flex-wrap: wrap; }
.msg-meta .who { font-weight: 700; color: var(--text-dim); }
.msg-meta .chip {
  display: inline-flex; align-items: center; gap: 4px; line-height: 15px; white-space: nowrap;
  font-size: 10px; padding: 1px 7px; border-radius: 999px;
  background: var(--surface-2); color: var(--text-faint); border: 1px solid var(--border-2);
  font-family: var(--font-mono);
}
.msg-meta .chip .icon { width: 11px; height: 11px; flex: none; stroke-width: 2.2; }
.msg-meta .chip.model { color: var(--accent); background: rgba(var(--accent-rgb),.1); border-color: rgba(var(--accent-rgb),.26); }
.msg-meta .chip.live { color: var(--accent-2); background: rgba(var(--accent-rgb),.13); border-color: rgba(var(--accent-rgb),.3); }
.msg-meta .chip.warn { color: var(--warning); }

/* 思考过程 */
.reasoning {
  margin: 3px 0 11px; border: 1px solid rgba(var(--accent-rgb),.22);
  border-radius: var(--r-md); overflow: hidden;
  background: linear-gradient(180deg, rgba(var(--accent-rgb),.07), transparent);
}
.reasoning-head {
  width: 100%; display: flex; align-items: center; gap: 8px;
  padding: 8px 12px; font-size: 12.5px; color: var(--text-dim); text-align: left;
}
.reasoning-head:hover { color: var(--text); }
.reasoning-head .icon { color: var(--accent); width: 14px; height: 14px; }
.reasoning-head .r-time { font-size: 11px; color: var(--text-faint); font-family: var(--font-mono); }
.reasoning-head .r-arrow { margin-left: auto; transition: transform .22s var(--ease); color: var(--text-faint); }
.reasoning.open .reasoning-head .r-arrow { transform: rotate(180deg); }
.reasoning-body {
  padding: 4px 14px 12px; font-size: 12.8px; line-height: 1.7; color: var(--text-dim);
  white-space: pre-wrap; word-break: break-word; border-top: 1px solid var(--border-2);
  /* 思考内容最多显示 --think-lines 行,超出后自身滚动 */
  max-height: calc(var(--think-lines) * 1.7em + 16px); overflow-y: auto;
  overscroll-behavior: contain;
}
.reasoning-body .msg-content { font-size: 13px; color: var(--text-dim); white-space: normal; }
.reasoning-body .msg-content p { margin: .42em 0; }
.reasoning-body .msg-content pre { margin: .5em 0; }
.reasoning.collapsed .reasoning-body { display: none; }

/* 消息正文 */
.msg-content { font-size: 14.5px; word-break: break-word; overflow-wrap: anywhere; }
.msg-content > *:first-child { margin-top: 0; }
.msg-content > *:last-child { margin-bottom: 0; }
.msg-content p { margin: var(--d-block) 0; }
.msg-content h1, .msg-content h2, .msg-content h3, .msg-content h4, .msg-content h5, .msg-content h6 {
  margin: 1em 0 .45em; line-height: 1.32; font-weight: 700;
}
.msg-content h1 { font-size: 1.46em; border-bottom: 1px solid var(--border-2); padding-bottom: .22em; }
.msg-content h2 { font-size: 1.27em; }
.msg-content h3 { font-size: 1.11em; }
.msg-content h4 { font-size: 1em; }
.msg-content ul, .msg-content ol { margin: .5em 0; padding-left: 1.65em; }
.msg-content li { margin: var(--d-li) 0; }
.msg-content li > p { margin: .25em 0; }
.msg-content li::marker { color: var(--accent); }
.msg-content input[type="checkbox"] { margin-right: 6px; accent-color: var(--accent); }
.msg-content blockquote {
  border-left: 3px solid var(--accent); margin: .7em 0; padding: 3px 15px;
  color: var(--text-dim); background: rgba(var(--accent-rgb),.055);
  border-radius: 0 var(--r-sm) var(--r-sm) 0;
}
.msg-content blockquote > *:first-child { margin-top: 0; }
.msg-content blockquote > *:last-child { margin-bottom: 0; }
.msg-content hr { border: none; border-top: 1px solid var(--border); margin: 1.1em 0; }
.msg-content a { color: var(--accent); text-decoration: none; border-bottom: 1px solid rgba(var(--accent-rgb),.4); }
.msg-content a:hover { border-bottom-color: var(--accent); }
.msg-content strong { font-weight: 700; color: var(--text); }
.msg-content del { color: var(--text-faint); }
.msg-content code, .tool-card .tc-note code {
  font-family: var(--font-mono); font-size: .87em;
  background: var(--inline-code-bg); padding: 2px 6px; border-radius: 5px;
  border: 1px solid var(--border-2);
}
.msg-content pre, .tool-card pre {
  background: var(--code-bg); border: 1px solid var(--border);
  border-radius: var(--r-md); margin: .75em 0; overflow: hidden; position: relative;
}
.msg-content pre .code-head, .tool-card pre .code-head {
  display: flex; align-items: center; justify-content: space-between; gap: 8px;
  padding: 6px 8px 6px 13px; font-size: 11px; color: var(--text-faint);
  background: var(--code-head-bg); border-bottom: 1px solid var(--border-2);
  font-family: var(--font-mono); letter-spacing: .4px;
}
.msg-content pre .code-head .ch-lang, .tool-card pre .code-head .ch-lang { display: flex; align-items: center; gap: 7px; text-transform: uppercase; }
.msg-content pre .code-head .ch-dot, .tool-card pre .code-head .ch-dot { width: 6px; height: 6px; border-radius: 50%; background: var(--accent); opacity: .7; }
.msg-content pre .code-head .ch-lines, .tool-card pre .code-head .ch-lines { text-transform: none; opacity: .75; }
.msg-content pre .code-head .ch-ops, .tool-card pre .code-head .ch-ops { display: flex; align-items: center; gap: 4px; flex-wrap: wrap; justify-content: flex-end; }
.msg-content pre .code-head button, .tool-card pre .code-head button {
  display: inline-flex; align-items: center; gap: 3px; flex: none; white-space: nowrap;
  font-size: 11px; color: var(--text-faint); padding: 3px 7px; border-radius: 6px;
  border: 1px solid var(--border); background: var(--surface);
  transition: color .14s, border-color .14s; line-height: 1.2;
  /* 命中区下限 24px(WCAG 2.2 目标尺寸):11×1.2 + 3×2 + 1×2 = 21.2 ⇒ 补到 24;
     写 min-height 而非加 padding ⇒ 不依赖字体度量,左右内边距与横向宽度一字不变(只有高 21.2 → 24) */
  min-height: 24px;
}
.msg-content pre .code-head button .icon, .tool-card pre .code-head button .icon { width: 12px; height: 12px; flex: none; }
.msg-content pre .code-head button:hover, .tool-card pre .code-head button:hover { color: var(--text); border-color: var(--accent); }
.msg-content pre code, .tool-card pre code {
  display: block; padding: 12px 15px; overflow: auto;
  background: none; border: none; font-size: 13px; line-height: 1.6; color: var(--text);
  tab-size: 4; -moz-tab-size: 4; word-spacing: .12em;
  /* 超出 ~10 行时,代码区自身成为纵向滚动区域(表头与复制按钮始终留在上方) */
  max-height: calc(var(--code-lines) * 1.6em + 24px);
}
.msg-content pre.expanded code, .tool-card pre.expanded code { max-height: none; }
.msg-content pre.wrapped code { white-space: pre-wrap; word-break: break-word; }
.tool-card pre.wrapped code { white-space: pre-wrap; word-break: break-word; }
.hljs { background: transparent !important; }
html[data-theme="dark"] .hljs { color: #e6edf3; }
html[data-theme="dark"] .hljs-comment, html[data-theme="dark"] .hljs-quote { color: #8b949e; font-style: italic; }
html[data-theme="dark"] .hljs-keyword, html[data-theme="dark"] .hljs-selector-tag, html[data-theme="dark"] .hljs-literal, html[data-theme="dark"] .hljs-operator, html[data-theme="dark"] .hljs-doctag { color: #ff7b72; }
html[data-theme="dark"] .hljs-number, html[data-theme="dark"] .hljs-symbol, html[data-theme="dark"] .hljs-bullet { color: #79c0ff; }
html[data-theme="dark"] .hljs-string, html[data-theme="dark"] .hljs-regexp, html[data-theme="dark"] .hljs-addition, html[data-theme="dark"] .hljs-attribute, html[data-theme="dark"] .hljs-meta .hljs-string { color: #a5d6ff; }
html[data-theme="dark"] .hljs-title, html[data-theme="dark"] .hljs-section, html[data-theme="dark"] .hljs-name, html[data-theme="dark"] .hljs-selector-id, html[data-theme="dark"] .hljs-selector-class, html[data-theme="dark"] .hljs-selector-pseudo, html[data-theme="dark"] .hljs-type { color: #d2a8ff; }
html[data-theme="dark"] .hljs-attr, html[data-theme="dark"] .hljs-variable, html[data-theme="dark"] .hljs-template-variable { color: #ffa657; }
html[data-theme="dark"] .hljs-built_in, html[data-theme="dark"] .hljs-title.function_ { color: #79c0ff; }
html[data-theme="dark"] .hljs-meta { color: #8b949e; }
html[data-theme="dark"] .hljs-deletion { color: #ffa198; }
html[data-theme="dark"] .hljs-emphasis { font-style: italic; }
html[data-theme="dark"] .hljs-strong { font-weight: 600; }
html[data-theme="dark"] .hljs-link { color: #a5d6ff; text-decoration: underline; }
html[data-theme="dark"] .hljs-tag { color: #7ee787; }
html[data-theme="dark"] .hljs-params { color: #e6edf3; }
html[data-theme="light"] .hljs { color: #1f2328; }
html[data-theme="light"] .hljs-comment, html[data-theme="light"] .hljs-quote { color: #6a737d; font-style: italic; }
html[data-theme="light"] .hljs-keyword, html[data-theme="light"] .hljs-selector-tag, html[data-theme="light"] .hljs-literal, html[data-theme="light"] .hljs-operator, html[data-theme="light"] .hljs-doctag { color: #cf222e; }
html[data-theme="light"] .hljs-number, html[data-theme="light"] .hljs-symbol, html[data-theme="light"] .hljs-bullet { color: #0550ae; }
html[data-theme="light"] .hljs-string, html[data-theme="light"] .hljs-regexp, html[data-theme="light"] .hljs-addition, html[data-theme="light"] .hljs-attribute { color: #0a3069; }
html[data-theme="light"] .hljs-title, html[data-theme="light"] .hljs-section, html[data-theme="light"] .hljs-name, html[data-theme="light"] .hljs-selector-id, html[data-theme="light"] .hljs-selector-class, html[data-theme="light"] .hljs-selector-pseudo, html[data-theme="light"] .hljs-type { color: #8250df; }
html[data-theme="light"] .hljs-attr, html[data-theme="light"] .hljs-variable, html[data-theme="light"] .hljs-template-variable { color: #953800; }
html[data-theme="light"] .hljs-built_in, html[data-theme="light"] .hljs-title.function_ { color: #0550ae; }
html[data-theme="light"] .hljs-meta { color: #6a737d; }
html[data-theme="light"] .hljs-deletion { color: #82071e; }
html[data-theme="light"] .hljs-tag { color: #116329; }

.msg-content table { border-collapse: collapse; margin: .75em 0; font-size: 13.5px; display: block; overflow-x: auto; max-width: 100%; }
.msg-content th, .msg-content td { border: 1px solid var(--border); padding: 7px 13px; text-align: left; }
.msg-content th { background: var(--surface-2); font-weight: 600; }
.msg-content tbody tr:nth-child(even) td { background: rgba(127,150,190,.045); }
.msg-content img { max-width: 100%; border-radius: var(--r-sm); cursor: zoom-in; }
.msg-content img.inline-thumb { max-width: 190px; }

/* 用户消息气泡:右侧对齐;内容同样走 Markdown 渲染 */
.msg.user { flex-direction: row-reverse; }
.msg.user .msg-body { display: flex; flex-direction: column; align-items: flex-end; }
.msg.user .msg-meta { justify-content: flex-end; }
.msg.user .msg-actions { justify-content: flex-end; }
.msg.user .edit-box { align-self: stretch; width: 100%; }
.msg.user > .msg-body > .msg-content {
  background: var(--user-bubble); border: 1px solid var(--user-bubble-border);
  color: var(--user-bubble-text); padding: 10px 15px; text-align: left;
  border-radius: var(--r-md) 4px var(--r-md) var(--r-md);
  display: inline-block; max-width: 100%;
}
.msg.user .msg-content p { margin: .35em 0; }
.msg.user .msg-content img { margin: 4px 4px 0 0; }

/* AI 消息气泡:中性实色不透明底(与用户的主题色淡底区分);
   内容为空时不占位,避免流式开始前出现空框 */
.msg.assistant > .msg-body > .msg-content {
  background: var(--ai-bubble); border: 1px solid var(--ai-bubble-border);
  padding: 12px 15px; border-radius: var(--r-md) var(--r-md) var(--r-md) 4px;
  display: inline-block; max-width: 100%;
  box-shadow: 0 1px 2px rgba(0,0,0,.06);
}
.msg.assistant > .msg-body > .msg-content:empty { display: none; }

/* 消息操作条 */
.msg-actions { display: flex; gap: 4px; margin-top: 9px; flex-wrap: wrap; opacity: 0; transition: opacity .16s; }
.msg:hover .msg-actions, .msg-actions:focus-within { opacity: 1; }
.msg-actions button {
  display: flex; align-items: center; gap: 5px;
  height: 27px; padding: 0 9px; border-radius: 7px; font-size: 11.5px;
  color: var(--text-faint); background: var(--surface-2); border: 1px solid var(--border-2);
  transition: color .14s, border-color .14s, background .14s;
}
.msg-actions button:hover { color: var(--text); border-color: rgba(var(--accent-rgb),.5); background: var(--surface-3); }
.msg-actions button.danger:hover { color: var(--danger); border-color: rgba(var(--danger-rgb),.5); }
.msg-actions .icon { width: 13px; height: 13px; }
.msg-actions .alt-nav { display: inline-flex; align-items: center; gap: 1px; margin-right: 2px; }
.msg-actions .alt-nav button { padding: 0 4px; }
.msg-actions .alt-nav button .icon { width: 14px; height: 14px; }
.msg-actions .alt-idx {
  font-size: 11px; font-family: var(--font-mono); color: var(--text-faint);
  min-width: 34px; text-align: center;
}
/* 朗读进行中:按钮高亮 + 音量图标轻微脉冲;点同一条消息的按钮、播完、切换/出错都会移除 .on,
   动画随类一起消失,不留残影 */
.msg-actions button[data-act="speak"].on {
  color: var(--accent); border-color: rgba(var(--accent-rgb),.45); background: rgba(var(--accent-rgb),.12);
}
.msg-actions button[data-act="speak"].on .icon { animation: speakPulse 1.3s ease-in-out infinite; }
@keyframes speakPulse {
  0%, 100% { opacity: 1; transform: scale(1); }
  50% { opacity: .5; transform: scale(.86); }
}
@media (prefers-reduced-motion: reduce) {
  .msg-actions button[data-act="speak"].on .icon { animation: none; }
}

/* 编辑框 */
.edit-box { margin-top: 4px; }
.edit-box textarea {
  width: 100%; min-height: 100px; padding: 11px 13px;
  border-radius: var(--r-md); border: 1px solid var(--accent);
  background: var(--surface); resize: vertical; outline: none;
  font-size: 14px; line-height: 1.6; font-family: inherit;
  box-shadow: 0 0 0 3px rgba(var(--accent-rgb),.13);
}
.edit-box .edit-actions { display: flex; gap: 8px; margin-top: 9px; justify-content: flex-end; align-items: center; }
.edit-box .edit-files { display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 9px; }
.edit-box .edit-files:empty { display: none; }
.edit-chip {
  display: inline-flex; align-items: center; gap: 7px; padding: 4px 6px 4px 5px; border-radius: 10px;
  background: var(--surface-2); border: 1px solid var(--border); font-size: 12px;
  color: var(--text-dim); max-width: 240px;
}
.edit-chip .ec-name { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.edit-chip .ec-rm { width: 19px; height: 19px; border-radius: 6px; flex: none;
  display: flex; align-items: center; justify-content: center; color: var(--text-faint); }
.edit-chip .ec-rm:hover { background: var(--surface-3); color: var(--danger); }
.edit-box .edit-actions .grow { margin-right: auto; }
/* 「Ctrl+Enter 保存」做成低对比的胶囊提示,排在两个按钮左侧 */
.edit-box .edit-hint {
  display: inline-flex; align-items: center; gap: 4px; margin-right: 3px;
  font-size: 11.5px; color: var(--text-faint);
  padding: 3px 10px 3px 7px; border-radius: 999px;
  background: var(--surface-2); border: 1px solid var(--border-2);
}
.edit-box .edit-hint kbd {
  font-family: var(--font-mono); font-size: 10px; color: var(--text-dim);
  background: var(--surface-3); border: 1px solid var(--border);
  border-bottom-width: 2px; border-radius: 4px; padding: 1px 4px; margin: 0;
}

/* 按钮 */
.btn {
  display: inline-flex; align-items: center; justify-content: center; gap: 7px;
  padding: 8px 16px; border-radius: var(--r-sm); font-size: 13px; font-weight: 500;
  background: var(--surface-2); color: var(--text); border: 1px solid var(--border);
  transition: background .15s, border-color .15s, transform .12s, color .15s;
}
.btn:hover { border-color: rgba(var(--accent-rgb),.6); background: var(--surface-3); }
.btn:active { transform: scale(.985); }
.btn.primary {
  /* 底色用 --accent-fill:同 .btn-new(小字号白字要过 AA 4.5:1) */
  background: linear-gradient(135deg, var(--accent-fill), var(--accent-fill-2));
  border-color: transparent; color: var(--accent-ink); font-weight: 600;
  box-shadow: 0 3px 14px rgba(var(--accent-rgb),.28);
}
.btn.primary:hover { filter: brightness(1.07); box-shadow: 0 6px 20px rgba(var(--accent-rgb),.4); }
.btn.danger { color: var(--danger); border-color: rgba(var(--danger-rgb),.4); }
.btn.danger:hover { background: rgba(var(--danger-rgb),.12); border-color: rgba(var(--danger-rgb),.7); }
.btn.ghost { background: transparent; border-color: transparent; color: var(--text-dim); }
.btn.ghost:hover { background: var(--surface-2); color: var(--text); }
.btn.sm { padding: 5px 12px; font-size: 12px; border-radius: 8px; }
.btn.xs { padding: 4px 9px; font-size: 11.5px; border-radius: 7px; gap: 5px; }
.btn.block { width: 100%; }
.btn:disabled { opacity: .45; cursor: not-allowed; transform: none; }
.btn .icon { width: 15px; height: 15px; }

/* 生成中:光标 + 「正在生成」位于消息内容下方,元素不被重绘替换,动画可连续播放 */
.gen-line { display: flex; align-items: center; gap: 8px; margin-top: 9px; font-size: 12px; color: var(--text-faint); }
.gen-line .gen-txt { font-family: var(--font-mono); letter-spacing: .3px; }
.cursor {
  display: inline-block; width: 8px; height: 15px; flex: none;
  vertical-align: -2px; border-radius: 2px;
  background: linear-gradient(180deg, var(--accent), var(--accent-2));
  box-shadow: 0 0 9px rgba(var(--accent-rgb),.75);
  animation: cursorBlink 1.05s steps(1, end) infinite;
}
@keyframes cursorBlink { 0%, 50% { opacity: 1; } 51%, 100% { opacity: .1; } }
.spinner {
  width: 13px; height: 13px; border-radius: 50%; flex: none;
  border: 2px solid var(--border); border-top-color: var(--accent);
  animation: spin .82s linear infinite;
}
.msg-error {
  margin-top: 9px; padding: 11px 14px; border-radius: var(--r-md);
  background: rgba(var(--danger-rgb),.09); border: 1px solid rgba(var(--danger-rgb),.36);
  color: var(--danger); font-size: 12.8px; white-space: pre-wrap; word-break: break-word;
}
.msg-error .err-title { font-weight: 700; display: flex; align-items: center; gap: 7px; margin-bottom: 5px; }
.msg-error .retry-btn { margin-top: 9px; }

/* 欢迎页 */
#welcome { text-align: center; padding: 52px 20px 26px; }
#welcome .w-logo {
  width: 66px; height: 66px; margin: 0 auto 20px; border-radius: 20px;
  display: flex; align-items: center; justify-content: center;
  color: var(--accent-ink); position: relative;
  background: linear-gradient(135deg, var(--accent), var(--accent-2));
  box-shadow: 0 12px 40px rgba(var(--accent-rgb),.42), inset 0 1px 0 rgba(255,255,255,.35);
}
#welcome .w-logo .icon { width: 46px; height: 46px; stroke-width: 1.5; }
#welcome h1 { font-size: 27px; font-weight: 750; letter-spacing: -.4px; margin-bottom: 9px; }
#welcome h1 em {
  font-style: normal;
  background: linear-gradient(100deg, var(--accent), var(--accent-2));
  -webkit-background-clip: text; background-clip: text; -webkit-text-fill-color: transparent;
}
#welcome .w-sub { color: var(--text-dim); font-size: 13.5px; margin-bottom: 8px; }
#welcome .w-env {
  display: inline-flex; flex-wrap: wrap; gap: 6px; justify-content: center;
  margin-bottom: 26px; max-width: 640px;
}
#welcome .w-env span {
  font-size: 10.5px; font-family: var(--font-mono); padding: 2px 9px; border-radius: 999px;
  background: var(--surface-2); border: 1px solid var(--border-2); color: var(--text-faint);
}
#welcome .w-env span.on { color: var(--success); border-color: rgba(var(--success-rgb),.35); }
#welcome .w-env span.off { color: var(--text-faint); }
#welcome .w-group-title {
  font-size: 11px; font-weight: 700; letter-spacing: .8px; text-transform: uppercase;
  color: var(--text-faint); text-align: left; max-width: 680px; margin: 0 auto 11px;
}
#welcome .tips { display: grid; gap: 11px; max-width: 680px; margin: 0 auto; text-align: left; grid-template-columns: repeat(2, 1fr); }
#welcome .tip {
  display: flex; gap: 11px; align-items: flex-start;
  padding: 13px 15px; border-radius: var(--r-md); cursor: pointer;
  background: var(--surface); border: 1px solid var(--border-2);
  color: var(--text-dim); font-size: 13px; line-height: 1.5;
  transition: transform .18s var(--ease), border-color .18s, color .18s, box-shadow .18s;
}
#welcome .tip:hover { border-color: rgba(var(--accent-rgb),.55); color: var(--text); transform: translateY(-2px); box-shadow: var(--shadow-2); }
#welcome .tip .tip-icon { color: var(--accent); flex: none; margin-top: 1px; }
#welcome .tip .tip-icon .icon { width: 17px; height: 17px; }
@media (max-width: 640px) { #welcome .tips { grid-template-columns: 1fr; } }

/* ============================================================================
   8. 输入区
   ============================================================================ */
#input-area { flex: none; padding: var(--d-input-y) 22px 12px; position: relative; }
#composer {
  max-width: var(--content-w); margin: 0 auto; position: relative;
  background: var(--surface); border: 1px solid var(--border);
  border-radius: var(--r-lg); box-shadow: var(--shadow-2);
  transition: border-color .18s, box-shadow .18s;
}
#composer:focus-within { border-color: rgba(var(--accent-rgb),.7); box-shadow: 0 0 0 4px rgba(var(--accent-rgb),.11), var(--shadow-2); }
#composer.drag-over { border-color: var(--accent); border-style: dashed; }
/* 斜杠命令浮窗(输入框里打 `/` 时出现):贴在输入区正上方,层级低于 .modal-mask(200)。
   宽度写死成 `min(--content-w, 容器宽−44px)` + `left/right:0` + auto 外边距 ——
   与输入框同宽同轴(用 left/right:22px + max-width 时 Chrome 会按内容做 shrink-to-fit,差 ~18px) */
#slash-menu {
  position: absolute; left: 0; right: 0; bottom: 100%;
  width: var(--content-w); max-width: calc(100% - 44px); margin: 0 auto 8px;
  display: none; z-index: 70; max-height: 260px; overflow-y: auto;
  background: var(--surface); border: 1px solid var(--border);
  border-radius: var(--r-md); box-shadow: var(--shadow-3); padding: 5px;
}
#slash-menu.open { display: block; animation: popIn .16s var(--ease); }
/* 待发送缓冲区浮窗(#slash-menu 先例:同轴同宽、贴输入框正上方;z-69 低于 #slash-menu 的 70)
   注:.sq-btn 两条规则必须带 #send-queue 作用域 —— 设置面板另有同名类(源序靠后者胜,会静默互相覆盖) */
#send-queue {
  position: absolute; left: 0; right: 0; bottom: 100%;
  width: var(--content-w); max-width: calc(100% - 44px); margin: 0 auto 8px;
  display: none; z-index: 69;
  background: var(--surface); border: 1px solid var(--border);
  border-radius: var(--r-md); box-shadow: var(--shadow-3); padding: 5px;
  max-height: 148px; overflow-y: auto;
}
#send-queue.open { display: block; animation: popIn .16s var(--ease); }
.sq-row { display: flex; align-items: center; gap: 6px; padding: 6px 8px; border-radius: var(--r-sm); }
.sq-row:hover { background: rgba(var(--accent-rgb), .07); }
.sq-text { flex: 1; min-width: 0; font-size: 12.5px; color: var(--text-dim);
  overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
#send-queue .sq-btn { width: 28px; height: 28px; flex: none; border-radius: var(--r-sm); border: none; background: transparent;
  display: flex; align-items: center; justify-content: center; color: var(--text-faint); cursor: pointer; }
#send-queue .sq-btn:hover { background: var(--surface-3); color: var(--text); }
.sq-hint { padding: 3px 8px 5px; font-size: 11px; color: var(--text-faint);
  overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
html[data-density="compact"] .sq-row { padding: 4px 7px; }
@media (max-width: 560px) { .sq-hint { display: none; } }
.slash-item {
  display: flex; align-items: baseline; gap: 9px; width: 100%; text-align: left;
  padding: 8px 10px; border-radius: var(--r-sm); border: 1px solid transparent;
  background: transparent; color: var(--text-dim); font: inherit; cursor: pointer;
}
.slash-item:hover, .slash-item.sel { background: rgba(var(--accent-rgb),.1); color: var(--text); border-color: rgba(var(--accent-rgb),.24); }
.slash-item b { flex: none; font-family: var(--font-mono); font-size: 12.5px; color: var(--text); }
.slash-item span { flex: 1; min-width: 0; font-size: 12.5px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.slash-item em { flex: none; font-style: normal; font-size: 11px; color: var(--text-faint); font-family: var(--font-mono); }
#input {
  width: 100%; border: none; outline: none; resize: none;
  background: transparent; color: var(--text);
  padding: 14px 16px 4px; font-size: 14.5px; line-height: 1.62;
  max-height: calc(1.62em * 5 + 18px);   /* 兜底 = 5 行(1.62em×5 + 14px 上 / 4px 下 padding);JS autoResize 按计算样式写入精确值 */
  overflow-y: auto; font-family: inherit;
}
#input::placeholder { color: var(--text-faint); }
.composer-bar { display: flex; align-items: center; gap: 7px; padding: 6px 9px 9px 12px; }
.composer-left, .composer-right { display: flex; align-items: center; gap: 5px; }
.composer-hint {
  flex: 1; min-width: 0; text-align: center; font-size: 11px; color: var(--text-faint);
  overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
}
.composer-hint kbd, kbd, .pal-esc {
  font-family: var(--font-mono); font-size: 10px;
  background: var(--surface-3); border: 1px solid var(--border);
  border-bottom-width: 2px; border-radius: 5px; padding: 1px 5px; margin: 0 1px; color: var(--text-dim);
  line-height: 1.6;
}
.pal-esc { flex: none; cursor: pointer; transition: color .14s, border-color .14s;
  /* 命中区下限 24px:与 kbd 共用规则只有 10×1.6 + 1×2 + (1+2) = 21 高 ⇒ 只给按钮补 min-height;
     正文里的按键提示(kbd)是行内件不是控件,一行不动 */
  min-height: 24px; display: inline-flex; align-items: center; justify-content: center; }
.pal-esc:hover { color: var(--text); border-color: rgba(var(--accent-rgb),.6); }
.pal-esc:active { transform: translateY(1px); border-bottom-width: 1px; }
.tool-btn {
  width: 32px; height: 32px; border-radius: var(--r-sm); flex: none;
  display: flex; align-items: center; justify-content: center;
  color: var(--text-faint); border: 1px solid transparent;
  transition: background .14s, color .14s, border-color .14s;
}
.tool-btn:hover { background: var(--surface-3); color: var(--text); }
.tool-btn.on { color: var(--accent); background: rgba(var(--accent-rgb),.13); border-color: rgba(var(--accent-rgb),.32); }
.tool-btn.rec { color: var(--danger); background: rgba(var(--danger-rgb),.14); border-color: rgba(var(--danger-rgb),.45); animation: pulse 1.3s infinite; }
.tool-btn:disabled { opacity: .38; cursor: not-allowed; }
#btn-send {
  width: 40px; height: 40px; border-radius: 13px; flex: none;
  display: flex; align-items: center; justify-content: center;
  color: var(--accent-ink); border: 1px solid transparent;
  background: linear-gradient(135deg, var(--accent), var(--accent-2));
  box-shadow: 0 4px 16px rgba(var(--accent-rgb),.34);
  transition: transform .16s var(--ease), box-shadow .16s, filter .16s;
}
#btn-send:hover { transform: translateY(-1px) scale(1.03); box-shadow: 0 8px 24px rgba(var(--accent-rgb),.46); }
#btn-send:active { transform: scale(.96); }
#btn-send .icon { width: 19px; height: 19px; }
#btn-send:disabled { background: var(--surface-3); color: var(--text-faint); box-shadow: none; transform: none; cursor: not-allowed; }
#btn-send.stop { background: linear-gradient(135deg, var(--danger), var(--danger-2)); color: #2a0209; }

/* 附件栏 */
#attach-bar { display: flex; flex-wrap: wrap; gap: 8px; padding: 11px 13px 0; }
#attach-bar:empty { display: none; }
.attach-chip {
  display: flex; align-items: center; gap: 7px;
  padding: 4px 6px 4px 5px; border-radius: 10px;
  background: var(--surface-2); border: 1px solid var(--border); font-size: 12px;
  max-width: 250px; cursor: grab; user-select: none;
}
.attach-chip:hover { border-color: rgba(var(--accent-rgb),.45); background: rgba(var(--accent-rgb),.06); }
.attach-chip.dragging { opacity: .45; }
.attach-chip.drag-over { border-color: var(--accent); box-shadow: 0 0 0 2px rgba(var(--accent-rgb),.25); }
.attach-chip img { width: 28px; height: 28px; border-radius: 7px; object-fit: cover; flex: none; }
.attach-chip .ac-ico { width: 28px; height: 28px; display: flex; align-items: center; justify-content: center;
                      color: var(--accent); background: rgba(var(--accent-rgb),.1); border-radius: 7px; flex: none; }
.attach-chip .ac-main { display: flex; flex-direction: column; gap: 1px; min-width: 0; }
.attach-chip .ac-name { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; color: var(--text-dim); }
.attach-chip .ac-sub { font-size: 10px; color: var(--text-faint); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.attach-chip .ac-rm { width: 19px; height: 19px; border-radius: 6px; display: flex; align-items: center; justify-content: center; color: var(--text-faint); flex: none; }
.attach-chip .ac-rm:hover { background: var(--surface-3); color: var(--danger); }
/* 解析中占位 chip(办公文档解析未完成时;虚线边框 + 次要色,进度写在文案里,不引动画) */
.attach-chip.pending { border-style: dashed; border-color: rgba(var(--accent-rgb),.5); cursor: default; }
.attach-chip.pending .ac-ico { color: var(--text-faint); background: var(--surface-3); }
.attach-chip.pending .ac-sub { color: var(--accent); }
.attach-count { align-self: center; font-size: 10.5px; color: var(--text-faint); font-family: var(--font-mono);
  padding: 2px 8px; border-radius: 999px; background: var(--surface-2); border: 1px solid var(--border-2); }

/* 气泡里的附件卡片(文本 / PDF):只显示文件名,内容点开弹窗看 */
.msg-attach { display: flex; flex-direction: column; gap: 7px; margin: 0 0 9px; }
.msg-attach:last-child { margin-bottom: 0; }
.file-card {
  display: flex; align-items: center; gap: 10px; text-align: left;
  padding: 8px 11px; border-radius: var(--r-sm); cursor: pointer;
  background: rgba(var(--accent-rgb),.07); border: 1px solid rgba(var(--accent-rgb),.26);
  max-width: 340px; transition: background .14s, border-color .14s;
}
.file-card:hover { background: rgba(var(--accent-rgb),.13); border-color: rgba(var(--accent-rgb),.45); }
.file-card .fc-ico { width: 30px; height: 30px; border-radius: 8px; flex: none;
  display: flex; align-items: center; justify-content: center;
  background: rgba(var(--accent-rgb),.16); color: var(--accent); }
.file-card .fc-main { min-width: 0; display: flex; flex-direction: column; gap: 2px; }
.file-card .fc-name { font-size: 12.5px; font-weight: 600; color: var(--text);
  overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.file-card .fc-sub { font-size: 10.5px; color: var(--text-faint); }
.file-card .fc-open { margin-left: auto; font-size: 10.5px; color: var(--accent); flex: none; }

/* 气泡里的图片:点击放大 */
.msg-content img.inline-thumb, .msg-media img { cursor: zoom-in; }
.msg-media { display: flex; flex-wrap: wrap; gap: 8px; margin: 0 0 9px; }
.msg-media img.inline-thumb { max-width: 190px; max-height: 190px; object-fit: cover; border-radius: 10px;
  border: 1px solid var(--border); background: var(--surface-2); }
.msg-media + .msg-attach { margin-top: 0; }
.ocr-note { margin-top: 6px; font-size: 11px; color: var(--text-faint); font-style: italic; }
.msg-content pre.ocr-text { max-height: 132px; margin: 6px 0 0; padding: 9px 11px;
  font-size: 11.5px; white-space: pre-wrap; word-break: break-word; color: var(--text-dim);
  font-family: var(--font-mono); border-radius: 8px; align-self: flex-start;
  background: var(--bg-2); border: 1px solid var(--border);
  overflow: auto; overscroll-behavior: contain; -webkit-overflow-scrolling: touch;
  scrollbar-width: thin; }

/* 附件预览弹窗(只能点 ✕ 关) */
.fp-meta { font-size: 11.5px; color: var(--text-faint); margin-bottom: 9px; }
.fp-body { margin: 0; padding: 11px 13px; border-radius: var(--r-sm); background: var(--bg-2);
  border: 1px solid var(--border); max-height: 52vh; overflow: auto;
  font-family: var(--font-mono); font-size: 12px; line-height: 1.62; white-space: pre-wrap; word-break: break-word; }
.fp-images { display: flex; flex-wrap: wrap; gap: 9px; }
.fp-images img { max-width: 150px; max-height: 200px; border-radius: 8px; border: 1px solid var(--border); cursor: zoom-in; }

/* 参数浮层 */
.popover {
  position: absolute; z-index: 60; min-width: 260px;
  background: var(--surface); border: 1px solid var(--border);
  border-radius: var(--r-md); box-shadow: var(--shadow-3); padding: 13px;
  display: none;
}
.popover.open { display: block; animation: popIn .16s var(--ease); }
@keyframes popIn { from { opacity: 0; transform: translateY(6px) scale(.98); } }
.pop-title { font-size: 11px; font-weight: 700; letter-spacing: .7px; text-transform: uppercase; color: var(--text-faint); margin-bottom: 10px; }
.pop-title .icon { vertical-align: -2px; margin-right: 4px; }
.pop-title .pop-sub { float: right; text-transform: none; letter-spacing: 0; font-weight: 500; }
/* 「调节」浮层的「工具」分组:分隔线 + 小标题 + 收紧的开关行 */
.pop-sep { height: 1px; background: var(--border-2); margin: 2px 0 12px; }
.pop-sub-title { font-size: 11px; font-weight: 700; letter-spacing: .7px; text-transform: uppercase; color: var(--text-faint); margin-bottom: 4px; }
#params-pop .switch-row { padding: 6px 0; border-bottom: none; }
/* 浮层的底部动作行(「调节」的完成 / 恢复默认 · 「上下文用量」的读取模型信息 / 关闭):
   内容高于浮层上限(cap)时**吸底** ⇒ 任意内容高度下两键都完整可见可点(浮层自身内滚,
   内容不再把动作行切在按钮中段)。
   由来:F5 —— 「调节」动作行原为最后一行内容,内容 752px > cap 720px 时只露 13px、中心点不可命中;
        F11 —— 「上下文用量」同源未修(measured 态溢出 46px ⇒ 1600×900 裁 32.56px、四视口末行整行
        落在可视盒之外、逐点扫描绘制像素 = 0),同一手法只修了一半。
   做法 = 浮层下内边距交给动作行自带(同值 13px)⇒ **未溢出时逐像素不变**(动作行是最后一个子元素时,
   盒底已贴住含块下沿 ⇒ sticky 无位移空间;只有溢出被内滚裁时才贴住浮层下沿)。
   注意:浮层 `padding-bottom:0` 与动作行的 13px **必须成对**(单加一边会在未溢出态多/少 13px)。 */
#params-pop, #ctx-pop { padding-bottom: 0; }
#params-pop .pop-actions, #ctx-pop .pop-actions { position: sticky; bottom: 0; z-index: 1; padding-bottom: 13px; background: var(--surface); }
#params-pop .switch-row .sw-txt label { font-size: 13px; }

/* ---- 输入区上下文用量环 ---- */
.ctx-meter {
  display: flex; align-items: center; gap: 6px; height: 32px; padding: 0 8px 0 10px;
  border-radius: var(--r-sm); border: 1px solid var(--border); background: var(--bg-2);
  transition: border-color .16s, background .16s;
}
.ctx-meter:hover { border-color: rgba(var(--accent-rgb),.5); background: var(--surface-2); }
.ctx-meter.on { border-color: var(--accent); background: rgba(var(--accent-rgb),.1); }
.cm-num {
  font-family: var(--font-mono); font-size: 11.5px; color: var(--text-dim);
  white-space: nowrap; letter-spacing: -.2px;
}
.ctx-meter.warn .cm-num { color: var(--warning); }
.ctx-meter.danger .cm-num { color: var(--danger); }
.cm-ring { width: 22px; height: 22px; flex: none; transform: rotate(-90deg); }
.cm-ring .cm-track { fill: none; stroke: var(--surface-3); stroke-width: 4; }
.cm-ring .cm-bar {
  fill: none; stroke: var(--accent); stroke-width: 4; stroke-linecap: round;
  stroke-dasharray: 94.248; stroke-dashoffset: 94.248;
  transition: stroke-dashoffset .28s var(--ease), stroke .2s;
}
.ctx-meter.warn .cm-bar { stroke: var(--warning); }
.ctx-meter.danger .cm-bar { stroke: var(--danger); }
.ctx-pop .ctx-hero {
  display: flex; align-items: center; gap: 12px; padding: 9px 12px; margin-bottom: 9px;
  border-radius: var(--r-sm); border: 1px solid var(--border-2);
  background: linear-gradient(135deg, rgba(var(--accent-rgb),.12), transparent 70%);
}
.ctx-pop .ctx-hero .big {
  font-family: var(--font-mono); font-size: 20px; font-weight: 650; color: var(--text);
  line-height: 1.15; white-space: nowrap;
}
.ctx-pop .ctx-hero .big small { font-size: 12px; color: var(--text-faint); font-weight: 500; }
.ctx-pop .ctx-hero .sub { font-size: 11.5px; color: var(--text-faint); margin-top: 3px; }
.ctx-pop .ctx-hero .ring-wrap { flex: none; }
.ctx-pop .ctx-hero svg.cm-big { width: 54px; height: 54px; transform: rotate(-90deg); }
.ctx-pop .ctx-hero svg.cm-big .cm-track { fill: none; stroke: var(--surface-3); stroke-width: 3.4; }
.ctx-pop .ctx-hero svg.cm-big .cm-bar {
  fill: none; stroke: var(--accent); stroke-width: 3.4; stroke-linecap: round;
  stroke-dasharray: 94.248; stroke-dashoffset: 94.248;
}
.ctx-pop .ctx-hero.warn svg.cm-big .cm-bar { stroke: var(--warning); }
.ctx-pop .ctx-hero.danger svg.cm-big .cm-bar { stroke: var(--danger); }
.ctx-pop .kv { font-size: 12px; gap: 5px 14px; }
.ctx-pop .ctx-sect { margin: 11px 0 6px; font-size: 10.5px; font-weight: 700; letter-spacing: .6px;
  text-transform: uppercase; color: var(--text-faint); }
.ctx-pop .meter { margin-top: 4px; }
.ctx-bar-legend { display: flex; justify-content: space-between; font-size: 10.5px; color: var(--text-faint); margin-top: 4px; }

/* 状态栏 */
#status-bar {
  height: var(--status-h); flex: none; display: flex; align-items: center; gap: 14px;
  padding: 0 16px; border-top: 1px solid var(--border-2);
  background: var(--bg-2); font-size: 11px; color: var(--text-faint);
  font-family: var(--font-mono); overflow-x: auto; white-space: nowrap;
}
#status-bar .st { display: flex; align-items: center; gap: 5px; flex: none; }
#status-bar .st .icon { width: 12px; height: 12px; }
#status-bar .st b { font-weight: 600; color: var(--text-dim); }
#status-bar .st.ok b { color: var(--success); }
#status-bar .st.run b { color: var(--accent); }   /* 运行中(accent)不等同于"成功"(绿) */
#status-bar .st.warn b { color: var(--warning); }
#status-bar .st.err b { color: var(--danger); }
#status-bar .spacer { flex: 1; }
#status-bar .st.clickable, #status-bar .st[data-click] { cursor: pointer; border-radius: 5px; padding: 2px 6px; margin: 0 -6px;
  /* 命中区下限 24px:芯片内容 17.81 + 2×2 = 21.81 ⇒ 补到 24(状态行 --status-h:28 装得下,不换行不溢出) */
  min-height: 24px; }
#status-bar .st.clickable:hover, #status-bar .st[data-click]:hover { background: var(--surface-2); color: var(--text); }

/* 滚动按钮 */
.float-btn {
  position: absolute; right: 26px; z-index: 30;
  width: 38px; height: 38px; border-radius: 50%;
  display: none; align-items: center; justify-content: center;
  background: var(--surface); border: 1px solid var(--border);
  box-shadow: var(--shadow-2); color: var(--text-dim);
  transition: color .15s, border-color .15s, transform .15s, opacity .18s;
}
.float-btn.show { display: flex; }
.float-btn:hover { color: var(--accent); border-color: rgba(var(--accent-rgb),.6); transform: translateY(-2px); }
#btn-scroll-bottom { bottom: 22px; }
#btn-scroll-top { bottom: 68px; }
#btn-scroll-top .icon { transform: rotate(180deg); }

/* ============================================================================
   9. 模态框
   ============================================================================ */
.modal-mask {
  position: fixed; inset: 0; z-index: 200; padding: 22px;
  display: none; align-items: center; justify-content: center;
  background: var(--overlay);
  backdrop-filter: blur(5px); -webkit-backdrop-filter: blur(5px);
}
.modal-mask.open { display: flex; }
/* 动态输入弹窗(新建 / 改名工作区等)要能压在设置弹窗之上 */
.modal-mask.on-top { z-index: 500; }
.modal {
  width: 100%; max-width: 620px; max-height: 88vh; display: flex; flex-direction: column;
  background: var(--surface); border: 1px solid var(--border);
  border-radius: var(--r-lg); box-shadow: var(--shadow-3); overflow: hidden;
  animation: modalIn .2s var(--ease);
}
@keyframes modalIn { from { opacity: 0; transform: scale(.965) translateY(8px); } }
.modal.narrow { max-width: 460px; }
.modal.wide { max-width: 860px; }
.modal-head {
  flex: none; display: flex; align-items: center; gap: 10px;
  padding: 16px 18px 13px; border-bottom: 1px solid var(--border-2);
}
.modal-head h2 { font-size: 16px; font-weight: 680; flex: 1; display: flex; align-items: center; gap: 9px; }
.modal-head h2 .icon { color: var(--accent); }
.modal-body { flex: 1; overflow-y: auto; padding: 16px 18px 20px; }
.modal-foot {
  flex: none; display: flex; gap: 10px; padding: 13px 18px;
  border-top: 1px solid var(--border-2); background: var(--surface-2);
}
.modal-foot .grow { flex: 1; }

/* 关于弹窗(hero + 教程卡):作者名 / 链接 / 版本全部由 JS 从 appA 的常量填充,
   样式只认元素与既有变量 —— 类名只用 .about-hero / .about-group / .about-card 三个 */
.about-hero {
  display: flex; align-items: center; gap: 13px; padding: 13px 15px;
  border: 1px solid var(--border); border-radius: var(--r-md); text-decoration: none;
  background: linear-gradient(135deg, rgba(var(--accent-rgb),.14), rgba(var(--accent-rgb),.03) 62%, transparent);
  transition: border-color .16s, transform .16s, box-shadow .16s;
}
.about-hero:hover { border-color: rgba(var(--accent-rgb),.55); transform: translateY(-1px); box-shadow: var(--shadow-2); }
.about-hero > i {
  width: 42px; height: 42px; flex: none; border-radius: 12px;
  display: flex; align-items: center; justify-content: center;
  background: var(--surface); border: 1px solid var(--border); color: var(--accent);
}
.about-hero > i .icon { width: 22px; height: 22px; }
.about-hero > span { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 3px; }
.about-hero > span b { font-size: 15.5px; color: var(--text); }
.about-hero > span small { font-size: 11.5px; color: var(--text-faint); }
.about-hero > em {
  flex: none; display: flex; flex-direction: column; align-items: flex-end; gap: 3px;
  font-style: normal; font-family: var(--font-mono); font-size: 11.5px; color: var(--text-dim);
}
.about-group { display: flex; flex-direction: column; gap: 9px; }
.about-card { border: 1px solid var(--border-2); border-radius: var(--r-md); padding: 11px 13px 12px; background: var(--surface-2); }
.about-card > b { display: flex; align-items: center; gap: 8px; font-size: 13px; margin-bottom: 6px; }
.about-card > b .icon { width: 15px; height: 15px; color: var(--accent); }
.about-card ul { margin: 0; padding-left: 17px; display: flex; flex-direction: column; gap: 4px; color: var(--text-dim); font-size: 12.5px; line-height: 1.62; }
.about-card li::marker { color: rgba(var(--accent-rgb),.8); }

/* 摘要气泡(「上下文已压缩」):默认折叠,点一下展开;Ctrl+O 亦可 */
.compact-card { border: 1px solid rgba(var(--accent-rgb),.3); border-radius: var(--r-md); padding: 12px 14px;
  background: linear-gradient(180deg, rgba(var(--accent-rgb),.09), transparent); }
.compact-card .cc-head { display: flex; align-items: center; gap: 8px; cursor: pointer; flex-wrap: wrap; }
.compact-card .cc-head .icon { color: var(--accent); }
.compact-card .cc-title { font-weight: 700; font-size: 13px; }
.compact-card .cc-chip {
  font-family: var(--font-mono); font-size: 10px; padding: 1px 7px; border-radius: 999px;
  background: var(--surface-2); border: 1px solid var(--border-2); color: var(--text-faint); white-space: nowrap;
}
.compact-card .cc-more { margin-left: auto; font-size: 11.5px; color: var(--accent); white-space: nowrap; }
.compact-card .cc-body { display: none; margin-top: 10px; padding-top: 10px; border-top: 1px dashed rgba(var(--accent-rgb),.32); }
.compact-card.expanded .cc-body { display: block; }
.compact-card .cc-body .msg-content { font-size: 13px; line-height: 1.75; color: var(--text-dim); }

/* 压缩工具气泡(U-4):`.cx-card` = 三态共同壳类(完成 .cx-sum / 运行中 .cx-run / 失败 .cx-fail)。
   覆盖一律写在 `.cx-card .tool-card .<子选择器>` 作用域内 —— .cx-card 在消息壳上,.tool-card 是
   renderToolCard 在壳内清空重建的卡片根,二者是祖代—后代关系(不改 .tool-card 自身规则)。 */
.msg.cx-card { display: block; }
.cx-card .tool-card .tc-head { flex-wrap: wrap; min-height: 24px; }
.cx-card .tool-card .cx-chips { flex-basis: 100%; display: flex; flex-wrap: wrap; gap: 5px; margin-top: 3px; }
.cx-card .tool-card .cx-chips .cc-chip {
  font-family: var(--font-mono); font-size: 11.5px; padding: 1px 7px; border-radius: 999px;
  background: var(--surface-2); border: 1px solid var(--border-2); color: var(--text-dim); white-space: nowrap;
}
.cx-card .tool-card .tc-ops .btn { min-height: 24px; }
.cx-card .tool-card .cx-sum-body { font-size: 13.5px; line-height: 1.75; }
.cx-card .tool-card .cx-live { margin-top: 10px; padding-top: 9px; border-top: 1px dashed rgba(var(--accent-rgb),.32); }
.cx-card .tool-card .cx-live .cx-stage { font-size: 12px; color: var(--text-dim); line-height: 1.7; }
.cx-card .tool-card .cx-live .cx-stage::before { content: "· "; color: var(--accent); }
.cx-card .tool-card .cx-live .cx-elapsed { font-family: var(--font-mono); font-size: 11px; color: var(--text-faint); margin-top: 4px; }
.cx-card .tool-card .cx-live .cx-stream {
  font-family: var(--font-mono); font-size: 11.5px; line-height: 1.62; color: var(--text-dim);
  white-space: pre-wrap; overflow-wrap: anywhere; margin-top: 6px; padding-top: 6px;
  border-top: 1px dashed var(--border-2); max-height: min(40vh, 420px); overflow-y: auto;
}
.cx-run .tool-card .tc-arrow, .cx-fail .tool-card .tc-arrow { display: none; }
.cx-run .tool-card .tc-head, .cx-fail .tool-card .tc-head { cursor: default; }
@media (max-width: 880px) { .cx-card .tool-card .tc-sum { display: none; } }
[data-density="compact"] .cx-card .tool-card .cx-live .cx-stream { max-height: 22vh; }

/* 标签页 */
.tabs { flex: none; display: flex; gap: 3px; padding: 0 18px; border-bottom: 1px solid var(--border-2);
        overflow-x: auto; background: var(--surface); }
.tabs button {
  padding: 10px 13px 9px; font-size: 12.5px; font-weight: 600; color: var(--text-faint);
  border-bottom: 2px solid transparent; white-space: nowrap; margin-bottom: -1px;
  display: flex; align-items: center; gap: 6px;
}
.tabs button:hover { color: var(--text); }
.tabs button.active { color: var(--accent); border-bottom-color: var(--accent); }
.tab-panel { display: none; }
.tab-panel.active { display: block; animation: fadeIn .18s var(--ease); }
@keyframes fadeIn { from { opacity: 0; } }
/* 窄屏:8 个标签放不下,让按钮保持自然宽度、整行横向滚动(隐藏滚动条),别把文字挤成一团 */
@media (max-width: 760px) {
  .tabs { scrollbar-width: none; -ms-overflow-style: none; }
  .tabs::-webkit-scrollbar { height: 0; }
  .tabs button { flex: none; padding: 10px 10px 9px; font-size: 12px; }
}
@media (max-width: 560px) {
  .tabs button .icon { display: none; }
  .tabs button { padding: 10px 8px 9px; gap: 0; }
}

/* 表单 */
.field { margin-bottom: 18px; }
.field:last-child { margin-bottom: 0; }
.field > label, .field-label {
  display: block; font-size: 12px; font-weight: 650; color: var(--text-dim);
  margin-bottom: 7px; letter-spacing: .2px;
}
.field input[type="text"], .field input[type="password"], .field input[type="number"],
.field textarea, .field select, .inp {
  width: 100%; padding: 9px 12px; border-radius: var(--r-sm);
  border: 1px solid var(--border); background: var(--bg-2);
  font-size: 13.5px; outline: none; transition: border-color .16s, box-shadow .16s;
}
.field select { appearance: none; -webkit-appearance: none; padding-right: 32px;
  background-image: linear-gradient(45deg, transparent 50%, var(--text-faint) 50%),
                    linear-gradient(135deg, var(--text-faint) 50%, transparent 50%);
  background-position: calc(100% - 17px) 50%, calc(100% - 12px) 50%;
  background-size: 5px 5px, 5px 5px; background-repeat: no-repeat; }
.field input:focus, .field textarea:focus, .field select:focus, .inp:focus {
  border-color: var(--accent); box-shadow: 0 0 0 3px rgba(var(--accent-rgb),.12);
}
.field textarea { resize: vertical; line-height: 1.6; font-family: inherit; }
.field .hint { font-size: 11.5px; color: var(--text-faint); margin-top: 6px; line-height: 1.6; }
/* 面板里紧跟控件/仪表条的说明文字,要和上面的控件拉开距离(否则贴着看着挤) */
.tab-panel .hint.gap-top { margin-top: 14px; }
.hint.multi { white-space: pre-line; }
/* 占用排行:每行「名字 + 消息数 / 占用体积 / 操作」,最多 10 条,超出自身滚动 */
#ds-rank { max-height: 168px; overflow-y: auto; }   /* 一次露 3 条,其余滚动 */
.rank-row { display: flex; align-items: center; gap: 10px; padding: 8px 10px; border-radius: var(--r-sm);
  border: 1px solid var(--border); background: var(--surface-2); margin-bottom: 7px; }
.rank-row:last-child { margin-bottom: 0; }
.rank-row:hover { border-color: rgba(var(--accent-rgb),.45); }
.rank-row .rr-main { min-width: 0; flex: 1; }
.rank-row .rr-name { font-size: 12.5px; font-weight: 600; color: var(--text);
  overflow: hidden; text-overflow: ellipsis; white-space: nowrap; display: block; }
.rank-row .rr-sub { font-size: 10.5px; color: var(--text-faint); margin-top: 2px;
  overflow: hidden; text-overflow: ellipsis; white-space: nowrap; display: block; }
.rank-row .rr-size { flex: none; font-family: var(--font-mono); font-size: 12px; color: var(--accent); }
.rank-row .rr-ops { flex: none; display: flex; gap: 6px; }
/* 清理空间弹窗里的勾选项 */
.space-opt { display: flex; align-items: flex-start; gap: 10px; padding: 10px 11px; border-radius: var(--r-sm);
  border: 1px solid var(--border); background: var(--surface-2); margin-bottom: 8px; cursor: pointer; }
.space-opt:hover { border-color: rgba(var(--accent-rgb),.45); }
.space-opt input { margin-top: 2px; flex: none; }
.space-opt .so-main { min-width: 0; flex: 1; display: flex; flex-direction: column; gap: 4px; }
.space-opt .so-title { display: block; font-size: 12.5px; font-weight: 600; color: var(--text); }
.space-opt .so-desc { display: block; font-size: 11px; color: var(--text-faint); line-height: 1.65; }
.space-opt .so-est { font-family: var(--font-mono); color: var(--accent); }
.hint.multi { font-size: 11.5px; line-height: 1.7; }
.field-row { display: flex; gap: 13px; }
.field-row .field { flex: 1; min-width: 0; }
.sec-title {
  font-size: 11px; font-weight: 700; letter-spacing: .8px; text-transform: uppercase;
  color: var(--text-faint); margin: 22px 0 11px; padding-bottom: 7px;
  border-bottom: 1px solid var(--border-2);
}
.sec-title:first-child { margin-top: 0; }
.input-wrap { position: relative; }
.input-wrap .reveal {
  position: absolute; right: 7px; top: 50%; transform: translateY(-50%);
  width: 28px; height: 28px; border-radius: 7px;
  display: flex; align-items: center; justify-content: center; color: var(--text-faint);
}
.input-wrap .reveal:hover { background: var(--surface-3); color: var(--text); }
/* 模型名称的主题化候选浮层(替代原生 datalist,原生弹层没法跟主题走) */
#model-suggest {
  position: fixed; z-index: 400; display: none; padding: 5px; max-height: 260px; overflow-y: auto;
  background: var(--surface); border: 1px solid var(--border); border-radius: var(--r-md);
  box-shadow: var(--shadow-2);
}
#model-suggest.open { display: block; animation: popIn .14s var(--ease); }
#model-suggest button {
  display: flex; align-items: center; gap: 9px; width: 100%; padding: 8px 10px;
  border-radius: var(--r-sm); font-size: 12.5px; color: var(--text-dim); text-align: left;
}
#model-suggest button:hover { background: var(--surface-2); color: var(--text); }
#model-suggest button.on { background: rgba(var(--accent-rgb),.13); color: var(--accent); }
#model-suggest .ms-name { flex: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
  font-family: var(--font-mono); font-size: 12px; }
#model-suggest .ms-src { flex: none; font-size: 10.5px; color: var(--text-faint); }
#model-suggest .ms-empty { padding: 9px 11px; font-size: 12px; color: var(--text-faint); }
.input-row { display: flex; align-items: center; gap: 8px; }
.input-row .input-wrap, .input-row .grow { flex: 1; min-width: 0; }
.sq-btn {
  flex: none; width: 37px; height: 37px; border-radius: var(--r-sm);
  display: flex; align-items: center; justify-content: center;
  color: var(--text-dim); background: var(--surface-2); border: 1px solid var(--border);
  transition: background .15s, color .15s, border-color .15s;
}
.sq-btn:hover { background: var(--surface-3); color: var(--accent); border-color: rgba(var(--accent-rgb),.5); }

/* 协议切换 */
.seg { display: flex; background: var(--bg-2); border: 1px solid var(--border); border-radius: var(--r-sm); padding: 4px; gap: 4px; }
.seg button {
  flex: 1; display: flex; align-items: center; justify-content: center; gap: 6px;
  padding: 8px; border-radius: 7px; font-size: 12.5px; font-weight: 600;
  color: var(--text-dim); transition: all .16s; text-align: center;
}
.seg button .icon { flex: none; }
.seg button:hover { color: var(--text); }
.seg button.active { background: rgba(var(--accent-rgb),.16); color: var(--accent); box-shadow: inset 0 0 0 1px rgba(var(--accent-rgb),.4); }
.seg button.openai.active { background: rgba(16,185,129,.16); color: #10b981; box-shadow: inset 0 0 0 1px rgba(16,185,129,.45); }
.seg button.anthropic.active { background: rgba(224,134,95,.16); color: #e0865f; box-shadow: inset 0 0 0 1px rgba(224,134,95,.45); }

/* 开关 */
.switch-row {
  display: flex; align-items: center; justify-content: space-between; gap: 14px;
  padding: 10px 0; border-bottom: 1px solid var(--border-2);
}
.switch-row:last-child { border-bottom: none; }
.switch-row .sw-txt { min-width: 0; }
.switch-row .sw-txt label { font-size: 13.5px; color: var(--text); display: block; }
.switch-row .sw-txt small { font-size: 11.5px; color: var(--text-faint); display: block; margin-top: 2px; line-height: 1.5; }
.switch { position: relative; width: 42px; height: 23px; flex: none; }
.switch input { position: absolute; opacity: 0; width: 0; height: 0; }
.switch .slider {
  position: absolute; inset: 0; border-radius: 999px; cursor: pointer;
  background: var(--surface-3); border: 1px solid var(--border); transition: background .2s, border-color .2s;
}
.switch .slider::before {
  content: ""; position: absolute; left: 2px; top: 2px; width: 17px; height: 17px;
  border-radius: 50%; background: var(--text-faint); transition: transform .2s var(--ease), background .2s;
}
.switch input:checked + .slider { background: rgba(var(--accent-rgb),.85); border-color: var(--accent); }
.switch input:checked + .slider::before { transform: translateX(19px); background: #fff; }
.switch input:focus-visible + .slider { box-shadow: 0 0 0 3px rgba(var(--accent-rgb),.3); }
/* 小号开关:给工具行里的单项配置用(如 FileOps 的「允许删除 / 允许覆盖」) */
.switch.sm { width: 34px; height: 19px; }
.switch.sm .slider::before { width: 13px; height: 13px; }
.switch.sm input:checked + .slider::before { transform: translateX(15px); }

/* 滑块行 */
.range-row { display: flex; align-items: center; gap: 11px; }
.r-lab { width: 70px; flex: none; font-size: 11.5px; color: var(--text-dim); }
.range-row input[type="range"] {
  flex: 1; min-width: 0; height: 4px; border-radius: 3px; appearance: none; -webkit-appearance: none;
  background: var(--surface-3); outline: none; accent-color: var(--accent);
}
.range-row input[type="range"]::-webkit-slider-thumb {
  -webkit-appearance: none; width: 15px; height: 15px; border-radius: 50%;
  background: var(--accent); cursor: pointer; border: 2px solid var(--surface);
  box-shadow: 0 0 0 1px rgba(var(--accent-rgb),.5);
}
.range-row input[type="range"]::-moz-range-thumb {
  width: 13px; height: 13px; border-radius: 50%; background: var(--accent);
  cursor: pointer; border: 2px solid var(--surface);
}
.range-row .val {
  width: 58px; text-align: right; font-family: var(--font-mono);
  font-size: 12px; color: var(--text-dim); flex: none;
}
.range-row .val input { width: 58px; text-align: right; padding: 4px 6px; font-size: 12px;
  border-radius: 7px; border: 1px solid var(--border); background: var(--bg-2); font-family: var(--font-mono); outline: none; }
/* 上下文长度(手动设定):滑块 + K 数字输入 + 单位 —— 显示形如 256K */
.range-row .val.ctxk { width: 86px; display: flex; align-items: center; gap: 3px; justify-content: flex-end; }
.range-row .val.ctxk input { width: 56px; }
.range-row .val.ctxk i { font-style: normal; font-size: 11px; color: var(--text-dim); }

/* ---- 主题化下拉控件(替代原生 select,配色跟随主题) ---- */
.nsel { position: relative; }
.nsel-flex { flex: 1; min-width: 0; }
.nsel-btn {
  width: 100%; display: flex; align-items: center; gap: 9px;
  padding: 8px 11px; border-radius: var(--r-sm); border: 1px solid var(--border);
  background: var(--bg-2); font-size: 13px; text-align: left; color: var(--text);
  transition: border-color .16s, box-shadow .16s, background .16s;
}
.nsel-btn:hover { border-color: rgba(var(--accent-rgb),.5); background: var(--surface-2); }
.nsel.open .nsel-btn { border-color: var(--accent); box-shadow: 0 0 0 3px rgba(var(--accent-rgb),.13); }
.nsel-val { flex: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.nsel-val .nsv-none { color: var(--text-faint); }
.nsel-val .nsv-tag {
  margin-left: 7px; padding: 1px 7px; border-radius: 999px; font-size: 10.5px;
  background: rgba(var(--accent-rgb),.14); color: var(--accent); border: 1px solid rgba(var(--accent-rgb),.3);
  font-family: var(--font-mono);
}
.nsel-arrow { flex: none; color: var(--text-faint); transition: transform .2s var(--ease); }
.nsel.open .nsel-arrow { transform: rotate(180deg); color: var(--accent); }
#nsel-pop {
  position: fixed; z-index: 400; min-width: 190px; max-width: min(360px, calc(100vw - 16px));
  background: var(--surface); border: 1px solid var(--border); border-radius: var(--r-md);
  box-shadow: var(--shadow-2); padding: 5px; display: none; max-height: 300px; overflow-y: auto;
}
#nsel-pop.open { display: block; animation: popIn .15s var(--ease); }
.nsel-opt {
  width: 100%; display: flex; align-items: flex-start; gap: 9px; padding: 8px 10px;
  border-radius: var(--r-sm); font-size: 13px; text-align: left; color: var(--text-dim);
}
.nsel-opt:hover, .nsel-opt.hl { background: var(--surface-2); color: var(--text); }
.nsel-opt.sel { background: rgba(var(--accent-rgb),.13); color: var(--accent); }
.nso-main { flex: 1; min-width: 0; }
.nso-main b { font-weight: 650; font-size: 13px; }
.nso-desc { display: block; font-size: 11.5px; font-weight: 400; color: var(--text-faint); margin-top: 4px; line-height: 1.5; }
.nsel-opt.sel .nso-desc { color: var(--text-dim); }
.nso-tick { flex: none; opacity: 0; color: var(--accent); margin-top: 1px; }
.nsel-opt.sel .nso-tick { opacity: 1; }

/* 测试结果 / 提示块 */
.note {
  margin-top: 11px; padding: 10px 13px; border-radius: var(--r-sm);
  font-size: 12.5px; display: none; line-height: 1.65;
  border: 1px solid var(--border); background: var(--surface-2); color: var(--text-dim);
}
.note.show { display: block; }
.note.ok { background: rgba(var(--success-rgb),.09); border-color: rgba(var(--success-rgb),.36); color: var(--success); white-space: pre-wrap; word-break: break-word; }
.note.err { background: rgba(var(--danger-rgb),.09); border-color: rgba(var(--danger-rgb),.36); color: var(--danger); white-space: pre-wrap; word-break: break-word; }
.note.warn { background: rgba(var(--warning-rgb),.09); border-color: rgba(var(--warning-rgb),.36); color: var(--warning); }

.kv { display: grid; grid-template-columns: max-content minmax(0, 1fr); gap: 7px 16px; font-size: 12.5px; align-items: baseline; }
.kv dt { color: var(--text-faint); white-space: nowrap; }
.kv dd { color: var(--text); font-family: var(--font-mono); font-size: 12px; overflow-wrap: anywhere; word-break: break-word; }
.kv dd.ok { color: var(--success); }
.kv dd.bad { color: var(--danger); }

/* 数据用量条 */
.meter { height: 7px; border-radius: 4px; background: var(--surface-3); overflow: hidden; margin-top: 7px; }
.meter > i { display: block; height: 100%; border-radius: 4px; background: linear-gradient(90deg, var(--accent), var(--accent-2)); transition: width .3s; }
.meter.warn > i { background: linear-gradient(90deg, var(--warning), var(--warning-2)); }
.meter.err > i { background: linear-gradient(90deg, var(--danger), var(--danger-2)); }

/* 主题/强调色选择 */
.swatches { display: flex; gap: 7px; flex-wrap: wrap; }
.swatch {
  width: 34px; height: 34px; border-radius: 50%; border: 2px solid transparent;
  position: relative; transition: transform .15s var(--ease), border-color .15s;
}
.swatch:hover { transform: scale(1.1); }
.swatch.active { border-color: var(--text); }
.swatch.active::after {
  content: ""; position: absolute; inset: -6px; border-radius: 50%;
  border: 1px solid rgba(var(--accent-rgb),.55);
}
.swatch[data-accent="mint"]     { background: linear-gradient(135deg,#a9f0d3,#5fc9a4); }
.swatch[data-accent="sakura"]   { background: linear-gradient(135deg,#ffcbd8,#f58ba6); }
.swatch[data-accent="lavender"] { background: linear-gradient(135deg,#d8cdfb,#a68ff0); }
.swatch[data-accent="sky"]      { background: linear-gradient(135deg,#c2e3ff,#77b8f2); }
.swatch[data-accent="peach"]    { background: linear-gradient(135deg,#ffd8c0,#f5a273); }
.swatch[data-accent="lemon"]    { background: linear-gradient(135deg,#fff1c9,#f0cb63); }
.swatch[data-accent="matcha"]   { background: linear-gradient(135deg,#dcf5bc,#a6d165); }
.swatch[data-accent="lilac"]    { background: linear-gradient(135deg,#f2dcf5,#cd8fd6); }
.swatch[data-accent="aqua"]     { background: linear-gradient(135deg,#c9f6f1,#63cfc4); }
.swatch[data-accent="coral"]    { background: linear-gradient(135deg,#ffd0da,#f58099); }
.swatch[data-accent="taro"]     { background: linear-gradient(135deg,#e3d8f8,#ab92e0); }
.swatch[data-accent="cream"]    { background: linear-gradient(135deg,#ffebd2,#f0bd74); }

/* 自定义标签页图标(设置 → 外观):预览块 + 拖放,视觉语言对齐 #composer.drag-over */
.fav-row { display: flex; align-items: center; gap: 13px; }
.fav-preview {
  flex: none; width: 46px; height: 46px; padding: 0; overflow: hidden;
  border: 1px solid var(--border); border-radius: var(--r-sm); background: var(--surface-2);
  display: flex; align-items: center; justify-content: center; cursor: pointer;
  transition: border-color .16s, background .16s;
}
.fav-preview:hover { border-color: rgba(var(--accent-rgb),.5); background: var(--surface-3); }
.fav-preview.drop-over { border-color: var(--accent); border-style: dashed; box-shadow: 0 0 0 2px rgba(var(--accent-rgb),.22); }
.fav-preview img { width: 100%; height: 100%; object-fit: contain; display: block; }
.fav-meta { min-width: 0; flex: 1; }
.fav-cur { font-size: 12px; color: var(--text-faint); margin-bottom: 7px; }
.fav-btns { display: flex; gap: 8px; flex-wrap: wrap; }

/* 桌面快捷方式(.url + 自定义 .ico):命名一律 dsk-*,与既有数据面板的 ds-* 家族(含 #ds-hint)严格隔离 */
.dsk-state { font-size: 12px; color: var(--text-faint); margin-bottom: 7px; white-space: pre-line; }
.dsk-btns { display: flex; gap: 8px; flex-wrap: wrap; }
.dsk-warn { color: var(--danger); }

/* 下拉菜单 */
.pop-menu {
  position: fixed; z-index: 300; min-width: 178px; padding: 5px;
  background: var(--surface); border: 1px solid var(--border);
  border-radius: var(--r-md); box-shadow: var(--shadow-3);
  display: none; animation: popIn .14s var(--ease);
}
.pop-menu.open { display: block; }
.pop-menu button {
  display: flex; align-items: center; gap: 9px; width: 100%;
  padding: 8px 11px; border-radius: 8px; font-size: 13px;
  color: var(--text-dim); text-align: left;
}
.pop-menu button:hover { background: var(--surface-2); color: var(--text); }
.pop-menu button.danger { color: var(--danger); }
.pop-menu button.danger:hover { background: rgba(var(--danger-rgb),.11); }
.pop-menu .pm-sep { height: 1px; background: var(--border-2); margin: 5px 4px; list-style: none; }
.pop-menu button .icon { width: 14px; height: 14px; }
.pop-menu .pm-hint { font-size: 10.5px; color: var(--text-faint); margin-left: auto; font-family: var(--font-mono); }
/* 工作区右键菜单:禁用项用原生 disabled(理由放 title,disabled 也能 hover 显示);
   选择器比全局 button{cursor:pointer} 更具体,不需要 !important */
.pop-menu button:disabled { opacity: .45; cursor: default; }
.pop-menu button:disabled:hover { background: transparent; color: var(--text-dim); }
.pop-menu .pm-foot { margin-top: 5px; padding: 6px 11px 2px; border-top: 1px solid var(--border-2);
  font-size: 10.5px; color: var(--text-faint); }

/* 重命名输入 */
.rename-input {
  width: 100%; padding: 8px 11px; border-radius: var(--r-sm);
  border: 1px solid var(--accent); background: var(--bg-2);
  font-size: 13.5px; outline: none; box-shadow: 0 0 0 3px rgba(var(--accent-rgb),.13);
}

/* 模型列表 */
.model-opt {
  display: flex; align-items: center; gap: 9px; width: 100%;
  padding: 9px 12px; border-radius: var(--r-sm); font-size: 13px;
  color: var(--text-dim); text-align: left; border: 1px solid transparent;
}
.model-opt:hover { background: var(--surface-2); color: var(--text); }
.model-opt.selected { background: rgba(var(--accent-rgb),.1); color: var(--text); border-color: rgba(var(--accent-rgb),.28); }
.model-opt .mo-name { flex: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-family: var(--font-mono); font-size: 12.5px; }
.model-opt .mo-src { flex: none; font-size: 10px; padding: 1px 8px; border-radius: 999px; background: var(--surface-3); color: var(--text-faint); }
.model-opt .mo-check { flex: none; color: var(--accent); }
.list-box { max-height: 340px; overflow-y: auto; display: flex; flex-direction: column; gap: 2px; }

/* ============================================================================
   10. 命令面板 / 会话内查找
   ============================================================================ */
#palette-mask { align-items: flex-start; padding-top: 12vh; }
#palette {
  width: 100%; max-width: 600px; background: var(--surface);
  border: 1px solid var(--border); border-radius: var(--r-lg);
  box-shadow: var(--shadow-3); overflow: hidden; animation: modalIn .18s var(--ease);
  display: flex; flex-direction: column; max-height: 66vh;
}
#palette .pal-input-row { display: flex; align-items: center; gap: 11px; padding: 14px 17px; border-bottom: 1px solid var(--border-2); }
#palette .pal-input-row .icon { color: var(--accent); width: 19px; height: 19px; }
#cmd-input { flex: 1; border: none; background: none; outline: none; font-size: 15px; }
#cmd-input::placeholder { color: var(--text-faint); }
#cmd-list { overflow-y: auto; padding: 7px; }
#palette .cmd-foot { flex: none; padding: 8px 17px 10px; border-top: 1px solid var(--border-2); font-size: 11px; color: var(--text-faint); }
.cmd-item {
  display: flex; align-items: center; gap: 11px; width: 100%;
  padding: 9px 12px; border-radius: var(--r-sm); text-align: left; color: var(--text-dim);
  border: 1px solid transparent;
}
.cmd-item:hover, .cmd-item.sel { background: rgba(var(--accent-rgb),.1); color: var(--text); border-color: rgba(var(--accent-rgb),.24); }
.cmd-item .ci-ico { width: 26px; height: 26px; border-radius: 8px; flex: none;
  display: flex; align-items: center; justify-content: center;
  background: var(--surface-2); color: var(--text-faint); }
.cmd-item:hover .ci-ico, .cmd-item.sel .ci-ico { color: var(--accent); background: rgba(var(--accent-rgb),.13); }
.cmd-item .ci-txt { flex: 1; min-width: 0; }
.cmd-item .ci-name {
  display: block; font-size: 13.5px;
  overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
}
.cmd-item .ci-desc {
  display: block; font-size: 11px; color: var(--text-faint);
  overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
}
.cmd-item .ci-key { font-size: 10.5px; font-family: var(--font-mono); color: var(--text-faint); flex: none; }
.cmd-group { padding: 9px 12px 4px; font-size: 10.5px; font-weight: 700; letter-spacing: .7px; text-transform: uppercase; color: var(--text-faint); }

#find-bar {
  display: none; align-items: center; gap: 8px;
  padding: 7px 13px; border-bottom: 1px solid var(--border-2);
  background: var(--surface-2);
}
#find-bar.open { display: flex; }
#find-bar input { flex: 1; max-width: 320px; padding: 6px 11px; font-size: 12.5px;
  border-radius: 8px; border: 1px solid var(--border); background: var(--bg-2); outline: none; }
#find-bar input:focus { border-color: var(--accent); }
#find-bar .fb-count { font-size: 11.5px; color: var(--text-faint); font-family: var(--font-mono); }
mark.search-hit { background: rgba(var(--warning-rgb),.45); color: inherit; border-radius: 3px; padding: 0 2px; }
mark.search-hit.cur { background: var(--warning); color: var(--warning-ink); box-shadow: 0 0 0 2px rgba(var(--warning-rgb),.45); }
.msg.hit-flash { animation: hitFlash 1s var(--ease); }
@keyframes hitFlash { from { background: rgba(var(--accent-rgb),.14); } }

/* ============================================================================
   11. 代码 / 数据展示块
   ============================================================================ */
.code-block {
  font-family: var(--font-mono); font-size: 12px; line-height: 1.6;
  background: var(--code-bg); border: 1px solid var(--border);
  border-radius: var(--r-sm); padding: 11px 13px; overflow: auto; max-height: 300px;
  white-space: pre; color: var(--text-dim); margin: 0;
}
.chips { display: flex; flex-wrap: wrap; gap: 6px; }
.chip-btn {
  display: inline-flex; align-items: center; gap: 6px;
  padding: 5px 11px; border-radius: 999px; font-size: 12px;
  background: var(--surface-2); border: 1px solid var(--border); color: var(--text-dim);
  transition: all .15s;
}
.chip-btn:hover { border-color: rgba(var(--accent-rgb),.6); color: var(--text); }
.chip-btn.on { background: rgba(var(--accent-rgb),.14); color: var(--accent); border-color: rgba(var(--accent-rgb),.4); }
.chip-btn .icon { width: 13px; height: 13px; }

/* ============================================================================
   12. MCP 工具面板
   ============================================================================ */
.mcp-state {
  display: flex; align-items: center; gap: 10px; padding: 12px 14px;
  border-radius: var(--r-md); border: 1px solid var(--border);
  background: var(--surface-2); margin-bottom: 16px;
}
.mcp-state .ms-ico { width: 38px; height: 38px; border-radius: 11px; flex: none;
  display: flex; align-items: center; justify-content: center;
  background: var(--surface-3); color: var(--text-faint); }
.mcp-state.on { border-color: rgba(var(--success-rgb),.4); background: rgba(var(--success-rgb),.07); }
.mcp-state.on .ms-ico { background: rgba(var(--success-rgb),.16); color: var(--success); }
.mcp-state .ms-txt { flex: 1; min-width: 0; }
.mcp-state .ms-txt b { font-size: 13.5px; display: block; }
.mcp-state .ms-txt small { font-size: 11.5px; color: var(--text-faint); }

/* MCP 面板顶部的说明块:比普通 hint 更好读(独立字色 / 行距 / 左侧强调条) */
.mcp-intro {
  margin: 14px 0 4px; padding: 12px 14px 12px 15px; border-radius: var(--r-md);
  border: 1px solid rgba(var(--accent-rgb),.22);
  border-left: 3px solid rgba(var(--accent-rgb),.55);
  background: linear-gradient(135deg, rgba(var(--accent-rgb),.07), transparent 70%);
}
.mcp-intro p {
  margin: 0 0 8px; font-size: 12.5px; line-height: 1.75; color: var(--text-dim);
  font-family: var(--font-ui); letter-spacing: .1px;
}
.mcp-intro p:last-child { margin-bottom: 0; }
.mcp-intro b { color: var(--text); font-weight: 680; }
.mcp-intro code {
  font-family: var(--font-mono); font-size: 11.5px; padding: 1px 6px; border-radius: 5px;
  background: var(--inline-code-bg); border: 1px solid var(--border-2); color: var(--text);
}

.tool-list { display: flex; flex-direction: column; gap: 7px; }
.tool-row {
  display: flex; align-items: flex-start; gap: 11px; padding: 10px 13px;
  border-radius: var(--r-sm); border: 1px solid var(--border-2); background: var(--surface-2);
  transition: border-color .15s;
}
.tool-row:hover { border-color: var(--border); }
.tool-row .tr-main { flex: 1; min-width: 0; }
.tool-row .tr-name { font-family: var(--font-mono); font-size: 12.5px; color: var(--text); display: flex; align-items: center; gap: 7px; flex-wrap: wrap; }
.tool-row .tr-desc { font-size: 11.5px; color: var(--text-faint); margin-top: 3px; line-height: 1.55; }
.tool-row .tr-scope { font-size: 9.5px; padding: 1px 7px; border-radius: 999px; letter-spacing: .3px; text-transform: uppercase; }
.tool-row .tr-scope.read { background: rgba(var(--success-rgb),.14); color: var(--success); }
.tool-row .tr-scope.write { background: rgba(var(--warning-rgb),.14); color: var(--warning); }
.tool-row .tr-run { flex: none; }
.tool-row.disabled { opacity: .5; }
/* 工具行右侧:权限三态 + 该工具自己的配置项(纵向排列) */
.tool-row .tr-side { flex: none; display: flex; flex-direction: column; align-items: flex-end; gap: 8px; }
.tool-row .tr-opts { display: flex; flex-direction: column; align-items: flex-end; gap: 6px; }
.tool-row .tr-opt {
  display: flex; align-items: center; gap: 7px; font-size: 11.5px; color: var(--text-dim);
  white-space: nowrap; cursor: pointer;
}
.tool-row .tr-opt:hover { color: var(--text); }
/* 三态权限:询问 / 允许 / 禁止 */
.tr-perm { display: flex; gap: 3px; background: var(--bg-2); border: 1px solid var(--border-2);
  border-radius: 999px; padding: 3px; flex: none; }
.tr-perm button {
  padding: 3px 9px; border-radius: 999px; font-size: 11px; color: var(--text-faint); white-space: nowrap;
}
.tr-perm button:hover { color: var(--text); background: var(--surface-3); }
.tr-perm button.on { background: rgba(var(--warning-rgb),.16); color: var(--warning); box-shadow: inset 0 0 0 1px rgba(var(--warning-rgb),.36); }
.tr-perm button.on[data-perm="deny"] { background: rgba(var(--danger-rgb),.15); color: var(--danger); box-shadow: inset 0 0 0 1px rgba(var(--danger-rgb),.36); }
.tr-perm button.on[data-perm="allow"] { background: rgba(var(--success-rgb),.15); color: var(--success); box-shadow: inset 0 0 0 1px rgba(var(--success-rgb),.36); }
.tr-need { font-size: 11px; color: var(--warning); margin-top: 5px; }

/* 对话里的工具调用卡片:跟随主题色的淡彩底 + 左侧强调条(不用纯白/纯黑),默认折叠,点标题栏展开 */
.tool-stack { margin: 9px 0 2px; display: flex; flex-direction: column; gap: 8px; }
/* 合并气泡里,同一轮的后续正文与工具卡片之间的间距 */
.msg.assistant .msg-body > .msg-content + .msg-content { margin-top: 10px; }
.msg.assistant .msg-body > .reasoning + .msg-content { margin-top: 2px; }
/* 工具卡片与上下正文之间留出呼吸空间(卡片自己是淡彩底,挨太近会显得挤) */
.msg-body > .tool-slot { margin: 14px 0; }
.msg-body > .tool-slot + .tool-slot { margin-top: 10px; }
.msg-body > .reasoning + .tool-slot { margin-top: 12px; }
.msg-body > .tool-slot + .gen-line { margin-top: 12px; }
.tool-card {
  position: relative; overflow: hidden; border-radius: var(--r-md);
  border: 1px solid rgba(var(--accent-rgb),.28);
  background:
    linear-gradient(135deg, rgba(var(--accent-rgb),.16) 0%, rgba(var(--accent-rgb),.06) 46%, rgba(var(--accent-rgb),.015) 100%),
    var(--surface);
  box-shadow: 0 1px 2px rgba(0,0,0,.05), inset 0 1px 0 rgba(255,255,255,.05);
}
html[data-theme="light"] .tool-card {
  background:
    linear-gradient(135deg, rgba(var(--accent-rgb),.20) 0%, rgba(var(--accent-rgb),.08) 46%, rgba(var(--accent-rgb),.03) 100%),
    #fff;
  box-shadow: 0 1px 3px rgba(16,32,64,.07), inset 0 1px 0 #fff;
}
.tool-card::before {
  content: ""; position: absolute; left: 0; top: 0; bottom: 0; width: 3px;
  background: linear-gradient(180deg, var(--accent), var(--accent-2));
  opacity: .9;
}
.tool-card .tc-head {
  width: 100%; display: flex; align-items: center; gap: 8px; padding: 8px 12px 8px 14px;
  font-size: 12px; flex-wrap: nowrap; text-align: left; color: var(--text-dim);
}
.tool-card .tc-head:hover { background: rgba(var(--accent-rgb),.07); color: var(--text); }
.tool-card .tc-head .icon { width: 14px; height: 14px; color: var(--accent); flex: none; }
.tool-card .tc-name {
  font-family: var(--font-mono); font-weight: 650; font-size: 11.5px; color: var(--accent);
  background: rgba(var(--accent-rgb),.15); border: 1px solid rgba(var(--accent-rgb),.26);
  padding: 1px 7px; border-radius: 6px; flex: none;
}
.tool-card .tc-status { color: var(--text-dim); font-size: 11.5px; line-height: 1.5; font-weight: 600; flex: none; white-space: nowrap; }
.tool-card .tc-sum {
  flex: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
  font-size: 11.5px; line-height: 1.5; color: var(--text-faint);
}
.tool-card .tc-arrow { flex: none; color: var(--text-faint); transition: transform .2s var(--ease); }
.tool-card.expanded .tc-arrow { transform: rotate(180deg); color: var(--accent); }
.tool-card .tc-ops { display: flex; gap: 7px; padding: 0 14px 11px; flex-wrap: wrap; }
.tool-card .tc-ops button {
  padding: 4px 11px; border-radius: 999px; font-size: 11.5px; border: 1px solid var(--border);
  background: var(--surface); color: var(--text-dim); transition: all .15s;
}
.tool-card .tc-ops button:hover { color: var(--text); border-color: var(--accent); }
.tool-card .tc-ops button.primary { background: rgba(var(--accent-rgb),.18); color: var(--accent); border-color: rgba(var(--accent-rgb),.44); }
.tool-card .tc-ops button.danger { color: var(--danger); border-color: rgba(var(--danger-rgb),.34); }
.tool-card .tc-ops button.danger:hover { background: rgba(var(--danger-rgb),.12); }
.tool-card .tc-body {
  border-top: 1px solid rgba(var(--accent-rgb),.16); padding: 10px 12px 12px;
  display: none;
}
.tool-card.expanded .tc-body { display: block; animation: fadeIn .16s var(--ease); }
.tool-card .tc-lab {
  display: flex; align-items: center; gap: 6px;
  font-size: 10.5px; font-weight: 700; letter-spacing: .5px; text-transform: uppercase;
  color: var(--text-dim); margin: 2px 0 7px;
}
.tool-card .tc-lab::before {
  content: ""; width: 5px; height: 5px; border-radius: 50%;
  background: var(--accent); opacity: .75; flex: none;
}
.tool-card .tc-lab + pre { margin-bottom: 11px; }
.tool-card .tc-note { font-size: 11.5px; color: var(--text-dim); line-height: 1.6; margin-bottom: 9px; }
/* 工具读取的图片(Read 的 m.media):折叠态只出一行文字(零 <img>),展开态才挂缩略图 */
.tool-card .tc-media { display: flex; flex-wrap: wrap; gap: 6px; margin: 2px 0 11px; font-size: 11.5px; color: var(--text-dim); }
.tool-card .tc-media-img { max-width: 160px; max-height: 160px; border-radius: 6px; border: 1px solid var(--border); cursor: zoom-in; }
.tool-card pre { max-height: calc(var(--code-lines) * 1.6em + 24px); }
.tool-card.in-reasoning { border-style: dashed; }

/* AskUser 卡片的逐题表单:题头小标签 + 题面 + 选项(单选圆点 / 多选方块,纯 CSS)+ 自定义输入 + 校验行 */
.tool-card .ask-q { margin: 0 0 13px; }
.tool-card .ask-q:last-of-type { margin-bottom: 7px; }
.tool-card .ask-h {
  display: inline-block; font-size: 10.5px; font-weight: 700; letter-spacing: .4px;
  color: var(--accent); background: rgba(var(--accent-rgb),.13);
  border: 1px solid rgba(var(--accent-rgb),.26); border-radius: 999px;
  padding: 1px 8px; margin-bottom: 6px;
}
.tool-card .ask-t { font-size: 12.5px; color: var(--text); line-height: 1.6; margin-bottom: 7px; }
.tool-card .ask-opts { display: flex; flex-direction: column; gap: 5px; }
.tool-card .ask-opt {
  display: flex; align-items: flex-start; gap: 8px; width: 100%; text-align: left;
  padding: 6px 10px; border: 1px solid var(--border); border-radius: var(--r-sm);
  background: var(--surface); color: var(--text-dim); font-size: 12px; line-height: 1.5;
  transition: all .15s;
}
.tool-card .ask-opt:hover { color: var(--text); border-color: var(--accent); }
.tool-card .ask-opt.on { color: var(--text); border-color: rgba(var(--accent-rgb),.5); background: rgba(var(--accent-rgb),.12); }
.tool-card .ask-opt .ao-mark {
  flex: none; width: 13px; height: 13px; margin-top: 2px; position: relative;
  border: 1.5px solid var(--text-faint); border-radius: 50%;
}
.tool-card .ask-opts.multi .ask-opt .ao-mark { border-radius: 3px; }
.tool-card .ask-opt.on .ao-mark { border-color: var(--accent); }
.tool-card .ask-opt.on .ao-mark::after {
  content: ""; position: absolute; left: 2.5px; top: 2.5px; width: 5px; height: 5px;
  border-radius: inherit; background: var(--accent);
}
.tool-card .ao-main { min-width: 0; }
.tool-card .ao-label { font-weight: 600; color: inherit; }
.tool-card .ao-desc { display: block; font-size: 11px; color: var(--text-faint); margin-top: 2px; }
.tool-card .ask-ta {
  width: 100%; margin-top: 6px; padding: 7px 9px; min-height: 40px; resize: vertical;
  border: 1px solid var(--border); border-radius: var(--r-sm); background: var(--surface);
  color: var(--text); font: inherit; font-size: 12px; line-height: 1.55;
}
.tool-card .ask-ta:focus { outline: none; border-color: var(--accent); }
.tool-card .ask-ta[hidden] { display: none; }
.tool-card .ask-hint { font-size: 11px; color: var(--warning); line-height: 1.6; margin-top: 2px; }
/* 多题轮播:一屏只显示当前一题(卡片高度 = 单题高度),←/→ + 计数 切题;到端点箭头禁用 */
.tool-card .ask-nav { display: flex; align-items: center; gap: 8px; margin: 1px 0 9px; }
.tool-card .ask-nav .ask-arrow {
  display: inline-flex; align-items: center; justify-content: center;
  width: 24px; height: 24px; padding: 0; border-radius: 6px;
  border: 1px solid var(--border); background: var(--surface); color: var(--text-dim);
  transition: all .15s;
}
.tool-card .ask-nav .ask-arrow .icon { width: 13px; height: 13px; }
.tool-card .ask-nav .ask-arrow:hover:not(:disabled) { color: var(--text); border-color: var(--accent); }
.tool-card .ask-nav .ask-arrow:disabled { opacity: .35; cursor: default; }
.tool-card .ask-nav .ask-idx { font-size: 11px; color: var(--text-dim); letter-spacing: .3px; }
.tool-card .ask-recap { display: flex; flex-direction: column; gap: 5px; font-size: 12px; line-height: 1.6; }
.tool-card .ask-recap .ar-q { color: var(--text-faint); }
.tool-card .ask-recap .ar-a { color: var(--text); font-weight: 600; }
.tool-card .tc-ask-foot {
  display: flex; gap: 7px; flex-wrap: wrap; justify-content: flex-end; padding: 11px 14px;
  border-top: 1px solid rgba(var(--accent-rgb),.16);
}
.tool-card .tc-ask-foot button {
  padding: 4px 11px; border-radius: 999px; font-size: 11.5px; border: 1px solid var(--border);
  background: var(--surface); color: var(--text-dim); transition: all .15s;
}
.tool-card .tc-ask-foot button:hover { color: var(--text); border-color: var(--accent); }
.tool-card .tc-ask-foot button.primary { background: rgba(var(--accent-rgb),.18); color: var(--accent); border-color: rgba(var(--accent-rgb),.44); }

/* 工具卡片里的「任务行」 —— 状态徽标 + task_id + 已用时 + 输出尾部 + 停止按钮 */
.tool-card .tc-task {
  display: flex; align-items: center; gap: 8px; flex-wrap: wrap;
  margin: 0 13px 12px; padding: 8px 10px;
  border: 1px solid var(--border); border-radius: var(--r-sm);
  background: rgba(var(--accent-rgb),.045);
  font-size: 11.5px; color: var(--text-dim);
}
.tool-card .tc-task .tt-badge {
  flex: none; padding: 1px 7px; border-radius: 999px;
  border: 1px solid var(--border); color: var(--text-dim); background: var(--surface-2);
}
.tool-card .tc-task .tt-badge.run { color: var(--accent); border-color: rgba(var(--accent-rgb),.35); background: rgba(var(--accent-rgb),.13); }
.tool-card .tc-task .tt-badge.ok { color: var(--success); border-color: rgba(var(--success-rgb),.32); background: rgba(var(--success-rgb),.12); }
.tool-card .tc-task .tt-badge.err { color: var(--danger); border-color: rgba(var(--danger-rgb),.32); background: rgba(var(--danger-rgb),.12); }
.tool-card .tc-task .tt-id { font-family: var(--font-mono); color: var(--text); }
.tool-card .tc-task .tt-drop { color: var(--warning); }
.tool-card .tc-task .tt-stop {
  margin-left: auto; flex: none; cursor: pointer;
  font: inherit; padding: 2px 10px; border-radius: var(--r-sm);
  border: 1px solid rgba(var(--danger-rgb),.38); color: var(--danger); background: transparent;
}
.tool-card .tc-task .tt-stop:hover { background: rgba(var(--danger-rgb),.14); color: var(--text); }
.tool-card .tc-task .tt-out {
  flex: 0 0 100%; margin: 4px 0 0; max-height: 8.4em; overflow: auto;
  font-family: var(--font-mono); font-size: 11px; line-height: 1.4;
  white-space: pre-wrap; word-break: break-word; color: var(--text-dim);
  overscroll-behavior: contain;   /* 未贴底时滚轮只作用于日志容器,不把滚动链带给对话区 */
}
.tool-card .tc-task .tt-load { color: var(--text-dim); }

/* /tasks 弹窗里的任务行:与卡片行同名类,但作用域不在 .tool-card 之下(P2-13)⇒
   把上面那组规则以 `#tasks-list` 为祖先**成对复制**(规则体逐字复制,不改既有块) */
#tasks-list { display: flex; flex-direction: column; }
#tasks-list .tc-task {
  display: flex; align-items: center; gap: 8px; flex-wrap: wrap;
  margin: 0 13px 12px; padding: 8px 10px;
  border: 1px solid var(--border); border-radius: var(--r-sm);
  background: rgba(var(--accent-rgb),.045);
  font-size: 11.5px; color: var(--text-dim);
}
#tasks-list .tc-task .tt-badge {
  flex: none; padding: 1px 7px; border-radius: 999px;
  border: 1px solid var(--border); color: var(--text-dim); background: var(--surface-2);
}
#tasks-list .tc-task .tt-badge.run { color: var(--accent); border-color: rgba(var(--accent-rgb),.35); background: rgba(var(--accent-rgb),.13); }
#tasks-list .tc-task .tt-badge.ok { color: var(--success); border-color: rgba(var(--success-rgb),.32); background: rgba(var(--success-rgb),.12); }
#tasks-list .tc-task .tt-badge.err { color: var(--danger); border-color: rgba(var(--danger-rgb),.32); background: rgba(var(--danger-rgb),.12); }
#tasks-list .tc-task .tt-id { font-family: var(--font-mono); color: var(--text); }
#tasks-list .tc-task .tt-drop { color: var(--warning); }
#tasks-list .tc-task .tt-stop {
  margin-left: auto; flex: none; cursor: pointer;
  font: inherit; padding: 2px 10px; border-radius: var(--r-sm);
  border: 1px solid rgba(var(--danger-rgb),.38); color: var(--danger); background: transparent;
}
#tasks-list .tc-task .tt-stop:hover { background: rgba(var(--danger-rgb),.14); color: var(--text); }
#tasks-list .tc-task .tt-out {
  flex: 0 0 100%; margin: 4px 0 0; max-height: 8.4em; overflow: auto;
  font-family: var(--font-mono); font-size: 11px; line-height: 1.4;
  white-space: pre-wrap; word-break: break-word; color: var(--text-dim);
  overscroll-behavior: contain;
}
#tasks-list .tc-task .tt-load { color: var(--text-dim); }

/* 状态配色:等待放行 / 成功 / 失败各一套淡彩 */
.tool-card.wait {
  border-color: rgba(var(--warning-rgb),.44);
  background: linear-gradient(135deg, rgba(var(--warning-rgb),.17) 0%, rgba(var(--warning-rgb),.05) 50%, rgba(var(--warning-rgb),.02) 100%), var(--surface);
}
html[data-theme="light"] .tool-card.wait {
  background: linear-gradient(135deg, rgba(var(--warning-rgb),.22) 0%, rgba(var(--warning-rgb),.08) 50%, rgba(var(--warning-rgb),.03) 100%), #fff;
}
.tool-card.wait::before { background: linear-gradient(180deg, var(--warning), var(--warning-2)); }
.tool-card.wait .tc-name { color: var(--warning); background: rgba(var(--warning-rgb),.15); border-color: rgba(var(--warning-rgb),.3); }
.tool-card.wait .tc-head .icon { color: var(--warning); }
.tool-card.wait .tc-lab::before { background: var(--warning); }
.tool-card.ok {
  border-color: rgba(var(--success-rgb),.32);
  background: linear-gradient(135deg, rgba(var(--success-rgb),.14) 0%, rgba(var(--success-rgb),.04) 50%, rgba(var(--success-rgb),.015) 100%), var(--surface);
}
html[data-theme="light"] .tool-card.ok {
  background: linear-gradient(135deg, rgba(var(--success-rgb),.18) 0%, rgba(var(--success-rgb),.07) 50%, rgba(var(--success-rgb),.02) 100%), #fff;
}
.tool-card.ok::before { background: linear-gradient(180deg, var(--success), var(--success-2)); }
.tool-card.ok .tc-name { color: var(--success); background: rgba(var(--success-rgb),.14); border-color: rgba(var(--success-rgb),.28); }
.tool-card.ok .tc-head .icon { color: var(--success); }
.tool-card.ok .tc-lab::before { background: var(--success); }
.tool-card.err, .tool-card.denied {
  border-color: rgba(var(--danger-rgb),.36);
  background: linear-gradient(135deg, rgba(var(--danger-rgb),.15) 0%, rgba(var(--danger-rgb),.045) 50%, rgba(var(--danger-rgb),.015) 100%), var(--surface);
}
html[data-theme="light"] .tool-card.err, html[data-theme="light"] .tool-card.denied {
  background: linear-gradient(135deg, rgba(var(--danger-rgb),.19) 0%, rgba(var(--danger-rgb),.07) 50%, rgba(var(--danger-rgb),.02) 100%), #fff;
}
.tool-card.err::before, .tool-card.denied::before { background: linear-gradient(180deg, var(--danger), var(--danger-2)); }
.tool-card.err .tc-name, .tool-card.denied .tc-name { color: var(--danger); background: rgba(var(--danger-rgb),.14); border-color: rgba(var(--danger-rgb),.3); }
.tool-card.err .tc-head .icon, .tool-card.denied .tc-head .icon { color: var(--danger); }
.tool-card.err .tc-lab::before, .tool-card.denied .tc-lab::before { background: var(--danger); }
.msg.tool .avatar { background: rgba(var(--accent-rgb),.14); color: var(--accent); }

.console-log {
  font-family: var(--font-mono); font-size: 11.5px; line-height: 1.6;
  background: var(--code-bg); border: 1px solid var(--border);
  border-radius: var(--r-sm); padding: 11px 13px; height: 190px; overflow-y: auto;
  white-space: pre-wrap; word-break: break-word;
}
.console-log .cl-in { color: var(--accent); }
.console-log .cl-ok { color: var(--success); }
.console-log .cl-err { color: var(--danger); }
.console-log .cl-dim { color: var(--text-faint); }

/* ============================================================================
   13. Toast / Lightbox
   ============================================================================ */
#toasts {
  position: fixed; top: 68px; left: 50%; transform: translateX(-50%);
  z-index: 900; display: flex; flex-direction: column; gap: 9px;
  align-items: center; pointer-events: none; width: calc(100% - 40px); max-width: 520px;
}
.toast {
  display: flex; align-items: center; gap: 9px;
  padding: 10px 17px; border-radius: 999px; font-size: 13px;
  background: var(--surface); border: 1px solid var(--border);
  box-shadow: var(--shadow-3); max-width: 100%;
  animation: toastIn .24s var(--ease); pointer-events: auto;
  transition: opacity .3s, transform .3s;
}
.toast .icon { flex: none; }
.toast.success { border-color: rgba(var(--success-rgb),.5); color: var(--success); }
.toast.error { border-color: rgba(var(--danger-rgb),.5); color: var(--danger); }
.toast.warn { border-color: rgba(var(--warning-rgb),.5); color: var(--warning); }
.toast.info .icon { color: var(--accent); }
.toast.out { opacity: 0; transform: translateY(-10px); }
@keyframes toastIn { from { opacity: 0; transform: translateY(-14px) scale(.96); } }

.lightbox {
  position: fixed; inset: 0; z-index: 800; padding: 26px; overflow: hidden;
  display: none; align-items: center; justify-content: center;
  background: rgba(0,0,0,.96);
}
.lightbox.open { display: flex; }
.lightbox img {
  max-width: 93vw; max-height: 92vh; border-radius: 10px;
  box-shadow: 0 16px 60px rgba(0,0,0,.7);
  transform-origin: 0 0; cursor: grab; -webkit-user-drag: none; user-select: none;
}
.lightbox img.dragging { cursor: grabbing; }
.lightbox .lb-close { position: absolute; top: 18px; right: 18px; color: #fff; width: 40px; height: 40px;
  border-radius: 50%; background: rgba(255,255,255,.12); display: flex; align-items: center; justify-content: center;
  z-index: 2; cursor: pointer; }
.lightbox .lb-close:hover { background: rgba(255,255,255,.24); }
.lightbox .lb-hint { position: absolute; bottom: 16px; left: 50%; transform: translateX(-50%);
  color: rgba(255,255,255,.72); font-size: 11.5px; letter-spacing: .3px; pointer-events: none;
  background: rgba(0,0,0,.4); padding: 5px 12px; border-radius: 999px; }

/* ============================================================================
   14. 响应式
   ============================================================================ */
#sidebar-backdrop { display: none; position: fixed; inset: 0; z-index: 90; background: rgba(0,0,0,.45); }
#sidebar-backdrop.show { display: block; }
@media (max-width: 880px) {
  #sidebar { position: fixed; z-index: 100; height: 100%; box-shadow: var(--shadow-3); }
  #sidebar-backdrop { z-index: 99; }
  #conv-title .t-sub { display: none; }
  .model-chip { max-width: 150px; }
  .model-chip .m-name { max-width: 92px; }
  .msg { gap: 11px; padding: 14px 0; }
  #chat-inner { padding: 14px 14px 22px; }
  #input-area { padding: 6px 12px 10px; }
  .float-btn { right: 14px; }
  #btn-scroll-bottom { bottom: 18px; }
  #btn-scroll-top { bottom: 62px; }
  :root { --sidebar-w: 280px; }
}
@media (max-width: 560px) {
  .msg-actions { opacity: 1; }
  .composer-hint { display: none; }
  #welcome h1 { font-size: 22px; }
  .modal { max-height: 92vh; }
  .modal-mask { padding: 12px; }
  .tabs { padding: 0 12px; }
  .modal-head, .modal-body, .modal-foot { padding-left: 14px; padding-right: 14px; }
  #status-bar { gap: 10px; padding: 0 10px; }
  /* 390px 这种宽度放不下全部指标:先收掉「最近一次生成」与「运行环境」,
     它们的信息在消息meta与 设置 → 环境 里都能看到,避免右端被裁掉 */
  #status-bar #st-last-wrap,
  #status-bar #st-env-wrap { display: none; }
  /* 窄屏:主题按钮与侧边栏底部重复,收起以给标题留出空间 */
  #btn-theme-top { display: none; }
  .model-chip { max-width: 132px; }
  .model-chip .m-name { max-width: 78px; }
  #topbar { gap: 6px; padding: 0 10px; }
}
@media (min-width: 881px) and (max-width: 1080px) {
  :root { --sidebar-w: 240px; }
}

/* ---- 紧凑模式(密度令牌) ----
   开关 = settings.compact → html[data-density="compact"](applyAppearance 写)。
   令牌的 normal 值是上面各处的原字面量,所以 data-density="normal" 下渲染逐像素不变。
   ★ 注意:本块的 (0,1,1) 会同时压过 881–1080px 带里的 `:root{--sidebar-w:240px}`(0,1,0)
     ⇒ 该带内紧凑模式取 244 而非 240 —— 这是**有意的「紧凑优先」**(紧凑是用户显式开关),
     不要当 bug 修成 240。                                                              */
html[data-density="compact"] {
  --sidebar-w: 244px;
  --topbar-h: 48px;
  --status-h: 24px;
  --content-w: 760px;
  --code-lines: 8;
  --think-lines: 8;
  --d-msg-y: 8px;
  --d-msg-gap: 10px;
  --d-avatar: 26px;
  --d-chat-t: 12px;
  --d-chat-x: 16px;
  --d-chat-b: 20px;
  --d-block: .42em;
  --d-li: .18em;
  --d-conv-y: 6px;
  --d-input-y: 4px;
}
/* --ws-rail-w 定义在 #ws-rail(1,0,0)上,必须带回元素选择器才覆盖得住 */
html[data-density="compact"] #ws-rail { --ws-rail-w: 300px; }
/* 令牌化不了的零散间距(逐条对齐现有字面量) */
html[data-density="compact"] .msg-meta { font-size: 11px; margin-bottom: 3px; }
html[data-density="compact"] .reasoning-body { padding: 3px 11px 9px; }
html[data-density="compact"] .msg-content h1, html[data-density="compact"] .msg-content h2,
html[data-density="compact"] .msg-content h3, html[data-density="compact"] .msg-content h4,
html[data-density="compact"] .msg-content h5, html[data-density="compact"] .msg-content h6 { margin: .7em 0 .34em; }
html[data-density="compact"] .msg-content pre { margin: .55em 0; }
html[data-density="compact"] .tool-card .tc-body { padding: 9px 11px 10px; }
html[data-density="compact"] .modal-head { padding: 12px 16px 10px; }
html[data-density="compact"] .modal-body { padding: 12px 16px 14px; }
html[data-density="compact"] .modal-foot { padding: 10px 16px; }
html[data-density="compact"] .btn { padding: 6px 13px; }
html[data-density="compact"] .btn.sm { padding: 4px 10px; }
html[data-density="compact"] #topbar { padding: 0 10px; }
/* 毛玻璃是低端显卡的主要合成开销:紧凑模式一律关掉(设置面板文案已写明) */
html[data-density="compact"] #topbar,
html[data-density="compact"] #sidebar,
html[data-density="compact"] #ws-rail { backdrop-filter: none; -webkit-backdrop-filter: none; }
html[data-density="compact"] .modal-mask { backdrop-filter: none; -webkit-backdrop-filter: none; }
/* 矮屏(1366×768 这类)+ 窄窗:紧凑模式下再压一点纵向占用。
   既有「隐藏 #st-last-wrap / .composer-hint」的规则在 ≤560px(head.part 那条 @media max-width:560px);
   本节 ≤1080 的规则对 #st-last-wrap 是它的超集,#st-env-wrap 仍只在 ≤560 收起 —— 两条并存,不重复 */
@media (max-height: 700px) {
  html[data-density="compact"] .composer-hint { display: none; }
  html[data-density="compact"] #chat-inner { padding-top: 10px; }
  html[data-density="compact"] #status-bar { height: 22px; }
}
@media (max-width: 1080px) {
  html[data-density="compact"] #status-bar #st-last-wrap { display: none; }
}
/* 无 flex-gap 支持时的兜底外边距 */
html.no-flexgap .topbar-row > * + *, html.no-flexgap #topbar > * + * { margin-left: 9px; }
html.no-flexgap .composer-bar > * + * { margin-left: 7px; }
html.no-flexgap .side-foot-row > * + * { margin-left: 6px; }
html.no-flexgap .msg-meta > * + * { margin-left: 8px; }
html.no-flexgap .msg-actions > * + * { margin-left: 4px; }
html.no-flexgap .msg > * + * { margin-left: 14px; }
html.no-flexgap #status-bar > * + * { margin-left: 14px; }
html.no-flexgap .tool-list > * + * { margin-top: 7px; }
html.no-flexgap .chips > * + * { margin-left: 6px; }

@media print {
  #sidebar, #topbar, #input-area, #status-bar, .float-btn, #toasts { display: none !important; }
  body { overflow: visible; background: #fff; color: #000; }
  #app, #chat { height: auto; overflow: visible; display: block; }
}

/* ============================================================================
   15. KaTeX(内嵌,含字体)
   ============================================================================ */
/*__KATEX_CSS__*/

/* --- KaTeX 与本站样式的适配 --- */
.msg-content .katex { font-size: 1.05em; }
.msg-content .katex-display { margin: .72em 0; padding: 5px 0; overflow-x: auto; overflow-y: hidden; }
.msg-content .katex-display > .katex { white-space: normal; }
.msg-content .katex-error {
  color: var(--danger) !important;
  font-family: var(--font-mono); font-size: .88em;
  background: rgba(var(--danger-rgb),.09); padding: 1px 6px; border-radius: 5px;
}
.msg-content .katex .mord.text { font-family: var(--font-ui); }

/* ============================================================================
   16. 工作区右栏(≥881px 常态占位 340px,≤880px 转 fixed 抽屉)
   ============================================================================ */
#ws-rail {
  --ws-rail-w: 340px;
  width: var(--ws-rail-w); min-width: var(--ws-rail-w);
  display: flex; flex-direction: column; position: relative;
  background: var(--glass);
  border-left: 1px solid var(--border-2);
  backdrop-filter: blur(16px) saturate(1.3);
  -webkit-backdrop-filter: blur(16px) saturate(1.3);
  transition: margin-right .26s var(--ease);
  overflow: hidden;
}
/* 桌面端收起 = 整列滑出右侧(与 #sidebar 的负 margin 同一套做法)。
   注意:**不要**改成 `width:0` 之类的缩宽动画 —— 那会让 offsetWidth 在动画期间读到
   ~0,而 autoFitSidebar() / wsRailMinWidth() 都从 offsetWidth 取宽度(railWidth() 也依赖它),
   于是「右栏太窄该自动收起」的判定会失效(实测 1280 视口下右栏不再自动收起)。
   盒子向右溢出 340px 本身由 html 的 overflow-x:clip 收住(见 :root 上方那条说明)。 */
#ws-rail.collapsed { margin-right: calc(-1 * var(--ws-rail-w)); }
#ws-rail.drop-over { outline: 2px dashed rgba(var(--accent-rgb),.65); outline-offset: -7px; }
#ws-rail-backdrop { display: none; position: fixed; inset: 0; z-index: 90; background: rgba(0,0,0,.45); }
#ws-rail-backdrop.show { display: block; }

.wsr-head {
  display: flex; align-items: center; gap: 8px; flex: none;
  padding: 14px 12px 10px; border-bottom: 1px solid var(--border-2);
}
.wsr-head > .icon { color: var(--accent); }
.wsr-head b { font-size: 13px; font-weight: 700; letter-spacing: .2px; }
.wsr-head .wsr-sub { flex: 1; min-width: 0; font-size: 10.5px; color: var(--text-faint);
  overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
#ws-rail .icon-btn { width: 28px; height: 28px; flex: none; }

.wsr-body { flex: 1; min-height: 0; display: flex; flex-direction: column; gap: 9px; padding: 10px 11px 8px; }
#wsr-switch .nsel { width: 100%; }
.wsr-info { font-size: 11.5px; color: var(--text-dim); flex: none; }
.wsr-info .wsr-line { display: flex; align-items: baseline; gap: 6px; }
.wsr-info .wsr-line b { color: var(--text); font-weight: 600;
  overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.wsr-info .wsr-line span { margin-left: auto; font-family: var(--font-mono); font-size: 10.5px; color: var(--text-faint); }
.wsr-info .wsr-bar { height: 6px; border-radius: 4px; background: var(--surface-3); overflow: hidden; margin-top: 6px; }
.wsr-info .wsr-bar > i { display: block; height: 100%; background: linear-gradient(90deg, var(--accent), var(--accent-2)); }
.wsr-info .wsr-bar.over > i { background: var(--danger); }

.wsr-tools { display: flex; align-items: center; gap: 4px; flex: none; }
.wsr-tools .tool-btn { width: 28px; height: 28px; }
.wsr-tools .tool-btn.danger { color: var(--danger); }
.wsr-tools .tool-btn.danger:hover { background: rgba(var(--danger-rgb),.13); color: var(--danger); border-color: rgba(var(--danger-rgb),.5); }
.wsr-spacer { flex: 1; }

.wsr-crumb { display: flex; flex-wrap: wrap; align-items: center; gap: 1px; flex: none;
  font-family: var(--font-mono); font-size: 11.5px; color: var(--text-faint); }
.wsr-crumb button { padding: 1px 5px; border-radius: 6px; color: var(--text-dim); font-size: 11.5px; }
.wsr-crumb button:hover { background: var(--surface-2); color: var(--accent); }
.wsr-crumb .wsr-sep { opacity: .55; }
/* 根目录项 = 「文件夹图标 + /」同一个按钮:命中区放大到 24px 高(其余面包屑按钮同高对齐) */
.wsr-crumb button { padding: 3px 8px; min-height: 24px; display: inline-flex; align-items: center; gap: 4px; }
.wsr-crumb .wsr-home { color: var(--text-dim); }
.wsr-crumb .wsr-home .icon { width: 14px; height: 14px; color: var(--accent); }

#wsr-files { flex: 1; min-height: 70px; max-height: none; overflow-y: auto; gap: 2px; }
.wsr-row { display: flex; align-items: center; gap: 8px; padding: 6px 8px; border-radius: var(--r-xs);
  border: 1px solid transparent; cursor: pointer; }
.wsr-row:hover { background: var(--surface-2); border-color: var(--border-2); }
.wsr-row.drop-on { border-color: var(--accent); background: rgba(var(--accent-rgb),.12); }
.wsr-row .icon { width: 15px; height: 15px; color: var(--text-faint); flex: none; }
.wsr-row.dir .icon { color: var(--accent); }
.wsr-row .wsr-name { flex: 1; min-width: 0; font-size: 12.5px; color: var(--text);
  overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.wsr-row .wsr-size { flex: none; font-family: var(--font-mono); font-size: 10.5px; color: var(--text-faint); }
.wsr-row .wsr-ops { flex: none; display: flex; gap: 2px; opacity: 0; transition: opacity .12s; }
.wsr-row:hover .wsr-ops, .wsr-row:focus-within .wsr-ops { opacity: 1; }
/* 行内 ops(下载/删除)与展开箭头:命中区下限 24px(WCAG 2.2 目标尺寸)。
   三者只放大按钮盒 ⇒ 图标本身尺寸不动(.icon 15px / .wsr-caret .icon 13px),视觉体量不变;
   行高 36 → 38(+2px,由行内容 max = 24 决定、`align-items:center` 上下各 +1,实测 4+6 行全同值) */
.wsr-row .wsr-ops button { width: 24px; height: 24px; border-radius: 6px; display: flex;
  align-items: center; justify-content: center; color: var(--text-faint); }
.wsr-row .wsr-ops button:hover { background: var(--surface-3); color: var(--text); }
.wsr-row .wsr-ops button.danger:hover { color: var(--danger); background: rgba(var(--danger-rgb),.13); }
/* 工作区内部剪贴板:被「剪切」的行先打上这个标记(粘贴成功后由重渲染自然消失) */
.wsr-row.wsr-cut { opacity: .5; font-style: italic; }
/* 选中行(门 8=B 多选:单击/多选的可见反馈;左缘竖条 + 底色,与 hover 区分开) */
.wsr-row.wsr-sel { background: var(--surface-2); border-color: var(--border-2);
  box-shadow: inset 2px 0 0 var(--accent); }
.wsr-empty { padding: 20px 10px; text-align: center; color: var(--text-faint); font-size: 12px; line-height: 1.75; }
.wsr-empty .btn { margin-top: 12px; }
.wsr-prog, .wsr-report { flex: none; font-size: 11px; color: var(--text-dim); line-height: 1.7; }
.wsr-prog { font-family: var(--font-mono); }
.wsr-report { max-height: 132px; overflow-y: auto; }
.wsr-report .wsr-fail { color: var(--danger); }
.wsr-report .wsr-skip { color: var(--text-faint); }
.wsr-report .wsr-head-line { color: var(--text); font-weight: 600; }
.wsr-report button { color: var(--accent); text-decoration: underline; }
.wsr-note { font-size: 11px; color: var(--text-faint); line-height: 1.65; }

.wsr-foot { flex: none; display: flex; gap: 7px; align-items: center;
  padding: 9px 11px 11px; border-top: 1px solid var(--border-2); }
.wsr-foot .btn { flex: none; }
.wsr-foot .grow { flex: 1; min-width: 0; }
.wsr-foot .on { color: var(--accent); border-color: rgba(var(--accent-rgb),.45); background: rgba(var(--accent-rgb),.1); }

@media (max-width: 880px) {
  /* 窄屏:与左栏一致的抽屉(遮罩 + 滑入),两块抽屉互斥,不互相打架 */
  #ws-rail { position: fixed; right: 0; top: 0; height: 100%; z-index: 100;
    width: var(--ws-rail-w); min-width: 0; max-width: 92vw;
    margin-right: 0; box-shadow: var(--shadow-3);
    transform: translateX(100%); transition: transform .26s var(--ease); }
  #ws-rail:not(.collapsed) { transform: translateX(0); }
  #ws-rail-backdrop { z-index: 99; }
  .wsr-row .wsr-ops { opacity: 1; }   /* 触屏没有 hover,行内操作常显 */
}
@media print { #ws-rail, #ws-rail-backdrop { display: none !important; } }

/* ---- 浮窗形态(column 之外的窄窗形态,见 appD 的形态机) ----
   只在 ≥881px 生效:≤880 的抽屉几何由上面那个媒体块权威。
   媒体查询本身不限最小宽度 ⇒ 若不包这一层,一旦属性在窄屏残留 "float",
   (1,1,1) 的 float 块会压过抽屉块的 (1,0,0) ⇒ 抽屉变成右上小窗。 */
@media (min-width: 881px) {
  html[data-rail-form="float"] #ws-rail {
    position: fixed; right: 14px; top: calc(var(--topbar-h) + 12px);
    height: min(620px, calc(100vh - var(--topbar-h) - 40px));
    width: var(--ws-rail-w); min-width: 0; max-width: 92vw;
    margin-right: 0; z-index: 100;
    border: 1px solid var(--border); border-radius: var(--r-lg);
    box-shadow: var(--shadow-3); transform-origin: top right;
    animation: railPop .2s var(--ease);
  }
  html[data-rail-form="float"] #ws-rail.collapsed {
    margin-right: 0; visibility: hidden; opacity: 0; pointer-events: none;
    transform: translateY(-6px) scale(.98);
  }
  @keyframes railPop { from { opacity: 0; transform: translateY(-6px) scale(.98); } }
}
@media (min-width: 881px) and (prefers-reduced-motion: reduce) {
  html[data-rail-form="float"] #ws-rail { animation: none; }
}

/* ---- 目录树的「上级目录」行与展开箭头 / 树行 ---- */
.wsr-row.up .icon { transform: rotate(90deg); }        /* i-left 顺时针 90° = 向上 */
.wsr-row.up .wsr-name { color: var(--text-dim); }
.wsr-caret { flex: none; width: 24px; height: 24px; border-radius: 6px; display: flex;
  align-items: center; justify-content: center; color: var(--text-faint); }
.wsr-caret:hover { background: var(--surface-3); color: var(--text); }
.wsr-caret .icon { width: 13px; height: 13px; transition: transform .16s var(--ease); }
.wsr-caret .icon { transform: rotate(-90deg); }        /* 收起 = ▶ */
.wsr-caret.open .icon { transform: rotate(0deg); }     /* 展开 = ▼ */
.wsr-row.tree .wsr-name { font-size: 12px; }
.wsr-row.tree .wsr-caret + .icon { margin-left: -2px; }

/* ---- 外部 MCP 工具列表的限高滚动容器(#mcp-tools 内置列表不加,设置面板整体已可滚) ---- */
.tool-scroll { max-height: 320px; overflow-y: auto; margin-top: 12px; padding: 8px;
  border: 1px solid var(--border-2); border-radius: var(--r-sm);
  background: var(--bg-2); overscroll-behavior: contain; }
</style>
</head>
<body>
