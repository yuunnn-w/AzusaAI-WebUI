<!-- Jupyter 官方标记(两条月牙 = 轨道 + 三个小圆 = 卫星)。几何逐字取自 JupyterLab
     ui-components 的 jupyter 图标(viewBox 0 0 152 165,BSD-3-Clause),只把配色换成 currentColor;
     三个小圆按官方圆心放大到小尺寸下可见(官方半径在 15~18px 下 <0.5px,呈亚像素 ⇒ 认不出) -->
<symbol id="i-jupyter" viewBox="-2 -2 156 169"><g fill="currentColor" stroke="none"><path d="M76.021 140.163c-32.64 0-61.145-11.927-75.942-29.58 5.51 15.84 15.781 29.567 29.39 39.278a80.17 80.17 0 0 0 46.57 14.929 80.17 80.17 0 0 0 46.57-14.929c13.61-9.711 23.88-23.437 29.391-39.278-14.833 17.653-43.338 29.58-75.979 29.58m-.005-114.832c32.64 0 61.146 11.927 75.943 29.58a80.9 80.9 0 0 0-29.391-39.278A80.16 80.16 0 0 0 75.998.705a80.16 80.16 0 0 0-46.57 14.928A80.9 80.9 0 0 0 .038 54.912c14.832-17.617 43.338-29.58 75.978-29.58"/><circle cx="34.2" cy="6.4" r="7"/><circle cx="8.6" cy="46.4" r="8.4"/><circle cx="7.6" cy="9.6" r="5.6"/></g></symbol>
</defs></svg>

<!-- ============ 旧浏览器提示 ============ -->
<div id="compat-screen" role="alert">
  <div class="cs-card">
    <h1><svg class="icon lg" style="color:var(--warning)"><use href="#i-warn" xlink:href="#i-warn"/></svg> 浏览器版本过低</h1>
    <p>这个页面使用了若干较新的浏览器能力,当前浏览器缺少其中一些关键特性,因此已停止加载应用,以免出现白屏或数据异常。</p>
    <div class="field-label">缺失的关键能力</div>
    <ul id="compat-list"></ul>
    <p class="cs-note">
      建议使用 <b>Chrome / Edge 88+</b>、<b>Firefox 85+</b>、<b>Safari 14.1+</b> 中的任意一款打开本页面。
      页面不依赖网络与任何外部资源,直接双击本文件即可离线使用。
    </p>
  </div>
</div>

<div id="app">
  <div class="bg-layer" id="bg-aurora"><span></span><span></span><span></span></div>
  <div class="bg-layer" id="bg-grid"></div>

  <!-- ============ 侧边栏 ============ -->
  <aside id="sidebar">
    <div class="side-head">
      <div class="logo"><svg class="icon"><use href="#i-cat" xlink:href="#i-cat"/></svg></div>
      <div class="brand">
        <b>AzusaAI WebUI</b>
        <small>单文件 · 离线可用 · 内置 MCP</small>
      </div>
      <button class="icon-btn side-close" id="btn-side-close" title="收起侧边栏 (Ctrl+B)" aria-label="收起侧边栏">
        <svg class="icon sm"><use href="#i-panel" xlink:href="#i-panel"/></svg>
      </button>
    </div>
    <div class="side-actions">
      <button class="btn-new" id="btn-new-chat">
        <svg class="icon"><use href="#i-plus" xlink:href="#i-plus"/></svg> 新建对话
      </button>
      <div class="search-wrap" id="conv-search-wrap">
        <svg class="icon sm"><use href="#i-search" xlink:href="#i-search"/></svg>
        <input type="text" id="conv-search" placeholder="搜索对话与消息…" spellcheck="false" autocomplete="off" />
        <button class="clear" id="conv-search-clear" title="清除搜索" aria-label="清除搜索">
          <svg class="icon sm"><use href="#i-x" xlink:href="#i-x"/></svg>
        </button>
      </div>
    </div>
    <div id="conv-list"></div>
    <div class="side-foot">
      <div class="conn-status">
        <span class="conn-dot" id="conn-dot"></span>
        <span id="conn-text">未连接</span>
      </div>
      <div class="side-foot-row">
        <button class="foot-btn" id="btn-theme" title="切换主题">
          <svg class="icon sm" id="theme-icon"><use href="#i-moon" xlink:href="#i-moon"/></svg>
          <span id="theme-label">深色</span>
        </button>
        <button class="foot-btn" id="btn-mcp" title="MCP 工具">
          <svg class="icon sm"><use href="#i-plug" xlink:href="#i-plug"/></svg> MCP
        </button>
      </div>
      <button class="foot-btn wide" id="btn-settings">
        <svg class="icon sm"><use href="#i-sliders" xlink:href="#i-sliders"/></svg> 设置
        <span class="pm-hint" style="margin-left:auto;font-size:10.5px;color:var(--text-faint)">Ctrl+,</span>
      </button>
      <button class="foot-btn wide" id="btn-help">
        <svg class="icon sm"><use href="#i-book" xlink:href="#i-book"/></svg> 使用教程与关于
      </button>
    </div>
  </aside>
  <div id="sidebar-backdrop"></div>

  <!-- ============ 主区域 ============ -->
  <main id="main" class="topbar-row">
    <header id="topbar">
      <button class="icon-btn" id="btn-toggle-sidebar" title="显示/隐藏侧边栏 (Ctrl+B)" aria-label="切换侧边栏">
        <svg class="icon"><use href="#i-panel" xlink:href="#i-panel"/></svg>
      </button>
      <div class="title-wrap">
        <div id="conv-title" data-menu-opener title="点击打开对话菜单"><span class="t-main">新对话</span><span class="t-sub" id="conv-sub"></span></div>
      </div>
      <span class="badge openai" id="proto-badge" title="当前协议">OPENAI</span>
      <button class="model-chip" id="model-chip" title="选择模型 (Ctrl+M)">
        <svg class="icon sm"><use href="#i-cpu" xlink:href="#i-cpu"/></svg>
        <span class="m-name empty" id="model-name">未设置模型</span>
        <svg class="icon sm m-caret"><use href="#i-down" xlink:href="#i-down"/></svg>
      </button>
      <button class="icon-btn" id="btn-find" title="在对话中查找 (Ctrl+F)" aria-label="查找">
        <svg class="icon"><use href="#i-search" xlink:href="#i-search"/></svg>
      </button>
      <button class="icon-btn" id="btn-palette" title="命令面板 (Ctrl+K)" aria-label="命令面板">
        <svg class="icon"><use href="#i-grid" xlink:href="#i-grid"/></svg>
      </button>
      <button class="icon-btn" id="btn-theme-top" title="切换主题" aria-label="切换主题">
        <svg class="icon"><use href="#i-moon" xlink:href="#i-moon"/></svg>
      </button>
      <button class="icon-btn" id="btn-ws-rail" title="工作区面板" aria-label="工作区面板" hidden>
        <svg class="icon"><use href="#i-layers" xlink:href="#i-layers"/></svg>
      </button>
    </header>

    <div id="find-bar">
      <svg class="icon sm" style="color:var(--text-faint)"><use href="#i-search" xlink:href="#i-search"/></svg>
      <input type="text" id="find-input" placeholder="在本对话中查找…" spellcheck="false" autocomplete="off" />
      <span class="fb-count" id="find-count"></span>
      <button class="icon-btn" id="find-prev" title="上一个 (Shift+Enter)" style="width:28px;height:28px">
        <svg class="icon sm" style="transform:rotate(180deg)"><use href="#i-down" xlink:href="#i-down"/></svg>
      </button>
      <button class="icon-btn" id="find-next" title="下一个 (Enter)" style="width:28px;height:28px">
        <svg class="icon sm"><use href="#i-down" xlink:href="#i-down"/></svg>
      </button>
      <button class="icon-btn" id="find-close" title="关闭 (Esc)" style="width:28px;height:28px">
        <svg class="icon sm"><use href="#i-x" xlink:href="#i-x"/></svg>
      </button>
    </div>

    <div id="chat"><div id="chat-inner"></div></div>
    <button class="float-btn" id="btn-scroll-top" title="回到顶部" aria-label="回到顶部">
      <svg class="icon"><use href="#i-down" xlink:href="#i-down"/></svg>
    </button>
    <button class="float-btn" id="btn-scroll-bottom" title="回到底部" aria-label="回到底部">
      <svg class="icon"><use href="#i-down" xlink:href="#i-down"/></svg>
    </button>

    <footer id="input-area">
      <div id="composer">
        <div id="attach-bar"></div>
        <textarea id="input" placeholder="输入消息… (Enter 发送 · Shift+Enter 换行 · Ctrl+K 命令面板)" rows="1" spellcheck="false"></textarea>
        <div class="composer-bar">
          <div class="composer-left">
            <button class="tool-btn" id="btn-attach" title="添加附件:文本 / 图片 / PDF / 办公文档(doc/docx/ppt/pptx/xls/xlsx),单个 ≤ 50MB,一条消息最多 10 个" aria-label="添加附件">
              <svg class="icon"><use href="#i-clip" xlink:href="#i-clip"/></svg>
            </button>
            <button class="tool-btn" id="btn-ws-mount" data-menu-opener title="工作区(沙箱虚拟盘):挂载后模型可用 Read / ReadOffice / Write / Edit / Glob / Grep / FileOps / Office" aria-label="工作区挂载" aria-haspopup="menu" hidden>
              <svg class="icon"><use href="#i-layers" xlink:href="#i-layers"/></svg>
            </button>
            <button class="tool-btn" id="btn-voice" title="语音输入(需浏览器支持)" aria-label="语音输入">
              <svg class="icon"><use href="#i-mic" xlink:href="#i-mic"/></svg>
            </button>
            <button class="tool-btn" id="btn-params" title="调节:生成参数 · 工具开关" aria-label="调节:生成参数与工具开关">
              <svg class="icon"><use href="#i-sliders" xlink:href="#i-sliders"/></svg>
            </button>
            <button class="tool-btn" id="btn-insert-lib" data-menu-opener title="插入提示词模板" aria-label="提示词模板">
              <svg class="icon"><use href="#i-book" xlink:href="#i-book"/></svg>
            </button>
          </div>
          <div class="composer-hint" id="composer-hint">
            <kbd>Enter</kbd> 发送 · <kbd>Shift</kbd>+<kbd>Enter</kbd> 换行 · 支持粘贴 / 拖拽上传
          </div>
          <div class="composer-right">
            <button class="ctx-meter" id="ctx-meter" type="button" title="上下文用量(点击查看明细)"
                    aria-label="上下文用量" aria-haspopup="dialog">
              <span class="cm-num" id="ctx-meter-num">—</span>
              <svg class="cm-ring" viewBox="0 0 36 36" aria-hidden="true">
                <circle class="cm-track" cx="18" cy="18" r="15"></circle>
                <circle class="cm-bar" id="ctx-ring-bar" cx="18" cy="18" r="15"></circle>
              </svg>
            </button>
            <button class="tool-btn" id="btn-clear-input" title="清空输入并移除附件" aria-label="清空输入">
              <svg class="icon"><use href="#i-eraser" xlink:href="#i-eraser"/></svg>
            </button>
            <button id="btn-send" title="发送 (Enter)" aria-label="发送">
              <svg class="icon"><use href="#i-send" xlink:href="#i-send"/></svg>
            </button>
          </div>
        </div>
      </div>
      <!-- 斜杠命令浮窗(输入框里打 `/` 时出现;位置由 CSS 贴到输入区正上方) -->
      <div id="slash-menu" role="listbox" aria-label="可用命令"></div>
      <!-- 待发送缓冲区(生成中回车入队;下一个工具轮边界插入;层级低于 #slash-menu) -->
      <div id="send-queue" role="list" aria-label="待发送消息(下一轮工具结果后自动发送)" hidden>
        <div class="sq-rows" id="send-queue-rows"></div>
        <div class="sq-hint" id="send-queue-hint"></div>
      </div>
      <!-- 调节浮层(生成参数 + 工具开关;位置由 placePopover 贴到按钮正上方) -->
      <div class="popover" id="params-pop" style="width:320px; max-width:calc(100vw - 20px);">
        <div class="pop-title">调节(保存在本地,仅影响之后的请求)</div>
        <div class="field">
          <div class="range-row">
            <span class="r-lab">采样温度</span>
            <input type="range" id="p-temp" min="-1" max="2" step="0.05" />
            <span class="val" id="p-temp-v"></span>
          </div>
        </div>
        <div class="field">
          <div class="range-row">
            <span class="r-lab">Top P</span>
            <input type="range" id="p-topp" min="-1" max="1" step="0.01" />
            <span class="val" id="p-topp-v"></span>
          </div>
        </div>
        <div class="field">
          <div class="range-row">
            <span class="r-lab">最大输出</span>
            <input type="range" id="p-maxtok" min="0" max="393216" step="1024" />
            <span class="val" id="p-maxtok-v"></span>
          </div>
        </div>
        <div class="field">
          <div class="range-row">
            <span class="r-lab">重复惩罚</span>
            <input type="range" id="p-reppen" min="0" max="2" step="0.01" />
            <span class="val" id="p-reppen-v"></span>
          </div>
        </div>
        <div class="field">
          <div class="range-row">
            <span class="r-lab">思考强度</span>
            <div class="nsel nsel-flex" id="p-reff"></div>
          </div>
        </div>
        <!-- 上下文长度(手动设定;8–1024K,步进 8K):只在服务端**没给**该模型的窗口长度时显示;
             服务端给了就整块隐藏,值也不参与计算(见 appD 的 ctxWinManualOn / ctxWindowFor) -->
        <div class="field" id="p-ctxwin-field" style="display:none">
          <div class="range-row">
            <span class="r-lab">上下文长度</span>
            <input type="range" id="p-ctxwin" min="8" max="1024" step="8" />
            <span class="val ctxk"><input type="number" id="p-ctxwin-n" min="8" max="1024" step="8" inputmode="numeric" /><i>K</i></span>
          </div>
          <div class="hint">服务端没给出该模型的窗口长度,按这里估算。改动立即影响用量环与压缩阈值。</div>
        </div>
        <!-- 「工具」分组:内部与外部两个独立开关,可同时开;
             开关立即写设置并下一轮生效(buildBody 每轮都调),不重发当前请求 -->
        <div class="pop-sep"></div>
        <div class="pop-sub-title">工具</div>
        <div class="field">
          <div class="switch-row">
            <div class="sw-txt"><label for="p-tools-enabled">内部工具</label><small id="p-tools-count">已关闭</small></div>
            <label class="switch sm"><input type="checkbox" id="p-tools-enabled" /><span class="slider"></span></label>
          </div>
          <div class="switch-row">
            <div class="sw-txt"><label for="p-ext-tools-enabled">外部 MCP 工具</label><small id="p-ext-tools-count">已关闭</small></div>
            <label class="switch sm"><input type="checkbox" id="p-ext-tools-enabled" /><span class="slider"></span></label>
          </div>
          <!-- 会话级覆盖(全局默认 + 会话级覆盖;先例 conv.system):
               这一行是**本会话**的生效态,写进 conv.extToolsEnabled 并随会话落 IDB;
               上面两个开关是全局默认值,两者各归各的 -->
          <div class="range-row" style="margin-top:6px">
            <span class="r-lab">本会话覆盖</span>
            <div class="nsel nsel-flex" id="p-ext-tools-scope"></div>
          </div>
          <div class="hint">只影响当前这条对话:选「跟随全局」用上面的总开关;选「本会话开 / 关」就固定住,随会话保存(刷新、导出导入都在)。改了从下一条消息起生效。</div>
          <div class="hint" id="p-tools-hint" style="display:none"></div>
        </div>
        <div style="display:flex;gap:8px;margin-bottom:12px">
          <button class="btn sm grow" id="p-manage-tools" style="flex:1">管理工具与服务器…</button>
        </div>
        <div class="pop-actions" style="display:flex;gap:8px">
          <button class="btn sm grow" id="p-reset" style="flex:1">恢复默认</button>
          <button class="btn sm primary" id="p-close" style="flex:1">完成</button>
        </div>
      </div>
      <input type="file" id="attach-file" multiple style="display:none"
             accept="image/*,.pdf,.doc,.docx,.ppt,.pptx,.xls,.xlsx,.txt,.md,.markdown,.json,.jsonl,.py,.js,.mjs,.cjs,.ts,.jsx,.tsx,.html,.htm,.css,.scss,.less,.c,.cpp,.cc,.h,.hpp,.java,.go,.rs,.rb,.php,.sh,.bat,.cmd,.ps1,.yaml,.yml,.toml,.ini,.cfg,.conf,.csv,.tsv,.xml,.sql,.log,.env,.vue,.svelte,.rst,.tex,.png,.jpg,.jpeg,.gif,.webp,.bmp,.avif,.svg,.ico,.tif,.tiff" />
      <!-- 上下文用量浮窗(位置同样贴到圆环按钮上方) -->
      <div class="popover ctx-pop" id="ctx-pop" role="dialog" aria-label="上下文用量明细"
           style="width:344px; max-width:calc(100vw - 20px);">
        <div class="pop-title"><svg class="icon sm"><use href="#i-layers" xlink:href="#i-layers"/></svg> 上下文用量
          <span class="pop-sub" id="ctx-pop-src"></span></div>
        <div id="ctx-pop-body"></div>
        <div class="pop-actions" style="display:flex;gap:8px;margin-top:12px">
          <button class="btn sm" id="ctx-refresh" style="flex:1">读取模型信息</button>
          <button class="btn sm primary" id="ctx-close" style="flex:1">关闭</button>
        </div>
      </div>
    </footer>

    <div id="status-bar">
      <div class="st" data-click="1" id="st-conn" title="点击打开设置并重新测试连接">
        <span class="conn-dot" id="st-conn-dot"></span><span id="st-conn-text">就绪</span>
      </div>
      <div class="st" id="st-model-wrap"><svg class="icon"><use href="#i-cpu" xlink:href="#i-cpu"/></svg><b id="st-model">—</b></div>
      <div class="st" data-click="1" id="st-ctx-wrap" title="估算的下一轮请求上下文用量(点击打开设置)"><svg class="icon"><use href="#i-layers" xlink:href="#i-layers"/></svg><b id="st-ctx">0 条 / ~0 tok</b></div>
      <div class="st" id="st-last-wrap" title="最近一次生成统计"><svg class="icon"><use href="#i-activity" xlink:href="#i-activity"/></svg><b id="st-last">—</b></div>
      <div class="spacer"></div>
      <div class="st" data-click="1" id="st-task-wrap" style="display:none" title="Python 任务状态"><svg class="icon"><use href="#i-clock" xlink:href="#i-clock"/></svg><b id="st-task">—</b></div>
      <div class="st" data-click="1" id="st-mcp-wrap" title="MCP 工具服务状态"><svg class="icon"><use href="#i-plug" xlink:href="#i-plug"/></svg><b id="st-mcp">MCP 关闭</b></div>
      <div class="st" data-click="1" id="st-env-wrap" title="运行环境(点击查看环境自检)"><svg class="icon"><use href="#i-shield" xlink:href="#i-shield"/></svg><b id="st-env">—</b></div>
    </div>
  </main>

  <!-- ============ 工作区右栏(② 沙箱虚拟盘) ============ -->
  <aside id="ws-rail" class="collapsed" aria-label="工作区面板">
    <div class="wsr-head">
      <svg class="icon sm"><use href="#i-layers" xlink:href="#i-layers"/></svg>
      <b>工作区</b>
      <span class="wsr-sub" id="wsr-sub">—</span>
      <button class="icon-btn" id="btn-wsr-jupyter" title="通过 JupyterLab 打开(工作区为根)" aria-label="通过 JupyterLab 打开" hidden>
        <svg class="icon"><use href="#i-jupyter" xlink:href="#i-jupyter"/></svg>
      </button>
      <button class="icon-btn" id="btn-wsr-close" title="收起工作区面板" aria-label="收起工作区面板">
        <svg class="icon sm"><use href="#i-right" xlink:href="#i-right"/></svg>
      </button>
    </div>
    <div class="wsr-body" id="wsr-body">
      <div id="wsr-switch"></div>
      <div class="wsr-info" id="wsr-info"></div>
      <div class="wsr-tools" id="wsr-tools" hidden>
        <button class="tool-btn" data-wsr="upload" title="上传文件(可多选;也可以把文件或整个文件夹拖进这一栏)">
          <svg class="icon sm"><use href="#i-upload" xlink:href="#i-upload"/></svg></button>
        <button class="tool-btn" data-wsr="mkdir" title="新建文件夹">
          <svg class="icon sm"><use href="#i-folder" xlink:href="#i-folder"/></svg></button>
        <button class="tool-btn" data-wsr="refresh" title="刷新列表">
          <svg class="icon sm"><use href="#i-refresh" xlink:href="#i-refresh"/></svg></button>
        <button class="tool-btn" data-wsr="zip" title="下载整箱(打包成 zip)">
          <svg class="icon sm"><use href="#i-download" xlink:href="#i-download"/></svg></button>
        <button class="tool-btn" data-wsr="recount" title="重算用量(游标扫描文件记录,较慢但准确)">
          <svg class="icon sm"><use href="#i-activity" xlink:href="#i-activity"/></svg></button>
        <span class="wsr-spacer"></span>
        <button class="tool-btn" data-wsr="rename" title="重命名工作区">
          <svg class="icon sm"><use href="#i-edit" xlink:href="#i-edit"/></svg></button>
        <button class="tool-btn danger" data-wsr="drop" title="删除工作区(文件一并删除,不可撤销)">
          <svg class="icon sm"><use href="#i-trash" xlink:href="#i-trash"/></svg></button>
      </div>
      <div class="wsr-crumb" id="wsr-crumb" hidden></div>
      <div class="wsr-files list-box" id="wsr-files"></div>
      <div class="wsr-prog" id="wsr-prog" hidden></div>
      <div class="wsr-report" id="wsr-report" hidden></div>
    </div>
    <div class="wsr-foot" id="wsr-foot" hidden>
      <button class="btn sm grow" id="btn-wsr-mount" data-wsr="mount">挂载到当前会话</button>
      <button class="btn sm grow" id="btn-wsr-persist" data-wsr="persist" title="请浏览器把本页的本地数据标记为「持久化」,尽量不被自动清理">申请持久化存储</button>
    </div>
  </aside>
  <div id="ws-rail-backdrop"></div>
</div>

<!-- 工作区上传入口:单文件与批量共用一条入口,不带 accept、不调 isBlockedExt()(不限扩展名) -->
<input type="file" id="ws-file" multiple style="display:none" />

<!-- ============ 设置 ============ -->
<div class="modal-mask" id="settings-modal" role="dialog" aria-modal="true" aria-label="设置" data-noclose>
  <div class="modal wide">
    <div class="modal-head">
      <h2><svg class="icon"><use href="#i-sliders" xlink:href="#i-sliders"/></svg> 设置</h2>
      <button class="icon-btn" data-close aria-label="关闭"><svg class="icon"><use href="#i-x" xlink:href="#i-x"/></svg></button>
    </div>
    <div class="tabs" id="settings-tabs">
      <button data-tab="model" class="active"><svg class="icon sm"><use href="#i-cpu" xlink:href="#i-cpu"/></svg> 模型</button>
      <button data-tab="gen"><svg class="icon sm"><use href="#i-zap" xlink:href="#i-zap"/></svg> 生成</button>
      <button data-tab="attach"><svg class="icon sm"><use href="#i-image" xlink:href="#i-image"/></svg> 附件</button>
      <button data-tab="look"><svg class="icon sm"><use href="#i-palette" xlink:href="#i-palette"/></svg> 外观</button>
      <button data-tab="data"><svg class="icon sm"><use href="#i-download" xlink:href="#i-download"/></svg> 数据</button>
      <button data-tab="mcp"><svg class="icon sm"><use href="#i-plug" xlink:href="#i-plug"/></svg> MCP 工具</button>
      <button data-tab="env"><svg class="icon sm"><use href="#i-shield" xlink:href="#i-shield"/></svg> 环境</button>
    </div>
    <div class="modal-body">

      <!-- ---------- 模型(连接 + 模型合一) ---------- -->
      <div class="tab-panel active" data-panel="model">
        <div class="field">
          <label>API 协议</label>
          <div class="seg" id="proto-switch">
            <button data-proto="openai" class="openai active">OpenAI 兼容</button>
            <button data-proto="anthropic" class="anthropic">Anthropic</button>
          </div>
          <div class="hint" id="proto-hint"></div>
        </div>
        <div class="field">
          <label for="set-base">Base URL</label>
          <input type="text" id="set-base" spellcheck="false" placeholder="http://127.0.0.1:8080/v1" autocomplete="off" />
          <div class="hint">已含 <code>/v1</code> 时不会重复拼接。留空的协议部分会按当前协议自动补齐。</div>
          <div class="chips" style="margin-top:9px">
            <button class="chip-btn" data-base="http://127.0.0.1:8080/v1">自定义服务</button>
            <button class="chip-btn" data-base="http://localhost:8080/v1">llama.cpp</button>
            <button class="chip-btn" data-base="https://api.openai.com/v1">OpenAI</button>
            <button class="chip-btn" data-base="https://api.deepseek.com/v1">DeepSeek</button>
          </div>
        </div>
        <div class="field">
          <label for="set-key">API Key</label>
          <div class="input-wrap">
            <input type="password" id="set-key" placeholder="本地服务可留空" spellcheck="false" autocomplete="off" />
            <button class="reveal" id="btn-reveal-key" title="显示 / 隐藏" aria-label="显示或隐藏密钥">
              <svg class="icon sm"><use href="#i-eye" xlink:href="#i-eye"/></svg>
            </button>
          </div>
          <div class="hint">OpenAI 协议使用 <code>Authorization: Bearer …</code>;Anthropic 协议使用 <code>x-api-key</code>。密钥仅保存在本机 localStorage,不会发送到其他任何地方。</div>
        </div>
        <div class="field">
          <label>连接测试</label>
          <div style="display:flex;gap:9px">
            <button class="btn" id="btn-test" style="flex:1"><svg class="icon sm"><use href="#i-zap" xlink:href="#i-zap"/></svg> 测试连接与延迟</button>
            <button class="btn" id="btn-fetch-models-top" style="flex:1"><svg class="icon sm"><use href="#i-refresh" xlink:href="#i-refresh"/></svg> 拉取模型列表</button>
          </div>
          <div class="note" id="test-result"></div>
        </div>
        <div class="sec-title">当前模型</div>
        <div class="field">
          <label for="set-model">模型名称</label>
          <div class="input-row">
            <div class="input-wrap"><input type="text" id="set-model" placeholder="选择或输入模型名" spellcheck="false" autocomplete="off" />
              <button class="reveal" id="btn-model-list" title="展开模型列表" aria-label="展开模型列表">
                <svg class="icon sm"><use href="#i-down" xlink:href="#i-down"/></svg>
              </button>
            </div>
            <button class="sq-btn" id="btn-pick-model" title="打开模型列表"><svg class="icon sm"><use href="#i-book" xlink:href="#i-book"/></svg></button>
            <button class="sq-btn" id="btn-fetch-models" title="从服务器刷新模型列表"><svg class="icon sm"><use href="#i-refresh" xlink:href="#i-refresh"/></svg></button>
          </div>
          <div class="hint" id="models-hint">尚未获取模型列表。</div>
          <div class="hint" id="ctx-window-hint" style="margin-top:5px">上下文窗口:未知(将按当前设定计算)。</div>
        </div>
        <div class="sec-title">服务器返回的模型</div>
        <div class="list-box" id="models-inline" style="max-height:260px"></div>
        <div class="sec-title">高级(兼容性)</div>
        <div class="field">
          <div class="switch-row">
            <div class="sw-txt"><label>预检规避兼容模式</label><small>服务端没处理 CORS 预检(OPTIONS)时的应急手段:请求改用简单请求(Content-Type: <code>text/plain</code>、不带任何自定义头),浏览器不再发预检。仅「OpenAI 兼容 + 未填 API Key」时可用;打开前会自动探测服务端(四条探针),探不通就拒绝开启。只作应急,不用时请关掉。</small></div>
            <label class="switch"><input type="checkbox" id="set-cors-bypass" /><span class="slider"></span></label>
          </div>
          <div class="hint" id="cors-bypass-hint"></div>
          <div class="note" id="cors-bypass-note"></div>
        </div>
      </div>

      <!-- ---------- 生成 ---------- -->
      <div class="tab-panel" data-panel="gen">
        <div class="field">
          <div class="switch-row">
            <div class="sw-txt"><label>流式输出</label><small>逐字返回。若浏览器不支持流式读取会自动关闭。</small></div>
            <label class="switch"><input type="checkbox" id="set-stream" /><span class="slider"></span></label>
          </div>
          <div class="switch-row">
            <div class="sw-txt"><label>自动滚动到最新</label><small>生成过程中自动跟随到底部。</small></div>
            <label class="switch"><input type="checkbox" id="set-autoscroll" /><span class="slider"></span></label>
          </div>
          <div class="switch-row">
            <div class="sw-txt"><label>显示思考过程</label><small>模型返回 reasoning 内容时展示可折叠的思考块。</small></div>
            <label class="switch"><input type="checkbox" id="set-show-reasoning" /><span class="slider"></span></label>
          </div>
          <div class="switch-row">
            <div class="sw-txt"><label>进入页面自动同步模型</label><small>打开时静默向服务端拉取一次模型列表。</small></div>
            <label class="switch"><input type="checkbox" id="set-auto-sync" /><span class="slider"></span></label>
          </div>
        </div>
        <div class="sec-title">思考强度</div>
        <div class="field">
          <label>Reasoning Effort</label>
          <div class="nsel" id="set-reff"></div>
          <div class="hint">OpenAI 协议发送 <code>reasoning_effort</code>;Anthropic 协议发送 <code>output_config.effort</code>(新模型支持,旧端点可能忽略或报错)。默认不发送。</div>
        </div>
        <div class="sec-title">采样参数(默认值)</div>
        <div class="field">
          <label>采样温度 <span class="hint" style="display:inline">拉到最左为「不发送」;越低越确定,越高越发散</span></label>
          <div class="range-row"><input type="range" id="set-temp" min="-1" max="2" step="0.05" /><span class="val" id="set-temp-v"></span></div>
        </div>
        <div class="field">
          <label>Top P</label>
          <div class="range-row"><input type="range" id="set-topp" min="-1" max="1" step="0.01" /><span class="val" id="set-topp-v"></span></div>
        </div>
        <div class="field">
          <label>最大输出 tokens</label>
          <div class="range-row"><input type="range" id="set-maxtok" min="0" max="393216" step="1024" /><span class="val" id="set-maxtok-v"></span></div>
          <div class="hint">可拖动范围 0 ~ 384K(步进 1K)。0 表示「不发送」:OpenAI 协议交由服务端决定;Anthropic 协议必须带 <code>max_tokens</code>,此时按 <b>256K</b> 发送。</div>
        </div>
        <div class="field">
          <label>重复惩罚 (frequency_penalty)</label>
          <div class="range-row"><input type="range" id="set-reppen" min="0" max="2" step="0.01" /><span class="val" id="set-reppen-v"></span></div>
          <div class="hint">0 表示不发送该参数。用于抑制逐字重复。</div>
        </div>
        <div class="field">
          <label>话题新鲜度 (presence_penalty)</label>
          <div class="range-row"><input type="range" id="set-presence" min="0" max="2" step="0.01" /><span class="val" id="set-presence-v"></span></div>
          <div class="hint">0 表示不发送该参数。用于鼓励模型引入新话题。</div>
        </div>
        <div class="sec-title">上下文管理</div>
        <div class="field">
          <label>最多携带的历史消息条数</label>
          <div class="range-row"><input type="range" id="set-ctxmsgs" min="0" max="200" step="2" /><span class="val" id="set-ctxmsgs-v"></span></div>
          <div class="hint">0 表示不限制(发送全部历史)。超出时从最早的消息开始丢弃,系统提示词始终保留。本应用不按 token 截断历史,实时用量见输入框右侧的上下文环。</div>
        </div>
        <!-- 上下文长度(手动设定):服务端返回了该模型的窗口长度时本项自动隐藏(以服务端为准) -->
        <div class="field" id="set-ctxwin-field" style="display:none">
          <label>上下文长度 <span class="hint" style="display:inline">服务端没给窗口长度时按它估算</span></label>
          <div class="range-row">
            <input type="range" id="set-ctxwin" min="8" max="1024" step="8" />
            <span class="val ctxk"><input type="number" id="set-ctxwin-n" min="8" max="1024" step="8" inputmode="numeric" /><i>K</i></span>
          </div>
          <div class="hint">8 ~ 1024K(步进 8K),默认 256K。服务端返回了该模型的窗口长度时会以服务端为准,本项不参与计算。改动立即生效(用量环与压缩阈值同口径)。</div>
        </div>
        <div class="sec-title">默认系统提示词</div>
        <div class="field">
          <textarea id="set-sys" rows="4" placeholder="可选。新建对话时的初始系统提示词。"></textarea>
          <div class="hint">每个对话都可以单独覆盖此值(对话菜单 → 系统提示词)。</div>
        </div>
      </div>

      <!-- ---------- 外观 ---------- -->
      <div class="tab-panel" data-panel="look">
        <div class="field">
          <label>主题</label>
          <div class="seg" id="theme-switch">
            <button data-theme="dark"><svg class="icon sm"><use href="#i-moon" xlink:href="#i-moon"/></svg> 深色</button>
            <button data-theme="light"><svg class="icon sm"><use href="#i-sun" xlink:href="#i-sun"/></svg> 浅色</button>
            <button data-theme="system"><svg class="icon sm"><use href="#i-monitor" xlink:href="#i-monitor"/></svg> 跟随系统</button>
          </div>
        </div>
        <div class="field">
          <label>主题色</label>
          <div class="swatches" id="accent-switch">
            <button class="swatch" data-accent="mint" title="薄荷"></button>
            <button class="swatch" data-accent="sakura" title="樱花"></button>
            <button class="swatch" data-accent="lavender" title="薰衣草"></button>
            <button class="swatch" data-accent="sky" title="天空蓝"></button>
            <button class="swatch" data-accent="peach" title="蜜桃"></button>
            <button class="swatch" data-accent="lemon" title="柠檬"></button>
            <button class="swatch" data-accent="matcha" title="抹茶"></button>
            <button class="swatch" data-accent="lilac" title="丁香"></button>
            <button class="swatch" data-accent="aqua" title="海盐"></button>
            <button class="swatch" data-accent="coral" title="珊瑚"></button>
            <button class="swatch" data-accent="taro" title="芋泥"></button>
            <button class="swatch" data-accent="cream" title="奶油"></button>
          </div>
          <div class="hint">主题色会同时影响按钮、链接、气泡、背景光晕、网格与边框描边。</div>
        </div>
        <div class="field">
          <label>标签页图标</label>
          <div class="fav-row">
            <button type="button" class="fav-preview" id="fav-preview" title="点击选择图片;也可把图片拖到这里">
              <img id="fav-preview-img" alt="当前标签页图标" />
            </button>
            <div class="fav-meta">
              <div class="fav-cur" id="fav-cur">默认图标</div>
              <div class="fav-btns">
                <button type="button" class="btn sm" id="btn-fav-upload">选择图片…</button>
                <button type="button" class="btn sm ghost" id="btn-fav-reset">重置为默认</button>
              </div>
            </div>
          </div>
          <div class="hint">图标以内嵌数据保存在本机(标签页与收藏夹即取即用),断网与 file:// 打开都会显示,不依赖外部文件。建议方形图片,会自动居中裁剪并缩放到 ≤256px;原图只在本页处理,不会离开本机。</div>
          <input type="file" id="fav-file" accept="image/*" style="display:none" />
        </div>
        <div class="field">
          <label>桌面快捷方式</label>
          <div class="dsk-state" id="dsk-state">—</div>
          <div class="dsk-btns">
            <button type="button" class="btn sm" id="btn-dsk-ico">下载图标(.ico)</button>
            <button type="button" class="btn sm" id="btn-dsk-url">下载快捷方式(.url)</button>
            <button type="button" class="btn sm ghost" id="btn-dsk-write" hidden>写入文件夹…</button>
          </div>
          <div class="hint gap-top multi" id="dsk-hint">生成 Windows 原生 `.url` 快捷方式与自定义 `.ico` 图标(状态与步骤见上方,仅 `file://` 打开时可用)。`.html` 文件本身的图标由系统按文件类型决定,网页无法改写它。</div>
        </div>
        <div class="field">
          <div class="switch-row">
            <div class="sw-txt"><label>紧凑模式</label><small>压缩界面密度(顶栏/侧栏/消息与输入区间距、按钮与弹窗内边距都变小,窗口较窄时左右栏仍能并排),一屏显示更多内容。会<b>关闭毛玻璃</b>以省 GPU;触屏 / 平板不建议开启(点击目标会变小)。</small></div>
            <label class="switch"><input type="checkbox" id="set-compact" /><span class="slider"></span></label>
          </div>
          <div class="switch-row">
            <div class="sw-txt"><label>动态背景与过渡动画</label><small>关闭可显著降低低配设备的 GPU 占用。</small></div>
            <label class="switch"><input type="checkbox" id="set-fx" /><span class="slider"></span></label>
          </div>
          <div class="switch-row">
            <div class="sw-txt"><label>代码块自动换行</label><small>关闭时超长代码横向滚动。</small></div>
            <label class="switch"><input type="checkbox" id="set-codewrap" checked /><span class="slider"></span></label>
          </div>
        </div>
      </div>

      <!-- ---------- 数据 ---------- -->
      <div class="tab-panel" data-panel="data">
        <div class="sec-title">本地存储</div>
        <div class="kv" style="margin-bottom:10px">
          <dt>对话数量</dt><dd id="ds-convs">0</dd>
          <dt>消息数量</dt><dd id="ds-msgs">0</dd>
          <dt>数据总量</dt><dd id="ds-total">—</dd>
          <dt>设置</dt><dd id="ds-settings">—</dd>
          <dt>小仓库占用</dt><dd id="ds-size">—</dd>
        </div>
        <div class="meter" id="ds-meter"><i style="width:0%"></i></div>
        <div class="hint gap-top multi" id="ds-hint">—</div>
        <div style="display:flex;gap:9px;flex-wrap:wrap;margin-top:12px">
          <button class="btn sm" id="btn-space"><svg class="icon sm"><use href="#i-eraser" xlink:href="#i-eraser"/></svg> 清理空间</button>
          <button class="btn sm" id="btn-probe-storage"><svg class="icon sm"><use href="#i-activity" xlink:href="#i-activity"/></svg> 精确探测可用空间</button>
        </div>
        <div class="hint" style="margin-top:9px">数据会随用随存、自动整理;真要腾地方时点「清理空间」,勾选后才会删东西。</div>
        <div class="sec-title">工作区(沙箱虚拟盘)</div>
        <div class="kv" style="margin-bottom:10px">
          <dt>工作区数量</dt><dd id="ds-ws-count">0</dd>
          <dt>合计占用</dt><dd id="ds-ws-used">—</dd>
          <dt>用量上限</dt><dd id="ds-ws-quota">—</dd>
        </div>
        <div class="list-box" id="ds-ws-list" style="max-height:220px"></div>
        <div style="display:flex;gap:9px;flex-wrap:wrap;margin-top:12px">
          <button class="btn sm" id="btn-ws-create"><svg class="icon sm"><use href="#i-plus" xlink:href="#i-plus"/></svg> 新建工作区</button>
        </div>
        <div class="hint gap-top multi" id="ds-ws-hint">—</div>
        <div class="sec-title">占用排行</div>
        <div class="list-box" id="ds-rank"></div>
        <div class="sec-title">备份与恢复</div>
        <div style="display:flex;gap:9px;flex-wrap:wrap">
          <button class="btn" id="btn-export"><svg class="icon sm"><use href="#i-download" xlink:href="#i-download"/></svg> 导出全部(JSON)</button>
          <button class="btn" id="btn-export-md"><svg class="icon sm"><use href="#i-file" xlink:href="#i-file"/></svg> 导出对话(Markdown)</button>
          <button class="btn" id="btn-import"><svg class="icon sm"><use href="#i-upload" xlink:href="#i-upload"/></svg> 导入备份</button>
          <button class="btn danger" id="btn-wipe"><svg class="icon sm"><use href="#i-trash" xlink:href="#i-trash"/></svg> 清空全部</button>
        </div>
        <div class="hint gap-top">导入会覆盖当前全部数据。导出的 JSON 内含对话与设置(含 API Key,请注意保管)。</div>
        <input type="file" id="import-file" accept=".json,application/json" style="display:none" />
        <div class="sec-title">提示词模板库</div>
        <div class="hint" style="margin-bottom:9px">模板会出现在输入框上方的“提示词模板”按钮中,可一键插入。</div>
        <div class="list-box" id="lib-list" style="max-height:220px"></div>
        <div class="field-row" style="margin-top:10px">
          <div class="field"><input type="text" id="lib-name" placeholder="模板名称" /></div>
          <div class="field" style="flex:2"><input type="text" id="lib-text" placeholder="模板内容" /></div>
          <div class="field" style="flex:none"><button class="btn sm" id="lib-add">添加</button></div>
        </div>
      </div>

      <!-- ---------- MCP 工具(给对话中的模型调用) ---------- -->
      <div class="tab-panel" data-panel="mcp">
        <div class="mcp-state" id="mcp-state">
          <div class="ms-ico"><svg class="icon lg"><use href="#i-plug" xlink:href="#i-plug"/></svg></div>
          <div class="ms-txt">
            <b id="mcp-title">模型工具调用已关闭</b>
            <small id="mcp-sub">默认关闭。开启后,对话中的模型可以调用下面的工具处理信息后再作答。</small>
          </div>
          <label class="switch"><input type="checkbox" id="mcp-enabled" /><span class="slider"></span></label>
        </div>
        <div class="mcp-intro">
          <p><b>工具怎么给到模型:</b>走协议原生的 function calling 通道 ——
            OpenAI 兼容协议在请求里发 <code>tools</code>、读流式 <code>tool_calls</code>;
            Anthropic 协议发 <code>tools</code>(<code>input_schema</code>)、读 <code>tool_use</code> 并回填 <code>tool_result</code>。
            模型每调用一次,页面就把结果回填并让它继续作答。</p>
          <p><b>只在本页内运行:</b>开关、权限、限额与执行全部发生在当前页面,
            页面不对外暴露任何接口,也不接受外部调用。</p>
          <p><b>前置条件:</b>需要服务端支持 function calling。不支持时模型不会主动调用工具,
            只是照常回答(此时发出的 <code>tools</code> 参数会被自动去掉重试一次)。</p>
        </div>

        <div class="sec-title">工具与权限</div>
        <div class="field">
          <div class="switch-row">
            <div class="sw-txt"><label for="set-tool-net">允许工具联网</label><small>影响所有可联网的工具(浏览器 JS 沙箱与 Python 解释器都读这一项)。关闭时,两类执行环境里的 fetch / XMLHttpRequest / WebSocket / EventSource / indexedDB / importScripts / BroadcastChannel / SharedWorker / sendBeacon 都被换成抛错的桩函数。</small></div>
            <label class="switch"><input type="checkbox" id="set-tool-net" /><span class="slider"></span></label>
          </div>
        </div>
        <div class="tool-list" id="mcp-tools"></div>

        <!-- ---------- 上下文压缩(Compact 工具 / 自动压缩;与紧凑模式无关) ---------- -->
        <div class="sec-title">上下文压缩</div>
        <div class="field">
          <div class="switch-row">
            <div class="sw-txt"><label for="set-compact-auto">接近窗口上限时自动压缩</label><small>默认开启。当前会话的上下文用量达到下面的阈值时,自动生成一份交接总结,然后丢弃较早的消息及其附件(彻底删除、不可回看;工作区文件与后台任务不受影响)。关掉后只能由模型调用 Compact 工具,或用下面的「立即压缩」。</small></div>
            <label class="switch"><input type="checkbox" id="set-compact-auto" /><span class="slider"></span></label>
          </div>
        </div>
        <div class="field">
          <label>自动压缩阈值</label>
          <div class="range-row"><input type="range" id="set-compact-pct" min="60" max="95" step="1" /><span class="val" id="set-compact-pct-v"></span></div>
          <div class="hint">60% ~ 95%(默认 85%)。用量超过它就自动压缩一次;提醒阈值 = 本值 − 15 个百分点(下限 50%)—— 到达提醒阈值后,系统提示里会告诉模型「接近上限、尽快收尾或调用 Compact」,但不会自动删任何东西。<b>与「紧凑模式」(界面密度)无关</b>,只是名字相邻。若「上下文管理」里开了历史条数上限,它会与压缩叠加生效。</div>
        </div>
        <div class="field">
          <button class="btn" id="btn-compact-now">立即压缩当前会话</button>
          <div class="hint">先生成一份交接总结,再彻底删除较早的消息及其附件(不可撤销;工作区文件与后台任务不受影响)。生成中或已有压缩在进行时会被拒绝。</div>
        </div>

        <!-- ---------- 外部 MCP 服务器(本机进程;默认关闭) ---------- -->
        <div class="sec-title">外部 MCP 服务器</div>
        <div class="mcp-intro">
          <p><b>工具来自你本机运行的 MCP 服务器</b>(例如 Rust-MCP-Server)。总开关关闭时,
            页面<b>不会</b>向服务器发送任何请求;打开后,模型调用外部工具时参数与结果会经过该服务器。</p>
          <p><b>数据边界:</b>请只填你自己信任的本机地址。开了外部工具,工具参数与结果就会出到那台服务器。</p>
          <p><b>离线打开本文件:</b>浏览器把 <code>file://</code> 页面的来源记为 <code>null</code>,
            服务器必须放行 <code>Origin: null</code>(本机 Rust-MCP-Server 0.6.0+ 已内置放行),
            否则会连不上、控制台报 CORS 错误。</p>
        </div>
        <div class="field">
          <div class="switch-row">
            <div class="sw-txt"><label for="mcp-ext-enabled">启用外部 MCP 工具</label><small>这是<b>全局默认值</b>:内部工具与外部工具互相独立,可以只开一边。开关变更不会重发当前请求,下一轮生效。</small></div>
            <label class="switch"><input type="checkbox" id="mcp-ext-enabled" /><span class="slider"></span></label>
          </div>
          <div class="note" id="mcp-ext-override-note"></div>
        </div>
        <div class="field">
          <label for="mcp-ext-url">服务器地址(MCP 端点)</label>
          <div style="display:flex;gap:8px">
            <input type="text" id="mcp-ext-url" placeholder="http://127.0.0.1:3344/mcp" spellcheck="false" autocomplete="off" style="flex:1" />
            <button class="btn sm" id="mcp-ext-test" style="flex:none">测试连接</button>
          </div>
          <div class="hint">默认 <code>http://127.0.0.1:3344/mcp</code>(Rust-MCP-Server 的默认 MCP 端口与端点路径)。
            改地址或改令牌后旧连接即作废,需要重新「测试连接」。</div>
        </div>
        <div class="note" id="mcp-ext-status"></div>
        <div class="field">
          <label for="mcp-ext-auth">Bearer 鉴权令牌(可留空)</label>
          <input type="password" id="mcp-ext-auth" autocomplete="off" placeholder="留空 = 不发送 Authorization 头" />
          <div class="hint">只存在本机浏览器设置里;<b>导出备份会包含它</b>,请妥善保管备份文件。</div>
        </div>
        <div class="field">
          <label>外部工具默认权限</label>
          <div class="nsel nsel-flex" id="mcp-ext-perm"></div>
          <div class="hint">新出现的外部工具默认按这里处理(默认「每次询问」,推荐保留)。
            个别工具可在下面的工具清单里单独设成允许 / 禁止,以那个为准。</div>
        </div>
        <div class="field">
          <div class="switch-row">
            <div class="sw-txt"><label for="mcp-ext-inject">把服务器 instructions 注入系统提示</label><small>默认关闭。开启后,服务器握手时返回的 instructions 会被拼进系统提示词 —— 这属于「服务器往你的提示词里写东西」的注入面,请只对可信服务器开启。</small></div>
            <label class="switch"><input type="checkbox" id="mcp-ext-inject" /><span class="slider"></span></label>
          </div>
        </div>
        <div class="note" id="mcp-ext-instr"></div>
        <div class="note" id="mcp-ext-note"></div>
        <div class="tool-scroll" id="mcp-ext-scroll" hidden>
          <div class="tool-list" id="mcp-ext-tools"></div>
        </div>
        <div style="margin-top:10px;display:flex;gap:8px;flex-wrap:wrap">
          <button class="btn ghost sm" id="mcp-ext-refresh"><svg class="icon sm"><use href="#i-refresh" xlink:href="#i-refresh"/></svg> 重新读取工具列表</button>
          <button class="btn ghost sm" id="mcp-ext-all-deny">全部禁用</button>
        </div>

        <div class="sec-title">资源与限额</div>
        <div class="field">
          <label>单次执行超时</label>
          <div class="range-row"><input type="range" id="set-tool-timeout" min="60000" max="3600000" step="60000" /><span class="val" id="set-tool-timeout-v"></span></div>
          <div class="hint">1 ~ 60 分钟(默认 10 分钟)。超时后直接销毁运行沙箱 —— 即使代码是死循环也能停下来,并把超时信息作为工具结果返回给模型。生成过程中按停止(Ctrl+X)也会立即销毁沙箱。</div>
        </div>
        <div class="field">
          <label>每轮最多调用次数</label>
          <div class="range-row"><input type="range" id="set-tool-calls" min="1" max="100" step="1" /><span class="val" id="set-tool-calls-v"></span></div>
          <div class="hint">1 ~ 100 次(默认 50)。模型在一轮里最多能连续调用多少次工具,超出后不再放行,让它直接作答。</div>
        </div>
        <div class="field">
          <label>结果长度上限</label>
          <div class="range-row"><input type="range" id="set-tool-out" min="1000" max="131072" step="1000" /><span class="val" id="set-tool-out-v"></span></div>
          <div class="hint">1K ~ 128K 字符(默认 16K)。工具输出超过上限时会保留末尾并注明截断量(不再标注原始长度);档位提示、工作区回写、并发冲突等短注记不受影响,不会因结果过长而丢失。</div>
        </div>
        <div class="field">
          <label>同时生成会话数上限</label>
          <div class="range-row"><input type="range" id="set-gen-max" min="1" max="6" step="1" /><span class="val" id="set-gen-max-v"></span></div>
          <div class="hint">1 ~ 6 条(默认 3)。多条会话可以同时生成;超过上限的发送会转入该会话的「待发送」浮窗,任一会话收尾后自动补发。提示:Python 解释器池上限为 2,设得更高会更容易撞到「池已满」。</div>
        </div>

        <div class="sec-title">Python 任务</div>
        <div class="field">
          <label>后台任务超时</label>
          <div class="range-row"><input type="range" id="set-py-task-timeout" min="60000" max="3600000" step="60000" /><span class="val" id="set-py-task-timeout-v"></span></div>
          <div class="hint">1 ~ 60 分钟(默认 30 分钟)。只作用于 <code>run_in_background=true</code> 的任务:到点直接销毁解释器并把状态标成「已超时」(python 在浏览器里没有协作式中断,销毁是唯一手段)。前台执行另有「单次执行超时」控制。</div>
        </div>
        <div class="note" id="py-task-summary"></div>
        <div class="hint">同时最多 2 个未完成任务(前台 + 后台合计),第 3 个会被拒绝并提示先停止其中一个。<b>任务不跨刷新</b>:刷新或关闭页面后任务与记录全部消失(已回写到工作区的产物不受影响),长任务请让脚本把中间结果写进工作区文件。</div>

        <div class="sec-title">工作区会话上限</div>
        <div class="field">
          <label for="set-ws-session-bytes">一次会话预载上限</label>
          <input type="number" id="set-ws-session-bytes" min="1" max="256" step="1" inputmode="numeric" />
          <div class="hint">1 ~ 256 MB(默认 16)。会话挂载工作区时最多把多少文件内容预载进执行环境;超出的文件只进清单、按需再读(标为 <code>remote</code>)。</div>
        </div>
        <div class="field">
          <label for="set-ws-session-wback">一次会话回写硬顶</label>
          <input type="number" id="set-ws-session-wback" min="16" max="4096" step="16" inputmode="numeric" />
          <div class="hint">16 ~ 4096 MB(默认 256)。一次会话里所有任务回写工作区的总字节硬顶,超出即失败(不会写半截)。</div>
        </div>
        <div class="field">
          <label for="set-ws-session-files">一次会话回写文件数上限</label>
          <input type="number" id="set-ws-session-files" min="100" max="20000" step="100" inputmode="numeric" />
          <div class="hint">100 ~ 20000 个(默认 2000)。一次会话里所有任务回写的文件条数上限。</div>
        </div>

        <div class="sec-title">调用记录(最近 100 条)</div>
        <div class="console-log" id="mcp-log"></div>
        <div style="margin-top:10px">
          <button class="btn ghost sm" id="tool-log-clear"><svg class="icon sm"><use href="#i-eraser" xlink:href="#i-eraser"/></svg> 清空记录</button>
        </div>
      </div>


      <!-- ---------- 附件 ---------- -->
      <div class="tab-panel" data-panel="attach">
        <div class="sec-title">上传限制</div>
        <dl class="kv" style="margin-bottom:10px">
          <dt>允许的类型</dt><dd>纯文本 / 图片 / PDF</dd>
          <dt>单个文件上限</dt><dd>50 MB</dd>
          <dt>单条消息附件数</dt><dd>10 个</dd>
          <dt>单条消息总大小</dt><dd id="kv-attach-max">—</dd>
          <dt>文本读取上限</dt><dd>128K 字符 / 文件</dd>
          <dt>图片最大边长</dt><dd id="kv-img-max">—</dd>
          <dt>图片发送方式</dt><dd>base64 内联(data URL),不发图片地址</dd>
        </dl>

        <div class="field">
          <div class="range-row">
            <span class="r-lab">图片最大边长</span>
            <input type="range" id="set-imgmax" min="512" max="8192" step="64" />
            <span class="val" id="set-imgmax-v"></span>
          </div>
          <div class="hint">512 ~ 8192 px(默认 4096)。超过就等比下采样;数值越大越清晰,请求体积 / token 与本地存储占用也越大。</div>
        </div>
        <div class="field">
          <div class="nsel" id="set-resample"></div>
          <div class="hint">浏览器只暴露 low / medium / high 三档平滑质量,所以「样条插值」是<b>逐级减半 + high 质量</b>的组合,最接近专业立方 / 样条重采样。</div>
        </div>
        <div class="field">
          <div class="range-row">
            <span class="r-lab">消息附件上限</span>
            <input type="range" id="set-attachmax" min="1" max="100" step="1" />
            <span class="val" id="set-attachmax-v"></span>
          </div>
          <div class="hint">单条消息里所有附件的总量上限(默认 100 MB)。数据存在浏览器的大仓库里,所以可以放宽;真放不下时会弹「清理空间」让你确认后再处理。</div>
        </div>

        <div class="sec-title">附件图片策略</div>
        <div class="field">
          <div class="nsel" id="set-attachmode"></div>
          <div class="hint">PDF 与办公文档共用这一档。<b>默认「混合」</b>:文字 + 文档里的图片一起发送(非视觉模型下图片自动改走本机 OCR,识别结果随文字发送、原图不发)。「纯文本」只发抽出的文字、最省 token(扫描件这类没有文字层的文件会自动升档并把原因写在气泡下方);「图片」把 <b>PDF 与 docx</b> 逐页渲染成页图(docx 基于浏览器排版,分页与 Word 可能不一致;页数为渲染结果),表格(xlsx/xls)在本机绘制成表格图发给模型 —— <b>图片档要不要发图取决于模型是否支持图像输入</b>。单张图片附件(png/jpg…)始终按图片发送,不受这一档影响。</div>
        </div>
        <div class="field">
          <div class="range-row">
            <span class="r-lab">渲染分辨率</span>
            <input type="range" id="set-pdfdpi" min="72" max="300" step="1" />
            <span class="val" id="set-pdfdpi-v"></span>
          </div>
          <div class="hint">72 ~ 300 DPI(默认 150)。只影响图片档与混合档里的<b>渲染页图</b>(xlsx/xls 的本机表格图另按行/列上限绘制);纯文本档不受它约束。分辨率越高越清晰,页图体积与 token 也越大;A4 在 150 DPI 下约 1240×1754 像素。</div>
        </div>
        <div class="field">
          <div class="range-row">
            <span class="r-lab">页数上限</span>
            <input type="range" id="set-pdfpages" min="1" max="50" step="1" />
            <span class="val" id="set-pdfpages-v"></span>
          </div>
          <div class="hint">只影响图片档与混合档的<b>渲染页图</b>(最多处理这么多页);纯文本档只受 40 万字符的上限约束。办公格式的图片档能力见上面的档位说明;docx 的页图与 PDF 同口径(同一 DPI / 页数上限)。</div>
        </div>

        <div class="sec-title">图像输入能力</div>
        <dl class="kv" style="margin-bottom:10px">
          <dt>当前模型</dt><dd id="set-vision-state">—</dd>
          <dt>探测方式</dt><dd>服务端模型清单声明 → 发一张 1×1 图片试探 → 手动指定</dd>
        </dl>
        <div class="field">
          <div class="nsel" id="set-visionforce"></div>
          <div class="hint">模型不支持图像输入时,图片会改用内嵌的 Tesseract.js 做 OCR,只把识别出的文字发给模型(气泡下方会注明;附件的图片会按此自动在原图与本机 OCR 之间切换,无需另设开关)。</div>
        </div>
        <div style="display:flex;gap:9px;flex-wrap:wrap;margin-top:10px">
          <button class="btn sm" id="btn-vision-probe"><svg class="icon sm"><use href="#i-eye" xlink:href="#i-eye"/></svg> 重新探测当前模型</button>
        </div>

        <div class="sec-title">OCR(图片文字识别)</div>
        <div class="field">
          <div class="nsel" id="set-ocrlangs"></div>
          <div class="hint" id="set-ocr-state">—</div>
        </div>

        <div class="sec-title">库状态</div>
        <dl class="kv" id="attach-libs"></dl>
      </div>

      <!-- ---------- 环境 ---------- -->
      <div class="tab-panel" data-panel="env">
        <div class="sec-title">运行环境自检</div>
        <dl class="kv" id="env-kv"></dl>
        <div class="sec-title">系统与设备</div>
        <dl class="kv" id="env-sys"></dl>
        <div class="sec-title">页面信息</div>
        <dl class="kv" id="env-info"></dl>
        <div class="sec-title">显示与图形</div>
        <dl class="kv" id="env-gpu"></dl>
        <div class="sec-title">存储与配额</div>
        <dl class="kv" id="env-store"></dl>
        <div class="sec-title">诊断</div>
        <div style="display:flex;gap:9px;flex-wrap:wrap">
          <button class="btn" id="btn-diag"><svg class="icon sm"><use href="#i-activity" xlink:href="#i-activity"/></svg> 运行自检</button>
          <button class="btn" id="btn-copy-env"><svg class="icon sm"><use href="#i-copy" xlink:href="#i-copy"/></svg> 复制环境信息</button>
        </div>
        <div class="note" id="diag-result"></div>
        <!-- Python 运行时状态行(仅一行;全内嵌下没有安装/更新/清缓存环节) -->
        <div class="sec-title">Python 运行时</div>
        <div class="note" id="py-run-state"></div>
      </div>

    </div>
    <div class="modal-foot">
      <button class="btn grow primary" id="btn-save-settings"><svg class="icon sm"><use href="#i-check" xlink:href="#i-check"/></svg> 保存设置</button>
      <button class="btn" data-close>关闭</button>
    </div>
  </div>
</div>

<!-- ============ 系统提示词 ============ -->
<div class="modal-mask" id="prompt-modal" role="dialog" aria-modal="true" aria-label="系统提示词" data-noclose>
  <div class="modal">
    <div class="modal-head">
      <h2><svg class="icon"><use href="#i-book" xlink:href="#i-book"/></svg> 系统提示词</h2>
      <button class="icon-btn" data-close aria-label="关闭"><svg class="icon"><use href="#i-x" xlink:href="#i-x"/></svg></button>
    </div>
    <div class="modal-body">
      <div class="field">
        <label for="conv-system">当前对话的系统提示词</label>
        <textarea id="conv-system" rows="9" placeholder="例如:你是一位严谨的技术顾问,回答时先给结论再给依据。"></textarea>
        <div class="hint">仅对当前对话生效,留空则不发送。此内容不会出现在消息列表中,但会随每次请求发送。</div>
      </div>
      <div class="field">
        <label>从模板库插入</label>
        <div class="chips" id="prompt-lib-chips"></div>
      </div>
    </div>
    <div class="modal-foot">
      <button class="btn grow primary" id="btn-save-system">保存</button>
      <button class="btn danger" id="btn-clear-system">清空</button>
      <button class="btn" data-close>取消</button>
    </div>
  </div>
</div>

<!-- ============ 模型选择 ============ -->
<div class="modal-mask" id="model-modal" role="dialog" aria-modal="true" aria-label="选择模型">
  <div class="modal">
    <div class="modal-head">
      <h2><svg class="icon"><use href="#i-cpu" xlink:href="#i-cpu"/></svg> 选择模型</h2>
      <button class="icon-btn" data-close aria-label="关闭"><svg class="icon"><use href="#i-x" xlink:href="#i-x"/></svg></button>
    </div>
    <div class="modal-body">
      <div class="field">
        <input type="text" id="model-search" placeholder="搜索模型…(直接输入自定义模型名后按 Enter 也可选中)" spellcheck="false" autocomplete="off" />
      </div>
      <div id="model-options" class="list-box"></div>
      <div style="display:flex;align-items:center;justify-content:space-between;gap:10px;margin-top:12px;padding-top:11px;border-top:1px solid var(--border-2)">
        <span class="hint" id="model-count"></span>
        <button class="btn sm" id="btn-refresh-models"><svg class="icon sm"><use href="#i-refresh" xlink:href="#i-refresh"/></svg> 刷新</button>
      </div>
    </div>
  </div>
</div>

<!-- ============ 命令面板 ============ -->
<div class="modal-mask" id="palette-mask" role="dialog" aria-modal="true" aria-label="命令面板">
  <div id="palette">
    <div class="pal-input-row">
      <svg class="icon"><use href="#i-search" xlink:href="#i-search"/></svg>
      <input type="text" id="cmd-input" placeholder="搜索命令、模型与对话…" spellcheck="false" autocomplete="off" />
      <button type="button" class="pal-esc" id="cmd-close" title="关闭命令面板 (Esc)" aria-label="关闭命令面板">Esc</button>
    </div>
    <div id="cmd-list"></div>
    <div class="cmd-foot" id="cmd-hint">输入关键词可搜索命令、模型与对话(含消息正文) · ↑↓ 选择 · Enter 执行 · Esc 关闭</div>
  </div>
</div>

<!-- ============ 使用教程与关于 ============ -->
<div class="modal-mask" id="help-modal" role="dialog" aria-modal="true" aria-label="使用教程与关于" data-noclose>
  <div class="modal wide">
    <div class="modal-head">
      <h2><svg class="icon"><use href="#i-book" xlink:href="#i-book"/></svg> 使用教程与关于</h2>
      <button class="icon-btn" data-close aria-label="关闭"><svg class="icon"><use href="#i-x" xlink:href="#i-x"/></svg></button>
    </div>
    <div class="modal-body">
      <!-- hero:作者名(textContent)/ 链接(setAttribute) / 版本 全部由 JS 从 appA 的常量填充 -->
      <a class="about-hero" id="about-hero" href="#" target="_blank" rel="noopener noreferrer">
        <i><svg class="icon"><use href="#i-github" xlink:href="#i-github"/></svg></i>
        <span><b>AzusaAI WebUI</b><small>单文件 · 离线可用 · 零外部请求 · 数据只留在本机</small></span>
        <em><span data-about="author"></span><span data-about="ver"></span></em>
      </a>
      <div class="sec-title">使用教程</div>
      <div class="about-group" data-about="guide"></div>
      <div class="sec-title">斜杠命令</div>
      <div class="about-group" data-about="cmds"></div>
      <div class="sec-title">快捷键</div>
      <dl class="kv" id="shortcut-kv"></dl>
      <div class="sec-title">已启用的降级策略</div>
      <div id="help-env" class="hint"></div>
      <div class="sec-title">关于</div>
      <p class="hint" style="line-height:1.85">
        整个应用(Markdown 渲染、语法高亮、HTML 净化、内嵌库与字体)都在这一个 HTML 文件里,不请求任何外部资源,
        断网也能完整运行。设置保存在浏览器 localStorage,会话与附件保存在 IndexedDB —— 都不会上传到任何服务器,
        只有你自己填写的 API 地址会收到请求。
      </p>
      <dl class="kv" data-about="meta"></dl>
    </div>
    <div class="modal-foot"><button class="btn grow primary" data-close>知道了</button></div>
  </div>
</div>

<!-- ============ 后台任务(/tasks) ============ -->
<div class="modal-mask" id="tasks-modal" role="dialog" aria-modal="true" aria-label="后台任务">
  <div class="modal">
    <div class="modal-head">
      <h2><svg class="icon"><use href="#i-clock" xlink:href="#i-clock"/></svg> 后台任务</h2>
      <button class="icon-btn" data-close aria-label="关闭"><svg class="icon"><use href="#i-x" xlink:href="#i-x"/></svg></button>
    </div>
    <div class="modal-body">
      <div class="hint" id="tasks-note" style="margin-bottom:11px"></div>
      <div id="tasks-list"></div>
    </div>
    <div class="modal-foot">
      <button class="btn danger" id="tasks-stop-all">全部停止</button>
      <button class="btn grow primary" data-close>关闭</button>
    </div>
  </div>
</div>

<div class="pop-menu" id="pop-menu" role="menu"></div>
<div id="nsel-pop" role="listbox" aria-label="选项"></div>
<div id="model-suggest" role="listbox" aria-label="模型候选"></div>
<div id="toasts" aria-live="polite"></div>
<div class="lightbox" id="lightbox">
  <button class="lb-close" id="lb-close" aria-label="关闭"><svg class="icon"><use href="#i-x" xlink:href="#i-x"/></svg></button>
  <img id="lightbox-img" alt="图片预览" />
  <div class="lb-hint">滚轮缩放 · 按住左键拖拽 · 双击复位 · <span id="lb-zoom">100%</span></div>
</div>

<!-- ============ 清理空间(勾选 + 确认后才删) ============ -->
<div class="modal-mask" id="space-modal" role="dialog" aria-modal="true" aria-label="清理空间" data-noclose>
  <div class="modal">
    <div class="modal-head">
      <h2><svg class="icon"><use href="#i-eraser" xlink:href="#i-eraser"/></svg> 清理空间</h2>
      <button class="icon-btn" id="space-close" aria-label="关闭"><svg class="icon"><use href="#i-x" xlink:href="#i-x"/></svg></button>
    </div>
    <div class="modal-body">
      <div class="note" id="space-warn"></div>
      <dl class="kv" id="space-kv"></dl>
      <div class="sec-title">保护范围</div>
      <div class="field">
        <div class="range-row">
          <span class="r-lab">保护最近</span>
          <input type="range" id="space-keep" min="10" max="100" step="1" />
          <span class="val" id="space-keep-v"></span>
        </div>
        <div class="hint" id="space-keep-hint"></div>
      </div>
      <div class="sec-title">要清理什么</div>
      <div id="space-actions"></div>
      <div class="hint gap-top">
        只有勾选并点「执行清理」才会动数据 —— 平时保存与整理都是自动的,不会无感删你的东西。
        清理前建议先「导出备份」(备份里含附件,可完整恢复)。
      </div>
    </div>
    <div class="modal-foot">
      <button class="btn" id="space-export"><svg class="icon sm"><use href="#i-download" xlink:href="#i-download"/></svg> 导出备份</button>
      <button class="btn primary" id="space-run"><svg class="icon sm"><use href="#i-check" xlink:href="#i-check"/></svg> 执行清理</button>
      <button class="btn" id="space-cancel">取消</button>
    </div>
  </div>
</div>

<!-- ============ 附件预览(只能点 ✕ 关) ============ -->
<div class="modal-mask" id="file-preview-modal" role="dialog" aria-modal="true" aria-label="附件预览" data-noclose>
  <div class="modal">
    <div class="modal-head">
      <h2><svg class="icon"><use href="#i-file" xlink:href="#i-file"/></svg> <span id="fp-title">附件预览</span></h2>
      <div style="display:flex;gap:7px">
        <button class="icon-btn" id="fp-copy" title="复制内容" aria-label="复制内容"><svg class="icon"><use href="#i-copy" xlink:href="#i-copy"/></svg></button>
        <button class="icon-btn" id="fp-close" aria-label="关闭"><svg class="icon"><use href="#i-x" xlink:href="#i-x"/></svg></button>
      </div>
    </div>
    <div class="modal-body">
      <div class="fp-meta" id="fp-meta"></div>
      <pre class="fp-body" id="fp-body"></pre>
      <div class="fp-images" id="fp-images"></div>
    </div>
  </div>
</div>
