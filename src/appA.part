/* ---------------------------------------------------------------------------
   附件释放层(上下文压缩 / 清空 / 裁剪 的唯一出口)
---------------------------------------------------------------------------
   为什么必须单独有一层:附件二进制的键(`attach.blob`)会被**多条消息甚至多条会话共享**
   (最典型:duplicateConv 的副本与原件深拷贝后共用同一批键)。所以释放绝不能
   「按被删消息的键直接删」—— 必须先把消息从数组里真的移除(且保留集/被搬移的消息已回位),
   再做一次**全库引用重算**,只删「此刻已无人引用」的键。

   ★ 三条顺序契约(压缩事务;见 shared/specs/b24-context-plan.md §4.3):
     ① 先移除 + 重插保留集,再释放:`referencedBlobKeys()` 扫的是**当前**内存里的会话树,
        释放早一步就会把「即将被搬回数组的那条消息」的附件当成无引用删掉(静默丢附件);
     ② `cxReleasePlan` 的 keep 重算必须在同步块结束、被保留消息回位之后取;
     ③ 同步块内不得 await:splice / 重插 / 写 meta / 触发落盘全部同步完成,
        唯一的 async(`blobDel`)后置到重插完成之后(双标签页的 pullConvsFromIdb / mergeConvs*
        可能替换数组,中段 await 会让后续插入落进「不是我们操作的那份」数组)。
--------------------------------------------------------------------------- */
/* 收集一组消息里所有 `p.attach.blob` 键(只读,不改数据)。覆盖图片(f.id)与 pdf/office 页图(f.id-pN) */
function cxBlobKeysOfMessages(list) {
  var keys = [];
  (list || []).forEach(function (m) {
    if (!m || !Array.isArray(m.content)) return;
    m.content.forEach(function (p) {
      if (p && p.attach && p.attach.blob) keys.push(p.attach.blob);
    });
  });
  return keys;
}
/* 当前仍被任何会话引用的键集合。单独命名是为了在释放路径上显式表达「共享 blob 保护」这一语义;
   内部直接调用既有实现(referencedBlobKeys),不复制逻辑 */
function cxSurvivingBlobKeys() { return referencedBlobKeys(); }
/* 同步、只读的释放规划:去重 + 过滤空键 → 按当前引用集过滤 → 只返回 {todo, freed},不删任何东西。
   freed = Σ blobMemo(k).len(未命中按 0 —— 不为此发起 IDB 读,保持同步) */
function cxReleasePlan(keys) {
  var seen = {}, keep = cxSurvivingBlobKeys(), todo = [], freed = 0;
  (keys || []).forEach(function (k) {
    if (!k || seen[k]) return;
    seen[k] = 1;
    if (keep[k]) return;
