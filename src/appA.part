                     mergeConvsByIdb 的收尾(合并体跑完才置否,中途抛错就留给下一轮) */
};
/* 每条会话的**权威副本**长什么样:id → 指纹。来源有二 —— ① 本页成功写进 IDB 的那一份;
   ② 从 IDB 读回来时采纳的那一份(bootStorage / mergeConvsByIdb)。内存副本与它一致
   ⇒ 这条会话没有还没落库的改动;不一致 ⇒ 本页改过、还没落库(saveSoon 最多延迟 700ms),
   收敛时必须以本页为准,否则会把用户刚做的改动吃掉。
   (不能只用"本页写没写过"来判断:没写过 ≠ 改过 —— 那样会把从 IDB 读进来的每一份都当成
   有本地改动,两边永远各说各话。) */
var convSeenSigs = {};
/* 删除墓碑:id → 删除时间戳。
   光看"IDB 里没有这条"分不清"对侧把它删了"与"它还没被写进去",于是"本页未落库改动优先"
   那条分支会把对侧已删 / 已清空 / 已覆盖掉的会话连内容一起写回权威库(删了又回来)。
   墓碑是**显式的删除意图**,跟着 localStorage 记录跨标签页走,合并与落盘时都优先于本地副本。 */
var convGoneMap = {};
/* 显式撤回台账:id → 「用户把这条会话要回来」的时间戳(导入备份里带回了同一个 id)。
   墓碑只该否决"删除方向",不该否决"用户明确导入回来"这条通路 —— 而且这个意图必须跟着记录走:
   ① 本页撤回后,同一次 stateRecord() 里的 mergeConvsGone(rec0.gone) 读到的还是**撤回之前**
      那份记录,会把刚撤掉的墓碑原样加回来,convsWritable 又按墓碑挡写 ⇒ 导入回来的会话
      永远写不进 IDB(历史教训:清空 / 删除后 10 分钟内导入备份 = 静默丢数据);
   ② 对侧手里那份墓碑会让它在收敛时把刚导入的会话当成"幽灵副本"从 IDB 里删掉。
   判据统一成:墓碑与撤回,谁的意图更新谁算(见 convGoneActive / mergeConvsGone)。 */
var convRestoredMap = {};
/* 墓碑有效期:它只需要覆盖"对侧还没收到这次删除"的那几秒到几分钟。过期即失效 ——
   这样"删掉后又从备份导入回来"的极端操作不会被一张很久以前的墓碑永久挡住。
   撤回台账同一个窗口:墓碑过期后不再否决任何东西,撤回也就不必再留着 */
var CONV_GONE_MS = 10 * 60 * 1000;
/* 记录里最多带多少条墓碑 / 撤回(防记录膨胀;超出丢掉最旧的)。三处口径必须一致:
   ① 落盘(pruneConvsGone)② 记录 → 内存的合并(mergeConvsGone / mergeConvsRestored)
   ③ 批量记账(markConvsGone / markConvsRestored)都与这个常量对齐 —— 任何一处小于它,
   记录里合法的条目就会被静默丢掉(历史教训:200 条时"一次删掉 >200 个会话",
   例如清理空间按保护范围整段删,墓碑落不进记录,只能靠 wiped 的整库替换语义兜底)。
   提到 2000 让这条路径在现实规模的库上也直接覆盖(一条墓碑约 30 字节,2000 条约 60KB,
   且只在这 10 分钟窗口里出现)。
   **已知残余边界(未实测)**:一次导入回来的会话既多于 2000 条、其中又有多于 2000 条与对侧
   仍活着的墓碑同 id 时,超出的那些拿不到撤回条目、会被对侧墓碑判死 —— 要达到这个规模需要
   先一次性删掉 >2000 个会话再导入一个同类规模的备份,现实不可达;真到那种规模请先弱化墓碑 */
var CONV_GONE_MAX = 2000;
var state = loadState();
var conv = null;
var generating = false;
var abortCtrl = null;
var storageBroken = false;
var connState = { level: "idle", text: "未配置" };
var draftFiles = [];
var convSearchKw = "";
var lastStats = null;

/* ---------------------------------------------------------------------------
   附件二进制的外置存储(IndexedDB)
---------------------------------------------------------------------------
   背景:localStorage 每个源只有 ~5MB,而一张 4096px 的图就能到几 MB。
   策略:附件的 base64 payload 优先写进 IndexedDB(它和 Cache 共用那个几十 GB 的
        「站点总配额」),localStorage 里只留元数据(name/size/mime/w/h/页数…);
        读的时候从内存缓存取,缓存没有就按 id 去 IndexedDB 要。
   安全:任何一步失败(不支持 / 被隐私模式禁掉 / 超时)→ 保持旧行为(内联在 localStorage),
        绝不出现「既不在 localStorage 也不在 IndexedDB」的窗口:
        先 await put 成功,才把 payload 从消息里剥掉。
--------------------------------------------------------------------------- */
var blobStore = {
  db: null, opening: null, ok: false, note: "", mem: {}
};
/* 版本 3:一次升级建齐工作区三区(workspaces / wsfiles / pyocache),不留第二次 bump。
   wsfiles 存 Blob(不转 base64);pyocache 是 pyodide 运行时缓存的唯一落点 */
var IDB_NAME = "chatgpt-webui-blobs", IDB_STORE = "blobs", IDB_CONVS = "convs",
    IDB_WS = "workspaces", IDB_WSF = "wsfiles", IDB_PYC = "pyocache", IDB_VER = 3;
/* 旧库迁移用:localStorage 里读到的旧版会话(迁移成功后丢弃) */
var pendingConvs = null;
/* 会话是否真的放在 IndexedDB 里(必须确认会话区可用;否则一律退回 localStorage) */
var convStoreReady = false;
/* 会话数据的权威副本是否真在 IndexedDB 里(纯诊断:只有在真正读/写过会话区之后才置真) */
var convsLiveInIdb = false;
/* 工作区三区是否齐备(DB v3 且 workspaces/wsfiles/pyocache 都在);不齐 → 工作区功能整体关闭 */
var wsStoreReady = false;
/* pyocache 区是否存在(pyodide 运行时缓存);全内嵌方案下为空区,仅影响缓存来源可用性 */
var pyCacheReady = false;
/* 存储升级是否被其它标签页阻塞(它们还攥着旧版本的连接,升级要等它们全关掉) */
var idbBlocked = false;
function convsInIdb() { return convStoreReady === true; }
function idbOpen(timeoutMs) {
  return new Promise(function (resolve, reject) {
    if (!window.indexedDB) { reject(new Error("浏览器不支持 IndexedDB")); return; }
    var done = false;
    idbBlocked = false;
    var to = setTimeout(function () {
      if (!done) {
        done = true;
        /* 被阻塞时也要给出真正的原因,否则用户只能看到「大仓库不可用」 */
        reject(new Error(idbBlocked
          ? "打开 IndexedDB 超时:存储升级被其它标签页阻塞,请关闭本应用的其它标签页后刷新"
          : "打开 IndexedDB 超时(可能是隐私模式)"));
      }
    }, timeoutMs || 4000);
    var req;
    try { req = indexedDB.open(IDB_NAME, IDB_VER); }
    catch (e) { clearTimeout(to); reject(e); return; }
    req.onupgradeneeded = function () {
      /* 老库(只有 blobs 区)在这里补齐 convs 区;v2→v3 再补工作区三区(只补建,不动既有两行) */
      var db = req.result;
      try {
        if (!db.objectStoreNames.contains(IDB_STORE)) db.createObjectStore(IDB_STORE);
        if (!db.objectStoreNames.contains(IDB_CONVS)) db.createObjectStore(IDB_CONVS);
        if (!db.objectStoreNames.contains(IDB_WS)) db.createObjectStore(IDB_WS);
        if (!db.objectStoreNames.contains(IDB_WSF)) {
          var stf = db.createObjectStore(IDB_WSF);
          /* 按工作区取文件的索引(删除级联、重算用量、快照桥都走它) */
          try { stf.createIndex("ws", "ws", { unique: false }); } catch (e) {}
        }
        if (!db.objectStoreNames.contains(IDB_PYC)) db.createObjectStore(IDB_PYC);
      } catch (e) {}
    };
    /* 升级撞上其它标签页(旧库连接没关)时浏览器会先回调这里:不提示的话用户只会看到 4s 后的超时 */
    req.onblocked = function () {
      idbBlocked = true;
      try { toast("请关闭本应用的其它标签页,以便升级本地存储", "warn", 6000); } catch (e) {}
    };
    req.onerror = function () {
      if (!done) { done = true; clearTimeout(to); reject(req.error || new Error("IndexedDB 打开失败")); }
    };
    req.onsuccess = function () {
      if (done) return;
      done = true; clearTimeout(to); resolve(req.result);
    };
  });
}
function blobDb() {
  if (blobStore.db) return Promise.resolve(blobStore.db);
  if (!blobStore.opening) {
    blobStore.opening = idbOpen(4000).then(function (db) {
      blobStore.db = db;
      blobStore.ok = true;
      blobStore.note = "";
      /* 会话区必须真的存在(旧库只有 blobs 区) —— 否则不能把会话从 localStorage 里搬走 */
      try {
        convStoreReady = !!(db.objectStoreNames && db.objectStoreNames.contains(IDB_CONVS));
        /* 工作区三区缺一个就整体关闭工作区功能(工具隐藏 + 报错),避免半可用的存储状态 */
        wsStoreReady = !!(db.objectStoreNames && db.objectStoreNames.contains(IDB_WS)
          && db.objectStoreNames.contains(IDB_WSF) && db.objectStoreNames.contains(IDB_PYC));
        pyCacheReady = !!(db.objectStoreNames && db.objectStoreNames.contains(IDB_PYC));
      } catch (e) { convStoreReady = false; wsStoreReady = false; pyCacheReady = false; }
      if (!convStoreReady) blobStore.note = "数据库里没有会话区(需要升级)";
      else if (!wsStoreReady) blobStore.note = "数据库里没有工作区存储区(需要升级)";
      db.onversionchange = function () { try { db.close(); } catch (e) {} blobStore.db = null; blobStore.opening = null; };
      return db;
    }, function (e) {
      blobStore.ok = false;
      blobStore.note = (e && e.message) || String(e);
      return null;
    });
  }
  return blobStore.opening;
}
function blobPut(id, mime, data) {
  if (!id || !data) return Promise.resolve(false);
  return blobDb().then(function (db) {
    if (!db) return false;
    return new Promise(function (resolve) {
      try {
        var tx = db.transaction(IDB_STORE, "readwrite");
        tx.objectStore(IDB_STORE).put({ mime: mime || "", data: data, len: data.length, at: Date.now() }, id);
        tx.oncomplete = function () {
          /* 写盘成功同时填内存缓存:发送流程是「先外置、再组装请求」,
             而 protocolContent 取 payload 走的是同步读(blobMemo)——
             不在这里补一份,同一轮发送就会退化成「图片数据不在本机」的占位文案 */
          blobStore.mem[id] = { mime: mime || "", data: data, len: data.length, at: Date.now() };
          resolve(true);
        };
        tx.onerror = function () { resolve(false); };
        tx.onabort = function () { resolve(false); };
      } catch (e) { resolve(false); }
    });
  });
}
function blobGet(id) {
  if (!id) return Promise.resolve(null);
  if (blobStore.mem[id]) return Promise.resolve(blobStore.mem[id]);
  return blobDb().then(function (db) {
    if (!db) return null;
    return new Promise(function (resolve) {
      try {
        var tx = db.transaction(IDB_STORE, "readonly");
        var rq = tx.objectStore(IDB_STORE).get(id);
        rq.onsuccess = function () {
          var v = rq.result || null;
          if (v && v.data) blobStore.mem[id] = v;
          resolve(v);
        };
        rq.onerror = function () { resolve(null); };
      } catch (e) { resolve(null); }
    });
  });
}
function blobDel(ids) {
  if (!ids || !ids.length) return Promise.resolve(0);
  return blobDb().then(function (db) {
    if (!db) return 0;
    return new Promise(function (resolve) {
      try {
        var tx = db.transaction(IDB_STORE, "readwrite");
        var st = tx.objectStore(IDB_STORE);
        ids.forEach(function (id) {
          delete blobStore.mem[id];
          try { st.delete(id); } catch (e) {}
        });
        tx.oncomplete = function () { resolve(ids.length); };
        tx.onerror = function () { resolve(0); };
      } catch (e) { resolve(0); }
    });
  });
}
/* ---- 会话本体:一条会话一个记录 ---- */
/* 写清单里**不带**被墓碑判死的那些 id:哪怕它们还留在内存里(对侧刚删、本页还没收到事件),
   也绝不写回权威库 —— 这是"删除被复活"的最后一道闸 */
function convsWritable(list) {
  return (list || []).filter(function (c) { return c && c.id && !convGoneActive(c.id); });
}
function convsPutAll(list) {
  var write = convsWritable(list || state.conversations);
  return blobDb().then(function (db) {
    if (!db) return false;
    return new Promise(function (resolve) {
      try {
        var tx = db.transaction(IDB_CONVS, "readwrite");
        var st = tx.objectStore(IDB_CONVS);
        write.forEach(function (c) { st.put(c, c.id); });
        tx.oncomplete = function () {
          convFlush.lastOK = Date.now(); convsLiveInIdb = true;
          /* 落库成功 ⇒ 这些会话的权威副本就是我们刚写下去的这一份;内存副本对应的版本号一起对齐
             (mergeConvsByIdb 靠前者判断"有没有还没落库的改动") */
          markConvsSeen(write);
          convRevState.sync = convRevState.rev;
          /* 本轮的会话改动现在真的进 IDB 了 → 再推一次版本号:接收方等的合并窗口里
             事务若没提交完,它会读到事务前的旧列表,而这个方向不会再产生 storage 事件 */
          if (convRevState.pending) { convRevState.pending = false; broadcastConvsChange(); }
          resolve(true);
        };
        tx.onerror = function () { resolve(false); };
        tx.onabort = function () { resolve(false); };
      } catch (e) { resolve(false); }
    });
  });
}
function convsGetAll() {
  return blobDb().then(function (db) {
    if (!db) return [];
    return new Promise(function (resolve) {
      try {
        var tx = db.transaction(IDB_CONVS, "readonly");
        var rq = tx.objectStore(IDB_CONVS).getAll();
        rq.onsuccess = function () { convsLiveInIdb = true; resolve(Array.isArray(rq.result) ? rq.result : []); };
        rq.onerror = function () { resolve([]); };
      } catch (e) { resolve([]); }
    });
  });
}
function convsDel(ids) {
  if (!ids || !ids.length) return Promise.resolve(0);
  return blobDb().then(function (db) {
    if (!db) return 0;
    return new Promise(function (resolve) {
      try {
        var tx = db.transaction(IDB_CONVS, "readwrite");
        var st = tx.objectStore(IDB_CONVS);
        ids.forEach(function (id) { try { st.delete(id); } catch (e) {} });
        tx.oncomplete = function () {
          /* 删除是"整库替换"方向:对侧删掉的会话必须在它读 IDB 之前真的提交完,
             否则它会读到旧列表、而且之后不会再收到事件(这个方向不写 localStorage)。
             所以事务落地后补推一次版本号,逼它再读一次(见 broadcastConvsChange);
             补推的记录里带上**删除墓碑**,对侧据此才不会把"本页未落库的副本"当成优先项 */
          ids.forEach(function (id) { delete convSeenSigs[id]; });
          markConvsGone(ids);
          broadcastConvsChange();
          resolve(ids.length);
        };
        tx.onerror = function () { resolve(0); };
      } catch (e) { resolve(0); }
    });
  });
}

/* ---------------------------------------------------------------------------
   会话指纹与跨标签页收敛(配合文件上方的 convRevState)
--------------------------------------------------------------------------- */
/* 一条会话的轻量指纹:覆盖当前所有"会话内容改动"会动到的字段
   (标题 / 置顶 / 消息条数与更新时间 / 挂载 / 单会话系统提示文本长度 / 外部工具会话级覆盖)。
   漏掉一个字段的后果是双份的:本页 saveState 不会推进 convsRev(对侧收不到改动),
   而 mergeConvsByIdb 又会把"本页刚改过的那条"当成已落库的权威副本 */
function convFingerprint(c) {
  if (!c) return "";
  return (c.id || "") + "," + (c.updatedAt || 0) + "," + (c.pinned ? 1 : 0) + "," +
    (c.messages ? c.messages.length : 0) + "," + (c.title || "") + "," + (c.wsId || "") + "," +
    ((c.system || "").length) + "," +
    (c.extToolsEnabled === true ? "E1" : (c.extToolsEnabled === false ? "E0" : "E-"));
}
function convsFingerprint(list) {
  var out = String((list || []).length), i;
  for (i = 0; i < (list || []).length; i++) out += "|" + convFingerprint(list[i]);
  return out;
}
/* ---- 删除墓碑(记录里的删除意图) ---- */
/* 墓碑 / 撤回台账都只留 CONV_GONE_MS 以内、且各自不超过 CONV_GONE_MAX 条;过期即删。
   撤回台账一样要封顶(历史教训:原先只有墓碑封顶,10 分钟内两次规模导入就能让台账
   涨到 2200 条 / 记录 91KB,与这里的口径不符)。裁掉最旧的撤回条目不会造成"该撤回丢失 ⇒
   已删会话复活"的反向问题:记下撤回时(mergeConvsRestored)就把不比它新的墓碑一并删了,
   所以"撤回与墓碑同时存在"时墓碑必然更新 —— 那条撤回本来就已经失效,丢掉它不改变任何一条的
   判死结果。残余边界与墓碑同源(见 CONV_GONE_MAX 的说明):同一窗口内 id 各不相同、又合计超过
   CONV_GONE_MAX 条的删除 / 导入,现实不可达 */
function pruneConvsGone() {
  var now = Date.now(), keep = [], rkeep = [], i, id;
  for (id in convGoneMap) {
    if (!Object.prototype.hasOwnProperty.call(convGoneMap, id)) continue;
    if (typeof convGoneMap[id] !== "number" || !isFinite(convGoneMap[id]) ||
        now - convGoneMap[id] > CONV_GONE_MS) { delete convGoneMap[id]; continue; }
    keep.push(id);
  }
  for (id in convRestoredMap) {
    if (!Object.prototype.hasOwnProperty.call(convRestoredMap, id)) continue;
    if (typeof convRestoredMap[id] !== "number" || !isFinite(convRestoredMap[id]) ||
        now - convRestoredMap[id] > CONV_GONE_MS) { delete convRestoredMap[id]; continue; }
    rkeep.push(id);
  }
  if (keep.length > CONV_GONE_MAX) {                 /* 超出上限:丢最旧的那几条 */
    keep.sort(function (a, b) { return convGoneMap[a] - convGoneMap[b]; });
    for (i = 0; i < keep.length - CONV_GONE_MAX; i++) delete convGoneMap[keep[i]];
  }
  if (rkeep.length > CONV_GONE_MAX) {
    rkeep.sort(function (a, b) { return convRestoredMap[a] - convRestoredMap[b]; });
    for (i = 0; i < rkeep.length - CONV_GONE_MAX; i++) delete convRestoredMap[rkeep[i]];
  }
}
/* 记下删除意图(本页删掉的、或从对侧记录里读到的);重复记只取更新的时间戳。
   撤回与删除同毫秒时按"撤回优先"(两个动作要求用户在同一个毫秒里点两下,现实里不可能;
   而漏掉撤回就是静默丢数据)—— 见 convGoneActive) */
function markConvsGone(ids, at) {
  var t = (typeof at === "number" && isFinite(at)) ? at : Date.now(), n = 0;
  (ids || []).forEach(function (id) {
    if (!id || n >= CONV_GONE_MAX) return;
    n++;
    if (convRestoredMap[id] >= t) return;      /* 用户明确要回来过 ⇒ 这次删除意图不生效 */
    if (!convGoneMap[id] || convGoneMap[id] < t) convGoneMap[id] = t;
  });
  if (n) pruneConvsGone();
  return n;
}
/* 对侧记录里的墓碑并进本页(取并集:谁的删除意图都不能被另一方忘记) */
function mergeConvsGone(raw) {
  if (!raw || typeof raw !== "object") return;
  var n = 0;
  for (var id in raw) {
    if (!Object.prototype.hasOwnProperty.call(raw, id)) continue;
    if (++n > CONV_GONE_MAX) break;             /* 记录被人手改过:不让它拖死保存链 */
    var t = raw[id];
    if (typeof t !== "number" || !isFinite(t)) continue;
    /* 这条已被"明确要回来"过(且不比这次删除旧)⇒ 墓碑不再生效。它可能来自本页撤回之前
       那份记录,也可能来自还没来得及收到撤回意图的对侧 —— 两种都不该把用户导入回来的
       会话重新判死(否则静默丢数据只是换了个入口) */
    if (convRestoredMap[id] >= t) continue;
    if (!convGoneMap[id] || convGoneMap[id] < t) convGoneMap[id] = t;
  }
  if (n) pruneConvsGone();
}
/* 对侧记录里的撤回意图并进本页:它比本页手里的墓碑新 ⇒ 墓碑作废(否则本页收敛时会把
   用户刚导入回来的会话当成"已删除的幽灵副本"从 IDB 里删掉) */
