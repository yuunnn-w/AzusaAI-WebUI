var convRecCache = { raw: null, rec: null };
function readConvsRec() {
  var empty = { rev: 0, gone: null, restored: null, wiped: 0 };
  if (storageBroken) return empty;
  var raw = null;
  try { raw = localStorage.getItem(LS_KEY); } catch (e) { return empty; }
  if (!raw) return empty;
  if (convRecCache.raw === raw && convRecCache.rec) return convRecCache.rec;
  var out = { rev: 0, gone: null, restored: null, wiped: 0 };
  try {
    var rec = JSON.parse(raw);
