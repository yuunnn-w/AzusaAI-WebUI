/* 把内存里的会话刷进 IndexedDB:同一时刻只跑一次,期间再有请求就排队重跑 */
var convFlush = { busy: false, again: false, lastOK: 0, fails: 0 };
function flushConvs() {
  if (!convsInIdb()) return Promise.resolve(false);
  if (!state.conversations.length) return Promise.resolve(true);
  if (convFlush.busy) { convFlush.again = true; return Promise.resolve(false); }
  convFlush.busy = true;
  /* 写前加固:本次保存前读到的落盘版本比内存副本对应的快照新 ⇒ 对侧刚动过会话集合
     (多是删除),而我们手里这份列表还是基于旧快照的 —— 直接整表回写会把对侧已删的会话
     写回去(复活)。先按"墓碑优先 + IDB 权威 + 本页未落库改动优先"合并一次,再写;
     即便这次没合并(版本号没前进),convsPutAll 也会把墓碑里的 id 从写清单里剔掉。 */
  var pre = (convRevState.peer > convRevState.sync) ? pullConvsFromIdb() : Promise.resolve(false);
  return pre.then(function () { return convsPutAll(); }).then(function (ok) {
