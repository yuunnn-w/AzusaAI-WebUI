  if (!raw || typeof raw !== "object") return;
  var n = 0;
  for (var id in raw) {
    if (!Object.prototype.hasOwnProperty.call(raw, id)) continue;
    if (++n > CONV_GONE_MAX) break;             /* 记录被人手改过:不让它拖死保存链 */
    var t = raw[id];
    if (typeof t !== "number" || !isFinite(t)) continue;
    if (!convRestoredMap[id] || convRestoredMap[id] < t) convRestoredMap[id] = t;
    if (typeof convGoneMap[id] === "number" && convGoneMap[id] <= convRestoredMap[id]) delete convGoneMap[id];
