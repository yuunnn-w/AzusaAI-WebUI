  return { keys: keys, tokens: tokens };
}
/* 同步读:只有已经缓存在内存里的才拿得到(发送/渲染前会先 hydrate) */
function blobMemo(id) {
  return (id && blobStore.mem[id]) ? blobStore.mem[id] : null;
}
/* 统计 IndexedDB 里我们自己的占用(打开数据面板时用一次) */
function blobStats() {
  return blobDb().then(function (db) {
    if (!db) return { count: 0, chars: 0, ok: false };
    return new Promise(function (resolve) {
      var count = 0, chars = 0;
      try {
        var tx = db.transaction(IDB_STORE, "readonly");
        var rq = tx.objectStore(IDB_STORE).openCursor();
        rq.onsuccess = function () {
          var cur = rq.result;
          if (!cur) { resolve({ count: count, chars: chars, ok: true }); return; }
          count++;
          chars += (cur.value && cur.value.len) || 0;
          cur.continue();
