}
/* 落盘记录里的版本号(读不到 / 解析失败一律按 0 —— 绝不因此打断保存) */
function readConvsRev() { return readConvsRec().rev; }
function convListFind(list, id) {
  for (var i = 0; i < list.length; i++) if (list[i] && list[i].id === id) return list[i];
  return null;
}
/* 记下"这些会话的权威副本长什么样"(成功写库之后 / 从 IDB 读回来之后都走它) */
function markConvsSeen(list) {
