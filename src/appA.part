      } catch (e) { resolve({ count: 0, chars: 0, ok: false }); }
    });
  });
}
/* 把某条消息里所有「已外置」的附件读进内存缓存,返回 Promise(用于渲染/发送/导出前的准备) */
function hydrateAttachments(list) {
  var need = [], seen = {};
  (list || []).forEach(function (m) {
    if (!m || !Array.isArray(m.content)) return;
    m.content.forEach(function (p) {
      var a = p && p.attach;
      if (!a || !a.id) return;
      /* 键位只有一种在用的:a.blob —— attachMetaOf 在 payload 外置成功时写它
         (图片 / 文本附件写 a.id,office / PDF 的每页图像写 -pN 键)。
         图像部件必须走 a.blob:office / PDF 在气泡里只出卡片,渲染不会碰 IndexedDB,
         不在这里读回来,发送时就会退化成「图片数据不在本机」的占位文案。
         (历史上这里还兜底过「文本 payload 外置」的 stub / external 两个字段,
         全库从来没有写入点,属于不可达死条件,已删除) */
      var key = a.blob || "";
      if (!key) return;
      if (blobStore.mem[key] || seen[key]) return;
      seen[key] = 1;
      need.push(key);
    });
  });
  if (!need.length) return Promise.resolve(0);
  return Promise.all(need.map(function (id) { return blobGet(id); })).then(function (arr) {
    var got = 0;
    arr.forEach(function (v) { if (v && v.data) got++; });
    return got;
  });
}
/* 启动时预热:把当前会话的附件读进内存(失败也不影响其它功能) */
function warmBlobs() {
  var m = (typeof conv !== "undefined" && conv) ? conv.messages : [];
  return hydrateAttachments(m).then(function (n) { return n; }, function () { return 0; });
}

/* localStorage 里保存的那一小份:设置 + 轻量状态(会话在 IndexedDB 里,
   只有附件库完全不可用时才退回把会话也写在这里) */
function stateRecord() {
  /* 会话版本:写之前先接住落盘里别人的进度,再看"会话指纹变没变"决定要不要 bump
     (见文件上方 convsRev 的说明 —— 这一步是"会话内容变更也能触发 storage 事件"的唯一来源)。
     版本号 / 墓碑 / 整库替换时间戳都取自同一次记录解析(只读、只 parse 一次) */
  var rec0 = readConvsRec();
  var peer = rec0.rev;
  if (peer > convRevState.rev) convRevState.rev = peer;
  convRevState.peer = peer;
  /* 对侧的撤回 / 删除墓碑要并进来:本页这次的记录写就是把它继续传下去的机会。
     撤回先并:同一条 id 上"撤回比墓碑新"时墓碑作废(顺序无关,撤回会顺手清掉本地墓碑) */
  mergeConvsRestored(rec0.restored);
  mergeConvsGone(rec0.gone);
  var sig = convsFingerprint(state.conversations);
  if (convRevState.sig === null) {
    /* 本页第一次写记录:只对齐指纹,不算"会话变了"。启动时这份列表是从 IDB 采纳来的,
       对侧早就知道,再 bump 一次就是白让对侧重读一遍全库 */
    convRevState.sig = sig;
  } else if (sig !== convRevState.sig) {
    convRevState.sig = sig;
    convRevState.rev++;
    convRevState.pending = true;
  }
  var rec = {
    schema: SCHEMA,
    convsRev: convRevState.rev,
    settings: state.settings,
    activeId: state.activeId,
    promptLib: state.promptLib,
    fetchedModels: state.fetchedModels,
    /* 诊断字段:报的是「会话的权威副本真的在 IDB 里」,不是「本次会话当前能不能用 IDB」——
       后者在存储升级被阻塞时会假阴性(数据其实还在 IDB 里) */
    convsInIdb: convsLiveInIdb
  };
  pruneConvsGone();
  var gone = [], nRestored = 0, id;
  for (id in convGoneMap) {
    if (Object.prototype.hasOwnProperty.call(convGoneMap, id)) gone.push(id);
  }
  for (id in convRestoredMap) {
    if (Object.prototype.hasOwnProperty.call(convRestoredMap, id)) nRestored++;
  }
  /* 墓碑跟着记录走:对侧据此才知道"这条是被显式删掉的",而不是"还没写进去" */
  if (gone.length) rec.convsGone = convGoneMap;
  /* 撤回也一起走:对侧据此才知道"这条是用户明确要回来的",而不是"墓碑还没到" ——
     少了这一步,对侧手里那份墓碑会在它收敛时把刚导入的会话从 IDB 里删掉(同类静默丢数据的对侧版本) */
  if (nRestored) rec.convsRestored = convRestoredMap;
  if (convRevState.wiped) rec.convsWiped = convRevState.wiped;
  if (!convsInIdb()) rec.conversations = state.conversations;
  return rec;
}
/* 启动成功后把落盘记录里的 convsInIdb 诊断字段对齐成真值。
   只在「存储可用 ∧ 记录里写的还是假」时改写这一个字段:不调 flushConvs、不重写会话正文,
   所以不会变成「每次启动多刷一次全库」(那才是把诊断偏差换成常态写放大)。 */
function alignConvsMarker() {
  if (storageBroken || !convsInIdb() || !convsLiveInIdb) return false;
  try {
    var raw = localStorage.getItem(LS_KEY);
    if (!raw) return false;
    var rec = JSON.parse(raw);
    if (!rec || typeof rec !== "object" || rec.convsInIdb === true) return false;
    rec.convsInIdb = true;
    localStorage.setItem(LS_KEY, JSON.stringify(rec));
    return true;
  } catch (e) { return false; }
}
function saveState(quiet) {
  if (storageBroken) return false;
  try {
    localStorage.setItem(LS_KEY, JSON.stringify(stateRecord()));
    storageRetried = false;
    flushConvs();
    return true;
  } catch (e) {
    var full = e && (e.name === "QuotaExceededError" || e.code === 22 || e.code === 1014);
    /* 空间满了:先把内联附件搬进附件库再试一次(自动、无损) */
    if (full && !storageRetried) {
      storageRetried = true;
      migrateAttachmentsToIdb().then(function (r) {
        var again = saveState(true);
        if (typeof updateStorageMeter === "function") updateStorageMeter();
        if (again) return;
        if (typeof openSpaceDialog === "function") openSpaceDialog("full");
      });
      return false;
    }
    if (!quiet) {
      toast("本地存储写入失败:" + (full ? "空间已满,已弹出「清理空间」。" : ((e && e.message) || e)), "error", 5200);
    }
    if (full && typeof openSpaceDialog === "function") openSpaceDialog("full");
    return false;
  }
}
var storageRetried = false;
var saveSoon = (function () {
  var t = null;
  return function () {
    if (t) clearTimeout(t);
    t = setTimeout(function () { t = null; saveState(true); updateStorageMeter(); }, 700);
  };
})();

/* ---------------------------------------------------------------------------
   3. DOM 与通用工具
--------------------------------------------------------------------------- */
function $(id) { return document.getElementById(id); }
function $$(sel, root) {
  return Array.prototype.slice.call((root || document).querySelectorAll(sel));
}
function icon(name, cls) {
  var c = "icon" + (cls ? " " + cls : "");
  return '<svg class="' + c + '"><use href="#i-' + name + '" xlink:href="#i-' + name + '"/></svg>';
}
function escapeHtml(s) {
  return String(s == null ? "" : s)
    .replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;")
    .replace(/"/g, "&quot;").replace(/'/g, "&#39;");
}
function escAttr(s) { return escapeHtml(s); }
function cssEscape(v) {
  v = String(v);
  if (CAP.cssEscape) return CSS.escape(v);
  return v.replace(/[^a-zA-Z0-9_\u00a0-\uffff-]/g, function (c) { return "\\" + c; });
}
function uid() {
  return Date.now().toString(36) + Math.random().toString(36).slice(2, 8);
}
function clamp(v, lo, hi) { return v < lo ? lo : (v > hi ? hi : v); }
function clampNum(v, lo, hi, dflt) {
  v = Number(v);
  if (!isFinite(v)) return dflt;
  return Math.round(clamp(v, lo, hi));
}
function fmtTime(ts) { return new Date(ts).toLocaleTimeString("zh-CN", { hour: "2-digit", minute: "2-digit" }); }
function fmtDateTime(ts) {
  var d = new Date(ts);
  return d.getFullYear() + "-" + p2(d.getMonth() + 1) + "-" + p2(d.getDate()) + " " + p2(d.getHours()) + ":" + p2(d.getMinutes());
}
function p2(n) { return (n < 10 ? "0" : "") + n; }
function fmtBytes(n) {
  if (n == null) return "—";
  if (n < 1024) return n + " B";
  if (n < 1048576) return (n / 1024).toFixed(1) + " KB";
  return (n / 1048576).toFixed(2) + " MB";
}
/* 当前所有会话里的消息总数(面板与清理弹窗都用) */
function totalMsgs() {
  var n = 0;
  state.conversations.forEach(function (c) { n += (c.messages || []).length; });
  return n;
}
function num(n) {
  if (n == null || isNaN(n)) return "—";
  return n >= 1000 ? String(Math.round(n)).replace(/\B(?=(\d{3})+(?!\d))/g, ",") : String(n);
}
/* token 数缩写(1K = 1024,保留一位小数):16.4K / 256.0K / 1.2M */
function fmtCtxNum(v) {
  v = Number(v) || 0;
  if (v < 1024) return String(Math.round(v));
  if (v < 1048576) return (v / 1024).toFixed(1) + "K";
  return (v / 1048576).toFixed(2) + "M";
}
/* 参数滑块用的写法:0 表示「不发送」 */
function fmtTok(v) {
  v = Number(v) || 0;
  return v <= 0 ? "自动" : fmtCtxNum(v);
}
function timeAgo(ts) {
  var d = Date.now() - ts;
  if (d < 60e3) return "刚刚";
  if (d < 3600e3) return Math.floor(d / 60e3) + " 分钟前";
  if (d < 86400e3) return Math.floor(d / 3600e3) + " 小时前";
  if (d < 7 * 86400e3) return Math.floor(d / 86400e3) + " 天前";
  return new Date(ts).toLocaleDateString("zh-CN");
}
/* 字符 → token 的四分类经验系数:用真实模型跑 12 组内容
   (英文散文 ×3 / 中文散文 / 代码 ×3 / JSON / 列表 ×2 / 中英混合 / ASCII 图),
   拿服务端返回的 completion_tokens 做最小二乘拟合。
   分桶很关键:CJK 与拉丁、数字差了一个数量级,合并成「其它」会互相抵消 ——
   实测平均绝对误差 四桶 7.9% / 三桶 17.7% / 朴素系数(1 与 1/3.6) 16.0%。
   注意数字:Qwen 这类分词器几乎把每个数字当独立 token,系数接近 1。 */
var TOK_PER_CJK = 0.804;    // 汉字与全角字符
var TOK_PER_LATIN = 0.170;  // 拉丁字母(A-Z a-z):英文散文约 6 字/token
var TOK_PER_DIGIT = 1.041;  // 数字:几乎一字一 token
var TOK_PER_SYM = 0.319;    // 标点 / 空白 / 其它符号
/* 把文本拆成四类字符计数;流式期间按字符累计再折算,
   比每个小碎片各自取整加起来准得多 */
function countScript(text) {
  var cjk = 0, latin = 0, digit = 0, sym = 0;
  for (var i = 0; i < text.length; i++) {
    var c = text.charCodeAt(i);
    if ((c >= 0x3000 && c <= 0x9fff) || c >= 0xff00) cjk++;
    else if ((c >= 65 && c <= 90) || (c >= 97 && c <= 122)) latin++;
    else if (c >= 48 && c <= 57) digit++;
    else sym++;
  }
  return [cjk, latin, digit, sym];
}
/* 按模型取校准系数:上一次同样的模型生成完,用真实 token 数反推出来的倍数 */
function tokCalibFor(model) {
  var t = state.settings.tokCalib;
  var k = (t && model) ? t[model] : null;
  return (typeof k === "number" && k > 0.3 && k < 3) ? k : 1;
}
function estimateTokens(text, calib) {
  if (!text) return 0;
  var cs = countScript(String(text));
  return Math.ceil((cs[0] * TOK_PER_CJK + cs[1] * TOK_PER_LATIN +
                    cs[2] * TOK_PER_DIGIT + cs[3] * TOK_PER_SYM) * (calib || 1));
}
function contentToText(content) {
  if (typeof content === "string") return content;
  if (Array.isArray(content)) {
    return content.map(function (c) {
      if (!c) return "";
      if (c.type === "text") return c.text || "";
      if (c.type === "image_url" || c.type === "image") return "[图像]";
      return "";
    }).filter(Boolean).join("\n");
  }
  return String(content == null ? "" : content);
}
/* 复制/朗读用:附件以「[附件:名字]」占位,不要把整个文件内容也当成正文复制出去 */
function contentToDisplay(content) {
  if (typeof content === "string") return content;
  if (!Array.isArray(content)) return String(content == null ? "" : content);
  var out = [];
  for (var i = 0; i < content.length; i++) {
    var c = content[i];
    if (!c) continue;
    var a = c.attach;
    if (c.type === "image_url" || c.type === "image") {
      out.push("[图片" + (a && a.name ? ":" + a.name : "") + "]");
    } else if (c.type === "text" && a && a.kind) {
      out.push("[附件:" + (a.name || "") + "]" + (a.ocrOnly && a.ocrText ? "\n" + a.ocrText : ""));
    } else if (c.type === "text") {
      out.push(c.text || "");
    }
  }
  return out.join("\n");
}
/* 上下文估算:一张图按 ~900 token 粗算(比 "[图像]" 三个字准得多);
   工具消息上的内联媒体不走这里 —— 见 estimateToolMediaTokens(实测拟合口径) */
function estimateContentTokens(content) {
  if (!Array.isArray(content)) return estimateTokens(contentToText(content)) + 4;
  var n = 4;
  for (var i = 0; i < content.length; i++) {
    var c = content[i];
    if (!c) continue;
    if (c.type === "image_url" || c.type === "image") n += 900;
    else if (c.type === "text") n += estimateTokens(c.text || "");
  }
  return n;
}
/* 工具消息上的媒体(token 估算;实测拟合 tokens ≈ max(1026, round(W×H/1024)),见方案 §2):
   **调用点清单(跨批契约 §3.12-2)**:① payloadMessages 的 token 循环;② b25 的 cxPayloadMsgTokens
   (其三处消费自动继承)。新增任何「对消息序列做 token 估算」的代码路径都必须经这两处之一。 */
function estimateToolMediaTokens(m) {
  var arr = (m && Array.isArray(m.media)) ? m.media : null;
  if (!arr || !arr.length) return 0;
  var n = 0;
  for (var i = 0; i < arr.length; i++) {
    var im = arr[i] || {};
    var w = Number(im.w) || 0, h = Number(im.h) || 0;
    n += Math.max(1026, Math.round(w * h / 1024));
  }
  return n;
}
/* 把「气泡里要显示的东西」翻译成协议里真正要发的东西:
   - 剥掉展示元数据(attach),否则严格实现会因为未知字段报 400
   - OCR-only 的图片部件换成 OCR 文本(模型看不到图,只能看文字)
   - 按目标协议统一图片部件形状(历史消息可能是另一种协议写的) */
function protocolContent(content, proto) {
  if (!Array.isArray(content)) return content;
  var out = [];
  for (var i = 0; i < content.length; i++) {
    var c = content[i];
    if (!c) continue;
    var a = c.attach || null;
    if (a && a.ocrOnly) {
      out.push({
        type: "text",
        text: "【图片 " + (a.name || "") + " 的文字(OCR 识别)】\n" + (String(a.ocrText || "").trim() || "(未识别出文字)")
      });
      continue;
    }
    if (c.type === "image_url" || c.type === "image") {
      var mime = c.type === "image_url"
        ? (String((c.image_url && c.image_url.url) || "").match(/^data:([^;,]+)/) || [])[1] || "image/png"
        : (c.source && c.source.media_type) || "image/png";
      var data = c.type === "image_url"
        ? String((c.image_url && c.image_url.url) || "").replace(/^data:[^,]*,/, "")
        : (c.source && c.source.data) || "";
      /* payload 外置在 IndexedDB 里:从内存缓存取回来(发送前会 hydrate 一次) */
      if (!data && a && a.blob) {
        var rec = blobMemo(a.blob);
        if (rec && rec.data) {
          data = rec.data;
          mime = rec.mime || mime;
        }
      }
      if (!data) {
        out.push({
          type: "text",
          text: "【附件 " + ((a && a.name) || "") + " 的图片数据不在本机(可能被清理过),仅保留这条记录】"
        });
        continue;
      }
      if (proto === "anthropic") out.push({ type: "image", source: { type: "base64", media_type: mime, data: data } });
      else out.push({ type: "image_url", image_url: { url: "data:" + mime + ";base64," + data } });
      continue;
    }
    if (c.type === "text") { out.push({ type: "text", text: c.text || "" }); continue; }
    out.push(c);
  }
  return out;
}
function copyText(text, okMsg) {
  function fallback() {
    try {
      var ta = document.createElement("textarea");
      ta.value = text;
      ta.setAttribute("readonly", "");
      ta.style.cssText = "position:fixed;left:-9999px;top:0;opacity:0";
      document.body.appendChild(ta);
      ta.select();
      ta.setSelectionRange(0, ta.value.length);
      var ok = document.execCommand("copy");
      document.body.removeChild(ta);
      if (ok) toast(okMsg || "已复制", "success");
      else toast("复制失败:当前浏览器不允许自动复制,请手动选择文本", "error");
    } catch (e) { toast("复制失败:" + (e.message || e), "error"); }
  }
  if (CAP.clipboard) {
    navigator.clipboard.writeText(text).then(function () { toast(okMsg || "已复制", "success"); }, fallback);
  } else fallback();
}
function download(filename, content, mime) {
  try {
    var blob = new Blob([content], { type: mime || "text/plain;charset=utf-8" });
    if (!CAP.objectUrl) {
      var dataUrl = "data:" + (mime || "text/plain") + ";charset=utf-8," + encodeURIComponent(content);
      var a0 = document.createElement("a");
      a0.href = dataUrl; a0.download = filename; a0.click();
      return true;
    }
    var url = URL.createObjectURL(blob);
    var a = document.createElement("a");
    a.href = url; a.download = filename;
    document.body.appendChild(a); a.click(); document.body.removeChild(a);
    setTimeout(function () { URL.revokeObjectURL(url); }, 4000);
    return true;
  } catch (e) {
    toast("导出失败:" + (e.message || e), "error");
    return false;
  }
}
function focusTrap(mask) {
  mask.addEventListener("keydown", function (e) {
    if (e.key !== "Tab") return;
    var f = $$('a[href],button:not([disabled]),input:not([disabled]),select,textarea,[tabindex]:not([tabindex="-1"])', mask)
      .filter(function (el) { return el.offsetParent !== null || el === document.activeElement; });
    if (!f.length) return;
    var first = f[0], last = f[f.length - 1];
    if (e.shiftKey && document.activeElement === first) { e.preventDefault(); last.focus(); }
    else if (!e.shiftKey && document.activeElement === last) { e.preventDefault(); first.focus(); }
  });
}

/* ---------------------------------------------------------------------------
   4. Toast
--------------------------------------------------------------------------- */
var toastBox = $("toasts");
function toast(msg, type, ms) {
  var el = document.createElement("div");
  var ico = type === "success" ? "check" : type === "error" ? "warn" : type === "warn" ? "warn" : "info";
  el.className = "toast " + (type || "info");
  el.innerHTML = icon(ico, "sm") + "<span>" + escapeHtml(msg) + "</span>";
  toastBox.appendChild(el);
  while (toastBox.children.length > 5) toastBox.removeChild(toastBox.firstChild);
  setTimeout(function () { el.className += " out"; }, ms || 2600);
  setTimeout(function () { if (el.parentNode) el.parentNode.removeChild(el); }, (ms || 2600) + 400);
}

/* ---------------------------------------------------------------------------
   5. 主题 / 外观
--------------------------------------------------------------------------- */
function resolveTheme() {
  var t = state.settings.theme;
  if (t === "system" && CAP.matchMedia) {
    return window.matchMedia("(prefers-color-scheme: light)").matches ? "light" : "dark";
  }
  return t === "system" ? "dark" : t;
}
function applyAppearance() {
  var s = state.settings;
  var root = document.documentElement;
  var theme = resolveTheme();
  root.setAttribute("data-theme", theme);
  root.setAttribute("data-accent", s.accent);
  root.setAttribute("data-fx", s.fx ? "on" : "off");
  root.setAttribute("data-density", s.compact ? "compact" : "normal");
  root.style.setProperty("--fs", s.fontSize + "px");
  var sysMode = s.theme === "system";
  var dark = theme === "dark";
  var themeIcon = sysMode ? "monitor" : (dark ? "moon" : "sun");
  var themeText = sysMode ? "跟随系统" : (dark ? "深色" : "浅色");
  $$("#theme-icon use, #btn-theme-top use").forEach(function (u) {
    setUse(u, themeIcon);
  });
  $("theme-label").textContent = themeText;
  var tBtn = $("btn-theme"), tBtnTop = $("btn-theme-top");
  if (tBtn) tBtn.title = "主题:" + themeText + "(点击切换)";
  if (tBtnTop) tBtnTop.title = "主题:" + themeText + "(点击切换)";
  applyCodeWrap();
  $$("#theme-switch button").forEach(function (b) {
    b.classList.toggle("active", b.dataset.theme === s.theme);
  });
  $$("#accent-switch .swatch").forEach(function (b) {
    b.classList.toggle("active", b.dataset.accent === s.accent);
  });
  applyFavicon();
  /* 密度令牌影响左右栏宽度与对话区下限 ⇒ 切换紧凑模式后立即重判形态与让位 */
  if (typeof wsRailRefit === "function") wsRailRefit();
}
/* 默认标签页图标句柄:appA 脚本求值时 <link rel="icon"> 已在 head 解析完毕,此处捕获其原始
   href —— 不把 14KB 的 SVG 再内嵌一份,自定义图标只替换 href,默认值永远取自 head 原文 */
var DEFAULT_FAVICON = (function () {
  var l = document.querySelector('link[rel~="icon"]');
  return l ? (l.getAttribute("href") || "") : "";
})();
/* 应用当前标签页图标:同步「移除全部 + 追加一个」(同一 JS 任务内完成,不出现"零 link"中间态);
   挂在 applyAppearance() 末尾 → 启动 / 主题切换 / 保存 / 导入 / 清空五条路径自动覆盖 */
function applyFavicon() {
  var custom = state.settings.customIcon || "";
  var href = custom || DEFAULT_FAVICON;
  var links = document.querySelectorAll('link[rel~="icon"]');
  if (!href) {
    for (var i = 0; i < links.length; i++) links[i].parentNode.removeChild(links[i]);
    return;
  }
  if (links.length === 1 && links[0].getAttribute("href") === href) return;   // 幂等:已是目标图标则不动
  for (var j = 0; j < links.length; j++) links[j].parentNode.removeChild(links[j]);
  var link = document.createElement("link");
  link.setAttribute("rel", "icon");
  /* type 要跟 href 的实际格式一致:自定义图标允许 PNG / JPEG(手改备份可能带 JPEG),不能恒报 png */
  link.setAttribute("type", custom ? (/^data:image\/jpeg/i.test(custom) ? "image/jpeg" : "image/png") : "image/svg+xml");
  link.setAttribute("href", href);
  document.head.appendChild(link);
}
function setUse(useEl, name) {
  var h = "#i-" + name, x = "#i-" + name;
  useEl.setAttribute("href", h);
  useEl.setAttributeNS("http://www.w3.org/1999/xlink", "xlink:href", x);
}
function applyCodeWrap() {
  var wrap = !!state.settings.codeWrap;
  $$("#chat pre").forEach(function (pre) { pre.classList.toggle("wrapped", wrap); });
}
function cycleTheme() {
  var order = ["dark", "light", "system"];
  var i = order.indexOf(state.settings.theme);
  state.settings.theme = order[(i + 1) % order.length];
  applyAppearance(); saveSoon();
  toast("主题:" + (state.settings.theme === "dark" ? "深色" : state.settings.theme === "light" ? "浅色" : "跟随系统"), "info", 1400);
}
if (CAP.matchMedia) {
  var mq = window.matchMedia("(prefers-color-scheme: light)");
  var onMq = function () { if (state.settings.theme === "system") applyAppearance(); };
  if (mq.addEventListener) mq.addEventListener("change", onMq);
  else if (mq.addListener) mq.addListener(onMq);
}

/* ---------------------------------------------------------------------------
   6. 连接状态
--------------------------------------------------------------------------- */
function setConn(level, text) {
  connState.level = level; connState.text = text;
  var dot = $("conn-dot");
  dot.className = "conn-dot" + (level === "ok" ? " ok" : level === "err" ? " err" : level === "busy" ? " busy" : "");
  $("conn-text").textContent = text;
  var sdot = $("st-conn-dot"), st = $("st-conn");
  sdot.className = "conn-dot" + (level === "ok" ? " ok" : level === "err" ? " err" : level === "busy" ? " busy" : "");
  $("st-conn-text").textContent = text;
  st.className = "st clickable" + (level === "ok" ? " ok" : level === "err" ? " err" : level === "warn" ? " warn" : "");
}

/* ---------------------------------------------------------------------------
   7. Markdown 渲染(marked + DOMPurify,均为内嵌库)
--------------------------------------------------------------------------- */
var hasMarked = typeof window.marked !== "undefined";
var hasPurify = typeof window.DOMPurify !== "undefined";

if (hasPurify) {
  DOMPurify.addHook("afterSanitizeAttributes", function (node) {
    if (node.tagName === "A") {
      node.setAttribute("target", "_blank");
      node.setAttribute("rel", "noopener noreferrer nofollow");
    }
    if (node.tagName === "IMG") {
      node.setAttribute("loading", "lazy");
      node.setAttribute("referrerpolicy", "no-referrer");
    }
  });
}

/* brk=true 时单个换行也转成 <br>(用户消息用,更贴近输入时的换行意图)
   公式先被抽出成占位符,Markdown 处理完再替换为 KaTeX 输出 */
function renderMarkdown(text, brk) {
  if (text == null || text === "") return "";
  var src = String(text), spans = [];
  if (hasKatex) {
    try { src = protectMath(src, spans); } catch (e) { spans = []; src = String(text); }
  }
  if (!hasMarked) {
    var plain = "<p>" + escapeHtml(src).replace(/\n/g, "<br>") + "</p>";
    return substituteMath(plain, spans);
  }
  var raw;
  try {
    raw = marked.parse(src, { gfm: true, breaks: !!brk, mangle: false, headerIds: false });
  } catch (e) {
    raw = "<p>" + escapeHtml(src).replace(/\n/g, "<br>") + "</p>";
  }
  var html = hasPurify ? DOMPurify.sanitize(raw) : raw;
  return substituteMath(html, spans);
}

