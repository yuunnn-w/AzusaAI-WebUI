function convWipedAway(c, replaced) {
  if (!replaced) return false;
  var born = (c && typeof c.createdAt === "number" && isFinite(c.createdAt)) ? c.createdAt : 0;
  return born < convRevState.wiped;
}
function mergeConvsByIdb(idbList) {
  var out = [], gone = [], i, c, local, pick;
  var replaced = convRevState.replaced === true;   /* 读一次:本次合并按整库替换处理 */
  for (i = 0; i < (idbList || []).length; i++) {
    c = idbList[i];
    if (!c || !c.id) continue;
    if (convGoneActive(c.id)) { gone.push(c.id); continue; }
    local = convListFind(state.conversations, c.id);
    /* 留本页:有还没落库的改动;整库替换只看它有没有被那次替换盖掉 */
    if (local && !convCommitted(local) && !convWipedAway(local, replaced)) { out.push(local); continue; }
    pick = sanitizeConv(c);
