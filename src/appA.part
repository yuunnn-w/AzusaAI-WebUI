/* 用户明确要把这些会话拿回来(导入备份里带回了同一个 id):撤回墓碑并把意图写进记录传给对侧。
   不放进 convsPutAll:那条路径每次整表回写都会跑,让它清墓碑就等于把墓碑机制废掉一半 */
function markConvsRestored(ids, at) {
  var t = (typeof at === "number" && isFinite(at)) ? at : Date.now(), n = 0, raw = {};
  (ids || []).forEach(function (id) {
