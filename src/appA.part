  }, function () { convFlush.busy = false; return false; });
}
/* 自动整理(每次打开时跑一次,不需要用户点任何按钮):
   ① 把还内联在消息里的附件 payload 搬进附件库
   ② 回收没有任何消息引用的附件记录(真正的垃圾) */
var autoTidyStat = null;
function referencedBlobKeys() {
  var set = {};
  state.conversations.forEach(function (c) {
    (c.messages || []).forEach(function (m) {
      if (!Array.isArray(m.content)) return;
      m.content.forEach(function (p) {
