<script>
"use strict";
/* ============================================================================
   AzusaAI WebUI —— 单文件对话终端
   · OpenAI 兼容协议 / Anthropic Messages 协议
   · 全部逻辑与依赖内嵌于本文件,不请求任何外部资源
   · 内置浏览器端 MCP 工具服务(默认关闭)
   ============================================================================ */
(function () {

/* ---------------------------------------------------------------------------
   0. 环境能力与兼容垫片
--------------------------------------------------------------------------- */
var ENV = window.__ENV__ || { critical: [], soft: [], ok: true, noFlexGap: false };
var CAP = {
  stream: typeof window.ReadableStream === "function" && typeof window.TextDecoder === "function",
  abort: typeof window.AbortController === "function",
  clipboard: !!(navigator.clipboard && navigator.clipboard.writeText),
  broadcast: typeof window.BroadcastChannel === "function",
  speech: !!(window.speechSynthesis && typeof window.speechSynthesis.speak === "function"),
  recognition: !!(window.SpeechRecognition || window.webkitSpeechRecognition),
  objectUrl: !!(window.URL && window.URL.createObjectURL),
  matchMedia: typeof window.matchMedia === "function",
  timeout: typeof AbortSignal !== "undefined" && typeof AbortSignal.timeout === "function",
  download: typeof document.createElement("a").download !== "undefined",
  fileReader: typeof window.FileReader === "function",
  worker: typeof window.Worker === "function" && typeof window.Blob === "function"
    && !!(window.URL && window.URL.createObjectURL),
  cssEscape: typeof window.CSS !== "undefined" && typeof CSS.escape === "function",
  /* 外部 MCP 工具的能力门:外部工具条目带 cap:"fetch",
     缺 fetch 的环境(极老内核)整套外部工具自动隐藏 */
  fetch: typeof window.fetch === "function",
  /* Office 写入(生成/编辑 docx·pptx)的能力门:加载器与写入核心都就绪才算可用。
     office.part 缺失(构建期跳过)时写入核心缺席 ⇒ 整个 Office 工具自动隐藏 */
  office: !!(window.OfficeKit && window.OfficeKit.available
    && window.OfficeWrite && window.OfficeWrite.available)
};
var raf = window.requestAnimationFrame
  ? window.requestAnimationFrame.bind(window)
  : function (fn) { return setTimeout(function () { fn(Date.now()); }, 16); };

/* AbortController 垫片:旧内核缺少时保证发送/停止逻辑不抛错 */
if (!CAP.abort) {
  window.AbortController = function () {
    this.signal = { aborted: false, addEventListener: function () {} };
    this.abort = function () { this.signal.aborted = true; };
  };
  CAP.abort = false;
}
/* 超时包装:优先用原生 AbortSignal.timeout,否则手动计时 */
function timeoutSignal(ms) {
  var ctrl = new AbortController();
  var timer = setTimeout(function () { try { ctrl.abort(); } catch (e) {} }, ms);
  if (ctrl.signal && typeof ctrl.signal.addEventListener === "function") {
    ctrl.signal.addEventListener("abort", function () { clearTimeout(timer); });
  }
  return { signal: ctrl.signal, abort: function () { clearTimeout(timer); ctrl.abort(); } };
}

/* ---------------------------------------------------------------------------
   1. 常量
--------------------------------------------------------------------------- */
var LS_KEY = "chatgpt-webui-v1";
/* Base URL 的默认值:本机回环地址(中性,不指向任何具体机器,也不泄露内网前缀)。
   0.1.0 之前的旧默认曾是某个局域网地址 —— 已随首个公开版本移除;为不在公开源码里保留内网字面量,
   这里**不做**「旧默认 → 新默认」的等值改名迁移:任何已存设置都原样保留(见 mergeSettings 里的说明)。
   全新安装(或用户自己清空该字段)才会得到这个默认值 */
var DEFAULT_BASE = "http://127.0.0.1:8080/v1";
/* 用户可见版本号的**唯一权威**(改值 = 改这一处):环境面板 / 环境信息 / 导出备份 version 字段 /
   MCP clientInfo.version / 关于弹窗都读它;启动时把 <meta name="version"> 也同步成它。
   口径 = README 头 + CHANGELOG [0.2.0] + 发布 tag v0.2.0(0.1.0 是首个公开版本,旧值 "2.1" 是历史遗留)。(CHANGELOG [0.2.0] 节由终局文档批落笔后本口径才完整)
   注意:它不是存储 schema(那是 SCHEMA,另算),也不是 MCP 协议版本(MCP_PROTOCOL,另算) */
var APP_VERSION = "0.2.0";
/* 作者显示名与项目主页(唯一权威):关于弹窗的 hero 由 JS 从这里填充,
   HTML / CSS / 其它 JS 里不得再出现这两个字面量(日后改一行) */
var APP_AUTHOR = "yuunnn-w";
var APP_HOME_URL = "https://github.com/yuunnn-w/AzusaAI-WebUI";
var BOOT_AT = Date.now();    // 页面开始加载的时刻(环境面板显示运行时长)
var SCHEMA = 4;              // 设置结构版本,用于一次性迁移旧默认值
var MAX_ATTACH = 50 * 1024 * 1024;   // 见 appD 的 ATTACH_MAX_BYTES(两处必须同值)
/* 自定义标签页图标(设置 → 外观):输入上限 → 居中剪方 → ≤256px(不放大)→ PNG。
   处理结果以 data URI 存进 settings.customIcon,超 FAVICON_DATA_MAX 时降 128/96px 重试 */
var FAVICON_MAX_SIDE = 256;
var FAVICON_SRC_MAX = 10 * 1024 * 1024;
var FAVICON_DATA_MAX = 500 * 1024;
var MAX_MSGS_PER_CONV = 600;
/* ---- 上下文压缩(Compact 工具 / 自动压缩 / 近极限提醒)的数值口径 ----
   ★ 与 settings.compact(紧凑模式,界面密度)是两个无关的开关,只是名字相邻 */
var CX_TRIGGER_DEF = 85;        // 自动压缩默认阈值(%)
var CX_TRIGGER_MIN = 60, CX_TRIGGER_MAX = 95;
var CX_WARN_GAP = 15;           // 提醒阈值 = 触发阈值 - 15(个百分点,下限 50)
var CX_KEEP_RATIO = 0.15;       // 保留尾部预算 = 窗口 × 0.15(Kimi maxRecentSizeRatio 0.2 / deepseek retainRatio 0.16 的同量级)
var CX_KEEP_MIN_TOK = 8192;     // 保留尾部预算下限
var CX_KEEP_MAX_TOK = 20000;    // 保留尾部预算上限(= Kimi COMPACT_USER_MESSAGE_MAX_TOKENS)
var CX_HEAD_TOK = 2000;         // 最早用户输入保留预算(= Kimi COMPACT_USER_MESSAGE_HEAD_TOKENS)
var CX_KEEP_MAX_MSGS = 8;       // 保留尾部最多几条消息(我们的扩展预算,非 Kimi 原值)
var CX_LOOP_TAIL_MIN = 2;       // 「单用户轮有界 tail 档」要求 tail 至少含这么多个完整工具循环
var CX_RESERVE_MIN = 16384;     // 冗余触发项下限:reserve = min(max(本值, win*0.05), win*0.5)
var CX_OVERFLOW_PER_TURN_MAX = 3;   // 溢出恢复:每 turn 最多自动压缩次数(U-4 借鉴-1;appD/appE 共用同一计数器)
var CX_SUMMARY_TIMEOUT_MS = 900000;   // 摘要请求超时(ms);每次尝试各计。全量输入后 180s 会在长会话误杀 ⇒ 抬到 15 分钟(Ctrl+X 可随时取消)
var CX_MIN_MSGS = 4;            // 少于这么多条消息时拒绝压缩(可压缩内容不足)
/* ---- 摘要请求的预算 / 重试链(对齐 Kimi fullCompaction;口径见 shared/specs/compact-align-kimi-plan.md §3.2/§3.4) ---- */
var CX_SUMMARY_OUT_CAP = 131072;        // 摘要输出预算封顶(= Kimi DEFAULT_COMPACTION_MAX_COMPLETION_TOKENS = 128*1024)
var CX_SUMMARY_OUT_MIN = 4096;          // 适配收窄的下限(连最小预算都放不下 ⇒ 改缩输入,不再压预算)
var CX_SUMMARY_ATTEMPTS_MAX = 5;        // 摘要请求总尝试上限(= Kimi MAX_COMPACTION_RETRY_ATTEMPTS)
var CX_SUMMARY_SHRINK_RATIOS = [0.7, 0.5, 0.35];  // 溢出缩窗比例(= Kimi COMPACTION_OVERFLOW_SHRINK_RATIOS)
var CX_SUMMARY_SHRINK_MAX = 3;          // 缩窗次数上限(= Kimi MAX_COMPACTION_OVERFLOW_SHRINK_ATTEMPTS)
var CX_SUMMARY_BACKOFF_BASE_MS = 500;   // 可重试错误的退避基数(= Kimi _base/utils/retry.ts)
var CX_SUMMARY_BACKOFF_MAX_MS = 32000;  // 退避上限
var CX_SUMMARY_BACKOFF_JITTER = 0.25;   // 退避抖动(0~25% 正向)
var CX_SUMMARY_FIT_MARGIN_RATIO = 0.05; // estInput 余量比例(配套下限 1024,见 cxSummaryBudget)
var CX_SUMMARY_MEDIA_KEEP_RECENT = 2;   // 媒体降级档保留最近几张图(= Kimi MEDIA_DEGRADE_KEEP_RECENT)
var CX_SUMMARY_MEDIA_MAX_BYTES = 32 * 1024 * 1024;  // 媒体体积闸(本项目的扩展,非 Kimi 原值):起步即 degraded 档
/* 最大输出滑块上限 384K;Anthropic 协议必须带 max_tokens,未设置时用 256K */
var MAX_TOK_LIMIT = 393216;
var ANTHROPIC_DEFAULT_MAXTOK = 262144;
/* 模型上下文窗口的兜底值:服务端没给出时用它(默认 K 值见 ctxWinK)
   范围常量是滑块 / 输入框 / 归一化(clamp)三条路径的**唯一口径**,别处不得另写一份 */
var DEFAULT_CTX_WINDOW = 262144;
var CTX_WIN_K_MIN = 8;      // 手动设定下限 8K
var CTX_WIN_K_MAX = 1024;   // 手动设定上限 1024K(1M)
var CTX_WIN_K_STEP = 8;     // 滑块步进 8K

var DEFAULT_SETTINGS = {
  schema: SCHEMA,
  protocol: "openai",
  baseUrl: DEFAULT_BASE,
  apiKey: "",
  model: "",
  /* 预检规避兼容模式(默认关;设置 → 模型 → 高级区):请求改发「简单请求」以绕过 OPTIONS 预检。
     仅 OpenAI 兼容 + 未填 API Key 时可用;开启前自带前置探针(门控与探针口径见 appD 的 corsBypassGate / setCorsBypass) */
  corsPreflightBypass: false,
  stream: true,
  autoscroll: true,
  showReasoning: true,
  autoSync: true,
  systemPrompt: "",
  theme: "dark",
  accent: "sakura",
  fontSize: 14.5,
  compact: false,
  fx: true,
  codeWrap: true,
  customIcon: "",           // 自定义标签页图标(处理后 PNG 的 data URI);"" = 默认图标
  reasoningEffort: "",
  temperature: -1,
  topP: -1,
  maxTokens: 0,
  freqPenalty: 0,
  presencePenalty: 0,
  ctxMsgs: 0,
  /* 手动设定的上下文窗口(K):服务端没给出该模型的窗口长度时按它估算(默认 256K)
     —— 服务端一旦返回该模型的窗口长度,一律以服务端为准,这里的值不参与计算 */
  ctxWinK: DEFAULT_CTX_WINDOW / 1024,
  tokCalib: {},
  modelCtx: {},
  /* --- MCP 工具(由对话中的模型调用,默认关闭) --- */
  toolsEnabled: false,
  toolPerms: {},
  toolLimits: { timeoutMs: 600000, maxCalls: 50, maxOut: 16384 },
  toolNet: false,
  /* --- 上下文压缩(Compact / 自动压缩;与上面的 settings.compact「紧凑模式」无关) --- */
  compactAuto: true,        // 接近窗口上限时自动压缩(可在 设置 → 工具与权限 关闭)
  compactTriggerPct: 85,    // 自动压缩阈值(60~95,单位 %);提醒阈值 = 本值 - 15(下限 50)
  /* --- 工作区(沙箱虚拟盘):右栏开合状态 + 各项上限 --- */
  /* 这三个上限的默认值在这里写死是**有意的**:`WS_SESSION_BYTES/WBACK/FILES`
     是 appE 的常量,而 appA 在 appE **之前**求值 —— 这里引用会拿到 undefined。
     三个运行期使用点(appE 的 wsOpenSession / pyWriteBack / pyToolRun)都已改引那三个常量。 */
  wsRailOpen: false,        // 右栏开合状态(纯界面状态,只在 localStorage 里)
  wsSessionBytesMb: 16,     // 一次会话预载进执行环境的总量上限(MB) —— 默认 = WS_SESSION_BYTES/1MB
  wsSessionWbackMb: 256,    // 一次会话回写工作区的总量硬顶(MB) —— 默认 = WS_SESSION_WBACK/1MB
  wsSessionFiles: 2000,     // 一次会话回写的文件数上限 —— 默认 = WS_SESSION_FILES
  toolOpsAllowDelete: true,      // FileOps 是否允许 delete
  toolOpsAllowOverwrite: true,   // FileOps 是否允许覆盖已存在的目标
  /* --- Python 运行时(pyodide,随页面内置) --- */
  pyodideCacheReady: false,      // 运行时是否已缓存(全内嵌下 pyocache 恒空 → 纯展示位)
  pyTaskTimeoutMs: 1800000,      // 后台 Python 任务超时(默认 30 分钟,clamp 60s–60min)
  pyTaskStopKills: false,        // 「停止生成时也终止后台任务」(默认关)
  /* --- 外部 MCP(需求④;默认关闭) --- */
  externalToolsEnabled: false,       // 外部 MCP 总开关(刻意避开 mcpEnabled,旧语义已废弃,见 mergeSettings)
  externalToolDefaultPerm: "ask",    // 外部工具默认权限(ask/allow/deny;个别工具的三态 toolPerms[全名] 优先)
  mcpServers: [ {                    // 服务器列表(UI 首版只渲染 [0])
    id: "local", name: "本地 Rust-MCP", url: "http://127.0.0.1:3344/mcp",
    enabled: true, auth: "", timeoutMs: 120000, disabledTools: []
  } ],
  mcpInjectInstructions: false,      // 是否把服务器 instructions 拼进系统提示词(默认不注入)
  /* --- 附件与多模态 --- */
  pdfMode: "text",          // PDF:纯文本抽取(默认) / 图片渲染
  pdfDpi: 150,              // PDF 图片模式的渲染分辨率(DPI)
  pdfMaxPages: 10,          // PDF 图片模式最多处理多少页
  ocrLangs: "chi_sim+eng",  // OCR 语言
  visionForce: "auto",      // auto / yes / no:图像输入能力的手动覆盖
  modelVision: {},          // 每个模型的视觉能力探测结果
  imgMaxSide: 4096,         // 图片最长边上限,超过就自动下采样
  imgResample: "spline",    // 下采样算法预设(spline/high/medium/low/nearest)
  attachMsgMaxMb: 100,      // 单条消息附件总量上限(MB;数据在大仓库里,所以可以很宽松)
  cleanKeepRecent: 30       // 清理/自动整理时「最近 N 个对话」原样保留(10~100)
};

/* 思考强度挡位。空字符串 = 不发送,交由服务端决定 */
var EFFORT_LEVELS = ["low", "medium", "high", "max"];

/* 图片下采样算法预设。
   浏览器不暴露具体滤波核,只给 imageSmoothingQuality(low/medium/high),
   所以「样条插值」= 先逐级减半(每步 ≤2 倍)再用 high 质量缩放 ——
   这是最接近专业立方/样条重采样的做法,抗锯齿与细节保留明显好于一次性缩放。 */
var RESAMPLE_PRESETS = {
  spline: { label: "样条插值", desc: "逐级减半 + high 质量平滑,细节保留最好(默认)", quality: "high", steps: true },
  high: { label: "高质量", desc: "一次性 high 质量缩放,速度快一些", quality: "high", steps: false },
  medium: { label: "中等", desc: "medium 质量,更快、略糊", quality: "medium", steps: false },
  low: { label: "快速", desc: "low 质量,最快,锯齿较明显", quality: "low", steps: false },
  nearest: { label: "最近邻", desc: "不做平滑,适合像素画 / 截图放大看像素", quality: "low", steps: false, nearest: true }
};

/* 主题色(马卡龙色系)。采样参数为 -1 表示「不发送」 */
var ACCENTS = ["mint", "sakura", "lavender", "sky", "peach", "lemon",
               "matcha", "lilac", "aqua", "coral", "taro", "cream"];
var ACCENT_ALIAS = {
  cyan: "aqua", violet: "lavender", emerald: "mint", amber: "cream", rose: "coral",
  blue: "sky", indigo: "lavender", teal: "aqua", green: "mint", purple: "lavender",
  orange: "peach", yellow: "lemon", pink: "sakura", red: "coral", gray: "sky", grey: "sky"
};

var DEFAULT_LIB = [
  /* ---- 办公文书 ---- */
  { group: "办公文书", name: "通知 / 公告起草", text: "你是一位有十五年经验的机关文秘。请把下面的要点写成一份正式通知，包含：标题、主送单位、正文（分“缘由 → 事项 → 执行要求”三段）、落款与日期。\n\n要求：用词庄重简洁，不用口语、不用感叹号；时间、单位、数字一律照抄我给的，没有提供的不要编造；必要但缺失的信息（如落款单位）请留成 {{待填}} 占位符，不要自行代拟。\n\n要点：\n{{把要通知的事项、关键时间点和涉及单位写在这里}}\n\n" },
  { group: "办公文书", name: "商务邮件 / 对外函件", text: "请以我的身份写一封商务邮件。\n\n收件人：{{收件人与关系，如“合作方项目经理”}}\n目的：{{你想达成什么，如“请对方在周五前确认排期”}}\n背景：{{一句话说明来龙去脉}}\n语气：{{正式 / 客气但直接 / 追问进度}}\n\n要求：\n① 主题行不超过 20 字，让人一眼看出要办什么事；\n② 正文第一句直接说明来意，不要铺垫；\n③ 请求部分写成即使被拒绝也留有回旋余地的表述；\n④ 结尾给出明确的下一步动作和对应时间点；\n⑤ 不要添加我没有提供的承诺、价格或期限。\n\n再附一句：如果我给的背景不足以礼貌地提出这个请求，请先告诉我缺什么。\n\n" },
  { group: "办公文书", name: "一页纸汇报", text: "你是资深汇报撰稿人。请把下面的素材整理成一页纸汇报，固定四节：\n\n① 结论——3 句以内，含关键数字；\n② 依据——支撑结论的数据与事实，逐条注明来自素材的哪一部分；\n③ 风险与不确定项——没把握的地方必须显式标注，不要藏进正文；\n④ 需决策事项——每项写明“建议方案 + 备选方案 + 最晚决策时间”。\n\n硬性要求：只用素材里出现的信息，缺的标“素材未提供”；不要用“赋能、闭环、抓手、打法”这类词；全文控制在 800 字以内。\n\n素材：\n{{粘贴原始记录、数据或散乱笔记}}\n\n" },
  /* ---- 写作与润色 ---- */
  { group: "写作与润色", name: "文字润色（保原意）", text: "你是中文编辑。请在完全保留原意、语气和事实的前提下润色下面的文字：改掉病句与搭配不当，去掉重复和空话，调整长句节奏，统一标点用法。\n\n不要做的事：不增加原文没有的信息；不把具体表述换成模糊的大词（如把“延迟 3 天”改成“存在一定延迟”）；不改动专有名词、产品名、引用的原文和数字。\n\n输出：① 润色后的全文；② 如果改动超过 5 处，附一张对照表（原文 → 改后 → 理由）。\n\n原文：\n{{粘贴需要润色的文字}}\n\n" },
  { group: "写作与润色", name: "术语与风格统一", text: "下面是同一份文档的若干片段。请：\n\n① 找出指代同一概念但用词不一致的地方（例如“用户 / 客户 / 业主”混用，“接口 / API / 服务”混用），列成对照表；\n② 给出一份术语表：术语 | 出现位置 | 建议统一为 | 理由；\n③ 按术语表改写全文，保持原句式与篇幅基本不变；\n④ 单独列出你判断“看似同义但实际不同、不该统一”的词对。\n\n不要改动专有名词、商标、产品型号与引用的原文；拿不准的列进第 ④ 项而不是直接改。\n\n文档：\n{{粘贴全文，或分批粘贴并说明还有后续}}\n\n" },
  { group: "写作与润色", name: "两层摘要", text: "请为下面的内容生成两层摘要：\n\n① 一句话结论——不超过 40 字，说清“这是关于什么的 + 所以怎样”；\n② 要点清单——不超过 8 条，每条一行，按重要性排序，每条末尾用括号注明依据在原文的第几段。\n\n硬性要求：只写原文支持的内容；原文没说的不要推测补全；确实需要外部信息才能判断的，另起一行写“待核实：……”。不要评价文笔，不要写导语式的开场白。\n\n若原文自相矛盾，请单列一行“原文冲突：……”并指出冲突的两处。\n\n内容：\n{{粘贴正文}}\n\n" },
  /* ---- 科研与文献 ---- */
  { group: "科研与文献", name: "文献综述框架", text: "你是 {{学科领域}} 方向的科研人员。我的研究问题是：{{研究问题}}。\n\n请给出：\n① 3–5 条可用的文献检索式——中英文关键词、同义词、布尔组合都要写出来，并说明每条式子的意图（宽检 / 精检）；\n② 综述的分类维度——按方法 / 按问题 / 按数据源各给一套，并说明每套的适用条件与缺陷；\n③ 该领域公认的关键节点工作与常见争议点——**明确标注哪些是你有把握的、哪些需要我自己核实**；\n④ 综述章节骨架（到二级标题），并说明每节要回答的问题。\n\n**绝对不要编造文献标题、作者、期刊或年份。** 需要举例时，用“{{作者}}（{{年份}}）”占位符让我自己填。\n\n" },
  { group: "科研与文献", name: "论文语体改写", text: "请把下面的段落改写为学术论文语体，目标语体是：{{中文核心期刊 / IEEE 英文 / 学位论文}}。\n\n改写规则：\n① 去掉口语化表述与主观夸饰（“非常好”改成可核查的具体陈述）；\n② 主动 / 被动语态按该语体惯例统一；\n③ 保留所有数字、单位、引用标记、术语和公式原样；\n④ 不新增引用，不改变原意，不替我编造实验结果；\n⑤ 原文逻辑跳跃处不要自行补全，改成一句“此处需要补充：……”。\n\n输出：① 改写后的段落；② 改动说明（逐条，说明为什么这样改，便于我确认是否接受）。\n\n段落：\n{{粘贴段落}}\n\n" },
  { group: "科研与文献", name: "审稿意见 / 回复信", text: "角色：我是 {{审稿人 / 作者}}。请根据下面的输入生成一份 {{审稿意见 / 回复信}}。\n\n结构：\n① 总体评价——先给结论（录用 / 小修 / 大修 / 拒稿）并给一句话核心理由；\n② 具体问题——分条列出，每条含：位置、问题、为什么是问题、建议怎么改；\n③ 分级——明确区分“必须修改”与“建议改进”；\n④ 若信息不足以下判断，单列“无法从现有材料判断的事项”。\n\n立场要求：就事论事，只针对内容与方法，不做人身评价，不使用贬义措辞；回复信部分要逐条对应审稿意见编号，未采纳的意见必须写明理由。\n\n输入：\n{{粘贴稿件摘要 / 审稿意见原文}}\n\n" },
  /* ---- 数据与表格 ---- */
  { group: "数据与表格", name: "表格数据解读", text: "你是数据分析师。下面是 {{业务场景，如“某产品近 12 个月销量”}} 的数据表。请输出：\n\n① 事实——3–5 条，说清数据本身（最大 / 最小、趋势方向、明显的异常点及其位置）；\n② 原因假设——2–3 个可能解释，每个假设都要写明“需要什么额外数据才能验证”；\n③ 数据质量问题——缺失、口径不一致、样本过小、单位混用，逐条指出；\n④ 建议——3 条可执行动作，按“投入小见效快 → 投入大”排序。\n\n硬性要求：只用表里出现的数字做推论，凡表中没有的，明确写“表里没有”；不要给出没有数据支撑的百分比；涉及预测时说明依据和置信程度。\n\n数据：\n{{粘贴表格，TSV 或 CSV 均可}}\n\n" },
  { group: "数据与表格", name: "Excel 公式与透视表", text: "你是 Excel 专家。我的软件与版本：{{Excel 2016 / Microsoft 365 / WPS}}。\n\n表格结构：{{列名与含义，如 A 列日期、B 列部门、C 列金额}}\n我想实现：{{目标，如“按月 + 部门汇总金额，并标出环比下降超过 10% 的组”}}\n\n请给出：\n① 首选方案——写清公式全文、填在哪一格、是否需要数组公式（是否要按 Ctrl+Shift+Enter），并逐段解释公式在做什么；\n② 透视表方案——行 / 列 / 值 / 筛选器分别拖什么，以及需要怎么预处理数据（如补日期列）；\n③ 已知陷阱——绝对 / 相对引用、文本型数字、合并单元格、日期被识别成文本时的表现。\n\n**不要使用我这个版本不支持的函数**；如果确实必须用新函数（如 XLOOKUP、FILTER），请标注最低版本并给出老版本替代写法。\n\n" },
  { group: "数据与表格", name: "数据清洗口径与脚本", text: "下面是一份待清洗的数据样本（含表头）。请输出：\n\n① 质量问题清单——逐列列出发现的问题（缺失、重复、格式不一致、单位混用、异常值、编码错误），每条附一个具体例子；\n② 清洗规则表——列名 | 规则 | 处理方式（保留 / 替换 / 置空 / 剔除）| 影响行数估计；\n③ Python 脚本——用 pandas 实现，规则与上表一一对应并加行内注释，脚本末尾打印清洗前后的行数与关键列分布；\n④ 待人工确认清单——你不能替我决定的条目（如“0 是缺失还是真实值”），列成选项让我选。\n\n不要在我没确认前直接剔除数据；不要让脚本静默丢弃行——每次丢弃都要能被日志看到。\n\n数据：\n{{粘贴样本，含表头}}\n\n" },
  /* ---- 代码与工程 ---- */
  { group: "代码与工程", name: "代码审查", text: "你是 {{编程语言}} 的资深工程师。请审查下面的代码，按优先级输出：\n\n① 正确性缺陷——逻辑错误、边界与空值、并发竞态、异常传播路径，每条写出触发条件；\n② 安全问题——注入、越权、密钥硬编码、未校验的外部输入、日志泄露敏感信息；\n③ 性能与资源——算法复杂度、重复 IO、未释放的连接 / 句柄 / 监听器；\n④ 可读性与一致性——只列影响维护成本的部分，不评论纯风格偏好。\n\n每条格式：位置（行号或函数名）→ 问题 → 为什么是问题 → 最小修改建议（只改必要的部分，不要顺手重写）。\n\n只报你确实看出来的问题，不要为凑数编造；没把握的标注“待确认”并说明怎么确认。若某处是对的但容易被误读，也可以点一句。\n\n代码：\n{{粘贴代码}}\n\n" },
  { group: "代码与工程", name: "需求说明（可评审）", text: "你是产品经理。请为下面这个需求写一份可评审的需求说明，固定章节：\n\n背景与问题 → 目标与非目标 → 用户故事（角色 / 场景 / 期望）→ 功能需求（编号，逐条可验收）→ 边界与异常 → 依赖与假设 → 验收标准 → 风险。\n\n硬性要求：\n① 每条功能需求都必须能被测试——写不出验收方式的，就不要写成需求；\n② 不要发明我没有提到的功能，也不要替我扩大范围；\n③ 我提供的信息不足时，把缺口整理成“待确认清单”，**不要自行假设后直接写成需求**；\n④ “非目标”一栏必须写，防止范围蔓延。\n\n需求描述：\n{{描述你想做的东西，可以只写一句}}\n\n" },
  { group: "代码与工程", name: "报错定位与最小复现", text: "你是调试专家。请根据下面的信息给出诊断：\n\n① 失败链路复述——你认为哪一步先出的问题，按时间顺序写出来，供我确认；\n② 根因假设——按可能性排序列 3–5 个，每个都附一个“能证伪它的最小实验”；\n③ 最小复现步骤——尽量少的步骤和最少的依赖，写清每一步的期望结果与实际结果；\n④ 针对性修法与验证方法——修完之后怎么确认真的修好了（不要用“应该好了”）。\n\n信息不足时，先列出你需要我补充什么，不要跳过直接给结论；不要把“重启 / 重装 / 换环境”当作首选建议。\n\n环境：{{语言 / 框架 / 版本 / 操作系统}}\n现象：{{期望行为 vs 实际行为}}\n报错全文：\n{{粘贴完整报错与堆栈}}\n相关代码：\n{{粘贴关键代码}}\n\n" },
  /* ---- 会议与沟通 ---- */
  { group: "会议与沟通", name: "会议纪要", text: "你是项目秘书。请把下面的会议记录整理成可核对的纪要：\n\n① 会议目的与结论——先写结论，再写目的；\n② 待办事项表格——任务 | 负责人 | 截止时间 | 依赖 | 原文依据（引用记录里的原话）；\n③ 未决问题与风险——写明卡在谁身上、卡在什么条件上；\n④ 待确认——记录中听不清、人名或日期不确定的，原样保留并标注“待确认”。\n\n硬性要求：不要补写记录中没有出现的决定；不要替任何人认领任务（负责人没点名就写“未指定”）；转写里明显误识别的词，只在上下文能唯一确定时才更正，并注明“推测更正”。\n\n记录：\n{{粘贴会议速记或录音转写全文}}\n\n" },
  { group: "会议与沟通", name: "周报 / 进展汇报", text: "请把下面的零散工作记录整理成本周进展，固定三节：本周完成 / 遇到的问题 / 下周计划。\n\n要求：\n① “本周完成”每条都要有可量化的结果（数量、比例、耗时、结论），口语描述转成书面表述；\n② 无法量化的条目，在末尾标“（待补数据）”，**不要编造数字**；\n③ “遇到的问题”要写清影响范围与当前状态（已解决 / 进行中 / 被阻塞），并写明卡点；\n④ “下周计划”最多 5 条，按优先级排序，每条给出一个能判断完成的标志；\n⑤ 区分“我做的”和“我参与的”，不要揽功也不要埋没。\n\n语气平实，不要用“赋能 / 闭环 / 抓手 / 对齐颗粒度”这类词。\n\n记录：\n{{粘贴本周流水记录}}\n\n" },
  { group: "会议与沟通", name: "演示大纲与口播稿", text: "你是汇报顾问。请根据下面的材料产出一份 {{15 分钟}} 的演示方案：\n\n① 一句话主张——听众听完应该记住的那句话；\n② 幻灯片清单——页码 | 标题 | 这页要证明什么 | 建议呈现形式（图 / 表 / 文字）| 预计用时；\n③ 逐页口播要点——写成口语短句，不要逐字稿，每页 3–5 个要点；\n④ 预判提问——5 个可能的提问与应答要点，其中至少 1 个是刁难问题；\n⑤ 取舍建议——告诉我为控制在 {{15 分钟}} 内，应该砍掉哪些内容，以及砍掉后会被追问什么。\n\n听众：{{听众背景与关心点}}；我的核心结论：{{核心结论}}；可用材料：{{材料清单}}。\n\n" }
];

/* 旧内置模板库签名(U-3 换代闸用):**逐字**保留上一版的 8 条(标题 + 正文),一字不改。
   `libIsLegacyDefault()` 靠它判定"用户的模板库从未被改过";改成常量表而不是散写判据,
   是为了让"什么算未改过"只有一个可复核的出处(整体逐条逐序比对 name ∧ text)。 */
var LEGACY_LIB = [
  { name: "设计评审汇报", text: "你是一位飞机设计研究所的资深主任设计师。请把下面的设计内容整理成评审汇报:先给结论与主要指标,再按「设计依据 / 方案描述 / 分析校核 / 风险与对策」四节展开,语言严谨、面向评审专家。\n\n" },
  { name: "需求符合性检查", text: "请对照需求条款逐条检查下面方案描述的符合性,按「条款号 | 符合 / 部分符合 / 不符合 | 依据说明 | 缺口与建议」输出表格,逐条核对、不要遗漏;方案中没有对应描述的标「未覆盖」。\n\n需求条款:\n方案描述:\n" },
  { name: "技术方案论证", text: "请以飞机总体论证专家的视角,对下面的技术方案从「技术可行性、性能指标达成度、研制风险、成本与周期」四个维度进行论证,给出明确的论证结论与改进建议。\n\n" },
  { name: "仿真试验数据分析", text: "请分析下面的仿真 / 试验数据:识别异常点与变化趋势,与理论预期或指标要求对比,给出可能的原因分析和下一步试验建议。\n\n[粘贴数据]" },
  { name: "专利交底书", text: "请根据下面的技术方案起草一份专利交底书草稿,包含:技术领域、背景技术、发明内容、技术方案、具体实施方式、与现有技术相比的有益效果。\n\n" },
  { name: "中译英(信达雅)", text: "把下面的内容翻译成地道的英文,保持原意与语气,不要逐字直译。只输出译文。\n\n" },
  { name: "要点提取", text: "把下面的内容压缩成不超过 8 条要点,每条一行,用 - 开头。只输出要点。\n\n" },
  { name: "代码审查", text: "请以资深工程师的视角审查下面的代码,指出潜在缺陷、边界情况与性能问题,并给出修改后的代码。\n\n" }
];
/* 内置模板库换代闸(U-3 路径 A;签名闸,自幂等):
   库与 LEGACY_LIB **逐条逐序逐字**相同(= 从未改过)⇒ 判定为"还是旧默认",可整组换代;
   只要用户加过 / 删过 / 改过任一条(含只改正文)⇒ 一律保留用户自建,绝不覆盖用户数据。
   替换后数组不再等于旧签名 ⇒ 重复执行是 no-op(loadState 被 storage 事件反复调用也安全)。
   不动 SCHEMA:promptLib 不在 DEFAULT_SETTINGS 内,不参与一次性存储迁移闸。 */
function libIsLegacyDefault(list) {
  if (!Array.isArray(list) || list.length !== LEGACY_LIB.length) return false;
  for (var i = 0; i < list.length; i++) {
    var a = list[i], b = LEGACY_LIB[i];
    if (!a || a.name !== b.name || a.text !== b.text) return false;
  }
  return true;
}

var WELCOME_TIPS = [
  { icon: "brain", text: "用通俗的语言解释 Transformer 的注意力机制,并说明它在机载边缘计算上的落地难点" },
  { icon: "cpu", text: "对比 CNN 与 ViT 在航空遥感图像目标检测中的优缺点,用表格呈现" },
  { icon: "book", text: "帮我梳理飞行器总体设计的主要流程与各学科之间的关键权衡" },
  { icon: "terminal", text: "写一段 Python,用卡尔曼滤波融合 IMU 与 GNSS 数据,并逐行解释思路" },
  { icon: "shield", text: "民用飞机适航审定对飞控软件提出了哪些主要要求?" },
  { icon: "activity", text: "分析这份风洞试验数据的趋势,指出异常点并给出复测建议:[粘贴数据]" }
];

var SHORTCUTS = [
  ["Enter", "发送消息"],
  ["Shift + Enter", "换行"],
  ["Ctrl + K", "命令面板"],
  ["Ctrl + F", "在对话中查找"],
  ["Ctrl + M", "切换模型"],
  ["Ctrl + B", "显示 / 隐藏侧边栏"],
  ["Ctrl + ,", "打开设置"],
  ["Ctrl + N", "新建对话"],
  ["Ctrl + Shift + L", "切换深色 / 浅色"],
  ["Ctrl + Alt + C", "复制最后一条回答"],
  ["Ctrl + O", "展开 / 折叠压缩总结"],
  ["Ctrl + X", "停止生成 / 中止手动压缩"],
  ["Esc", "关闭弹层 / 丢弃待发送缓冲"],
  ["F1 / ?", "使用教程与关于"],
  ["↑ / ↓(命令面板)", "选择条目"],
  ["PageUp / PageDown", "滚动对话(命令面板内为 ±5 选择)"]
];

/* ---------------------------------------------------------------------------
   2. 状态与持久化
--------------------------------------------------------------------------- */
function loadState() {
  var raw = null;
  try { raw = localStorage.getItem(LS_KEY); } catch (e) { storageBroken = true; }
  var s = null;
  if (raw) {
