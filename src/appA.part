  return { todo: todo, freed: freed };
}
/* 异步删除的**唯一出口**(blobDel 自带 delete blobStore.mem[id],返回「尝试删除的键数」) */
function cxReleaseBlobs(todo) {
  if (!todo || !todo.length) return Promise.resolve(0);
  return blobDel(todo);
}
/* 丢弃区间 [from, to] 的消息:只做三件事 —— 收集键、估算 token、splice。
   **不释放、不 await、不改其它字段**(释放时机由调用方按顺序契约决定,见上) */
function cxDropMessages(conv, from, to) {
  var c = conv;
  if (!c || !Array.isArray(c.messages)) return { keys: [], tokens: 0 };
  var n = c.messages.length;
  from = Math.max(0, Math.floor(Number(from) || 0));
  to = Math.min(n - 1, Math.floor(Number(to)));
  if (!(to >= from)) return { keys: [], tokens: 0 };
  var slice = c.messages.slice(from, to + 1);
  var tokens = 0;
  slice.forEach(function (m) { tokens += estimateContentTokens(m.content) + estimateTokens(m.reasoning || ""); });
  var keys = cxBlobKeysOfMessages(slice);
