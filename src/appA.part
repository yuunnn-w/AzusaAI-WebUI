  seen: 0,        /* 已经按记录收敛过的版本号(同一 rev 的重复事件不再重读全库,见 onStorageSync) */
  wiped: 0,       /* 「整库被替换」(清空 / 导入)的时间戳:跟着记录走,对侧见到更大的值就按整库替换处理 */
