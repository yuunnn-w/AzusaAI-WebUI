<script type="text/plain" id="ocr-embed-adapter">
/* ============================================================
   OCRKit —— core 适配层
   必须拼在官方 tesseract-core glue 之后、官方 worker 源码之前。

   官方 worker 的 getCore() 逻辑:
       if (typeof global.TesseractCore === 'undefined') { ... importScripts(corePath) ... }
   因为我们在同一份脚本里先执行了 core glue,global.TesseractCore 已存在,
   于是 importScripts 被完全跳过 ——  blob worker 里那一步在 file:// 下必然失败。

   这一层只做两件事:
   1. 把 wasm 二进制以 wasmBinary 形式注入(自包含,不需要再去找 .wasm 文件);
   2. 等主线程把内嵌资源投递进来之后再真正初始化。
   ============================================================ */
(function () {
  var realCore = self.TesseractCore;

  self.TesseractCore = function (arg) {
    return self.__OCR_EMBED_READY.then(function () {
      var a = arg || {};
      a.wasmBinary = new Uint8Array(self.__OCR_WASM);
      return realCore(a);
    });
  };
})();

</script>

