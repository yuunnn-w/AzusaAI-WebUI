<script type="text/plain" id="ocr-embed-boot">
/* ============================================================
   OCRKit —— 内联 blob worker 的引导层(必须拼在 worker 脚本最前面)

   职责:
   1. 在 worker 内**彻底切断网络**:覆写 self.fetch,只应答被内嵌的
      *.traineddata,其余一律 reject(并记录到 self.__OCR_BLOCKED)。
      —— file:// 下 blob worker 既不能 importScripts(blob:),
         也不能 fetch(blob:),所以资源只能靠 postMessage 投递。
   2. 接收主线程投递的内嵌资源(wasm 原始字节 + traineddata 原始字节),
      放到 self.__OCR_WASM / 内部 langs 表里,并 resolve
      self.__OCR_EMBED_READY,让 core adapter 继续加载 wasm。
   ============================================================ */
(function () {
  var langs = null;
  var resolveReady;
  var blocked = [];

  self.__OCR_BLOCKED = blocked;
  self.__OCR_EMBED_READY = new Promise(function (r) { resolveReady = r; });

  function okResponse(buf, url) {
    /* 不用 Response 构造器:手搓一个鸭子类型对象即可,
       tesseract 只用到 .ok / .status / .arrayBuffer() */
    return {
      ok: true,
      status: 200,
      statusText: 'OK',
      url: url,
      arrayBuffer: function () { return Promise.resolve(buf); },
      text: function () { return Promise.resolve(''); },
      json: function () { return Promise.resolve(null); }
    };
  }

  /* ---------- 1. 网络闸门:任何未被内嵌的请求直接失败 ---------- */
  self.fetch = function (url, init) {
    var s = String(url == null ? '' : url);
    var m = /([A-Za-z0-9_]+)\.traineddata(\.gz)?$/.exec(s);
    if (m && langs && langs[m[1]]) return Promise.resolve(okResponse(langs[m[1]], s));
    blocked.push(s);
    return Promise.reject(new Error('OCRKit: 已拦截未内嵌的网络请求 ' + s));
  };

  /* ---------- 2. 资源投递握手 ---------- */
  self.addEventListener('message', function (ev) {
    var d = ev.data;
    if (!d || d.__ocrEmbed !== 1) return;

    /* 官方 worker 的 handler 也会收到这条消息,必须拦住 */
    if (ev.stopImmediatePropagation) ev.stopImmediatePropagation();

    langs = {};
    var raw = d.langs || {};
    for (var k in raw) {
      if (Object.prototype.hasOwnProperty.call(raw, k)) langs[k] = raw[k];
    }
    self.__OCR_WASM = d.wasm;

    if (resolveReady) { resolveReady(); resolveReady = null; }
    self.postMessage({ __ocrEmbedAck: 1, langs: Object.keys(langs) });
  });
})();

</script>

