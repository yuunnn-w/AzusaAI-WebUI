      for (k in SEG) { if (own(k, SEG)) { segs.push({ path: k, bytes: (SEG[k] && SEG[k].length) || 0 }); n += (SEG[k] && SEG[k].length) || 0; } }
      return { ready: READY, segs: segs.length, bytes: n, segList: segs, miss: MISS.slice(0, 60), err: ERR.slice(0, 20),
        log: LOG.slice(-150), pyodideUrl: !!self.__jlPyodideUrl, factory: (typeof self.__jlCreateModule === "function"),
        lockLen: (typeof self.__jlLockText === "string") ? self.__jlLockText.length : 0 };
    }
    self.__JL_DIAG = diag;
    function toParent(m, tf) { try { if (PORT) PORT.postMessage(m, tf || []); } catch (e) { L("postMessage 失败 " + ((e && e.message) || e)); } }
    function pushDiag(tag) { toParent({ diag: diag(), tag: tag }); }
