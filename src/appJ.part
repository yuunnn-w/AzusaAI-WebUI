  return Promise.all([jlMirrorKvGet(JL_MIRROR_KV_BASE + ws), jlMirrorKvGet(JL_MIRROR_KV_GONE + ws)])
    .then(function (a) {
      if (ws !== JL_LAB_WS) return false;   /* R2 改动 4-B：载入期间绑定已变 ⇒ 丢弃本次结果 */
      JL_MIRROR_BASE = (a[0] && typeof a[0] === "object") ? a[0] : {};
      JL_MIRROR_GONE = (a[1] && typeof a[1] === "object") ? a[1] : {};
      JL_MIRROR_STAT_LOADED = true;
      JL_MIRROR_BASE_WS = ws;
      jlMirrorPub("base", Object.keys(JL_MIRROR_BASE).length + "/" + Object.keys(JL_MIRROR_GONE).length);
      return true;
    });
}
function jlMirrorStateSave() {
  /* R2 改动 4-C：**按归属落键** —— 内存基线属于谁就写回谁的键；归属缺失/与绑定不符 ⇒ 不落盘（防跨 ws 污染） */
  var ws = JL_MIRROR_BASE_WS;
  if (!ws || ws !== JL_LAB_WS) return Promise.resolve(false);
  if (!ws) return Promise.resolve(false);
  return Promise.all([jlMirrorKvPut(JL_MIRROR_KV_BASE + ws, JL_MIRROR_BASE), jlMirrorKvPut(JL_MIRROR_KV_GONE + ws, JL_MIRROR_GONE)])
    .then(function (r) { return !!(r[0] && r[1]); });
}
function jlMirrorBaseSet(p, o) {
  JL_MIRROR_BASE[p] = { size: Number(o.size || 0), m: Number(o.m || 0), csize: Number(o.csize || 0), clm: jlMirrorLmMs(o.clm) };
}
function jlMirrorBaseDel(p) { delete JL_MIRROR_BASE[p]; }
function jlMirrorGoneSet(p, why) { JL_MIRROR_GONE[p] = { at: Date.now(), why: String(why || "") }; }
