/* ---- 基线 / 墓碑（`pyocache`,主页面单写者;§2.5/§2.8/§2.9） ---- */
function jlMirrorKvGet(key) {
  return wsStoreTx(IDB_PYC, "readonly", function (tx) {
    return wsReqP(tx.objectStore(IDB_PYC).get(String(key))).then(function (v) { return { ok: true, rec: v || null }; });
  }).then(function (r) {
