     · 字节来源(⌜勘-七-2.1⌟ 的映射表 = 唯一权威):
         #jupyterlite-assets(载荷段,本页已解码) → #pyodide-assets(宿主页第二资产面,按 basename 取段)
         → miss 即 reject + 可见诊断(禁止静默)
     · core(pyodide.asm.mjs / pyodide.asm.wasm / python_stdlib.zip / pyodide.js)**只在宿主段**:
       载荷侧不得有副本(断言 16);内核的锁用载荷段 jupyterlite-lock.json(产品剪裁锁不含 micropip,
       内核的 initPackageManager 必装它 ⇒ 用产品锁必挂)
     · worker 源码在**运行期**打补丁(不改生成器、不改载荷字节;虚拟源始终由本页 blob 承载)
     · 输出面 = 子文档底部的 #jl-out(§2.6.1 C 的最小轮口径:阶段诊断行 + 判据读数)
  --------------------------------------------------------------------------- */
  var KR = {
    t0: Date.now(), stage: "idle", lines: [], stages: {}, checks: {}, errors: [], msgs: [],
    assets: [], patch: [], workerDiag: [], status: [], conn: [], coreFp: null,
    kernel: null, kernelId: "", payloadPyodide: [], coreNotInPayload: null, hostMeta: null
  };
  window.__JL_KERN = KR;
  var WLASTPORT = null;                       /* 最近一个内核 worker 的专用通道(诊断现取用) */
  var WBOOT = null, WBOOT_ERR = "";
  var PYCORE = { asm: null, err: "", promise: null };   /* 宿主段的 asm 工厂文本(boot 子集之一) */
  var PYSEC = {};                             /* 宿主段缓存:段 id(basename) → Uint8Array */
  var WORKER_RE = /\/static\/(?:comlink|coincident)\.worker\.[0-9a-f]+\.js$/;   /* 诊断:哪些段是内核 worker */
  var PYFRAME = null;                         /* #pyodide-assets 帧走读缓存 */
  var WPATCH = {};                            /* worker 源码改造缓存:段 id → {src,hits,...} */
  var PRELUDE_SRC = null, PRELUDE_ERR = "";
  var JL_CORE_NAMES = ["pyodide.asm.mjs", "pyodide.asm.wasm", "python_stdlib.zip", "pyodide.js"];
  /* 子文档 realm 的段正文取用:本函数体最终经 jlChildMain.toString() 送进子文档执行,
     那边**没有**宿主侧任何函数(jlSectionText 只存在于主页面 realm)⇒ 段表一律从本函数体内
     自己的 TEXT 取(主流程开头已按 id 全量解码)。误用宿主函数会抛 ReferenceError
     (实测 r4:S2.startNew: jlSectionText is not defined) */
  function jlPayText(id) { return (typeof TEXT[id] === "string") ? TEXT[id] : null; }

  function krRec(k, v) { KR.stages[k] = { at: Date.now() - KR.t0, v: String(v) }; }
  function krFail(k, e) {
    var m = (e && (e.message || String(e))) || String(e);
    KR.errors.push(k + ": " + m);
    krRec(k + ".FAIL", m);
    jlOut("[失败] " + k + ":" + m);
    return m;
  }
  /* 子文档可见的输出面(§2.6.1 C:本轮渲染进我们自己的 <pre id="jl-out"> + 阶段诊断行)
     E11①：高度收敛为两行（12px/1.55 ⇒ 行高 18.6px，2 行 37.2px + 上下 padding 16px ≈ 54px 含盒），
     超出滚动（overflow:auto 原样）；追加后跟尾滚动 ⇒ 两行窗口里看到的是**最新**一行，不是 [+0ms] 开头 */
  function jlOutEl() {
    var pre = document.getElementById("jl-out");
    if (!pre) {
      pre = document.createElement("pre");
      pre.id = "jl-out";
      pre.setAttribute("style", "position:fixed;left:0;right:0;bottom:0;margin:0;max-height:54px;overflow:auto;"
        + "box-sizing:border-box;padding:8px 10px;font:12px/1.55 ui-monospace,Consolas,monospace;white-space:pre-wrap;"
        + "background:rgba(252,252,252,.97);color:#222;border-top:1px solid #ddd;z-index:2147483645");
      (document.body || document.documentElement).appendChild(pre);
    }
    return pre;
  }
  function jlOut(line) {
    var s = "[+" + (Date.now() - KR.t0) + "ms] " + line;
    KR.lines.push(s);
    try {
      var pre = jlOutEl();
      pre.textContent += s + "\n";
      pre.scrollTop = pre.scrollHeight;
    } catch (e) {}
  }
  function jlRace(p, ms, tag) {
    return new Promise(function (res, rej) {
      var done = false;
      var t = setTimeout(function () { if (!done) { done = true; rej(new Error(tag + " 超时 " + ms + " ms")); } }, ms);
      Promise.resolve(p).then(function (v) {
        if (!done) { done = true; clearTimeout(t); res(v); }
      }, function (e) {
        if (!done) { done = true; clearTimeout(t); rej(e); }
      });
    });
  }
  function jlPoll(fn, ms, every) {
    return new Promise(function (res, rej) {
      var t0 = Date.now();
      (function loop() {
        var v = null;
        try { v = fn(); } catch (e) { return rej(e); }
        if (v) return res(v);
        if (Date.now() - t0 > ms) return rej(new Error("poll 超时 " + ms + "ms"));
        setTimeout(loop, every || 250);
      })();
    });
