        catch (e) { ERR.push("boot 装载失败: " + ((e && e.message) || e)); pushDiag("boot-fail"); }
      }
    });
    setTimeout(function () { pushDiag("t5s"); }, 5000);
    setTimeout(function () { pushDiag("t30s"); }, 30000);
    setTimeout(function () { pushDiag("t120s"); }, 120000);
  }
  /* 宿主段 asm 工厂的**预取**(幂等):boot 子集要求它同步可得(Worker 构造时即投递) */
  function jlCorePrefetch() {
    if (PYCORE.promise) return PYCORE.promise;
    PYCORE.promise = (async function () {
      var fr = pyHostFrame();
      if (!fr.ok) { PYCORE.err = fr.reason; return null; }
      var b = await pyHostBytes("pyodide.asm.mjs");
      if (!b) { PYCORE.err = PYCORE.err || "宿主段 pyodide.asm.mjs 取不到"; return null; }
      PYCORE.asm = b;
      var fp = await jlFingerprint(b);
      KR.coreFp = { name: "pyodide.asm.mjs", bytes: b.length, alg: fp.alg, hex: fp.hex, source: "pyodide-assets" };
      KR.assets.push({ path: "pyodide/pyodide.asm.mjs", name: "pyodide.asm.mjs", source: "pyodide-assets",
        bytes: b.length, alg: fp.alg, hash: fp.hex, at: Date.now() - KR.t0, via: "boot" });
      devlog("core asm " + b.length + " B ← #" + PY_ID + " piplock=" + (PYCORE.err ? "err" : "ok"));
      return b;
    })();
    return PYCORE.promise;
  }
  /* boot 子集:内核装载的**竞态关键三件**(pyodide.mjs / asm 工厂 / 内核专用锁)。
     其余字节(asm.wasm、stdlib、闭包与其它 wheel、站点 pypi 件)按需经 relay 取 —— 不重复打包、
     也不在开页时就把十几 MB 解到内存 */
  function jlWorkerBoot() {
    if (WBOOT || WBOOT_ERR) return WBOOT;
    var mjs = SEG["pyodide/pyodide.mjs"];
    var lock = jlPayText("jupyterlite-lock.json");
    if (!mjs) { WBOOT_ERR = "载荷里没有 pyodide/pyodide.mjs 段"; return null; }
    if (lock === null) { WBOOT_ERR = "载荷里没有 jupyterlite-lock.json 段(内核专用锁)"; return null; }
    if (!PYCORE.asm) { WBOOT_ERR = PYCORE.err || "宿主载荷里没有 pyodide.asm.mjs 段(#pyodide-assets 缺失)"; return null; }
    WBOOT = {};
    WBOOT["pyodide/pyodide.mjs"] = mjs;
    WBOOT["pyodide/pyodide.asm.mjs"] = PYCORE.asm;
    WBOOT["pyodide/pyodide-lock.json"] = new TextEncoder().encode(lock);
    KR.stages["boot.subset"] = { at: Date.now() - KR.t0, v: "pyodide.mjs " + mjs.length + " B + asm " + PYCORE.asm.length + " B + 锁 " + lock.length + " 字符" };
    return WBOOT;
  }
  /* P3b:worker 文本改造(锚点计数断言;漂移即记录 + 可见横幅,不静默) */
  function jlWorkerPatch(path, src) {
    if (WPATCH[path]) return WPATCH[path];
    var out = src, hits = 0, probs = [];
    function rep(needle, to, label, want) {
      var n = out.split(needle).length - 1;
      if (n !== want) probs.push(label + " 命中 " + n + " 处(期望 " + want + ")");
      if (n > 0) { out = out.split(needle).join(to); hits += n; }
    }
    /* ① 动态 import 的目标钉到 worker 内自建的 blob URL(虚拟源不可解析 ⇒ 不去网络) */
    rep("Function(\"url\",\"return import(url)\")", "Function(\"url\",\"return import(self.__jlPyodideUrl||url)\")", "P3b.import", 1);
    /* ② loadPyodide 注入 asm 工厂与内核专用锁(站点配置里没有这两项) */
    rep("...e.loadPyodideOptions}", "...e.loadPyodideOptions,createPyodideModule:self.__jlCreateModule,lockFileContents:self.__jlLockText}", "P3b.loadPyodideOptions", 1);
    /* ③ 摘掉安装清单里的 `jedi`。⚠ 子批 B(jedi 根治,2026-09-18)起本档**已在册**:
       `jedi 0.19.2 + parso 0.8.6` 由**生成期预装**(`scripts/make-jupyterlite-part.js` 的
       `KERNEL_EXTRA_PACKAGES` 注入 `loadPyodideOptions.packages`,并进载荷段 / 专用锁 / 合并索引)
       ⇒ 上游 worker 的 `t.includes('jedi')` 已为真、`piplite.install('jedi')` 本就不会执行
       ⇒ 本摘除**成为冗余保险**(行为等价)。保留它只为 ① 预装面若回退仍挡住那条会让 `initialize()`
       整链 reject 的 install ② 继续充当 `JN` 上游文本漂移哨(锚点消失即 `probs` FAIL)。
       —— 历史成因(留档,写作时的事实):Phase 3 时本档在册集不含 jedi(实证:当时
       `src/jupyterlite.part` 全文 0 处 `jedi`,内核专用锁 `jupyterlite-lock.json` 153 条里也没有;
       而 `vendor/pyodide-src/pyodide-lock.json` 里 jedi 存在但**该实现在册集已裁**)。上游 worker 把 `jedi` 硬编码进
       `["ipykernel","comm","pyodide-kernel","jedi","ipython"]`,且 piplite 的 `keep_going=True`
       **并不会**吞掉 micropip 抛出的 `ValueError`(实测 traceback 见 Phase 3 接手批 3 报告:
       `piplite/piplite.py:133 _install` → `micropip/package_manager.py:208`
       `ValueError: Can't find a pure Python 3 wheel for: 'jedi'`)⇒ 第 4 句 install 直接抛
       ⇒ `initialize()` 整链 reject(被 comlink 包成 `HANDLER/throw` 回执,页面上无任何可见报错)
       ⇒ 内核永不 `ready` ⇒ `kernel_info` 300 s 超时。
       摘除的安全性:IPython 对 jedi 缺失有**原生降级**(jedi 只在补全路径上惰性 import,
       `pyodide_kernel/interpreter.py` 里那句 `Completer.use_jedi = True` 只影响补全,不影响内核
       启动与执行);`pyodide_kernel`/`ipykernel` 两个轮子全文再无 jedi 引用。
       ⚠ 本条**不计入 `hits`**(hits 仍是"两个语义注入点"),但走**同一 `probs` 漂移守卫**
       ⇒ 锚点消失时 `K6.worker-patch` 照样 FAIL。 */
    var JN = "\"comm\",\"pyodide-kernel\",\"jedi\",\"ipython\"";
    var jHits = out.split(JN).length - 1;
    if (jHits !== 1) probs.push("P3b.no-jedi 锚点命中 " + jHits + " 处(期望 1 处;上游漂移?)");
    if (jHits > 0) {
      out = out.split(JN).join("\"comm\",\"pyodide-kernel\",\"ipython\"");
      KR.stages["W.no-jedi"] = { at: Date.now() - KR.t0, v: "摘除 jedi 安装项(" + jHits + " 处;子批 B 起已由生成期预装 ⇒ 本摘除为冗余保险)" };
      devlog("worker 适配:摘除 jedi 安装项 " + jHits + " 处(" + path + ")");
    }
    var prelude = jlKernelPreludeSrc();
    if (PRELUDE_ERR) probs.push(PRELUDE_ERR);
    var res = { src: prelude + out, hits: hits, jediFix: jHits, probs: probs, preludeBytes: prelude.length, srcBytes: out.length };
    WPATCH[path] = res;
    KR.patch.push({ path: path, hits: hits, jediFix: jHits, probs: probs, preludeBytes: prelude.length, bundleBytes: out.length });
    if (probs.length) {
      DIAG.err.push("worker 改造点异常(" + path + "):" + probs.join(";"));
      banner("Python 内核 worker 的改造点与预期不符(上游版本漂移?):" + probs.join(";"));
    }
    return res;
  }
  /* ---- 直连内核通道(§2.6.1 A–D):句柄 → 启动 → 执行 → 输出 ---- */
  function jlKernelOnStatus(cb) {
    var k = KR.kernel;
    if (!k || !k.statusChanged) return false;
    try {
      k.statusChanged.connect(function (_, s) {
        KR.status.push(String(s) + "@" + (Date.now() - KR.t0));
        if (cb) cb(s);
      });
      return true;
    } catch (e) { return false; }
  }
  async function jlKernelStart(app, name) {
    var sm = app.serviceManager, want = name || JL_DEFAULT_KERNEL, specs = null, k = null;
    if (cfg && cfg.defaultKernelName) want = String(cfg.defaultKernelName);     /* 一律读配置,不硬编码 */
    /* ⌜就绪链⌟规格管理器是**异步**的:`kernelspecs.specs` 在静态清单回落前是空壳
       (`{default:"", kernelspecs:{}}`,实测 r2:内核启动时读到空壳、同一页数分钟后读到完整
       `python → "Python (Pyodide)"`)⇒ 这里**必须先等就绪再判定**,否则会把"还没加载好"
       误判成"规格缺失"并 fail-fast(真机上表现为"Python 内核不可用",属误报)。
       口径 = §2.6.1 A 的就绪链(app.restored → serviceManager 各子管理器 ready)。 */
    try { await jlRace(Promise.resolve(sm.kernelspecs.ready), JL_KERNEL_CONNECT_MS, "S1.kernelspecsReady"); }
    catch (e) { krRec("S1.kernelspecsReady", "超时/失败:" + ((e && e.message) || e)); }
    /* `ready` 会以**空壳**先落定(实测 r2:落定时 `{default:"",kernelspecs:{}}`,同页数分钟后才是
       完整的 `python → "Python (Pyodide)"`)⇒ 再主动 refresh 一次并轮询到 JL_KERNEL_SPEC_MS 上限;
       命中时刻落 `S1.kernelspecsAt`(供定位"首次装载要多久") */
    try {
      var rp = sm.kernelspecs.refreshSpecs();
      if (rp && typeof rp.then === "function") rp.then(null, function (e) { krRec("S1.kernelspecsRefresh", "失败:" + ((e && e.message) || e)); });
    } catch (e3) { krRec("S1.kernelspecsRefresh", "异常:" + ((e3 && e3.message) || e3)); }
    try {
      specs = await jlPoll(function () {
        var s = sm.kernelspecs.specs;
        return (s && s.kernelspecs && s.kernelspecs[want]) ? s : null;
      }, JL_KERNEL_SPEC_MS, 500);
      krRec("S1.kernelspecsAt", (Date.now() - KR.t0) + " ms(内核启动起算)");
    } catch (e) {
      try { specs = sm.kernelspecs.specs; } catch (e2) { specs = null; }
      krRec("S1.kernelspecsPoll", "轮询未命中(" + JL_KERNEL_SPEC_MS + " ms):" + ((e && e.message) || e));
    }
    krRec("S1.kernelspecs", JSON.stringify({ def: specs && specs.default, names: (specs && specs.kernelspecs) ? Object.keys(specs.kernelspecs) : null }));
    /* 失败面①:spec 缺失(显式 throw,不静默) */
    if (!specs || !specs.kernelspecs || !specs.kernelspecs[want]) {
      var m = "内核规格缺失 " + want;
      window.__JL_KERN_ERR = m;
      krFail("S2.spec", m);
      banner("Python 内核不可用:" + m);
      return null;
    }
    /* 失败面②:startNew reject(如 `No factory for kernel <name>`) */
    try {
      k = await jlRace(sm.kernels.startNew({ name: want }), JL_KERNEL_CONNECT_MS * 2, "S2.startNew");
    } catch (e) {
      krFail("S2.startNew", e);
      window.__JL_KERN_ERR = String((e && e.message) || e);
      banner("Python 内核启动失败:" + window.__JL_KERN_ERR);
      return null;
    }
    KR.kernel = k;
    KR.kernelId = k.id;
    krRec("S2.startNew", JSON.stringify({ id: k.id, name: k.name }));
    jlKernelOnStatus(null);
    try {
      if (k.connectionStatusChanged) k.connectionStatusChanged.connect(function (_, s) { KR.conn.push(String(s) + "@" + (Date.now() - KR.t0)); });
    } catch (e) {}
    /* 失败面③:startNew 成功但通道/内核未就绪 */
    try { await jlPoll(function () { return k.connectionStatus === "connected"; }, JL_KERNEL_CONNECT_MS, 200); }
    catch (e) { krFail("S2.connection", e); }
    krRec("S2.connection", String(k.connectionStatus));
    try {
      var info = await jlRace(k.info, JL_KERNEL_READY_MS, "S2.kernel_info");
      var c = (info && info.content) ? info.content : info;      /* 防御式双取法(Q2) */
      krRec("S2.kernel_info", JSON.stringify({ status: c && c.status, protocol: c && c.protocol_version }));
      if (!c || c.status !== "ok") krFail("S2.kernel_info.status", String(c && c.status));
    } catch (e) {
      krFail("S2.kernel_info", e);
      window.__JL_KERN_ERR = String((e && e.message) || e);
      banner("Python 内核未能就绪(worker 侧诊断见下方输出面):" + window.__JL_KERN_ERR);
      return null;
    }
    krRec("S2.status", KR.status.join(","));
    return k;
  }
  /* 消息解析表(§2.6.1 C):结构化判读 msg.header.msg_type + msg.content,不用字符串匹配 */
  function jlKernelCollect(msg, io) {
    var t = msg && msg.header && msg.header.msg_type;
    var c = (msg && msg.content) || {};
    if (t === "stream") {
      io.streams[String(c.name || "stdout")] += String(c.text || "");
    } else if (t === "execute_result") {
      io.result = String((c.data || {})["text/plain"]);
      io.execution_count = c.execution_count;
    } else if (t === "display_data" || t === "update_display_data") {
      io.display.push(String((c.data || {})["text/plain"]));
    } else if (t === "error") {
      io.errors.push({ ename: String(c.ename || ""), evalue: String(c.evalue || ""), traceback: (c.traceback || []).slice(0, 5) });
    } else if (t === "status") {
      io.states.push(String(c.execution_state || ""));
    }
    io.msgs.push({ type: String(t), at: Date.now() - KR.t0 });
    KR.msgs.push({ type: String(t), at: Date.now() - KR.t0 });
  }
  /* 执行:请求 → iopub/onReply 收集 → execute_reply。
     首次执行内含内核装载(pyodide + 依赖闭包),预算取 JL_KERNEL_READY_MS;其后取 JL_EXEC_TIMEOUT_MS */
  async function jlKernelExec(code, opts) {
    var k = KR.kernel;
    if (!k) throw new Error("内核尚未启动");
    var o = opts || {};
    KR.execCount = (KR.execCount || 0) + 1;
    var budget = o.budgetMs || (KR.execCount === 1 ? JL_KERNEL_READY_MS : JL_EXEC_TIMEOUT_MS);
    var io = { msgs: [], streams: { stdout: "", stderr: "" }, states: [], display: [],
      result: null, errors: [], reply: null };
    var fut = k.requestExecute({
      code: String(code), silent: false, store_history: true, user_expressions: {},
      allow_stdin: false, stop_on_error: true
    }, true);
    var h = function (m) { jlKernelCollect(m, io); };
    /* onIOPub / onReply 是"可赋值属性";升级守门写法:是 Signal 就连,否则赋值 */
    if (fut.onIOPub && typeof fut.onIOPub.connect === "function") fut.onIOPub.connect(function (_, m) { h(m); });
    else fut.onIOPub = h;
    if (fut.onReply && typeof fut.onReply.connect === "function") fut.onReply.connect(function (_, m) { io.reply = m; });
    else fut.onReply = function (m) { io.reply = m; };
    var t0 = Date.now();
    var doneReply = await jlRace(fut.done, budget, "S3.done(#" + KR.execCount + ")");
    /* onReply 与 done 是同一条 reply 的两个来源 ⇒ 任一可用即可(不同版本里 onReply 可能是 Signal) */
    var rc = (io.reply && io.reply.content) || (doneReply && doneReply.content) || {};
    io.doneType = (doneReply && doneReply.header) ? String(doneReply.header.msg_type) : "";
    io.status = String(rc.status || "");
    io.execution_count = rc.execution_count;
    io.ms = Date.now() - t0;
    return io;
  }
  /* 释放(D-2 改准判据:isDisposed ∧ disconnected;running() 只作诊断,照抄留盘不参与判分) */
  function jlKernelRunningIds(sm) {
    var a = [];
    try {
      var it = sm.kernels.running(), n = it.next();
      while (!n.done) { a.push(n.value.id); n = it.next(); }
    } catch (e) {}
    return a;
  }
  async function jlKernelShutdown() {
    var k = KR.kernel;
    if (!k) return { ok: false, reason: "没有内核句柄" };
    var sm = (KR.app && KR.app.serviceManager) || null;
    var rec = { before: sm ? jlKernelRunningIds(sm) : null, pre: null, after: null, isDisposed: null, conn: null, err: null };
    /* 同轮负例(勘-七-1.4 ④):释放**前**先断言两项非恒真 */
    try { rec.pre = { isDisposed: k.isDisposed === true, conn: String(k.connectionStatus) }; } catch (e) { rec.pre = { err: String((e && e.message) || e) }; }
    try { await jlRace(k.shutdown(), 60000, "S4.shutdown"); } catch (e) { rec.err = String((e && e.message) || e); }
    try { rec.isDisposed = k.isDisposed === true; } catch (e) { rec.isDisposed = "?(" + ((e && e.message) || e) + ")"; }
    try { rec.conn = String(k.connectionStatus); } catch (e) { rec.conn = "?(" + ((e && e.message) || e) + ")"; }
    if (sm) rec.after = jlKernelRunningIds(sm);
    rec.ok = (rec.isDisposed === true) && (rec.conn === "disconnected");
    KR.release = rec;
    jlOut("[释放] isDisposed=" + rec.isDisposed + " connectionStatus=" + rec.conn
      + " running()(诊断)before=" + JSON.stringify(rec.before) + " after=" + JSON.stringify(rec.after)
      + " ⇒ " + (rec.ok ? "PASS" : "FAIL"));
    return rec;
  }
  /* 内核启动 + 自检(A6/A3 判据读数):不阻塞应用就绪链(§2.6.1 E:应用就绪与内核就绪是两件事) */
  async function jlKernelBoot(app) {
    KR.app = app;
    KR.stage = "kernel";
    jlOut("[内核] 启动:defaultKernelName=" + String((cfg && cfg.defaultKernelName) || JL_DEFAULT_KERNEL));
    var k = await jlKernelStart(app, null);
    if (!k) { KR.stage = "kernel-fail"; return; }
    jlOut("[内核] ready(id=" + KR.kernelId + " · connectionStatus=" + k.connectionStatus + " · statusSeen=" + KR.status.join(",") + ")");
    KR.stage = "exec";
    /* ① 判据源:$1+1$ ⇒ execute_result.data['text/plain'] == "2" */
    try {
      var r1 = await jlKernelExec("1+1", {});
      KR.checks.add = { ok: (r1.status === "ok" && r1.result === "2"), value: r1.result, status: r1.status,
        execution_count: r1.execution_count, ms: r1.ms, iopub: r1.msgs.map(function (x) { return x.type; }) };
      jlOut("[自检] 1+1 ⇒ execute_result=" + JSON.stringify(r1.result) + " · reply.status=" + r1.status
        + " · count=" + r1.execution_count + " · " + r1.ms + " ms ⇒ " + (KR.checks.add.ok ? "PASS" : "FAIL"));
    } catch (e) { KR.checks.add = { ok: false }; krFail("S3.1+1", e); }
    /* ② 内核/库共用(A6):sys.version + numpy(全档在册包);本档无该件时**如实标注跳过** */
    var lockObj = null, npPath = null;
    try { lockObj = JSON.parse(jlPayText("jupyterlite-lock.json")); } catch (e) { lockObj = null; }
    if (lockObj && lockObj.packages && lockObj.packages.numpy) npPath = "pyodide/" + lockObj.packages.numpy.file_name;
    if (!npPath || !jlKernLookup(npPath)) {
      KR.checks.lib = { ok: false, skipped: true, reason: "本档载荷不含 numpy(" + String(npPath) + ")——该档在册包集限制" };
      jlOut("[自检] import numpy:本档载荷不含该件 ⇒ 跳过(属该档在册包集限制,不是缺陷)");
    } else {
      try {
        /* ⌜接手批 3⌟ Python 侧的包加载入口是 `pyodide_js.loadPackage`(返回 JS Promise,可 await);
           原先写的 `await pyodide.loadPackage("numpy")` 是**错误的 API**(实测 r10:
           `AttributeError: module 'pyodide' has no attribute 'loadPackage'`)⇒ 该句一抛,后面的
           `import numpy` 与三行 print 全部不执行 ⇒ 本判据恒 FAIL。此处改准(与 pyodide_kernel 自己
           `from pyodide_js import loadPackagesFromImports` 同一入口)。 */
        var r2 = await jlKernelExec("import sys\nfrom pyodide_js import loadPackage\nawait loadPackage(\"numpy\")\n"
          + "import numpy\nprint(\"PYVER=\" + sys.version.split()[0])\nprint(\"NUMPY=\" + numpy.__version__)\n"
          + "print(\"SYSVER=\" + sys.version)", {});
        var out = r2.streams.stdout || "";
        var mv = /PYVER=([^\s]+)/.exec(out), mn = /NUMPY=([^\s]+)/.exec(out), ms2 = /SYSVER=(.+)/.exec(out);
        var hostPy = (KR.hostMeta && KR.hostMeta.python) ? String(KR.hostMeta.python) : "";
        KR.checks.lib = { ok: (r2.status === "ok" && !!mv && !!mn), python: mv ? mv[1] : null, numpy: mn ? mn[1] : null,
          sysVersion: ms2 ? ms2[1] : null, hostPython: hostPy, versionMatch: !!(mv && hostPy && mv[1] === hostPy),
          status: r2.status, ms: r2.ms, stderr: r2.streams.stderr, errors: r2.errors };
        jlOut("[自检] sys.version=" + String(KR.checks.lib.python) + "(宿主载荷声明 " + hostPy + ") · numpy="
          + String(KR.checks.lib.numpy) + " ⇒ " + (KR.checks.lib.ok ? "PASS" : "FAIL"));
      } catch (e) { KR.checks.lib = { ok: false }; krFail("S3.lib", e); }
    }
    /* ③ 载荷复用证据:载荷侧 pyodide/* 段清单 + core 不得出现在载荷里(断言 16) */
    var names = [], p;
    for (p in SEG) { if (Object.prototype.hasOwnProperty.call(SEG, p) && /^pyodide\//.test(p) && !WPATCH[p]) names.push(p); }
    KR.payloadPyodide = names.sort();
    KR.coreNotInPayload = !names.some(function (x) { return JL_CORE_NAMES.indexOf(x.slice(x.lastIndexOf("/") + 1)) >= 0; });
    jlOut("[共用] 载荷侧 pyodide/* 段 " + names.length + " 个;core 不入载荷 = " + KR.coreNotInPayload
      + ";按需取件 " + KR.assets.length + " 件(宿主段/载荷段,见 __JL_KERN.assets)");
    KR.stage = "done";
  }
  /* 本批验收的读数/驱动面(与 __JL_READY 同类的子文档侧诊断;Phase 6 复核是否保留) */
  window.__JL_KERN_ACT = {
    exec: function (code, opts) { return jlKernelExec(code, opts || {}); },
    stop: function () { return jlKernelShutdown(); },
    diag: function () {
      var w = window.__JL_LAST_WORKER, k = {}, q;
      /* kr 的**可序列化投影**:KR.app(Application 实例)与 KR.kernel(IKernelConnection)是活句柄、
         含循环引用 ⇒ 直接 JSON.stringify 会抛("Converting circular structure to JSON"),
         整个读数面变成不可读。读数只需要状态与记录,不需要句柄本身 */
      for (q in KR) {
        if (Object.prototype.hasOwnProperty.call(KR, q) && q !== "app" && q !== "kernel") k[q] = KR[q];
      }
      k.hasApp = !!KR.app;
      k.hasKernel = !!KR.kernel;
      return {
        kr: k, assets: KR.assets, patch: KR.patch, workerPath: window.__JL_LAST_WORKER_PATH || null,
        workerDiag: KR.workerDiag, hostMeta: KR.hostMeta, payloadPyodide: KR.payloadPyodide,
        coreNotInPayload: KR.coreNotInPayload, release: KR.release || null,
        appReady: window.__JL_APP_READY === true, boot: window.__JL_READY === true,
        workerAlive: !!(w && typeof w.postMessage === "function")
      };
    },
    /* 现取一次 worker 侧诊断(经专用通道,不经 comlink 主端口);响应异步,读数落 KR.workerDiag */
    workerDiag: function () {
      if (WLASTPORT) { try { WLASTPORT.postMessage({ diagq: 1 }); } catch (e) {} }
      return KR.workerDiag.length ? KR.workerDiag[KR.workerDiag.length - 1] : null;
    }
  };


  /* ---------------------------------------------------------------------------
     27.8 JL 同步（需求 6 · B2-a：① 能力探测降级 + ② Contents → 内核 MEMFS 注入）
     · 设计权威 = shared/specs/jupyterlite-b2-sync-plan.md **v6**（§3.2 挂点与返回契约 /
       §3.3 链序与①的降级 / §4.2 上限 / §4.3 API 与 __JL_SYNC_STAT 字段全集 /
       §4.4 C-9 世代 nonce 与 boot 门槛 / §4.5 Python 引导）
     · 本批做链上的 ①②；③（用户单元格）**永不由我们改**；④（jlSyncOut/回收）与 ⑤
       （filebrowser:refresh）属 B2-b / Phase 4
     · ① 的能力探测：P2-4 定案（decisions/jupyterlite-p2-4-adoption-2026-09-17.md）
       = 推送统一由主页面执行 ⇒ 子文档侧**没有可 await 的写队列** ⇒
       `window.jlBridgePush` 不存在 ⇒ ① **恒走 degraded 分支**（预期形态,不是缺陷）
     · ② 的 boot 门槛（§4.4 · R6-P2-3/R7-P3-1）：可下发充要条件 =
       `conn.__jlBootSeen >= 1 ∧ conn.__jlNonce !== null`；其否定 ⇒ 不下发载荷 +
       按"不完整"处置（degraded + 本边界不判任何删除 + 下一边界全量）
     · 本批**不判任何删除**（C-5/C-6 属 B2-b）⇒ `apply.del[]` 恒空、`apply` 的 del 分支
       本批无判据（已在报告里点名）
     · 零新增跨文档 API / 零新增 IDB 区 / 零新增 localStorage 键（§4.3 D-5）；
       内核侧写入只经 `sm.contents`（本批只**读** Contents）
  --------------------------------------------------------------------------- */
  /* ---- 常量（口径 = §4.2 表；本批实际用到 in 方向四个 + 门槛/预算） ---- */
  var JL_SYNC_ROOT_FALLBACK = "/home/pyodide";
  var JL_SYNC_SENTINEL = "__AZUSA_SYNC__";
  var JL_SYNC_BOOT_SENTINEL = "__AZUSA_SYNC_BOOT__";
  var JL_SYNC_MAX_BYTES_IN = 16 * 1024 * 1024;
  var JL_SYNC_MAX_BYTES_OUT = 16 * 1024 * 1024;
  var JL_SYNC_MAX_FILES = 2000;
  var JL_SYNC_MAX_ENTRIES = 2000;
  var JL_SYNC_MAX_DEPTH = 8;
  var JL_SYNC_RELEASE_MS = 5000;
  var JL_SYNC_STREAM_CHUNK = 512 * 1024;
  /* §4.2 表末注（v3 收口 · 探针①已证「Console 面会渲染」）⇒ **16 MiB → 1 MiB（≈2 片）**。
     命中即判"本次同步不完整"：本边界不回写 + degraded + 状态行 + `ioTruncated++` +
     下一边界全量 + **本轮不判任何删除**（§4.2 / R-19）。 */
  var JL_SYNC_IO_TOTAL = 1 * 1024 * 1024;
  var JL_SYNC_PUSH_WAIT_MS = 2000;
  var JL_SYNC_ECHO_STOP_ROUNDS = 2;
  var JL_SYNC_ATTACH_TICK_MS = 1500;
  var JL_SYNC_ATTACH_TICK_MAX = 8;
  /* 链首看门狗窗口（裁定 1 · (b)，见 decisions/jupyterlite-b2-a-closeout-rulings-2026-09-17.md）：
     队列里"尚未派发"的请求的等待上限。取 2× `JL_KERNEL_SPEC_MS`(90000) ⇒ boot 期
     （kernelspec 就绪门 + 首个隐藏 exec）**永不误触发**；我方常态读数 = `applyMs` 10–13 ms /
     `chain.maxWaitMs` 67–99 ms。**只结清尚未派发的**，正在跑的链首不受影响（单链串行不破）。 */
  var JL_SYNC_CHAIN_WAIT_MS = 120000;
  /* 看门狗计时的**采样粒度**（修正案 1 / P1-1）：窗口只累计"内核空闲"时段 ⇒ 须周期采样再判窗。
     500 ms 相对 120000 ms = 0.4% 粒度（判据抖动容差 4000 ms ≫ 一格）。 */
  var JL_SYNC_WATCHDOG_TICK_MS = 500;
  /* busy 型挂死的**可见等待**阈值（准入 ④ · 可选 warn）：内核 `busy` 期间排队格**不结清**
     （看门狗只累计空闲时段）⇒ 静默等待；本阈值把它变成 `warn` 级状态行（**不置 degraded**、
     不改任何不变量）。 */
  var JL_SYNC_BUSY_NOTE_MS = 5000;
  /* E-3 的段名 / 后缀 denylist（§4.2 表；**只拦内核侧新生成** —— 「Contents 已存在优先」由
     宿主的 `known` 白名单在本文件的 `__azusa_sync_scan` 生成物里落地）。 */
  var JL_SYNC_DENY_SEGS = ["site-packages", "dist-packages", "__pycache__", "node_modules",
    ".git", ".ipython", ".cache", ".local", ".jupyter", ".config", ".azusa-sync"];
  var JL_SYNC_DENY_EXTS = [".pyc", ".so", ".wasm"];

  /* ---- 状态（`__JL_SYNC_STAT` 的字段全集 = §4.3 单点定义,别处只引用不重列） ---- */
  var JLS_DEGRADED = false;
  var JLS_ATTACHED = false, JLS_ATTACH_INFO = null, JLS_ATTACH_TICKS = 0, JLS_WRAPPED_ANY = false;
  var JLS_BOOT_ERR = "";
  var JLS_APP = null;       /* 挂点/② 都要 serviceManager;这里留住 app 句柄 */
  /* 活跃 conn 归并表（**按 kernel id**）：`sm.kernels.connectTo` 每被调用一次就产出一个新的
     `IKernelConnection`（同一 kernel id；B2-a 实测一次 `notebook:create-new` 触发 **3 个**对象），
     其中只有"真正跑单元格的那一个"会被内核应答 ⇒ 被丢弃的重复对象上的
     `connectionStatusChanged = disconnected` **不得驱动 C-9 状态机**
     （B2-a 收口裁定 2 决定 B；否则 `generation.resetCount` 被假信号推高 ⇒ N8b 的
     `resetCount === 0` 断言在本环境不可达）。 */
  var JLS_LIVE = {};
  window.__JL_SYNC_STAT = {
    injected: 0, reclaimed: 0, skippedWrites: 0, skippedPaths: [], truncatedEntries: 0,
    echoQuiet: 0, degraded: false, depthLeak: 0, ioTruncated: 0, ledgerValid: false,
    generation: { bootSeen: 0, resetCount: 0, staleApply: 0, prevNonce: null,
      bootNonce: null, scanNonce: null, mismatch: false, events: [] }
  };
  /* 本批的**读数/驱动面**（与 __JL_KERN_ACT 同族;不属于 §4.3 的字段全集,
     Phase 6 复核是否保留） */
  window.__JL_SYNC_DIAG = { at: Date.now(), notes: [], boundaries: [], bootRuns: [],
    attach: null, installDirs: null, resets: [],
    /* 链上排队读数（§3.2「Run All 排队」的可见面 + 放大效应的机械读数）：
       `releases[]` = 每个请求从入队到被放行的等待；`aborted` = 强制结清（aborted）计数；
       `watchdog` = 其中由链首看门狗结清的条数（`releases[]` 的那一条带 `via:"watchdog"`） */
    releases: [], chain: { aborted: 0, maxWaitMs: 0, watchdog: 0 },
    /* N8b (a) 的**三相命中计数**（准入 ①/②）：只计**通过活跃 conn 闸之后**真正驱动 C-9 的命中
       ⇒ "重置确实没有发生" 由 `resetCount === 0 ∧ staleApply === 0 ∧ 三相各自为 0` 合取证明。
       载体 = 本诊断面（§5.4 N8b 明写：**不新增 `__JL_SYNC_STAT` 字段**，避免字段全集第三次漂移）。 */
    genHits: { disconnected: 0, restarting: 0, nonceMismatch: 0, redundant: 0, staleApply: 0 },
    /* 诊断**注入面**（准入 ⑨：给"分片不齐"与"回声环硬熔断"各配真机臂 —— 两处本属"读码级"，
       配臂后才达 [E13] 已验证）。`dropChunk` = 命中该路径时令分片拼接失败；
       `echoQuiet` = 命中该路径时令回声熔断立即返回 false。**仅诊断用**，不是产品运行期开关；
       与 `__JL_SYNC_FORCE_OFF` 同族（各自独立成文）。 */
    inject: { dropChunk: null, echoQuiet: null },
    busyWaits: [], shadow: { ignoredSignals: [] } };

  function jlSyncSt() { return window.__JL_SYNC_STAT; }
  function jlSyncSm() { var a = JLS_APP || KR.app || null; return (a && a.serviceManager) || null; }
  function jlSyncDg() { return window.__JL_SYNC_DIAG; }
  function jlSyncForceOff(dir) {
    var o = window.__JL_SYNC_FORCE_OFF;
    if (!o) return false;
    return Number(dir === "out" ? o.out : o.in) === 1;
  }
  /* 活跃 conn 归并（裁定 2 决定 B）：kernel id 是归并键；`conn.id` 就是 kernel id，
     兜底读 `conn.model.id`。**取值不稳时一律返回 `"?"`**（宁可不认活跃，也不误认）。 */
  function jlSyncKid(conn) {
    try {
      var v = conn && (conn.id || (conn.model && conn.model.id));
      return v ? String(v) : "?";
    } catch (e) { return "?"; }
  }
  /* 声明"本 conn 是活跃 conn"（调用点**唯一** = boot 成功那一刻 —— 内核真的应答了 boot，
     这是本环境可得的**最强**活跃证据；被丢弃的重复对象永远不会走到这里）。返回是否活跃。 */
  function jlSyncClaimLive(conn) {
    var k = jlSyncKid(conn), cur = JLS_LIVE[k];
    if (cur && cur !== conn) {
      cur.__jlWrappedLive = false;                     /* 旧对象降级（同 kernel id 上的更新者胜） */
      cur.__jlSupersededAt = Date.now() - KR.t0;
    }
    if (cur !== conn) JLS_LIVE[k] = conn;
    conn.__jlWrappedLive = true;
    return true;
  }
  /* 状态机闸（裁定 2 决定 B）：**只有活跃 conn 的信号**才允许驱动 C-9 的清账。
     未声明活跃的 conn（被丢弃的重复对象 / 从未 boot 成功者）⇒ 一律不认。 */
  function jlSyncConnLive(conn) {
    return !!(conn && conn.__jlWrappedLive === true && JLS_LIVE[jlSyncKid(conn)] === conn);
  }
  /* 状态行（§4.2「永不静默」；`#jl-sync-note` 的挂点由本批补进骨架 ——
     Phase 2 骨架当时未含它,B2-c 只写文本） */
  function jlSyncNote(msg, kind, path) {
    var text = String(msg || "") + (path ? "：" + String(path) : "");
    var kind2 = String(kind || "info");
    var D = jlSyncDg();
    D.notes.push({ at: Date.now() - KR.t0, kind: kind2, msg: text, path: path || null });
    if (D.notes.length > 160) D.notes.shift();
    var el = document.getElementById("jl-sync-note");
    if (!el) {
      el = document.createElement("div");
      el.id = "jl-sync-note";
      el.setAttribute("style", "position:fixed;left:0;right:0;bottom:0;margin:0;padding:3px 8px;"
        + "font:12px/1.5 ui-monospace,Consolas,monospace;white-space:pre-wrap;max-height:42px;overflow-y:auto;box-sizing:border-box;"
        + "background:rgba(24,24,28,.88);color:#eee;z-index:2147483646");
      (document.body || document.documentElement).appendChild(el);
    }
    el.textContent = "JL 同步[" + kind2 + "] " + text;
    el.setAttribute("data-jl-sync-kind", kind2);
    if (kind2 === "degraded" || kind2 === "err") devlog("sync." + kind2 + " " + text);
    return text;
  }
  function jlSyncDegrade(msg) {
    JLS_DEGRADED = true;
    jlSyncSt().degraded = true;
    jlSyncNote(msg, "degraded");
  }

  /* ---- IFuture 的三个回调槽位（**上游形态实测 = 可赋值单处理器，不是 Signal**） ----
     机械依据（本产品内嵌站点 build 里逐字抽取，非推断）：
       · `OutputArea._setFuture`：`n.onIOPub = this._onIOPub, n.onReply = this._onExecuteReply,
         n.onStdin = i => {...}` —— **赋值**（同一处还有 `this._future.dispose()` 与 `n.done.finally(...)`）；
       · `OutputArea.execute`：`let c = d.requestExecute(l, !1, r); return i.future = c, c.done`
         —— 单元格执行拿的**就是本代理的 `done`**；
       · `KernelFutureHandler._handleIOPub`：`let i = await this._hooks.process(n), o = this._iopub;
         if (i && o) await o(n); if (isStatusMsg(n) && "idle" === n.content.execution_state) { … GotIdle … }`
         —— 单处理器 + **单参数**调用，且 `status:idle` 的判定排在 `await o(n)` **之后**。
     ⇒ 若这三个成员被实现成 Signal 对象，`_setFuture` 的赋值会把它**覆盖**，转发器里的
       `f.onIOPub.emit(...)` 立刻 TypeError ⇒ `o(n)` 抛出 ⇒ **`GotIdle` 永不置位** ⇒
       `_handleDone()` 永不调用 ⇒ **真 future 的 `done` 永不 resolve** ⇒ 单元格挂死 + outputs 恒空
       （= P-C2 的失败形状，2026-09-17 实测）。故本槽位**同时**支持两种注册约定：
       `assign(h)`（上游语义：单参数 `h(msg)`，后赋值者替换前者）与 `connect(cb)` / `fn(cb)`
       （Signal 语义：`cb(sender, msg)`，供本批装置与既有读数使用）；投递一律经 `emit`。 */
  function jlSyncSlot() {
    var conns = [];
    var assigned = null;
    var dead = false;
    var fn = function (cb) { fn.connect(cb); return fn; };
    fn.connect = function (cb) { if (!dead && typeof cb === "function") conns.push(cb); return cb; };
    fn.assign = function (cb) { if (!dead) assigned = (typeof cb === "function") ? cb : null; return cb; };
    fn.disconnect = function (cb) { var i = conns.indexOf(cb); if (i >= 0) conns.splice(i, 1); };
    fn.emit = function (sent, m) {
      var s = conns.slice(), i;
      for (i = 0; i < s.length; i++) {
        try { s[i](sent, m); } catch (e) { devlog("sync 回调异常:" + ((e && e.message) || e)); }
      }
      if (assigned) { try { assigned(m); } catch (e2) { devlog("sync 处理器异常:" + ((e2 && e2.message) || e2)); } }
    };
    fn.kill = function () { dead = true; assigned = null; conns.length = 0; };
    fn.slotCount = function () { return conns.length + (assigned ? 1 : 0); };
    return fn;
  }
  /* 真 future 的钩挂（onIOPub/onReply/onStdin 是 Signal;升级守门写法与 jlKernelExec 同款） */
  function jlSyncHook(fut, io) {
    var h = function (m) {
      var t = m && m.header && m.header.msg_type, c = (m && m.content) || {};
      if (t === "stream") { io.streams[String(c.name || "stdout")] += String(c.text || ""); }
      else if (t === "execute_result") { io.result = String((c.data || {})["text/plain"]); }
      else if (t === "error") { io.errors.push({ ename: String(c.ename || ""), evalue: String(c.evalue || "") }); }
      io.msgs.push(String(t));
    };
    if (fut.onIOPub && typeof fut.onIOPub.connect === "function") fut.onIOPub.connect(function (_, m) { h(m); });
    else fut.onIOPub = h;
    if (fut.onReply && typeof fut.onReply.connect === "function") fut.onReply.connect(function (_, m) { io.reply = m; });
    else fut.onReply = function (m) { io.reply = m; };
    return io;
  }
  /* 我们自己的隐藏执行：**绕过**包装（用 __jlSyncOrig）⇒ 不进队列、不递归（§3.2 挂点 3） */
  async function jlSyncHiddenExec(conn, code, opts) {
    var o = opts || {};
    var io = { msgs: [], streams: { stdout: "", stderr: "" }, errors: [], reply: null, result: null };
    var fut = conn.__jlSyncOrig({ code: String(code), silent: false, store_history: false,
      user_expressions: o.user_expressions || {}, allow_stdin: false, stop_on_error: true }, true);
    jlSyncHook(fut, io);
    var d = null;
    try { d = await jlRace(fut.done, o.budgetMs || JL_EXEC_TIMEOUT_MS, "sync.exec"); }
    catch (e) { io.timeout = true; io.errors.push({ ename: "Timeout", evalue: String((e && e.message) || e) }); }
    var rc = (io.reply && io.reply.content) || (d && d.content) || {};
    io.status = String(rc.status || "");
    io.userExpressions = rc.user_expressions || null;
    io.replyPayload = rc.payload || null;
    return io;
  }

  /* ---- 哨兵解析（分片 = 多条 stream 消息,这里按累积文本切分 ⇒ 天然支持跨片拼接） ---- */
  function jlSyncParseOut(text, sentinel) {
    var s = String(text || ""), i = s.lastIndexOf(sentinel);
    if (i < 0) return null;
    var rest = s.slice(i + sentinel.length);
    var nl = rest.indexOf("\n");
    if (nl >= 0) rest = rest.slice(0, nl);
    rest = rest.replace(/^\s+|\s+$/g, "");
    if (!rest) return null;
    try { return JSON.parse(rest); } catch (e) { return null; }
  }
  /* 多记录版（B2-b 的 ④：一次走查发多条带哨兵的行 —— 内容分片 + 元数据）。
     `JSON.stringify`/`json.dumps` 都保证**单行** ⇒ 按哨兵切段、每段取到首个换行即是一条完整记录。
     坏片只丢那一片（不吞掉整批）——但"元数据记录缺失"由调用方判为**不完整**（绝不静默当成功）。 */
  function jlSyncParseAll(text, sentinel) {
    var parts = String(text || "").split(sentinel), out = [], i;
    for (i = 1; i < parts.length; i++) {
      var seg = parts[i], nl = seg.indexOf("\n");
      if (nl >= 0) seg = seg.slice(0, nl);
      seg = seg.replace(/^\s+|\s+$/g, "");
      if (!seg) continue;
      try { out.push(JSON.parse(seg)); } catch (e) { out.push({ __bad: seg.slice(0, 120) }); }
    }
    return out;
  }
  function jlSyncLastMatch(text, re) {
    var m = null, g = new RegExp(re.source, "g"), x;
    while ((x = g.exec(String(text || ""))) !== null) { m = x[1]; if (g.lastIndex <= x.index) break; }
    return m;
  }
  function jlSyncReplyUserExpr(io, name) {
    var r = io && io.userExpressions;
    if (r && Object.prototype.hasOwnProperty.call(r, name)) {
      var v = r[name];
      if (v && typeof v === "object" && v["text/plain"] !== undefined) return String(v["text/plain"]);
      return String(v);
    }
    var pl = (io && io.replyPayload) || [], i;
    for (i = 0; i < pl.length; i++) {
      if (pl[i] && pl[i].source === "user_expressions" && pl[i].data &&
          Object.prototype.hasOwnProperty.call(pl[i].data, name)) {
        var d = pl[i].data[name];
        return (d && typeof d === "object" && d["text/plain"] !== undefined) ? String(d["text/plain"]) : String(d);
      }
    }
    return null;
  }

  /* ---- Python 引导源码（§4.5；nonce 由**内核侧**每次 boot 生成并随该次执行回传） ---- */
  function jlSyncPyStr(s) {
    return "'" + String(s).replace(/\\/g, "\\\\").replace(/'/g, "\\'") + "'";
  }
  function jlSyncBootSrc() {
    var S = JL_SYNC_BOOT_SENTINEL, L = [];
    L.push("import os as _za_os, sysconfig as _za_syscfg, site as _za_site, secrets as _za_secrets, json as _za_json, base64 as _za_b64");
    L.push("_za_nonce = _za_secrets.token_hex(16)");
    L.push("_za_st = {'root': _za_os.getcwd(), 'paths': {}, 'sitepkgs': [], 'osfile': '', 'readback': [], 'ps': [], 'skips': {}}");
    L.push("_za_e = None");
    L.push("try:");
    L.push("    _za_st['paths'] = dict(_za_syscfg.get_paths())");
    L.push("    _za_st['sitepkgs'] = list(_za_site.getsitepackages())");
    L.push("    _za_st['osfile'] = _za_os.path.dirname(_za_os.__file__)");
    L.push("    _za_ps = set()");
    L.push("    for _za_k in ('stdlib', 'platstdlib', 'purelib', 'platlib', 'data'):");
    L.push("        _za_v = _za_st['paths'].get(_za_k)");
    L.push("        if _za_v:");
    L.push("            _za_ps.add(_za_v)");
    L.push("    for _za_v in _za_st['sitepkgs']:");
    L.push("        _za_ps.add(_za_v)");
    L.push("    if _za_st['osfile']:");
    L.push("        _za_ps.add(_za_st['osfile'])");
    L.push("    for _za_p in sorted(_za_ps):");
    L.push("        _za_isd = _za_os.path.isdir(_za_p)");
    L.push("        _za_st['readback'].append({'p': _za_p, 'isdir': _za_isd, 'n': (len(_za_os.listdir(_za_p)) if _za_isd else None)})");
    L.push("    _za_st['ps'] = sorted(_za_ps)");
    L.push("except Exception as _za_e:");
    L.push("    _za_st['err'] = str(_za_e)");
    L.push("print('" + S + "DIRS__' + _za_json.dumps(_za_st, ensure_ascii=False))");
    L.push("");
    L.push("def __azusa_sync_root(_st=_za_st):");
    L.push("    return _st['root']");
    L.push("");
    L.push("def __azusa_sync_nonce(_n=_za_nonce):");
    L.push("    return _n");
    L.push("");
    /* `open()` 提示包装器（§4.5 的**四分支**；B2-c 准入清单外、但属本批 §5.1 的明确范围）——
       纪律照抄 `src/appE.part:7455-7484 __pyShimOpen`：**只在错误分支上追加文案并原样 raise，
       不改任何成功路径语义**；唯一的例外是第 ④ 分支（写模式命中跳过清单）——它**有意**在调用
       原函数**之前**拒绝，否则"先截断 MEMFS 里的不完整副本"就会发生（= P0-1 的失败形状）。 */
    L.push("import builtins as _za_builtins");
    L.push("__azusa_sync_open_orig = _za_builtins.open");
    L.push("__azusa_sync_os = _za_os");
    L.push("def __azusa_sync_rel(_p, _os=_za_os, _st=_za_st):");
    L.push("    _s = str(_p)");
    L.push("    _r = _st['root']");
    L.push("    if _s.startswith('/'):");
    L.push("        if _s == _r or _s.startswith(_r + '/'):");
    L.push("            return _s[len(_r):] or '/'");
    L.push("        return _s");
    L.push("    return '/' + _os.path.normpath(_s).lstrip('/')");
    L.push("def __azusa_sync_skipof(_rel, _st=_za_st):");
    L.push("    _sk = _st.get('skips') or {}");
    L.push("    if _rel in _sk:");
    L.push("        return _sk[_rel]");
    L.push("    for _q, _v in _sk.items():");
    L.push("        if _v.get('prefix') and (_rel == _q or _rel.startswith(_q.rstrip('/') + '/')):");
    L.push("            return _v");
    L.push("    return None");
    L.push("def __azusa_sync_setskips(_lst, _st=_za_st):");
    L.push("    _sk = {}");
    L.push("    for _e in (_lst or []):");
    L.push("        try:");
    L.push("            _p = str(_e.get('path') or '')");
    L.push("            if _p:");
    L.push("                _sk[_p] = {'why': str(_e.get('why') or ''), 'prefix': bool(_e.get('prefix'))}");
    L.push("        except Exception:");
    L.push("            continue");
    L.push("    _st['skips'] = _sk");
    L.push("    return len(_sk)");
    L.push("def __azusa_sync_open(*_a, **_kw):");
    L.push("    try:");
    L.push("        _p = _a[0] if len(_a) > 0 else _kw.get('file')");
    L.push("    except Exception:");
    L.push("        _p = None");
    L.push("    _mode = str((_a[1] if len(_a) > 1 else _kw.get('mode')) or 'r')");
    L.push("    _rel = None");
    L.push("    try:");
    L.push("        _rel = __azusa_sync_rel(_p)");
    L.push("    except Exception:");
    L.push("        _rel = None");
    L.push("    if _rel is not None and any((_c in _mode) for _c in ('w', 'a', 'x', '+')):");
    L.push("        _v = __azusa_sync_skipof(_rel)");
    L.push("        if _v is not None:");
    L.push("            raise OSError('该路径本轮被同步跳过（why=%s），拒绝写入内核侧的不完整副本（方案 §4.5 写模式分支）。' % _v.get('why'))");
    L.push("    try:");
    L.push("        return __azusa_sync_open_orig(*_a, **_kw)");
    L.push("    except OSError as _fe:");
    /* ⚠️ **真机实测修正（B2-c r1）**：本内核里"文件不存在"抛的是 **`OSError` + errno 44**
       （Emscripten 的 ENOENT 编号），**不是 `FileNotFoundError`**（后者 errno=2）⇒ 只捕
       `FileNotFoundError` 会**整条漏掉**（实测 `[Errno 44] No such file or directory: 'big.txt'`
       原样透出、四分支一条都不生效）。故按 `OSError` 捕，并用 errno ∈ {2, 44} 或
       `FileNotFoundError` 收窄到"找不到"这一类（不吞权限/其它错误）。 */
    L.push("        if not (isinstance(_fe, FileNotFoundError) or _fe.errno in (2, 44)):");
    L.push("            raise");
    L.push("        _msg = None");
    L.push("        if _rel is not None:");
    L.push("            _v = __azusa_sync_skipof(_rel)");
    L.push("            if _v is not None:");
    L.push("                if _v.get('why') == 'deny':");
    L.push("                    _msg = '该路径属同步排除面（内核侧新生成的开发者产物），未装载进解释器；如属你的工作区文件请改用它名。'");
    L.push("                else:");
    L.push("                    _msg = '该文件超出本次同步上限（why=%s），未装载进解释器。' % _v.get('why')");
    L.push("        if _msg is None:");
    L.push("            try:");
    L.push("                _s = str(_p)");
    L.push("                _r0 = __azusa_sync_root()");
    L.push("                if _s.startswith('/') and not (_s == _r0 or _s.startswith(_r0 + '/')) and __azusa_sync_os.path.exists(_r0 + _s):");
    L.push("                    _msg = '这个文件在内核里的路径是 %s，工作区工具里才是 %s 写法。' % (_r0 + _s, _s)");
    L.push("            except Exception:");
    L.push("                _msg = None");
    L.push("        if _msg is None:");
    L.push("            raise");
    L.push("        try:");
    L.push("            raise type(_fe)(_msg)");
    L.push("        except TypeError:");
    L.push("            raise FileNotFoundError(_msg)");
    L.push("_za_builtins.open = __azusa_sync_open");
    /* ⚠️ **真机实测修正（B2-c r8 定点复现 · 产品缺陷）**：只补 `builtins.open` **对单元格无效** ——
       单元格里 `open('big.txt')` 仍抛**原样**的 `[Errno 44] No such file or directory: 'big.txt'`，
       而同格探针同时读到：`builtins.open is __azusa_sync_open` = **True** ·
       `_st['skips']` 含 `"/big.txt"` · `__azusa_sync_skipof('/big.txt')` **返回记录**
       ⇒ 单元格的裸 `open` 走的**不是** `builtins.open`（本环境下单元格命名空间对 builtins 有自己的一份）
       ⇒ **§4.5 的 `open()` 四分支在本环境是死代码**。⇒ 把包装器**显式注入执行命名空间**。
       （保留对 `builtins.open` 的补丁：无害，且覆盖"经模块属性取 `open`"的路径。
         as-built 偏离登记：内核全局里除四个 `__azusa_sync_*` 外**多一个裸名 `open`** —— 这是必需的，
         §4.5 的"不留裸名字"指的是 boot 的**临时变量**，而"装包装器"本身就是让 `open` 可被看到。） */
    L.push("_za_b = globals().get('__builtins__')");
    L.push("if isinstance(_za_b, dict):");
    L.push("    _za_b['open'] = __azusa_sync_open");
    L.push("globals()['open'] = __azusa_sync_open");
    L.push("");
    L.push("def __azusa_sync_scan(_known=None, _os=_za_os, _st=_za_st, _n=_za_nonce, _maxd=" + JL_SYNC_MAX_DEPTH + ", _maxe=" + JL_SYNC_MAX_ENTRIES + "):");
    L.push("    _o = {'nonce': _n, 'root': _st['root'], 'files': {}, 'truncated': False,");
    /* ⚠️ **D2 分离（B2-c，2026-09-17）**：`skipped` 是**全量口径**（含 `deny` 命中 —— 既有报文形状
       不变），`skippedReal` 是**真实跳过事件**分项（截断 / 上限类）⇒ 宿主的保守闸③ 只读后者。
       `deny` 命中是"有意排除"（E-2 安装目录 / E-3 段名与后缀），**不指示本轮扫描不完整**。 */
    /* ⚠️ **R-D2-2（B2-c · D3 补批，2026-09-17）**：`errors` = 本轮扫描里被 `except` 吃掉的异常
       （`listdir` / `stat`）的**逐条留档**。此前两处是静默 `return` / `continue` ⇒ "内核侧没看见"
       与"内核侧被删"**同形** ⇒ 宿主 ④ 会把它判成内核侧删除、**删掉 Contents 副本**（数据丢失）。
       宿主读本报文的 `errors`：非空 ⇒ 本轮 `incomplete` ⇒ 闭闸 `noDel` + 不推进账本（R-D2-2）。 */
    L.push("          'truncatedEntries': 0, 'skipped': 0, 'skippedReal': 0, 'skippedPaths': [], 'errors': []}");
    L.push("    _c = [0]");
    L.push("    _o['skips'] = sorted(list(_st.get('skips') or {}))");
    /* E-1/E-2/E-3 的**反方向护栏**（准入 ⑥ / §4.2）：内核侧新生成的开发者产物（`__pycache__` /
       `*.pyc` / 安装目录 / site-packages…）**永不进同步**；但「**Contents 已存在优先**」——
       `_known` = 宿主账本的全部键（= Contents 认得的路径）⇒ 命中的路径**豁免 E-3**
       （工作区里真有的 `.config/x.json` 必须同步，否则 = `勘-八-1` 禁止的静默缩功能）。
       E-1（根作用域）**绝对优先**：`_w` 从 `_root` 起走、只降入 `_root` 之内 ⇒ 越界路径
       结构性地不可能出现；`_deny` 里的 `scope` 支路是**防御性断言**（不依赖结构性论证）。
       `why` 一律记 `'deny'`（§4.2 的 why 枚举不扩张 —— b-fix 审查 P2-4 口径）。 */
    L.push("    _root = _st['root'].rstrip('/')");
    L.push("    _ps = [str(_q).rstrip('/') for _q in (_st.get('ps') or []) if _q]");
    L.push("    _kn = set(_known or [])");
    L.push("    _segs = set(" + JSON.stringify(JL_SYNC_DENY_SEGS) + ")");
    L.push("    _exts = tuple(" + JSON.stringify(JL_SYNC_DENY_EXTS) + ")");
    L.push("    def _deny(_p):");
    L.push("        if not (_p == _root or _p.startswith(_root + '/')):");
    L.push("            return True");
    L.push("        _rel = _p[len(_root):]");
    L.push("        for _q in _ps:");
    L.push("            if _q and (_p == _q or _p.startswith(_q + '/')):");
    L.push("                return True");
    L.push("        if _rel in _kn:");
    L.push("            return False");
    /* ⚠️ **真机实测修正（B2-c r8 · 产品缺陷）**：`_kn` 里的路径**其祖先目录**也必须豁免 ——
       否则 `_w()` 在目录项上就被 `_deny` 拦下、**不再降入**（r8 实测 `/.config/x.json` 在 Contents
       ⇒ 文件本身可读、且不在 `skippedPaths[]`，但**父目录 `.config` 被记 `deny`**）⇒ 该子树在
       **出方向（C-3/C-4 回收）永不参与** ⇒ 内核侧对 `.config/x.json` 的改动悄悄丢失
       = 方案 §4.2「Contents 已存在优先」被违反、`勘-八-1` 禁止的"静默缩功能"。
       豁免范围**由 Contents 已知路径决定**（`_ka.startswith(_rel + '/')`）⇒ 不可豁免的兄弟文件仍按
       段名/后缀拒收（文件级检查不变）；E-1 根作用域与 E-2 安装目录**都在本行之前**、不受影响。 */
    L.push("        for _ka in _kn:");
    L.push("            if _ka.startswith(_rel + '/'):");
    L.push("                return False");
    L.push("        for _x in [x for x in _rel.split('/') if x]:");
    L.push("            if _x in _segs:");
    L.push("                return True");
    L.push("        for _e in _exts:");
    L.push("            if _p.endswith(_e):");
    L.push("                return True");
    L.push("        return False");
    L.push("    def _w(_d, _dep):");
    L.push("        if _dep > _maxd:");
    L.push("            _o['truncated'] = True");
    L.push("            _o['truncatedEntries'] += 1");
    L.push("            _o['skipped'] += 1");
    L.push("            _o['skippedReal'] += 1");
    L.push("            _o['skippedPaths'].append({'path': _d, 'why': 'depth', 'prefix': True})");
    L.push("            return");
    L.push("        try:");
    L.push("            _ns = sorted(_os.listdir(_d))");
    L.push("        except Exception as _x:");
    L.push("            _o['errors'].append({'path': _d, 'error': str(_x)})");
    L.push("            return");
    L.push("        for _nm in _ns:");
    L.push("            _p = _d.rstrip('/') + '/' + _nm");
    /* ⚠️ **D2 分离（B2-c，2026-09-17）**：`deny` 命中**只**进全量口径 `skipped`，**不进
       `skippedReal`** ⇒ 宿主的保守闸③（"本轮不判任何删除"）不再被排除面的**常态命中**恒真拦下。
       本环境 `/home/pyodide/.ipython` 必然命中（`JL_SYNC_DENY_SEGS` 含 `.ipython`）⇒ 分离前
       **C-6 的删除分支结构性不可达**（r10 实测：④ 边界 29 条 `noDelete` 全真、`deleted` 合计 0）。
       `skippedPaths[]` 的逐路径留档**原样保留**（`why:'deny'` 在册 ⇒ C6/C6B/C6NEG 的读数面不变），
       `_deny()` 语义与 `JL_SYNC_DENY_SEGS` 内容**未动**。 */
    L.push("            if _deny(_p):");
    L.push("                _o['skipped'] += 1");
    L.push("                _o['skippedPaths'].append({'path': _p, 'why': 'deny'})");
    L.push("                continue");
    L.push("            _c[0] += 1");
    L.push("            if _c[0] > _maxe:");
    L.push("                _o['truncated'] = True");
    L.push("                _o['truncatedEntries'] += 1");
    L.push("                _o['skipped'] += 1");
    L.push("                _o['skippedReal'] += 1");
    L.push("                _o['skippedPaths'].append({'path': _d, 'why': 'count', 'prefix': True})");
    L.push("                return");
    L.push("            try:");
    L.push("                if _os.path.isdir(_p):");
    L.push("                    _w(_p, _dep + 1)");
    L.push("                    continue");
    L.push("                _s = _os.stat(_p)");
    L.push("                _o['files'][_p[len(_st['root']):] if _p.startswith(_st['root']) else _p] = {'size': _s.st_size, 'mtime': _s.st_mtime}");
    L.push("            except Exception as _x:");
    L.push("                _o['errors'].append({'path': _p, 'error': str(_x)})");
    L.push("                continue");
    L.push("    _w(_st['root'], 0)");
    L.push("    return _o");
    L.push("");
    /* 内容摘要（**两语言同式**，B2-b 新增）：`'n<精确字节数>:<fnv1a32(全长 base64 的前 4096 字符)>'`
       —— 宿主侧对应 `jlSyncHashContent(b64, size)`。两者可比的机械理由：base64 对每 3 字节组独立编码
       ⇒ `b64encode(data[:3072])` 恰是全长 base64 的前 4096 个字符（且 3072 是 3 的倍数，必无padding）。
       用途 = §3.3「跨文档回声环的收敛条件」第 1 条：**按内容判等（不是时间戳）**。 */
    L.push("def __azusa_sync_hash(_d, _b64=_za_b64):");
    L.push("    _s = _b64.b64encode(_d[:3072]).decode('ascii')[:4096]");
    L.push("    _h = 2166136261");
    L.push("    for _c in _s:");
    L.push("        _h = ((_h ^ ord(_c)) * 16777619) & 0xFFFFFFFF");
    L.push("    return 'n%d:%s' % (len(_d), format(_h, 'x'))");
    L.push("");
    /* ④ 的内核侧一次走查（B2-b）：元数据全集 + 变文件内容分片。
       · 走查语义**完全复用 `__azusa_sync_scan()`**（同一个函数 ⇒ 截断 / MAX_ENTRIES / MAX_DEPTH /
         `.azusa-sync` deny / skippedPaths 的口径不可能两处漂移）；
       · `_base` = 宿主账本的已同步位 `{rel: {s,m,h}}` ⇒ 两条快路径都免读文件：
         ① `size`+`mtime` 都与基准相同 ⇒ 直接 `same:true`（**稳定态零读盘**）；
         ② 不符 ⇒ 读一次、算摘要：摘要相同 ⇒ `same:true`（**回声抑制的"按内容判等"**）。
       · 真变了的文件按 `_chunk` 切分内容（每片一条 `print` ⇒ 单条 IOPub `stream.text` 有界）；
       · `_maxb` = 单边界回收字节上限（base64 前）；超出的路径记 `over:true`（宿主按"超上限 ⇒ 跳过 + 提示"处置）。 */
    L.push("def __azusa_sync_out(_base, _maxb=" + JL_SYNC_MAX_BYTES_OUT + ", _chunk=" + Math.floor(JL_SYNC_STREAM_CHUNK / 2) + ",");
    L.push("                     _scan=__azusa_sync_scan, _b64=_za_b64, _json=_za_json, _hash=__azusa_sync_hash, _known=None):");
    L.push("    _r = _scan(_known)");
    L.push("    _o = {'t': 'meta', 'nonce': _r['nonce'], 'root': _r['root'], 'files': {}, 'truncated': _r['truncated'],");
    L.push("          'truncatedEntries': _r['truncatedEntries'], 'skipped': _r['skipped'],");
    /* `skippedReal` 必须一并转出 —— 宿主的保守闸③ 读的是**本报文**的 `meta`（`jlSyncOut` 从
       `__azusa_sync_out` 的 `t:'meta'` 里取），漏转 ⇒ 回退成 `skipped − deny` 的近似口径。
       ⚠️ 取值用 **`.get(..., 0)`（缺键容错）**：`_scan` 是可被替换的（装置的 run-time override 用
       自己的替身 `scan` —— 它按旧形状返回、无 `skippedReal` 键）⇒ 严格取值会 `KeyError` ⇒
       **整条 ④ 隐藏执行失败**（r13 首轮实测：状态行 `④ 本次回收不完整（status=error · 哨兵/元数据缺失）`
       ⇒ C6NEG 负例失去咬合力）。缺键按 0 记 ⇒ 与"该 scan 未报告真实跳过"一致，且**宿主侧仍有
       `skipped − deny` 的保守回退**兜底。 */
    L.push("          'skippedReal': _r.get('skippedReal', 0),");
    /* ⚠️ **R-D2-2（B2-c · D3 补批，2026-09-17）**：`errors` 必须**一并转出扫描侧**的异常（`.get` 容错：
       `_scan` 是可替换的注入参数 ⇒ 替身可能没有该键）—— 本行之后 ④ 自身的内容读失败也追加到
       同一个列表 ⇒ 宿主拿到的 `meta.errors` = "**本轮 scan + out 侧的异常全集**"（闭闸依据）。 */
    L.push("          'skippedPaths': _r['skippedPaths'], 'over': [], 'errors': list(_r.get('errors') or []),");
    L.push("          'skips': _r.get('skips') or []}");
    L.push("    _budget = [_maxb]");
    L.push("    _base = _base or {}");
    L.push("    for _rel in sorted(_r['files'].keys()):");
    L.push("        _m = _r['files'][_rel]");
    L.push("        _b = _base.get(_rel)");
    L.push("        if (_b and _b.get('m') is not None and int(_b.get('s', -1)) == int(_m['size'])");
    L.push("                and abs(float(_b['m']) - float(_m['mtime'])) < 1e-6):");
    L.push("            _o['files'][_rel] = {'size': _m['size'], 'mtime': _m['mtime'], 'same': True}");
    L.push("            continue");
    L.push("        try:");
    L.push("            with open(_r['root'] + _rel, 'rb') as _f:");
    L.push("                _d = _f.read()");
    L.push("        except Exception as _x:");
    L.push("            _o['errors'].append({'path': _rel, 'error': str(_x)})");
    L.push("            continue");
    L.push("        _hv = _hash(_d)");
    L.push("        _same = bool(_b and _b.get('h') == _hv)");
    L.push("        _rec = {'size': _m['size'], 'mtime': _m['mtime'], 'hash': _hv, 'same': _same}");
    L.push("        if not _same:");
    L.push("            if len(_d) > _budget[0]:");
    L.push("                _rec['over'] = True");
    L.push("                _o['over'].append(_rel)");
    L.push("            else:");
    L.push("                _budget[0] -= len(_d)");
    L.push("                _s = _b64.b64encode(_d).decode('ascii')");
    L.push("                _n = (len(_s) + _chunk - 1) // _chunk");
    L.push("                for _i in range(_n):");
    L.push("                    print('" + JL_SYNC_SENTINEL + "' + _json.dumps({'t': 'c', 'p': _rel, 'seq': _i, 'total': _n, 'd': _s[_i * _chunk:(_i + 1) * _chunk]}))");
    L.push("        _o['files'][_rel] = _rec");
    L.push("    print('" + JL_SYNC_SENTINEL + "' + _json.dumps(_o))");
    L.push("    return _o");
    L.push("");
    L.push("def __azusa_sync_apply(_pl, _os=_za_os, _b64=_za_b64, _n=_za_nonce, _st=_za_st):");
    L.push("    if not _pl or _pl.get('nonce') is None or _pl.get('nonce') != _n:");
    L.push("        return {'ok': False, 'stale': True, 'err': 'nonce-mismatch'}");
    L.push("    __azusa_sync_setskips(_pl.get('skips'))");
    L.push("    _root = _st['root']");
    L.push("    _w = 0");
    L.push("    _d = 0");
    L.push("    _hs = {}");
    L.push("    _errs = []");
    L.push("    for _it in (_pl.get('add') or []):");
    L.push("        _rel = str(_it.get('path') or '')");
    L.push("        _nr = _os.path.normpath('/' + _rel)");
    L.push("        if (not _rel) or _nr == '/..' or _nr.startswith('/../'):");
    L.push("            _errs.append({'path': _rel, 'error': 'bad-path'})");
    L.push("            continue");
    L.push("        try:");
    L.push("            _p = _root + _nr");
    L.push("            _dir = _os.path.dirname(_p)");
    L.push("            if _dir and not _os.path.isdir(_dir):");
    L.push("                _os.makedirs(_dir, exist_ok=True)");
    L.push("            _raw = _b64.b64decode(_it.get('b64') or '')");
    L.push("            with open(_p, 'wb') as _f:");
    L.push("                _f.write(_raw)");
    L.push("            _hs[_rel] = __azusa_sync_hash(_raw)");
    L.push("            _w += 1");
    L.push("        except Exception as _x:");
    L.push("            _errs.append({'path': _rel, 'error': str(_x)})");
    L.push("    for _rel in (_pl.get('del') or []):");
    L.push("        _nr = _os.path.normpath('/' + str(_rel))");
    L.push("        if _nr == '/..' or _nr.startswith('/../'):");
    L.push("            _errs.append({'path': str(_rel), 'error': 'bad-path'})");
    L.push("            continue");
    L.push("        try:");
    L.push("            _p = _root + _nr");
    L.push("            if _os.path.exists(_p):");
    L.push("                _os.remove(_p)");
    L.push("                _d += 1");
    L.push("        except Exception as _x:");
    L.push("            _errs.append({'path': str(_rel), 'error': str(_x)})");
    L.push("    return {'ok': True, 'written': _w, 'deleted': _d, 'hashes': _hs, 'errors': _errs}");
    L.push("");
    L.push("print('" + S + "' + _za_nonce)");
    L.push("for _za_n in [k for k in list(globals().keys()) if k.startswith('_za_')]:");
    L.push("    globals().pop(_za_n, None)");
    L.push("globals().pop('_za_n', None)");
    return L.join("\n");
  }
  /* ④ 的隐藏执行源码生成（**消费者 = B2-b 的 jlSyncOut**;本批把它一并产出并自证可执行） */
  function jlSyncScanSrc() {
    return [
      "import json as _za_j",
      "_za_r = __azusa_sync_scan()",
      "print('" + JL_SYNC_SENTINEL + "' + _za_j.dumps(_za_r))",
      "del _za_j, _za_r"
    ].join("\n");
  }
  function jlSyncApplySrc(payload) {
    return [
      "import json as _za_j",
      "_za_p = _za_j.loads(" + jlSyncPyStr(JSON.stringify(payload)) + ")",
      "_za_r = __azusa_sync_apply(_za_p)",
      "print('" + JL_SYNC_SENTINEL + "' + _za_j.dumps(_za_r))",
      "del _za_j, _za_p, _za_r"
    ].join("\n");
  }
  /* ④ 的隐藏执行源码（B2-b）：账本当 baseline 传进内核 ⇒ **一次**走查同时产出元数据与内容分片
     （§3.3「常态额外执行次数 ≤1 次（回收侧扫描，即 ④）」；不传 baseline 就要么多一次 exec、
     要么每边界读全量内容）。baseline 只带**已同步位**（跳过位不是"内核里的内容"）。 */
  function jlSyncBaselineOf(conn) {
    var L = conn.__jlLedger || {}, out = {}, p, r;
    for (p in L) {
      if (!Object.prototype.hasOwnProperty.call(L, p)) continue;
      r = L[p];
      if (!r || r.skipped) continue;
      out[p] = { s: r.size, m: (typeof r.mtime === "number") ? r.mtime : null, h: r.hash || null };
    }
    return out;
  }
  /* 「**Contents 已存在优先**」的载体（准入 ⑥ / §4.2）：账本的**全部键**（含跳过位）=
     宿主认得的路径集合 ⇒ 内核侧 E-3 对它们**豁免**（否则工作区里真有的
     `.config/x.json` / `node_modules/…` 会被静默吃掉 = `勘-八-1` 禁止的缩功能）。 */
  function jlSyncKnownPaths(conn) {
    var L = conn.__jlLedger || {}, out = [], p;
    for (p in L) {
      if (Object.prototype.hasOwnProperty.call(L, p)) out.push(p);
    }
    out.sort();
    return out;
  }
  function jlSyncOutSrc(conn, base, known) {
    return [
      "import json as _za_j",
      "_za_base = _za_j.loads(" + jlSyncPyStr(JSON.stringify(base || {})) + ")",
      "_za_kn = _za_j.loads(" + jlSyncPyStr(JSON.stringify(known || [])) + ")",
      "_za_r = __azusa_sync_out(_za_base, _known=_za_kn)",
      "del _za_j, _za_base, _za_kn, _za_r"
    ].join("\n");
  }

  /* ---- 世代校验（§4.4 C-9）：清账本的**唯一**入口（口径 = §4.3 的 resetCount 五条枚举） ---- */
  function jlSyncLedgerClear(conn, why) {
    conn.__jlLedger = {};
    conn.__jlLedgerValid = false;
    var S = jlSyncSt();
    S.ledgerValid = false;
    S.generation.resetCount++;
    var D = jlSyncDg();
    D.resets.push({ at: Date.now() - KR.t0, why: String(why), conn: String(conn.id),
      resetCount: S.generation.resetCount });
    if (D.resets.length > 40) D.resets.shift();
    JLS_DEGRADED = true;
    S.degraded = true;
    jlSyncNote("世代校验命中（" + why + "）⇒ 当刻清空账本 + __jlLedgerValid=false + 本边界不判任何删除"
      + "（generation.resetCount=" + S.generation.resetCount + "）", "degraded");
  }
  /* "中途失败 ⇒ **保留旧 ledger** + 置假 ⇒ 下轮全量"（§4.4「ledger 的定义」末段）——
     与 `jlSyncLedgerClear`（**清账**）是两件事：这里是"不信任这份账"，不是"账没了"。 */
  function jlSyncLedgerInvalidate(conn) {
    conn.__jlLedgerValid = false;
    jlSyncSt().ledgerValid = false;
  }
  /* boot 观察点：先比后移（§4.4）——落点 = conn.__jlBootSeen++ 的同一处 */
  function jlSyncBootObserve(conn, nonce, via) {
    /* **活跃 conn 的声明点**（裁定 2 决定 B）：boot 取得回传值 = 内核真的应答了本 conn ⇒
       这是本环境可得的**最强**活跃证据。被丢弃的重复 `IKernelConnection` 永远走不到这里
       ⇒ 它们的状态信号随后被 `jlSyncConnLive` 挡在 C-9 之外。 */
    var wasLive = jlSyncConnLive(conn);
    jlSyncClaimLive(conn);
    if (!wasLive) {
      jlSyncDg().shadow.liveClaim = { at: Date.now() - KR.t0, conn: String(conn.id), via: via,
        kid: jlSyncKid(conn) };
    }
    var S = jlSyncSt(), g = S.generation;
    var prev = conn.__jlNonce;
    var mismatch = (prev !== null && prev !== nonce);       /* 含 null 基准守卫（R6-P2-1） */
    var bootSeen = conn.__jlBootSeen + 1;
    g.prevNonce = prev;
    g.bootNonce = nonce;
    g.mismatch = mismatch;
    g.bootSeen = bootSeen;
    g.events.push({ at: "boot", prevNonce: prev, curNonce: nonce, mismatch: mismatch,
      bootSeen: bootSeen, via: via, t: Date.now() - KR.t0 });
    conn.__jlBootSeen = bootSeen;
    conn.__jlNonce = nonce;                                  /* 无条件后移 */
    S.ledgerValid = conn.__jlLedgerValid === true;
    var redundant = (bootSeen >= 2);                         /* 不依赖 nonce 通道的冗余触发 */
    if (mismatch) jlSyncDg().genHits.nonceMismatch++;
    if (redundant) jlSyncDg().genHits.redundant++;
    if (mismatch || redundant) jlSyncLedgerClear(conn, mismatch ? "boot-nonce-mismatch" : "bootSeen>=2");
    else jlSyncNote("boot 观察点：首个 boot（基准 null）⇒ 不判世代不符（mismatch=false）", "info");
    return { mismatch: mismatch, bootSeen: bootSeen };
  }
  /* C-9 的另两条状态触发（v5/v6：命中 ⇒ 同款清账 + resetCount++）。
     **活跃 conn 闸（裁定 2 决定 B，B2-c 准入 ①）**：只认活跃 conn 的信号 ——
     `sm.kernels.connectTo` 每次都造新 `IKernelConnection`（同一 kernel id），其中被丢弃的那些
     在销毁时会发 `disconnected`；若照单全收，`generation.resetCount` 会被假信号推高
     （B2-a 实测 `resetCount=2` 全部来自这类对象），N8b 的 `resetCount === 0` 断言即不可达。
     被挡下的信号**不静默**：逐条进 `__JL_SYNC_DIAG.shadow.ignoredSignals[]`。 */
  function jlSyncSubscribeGen(conn) {
    var info = { conn: String(conn.id), kid: jlSyncKid(conn), connectionStatusChanged: false,
      statusChanged: false, seen: [], ignored: 0, hit: 0, connRef: conn };   /* connRef = 诊断用活句柄 */
    var gate = function (sig) {
      info.seen.push(sig);
      if (!jlSyncConnLive(conn)) {
        info.ignored++;
        var D = jlSyncDg();
        D.shadow.ignoredSignals.push({ at: Date.now() - KR.t0, conn: String(conn.id),
          kid: jlSyncKid(conn), sig: sig, why: "not-live" });
        if (D.shadow.ignoredSignals.length > 40) D.shadow.ignoredSignals.shift();
        return false;
      }
      info.hit++;
      return true;
    };
    try {
      if (conn.connectionStatusChanged && typeof conn.connectionStatusChanged.connect === "function") {
        conn.connectionStatusChanged.connect(function (_, s) {
          if (!gate("conn:" + String(s))) return;
          if (String(s) === "disconnected") {
            jlSyncDg().genHits.disconnected++;
            jlSyncLedgerClear(conn, "connectionStatusChanged=disconnected");
          }
        });
        info.connectionStatusChanged = true;
      }
    } catch (e) {}
    try {
      if (conn.statusChanged && typeof conn.statusChanged.connect === "function") {
        conn.statusChanged.connect(function (_, s) {
          if (!gate("status:" + String(s))) return;
          if (String(s) === "restarting") {
            jlSyncDg().genHits.restarting++;
            jlSyncLedgerClear(conn, "statusChanged=restarting");
          }
        });
        info.statusChanged = true;
      }
    } catch (e) {}
    if (JLS_ATTACH_INFO) JLS_ATTACH_INFO.genSignals.push(info);
    return info;
  }

  /* ---- boot：每连接一次（§4.5；不在 ①②③④⑤ 链上,它是 ② 的前置条件） ---- */
  async function jlSyncBootRun(conn) {
    var D = jlSyncDg();
    var rec = { at: Date.now() - KR.t0, conn: String(conn.id), ok: false, via: null, nonce: null,
      dirs: null, status: "", timeout: false, err: "" };
    try {
      try { await jlRace(Promise.resolve(conn.info), JL_KERNEL_READY_MS, "boot.info"); } catch (e) {}
      /* 只等**通道**连上，**不等** status 回 idle —— 边界的 boot 是在"用户请求被我们扣住、
         内核本该空闲"的时刻发的，但 status 在排队/重启窗口里可能是 busy/restarting；
         等 idle 会把首个边界白拖 JL_KERNEL_READY_MS（r7 实测失败形状：`sync.exec 超时 300000 ms`）。 */
      try {
        await jlPoll(function () { return conn.connectionStatus === "connected"; }, JL_EXEC_TIMEOUT_MS, 300);
      } catch (e2) {}
      var io = null;
      try { io = await jlSyncHiddenExec(conn, jlSyncBootSrc(), {
        user_expressions: { __azusa_boot_nonce: "__azusa_sync_nonce()" },
        /* 就绪**轮询**用 JL_KERNEL_READY_MS（慢启动期），但 boot 这一次**执行**的预算是
           JL_EXEC_TIMEOUT_MS —— 它只是 import/print，绝不该拿 5 分钟去等一个不会来的 reply
           （r7 实测：孤儿 conn 上按 300 s 等 ⇒ 把首个边界一起拖住）。 */
        budgetMs: JL_EXEC_TIMEOUT_MS }); }
      catch (e3) { rec.err = "boot 执行异常：" + ((e3 && e3.message) || e3); }
      if (io) {
        rec.status = io.status;
        rec.timeout = !!io.timeout;
        var text = io.streams.stdout || "";
        var i0 = text.indexOf(JL_SYNC_BOOT_SENTINEL + "DIRS__");
        if (i0 >= 0) {
          var raw = text.slice(i0 + (JL_SYNC_BOOT_SENTINEL + "DIRS__").length);
          var nl = raw.indexOf("\n");
          if (nl >= 0) raw = raw.slice(0, nl);
          try { rec.dirs = JSON.parse(raw); D.installDirs = rec.dirs; } catch (e4) {}
        }
        var ue = jlSyncReplyUserExpr(io, "__azusa_boot_nonce");
        /* 主通道取回的是**显示形态**（`?` I 实测面）：IPython 的 PlainText 格式器对 str 走 repr
           ⇒ 值形如 `'ab12…'`（**带引号**）。这里按"归一化后必须恰好 32 位十六进制"收口，
           否则退回哨兵 —— 不许把带引号的值当世代号（那会让内核侧 apply 恒判 stale ⇒ 注入永不落地）。 */
        rec.ueRaw = (ue === null || ue === undefined) ? null : String(ue).slice(0, 80);
        var ueNorm = (ue === null || ue === undefined) ? "" : String(ue).replace(/^[\s"']+|[\s"']+$/g, "");
        if (/^[0-9a-fA-F]{32}$/.test(ueNorm)) { rec.nonce = ueNorm.toLowerCase(); rec.via = "user_expressions"; }
        if (!rec.nonce) {
          var m = jlSyncLastMatch(text, new RegExp(JL_SYNC_BOOT_SENTINEL + "([0-9a-f]{32})"));
          if (m) { rec.nonce = m; rec.via = "stdout-sentinel"; }
        }
        if (!rec.nonce && io.errors && io.errors.length) rec.err = JSON.stringify(io.errors[0]);
      }
      if (!rec.nonce) {
        JLS_BOOT_ERR = "boot 两条回传通道都取不到 _NONCE（方案 §4.4：停止并上报）";
        rec.err = rec.err || JLS_BOOT_ERR;
        jlSyncDegrade(JLS_BOOT_ERR + " · status=" + rec.status + (rec.err ? " · " + rec.err : ""));
      } else {
        jlSyncBootObserve(conn, rec.nonce, rec.via);
        rec.ok = true;
        jlSyncNote("boot 完成：via=" + rec.via + " · bootSeen=" + conn.__jlBootSeen
          + " · root=" + ((rec.dirs && rec.dirs.root) || JL_SYNC_ROOT_FALLBACK), "info");
      }
    } catch (e9) {
      rec.err = "boot 异常：" + ((e9 && e9.message) || e9);
      jlSyncDegrade(rec.err);
    }
    D.bootRuns.push(rec);
    return rec;
  }

  /* ---- ② 的边界：Contents 快照 → 载荷 → 隐藏执行 apply ---- */
  function jlSyncB64Utf8(s) {
    var u8 = new TextEncoder().encode(String(s)), bin = "", i;
    for (i = 0; i < u8.length; i += 8192) {
      bin += String.fromCharCode.apply(null, u8.subarray(i, Math.min(i + 8192, u8.length)));
    }
    return btoa(bin);
  }
  /* 内容摘要（**内核侧 `__azusa_sync_hash` 的同式实现**，B2-b 改准：原 `jlSyncHashB64` 只取前 4 KiB 的
     fnv1a**且不含长度**，与内核侧算不出同一个值 ⇒ 两侧无法"按内容判等"）。式 = `'n<字节数>:<fnv1a32hex>'`：
       · 字节数取**精确值**（不得用 `b64.length*3/4` 反推 —— n%3≠0 时会差 1–2 字节）；
       · 摘要域 = **全长 base64 的前 4096 字符** == 内核侧 `b64encode(data[:3072])`（3 的倍数 ⇒ 无 padding
         ⇒ 前缀性成立）⇒ 两语言同式、可逐字符比对。
     ⚠️ 这是方案 §3.3 允许的"廉价等价物"（`?` D 未闭合前：`size + 内容长度 + 前 4 KiB 摘要`），
     写进 NOTES 时须照抄这句定语。 */
  function jlSyncHashContent(b64, size) {
    var s = String(b64 || "").replace(/\s+/g, "").slice(0, 4096), h = 2166136261, i;
    for (i = 0; i < s.length; i++) { h = h ^ s.charCodeAt(i); h = Math.imul(h, 16777619) >>> 0; }
    return "n" + ((typeof size === "number" && isFinite(size)) ? size : 0) + ":" + (h >>> 0).toString(16);
  }
  /* base64 的精确字节数（去空白 + 去 padding 计数）——`contents.get` 没给 `size` 时的兜底 */
  function jlSyncB64Bytes(b64) {
    var s = String(b64 || "").replace(/\s+/g, ""), pad = 0;
    if (s.length >= 2 && s.charAt(s.length - 1) === "=") pad++;
    if (s.length >= 2 && s.charAt(s.length - 2) === "=") pad++;
