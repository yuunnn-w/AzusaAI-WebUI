      /* 未命中:给 404(不用 reject)——reject 会变成"未处理拒绝",
         把 A2 的「控制台无未处理错误」判据变成不可判定;404 与真实站点缺页同形 */
      if (!b) { missOf(p, "fetch"); return Promise.resolve(new Response("", { status: 404, statusText: "jl shim miss" })); }
      return Promise.resolve(new Response(b, { status: 200, headers: { "Content-Type": mimeOf(p) } }));
    };

    /* ② XHR */
    var RealXHR = window.XMLHttpRequest;
    window.XMLHttpRequest = function () {
      var x = new RealXHR(), p = null;
      this._x = x;
      this.open = function (mm, u) { p = pathOf(u); if (p === null) { x.open(mm, u); } this._m = mm; };
      this.setRequestHeader = function () { return x.setRequestHeader.apply(x, arguments); };
      this.getResponseHeader = function () { return p === null ? x.getResponseHeader.apply(x, arguments) : "application/octet-stream"; };
      this.getAllResponseHeaders = function () { return p === null ? x.getAllResponseHeaders.apply(x, arguments) : ""; };
      this.addEventListener = function () { return x.addEventListener.apply(x, arguments); };
      this.removeEventListener = function () { return x.removeEventListener.apply(x, arguments); };
