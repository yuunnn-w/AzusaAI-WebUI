      L("boot:" + n + " 段 ready=" + READY);
      pushDiag("boot");
    }
    function onPort(ev) {
      var d = ev.data;
      if (!d) return;
      if (d.diagq) { pushDiag("query"); return; }
      if (d.q === undefined) return;
      var f = PEND[d.q];
      if (!f) return;
      delete PEND[d.q];
      f(d);
    }
