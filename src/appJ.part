}
function jlMirrorReadChildFile(cs, path) {
  return Promise.resolve(cs.get(path, { content: true, format: "base64" })).then(function (m) {
    var b64 = (m && typeof m.content === "string") ? m.content : "";
    return { ok: true, b64: b64, size: (m && m.size) || 0, lm: jlMirrorLmMs(m && m.last_modified) };
  }, function (e) { return { ok: false, err: String((e && e.message) || e).slice(0, 120) }; });
}
async function jlMirrorEnsureChildDir(cs, dir) {
  var parts = jlMirrorSegs(dir), i, acc = "", r;
  for (i = 0; i < parts.length; i++) {
    acc += "/" + parts[i];
    try { await cs.get(acc, { content: false }); continue; } catch (e) {}
    try { await cs.save(acc, { type: "directory" }); } catch (e2) {}
  }
  return true;
}

/* ---- 主页面侧刷新（⑤ 的主页面同款路径）+ `wsRev`（§2.9） ---- */
function jlMirrorRailRefresh() {
  try {
    wsrTreeReset();            /* 目录树缓存作废（换过内容/结构） */
    renderWsRail();
    renderWsDataPanel();
  } catch (e) { return "右栏刷新失败:" + String((e && e.message) || e).slice(0, 120); }
  return "";
}
function jlMirrorWsRevNow() {
  var rec = null;
  try { rec = JSON.parse(String(localStorage.getItem(LS_KEY) || "") || "{}"); } catch (e) { rec = null; }
  return Number((rec && rec.wsRev) || 0);
}
/* `wsRev`：**主页面单写者**（§2.9）。指纹 = 工作区根的 `wsStat`（每次改动都刷新 `updatedAt`）
   ⇒ 变了才 bump；单调不减（先接住落盘里更大的值，口径同 `convsRev`）。
   ⚠️ 本批代码面 = `src/appJ.part`（派单书限定）⇒ 不改 `appA`：此处**复用** appA 的权威记录构造器
   `stateRecord()`（字段一个不少，正是 §2.9 写者纪律防「漏带字段把对侧状态回退」的落点），只多写
   `wsRev` 这一个字段。**登记债**：`stateRecord()` 的字段表未随批加注（归 Phase 6 文档/口径批）。 */
function jlMirrorWsRevTick(ws) {
  return Promise.resolve(wsStat(ws, "/")).then(function (st) {
    if (!st || st.ok !== true) return { ok: false, reason: "wsStat 失败" };
    var fp = String(ws) + "|" + st.mtime + "|" + st.files + "|" + st.size;
    if (JL_WSREV_FP === null) {
      JL_WSREV_FP = fp;
      JL_WSREV_VAL = Math.max(JL_WSREV_VAL, jlMirrorWsRevNow());
      return { ok: true, bumped: false, reason: "首次对齐", wsRev: JL_WSREV_VAL };
    }
    if (fp === JL_WSREV_FP) return { ok: true, bumped: false, wsRev: JL_WSREV_VAL };
    JL_WSREV_FP = fp;
    var next = Math.max(JL_WSREV_VAL, jlMirrorWsRevNow()) + 1;
    JL_WSREV_VAL = next;
    JL_WSREV_BUMPS++;
    var rec = stateRecord();
    rec.wsRev = next;
    jlLsCarryFields(rec);   /* Phase 5：接回 `jlLease`（对方字段），否则会把主页面侧续命抹掉（见 27.9 头注） */
    try { localStorage.setItem(LS_KEY, JSON.stringify(rec)); } catch (e) {
      return { ok: false, err: String((e && e.message) || e).slice(0, 120) };
    }
    jlMirrorPub("wsrev", next);
    return { ok: true, bumped: true, wsRev: next };
