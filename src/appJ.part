  function jlBytesCopy(u8) { var out = new Uint8Array(u8.length); out.set(u8); return out; }
  /* 指纹:SHA-256 优先(file:// 是 secure context 时可用),不可用则退化为 FNV-1a(仍可机械对拍) */
  async function jlFingerprint(u8) {
    var i, h = 0x811c9dc5;
    if (self.crypto && self.crypto.subtle && self.crypto.subtle.digest) {
      try {
        var d = await self.crypto.subtle.digest("SHA-256", u8);
        var b = new Uint8Array(d), s = "";
        for (i = 0; i < b.length; i++) s += (b[i] < 16 ? "0" : "") + b[i].toString(16);
        return { alg: "sha256", hex: s };
      } catch (e) { /* 落到 FNV */ }
    }
    for (i = 0; i < u8.length; i++) { h ^= u8[i]; h = (h * 0x01000193) >>> 0; }
    return { alg: "fnv1a", hex: ("00000000" + h.toString(16)).slice(-8) };
