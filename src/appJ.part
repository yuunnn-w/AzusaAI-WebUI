    }
    if (!ok) {
      conn.__jlSyncWrapped = false;
      jlSyncNote("requestExecute 不可覆写 ⇒ 该连接未包装（挂点失效,不得当成功）", "err");
      return conn;
    }
    jlSyncSubscribeGen(conn);
    /* Phase 5 · 活动源②（§4.6）：`kernel.statusChanged` 的 busy/restarting = 活动（用户/装置发起） */
    try { jlLeaseHook(conn); } catch (e0b) {}
    jlSyncWrapSettle(conn, "interrupt");
    jlSyncWrapSettle(conn, "restart");
    jlSyncWrapSettle(conn, "shutdown");
    jlSyncWrapSettle(conn, "dispose");
    JLS_WRAPPED_ANY = true;
    jlSyncDg().wrappedConns = (jlSyncDg().wrappedConns || 0) + 1;
    /* boot **不在链上**（§3.3：它是 ② 的前置条件），且**惰性启动** —— 落点见 jlSyncIn 的注释
       （conn 对象可能只被 `connectTo` 造出来却从不跑单元格；对它发 hidden exec 只会换来 300 s 超时） */
    conn.__jlSyncBoot = null;
    return conn;
  }

  /* ---- 挂点（§3.2 主挂点 + 两级兜底） ---- */
  /* 形状分派（F10 修）：`KernelManager.running()` 的产出是内核**模型**（`Kernel.IModel`：
     id / name / last_activity / connections / execution_state），**不是连接**（`IKernelConnection`）
     —— 上游写死 `running(): IterableIterator<Kernel.IModel>`。真机实测（jupyterapp 只读探针，
     2026-09-18）：唯一一项 = `{ctor:"Object", keys:"id,name", requestExecute:"undefined",
     sendShellMessage:"undefined", id:"7e5ca27d-…"}`、`runningCount=1` ⇒ 判据链闭合。
     而 `startNew` / `connectTo` 返回的连接**恒有** `requestExecute`（`KernelConnection` 的原型方法）
     ⇒ 把模型喂给 `jlSyncWrapConn` 只会得到一条**假警报**：本函数在 `jlSyncAttach` 里的首次调用
     （实测 1.88 s）即刷出 `[err] 连接形状不符（没有 requestExecute）`，该文案一直留到下一个 note
     （阶段 ② 短路，~6.7 s）⇒ 用户可见 err ≈ 4.6 s（F10 三段独立复现 4,592 / 4,573 / 4,614 ms）；
     若此刻尚无连接被包装，1.5 s 轻 tick 还会逐次重刷（r1 console 出现 10 次的由来）。
     ⇒ 它**不是**环境使然（形状由 running() 的契约决定，与 file:// / mock / 真服务端无关），
     也不该按 err 播报。这里按形状分派：**真有 requestExecute 的才进包装**，模型跳过
     （它们本来也包不了，本函数只登记计数）。`jlSyncWrapConn` 内的 err 分支**保留不动** ——
     真正的异常（`startNew` / `connectTo` 返回非连接形状）照旧可见、照旧是 err。 */
  function jlSyncWrapRunning() {
    var sm2 = jlSyncSm(), n = 0, it, x;
    if (!sm2 || !sm2.kernels) return 0;
    try {
      it = sm2.kernels.running();
      x = it.next();
      while (!x.done) {
        if (x.value && typeof x.value.requestExecute === "function") jlSyncWrapConn(x.value);
        n++; x = it.next();
      }
    } catch (e) {}
    if (JLS_ATTACH_INFO) JLS_ATTACH_INFO.preWrapped = n;
    return n;
  }
  function jlSyncAttach(app) {
    if (app) JLS_APP = app;
    if (JLS_ATTACHED) return JLS_ATTACH_INFO;
    var info = { at: Date.now() - KR.t0, mount: null, tries: [], protoWrap: false,
      connectToWrap: false, signal: false, preWrapped: 0, ticks: 0, genSignals: [] };
    JLS_ATTACH_INFO = info;
    var sm2 = jlSyncSm();
    if (!sm2 || !sm2.kernels) {
      info.mount = "none";
      jlSyncNote("serviceManager.kernels 缺失 ⇒ 自动挂点装不上（直连臂仍经 jlKernelExec 包装）", "err");
      JLS_ATTACHED = true;
      jlSyncDg().attach = info;
      return info;
    }
    var K2 = sm2.kernels;
    var origStart = K2.startNew;
    var shapeWrap = function (r) {
      /* 形状保持：Promise ⇒ 仍在 Promise 里包；同步连接 ⇒ 同步包（connectTo 在 JupyterLab 里是**同步**返回连接的） */
      if (r && typeof r.then === "function") return Promise.resolve(r).then(function (c) { return jlSyncWrapConn(c); });
      return jlSyncWrapConn(r);
    };
    var wrapper = function () { return shapeWrap(origStart.apply(K2, arguments)); };
    /* 主挂点 = 实例自有属性覆写（探针实测：startNew 在**原型**上、实例可覆写） */
    try { K2.startNew = wrapper; } catch (e) { info.tries.push("assign:" + ((e && e.message) || e)); }
    if (K2.startNew === wrapper) info.mount = "own-assign";
    else {
      try { Object.defineProperty(K2, "startNew", { value: wrapper, writable: true, configurable: true }); }
      catch (e2) { info.tries.push("define:" + ((e2 && e2.message) || e2)); }
      if (K2.startNew === wrapper) info.mount = "defineProperty";
    }
    /* 兜底 1b-原型：包 Object.getPrototypeOf(sm.kernels) 的 startNew（新实例同样受益） */
    if (!info.mount) {
      try {
        var proto = Object.getPrototypeOf(K2);
        var porig = proto.startNew;
        var pw = function () { return shapeWrap(porig.apply(this, arguments)); };
        proto.startNew = pw;
        if (proto.startNew === pw) { info.mount = "prototype"; info.protoWrap = true; }
        else info.tries.push("proto:不可覆写");
      } catch (e3) { info.tries.push("proto:" + ((e3 && e3.message) || e3)); }
    }
    try {
      if (typeof K2.connectTo === "function") {
        /* ★ 实测（B2-a 探针 r6）：**笔记本 UI 那条腿走的是 connectTo,不是 startNew** ——
           `sm.sessions.startNew` 的源码 = `await this.refreshRunning(); this.connectTo({...})`
           ⇒ `SessionManager._connectToKernel` → `kernels.connectTo`。只包 startNew 会**静默丢掉**
           这台内核（r3 实测 wrapHits=0）。方案 §3.2 主挂点本来就并列要求包 connectTo。 */
        var corig = K2.connectTo;
        K2.connectTo = function () { return shapeWrap(corig.apply(K2, arguments)); };
        info.connectToWrap = (K2.connectTo !== corig);
        if (!info.connectToWrap) info.tries.push("connectTo:不可覆写");
      }
    } catch (e4) { info.tries.push("connectTo:" + ((e4 && e4.message) || e4)); }
    /* 兜底 1b-信号：runningChanged 补包装 */
    try {
      if (K2.runningChanged && typeof K2.runningChanged.connect === "function") {
        K2.runningChanged.connect(function () { info.signal = true; jlSyncWrapRunning(); });
        info.signal = true;
      }
    } catch (e5) {}
    jlSyncWrapRunning();
    /* 再兜底：只在"尚未包装任何连接"时的 1.5 s 轻 tick（只读 running()，不写内核、不进 FS） */
    var tick = function () {
      if (JLS_ATTACH_TICKS >= JL_SYNC_ATTACH_TICK_MAX || JLS_WRAPPED_ANY) return;
      JLS_ATTACH_TICKS++;
      info.ticks = JLS_ATTACH_TICKS;
      jlSyncWrapRunning();
      setTimeout(tick, JL_SYNC_ATTACH_TICK_MS);
    };
    setTimeout(tick, JL_SYNC_ATTACH_TICK_MS);
    JLS_ATTACHED = true;
    jlSyncDg().attach = info;
    jlSyncNote("挂点已装：mount=" + info.mount + " · connectTo=" + info.connectToWrap
      + " · runningChanged=" + info.signal + " · 已包连接=" + info.preWrapped, "info");
    return info;
  }

  /* ---- 本批的读数/驱动面（诊断用;与 __JL_KERN_ACT 同族） ---- */
  function jlSyncContentsPut(path, text) {
    var sm2 = jlSyncSm();
    if (!sm2 || !sm2.contents) return Promise.reject(new Error("serviceManager.contents 缺失"));
    return sm2.contents.save(path, { type: "file", format: "text", content: String(text) });
  }
  function jlSyncContentsDel(path) {
    var sm2 = jlSyncSm();
    if (!sm2 || !sm2.contents) return Promise.reject(new Error("serviceManager.contents 缺失"));
    return sm2.contents.delete(path);
  }
  /* ---- Phase 4：跨页键（§2.9）+「打开指定文件」（§2.6.1 D-4） ----
     写者纪律（§2.9 键表）：子文档**只读** `LS_KEY`（只取 `wsRev`、不落缓存、不回写），**只写** `LS_KEY+":jl"`；
     键名**不硬编码** —— 宿主经 `#jl-open-params` 注入（`lsKey`/`wsId`/`wantPath`/`wsRev`）。
     推送**不在这里做**：裁定 P2-4 第 2 条判「对 IDB / Contents 的推送统一由主页面执行」
     ⇒ 子文档侧**不存在可 await 的写队列**（① flush 因此恒走 degraded 分支，§3.3/§5.1）。
     `fileChanged` 只作**触发**（上报 `jlabRev` 让主页面立刻拉一次），**不作删除判据**（§2.6.1 D-3）。 */
  var JL_P4 = { params: null, wsRevSeen: 0, jlabRev: 0, lastActive: 0, reports: 0, opens: 0, tab: String(Math.random()).slice(2, 10),
    /* J-TAB-2 新增:want 承接面（`opens` = 打开动作次数;`opensNew` = 真新建打开;`opensDup` = 对"已在文档面"的激活） */
    opensNew: 0, opensDup: 0, wantSeen: "", wantSeqSeen: 0, wantInflight: null, wantStat: null, wantTimer: null,
    wantDups: 0, wantSuperseded: 0 };
  function jlP4Params() {
    if (JL_P4.params !== null) return JL_P4.params;
    var o = null;
    try {
      var el = document.getElementById("jl-open-params");
      if (el && el.textContent) o = JSON.parse(el.textContent);
    } catch (e) { o = null; }
    JL_P4.params = (o && typeof o === "object") ? o : {};
    return JL_P4.params;
  }
  function jlP4Ls() {
    var k = String(jlP4Params().lsKey || "");
    if (!k) return null;
    var ls = null;
    try { ls = (window.opener && window.opener.localStorage) ? window.opener.localStorage : null; } catch (e) { ls = null; }
    if (!ls) { try { ls = window.localStorage; } catch (e2) { ls = null; } }
    return ls ? { ls: ls, key: k } : null;
  }
  function jlP4Report(why) {
    var L = jlP4Ls();
    if (!L) return null;
    var wsRev = 0;
    try { wsRev = Number((JSON.parse(String(L.ls.getItem(L.key) || "") || "{}") || {}).wsRev || 0); } catch (e) { wsRev = 0; }
    if (wsRev > JL_P4.wsRevSeen) JL_P4.wsRevSeen = wsRev;
    var rec = { v: 1, tab: JL_P4.tab, jlabRev: JL_P4.jlabRev, wsRevSeen: JL_P4.wsRevSeen,
      /* Phase 5：`lastActive` 取**租约模块**的活动时刻（`jlLeasePoke` 维护）；`JL_P4.lastActive` 为兼容兜底。
         `JL5` 在本段之前只是 var 提升（`jlP4Install` 早于 `jlLeaseArm`）⇒ 必须存在性判断，否则抛。 */
      lease: { beat: Date.now(), lastActive: ((JL5 && JL5.lastActive) || JL_P4.lastActive || Date.now()) },
      at: Date.now() };
    try { L.ls.setItem(L.key + ":jl", JSON.stringify(rec)); JL_P4.reports++; } catch (e2) {}
    return { why: String(why || ""), wsRev: wsRev, wsRevSeen: JL_P4.wsRevSeen, jlabRev: JL_P4.jlabRev, reports: JL_P4.reports };
  }
  /* ---- J-TAB-2:want(「打开指定文件」)的**现读 + 等落位 + 幂等回执** ----
     载体 = 宿主写的 `#jl-open-params`(同一元素在首开时写一次、**已有标签页时被宿主重写** ⇒ 必须**现读**,
     不能共用 `jlP4Params()` 的缓存 —— 那正是"一次性消费"的根源)。
     回执 = 同一元素的 `data-jl-want`(子页写**自己**的文档,宿主同源直读;同族先例 = 宿主读子页
     `#jl-sync-note`/`w.jupyterapp`)⇒ 宿主能做幂等,也能让超时**可见**。
     时序(撤回批实测):子页 app 就绪(≈12 s)早于镜像把件推进 Contents(≈1 s/tick)⇒ 一次性消费**必失败**
     (横幅「打开指定文件失败: Could not find content with path …」)⇒ 这里改成"等到该路径出现在 Contents
     再开",超时**可见**(横幅 + 回执),绝不假装打开。 */
  var JL_P4_WANT_POLL_MS = 400;    /* 载体轮询节拍(隐藏标签页会被浏览器节流到 ≈1 s,可接受;`visibilitychange` 兜住) */
  var JL_P4_WANT_GATE_MS = 500;    /* 门内复读节拍(等 app 在册 / 等路径落位) */
  var JL_P4_WANT_MS_DEF = 25000;   /* 宿主经 `wantMs` 注入(口径权威在宿主 `JL_LAB_WANT_OPEN_MS`);此处只做默认 */
  function jlP4WantMs() { var n = Number(jlP4Params().wantMs || 0); return n > 0 ? n : JL_P4_WANT_MS_DEF; }
  function jlP4WantEl() { try { return document.getElementById("jl-open-params"); } catch (e) { return null; } }
  function jlP4WantRead() {   /* 现读(不走 `jlP4Params` 的缓存) */
    var el = jlP4WantEl(), o = null;
    try { o = (el && el.textContent) ? JSON.parse(el.textContent) : null; } catch (e) { o = null; }
    if (!o || typeof o !== "object") return null;
    var p = String(o.wantPath || "");
    if (!p) return null;
    return { seq: Number(o.wantSeq || 0) || 0, path: p, at: Number(o.wantAt || 0) || 0 };
  }
  function jlP4Ack(rec) {
    try {
      var el = jlP4WantEl();
      if (el && el.setAttribute) el.setAttribute("data-jl-want", JSON.stringify(rec));
    } catch (e) {}
  }
  /* 幂等比对口径:路径**只**做前导/尾斜杠归一(不做大小写/百分号等改写) */
  function jlP4PathNorm(p) {
    var s = String(p || "");
    if (!s) return "";
    if (s.charAt(0) !== "/") s = "/" + s;
    return (s.length > 1 && s.charAt(s.length - 1) === "/") ? s.replace(/\/+$/, "") : s;
  }
  /* 文档面里已有该路径 ⇒ 不再走等待门(`docmanager:open` 对已开文档 = **激活**,不新建)。
     ⚠ `shell.widgets("main")` 返回的是 Lumino 的**迭代器**(实测**没有** `length` ⇒ `!its.length` 恒真,
     会把"已打开"判成"没打开")⇒ 这里按 forEach → next() 排空 → 下标 三条路兜住,不依赖 `length`。 */
  function jlP4HasOpen(path) {
    var a = JLS_APP || KR.app || null, sh = (a && a.shell) || null, want = jlP4PathNorm(path), hit = false, i, v;
    if (!sh || typeof sh.widgets !== "function") return false;
    var scan = function (w) {
      var p = w && w.context && w.context.path;
      if (p && jlP4PathNorm(p) === want) hit = true;
    };
    try {
      var its = sh.widgets("main");
      if (its && typeof its.forEach === "function") { its.forEach(scan); return hit; }
      if (its && typeof its.next === "function") {
        for (v = its.next(); v !== undefined; v = its.next()) scan(v);
        return hit;
      }
      if (its && typeof its.length === "number") { for (i = 0; i < its.length; i++) scan(its[i]); }
    } catch (e) { return false; }
    return hit;
  }
  /* 门:等 ① `docmanager:open` 在册(应用就绪) ② 该路径已在 Contents(镜像已推送)。
     两条都不满足就等 ⇒ 首开的"文件晚 1–3 s 落位"不再退化成一次性失败;超时给出**明确原因**。
     让位:新的 want 取代本件时**静默**退出(由新的那次负责反馈)。 */
  function jlP4WantGate(path, t0) {
    return Promise.resolve().then(function () {
      var app = JLS_APP || KR.app || null, sm2 = jlSyncSm(), cs = (sm2 && sm2.contents) || null;
      if (!app || !app.commands) return { ok: false, err: "app.commands 缺失" };
      if (typeof app.commands.hasCommand === "function" && !app.commands.hasCommand("docmanager:open")) {
        return { ok: false, err: "docmanager:open 不在册" };
      }
      if (!cs || typeof cs.get !== "function") return { ok: false, err: "serviceManager.contents 缺失" };
      return Promise.resolve(cs.get(path, { content: false })).then(function () { return { ok: true }; },
        function (e) { return { ok: false, err: "Contents 里始终没有该路径(镜像未推送):" + String((e && e.message) || e).slice(0, 100) }; });
    }).then(function (r) {
      if (r.ok === true) return r;
      if (Date.now() - t0 > jlP4WantMs()) return { ok: false, err: r.err };
      return new Promise(function (res) { setTimeout(res, JL_P4_WANT_GATE_MS); }).then(function () {
        if (!JL_P4.wantInflight || JL_P4.wantInflight.path !== path) {
          return { ok: false, err: "已被新的打开请求取代", silent: true };
        }
        return jlP4WantGate(path, t0);
      });
    });
  }
  /* 计数器与读数面同步：`DIAG.p4` 的同族读数位此前**只声明不更新**（`opens` 恒 0 —— 撤回批读数里也是 0）
     ⇒ 本批一并对齐（判据面要能看见 `opens/opensNew/opensDup/wantDups` 的真实值）。 */
  function jlP4WantPub() {
    var D = DIAG.p4;
    if (!D) return;
    D.opens = JL_P4.opens; D.opensNew = JL_P4.opensNew; D.opensDup = JL_P4.opensDup;
    D.wantDups = JL_P4.wantDups; D.wantSuperseded = JL_P4.wantSuperseded;
    D.wantSeqSeen = JL_P4.wantSeqSeen; D.wantStat = JL_P4.wantStat;
  }
  function jlP4WantOpen(w) {
    var t0 = Date.now(), app = JLS_APP || KR.app || null;
    var finish = function (p, already) {
      return Promise.resolve(p).then(function () { return { ok: true, path: w.path, already: already === true, ms: Date.now() - t0 }; },
        function (e) { return { ok: false, path: w.path, already: already === true, err: String((e && e.message) || e).slice(0, 140), ms: Date.now() - t0 }; });
    };
    var exec = function () {
      JL_P4.opens++; jlP4WantPub();
      /* `commands.execute` 同步抛也要变成拒绝(否则会从 interval 回调里逃出去,留下"在飞"假态) */
      try { return Promise.resolve(app.commands.execute("docmanager:open", { path: w.path })); }
      catch (e) { return Promise.reject(e); }
    };
    if (app && app.commands && jlP4HasOpen(w.path)) {   /* 幂等:已在文档面 ⇒ 跳过等待门,直接激活(`already=true`) */
      JL_P4.opensDup++; jlP4WantPub();
      return finish(exec(), true);
    }
    return jlP4WantGate(w.path, t0).then(function (g) {
      if (g.ok !== true) return { ok: false, path: w.path, err: g.err, silent: g.silent === true, ms: Date.now() - t0 };
      if (!app || !app.commands) return { ok: false, path: w.path, err: "app.commands 缺失", ms: Date.now() - t0 };
      JL_P4.opensNew++; jlP4WantPub();
      return finish(exec(), false);
    });
  }
  function jlP4WantHandle(w) {
    var t0 = Date.now(), run;
    /* 幂等①:同一件的上一次投递**仍在飞** ⇒ 不重复打开、不重复提示(只把回执 seq 抬到最新) */
    if (JL_P4.wantInflight && JL_P4.wantInflight.path === w.path) {
      JL_P4.wantDups++; jlP4WantPub();
      jlP4Ack({ seq: w.seq, path: w.path, status: "opening", ms: Date.now() - JL_P4.wantInflight.t0, dup: true, at: Date.now() });
      DIAG.p4.want = { ok: null, path: w.path, dup: true, status: "opening" };
      return null;
    }
    if (JL_P4.wantInflight) { JL_P4.wantSuperseded++; jlP4WantPub(); }   /* 读旧那次尚未结清 ⇒ 记一次让位(它自己会静默退出) */
    run = { seq: w.seq, path: w.path, t0: t0 };
    JL_P4.wantInflight = run;
    jlP4Ack({ seq: w.seq, path: w.path, status: "opening", ms: 0, at: Date.now() });
    DIAG.p4.want = { ok: null, path: w.path, status: "opening" };
    return Promise.resolve(jlP4WantOpen(w)).then(function (r) {
      if (JL_P4.wantInflight === run) JL_P4.wantInflight = null;
      if (r.silent === true) return null;            /* 让位给更新的 want ⇒ 静默(不弹"失败") */
      JL_P4.wantStat = { seq: w.seq, path: w.path, status: r.ok === true ? "opened" : "failed",
        ms: Number(r.ms || 0), already: r.already === true, err: String(r.err || "").slice(0, 140), at: Date.now() };
      jlP4WantPub();
      jlP4Ack(JL_P4.wantStat);
      DIAG.p4.want = { ok: r.ok === true, path: w.path, err: r.err || "", ms: JL_P4.wantStat.ms,
        lagMs: w.at ? (Date.now() - w.at) : null, already: r.already === true };
      if (r.ok !== true) banner("打开指定文件失败：" + r.err);   /* 可见反馈(不静默) */
      return DIAG.p4.want;
    });
  }
  function jlP4WantTick() {
    var w = jlP4WantRead(), sig;
    if (!w) return null;
    /* 幂等②:同一份载荷被重读(seq|path|at 签名相同)⇒ 不重复打开、不重复提示。
       签名带 path+at ⇒ 对"没有 seq 的手写/注入载荷"同样成立(不能只靠 seq)。 */
    sig = String(w.seq) + "|" + w.path + "|" + String(w.at);
    if (sig === JL_P4.wantSeen) return null;
    JL_P4.wantSeen = sig;
    if (w.seq > JL_P4.wantSeqSeen) JL_P4.wantSeqSeen = w.seq;
    jlP4WantPub();
    return jlP4WantHandle(w);
  }
  function jlP4WantArm() {
    if (JL_P4.wantTimer === null) {
      try { JL_P4.wantTimer = setInterval(jlP4WantTick, JL_P4_WANT_POLL_MS); } catch (e) { JL_P4.wantTimer = null; }
    }
    /* 标签页被切到前台(宿主 `jlLabFocus()` 或用户自己点)⇒ 立刻复读一次(隐藏标签页的定时器会被节流) */
    try { document.addEventListener("visibilitychange", jlP4WantTick, false); } catch (e2) {}
    jlP4WantTick();   /* 首开:立刻处理引导时写好的 want(不等一拍) */
    return { timer: JL_P4.wantTimer !== null, pollMs: JL_P4_WANT_POLL_MS, gateMs: jlP4WantMs() };
  }
  function jlP4Install() {
    var p = jlP4Params();
    DIAG.p4 = { params: { wsId: p.wsId || null, wantPath: p.wantPath || null, wantSeq: Number(p.wantSeq || 0), lsKey: !!p.lsKey, wsRev: Number(p.wsRev || 0), tickMs: p.tickMs || null },
      tab: JL_P4.tab, reports: 0, opens: 0, opensNew: 0, opensDup: 0, wantDups: 0, wantSuperseded: 0, wantSeqSeen: 0 };
    var r0 = jlP4Report("app-ready");
    DIAG.p4.firstReport = r0;
    try {
      var sm4 = jlSyncSm();
      if (sm4 && sm4.contents && sm4.contents.fileChanged) {
        sm4.contents.fileChanged.connect(function () { JL_P4.jlabRev = Date.now(); jlP4Report("fileChanged"); DIAG.p4.jlabRev = JL_P4.jlabRev; });
        DIAG.p4.fileChanged = true;
      }
    } catch (e) {}
    try {
      window.addEventListener("storage", function (ev) {
        try {
          if (!ev || String(ev.key || "") !== String(jlP4Params().lsKey || "")) return;   /* 只认宿主那条键 */
          var r = jlP4Report("wsRev-changed");
          DIAG.p4.lastStorage = r;
        } catch (e2) {}
      }, false);
      DIAG.p4.lsListener = true;
    } catch (e3) {}
    DIAG.p4.wantArm = jlP4WantArm();   /* J-TAB-2:want 由"一次性消费"改为"现读 + 等落位"(见本段 jlP4Want* 族) */
    return DIAG.p4;
  }

  /* ---------------------------------------------------------------------------
     27.8.6 JL 空闲租约 + 释放（需求 6 · Phase 5）
     设计权威：`specs/jupyterlite-plan.md` §3「Phase 5 —— 空闲租约同步」+ §2.9 键表 + `勘-七-2.4`（共享时钟）
              + `specs/jupyterlite-b2-sync-plan.md`（v6）§4.6 回收行 + §5.4 **P-C10** + §5.3 负例纪律
     · **键族口径收口**（`decisions/plans-decision-gates.md:246` 的 P2-1 三族前缀）：取「**统一键名**」分支 ——
       单一 `jl:` 前缀族：`jl:lease:main` / `jl:lease:jupyter`（本段）与 `jl:base:<ws>` / `jl:gone:<ws>`
       （Phase 4 as-built）同族。理由（逐条见 `shared/tmp/jl-phase5/progress.md` §3）：Phase 4 的键已在产
       且已 PASS，改名会让落盘基线/墓碑失配（白丢一轮"删除不复活"保护）；决策门本身写的是"**或**统一键名"。
     · **写者纪律**（§2.9）：`pyocache` 的 `jl:` 键**只由主页面**写；子文档**只读** `LS_KEY`（只取
       `jlLease.lastActive`）、**只写** `LS_KEY+":jl"`（经 `jlP4Report`）。本段因此**零 IDB 访问**（子文档
       在 `file://` 下 IDB 不可用 ⇒ 这条纪律同时是可用性要求）。
     · **共享时钟**（`勘-七-2.4`，**不用**已作废的 `jlastActive` 字段）：
       子文档侧 `sharedIdle = now - max(LS_KEY.jlLease.lastActive, LS_KEY+":jl".lease.lastActive, 本页活动时刻)`；
       `opener` 不在 / `LS_KEY` 读不到（或装置注入 `forceDegrade`）⇒ **退化为独立计时**（DG6 退化分支）。
     · **释放序列**（b2-sync-plan §4.6）：空闲达阈值 ⇒ **先**释放前同步（`jlSyncOut`，墙钟
       `JL_SYNC_RELEASE_MS` 上限）**再** `kernel.shutdown()`；同步失败/超时 ⇒ 可见提示 + **仍然释放**
       （**不得因同步卡死回收**）。
     · **判定串 `releaseWithinWindow`**（P-C10，v3 写死该串名）：
         released ∧ isDisposed ∧ connectionStatus==="disconnected" ∧ preSync.count ≥ 1 ∧ preSync.ok ≥ 1 ∧ preSync.ms ≤ 上限
       ⚠ 比方案**字面**更紧：字面只要求"回收前发生过一次释放前同步（**读数计数 ≥1**）"，那样"N7 = 把释放前
       同步改成永不返回"**不会 FAIL**（调用照样计数 ≥1）⇒ 判据失去咬合力。故把"确有一次**成功完成**且**在
       窗口内**"写成显式合取（[E13] 四段范式见 `progress/jupyterlite-phase5-done.md`）。方向 = **收紧**，非放宽。
     · **活动源**（§4.6「我们的隐藏执行计入活动」/ R-7 不得自我续命）：**用户/装置发起**的 `requestExecute`
       时刻（经包装层 `jlSyncRequest`）与 `kernel.statusChanged` 的 `busy`。我方**隐藏**执行一律走
       `conn.__jlSyncOrig`（绕开包装、见 `jlSyncHiddenExec`）⇒ **不计入活动**，无定时器 ⇒ 不会自我续命。
     · **读数面**：`window.__JL_LEASE_STAT`（子文档 realm 诊断）+ `#jl-sync-note` 可见文案 + `document.title`。
  --------------------------------------------------------------------------- */
  var JL_LEASE_KV_MAIN = "jl:lease:main";
  var JL_LEASE_KV_JUP = "jl:lease:jupyter";
  var JL_LEASE_PREFIX = "jl:lease:";
  /* 子文档 realm 读不到 appE 的 `PY_IDLE_MS` / `PY_IDLE_TICK`（跨 realm）⇒ 此处独立声明同值常量，
     并由宿主经 `#jl-open-params` 注入（`idleMs` / `leaseTickMs`）覆盖；默认值 = appE 现值（10 min / 30 s）。 */
  var JL_LEASE_DEF_IDLE_MS = 10 * 60 * 1000;
  var JL_LEASE_DEF_TICK_MS = 30 * 1000;
  var JL_LEASE_TTL_PAD_TICKS = 2;        /* JL_LEASE_TTL_MS = idleMs + 2×tickMs（§2.9 纯超时口径） */
  var JL5 = {
    cfg: null, timer: null, armAt: null, ticks: 0, pokes: 0, lastActive: 0, lastPokeAt: 0,
    idleMs: 0, tickMs: 0, lastIdleMs: null, minIdleSeen: null, maxIdleSeen: 0, maxIdleWhileBusy: 0,
    thresholdHits: 0, busySkips: 0, releasing: false, released: false, decideAt: null,
    releaseRec: null, withinWindow: false, forceDegrade: false, forcedIdleMs: null,
    preSync: { count: 0, ok: 0, err: 0, timeout: 0, ms: 0, gate: "", syncMs: null },
    phase: "init", errs: [], why: "", version: 2, noticeShown: false, noticeClearedAt: 0
  };
  function jlLeaseCfg() {
    if (JL5.cfg) return JL5.cfg;
    var p = jlP4Params() || {};
    var idle = Number(p.idleMs || 0), tick = Number(p.leaseTickMs || 0);
    JL5.idleMs = (isFinite(idle) && idle > 0) ? idle : JL_LEASE_DEF_IDLE_MS;
    JL5.tickMs = (isFinite(tick) && tick > 0) ? tick : JL_LEASE_DEF_TICK_MS;
    JL5.cfg = { idleMs: JL5.idleMs, tickMs: JL5.tickMs, ttlMs: JL5.idleMs + JL_LEASE_TTL_PAD_TICKS * JL5.tickMs,
      releaseCapMs: JL_SYNC_RELEASE_MS, kvMain: JL_LEASE_KV_MAIN, kvJup: JL_LEASE_KV_JUP,
      source: (idle > 0 ? "params" : "default"), lsKeyGiven: !!p.lsKey };
    return JL5.cfg;
  }
  function jlLeaseNote(msg, kind) {
    var t = jlSyncNote(String(msg), kind || "info");
    JL5.why = String(msg);
    return t;
  }
  /* 横幅读面（E11：诊断/验证用；`#jl-child-banner` 的单槽文本，缺席 ⇒ null） */
  function jlLeaseBannerText() {
    try {
      var b = document.getElementById("jl-child-banner");
      return b ? String(b.textContent || "").slice(0, 200) : null;
    } catch (e) { return null; }
  }
  /* E11②（2026-09-18）：回收提示的可见残留清除 —— 内核/单元格再次活动（`jlLeasePoke`）时撤掉
     「内核已空闲回收」横幅 + 刷新同族旧文案（`#jl-sync-note` 若仍是释放文案、`document.title` 后缀）。
     · 只认领本提示：横幅以 `data-jl-banner="lease-recycle"` 标记 ⇒ 其余横幅（内核不可用 /
       打开文件失败 / worker 改造点异常）一律不动；
     · 只在确实显示过（`JL5.noticeShown`）或有释放事实（`JL5.released`）时才会被调用检查 ⇒
       正常运行时零行为，且本函数**只清不显** ⇒ 不会误闪；
     · `JL5.released` 一次性语义与判据面（releaseWithinWindow）**保持不动** —— 不对已 dispose
       的旧句柄二次释放；"重启后是否可再次回收"与本批目标的可见残留清理是两件事。 */
  function jlLeaseNoticeClear(why) {
    var acted = false;
    try {
      var box = document.getElementById("jl-child-banner");
      if (box && box.getAttribute && box.getAttribute("data-jl-banner") === "lease-recycle") {
        if (box.parentNode) box.parentNode.removeChild(box);
        acted = true;
      }
    } catch (e1) {}
    if (JL5.noticeShown === true) {
      JL5.noticeShown = false; JL5.noticeClearedAt = Date.now(); acted = true;
      var txt = "";
      try { var el = document.getElementById("jl-sync-note"); txt = String((el && el.textContent) || ""); } catch (e2) {}
      if (txt.indexOf("内核已释放") >= 0) {
        jlLeaseNote("内核再次活动（" + String(why || "activity") + "）⇒ 已清除「空闲回收」横幅与旧文案", "info");
      }
      try {
        var t = String(document.title || "");
        if (t.indexOf("（内核已空闲回收）") >= 0) document.title = t.replace("（内核已空闲回收）", "");
      } catch (e3) {}
    }
    return acted;
  }
  /* 活动上报（§2.9：子文档侧 = 写 `LS_KEY+":jl"` 的 lease 槽 ⇒ 免 IDB、零跨文档 API）。
     节流：≥1 s 才落一次 localStorage（多次 requestExecute 只写一条）。 */
  function jlLeasePoke(why) {
    var now = Date.now();
    JL5.lastActive = now; JL5.pokes++;
    if (JL5.noticeShown === true || JL5.released === true) {
      try { jlLeaseNoticeClear(why); } catch (eN) {}
    }
    if (now - JL5.lastPokeAt >= 1000) { JL5.lastPokeAt = now; jlP4Report("activity:" + String(why || "")); }
    return now;
  }
  /* 两份记录的读回：`{ok, mainLastActive, selfLastActive, mainBeat, selfBeat, ls}`。ok=false ⇒ 退化分支。 */
  function jlLeaseReadRecs() {
    var out = { ok: false, why: "", ls: false, mainLastActive: 0, selfLastActive: 0, mainBeat: 0, selfBeat: 0 };
    if (JL5.forceDegrade) { out.why = "forceDegrade(注入)"; return out; }
    var L = jlP4Ls();
    if (!L) { out.why = "LS_KEY 不可达(opener 不在或无 lsKey 参数)"; return out; }
    out.ls = true;
    var a = null, b = null;
    try { a = JSON.parse(String(L.ls.getItem(L.key) || "") || "{}"); } catch (e) { a = null; }
    try { b = JSON.parse(String(L.ls.getItem(L.key + ":jl") || "") || "{}"); } catch (e2) { b = null; }
    var mainL = (a && a.jlLease && typeof a.jlLease === "object") ? a.jlLease : null;
    var selfL = (b && b.lease && typeof b.lease === "object") ? b.lease : null;
    out.mainLastActive = Number((mainL && mainL.lastActive) || 0);
    out.mainBeat = Number((mainL && mainL.beat) || 0);
    out.selfLastActive = Number((selfL && selfL.lastActive) || 0);
    out.selfBeat = Number((selfL && selfL.beat) || 0);
    out.ok = !!(mainL || selfL);
    if (!out.ok) out.why = "两份记录都读不到";
    return out;
  }
  /* 共享时钟（`勘-七-2.4` 子文档侧公式）；退化分支 = 只用自己的活动时刻。 */
  function jlLeaseSharedIdle(now) {
    var t = (now || Date.now());
    if (JL5.forcedIdleMs !== null && isFinite(JL5.forcedIdleMs)) return Number(JL5.forcedIdleMs);   /* 装置注入 */
    var r = jlLeaseReadRecs();
    var own = Number(JL5.lastActive || 0);
    var last = own;
    if (r.ok) {
      if (r.mainLastActive > last) last = r.mainLastActive;
      if (r.selfLastActive > last) last = r.selfLastActive;
    }
    if (!last) last = Number(JL5.armAt || t);
    return Math.max(0, t - last);
  }
  function jlLeaseIdleInfo() {
    var now = Date.now();
    var r = jlLeaseReadRecs();
    var cfg = jlLeaseCfg();
    var busy = false;
    try { busy = String((KR.kernel && KR.kernel.status) || "") === "busy"; } catch (e) {}
    return { now: now, sharedIdleMs: jlLeaseSharedIdle(now), degraded: !r.ok, degradedWhy: r.why,
      lsReachable: r.ls, mainLastActive: r.mainLastActive, selfLastActive: r.selfLastActive,
      mainBeat: r.mainBeat, selfBeat: r.selfBeat, ownLastActive: Number(JL5.lastActive || 0),
      idleMs: cfg.idleMs, tickMs: cfg.tickMs, ttlMs: cfg.ttlMs, kernelBusy: busy,
      cfgSource: cfg.source, armAt: JL5.armAt, ticks: JL5.ticks };
  }
  /* 释放前同步：`jlSyncOut` 包一层墙钟上限（`JL_SYNC_RELEASE_MS`）；超时/失败 ⇒ 记录 + 仍释放。 */
  function jlLeasePreSync(conn) {
    var cap = Number(JL_SYNC_RELEASE_MS) || 5000;
    var t0 = Date.now();
    var rec = { cap: cap, ms: 0, gate: "", incomplete: null, ok: false, timeout: false, syncMs: null, err: null };
    JL5.preSync.count++;
    var timed = false;
    var toP = new Promise(function (resolve) { setTimeout(function () { timed = true; resolve("__JL_LEASE_TIMEOUT__"); }, cap); });
    var runP = Promise.resolve().then(function () { return jlSyncOut(conn); }).then(function (r) {
      rec.syncMs = r ? Number(r.ms || 0) : null;
      return r;
    }, function (e) { return { gate: "throw", incomplete: true, ms: 0, errors: [String((e && e.message) || e)] }; });
    return Promise.race([runP, toP]).then(function (v) {
      rec.ms = Date.now() - t0;
      if (v === "__JL_LEASE_TIMEOUT__" || timed === true) {
        rec.timeout = true; rec.gate = "timeout"; rec.incomplete = true;
        JL5.preSync.timeout++; JL5.preSync.ms = rec.ms;
        jlLeaseNote("释放前同步未在 " + cap + " ms 内返回 ⇒ 按 §4.6 放弃同步、**仍然释放**（不得因同步卡死回收）", "warn");
        return rec;
      }
      rec.gate = String((v && v.gate) || "");
      rec.incomplete = !!(v && v.incomplete);
      rec.err = (v && v.errors && v.errors.length) ? String(v.errors[0]) : null;
      rec.ok = (rec.gate === "pass" && rec.incomplete !== true);
      JL5.preSync.ms = rec.ms; JL5.preSync.gate = rec.gate;
      if (rec.ok) JL5.preSync.ok++;
      else {
        JL5.preSync.err++;
        jlLeaseNote("释放前同步**未成功**（gate=" + rec.gate + (rec.incomplete ? " · incomplete" : "")
          + "）⇒ 记入读数 + **仍然释放**（不静默）", "warn");
      }
      return rec;
    }, function (e2) {
      rec.ms = Date.now() - t0; rec.gate = "throw"; rec.err = String((e2 && e2.message) || e2);
      JL5.preSync.err++;
      return rec;
    });
  }
  /* 释放：释放前同步 → `kernel.shutdown()` → 逐项判定 + 可见提示。一次性（`JL5.released` 闸）。 */
  async function jlLeaseRelease(why) {
    if (JL5.released || JL5.releasing) return JL5.releaseRec;
    JL5.releasing = true; JL5.phase = "releasing"; JL5.decideAt = Date.now();
    var conn = KR.kernel;
    var cfg = jlLeaseCfg();
    var rec = { why: String(why || ""), at: Date.now() - KR.t0, idleMs: JL5.lastIdleMs, idleThresholdMs: cfg.idleMs,
      conn: conn ? String(conn.id) : null, preSync: null, shutdown: null, released: false,
      isDisposed: null, connStatus: null, withinWindow: false, err: null };
    jlLeaseNote("空闲达阈值（共享时钟 " + cfg.idleMs + " ms）⇒ 释放开始：**先**释放前同步（上限 "
      + cfg.releaseCapMs + " ms）**再** shutdown", "info");
    try { rec.preSync = await jlLeasePreSync(conn); } catch (e) { rec.preSync = { ok: false, gate: "throw" }; }
    rec.preSync = rec.preSync || { ok: false, gate: "none" };
    rec.preSync.count = JL5.preSync.count;
    rec.preSync.okTotal = JL5.preSync.ok;
    try { rec.shutdown = conn ? await jlKernelShutdown() : null; } catch (e2) { rec.err = String((e2 && e2.message) || e2); }
    try { rec.isDisposed = conn ? (conn.isDisposed === true) : false; } catch (e3) { rec.isDisposed = false; }
    try { rec.connStatus = conn ? String(conn.connectionStatus) : ""; } catch (e4) { rec.connStatus = ""; }
    if (!rec.shutdown || rec.shutdown.ok !== true) {
      /* `jlKernelShutdown` 自己已打印并落 `KR.release`；这里只补一条可见提示（不静默） */
      rec.err = rec.err || "shutdown 判定未通过（isDisposed=" + String(rec.isDisposed) + " · conn=" + rec.connStatus + "）";
    }
    rec.released = true;
    rec.withinWindow = (rec.released === true && rec.isDisposed === true && String(rec.connStatus) === "disconnected"
      && Number(JL5.preSync.count) >= 1 && Number(JL5.preSync.ok) >= 1
      && Number(rec.preSync.ms || 0) <= cfg.releaseCapMs);
    JL5.released = true; JL5.releasing = false; JL5.releaseRec = rec;
    JL5.withinWindow = rec.withinWindow; JL5.phase = rec.withinWindow ? "released" : "released-warn";
    jlLeaseNote("内核已释放：isDisposed=" + String(rec.isDisposed) + " · connectionStatus=" + String(rec.connStatus)
      + " · 释放前同步=" + (rec.preSync.ok ? "成功 " + rec.preSync.ms + " ms" : "未成功(" + rec.preSync.gate + ")")
      + " · releaseWithinWindow=" + String(rec.withinWindow), rec.withinWindow ? "info" : "warn");
    try {
      banner("Jupyter 内核已空闲回收（超过 " + Math.round(cfg.idleMs / 1000) + " 秒无活动）。"
        + "释放前已做一次同步；再次执行单元格会自动重开内核。");
      /* E11②：给本横幅打专属标记（清除时只认领它）+ 置「曾显示」旗标（`jlLeaseNoticeClear` 的判据） */
      var box5 = document.getElementById("jl-child-banner");
      if (box5 && box5.setAttribute) box5.setAttribute("data-jl-banner", "lease-recycle");
      JL5.noticeShown = true;
    } catch (e5) {}
    try { document.title = "JupyterLab（内核已空闲回收）"; } catch (e6) {}
    return rec;
  }
  function jlLeaseTickFn() {
    JL5.ticks++;
    try {
      var cfg = jlLeaseCfg();
      if (!KR.kernel) { JL5.phase = "no-kernel"; return; }
      /* 内核**启动期**（boot / 自检 / 预取）不参与空闲回收：`jlKernelStart` 的规格等待可达 90 s，
         而这段时间里"最后一次活动"是更早的启动时刻 ⇒ 若照常按阈值判，会在内核刚拿到句柄、自检还没跑完时
         就把它回收掉（长短阈值都可能有这个窗口；短阈值下必然命中）。**只挡回收，不改任何阈值语义。** */
      if (String(KR.stage) !== "done") { JL5.phase = "kernel-not-ready:" + String(KR.stage); return; }
      if (JL5.released || JL5.releasing) { JL5.phase = "done"; return; }
      var info = jlLeaseIdleInfo();
      var idle = info.sharedIdleMs, now = info.now;
      JL5.lastIdleMs = idle;
      if (JL5.minIdleSeen === null || idle < JL5.minIdleSeen) JL5.minIdleSeen = idle;
      if (idle > JL5.maxIdleSeen) JL5.maxIdleSeen = idle;
      if (info.kernelBusy && idle > JL5.maxIdleWhileBusy) JL5.maxIdleWhileBusy = idle;
      if (idle < cfg.idleMs) { JL5.phase = "idle-" + Math.round(idle / 1000) + "s"; return; }
      JL5.thresholdHits++;
      if (info.kernelBusy) {
        /* 内核正忙 ⇒ 不释放（不打断用户正在跑的执行）；下一 tick 重判。**可见**（不静默） */
        JL5.busySkips++;
        JL5.phase = "threshold-but-busy";
        if (JL5.busySkips === 1) jlLeaseNote("空闲已超阈值但内核 busy ⇒ 本 tick 不释放（下一 tick 重判）", "warn");
        return;
      }
      JL5.phase = "threshold-hit@" + (now - KR.t0);
      Promise.resolve(jlLeaseRelease("idle>=" + cfg.idleMs)).then(null, function (e) {
        if (JL5.errs.length < 20) JL5.errs.push(String((e && e.message) || e));
      });
    } catch (e2) {
      if (JL5.errs.length < 20) JL5.errs.push(String((e2 && e2.message) || e2));
    }
  }
  function jlLeaseArm() {
    var cfg = jlLeaseCfg();
    if (JL5.timer !== null) return { armed: true, already: true, tickMs: cfg.tickMs, idleMs: cfg.idleMs };
    JL5.armAt = Date.now();
    if (!JL5.lastActive) JL5.lastActive = JL5.armAt;
    /* `jlP4Report` 的 `lease.lastActive` 取自这里 ⇒ 必须把起点也补上：
       否则"从未活动过"的页面会在**每次**上报（含主页面 LS_KEY 写入触发的 `wsRev-changed` 上报）
       里用 `Date.now()` 兜底 ⇒ 子文档租约被**自我续命**、10 分钟回收永不触发。 */
    if (!JL_P4.lastActive) JL_P4.lastActive = JL5.armAt;
    JL5.timer = setInterval(jlLeaseTickFn, cfg.tickMs);
    JL5.phase = "armed";
    jlLeaseNote("空闲租约已装载：idleMs=" + cfg.idleMs + "（" + cfg.source + "）· tickMs=" + cfg.tickMs
      + " · ttlMs=" + cfg.ttlMs + " · 释放上限=" + cfg.releaseCapMs + " ms", "info");
    return { armed: true, tickMs: cfg.tickMs, idleMs: cfg.idleMs, ttlMs: cfg.ttlMs };
  }
  /* 活动 hook：`statusChanged` 的 busy/restarting（`requestExecute` 那条在 `jlSyncRequest` 里 poke）。 */
  function jlLeaseHook(conn) {
    if (!conn || conn.__jlLeaseHooked) return false;
    conn.__jlLeaseHooked = true;
    try {
      if (conn.statusChanged && typeof conn.statusChanged.connect === "function") {
        conn.statusChanged.connect(function (_, s) {
          var v = String(s);
          if (v === "busy") jlLeasePoke("status:busy");
          else if (v === "restarting") jlLeasePoke("status:restarting");
        });
      }
    } catch (e) {}
    return true;
  }
  /* ---- 读数/驱动面（子文档 realm 诊断；与 `__JL_SYNC_ACT` 同族） ---- */
  window.__JL_LEASE_STAT = function () {
    var cfg = jlLeaseCfg();
    var info = null;
    try { info = jlLeaseIdleInfo(); } catch (e) { info = { err: String((e && e.message) || e) }; }
    var lr = null;
    try { lr = (KR.release || null); } catch (e2) { lr = null; }
    var noteEl = null;
    try { noteEl = document.getElementById("jl-sync-note"); } catch (e3) { noteEl = null; }
    return {
      version: JL5.version, phase: JL5.phase, ticks: JL5.ticks, pokes: JL5.pokes,
      cfg: cfg, cfgReadonly: { defIdleMs: JL_LEASE_DEF_IDLE_MS, defTickMs: JL_LEASE_DEF_TICK_MS,
        capMs: JL_SYNC_RELEASE_MS, ttlPadTicks: JL_LEASE_TTL_PAD_TICKS },
      idle: info, lastIdleMs: JL5.lastIdleMs, minIdleSeen: JL5.minIdleSeen, maxIdleSeen: JL5.maxIdleSeen,
      maxIdleWhileBusy: JL5.maxIdleWhileBusy, thresholdHits: JL5.thresholdHits, busySkips: JL5.busySkips,
      releasing: JL5.releasing, released: JL5.released, decideAt: JL5.decideAt,
      noticeShown: JL5.noticeShown === true, noticeClearedAt: JL5.noticeClearedAt || null,
      banner: jlLeaseBannerText(),
      withinWindow: JL5.withinWindow, releaseRec: JL5.releaseRec, krRelease: lr,
      preSync: { count: JL5.preSync.count, ok: JL5.preSync.ok, err: JL5.preSync.err,
        timeout: JL5.preSync.timeout, ms: JL5.preSync.ms, gate: JL5.preSync.gate, syncMs: JL5.preSync.syncMs },
      forceDegrade: JL5.forceDegrade, forcedIdleMs: JL5.forcedIdleMs,
      kernStage: KR.stage, kernelReady: !!KR.kernel, kernelDisposed: (KR.kernel ? KR.kernel.isDisposed === true : null),
      kernelStatus: (KR.kernel ? String(KR.kernel.status) : null),
      kernelConn: (KR.kernel ? String(KR.kernel.connectionStatus) : null),
      syncDegraded: jlSyncSt().degraded, syncStat: { ioTruncated: jlSyncSt().ioTruncated,
        skippedWrites: jlSyncSt().skippedWrites, deleted: jlSyncSt().deleted },
      noteText: noteEl ? String(noteEl.textContent || "").slice(0, 300) : null,
      title: String(document.title || "").slice(0, 80),
      errs: JL5.errs.slice(0, 10), why: JL5.why, op4Reports: JL_P4.reports
    };
  };
  window.__JL_LEASE_ACT = {
    stat: function () { return window.__JL_LEASE_STAT(); },
    arm: function () { return jlLeaseArm(); },
    tick: function () { jlLeaseTickFn(); return window.__JL_LEASE_STAT(); },
    poke: function (why) { return jlLeasePoke(String(why || "act")); },
    forceDegrade: function (b) { JL5.forceDegrade = !!b; return JL5.forceDegrade; },
    forceIdle: function (ms) { JL5.forcedIdleMs = (ms === null || ms === undefined) ? null : Number(ms); return JL5.forcedIdleMs; },
    release: function (why) { return jlLeaseRelease(String(why || "act")); },
    readRecs: function () { return jlLeaseReadRecs(); },
    sharedIdle: function () { return jlLeaseSharedIdle(Date.now()); }
  };

  window.__JL_SYNC_ACT = {
    stat: function () { return jlSyncSt(); },
    diag: function () { return jlSyncDg(); },
    attach: function () { return JLS_ATTACH_INFO || jlSyncAttach(); },
    syncIn: function () { return jlSyncIn(KR.kernel); },
    forceOff: function (o) { window.__JL_SYNC_FORCE_OFF = o || { in: 0, out: 0 }; return window.__JL_SYNC_FORCE_OFF; },
    bootSrcLen: function () { return jlSyncBootSrc().length; },
    scanSrc: function () { return jlSyncScanSrc(); },
    runScan: function (conn) { return jlSyncHiddenExec(conn || KR.kernel, jlSyncScanSrc(), { budgetMs: JL_EXEC_TIMEOUT_MS }); },
    wrapInfo: function (conn) {
      var c = conn || KR.kernel;
      return { wrapped: !!(c && c.__jlSyncWrapped), bootSeen: c ? c.__jlBootSeen : null,
        nonce: c ? c.__jlNonce : null, ledgerValid: c ? c.__jlLedgerValid === true : null,
        ledgerKeys: c ? Object.keys(c.__jlLedger || {}) : null,
        queued: c ? (c.__jlQueue || []).length : null,
        depth: c ? Number(c.__jlDepth || 0) : null,
        injectedKeys: c ? Object.keys(c.__jlInjected || {}) : null,
        lastRefresh: c ? (c.__jlLastRefresh || null) : null,
        syncBootSettled: !!(c && c.__jlSyncBoot),
        /* B2-c：活跃 conn 读数（准入 ① 的判据面）+ busy/排队 + 账本 known 白名单（准入 ⑥） */
        wrappedLive: c ? jlSyncConnLive(c) : null,
        kid: c ? jlSyncKid(c) : null,
        busyMs: c ? Number(c.__jlBusyMs || 0) : null,
        pending: c ? jlSyncPendingCount(c) : null,
        known: c ? jlSyncKnownPaths(c) : null };
    },
    /* ④ 的读数/驱动面（B2-b）：手工触发一次回收边界（装置用；产品路径 = 链末自动调用） */
    out: function (conn) { return jlSyncOut(conn || KR.kernel); },
    outSrc: function (conn) { var c = conn || KR.kernel; return jlSyncOutSrc(c, jlSyncBaselineOf(c), jlSyncKnownPaths(c)); },
    refresh: function (conn) { return jlSyncRefresh(conn || KR.kernel); },
    baseline: function (conn) { return jlSyncBaselineOf(conn || KR.kernel); },
    skipHit: function (p, conn) { return jlSyncSkipHit(conn || KR.kernel, p); },
    depthCheck: function (conn) { return jlSyncDepthCheck(conn || KR.kernel, "act"); },
    put: function (path, text) { return jlSyncContentsPut(path, text); },
    del: function (path) { return jlSyncContentsDel(path); },
    snapshot: function () { return jlSyncContentsSnapshot(KR.kernel); },
    hiddenExec: function (code, opts) { return jlSyncHiddenExec(KR.kernel, code, opts || {}); },
    /* P-C15 用：连发两次请求（都经包装 ⇒ 第二格排队），结清读数落 window.__JL_QST */
    twoQueued: function () {
      var conn = KR.kernel;
      var st = { q1: { settled: false, status: null }, q2: { settled: false, status: null },
        kernelStatusAt: null, queuedNow: 0 };
      window.__JL_QST = st;
      var f1 = conn.requestExecute({ code: "import time\nprint('__Q1__')\ntime.sleep(2)", silent: false,
        store_history: true, user_expressions: {}, allow_stdin: false, stop_on_error: true }, true);
      var f2 = conn.requestExecute({ code: "print('__Q2__')", silent: false, store_history: true,
        user_expressions: {}, allow_stdin: false, stop_on_error: true }, true);
      f1.onReply.connect(function (_, m) { st.q1.status = String((m && m.content && m.content.status) || ""); });
      f2.onReply.connect(function (_, m) { st.q2.status = String((m && m.content && m.content.status) || ""); });
      Promise.resolve(f1.done).then(function () { st.q1.settled = true; }, function () { st.q1.settled = "rejected"; });
      Promise.resolve(f2.done).then(function () { st.q2.settled = true; }, function () { st.q2.settled = "rejected"; });
      window.__JL_Q1 = f1;
      window.__JL_Q2 = f2;
      st.queuedNow = (conn.__jlQueue || []).length;
      return { queuedNow: st.queuedNow };
    },
    settled: function () {
      var st = window.__JL_QST || {};
      var c = KR.kernel;
      return { q1: st.q1 || null, q2: st.q2 || null, kernelStatus: c ? String(c.status) : null,
        connStatus: c ? String(c.connectionStatus) : null, queueLen: (c && c.__jlQueue || []).length,
        degraded: jlSyncSt().degraded, ledgerValid: c ? c.__jlLedgerValid === true : null };
    },
    interrupt: function () { return KR.kernel.interrupt(); },
    restart: function () { return KR.kernel.restart(); },
    exec: function (code, opts) { return jlKernelExec(code, opts || {}); },
    queueLen: function () { return (KR.kernel && KR.kernel.__jlQueue || []).length; }
  };

  /* ---- 段表解码 ---- */
  function parseSections(raw) {
    var out = [], re = /\n;;;JLITE-SECTION ([^\n]*) ([a-z0-9]+) (\d+)\n/g, m;
    while ((m = re.exec(raw)) !== null) {
      out.push({ id: m[1], kind: m[2], chars: parseInt(m[3], 10), body: raw.substr(m.index + m[0].length, parseInt(m[3], 10)) });
    }
    return out;
  }

  /* ---- 配置合并(⌜P5⌝ 自研版;与上游 config-utils 的等价物,但取值来自已解码段) ---- */
  function cfgDataOf(id) {
    var t = TEXT[id];
    if (t == null) return null;
    var j = null;
    try { j = JSON.parse(t); } catch (e) { return null; }
    if (!j) return null;
    var lite = /\.ipynb$/.test(id) ? (j.metadata && j.metadata["jupyter-lite"]) : j;
    return (lite && lite["jupyter-config-data"]) || null;
  }
  function fixCfg(cfg, urlBase) {
    var out = {}, k, v, p;
    for (k in cfg) {
      if (!Object.prototype.hasOwnProperty.call(cfg, k)) continue;
      v = cfg[k];
      if (k === "litePluginSettings" || k === "settingsOverrides") {
        var sub = {};
        for (p in (v || {})) { if (Object.prototype.hasOwnProperty.call(v, p)) sub[p] = fixCfg(v[p] || {}, urlBase); }
        out[k] = sub;
      } else if (UNPREFIXED.indexOf(k) < 0 && /Url$/.test(k) && typeof v === "string" && v.indexOf("./") === 0) {
        out[k] = urlBase + v.slice(2);
      } else if (/Urls$/.test(k) && Object.prototype.toString.call(v) === "[object Array]") {
        out[k] = v.map(function (x) {
          return (typeof x === "string" && x.indexOf("./") === 0) ? (urlBase + x.slice(2)) : x;
        });
      } else {
        out[k] = v;
      }
    }
    return out;
  }
  function mergeCfg(memo, cfg) {
    var k, v, p;
    for (k in cfg) {
      if (!Object.prototype.hasOwnProperty.call(cfg, k)) continue;
      v = cfg[k];
      if (k === "disabledExtensions" || k === "federated_extensions") {
        memo[k] = (memo[k] || []).concat(v || []);
      } else if (k === "litePluginSettings" || k === "settingsOverrides") {
        if (!memo[k]) memo[k] = {};
        for (p in (v || {})) {
          if (!Object.prototype.hasOwnProperty.call(v, p)) continue;
          /* 逐键一级合并(上游 mergeOneConfig 的同款语义:{...memo[k][p], ...defaults}) */
          var merged = {}, q, src = memo[k][p] || {};
          for (q in src) { if (Object.prototype.hasOwnProperty.call(src, q)) merged[q] = src[q]; }
          var add = v[p] || {};
          for (q in add) { if (Object.prototype.hasOwnProperty.call(add, q)) merged[q] = add[q]; }
          memo[k][p] = merged;
        }
      } else {
        memo[k] = v;
      }
    }
    return memo;
  }
  function buildConfig() {
    /* 目录表 = 上游 config-utils.js 的 HERE → FULL_LITE_ROOT 走链(段正文见载荷 config-utils.js):
       · `prefix` 参与段 id —— 少了它 /lab/ 那一轮会**再读一遍根配置**并按 `/lab/` 二次前缀,
         于是 fullStaticUrl 变 `/lab/build`、fullLabextensionsUrl 变 `/lab/extensions`
         ⇒ Webpack 去取 `/lab/build/*.js` 而载荷里只有 `build/*.js`,整片 chunk miss、应用起不来;
         lab/ 目录自己的 jupyter-lite.json 同时**从未被读到**(appUrl/settingsUrl/themesUrl 全丢)。
       · `base` = 该目录路径,喂 fixRelativeUrls(`./` 前缀值按此拼;UNPREFIXED 的两键不拼) */
    var dirs = [
      { base: "/", prefix: "", files: LITE_FILES },
      { base: "/lab/", prefix: "lab/", files: LITE_FILES }
    ];
    var cfg = {};
    var i, j, id, one;
    for (i = 0; i < dirs.length; i++) {
      for (j = 0; j < dirs[i].files.length; j++) {
        id = dirs[i].prefix + dirs[i].files[j];
        one = cfgDataOf(id);
        if (one) mergeCfg(cfg, fixCfg(one, dirs[i].base));
      }
    }
    /* faviconUrl 剔除:它的虚拟路径由**渲染栈**发起、不经任何垫片(§0.5)⇒ 会打到网络层。
       骨架已写死内联 data: 图标(§2.7.2),故这里不再引用站点图标 */
    if (cfg.faviconUrl) delete cfg.faviconUrl;
    return cfg;
  }

  /* ---- 就绪链(§2.6.1 A;Phase 2 只到 S1:句柄 + restored + serviceManager.ready) ---- */
  async function jlAppWaitReady() {
    var t0 = Date.now(), app = null;
    while (true) {
      app = window.jupyterapp || null;
      if (app && app.restored && app.serviceManager) break;
      if (Date.now() - t0 > APP_READY_MS) break;
      await sleep(200);
    }
    if (!app) throw new Error("window.jupyterapp 未出现(exposeAppInBrowser 未注入或引导失败)");
    await app.restored;
    await app.serviceManager.ready;
    return app;
  }

  /* ---- 主流程 ---- */
  DIAG.phase = "shims";
  installShims();

  DIAG.phase = "decode";
  if (typeof DecompressionStream !== "function") { fatal("当前浏览器没有 DecompressionStream,JupyterLite 载荷无法解压。"); return; }
  var secs = parseSections(hostRaw);
  DIAG.sectionCount = secs.length;
  if (!secs.length) { fatal("载荷里没有任何段(帧格式不符)。"); return; }
  var i, s, u8;
  for (i = 0; i < secs.length; i++) {
    s = secs[i];
    try {
      u8 = (s.kind === "text") ? new TextEncoder().encode(s.body) : await gunzip(b64ToBytes(s.body));
    } catch (e) {
      DIAG.err.push("段 " + s.id + " 解码失败: " + e.message);
      fatal("段 \"" + s.id + "\" 解码失败:" + e.message);
      return;
    }
    SEG[s.id] = u8;
    TEXT[s.id] = textOf(u8);
  }
  DIAG.segCount = Object.keys(SEG).length;
  if (!TEXT[BUNDLE_PATH]) { fatal("载荷里没有主 bundle(" + BUNDLE_PATH + "),无法引导 JupyterLab。"); return; }

  DIAG.phase = "config";
  var cfgScript = document.getElementById("jupyter-config-data");
  var cfg = buildConfig();
  DIAG.configKeys = Object.keys(cfg).length;
  DIAG.exposeAppInBrowser = cfg.exposeAppInBrowser === true;
  if (cfgScript) cfgScript.textContent = JSON.stringify(cfg, null, 2);
  if (!DIAG.exposeAppInBrowser) banner("配置里没有 exposeAppInBrowser:应用不会暴露句柄,后续的文件同步与内核直连都不可用。");
  window.__JL_CONFIG = cfg;

  /* 此处 = 段表解码 + 配置注入完成(§5.2 的子文档 boot 标志;与 __JL_APP_READY 含义不同,不得混用) */
  window.__JL_READY = true;
  DIAG.phase = "bundle";
  var bs = document.createElement("script");
  bs.async = false;
  bs.src = BUNDLE_PATH;
  document.head.appendChild(bs);

  DIAG.phase = "app";
  try {
    /* ⌜Phase 3⌟ 内核资产预取:内核启动的 boot 子集需要宿主段 asm 工厂(同步投递 ⇒ 必须先备好)。
       失败不阻断应用就绪 —— 内核启动时会以可见错误收场(错误路径不静默) */
    var appReady = await jlAppWaitReady();
    jlCorePrefetch();
    window.__JL_APP_READY = true;
    jlSyncAttach(appReady);   /* B2-a 挂点:必须在 jlKernelBoot 之前装(直连臂也要过包装) */
    jlP4Install();            /* Phase 4:跨页键上报（只读 wsRev / 只写 LS_KEY+":jl"）+ wantPath 承接 */
    jlLeaseArm();             /* Phase 5:空闲租约定时器装载（tick 内自查 KR.kernel ⇒ 内核未起时自然空转） */
    DIAG.phase = "ready";
    devlog("app ready");
    /* 内核就绪是**另一件事**(§2.6.1 A):__JL_READY / __JL_APP_READY 都不是内核就绪信号。
       异步启动 ⇒ 不阻塞上面两个就绪标记(Phase 2 的判据面因此逐字不变) */
    Promise.resolve(PYCORE.promise).then(function () { return jlKernelBoot(appReady); }).then(null, function (e) {
      krFail("kernel.boot", e);
    });
  } catch (e) {
    window.__JL_APP_ERR = String((e && e.message) || e);
    DIAG.err.push("应用未就绪: " + window.__JL_APP_ERR);
    fatal("JupyterLab 应用未能就绪:" + window.__JL_APP_ERR);
  }
}

function jlChildBootScript() {
  /* 只做一件事:把子文档侧那一段代码**原样**变成文本(不拼字符串模板 ⇒ 语法/静态检查都覆盖得到) */
  return "(" + jlChildMain.toString() + ")();";
}

/* ---------------------------------------------------------------------------
   27.5 宿主侧:开标签页 / 引导 / 句柄
--------------------------------------------------------------------------- */
function jlLabHandle() { return JL_LAB_WIN; }
function jlLabAlive() { var w = JL_LAB_WIN; return !!(w && !w.closed); }
function jlLabHandleDrop() {
  jlLabWantWatchStop();   /* J-TAB-2:句柄没了 ⇒ 停读回执(seq **不**归零:旧回执不得吞掉新 want) */
  JL_LAB_WIN = null; JL_LAB_WS = null; JL_LAB_PATH = null;
}
function jlLabFocus() {
  if (!jlLabAlive()) return false;
  try { JL_LAB_WIN.focus(); } catch (e) {}
  return true;
}

/* ---------------------------------------------------------------------------
   27.5.0 J-TAB-2:「打开指定文件」(want)的投递 / 回执 / 读数
   通道(§6.2 红线逐条对齐 —— **不新增任何对外接口**):
     · 投递 = **既有 `#jl-open-params` 载体**(宿主写**子文档** `w.document` 里那条 `text/plain` JSON)
       —— 与引导时 `jlHostBoot` 完全同一条通道:首开写一次,**已有标签页时重写同一元素**(序 seq 递增)。
       以下一律**不做**:window API / `postMessage` / `BroadcastChannel` / HTTP 端点 / 新 localStorage 键。
     · 承接 = 子页**现读**(不走自己的缓存)+ 轮询 + `visibilitychange`(见 `jlChildMain` 的 `jlP4Want*` 族)。
     · 回执 = 同一元素的 `data-jl-want`(子页写**自己**的文档,宿主同源直读;同族先例 = 宿主读子页
       `#jl-sync-note`)。只用于**幂等**(同一件在飞 ⇒ 不重复投递 / 不重复提示)与**可见反馈**
       (超时 / 失败在主页面也提示),**不作**打开判据。
   为什么必须"重写载体":子页的 `jlP4Params()` 把首次读到的对象缓存了 ⇒ 只有**现读**才看得见新 want。
--------------------------------------------------------------------------- */
function jlLabParamsPayload() {
  return JSON.stringify({
    v: 1, wsId: JL_LAB_WS, wantPath: JL_LAB_PATH, wantSeq: JL_LAB_WANT_SEQ, wantAt: JL_LAB_WANT_AT,
    lsKey: LS_KEY, wsRev: jlMirrorWsRevNow(), tickMs: JL_MIRROR_TICK_MS,
    /* Phase 5:租约阈值/tick 由宿主注入(子文档 realm 读不到 appE 的 `PY_IDLE_MS` / `PY_IDLE_TICK`) */
    idleMs: JL_LEASE_IDLE_MS, leaseTickMs: JL_LEASE_TICK_MS,
    wantMs: JL_LAB_WANT_OPEN_MS,   /* J-TAB-2:子页"等落位"预算(口径权威在宿主,子页只做默认值) */
    at: Date.now()
  });
}
/* 跨页参数的**唯一写者**(§2.5):首开与"已有标签页时重投 want"共用;子页现读 ⇒ 落地即见 */
function jlLabParamsWrite(doc) {
  if (!doc) return false;
  var el = doc.getElementById("jl-open-params");
  if (!el) {
    el = doc.createElement("script");
    el.id = "jl-open-params";
    el.type = "text/plain";
    (doc.head || doc.documentElement).appendChild(el);
  }
  el.textContent = jlLabParamsPayload();
  return true;
}
/* want 的**唯一递增点**(§2.5):空路径 = 不投 want(点按钮开页时走这条) */
function jlLabWantSet(path) {
  if (!path) { JL_LAB_PATH = null; JL_LAB_WANT_AT = 0; return null; }
  JL_LAB_WANT_SEQ++;
  JL_LAB_PATH = String(path);
  JL_LAB_WANT_AT = Date.now();
  return { seq: JL_LAB_WANT_SEQ, path: JL_LAB_PATH, at: JL_LAB_WANT_AT };
}
/* 读子页回执(`data-jl-want`);取不到一律当"无回执"⇒ 照常投递(绝不吞点击) */
function jlLabWantAck() {
  if (!jlLabAlive()) return null;
  try {
    var d = JL_LAB_WIN.document;
    var el = d ? d.getElementById("jl-open-params") : null;
    var raw = (el && el.getAttribute) ? el.getAttribute("data-jl-want") : null;
    if (!raw) return null;
    var o = JSON.parse(raw);
    return (o && typeof o === "object") ? o : null;
  } catch (e) { return null; }
}
function jlLabWantReadout(ack) {
  return { seq: JL_LAB_WANT_SEQ, path: JL_LAB_PATH, at: JL_LAB_WANT_AT, watching: JL_LAB_WANT_TIMER !== null,
    ack: ack ? { seq: Number(ack.seq || 0), path: String(ack.path || ""), status: String(ack.status || ""),
      ms: Number(ack.ms || 0), already: ack.already === true, dup: ack.dup === true,
      err: String(ack.err || "").slice(0, 140), at: Number(ack.at || 0) } : null };
}
function jlLabWantPub(ack) { jlMirrorPub("want", JSON.stringify(jlLabWantReadout(ack))); }
/* 短时 tick(**只在有在飞 want 时存在**):读回执 ⇒ 发布读数 / 失败可见 / 终态即停 */
function jlLabWantNote() {
  if (!jlLabAlive()) { jlLabWantWatchStop(); jlLabWantPub(null); return null; }
  var ack = jlLabWantAck();
  jlLabWantPub(ack);
  if (ack && Number(ack.seq || 0) === JL_LAB_WANT_SEQ) {
    var st = String(ack.status || "");
    if (st === "opened" || st === "failed") {
      var mark = String(ack.seq) + ":" + st;
      if (JL_LAB_WANT_MARK !== mark) {
        JL_LAB_WANT_MARK = mark;
        if (st === "failed") toast("JupyterLab 里打开失败:" + String(ack.err || ""), "warn", 9000);
      }
      jlLabWantWatchStop();
      jlLabWantPub(ack);   /* 停后再发一次:让读数里的 `watching` 落到 false */
      return ack;
    }
    /* 有回执但久无终态 ⇒ 子页那边卡住了(它的门预算更短,正常不会走到这里) */
    if (Date.now() - Number(ack.at || 0) > JL_LAB_WANT_WATCH_MS) {
      jlLabWantWatchStop();
      jlLabWantPub(ack);
      if (JL_LAB_WANT_MARK !== String(JL_LAB_WANT_SEQ) + ":stuck") {
        JL_LAB_WANT_MARK = String(JL_LAB_WANT_SEQ) + ":stuck";
        toast("JupyterLab 标签页打开该文件用时过长:可稍后在标签页里再试", "warn", 9000);
      }
    }
    return ack;
  }
  /* 连回执都没有:子页可能还在装载(首开 ≈12 s)⇒ 上限放宽到 BOOT;超了就是脚本没跑起来。
     `WANT_AT > 0` 是**前置守卫**:无 want(面板按钮开页)时 `jlLabWantSet(null)` 把 AT 归 0
     ⇒ `now - 0` 恒 > BOOT ⇒ 首个 tick 就误报"没有回应"(J-TAB-2 假警告的成因) */
  if (JL_LAB_WANT_AT > 0 && Date.now() - JL_LAB_WANT_AT > JL_LAB_WANT_BOOT_MS) {
    jlLabWantWatchStop();
    jlLabWantPub(null);
    if (JL_LAB_WANT_MARK !== String(JL_LAB_WANT_SEQ) + ":noack") {
      JL_LAB_WANT_MARK = String(JL_LAB_WANT_SEQ) + ":noack";
      toast("JupyterLab 标签页没有回应打开请求:请在该标签页里手动打开该文件", "warn", 9000);
    }
  }
  return ack;
}
function jlLabWantWatchStart() {
  if (JL_LAB_WANT_TIMER === null) JL_LAB_WANT_TIMER = setInterval(jlLabWantNote, JL_LAB_WANT_POLL_MS);
  jlLabWantPub(null);
}
function jlLabWantWatchStop() {
  if (JL_LAB_WANT_TIMER !== null) { clearInterval(JL_LAB_WANT_TIMER); JL_LAB_WANT_TIMER = null; }
}
function jlLabWantName(p) {
  var s = String(p || ""), i = s.lastIndexOf("/");
  return (i >= 0 && i < s.length - 1) ? s.slice(i + 1) : s;
}

/* §2.3 jlHostBoot(doc, openerRef):把子文档引导起来 —— 写骨架(⌜P6⌝)+ 写引导脚本(子文档 realm) */
function jlHostBoot(doc, openerRef) {
  JL_LAB_WIN = openerRef || null;
  if (openerRef) {
    try { openerRef.addEventListener("pagehide", jlLabHandleDrop, false); } catch (e) {}
  }
  try {
    doc.open();
    doc.write(jlSkeletonHtml());
    doc.close();
  } catch (e) {
    return "写子文档骨架失败: " + ((e && e.message) || e);
  }
  try {
    var s = doc.createElement("script");
    s.id = JL_BOOT_SCRIPT_ID;
    s.textContent = jlChildBootScript();
    (doc.head || doc.documentElement).appendChild(s);
  } catch (e2) {
    return "写子文档引导脚本失败: " + ((e2 && e2.message) || e2);
  }
  /* Phase 4：把跨页键的**常量**投给子文档（§2.9「键名由宿主注入、子文档不硬编码」）+
     需求 3 的 `#jl-open-params` 承接（`wantPath` 由子文档经 `docmanager:open` 消费）。
     J-TAB-2：构造与落盘收进 `jlLabParamsWrite()`（唯一写者）—— 已有标签页时**重写同一元素**投新 want。 */
  var wrote = false;
  try { wrote = jlLabParamsWrite(doc); } catch (e3) { return "写跨页参数失败: " + ((e3 && e3.message) || e3); }
  if (!wrote) { return "写跨页参数失败: 子文档不可写"; }
  return "";
}

/* §2.3 jlLabOpen(wsId, wantPath):开/聚焦 Jupyter 标签页。
   `wantPath` 非空 = 打开后**真的打开**该文件 —— 首开经 `#jl-open-params` 载体 + 子页"等落位";
   **已有标签页时重写同一载体**(J-TAB-2:此前只 `jlLabFocus()` + 一条提示 ⇒ 目标文件永远打不开)。 */
function jlLabOpen(wsId, wantPath) {
  var a = jlAvailable();
  if (!a.ok) { toast("JupyterLab 不可用:" + a.reason, "warn", 6000); return false; }
  if (jlLabAlive()) {
    jlLabFocus();
    var path = wantPath ? String(wantPath) : "";
    if (!path) {
      toast("JupyterLab 已在新标签页中打开(同一个标签页跟随一个工作区)", "info", 3600);
      return true;
    }
    /* 幂等:子页正为**同一件**在飞 ⇒ 只聚焦(不重复投递、不重复提示)。
       ⚠ 回执必须**新鲜** —— 陈旧回执(例如子页脚本已死)不能把后续点击永久吞掉。 */
    var ack = jlLabWantAck();
    if (ack && String(ack.path || "") === path && String(ack.status || "") === "opening"
      && (Date.now() - Number(ack.at || 0)) <= JL_LAB_WANT_OPEN_MS) {
      jlLabWantPub(ack);
      return true;
    }
    jlLabWantSet(path);
    var okSend = false;
    try { okSend = jlLabParamsWrite(JL_LAB_WIN.document); } catch (e) { okSend = false; }
    if (!okSend) {
      JL_LAB_PATH = null; JL_LAB_WANT_AT = 0;
      toast("无法把打开请求投递到 JupyterLab 标签页(跨文档写被拒):请在该标签页里手动打开该文件", "warn", 8000);
      return false;
    }
    /* J-TAB-2:只有**真投了 want** 才开监视 —— 无 want 的调用点(面板按钮)走上面早退,
       这里加守卫是纵深(万一将来新增无 want 的入口,也不会生出"等回执"的假窗口) */
    if (JL_LAB_PATH) jlLabWantWatchStart();
    var childReady = false;
    try { childReady = JL_LAB_WIN.__JL_APP_READY === true; } catch (e3) { childReady = false; }
    /* 幂等(提示面):**同一件已经打开过**再点 ⇒ 照常投递(只为把它带到前台),但**不重复弹提示** */
    var quiet = !!(ack && String(ack.path || "") === path && String(ack.status || "") === "opened");
    if (!quiet) {
      toast(childReady
        ? ("已在 JupyterLab 标签页中打开:" + jlLabWantName(path))
        : ("JupyterLab 标签页还在装载:装载完成后会自动打开 " + jlLabWantName(path)), "info", 3600);
    }
    return true;
  }
  if (JL_LAB_OPENING) return false;
  JL_LAB_OPENING = true;
  var w = null;
  try {
    /* **同步**开页:保留用户手势(无头下另需 --disable-popup-blocking);**不传 noopener**(否则 opener 为 null) */
    w = window.open("about:blank");
  } catch (e) { w = null; }
  if (!w) {
    JL_LAB_OPENING = false;
    toast("新标签页被浏览器拦住:请允许本页弹出窗口后重试", "warn", 6000);
    return false;
  }
  JL_LAB_WS = wsId || null;
  /* R2 改动 4-A（P0-1 闭合）：**换绑即作废内存基线/墓碑** —— 旧绑定的 `BASE`/`GONE` 会被沿用，
     `BASE_WS === JL_LAB_WS` 出现"陈旧等价" ⇒ 误判用户删除。只置"未载入"，KV 不动（下个 tick 重载）。 */
  JL_MIRROR_STAT_LOADED = false;
  JL_MIRROR_BASE = {};
  JL_MIRROR_GONE = {};
  JL_MIRROR_BASE_WS = null;
  jlLabWantSet(wantPath);   /* J-TAB-2:want 的唯一登记点(seq 递增 + wantAt);无 want 时清空 */
  var err = "";
  try { err = jlHostBoot(w.document, w); } catch (e2) { err = "引导异常: " + ((e2 && e2.message) || e2); }
  JL_LAB_OPENING = false;
  if (err) {
    toast("JupyterLab 引导失败:" + err, "error", 8000);
    return false;
  }
  jlMirrorStart();     /* Phase 4:跨页文件镜像 + 跨页刷新（tick 自终止:标签页关闭即停） */
  /* J-TAB-2:首开也读回执 ⇒ "打开失败/无回应"在主页面同样可见(不静默)。
     **有 want 才开监视** —— 面板按钮开页时 `jlLabWantSet(null)` 已把 PATH/AT 归零,
     开了也只会立刻拿 `now - 0` 判"没回应"(P1 假警告),故守卫掉 */
  if (JL_LAB_PATH) jlLabWantWatchStart();
  if (!JL_TIP_SHOWN) {
    JL_TIP_SHOWN = true;
    toast("JupyterLab 已在新标签页打开:该页刷新即白页、也无法收藏(请从主页面重新打开);内核的 input() 不可用。", "info", 9000);
  }
  return true;
}

/* ---------------------------------------------------------------------------
   27.6 UI 挂点(§2.4 DOM 契约)
   · 按钮在 head.part 的 .wsr-head 内、#btn-wsr-close **之前**(= 视觉左侧)
   · 降级:载荷缺失 / 无 DecompressionStream / 无 Blob+Worker ⇒ hidden + 状态写进 data-* 属性
     (不新增 window 全局:§6.2「页面不对外暴露任何接口」;读数走 DOM)
--------------------------------------------------------------------------- */
function jlUiInit() {
  var btn = document.getElementById("btn-wsr-jupyter");
  if (!btn) return;
  var a = jlAvailable();
  btn.hidden = !a.ok;
  btn.setAttribute("data-jl-available", a.ok ? "true" : "false");
  btn.setAttribute("data-jl-reason", a.ok ? "" : a.reason);
  if (!a.ok) {
    devlogHost("JupyterLab 标签页不可用:" + a.reason);
    return;
  }
  btn.addEventListener("click", function () {
    if (!WS_RAIL_SEL) { toast("请先创建或选择一个工作区", "warn"); return; }
    jlLabOpen(WS_RAIL_SEL, null);
  });
}
/* 主页面侧的 dev 日志:debug 级(不进 error 统计,但留档可查) */
function devlogHost(s) { try { console.debug("[jl] " + s); } catch (e) {} }

jlUiInit();

/* ===========================================================================
   27.7 Phase 4：文件互通（Contents ⇄ 工作区 `wsfiles` 镜像）+ 跨页刷新
   契约来源（逐条）：
     · §2.5 存储契约：工作区文件 = **主页面唯一写者**（既有 WS API）/ JupyterLite 内容 =
       Jupyter 标签页唯一写者（经 drive 公共 API）⇒ 镜像**无双写**：主页面只**读** Contents、
       只**写** `wsfiles`；**对 Contents 的写入也由主页面执行**（裁定 P2-4 第 2 条：
       「推送统一由主页面执行」，子文档侧不存在可 `await` 的写队列）。
     · §2.8 镜像协议三件套：**同步基线**（`jl:base:<ws>`）+ **显式墓碑**（`jl:gone:<ws>`）+
       两条反向断言（新建后 1 s 内的 tick 不得删掉它 / 对侧删除后本侧不得复活）。
       **只有「基线内存在、现在缺失」才判删除**；基线缺失（首启 / `pyCacheClear` 之后）⇒
       保守口径：不判删除，先做一遍并集合并。
     · §2.9 跨页键：`LS_KEY` 新增 `wsRev`（**主页面单写者**、指纹比对 bump、只增不减）；
       子文档**只读** `wsRev`、**只写** `LS_KEY+":jl"`（子文档侧实现见 27.4 的 `jlP4*`）。
     · §4.4 / §4.3 的回声抑制 = **值比对为主 + 计数式为辅**（内容相同 ⇒ 绝不回写）。
     · `pyocache` 承载 `jl:` 键：**不新增 store、不升 `IDB_VER`**（[E5] 铁律）⇒ 复用 appE 的
       通用事务助手 `wsStoreTx(IDB_PYC, …)`，记录形态为 `{name, data:<json string>, at, jl:1}`
       （**不写 `bytes`/`size` 字段** ⇒ `pyCacheStats` 的字节读数不被污染；`pyCacheClear` 会一并
       清掉它们 ⇒ 基线缺失走 §2.8-1 的保守口径，自愈）。
     · ⑤ `filebrowser:refresh` 的**真正实现**：主页面驱动的 Contents 写入 ⇒ 由**主页面**在子文档
       app 上执行该命令（B2-a/b 只调它、不保证主页面驱动的那条腿也被刷新）。
   ES5 + `var` + `function`；仅网络/工具执行层用 async/await（与本文件既有同步段一致）。
   ⚠️ 读数面走 DOM（§2.4）：`#btn-wsr-jupyter` 的 `data-jl-mirror*` 属性 —— **不新增 window 全局**。
--------------------------------------------------------------------------- */
var JL_MIRROR_TICK_MS = 1000;              /* 镜像 tick（§2.8-4 的 tick 契约;取 1 s 以便 P-C3b ≤3 s 可见） */
var JL_MIRROR_TICK_MAX_MS = 8000;          /* 单 tick 墙钟上限 ⇒ 强制释放守卫 + 可见提示（不静默） */
var JL_MIRROR_MAX_FILES = 2000;            /* **Contents 侧**单轮文件数上限（对齐 JL_SYNC_MAX_FILES）
   ⚠️ **P0-1 登记项（声明与能力不符,如实登记；本批不擅自改 `appE.part`）**：本值对**工作区侧**不成立 ——
   `jlMirrorListWs` 把 `limit: JL_MIRROR_MAX_FILES` 传给 `wsListDir`，而后者（`appE.part:3102`
   `clampNum(opts.limit, 1, WS_LIST_MAX, WS_LIST_DEF)`）把 limit **硬夹到 `WS_LIST_MAX`（`appE.part:2305` = 500）**
   ⇒ 工作区每轮最多只列到 500 条（读数面 = `out.shown` / `out.total`；`total > shown` 即证），
   `next_offset` 非空 ⇒ `truncated = true`。工作区条目 >500 即常态触发（见下方删除轮闸）。 */
var JL_MIRROR_MAX_DEPTH = 8;               /* 单轮递归深度上限（对齐 JL_SYNC_MAX_DEPTH；`GLOB_MAX_DEPTH` 同为 8） */
var JL_MIRROR_MAX_BYTES = 16 * 1024 * 1024;/* 单件字节上限（对齐 JL_SYNC_MAX_BYTES_*） */
var JL_MIRROR_GONE_TICKS = 20;             /* 墓碑保留 20 tick（§2.8-2,≈20 s） */
var JL_MIRROR_KV_BASE = "jl:base:";        /* pyocache 键前缀（§2.5/§2.9） */
var JL_MIRROR_KV_GONE = "jl:gone:";
var JL_MIRROR_JLKEY = ":jl";
var JL_MIRROR_DENY_SEGS = ["site-packages", "dist-packages", "__pycache__", "node_modules",
  ".git", ".ipython", ".cache", ".local", ".jupyter", ".azusa-sync"];
var JL_MIRROR_TICK = null;
var JL_MIRROR_BUSY = false;
var JL_MIRROR_TICKS = 0, JL_MIRROR_SKIP_BUSY = 0, JL_MIRROR_KICKS = 0, JL_MIRROR_DEADLINE_HITS = 0;
var JL_MIRROR_PULL_WRITES = 0, JL_MIRROR_PUSH_WRITES = 0, JL_MIRROR_DELS = 0, JL_MIRROR_SAME = 0;
var JL_MIRROR_TRUNC_TICKS = 0;             /* 截断 tick 计数（P0-1 闸的读数面：>0 ⇒ 删除面被闭） */
var JL_MIRROR_TOMB_DELS = 0;               /* C-7 的"删 Contents 副本"计数（墓碑命中且本侧确无） */
var JL_MIRROR_USER_DELS = 0;   /* P0-2：用户显式删除意图命中数（基线内 ∧ 本侧权威确无） */
var JL_MIRROR_CONFLICTS = 0;   /* 乙-1（R2 并入 J3a）：冲突轮计数（两侧自基线以来都变过） */
var JL_MIRROR_CONFLICT_TOAST_AT = 0, JL_MIRROR_CONFLICT_TOAST_MS = 8000;   /* 冲突提示限频（同窗只提示一次） */
var JL_MIRROR_NUDGED = 0, JL_MIRROR_NUDGE_SKIPPED = 0, JL_MIRROR_NUDGE_FAILED = 0, JL_MIRROR_NUDGE_LAST_MS = 0;
   /* 乙-2：打开文档跟随三计数 + 最近一次成功 revert 的墙钟毫秒（0 = 尚无读数） */
var JL_MIRROR_ERR = "", JL_MIRROR_WHY = "", JL_MIRROR_LAST = null, JL_MIRROR_FIRSTWRITE = null;
var JL_MIRROR_BASE = {}, JL_MIRROR_GONE = {}, JL_MIRROR_STAT_LOADED = false, JL_MIRROR_BASE_WS = null;
var JL_MIRROR_JLREV = 0, JL_MIRROR_READY = false, JL_MIRROR_REFRESHES = 0;
var JL_WSREV_FP = null, JL_WSREV_VAL = -1, JL_WSREV_BUMPS = 0;

function jlMirrorBtn() { return document.getElementById("btn-wsr-jupyter"); }
function jlMirrorPub(k, v) {
  var b = jlMirrorBtn();
  if (!b) return;
  try { b.setAttribute("data-jl-mirror-" + k, String(v == null ? "" : v).slice(0, 900)); } catch (e) {}
}
function jlMirrorSegs(p) {
  var s = String(p || "").split("/"), out = [], i;
  for (i = 0; i < s.length; i++) { if (s[i] !== "") out.push(s[i]); }
  return out;
}
function jlMirrorDenied(p) {
  var seg = jlMirrorSegs(p), i;
  for (i = 0; i < seg.length; i++) { if (JL_MIRROR_DENY_SEGS.indexOf(seg[i]) >= 0) return seg[i]; }
  return null;
}
function jlMirrorDirOf(p) {
  var s = String(p || ""), i = s.lastIndexOf("/");
  return i <= 0 ? "/" : s.slice(0, i);
}
function jlMirrorBytesB64(u8) {
  var s = "", CH = 8192, i;
  for (i = 0; i < u8.length; i += CH) { s += String.fromCharCode.apply(null, u8.subarray(i, i + CH)); }
  return btoa(s);
}
function jlMirrorB64Bytes(b64) {
  var bin = atob(String(b64 == null ? "" : b64)), i, u8 = new Uint8Array(bin.length);
  for (i = 0; i < bin.length; i++) u8[i] = bin.charCodeAt(i) & 0xff;
  return u8;
}
function jlMirrorB64Text(b64) {
  try { return new TextDecoder("utf-8").decode(jlMirrorB64Bytes(b64)); } catch (e) { return null; }
}
function jlMirrorBlobB64(blob) {
  return new Promise(function (resolve) {
    try {
