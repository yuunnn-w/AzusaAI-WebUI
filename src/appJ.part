  function jlKernelPreludeSrc() {
    if (PRELUDE_SRC) return PRELUDE_SRC;
    var src = "(" + jlKernelPrelude.toString() + ")();\n";
    try { new Function(src); } catch (e) {
      PRELUDE_ERR = "prelude 语法错误:" + ((e && e.message) || e);
      KR.errors.push(PRELUDE_ERR);
    }
    PRELUDE_SRC = src;
    return src;
  }
  function jlKernelPrelude() {
