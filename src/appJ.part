  }
}
function jlMirrorStatChild(cs, path) {
  return Promise.resolve(cs.get(path, { content: false })).then(function (m) {
    return { ok: true, size: (m && m.size) || 0, lm: jlMirrorLmMs(m && m.last_modified) };
  }, function (e) {
    var st = (e && e.response && e.response.status) || 0;
    var msg = String((e && e.message) || e);
    /* `miss` = **对端明确说"没有这个路径"**（404 语义）—— 与"读失败/超时"区分开:
       只有前者才可以被读作"删除意图"（§2.8-1/2 与 A14② 的判据基础） */
    var miss = (st === 404) || /not found|404|does not exist|no such/i.test(msg);
