  out.dirs.sort();
  return out;
}
/* 工作区递归列（既有 WS API;`wsListDir` 自带 depth/limit 夹取）
   ⚠️ **口径不一致（P0-1 登记项）**：请求 `limit: JL_MIRROR_MAX_FILES`(=2000)，实际被 `wsListDir`
   夹到 `WS_LIST_MAX`(=500) ⇒ 每轮最多 500 条；`out.total > out.shown` 即证（`next_offset` 非空）。 */
async function jlMirrorListWs(ws) {
  var out = { files: [], dirs: [], truncated: false, map: {}, err: "", total: 0, shown: 0 };
  var r = await wsListDir(ws, "/", { depth: JL_MIRROR_MAX_DEPTH, limit: JL_MIRROR_MAX_FILES });
  if (!r || r.ok !== true) { out.err = (r && (r.message || r.error || r.code)) || "wsListDir 失败"; return out; }
  var i, e;
  for (i = 0; i < r.entries.length; i++) {
    e = r.entries[i];
    if (!e || !e.path) continue;
    if (jlMirrorDenied(e.path)) continue;
    out.map[e.path] = e;
    if (e.type === "dir") out.dirs.push(e.path); else out.files.push(e.path);
  }
  out.truncated = (r.next_offset !== null && r.next_offset !== undefined);
  out.total = Number(r.total || 0);          /* 全量条目数（夹取前） */
  out.shown = Number(r.shown || (r.entries ? r.entries.length : 0));   /* 本页条目数（夹取后） */
  return out;
}
/* ---- P0-1 的闸（方案 `b2-sync-plan.md:300` **C-6 闸③** / `:332`「**截断 ⇒ 本轮不判任何删除**」
   在镜像侧的对应物）：**本 tick 任一"全集列举"不完整 ⇒ 本 tick 不判任何删除**。
   列举不完整的三个来源（全部登记）：
     ① Contents 列被条目上限截断（`jlMirrorListChild`：`> JL_MIRROR_MAX_FILES`）；
     ② Contents 列被深度上限截断（同上；**原先不置 `truncated`，本批补齐**）；
     ③ 工作区列被 `WS_LIST_MAX`(=500) 硬夹截断（`jlMirrorListWs`；声明 2000 与实际 500 不一致）。
   理由：删除判定的前提是"**对端全集里没有它**"；截断时"看不见 ≠ 已删" ⇒ 判删即误删对端用户文件
   （推方向 `cs.delete` ⇒ Contents 副本消失；拉方向 `wsDelete` ⇒ **工作区文件被删**）。
   **代价（如实登记）**：条目数超窗口（工作区 >500 / Contents >2000 / 有深于 8 层的子树）时，
   该 tick 的删除面整体关闭（保守：不误删，但删除暂不传播；详见报告 §P0-1 的后续项）。 */
function jlMirrorTruncated(all, wl) {
  var a = !!(all && all.truncated === true), b = !!(wl && wl.truncated === true);
  return { any: (a || b), contents: a, ws: b,
    contentsWhy: (all && all.why) || (a ? "count" : ""),
    wsShown: (wl && wl.shown) || 0, wsTotal: (wl && wl.total) || 0 };
}
/* 闸的**第二条件**：路径落在**列举窗口之外**（两侧列举都按 `JL_MIRROR_MAX_DEPTH` 截深）
   ⇒ 同款不判删除。`wsListDir`/`jlMirrorListChild` 的窗口 = 根起 **≤ 8 段**的路径。 */
function jlMirrorBeyondWindow(p) { return jlMirrorSegs(p).length > JL_MIRROR_MAX_DEPTH; }
/* ---- 乙 / R3 面：时间戳归一 + 冲突可见化 + 打开文档跟随（`JL-J3`） ----
   落点 A（R2 甲）：**时间戳类型归一** —— 未归一时工作区侧 `mtime` 是数值毫秒、Jupyter 侧
   `last_modified` 是 ISO 字符串 ⇒ `ch.lm + 1000` 变成字符串拼接 ⇒ 与数值比较得
