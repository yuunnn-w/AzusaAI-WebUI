/* ===========================================================================
   27. JupyterLite 宿主(需求 6 · Phase 2)—— 新标签页 + 子文档垫片 + 引导 fork
   · 载荷:产物 html 里的 <script type="text/plain" id="jupyterlite-assets">(构建期生成,只读)
     行帧分段:;;;JLITE-PART / -META / -SECTION <id> <text|b64gz> <字符数> / -END
     段长一律以**帧头声明的字符数**为准 —— 与 pyodide.part 同构、同一套解析口径(不改行尾、不重算长度)
   · 形态(DG2=A):主页面 window.open('about:blank')(**不传 noopener**,A15)⇒ 宿主把骨架 +
     引导脚本写进子文档;子文档**只读宿主 DOM 文本**(opener 直读,§2.7.3),
     **不调用宿主函数、不新增跨文档 API**(§6.2:页面不对外暴露任何接口)
   · 伪源 https://azusa-jupyter.invalid/ 永不解析;子文档内 5 个垫片把虚拟路径翻成**该文档自己**
     新建的 blob URL:fetch / XHR / <script>.src / <link>.href(含 JS 插入的 <link rel=stylesheet>)
     / Worker。落点口径=勘-7(相对 URL 先按 document.baseURI 解析;setter + 插入时刻双保险)
   · P5/P6 落点:骨架 HTML(P6)与自研配置合并(P5,不 fetch)都在本段内 —— 段 `lab/index.html` /
     `config-utils.js` 因此**在运行期完全不被引用**(替换而非共存)
   · 与 pyodide 侧**零共享**:段表各解各的;内核装载(worker prelude / P3 / P3b)属 Phase 3
   =========================================================================== */

/* ---- 常量 ---- */
var JL_ASSETS_ID = "jupyterlite-assets";
var JL_STATUS_SECTION = "jl-status.json";             /* 构建期缺件降级占位段(build.js 生成) */
var JL_VIRT_ROOT = "https://azusa-jupyter.invalid/";  /* 伪源(站点根;永不解析) */
var JL_VHOST_RE = /^https?:\/\/azusa-jupyter\.invalid\//i;
var JL_BOOT_SCRIPT_ID = "jl-child-boot";              /* 子文档里引导脚本元素的 id(排错用) */
var JL_FAVICON = "data:image/x-icon;base64,AAABAAEAEBAAAAEAIACQAAAAFgAAAIlQTkcNChoKAAAADUlIRFIAAAAQAAAAEAgGAAAAH/P/YQAAAFdJREFUeNpj+FyuxkAJZhjeBih9LldrhWIlUgzwhWr6j4ZboXI4Ddj8uVwtBWrbfxxYCapmM7oBWz+Xq1lB2a14DGiFqrGC6qGeARR7gSqBSLVoHGl5AQB5jMCIKDDEXwAAAABJRU5ErkJggg==";
/* 上面这枚 16×16 图标(= 段 `lab/favicon.ico` 的替代物)由宿主写在骨架里,§2.7.2:
   `<link rel=icon>` 由渲染栈发起、**不经任何垫片** ⇒ 只能内联;站点里的 favicon/PNG 图标
   因此不再被引用(§2.7 断言 9 登记的三件 `unresolvedNoForm` 在运行期全部归零) */

/* ---- 模块状态 ---- */
var JL_FRAME = null;        /* 帧走读缓存(段头表 + META;**不含**段正文) */
var JL_AVAIL = null;        /* 可用性缓存 {ok, reason} */
var JL_LAB_WIN = null;      /* 本页持有的 Jupyter 标签页句柄(§2.3 jlLabHandle) */
var JL_LAB_WS = null;       /* 该标签页绑定的工作区 id(§2.4 DG4:一个标签页跟随一个工作区) */
var JL_LAB_PATH = null;     /* 打开时指定的文件(wantPath);**承接方 = 既有 `#jl-open-params` 载体**(J-TAB-2) */
var JL_LAB_OPENING = false; /* 开页中守卫(同一时刻只允许一次引导) */
var JL_TIP_SHOWN = false;   /* A16 首次打开的一次性提示(按页面会话计:只弹一次) */
/* J-TAB-2:want 的**递增序号**(幂等键)与投递读数。
   `JL_LAB_PATH` 仍是"目标路径"的唯一权威;`wantSeq` 让子页能区分「新的一次请求」与「同一份载荷被重读」,
   也让宿主能对"同一件仍在打开中"的重复点击做幂等(不重复投递 / 不重复提示)。 */
var JL_LAB_WANT_SEQ = 0;        /* 只增不减(同一页面会话内);句柄丢弃时**不**归零(旧回执不得吞掉新 want) */
var JL_LAB_WANT_AT = 0;         /* 最近一次 want 的投递时刻(读数/新鲜度判据) */
var JL_LAB_WANT_TIMER = null;   /* 宿主侧"等回执"的**短时** tick:只在有在飞 want 时存在,终态即停 */
var JL_LAB_WANT_MARK = "";      /* 已提示过的终态标记(`seq:status`)⇒ 不重复弹提示 */
var JL_LAB_WANT_POLL_MS = 500;  /* 宿主侧读回执节拍(短时;子页侧承接节拍见 `JL_P4_WANT_POLL_MS`) */
var JL_LAB_WANT_OPEN_MS = 25000;/* 子页"等落位"预算的口径权威(= 注入子页的 `wantMs`;子页只做默认值) */
var JL_LAB_WANT_WATCH_MS = 45000;   /* 有回执但迟迟没有终态 ⇒ 判"无回应"(子页门预算 25 s + 余量) */
var JL_LAB_WANT_BOOT_MS = 120000;   /* **连回执都没有**(子页还在装载 / 脚本已死)⇒ 上限(子页 app-ready 上限 90 s + 余量) */

/* ---------------------------------------------------------------------------
   27.1 载荷:帧走读 + 段正文
   · 与 appE 的 pyPayloadAt/pyFrameRead **同款口径**:只在文本节点上按需 substringData,
     绝不 materialize 整个 15 MB 文本节点(载荷多数段是单行巨串)
--------------------------------------------------------------------------- */
function jlAssetsEl() { return document.getElementById(JL_ASSETS_ID); }

function jlPayloadAt(el) {
  var kids = el.childNodes, texts = [], i, node, total = 0;
  for (i = 0; i < kids.length; i++) {
    node = kids[i];
    if (node.nodeType === 3 && typeof node.substringData === "function" && node.length > 0) {
      texts.push(node);
      total += node.length;
    }
  }
  if (!texts.length) return null;
  if (texts.length === 1) {
    var len = texts[0].length;
    return { len: len, at: function (p, n) { return texts[0].substringData(p, Math.min(n, len - p)); } };
  }
  return {
    len: total,
    at: function (p, n) {
      var want = Math.min(n, total - p), out = "", j, off = 0, L, start;
      if (want <= 0) return "";
      for (j = 0; j < texts.length && out.length < want; j++) {
        L = texts[j].length;
        if (p >= off + L) { off += L; continue; }
        start = Math.max(0, p - off);
        out += texts[j].substringData(start, Math.min(L - start, want - out.length));
        off += L;
      }
      return out;
    }
  };
}
/* 同步走帧:只读帧头 / META / 各段头(window 逐步放大直到拿到换行) */
function jlFrameRead() {
  if (JL_FRAME) return JL_FRAME;
  var el = jlAssetsEl();
  if (!el) { JL_FRAME = { ok: false, reason: "页面里没有内嵌的 JupyterLite 载荷(构建时缺少 src/jupyterlite.part)" }; return JL_FRAME; }
  var rd = jlPayloadAt(el);
  if (!rd) { JL_FRAME = { ok: false, reason: "JupyterLite 载荷文本节点为空" }; return JL_FRAME; }
  var p = 0;
  function line(win) {
    var n = win, chunk = rd.at(p, n), q = chunk.indexOf("\n");
    while (q < 0 && n < 16 * 1024 * 1024 && (p + chunk.length) < rd.len) {
      n *= 8;
      chunk = rd.at(p, n);
      q = chunk.indexOf("\n");
    }
    if (q < 0) { p = rd.len; return chunk; }
    var s = chunk.slice(0, q);
    p += q + 1;
    return s;
  }
  var head = line(4096);
  while (head === "" && p < rd.len) head = line(4096);
  if (!/^;;;JLITE-PART\s+(\d+)\s+(\d+)$/.test(head)) {
    JL_FRAME = { ok: false, reason: "载荷帧头不合法" };
    return JL_FRAME;
  }
  var count = parseInt(RegExp.$2, 10);
  if (!isFinite(count) || count <= 0) { JL_FRAME = { ok: false, reason: "载荷声明的段数为 0" }; return JL_FRAME; }
  var metaRaw = line(4096);
  var meta = null;
  try { meta = JSON.parse(metaRaw.replace(/^;;;JLITE-META\s+/, "")); } catch (e) { meta = null; }
  var sections = [], byId = {}, i, m, id, kind, len, chars = 0;
  for (i = 0; i < count; i++) {
    m = /^;;;JLITE-SECTION\s+(\S+)\s+(text|b64gz)\s+(\d+)$/.exec(line(256));
    if (!m) { JL_FRAME = { ok: false, reason: "第 " + (i + 1) + " 段的段头不合法" }; return JL_FRAME; }
    id = m[1]; kind = m[2]; len = parseInt(m[3], 10);
    sections.push({ id: id, kind: kind, len: len, p: p });
    byId[id] = sections[sections.length - 1];
    chars += len;
    p += len + 1;
  }
  JL_FRAME = { ok: true, rd: rd, meta: meta, sections: sections, byId: byId, chars: chars };
  return JL_FRAME;
}
/* §2.3 jlAssetsMeta():段表读数(不含段正文) */
function jlAssetsMeta() {
  var fr = jlFrameRead();
  if (!fr.ok) return { ok: false, reason: fr.reason };
  var secs = {}, i, s;
  for (i = 0; i < fr.sections.length; i++) {
    s = fr.sections[i];
    secs[s.id] = { kind: s.kind, chars: s.len };
  }
  /* bytes = 帧头声明字符数之和:生成期保证段正文全 ASCII(断言 5),故字符数 == 字节数 */
  return { ok: true, count: fr.sections.length, bytes: fr.chars, meta: fr.meta, sections: secs };
}
/* §2.3 jlSectionText(path):text 段的正文;未命中或非 text 段 → null */
function jlSectionText(path) {
  var fr = jlFrameRead();
  if (!fr.ok) return null;
  var s = fr.byId[path];
  if (!s || s.kind !== "text") return null;
  var body = fr.rd.at(s.p, s.len);
  return body.length === s.len ? body : null;
}
/* 载荷是否来自构建期降级占位段(build.js 的缺件路径 —— 唯一入口是 `jl-status.json` 段) */
function jlStatusSection() { return jlSectionText(JL_STATUS_SECTION); }

/* ---------------------------------------------------------------------------
   27.2 可用性(§2.3 / §2.7.3 降级口径)
   · 三条降级条件:载荷缺失 / 无 DecompressionStream(子文档侧**不做** JS 兜底解压)
     / 缺 Blob URL 或 Worker 能力。**minimal 档不在其中** —— DG5 终裁 = B(三档都带)
--------------------------------------------------------------------------- */
function jlAvailable() {
  if (JL_AVAIL) return JL_AVAIL;
  var r = { ok: true, reason: "" };
  if (!jlAssetsEl()) {
    r = { ok: false, reason: "页面里没有内嵌的 JupyterLite 载荷(构建时缺少 src/jupyterlite.part)" };
  } else if (typeof DecompressionStream !== "function") {
    r = { ok: false, reason: "当前浏览器没有 DecompressionStream,JupyterLite 载荷无法解压" };
  } else if (!CAP.objectUrl || !CAP.worker) {
    r = { ok: false, reason: "当前浏览器不支持 Blob URL / Worker,JupyterLite 标签页无法引导" };
  } else if (jlStatusSection() !== null) {
    r = { ok: false, reason: "载荷来自构建期降级占位段(构建时缺少 src/jupyterlite.part)" };
  } else {
    var fr = jlFrameRead();
    if (!fr.ok) r = { ok: false, reason: fr.reason };
    else if (fr.meta && fr.meta.jlAvailable === false) r = { ok: false, reason: "载荷自述不可用(JLITE-META.jlAvailable=false)" };
  }
  JL_AVAIL = r;
  return r;
}

/* ---------------------------------------------------------------------------
   27.3 子文档骨架(⌜P6⌝)与配置(⌜P5⌝)
   · 骨架 = 我们生成(P6:「lab/index.html 由宿主生成的骨架 HTML 取代」)⇒ 段 lab/index.html 不再被引用
   · 配置 = 我们合并(P5:「整体替换为 jlConfigUtils.js(自研,无 fetch)」)⇒ 段 config-utils.js 不再被引用
     合并次序与上游 config-utils 的 jupyterConfigData() 等价:根 → 应用目录,
     同一目录内 .ipynb 先于 .json(fetch 换成从**已解码的段表**取值 ⇒ file:// 下无 fetch)
--------------------------------------------------------------------------- */
function jlSkeletonHtml() {
  return [
    "<!DOCTYPE html>",
    "<html><head><meta charset=\"utf-8\">",
    "<title>JupyterLab</title>",
    "<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">",
    "<base href=\"" + JL_VIRT_ROOT + "\">",
    "<link rel=\"icon\" type=\"image/x-icon\" href=\"" + JL_FAVICON + "\">",
    /* 加载指示器保留(上游 bootstrap/bundle 会对它 classList.add/remove('hidden') 并按
       showLoadingIndicator 决定是否显示)。这里**保持 display:none**:Phase 2 不做首屏皮肤,
       避免"遮挡层动画未结束就永久盖住界面"这一类不可判定失败 */
    "<style>html,body{margin:0;padding:0;height:100%}"
      + "body{background:#fff;color:#000}body.jp-mod-dark{background:#111;color:#fff}"
      + "#jupyterlite-loading-indicator{display:none}</style>",
    "<script id=\"jupyter-config-data\" type=\"application/json\" data-jupyter-lite-root=\".\">{}</scr" + "ipt>",
    "</head><body class=\"jp-ThemedContainer\" data-notebook=\"lab\">",
    "<div id=\"jupyterlite-loading-indicator\" class=\"hidden\"></div>",
    /* E11①：底部状态行最多两行（12px/1.5 ⇒ 行高 18px，2 行 36px + 上下 padding 6px = 42px 含盒），
       超出滚动；文案不截断（white-space:pre-wrap 保留折行，「永不静默」语义不变） */
    "<div id=\"jl-sync-note\" style=\"position:fixed;left:0;right:0;bottom:0;padding:3px 8px;font:12px/1.5 ui-monospace,Consolas,monospace;white-space:pre-wrap;max-height:42px;overflow-y:auto;box-sizing:border-box;background:rgba(24,24,28,.88);color:#eee;z-index:2147483646\"></div>",
    "</body></html>"
  ].join("\n");
}

/* ---------------------------------------------------------------------------
   27.4 子文档引导(在**子文档 realm** 内执行的整段代码;由宿主写成 <script>.textContent)
   · 自包含:只用浏览器内建能力,不引用本页任何函数/变量(§2.7.3:不新增跨文档 API)
   · 写好即止:任何一处失败都**可见**(子文档内横幅/整页说明),不静默、不半启动
--------------------------------------------------------------------------- */
async function jlChildMain() {
  var VIRT_ROOT = "https://azusa-jupyter.invalid/";
  var VHOST_RE = /^https?:\/\/azusa-jupyter\.invalid\//i;
  var BUNDLE_PATH = "build/lab/bundle.js";         /* 站点根下的主 bundle(垫片翻成本页 blob) */
  /* 每个目录内按**上游 config-utils.js 的次序**读:`getPathConfig` 对 LITE_FILES 逐个
     `unshift` ⇒ 实际求值序 = ipynb → json → page,故 json 覆盖 ipynb(段正文见载荷 config-utils.js) */
  var LITE_FILES = ["jupyter-lite.ipynb", "jupyter-lite.json"];
  var UNPREFIXED = ["licensesUrl", "themesUrl"];   /* 上游口径:与 baseUrl 拼接,不做 ./ 归一 */
  var APP_READY_MS = 90000;
  /* 内核侧(⌜Phase 3⌟)常量:名与 §2.6.1 F 一致;PY_ID = 宿主页的第二资产面(#pyodide-assets) */
  var PY_ID = "pyodide-assets";
  var JL_DEFAULT_KERNEL = "python";
  var JL_KERNEL_CONNECT_MS = 15000;
  var JL_KERNEL_SPEC_MS = 90000;      /* 规格管理器从"空壳"到"填上 python"的等待上限(实测需远长于 connect) */
  var JL_KERNEL_READY_MS = 300000;
  var JL_EXEC_TIMEOUT_MS = 30000;
  var DIAG = { phase: "start", miss: [], err: [], notes: [] };
  var SEG = {}, TEXT = {};
  window.__JL_DIAG = DIAG;
  window.__JL_MISS = DIAG.miss;

  function devlog(s) {
    DIAG.notes.push(s);
    try { console.debug("[jl] " + s); } catch (e) {}
  }
  function sleep(ms) { return new Promise(function (r) { setTimeout(r, ms); }); }
  /* 子文档可见的失败面:整页说明(致命) */
  function fatal(msg) {
    DIAG.phase = "fatal";
    DIAG.err.push(msg);
    var box = document.getElementById("jl-child-fatal");
    if (!box) {
      box = document.createElement("div");
      box.id = "jl-child-fatal";
      box.setAttribute("style", "position:fixed;inset:0;z-index:2147483647;display:flex;align-items:center;"
        + "justify-content:center;padding:32px;box-sizing:border-box;background:#fff;color:#333;"
        + "font:15px/1.8 system-ui,-apple-system,'Segoe UI',sans-serif;white-space:pre-wrap;text-align:center");
      (document.body || document.documentElement).appendChild(box);
    }
    box.textContent = "JupyterLab 无法启动\n" + msg;
    try { console.error("[jl] " + msg); } catch (e) {}
  }
  /* 子文档可见的提示面:顶部横幅(非致命) */
  function banner(msg) {
    DIAG.notes.push("banner: " + msg);
    var box = document.getElementById("jl-child-banner");
    if (!box) {
      box = document.createElement("div");
      box.id = "jl-child-banner";
      box.setAttribute("style", "position:fixed;left:0;right:0;top:0;z-index:2147483646;padding:8px 12px;"
        + "font:13px/1.6 system-ui,-apple-system,'Segoe UI',sans-serif;background:#fff4e5;color:#5a3200;"
        + "border-bottom:1px solid #f0c48a;white-space:pre-wrap");
      (document.body || document.documentElement).appendChild(box);
    }
    box.textContent = msg;
  }

  /* ---- ⓪ opener 契约(§2.7.3 / A15):缺失即显示「请从主页面重新打开」并**停止**(不半启动) ---- */
  var OP = null;
  try { OP = window.opener || null; } catch (e) { OP = null; }
  DIAG.opener = (OP === null) ? "null" : typeof OP;
  if (!OP) { fatal("这个标签页不是从主页面打开的,无法取得内嵌载荷。请回到主页面,点工作区面板右上角的 JupyterLab 按钮重新打开。"); return; }

  /* ---- 资产投递自证:只读宿主 DOM 文本 ---- */
  var hostEl = null;
  try { hostEl = OP.document.getElementById("jupyterlite-assets"); } catch (e) { DIAG.err.push("跨文档读被拒: " + e.message); }
  var hostRaw = "";
  try { hostRaw = hostEl ? hostEl.textContent : ""; } catch (e2) { DIAG.err.push("读宿主载荷文本被拒: " + e2.message); }
  DIAG.assetsElType = (hostEl && typeof hostEl === "object") ? "object" : String(hostEl);
  DIAG.assetsChars = hostRaw.length;
  if (!hostEl) { fatal("读不到主页面里的 JupyterLite 载荷元素(#jupyterlite-assets)。请从主页面重新打开。"); return; }

  /* ---- 垫片 ---- */
  function pathOf(u) {
    if (typeof u !== "string" || !u) return null;
    if (/^(blob|data|devtools|chrome|about|javascript)/i.test(u)) return null;
    var abs;
    /* ⌜勘-7⌝ setter 拿到的是**原始相对串**(rspack/webpack 赋值 `./build/xxx.js`)
       ⇒ 必须先用 document.baseURI 解析再匹配,否则整片漏拦 */
    try { abs = new URL(u, document.baseURI).href; } catch (e) { return null; }
    if (!VHOST_RE.test(abs)) return null;
    return abs.replace(VHOST_RE, "").split("?")[0].split("#")[0];
  }
  /* ⌜勘-5 D1 同款⌝ URL 实例只有 .href(.url 恒 undefined)⇒ href 优先 */
  function urlOf(input) {
    if (typeof input === "string") return input;
    if (!input) return "";
    if (typeof input.href === "string") return input.href;
    if (typeof input.url === "string") return input.url;
    return "";
  }
  function mimeOf(p) {
    var e = (p.split(".").pop() || "").toLowerCase();
    return ({ js: "text/javascript", mjs: "text/javascript", json: "application/json", wasm: "application/wasm",
      zip: "application/zip", whl: "application/octet-stream", css: "text/css", svg: "image/svg+xml",
      html: "text/html", woff2: "font/woff2", woff: "font/woff", ttf: "font/ttf", eot: "application/vnd.ms-fontobject",
      ico: "image/x-icon", png: "image/png", gif: "image/gif", jpg: "image/jpeg", jpeg: "image/jpeg",
      webmanifest: "application/manifest+json", txt: "text/plain", md: "text/markdown" })[e] || "application/octet-stream";
  }
  function blobUrlOf(text, mime) { return URL.createObjectURL(new Blob([text], { type: mime || "text/javascript" })); }
  function textOf(u8) { return new TextDecoder("utf-8").decode(u8); }
  function b64ToBytes(b64) {
    var bin = atob(b64), n = bin.length, u8 = new Uint8Array(n), i;
    for (i = 0; i < n; i++) u8[i] = bin.charCodeAt(i);
    return u8;
  }
  async function gunzip(u8) {
    var ds = new DecompressionStream("gzip");
