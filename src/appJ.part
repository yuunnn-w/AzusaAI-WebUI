  /* ---- 宿主第二资产面 #pyodide-assets:帧走读(按帧头声明的字符数切正文,不 materialize 整段) ---- */
  function pyHostEl() {
    if (!OP) return null;
    try { return OP.document.getElementById(PY_ID); } catch (e) {
      DIAG.err.push("读宿主 Python 载荷被拒: " + ((e && e.message) || e));
      return null;
    }
  }
  function pyHostRd() {
    var el = pyHostEl(), kids, texts = [], i, node, total = 0;
    if (!el) return null;
    kids = el.childNodes;
    for (i = 0; i < kids.length; i++) {
      node = kids[i];
      if (node.nodeType === 3 && typeof node.substringData === "function" && node.length > 0) { texts.push(node); total += node.length; }
    }
    if (!texts.length) return null;
    if (texts.length === 1) {
      var len = texts[0].length;
      return { len: len, at: function (p, n) { return texts[0].substringData(p, Math.min(n, len - p)); } };
    }
    return {
      len: total, at: function (p, n) {
        var want = Math.min(n, total - p), out = "", j, off = 0, L, start;
        if (want <= 0) return "";
        for (j = 0; j < texts.length && out.length < want; j++) {
          L = texts[j].length;
          if (p >= off + L) { off += L; continue; }
          start = Math.max(0, p - off);
          out += texts[j].substringData(start, Math.min(L - start, want - out.length));
          off += L;
        }
        return out;
      }
    };
  }
  /* 帧走读(同步):帧头 `;;;PYODIDE-PART 1 <段数>` + META + 逐段头;与 appE.pyFrameRead 同口径 */
  function pyHostFrame() {
    if (PYFRAME) return PYFRAME;
    var rd = pyHostRd();
    if (!rd) { PYFRAME = { ok: false, reason: "宿主页里没有内嵌的 Python 载荷(#" + PY_ID + " 缺失)" }; return PYFRAME; }
    var p = 0;
    function line(win) {
      var n = win, chunk = rd.at(p, n), q = chunk.indexOf("\n");
      while (q < 0 && n < 16 * 1024 * 1024 && (p + chunk.length) < rd.len) { n *= 8; chunk = rd.at(p, n); q = chunk.indexOf("\n"); }
      if (q < 0) { p = rd.len; return chunk; }
      var s = chunk.slice(0, q);
      p += q + 1;
      return s;
    }
    var head = line(4096);
    while (head === "" && p < rd.len) head = line(4096);
    if (!/^;;;PYODIDE-PART\s+(\d+)\s+(\d+)$/.test(head)) { PYFRAME = { ok: false, reason: "Python 载荷帧头不合法" }; return PYFRAME; }
    var count = parseInt(RegExp.$2, 10);
    if (!isFinite(count) || count <= 0) { PYFRAME = { ok: false, reason: "Python 载荷声明的段数为 0" }; return PYFRAME; }
    var metaRaw = line(4096), meta = null;
    try { meta = JSON.parse(metaRaw.replace(/^;;;PYODIDE-META\s+/, "")); } catch (e) { meta = null; }
    var sections = [], byId = {}, i, m, id, kind, len;
    for (i = 0; i < count; i++) {
      m = /^;;;PYODIDE-SECTION\s+(\S+)\s+(text|b64gz)\s+(\d+)$/.exec(line(256));
      if (!m) { PYFRAME = { ok: false, reason: "Python 载荷第 " + (i + 1) + " 段的段头不合法" }; return PYFRAME; }
      id = m[1]; kind = m[2]; len = parseInt(m[3], 10);
      sections.push({ id: id, kind: kind, len: len, p: p });
      byId[id] = sections[sections.length - 1];
      p += len + 1;
    }
    PYFRAME = { ok: true, rd: rd, meta: meta, sections: sections, byId: byId };
    KR.hostMeta = meta;
    return PYFRAME;
  }
  /* 取宿主段(按需解码:b64gz → base64 + gunzip;text → 反转义后 UTF-8 编码) */
  async function pyHostBytes(name) {
    if (PYSEC[name]) return PYSEC[name];
    var fr = pyHostFrame();
    if (!fr.ok) { PYCORE.err = fr.reason; return null; }
    var s = fr.byId[name];
    if (!s) return null;
    var body = fr.rd.at(s.p, s.len);
    if (body.length !== s.len) { PYCORE.err = "宿主段 " + name + " 的长度与帧头不符"; return null; }
    var u8;
    if (s.kind === "text") u8 = new TextEncoder().encode(jlUnesc(body));
    else {
      try {
        u8 = await gunzip(b64ToBytes(body));
      } catch (e) { PYCORE.err = "宿主段 " + name + " 解码失败:" + ((e && e.message) || e); return null; }
    }
    PYSEC[name] = u8;
    return u8;
  }
  /* text 段的反转义(与 appE.pyUnescapeInline 同口径:生成期把 HTML 注释起始与脚本结束标签
     这两个序列转义掉;此处**不得**写出它们的字面量 —— 内联脚本正文里,这两个序列
     会把 HTML 分词器推进脚本转义态/双转义态,导致本段收尾标签被吞、整段脚本不执行) */
  function jlUnesc(s) {
    var a = "<" + "\\/script", b = "<" + "\\!--";
    if (s.indexOf(a) < 0 && s.indexOf(b) < 0) return s;
    return s.split(a).join("<" + "/script").split(b).join("<" + "!--");
  }

  /* ---- 内核资产解析:映射表(⌜勘-七-2.1⌟)写死 + 单一仲裁点 ---- */
  function jlKernLookup(path) {
    if (SEG[path]) return "payload";
    if (path === "pyodide/pyodide-lock.json" && jlPayText("jupyterlite-lock.json") !== null) return "payload-lock";
    if (/^pyodide\//.test(path)) {
      var fr = pyHostFrame();
      if (fr.ok && fr.byId[path.slice(path.lastIndexOf("/") + 1)]) return "pyodide-assets";
      return null;
    }
    return null;
  }
  async function jlKernAsset(path) {
    var src = jlKernLookup(path), u8 = null, name = path.slice(path.lastIndexOf("/") + 1);
    if (src === "payload") u8 = SEG[path];
    else if (src === "payload-lock") u8 = new TextEncoder().encode(jlPayText("jupyterlite-lock.json"));
    else if (src === "pyodide-assets") u8 = await pyHostBytes(name);
    if (!u8) {
      var why = src === null
        ? (PYCORE.err || ("载荷与宿主段都没有 " + path))
        : ("取件失败(" + src + "):" + (PYCORE.err || "未知"));
      return { ok: false, path: path, reason: why };
    }
    var fp = await jlFingerprint(u8);
    var rec = { path: path, name: name, source: src, bytes: u8.length, alg: fp.alg, hash: fp.hex, at: Date.now() - KR.t0 };
    KR.assets.push(rec);
    return { ok: true, path: path, name: name, source: src, bytes: u8, fp: fp };
  }
  /* worker 侧按需取件的应答(经专用 MessagePort;字节 transfer ⇒ 先复制,保住本页缓存) */
  function jlWorkerRelay(port, workerPath) {
    WLASTPORT = port;
    port.onmessage = function (ev) {
      var d = ev.data;
      if (!d) return;
      if (d.diag) { KR.workerDiag.push({ tag: d.tag, at: Date.now() - KR.t0, diag: d.diag }); jlWorkerDiagLog(d.tag, d.diag); return; }
      if (d.note) { KR.workerDiag.push({ note: d.note, at: Date.now() - KR.t0 }); return; }
      if (typeof d.q !== "number") return;
      (async function () {
        var r;
        try { r = await jlKernAsset(d.path); }
        catch (e) { r = { ok: false, path: d.path, reason: "取件异常:" + ((e && e.message) || e) }; }
        if (!r.ok) {
          KR.errors.push("资产 " + d.path + " 取件失败:" + r.reason);
          devlog("kernel asset miss " + d.path + " ← " + r.reason);
          port.postMessage({ q: d.q, path: d.path, miss: r.reason });
          return;
        }
        var copy = jlBytesCopy(r.bytes);
        port.postMessage({ q: d.q, path: r.path, bytes: copy, src: r.source, bytesN: r.bytes.length }, [copy.buffer]);
        devlog("kernel asset " + r.path + " " + r.bytes.length + " B ← " + r.source + "(worker " + workerPath + ")");
      })();
    };
  }
  function jlWorkerDiagLog(tag, diag) {
    var m = "worker[" + tag + "] ready=" + diag.ready + " 段=" + diag.segs + " 字节=" + diag.bytes
      + " miss=" + diag.miss.length + " err=" + diag.err.length;
    devlog(m);
    KR.stages["W." + tag] = { at: Date.now() - KR.t0, v: m };
    if (diag.err && diag.err.length) jlOut("[worker] " + diag.err.join(" | "));
  }
  /* ---- prelude(⌜P3⌟):worker 源码头部前置的整段代码 ----
