    function installFactory() {
      var seg = SEG["pyodide/pyodide.asm.mjs"];
      if (!seg) { ERR.push("asm 段缺失(pyodide/pyodide.asm.mjs)"); L("factory:FAIL 段缺失"); return; }
      try {
        (new Function(textOf(seg)))();
        self.__jlCreateModule = (typeof self.__pyodideCreateModule === "function") ? self.__pyodideCreateModule : null;
        if (typeof self.__jlCreateModule !== "function") { ERR.push("__pyodideCreateModule 未定义"); L("factory:FAIL 未定义"); return; }
        L("factory:ok");
      } catch (e) { ERR.push("asm new Function 失败: " + ((e && e.message) || e)); L("factory:EXC"); }
    }
    /* ④ pyodide.mjs 的 worker 内 blob URL(P3b 的动态 import 目标;mjs 无静态 import,可安全 blob 化) */
    function installPyodideUrl() {
      var seg = SEG["pyodide/pyodide.mjs"];
      if (!seg) { ERR.push("pyodide.mjs 段缺失"); L("pyodideUrl:FAIL 段缺失"); return; }
      try {
