    }
    function installBoot(b) {
      var k, n = 0;
      for (k in b) { if (own(k, b)) { SEG[k] = (b[k] instanceof Uint8Array) ? b[k] : new Uint8Array(b[k]); n++; } }
      var lock = SEG["pyodide/pyodide-lock.json"];
      self.__jlLockText = lock ? textOf(lock) : "";
