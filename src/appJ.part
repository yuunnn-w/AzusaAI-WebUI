}

/* ---- 拉：Contents → 工作区（`wsfiles`） ---- */
async function jlBridgePull() {
  var rec = { at: Date.now(), dir: "contents→ws", listed: 0, wrote: 0, same: 0, del: 0, tombDel: 0, err: [], skip: [], conflicts: [], firstWriteAt: null, mkdir: 0, truncated: false };
  var ws = JL_LAB_WS, cs = jlMirrorContents(), i, p, we, base, ch, cur, curB64, wr, mk, wx, conflictP;
  if (!ws) { rec.err.push({ why: "未绑定工作区" }); return rec; }
  if (!cs) { rec.why = JL_MIRROR_WHY; return rec; }
  var all = await jlMirrorListChild(cs);
  var wl = await jlMirrorListWs(ws);
  /* P0-1 闸：本 tick 的**两个全集列举**（Contents 列 / 工作区列）任一不完整 ⇒ 本 tick 不判任何删除 */
  var tr = jlMirrorTruncated(all, wl);
  rec.truncated = tr.any;
  rec.listed = all.files.length;
  rec.jlDirs = all.dirs.length;
  if (all.truncated) rec.skip.push({ why: "contents-tree-truncated", kind: tr.contentsWhy, at: JL_MIRROR_MAX_FILES, seen: all.files.length });
  if (wl.truncated) rec.skip.push({ why: "ws-tree-truncated", at: JL_MIRROR_MAX_FILES, shown: wl.shown, total: wl.total });
  for (i = 0; i < all.err.length; i++) rec.err.push(all.err[i]);
  if (wl.err) rec.err.push({ why: "wsListDir:" + wl.err });
  /* 目录：先建（空目录也要在工作区里出现 —— 身份映射,§4.1） */
  for (i = 0; i < all.dirs.length; i++) {
    we = wl.map[all.dirs[i]];
    if (we && we.type === "dir") continue;
    mk = await wsMkdir(ws, all.dirs[i], { recursive: true });
    if (mk && mk.ok === true) rec.mkdir++;
    else rec.err.push({ path: all.dirs[i], why: "wsMkdir:" + ((mk && (mk.message || mk.code)) || "") });
  }
  for (i = 0; i < all.files.length; i++) {
    p = all.files[i];
    we = wl.map[p] || null;
    base = JL_MIRROR_BASE[p] || null;
    conflictP = false;   /* 乙-1：冲突标记**按路径**复位（冲突轮不更新基线） */
    /* ↓↓↓ P0-2 修（JL-WSDEL）：用户显式删除意图 —— 基线内 ∧ 本侧**权威确无** ⇒ 立墓碑（C-7「不复活」），
       不写回。判据三条：① 基线内（`base`，= C-6 闸②「已同步位」在镜像侧的对应物）；
       ② 本侧列举里没有（`!we`）；③ **路径级权威读** `wsStat` 返回明确缺席（ENOENT）。
       ⚠️ ③ 不能用"列举里没看见"代替 —— 列举被 `WS_LIST_MAX`(=500) 夹取/失败时"看不见 ≠ 已删"
       （闸③ 的失败形状）；`wsStat` 走 `wsTreeGet` 全路径，不受夹取影响。
       ⚠️ 归属守卫 `JL_MIRROR_BASE_WS === JL_LAB_WS`：基线必须属于当前绑定的工作区（同一页面会话内
       换 lab 绑定时，内存里的 `JL_MIRROR_BASE`/`JL_MIRROR_GONE` 可能仍是旧 ws 的 ⇒ 不得据此判"用户删除"）。
       命中 ⇒ 本 tick 直落既有墓碑分支（拒收写回；窗口无截断时由该分支顺带 `cs.delete`）；同 tick
       推方向删除轮照常处理（`wl.map[p]` 仍为空 ⇒ 立碑/清基线）。 */
    if (!we && base && !wl.err && !jlMirrorGoneLive(p) && JL_MIRROR_BASE_WS === JL_LAB_WS) {
      wx = await wsStat(ws, p);
      if (wx && wx.ok === false && wx.code === "ENOENT"
        && String(wx.error || "").indexOf("文件或目录不存在") === 0) {
        jlMirrorGoneSet(p, "ws");
        JL_MIRROR_USER_DELS++;
        rec.skip.push({ path: p, why: "user-del-intent" });
      } else if (!(wx && wx.ok === true)) {
        /* 权威读不可用（既非"在"也非"确无"）⇒ 本 tick 既不写回也不判删，延后到下个 tick（不静默） */
        rec.skip.push({ path: p, why: "wsstat:" + String((wx && wx.code) || "err") });
        continue;
      }
      /* wx.ok === true：件在（如被 WS_LIST_MAX 挤出列举窗口 / 深路径）⇒ 不改既有行为，照常走比对/写回 */
    }
    /* ↑↑↑ P0-2 修（新增结束）↑↑↑ */
    /* 墓碑（§2.8-2 / A14② / §4.4 **C-7**）—— **P1-1 修：判据必须在 `if (we && …)` 块之外求值**。
       由来：`jlMirrorGoneLive(p)` 原先落在 `if (we && we.type === "file")`（原 `:4151`）**块内**，
       而「**本侧已删、对侧又写回**」这条**恰需墓碑**的路径上 `we` 为 `undefined` ⇒ 判据**从未求值**
       ⇒ 直落 `wsWriteBlob` ⇒ 已删件**复活并重入基线**。命中处置两半：① **拒收**（绝不写工作区）；
       ② **C-7 的另一半**：本侧确无该件（`!we`）∧ 本 tick 无截断 ∧ 在深度窗口内 ⇒ 顺手删掉
       Contents 副本（"1–2 tick 内 Contents 侧那件也被镜像删掉"）⇒ 单独计数 `rec.tombDel`。 */
    if (jlMirrorGoneLive(p)) {
      rec.skip.push({ path: p, why: "tomb", we: !!we });
      if (!we && !tr.any && !jlMirrorBeyondWindow(p) && JL_MIRROR_BASE_WS === JL_LAB_WS) {   /* R3 改动 5：归属门（同推方向删除轮） */
        try {
          await cs.delete(p);
          rec.tombDel++; JL_MIRROR_TOMB_DELS++; rec.del++; JL_MIRROR_DELS++;
        } catch (eT) { rec.err.push({ path: p, why: "contents.delete(tomb):" + String((eT && eT.message) || eT).slice(0, 100) }); }
      }
      continue;
    }
    /* 元数据一致 ⇒ 只对齐基线（代价护栏;值比对留给不一致的情形） */
    if (base && we && we.type === "file" && base.m === we.mtime && base.size === we.size) {
      var light = await jlMirrorStatChild(cs, p);
      if (light.ok === true && light.size === base.csize && light.lm === base.clm) { rec.same++; continue; }
    }
    ch = await jlMirrorReadChildFile(cs, p);
    if (ch.ok !== true) { rec.err.push({ path: p, why: "contents.get:" + (ch.err || "") }); continue; }
    if (ch.size > JL_MIRROR_MAX_BYTES) { rec.skip.push({ path: p, why: "size", size: ch.size }); continue; }
    if (we && we.type === "file") {
      cur = await wsReadBlob(ws, p);
      if (cur && cur.ok === true && cur.blob) {
        curB64 = await jlMirrorBlobB64(cur.blob);
        /* 值比对为主（§4.4 C-8）：同内容 ⇒ 只对齐基线,绝不回写（回声抑制） */
        if (curB64 !== null && curB64 === ch.b64) {
          rec.same++;
          jlMirrorBaseSet(p, { size: we.size, m: we.mtime, csize: ch.size, clm: ch.lm });
          continue;
        }
      }
      /* 乙-1（R2 并入 J3a）：冲突轮 = 两侧**自基线以来都变过** ⇒ 计数 + 读数 + 限频提示；
         该路径当轮**不更新基线**（`§2.8-5` 明文），下一轮全量比对再对齐。 */
      conflictP = !!(base && ch.lm !== base.clm && (we.mtime !== base.m || we.size !== base.size));
      if (conflictP) jlMirrorConflictNote(rec, p);
      /* 冲突：本侧更新 ⇒ 让 push 方向去写（时间戳取大者,§2.5/§2.8-5）；
         **平局让位给外部（工作区侧）** —— §10-R4 的有意偏离（对"相等跳过"），已升格 J3a 验收项。 */
      if (we.mtime && ch.lm && we.mtime >= ch.lm) { rec.skip.push({ path: p, why: "local-newer" }); continue; }
    }
    var bytes = jlMirrorB64Bytes(ch.b64);
    wr = await wsWriteBlob(ws, p, new Blob([bytes], { type: "application/octet-stream" }), {});
    if (wr && wr.ok === true) {
      rec.wrote++;
      JL_MIRROR_PULL_WRITES++;
      if (rec.firstWriteAt === null) { rec.firstWriteAt = Date.now(); JL_MIRROR_FIRSTWRITE = rec.firstWriteAt; }
      if (!conflictP) jlMirrorBaseSet(p, { size: wr.size, m: Date.now(), clm: ch.lm, csize: ch.size });
      else rec.skip.push({ path: p, why: "conflict-base-hold" });   /* 冲突轮不更新基线（§2.8-5） */
    } else rec.err.push({ path: p, why: "wsWriteBlob:" + ((wr && (wr.message || wr.code)) || "") });
  }
  /* 删除判定（§2.8-1：**只有「基线内存在、现在缺失」才判删除**；基线缺失 ⇒ 不判删除）
     ⚠️ **P0-1 闸**（方案 `b2-sync-plan.md:300` C-6 闸③ / `:332`「截断 ⇒ 本轮不判任何删除」）：
     本 tick 任一列举被截断（Contents 条目 >2000 / 深度 >8 / 工作区被 `WS_LIST_MAX`(=500) 硬夹）
     ⇒ **整轮不判任何删除**。否则 `inJl` 是**被截断的** Contents 列 ⇒ 被挤出窗口的路径
     （Contents 里其实还在）被读成"对端已删" ⇒ `wsDelete(ws,p)` = **删掉用户的工作区文件**
     （方案写明的失败形状）。**基线缺失**（首启 / `pyCacheClear` 后）走原有保守口径。 */
  if (tr.any) {
    rec.skip.push({ why: "delete-round-closed:truncated", contents: tr.contents, ws: tr.ws,
      kind: tr.contentsWhy, wsShown: tr.wsShown, wsTotal: tr.wsTotal, at: JL_MIRROR_MAX_FILES });
  } else {
    var inJl = {};
    for (i = 0; i < all.files.length; i++) inJl[all.files[i]] = 1;
    for (p in JL_MIRROR_BASE) {
      if (!Object.prototype.hasOwnProperty.call(JL_MIRROR_BASE, p)) continue;
      if (inJl[p]) continue;
      if (jlMirrorBeyondWindow(p)) { rec.skip.push({ path: p, why: "beyond-depth-window" }); continue; }
      we = wl.map[p];
      if (!we) { jlMirrorBaseDel(p); continue; }
      if (!JL_MIRROR_STAT_LOADED) { rec.skip.push({ path: p, why: "base-missing" }); continue; }
      if (jlMirrorGoneLive(p)) { rec.skip.push({ path: p, why: "tomb" }); continue; }
      var del = await wsDelete(ws, p, { recursive: true });
      if (del && del.ok === true) {
        rec.del++; JL_MIRROR_DELS++;
        jlMirrorGoneSet(p, "contents");
        jlMirrorBaseDel(p);
      } else rec.err.push({ path: p, why: "wsDelete:" + ((del && (del.message || del.code)) || "") });
    }
  }
  return rec;
}

/* ---- 推：工作区 → Contents（**由主页面执行**，裁定 P2-4 第 2 条） ---- */
async function jlBridgePush() {
  var rec = { at: Date.now(), dir: "ws→contents", listed: 0, wrote: 0, same: 0, del: 0, err: [], skip: [], conflicts: [], refresh: null, ms: 0 };
  var t0 = Date.now();
  var ws = JL_LAB_WS, cs = jlMirrorContents(), i, p, f, ch, blob, b64, mime, conflictP, savedOk;
  if (!ws) { rec.err.push({ why: "未绑定工作区" }); return rec; }
  if (!cs) { rec.why = JL_MIRROR_WHY; return rec; }
  var wl = await jlMirrorListWs(ws);
  if (wl.err) rec.err.push({ why: "wsListDir:" + wl.err });
  rec.listed = wl.files.length;
  /* P0-1 闸：**工作区列被截断 ⇒ 本 tick 不判任何删除**（见下方删除轮）。`wsListDir` 把 limit 夹到
     `WS_LIST_MAX`(=500) ⇒ 被挤出窗口的**仍然存在**的工作区文件会被读成"已删" ⇒ 删 Contents 副本。 */
  var trp = jlMirrorTruncated(null, wl);
  rec.truncated = trp.any;
  if (wl.truncated) rec.skip.push({ why: "ws-tree-truncated", at: JL_MIRROR_MAX_FILES, shown: wl.shown, total: wl.total });
  for (i = 0; i < wl.files.length; i++) {
    p = wl.files[i];
    f = wl.map[p] || {};
    conflictP = false; savedOk = false;   /* 乙-1/乙-2：标记**按路径**复位 */
    if (jlMirrorGoneLive(p)) { rec.skip.push({ path: p, why: "tomb" }); continue; }   /* 显式删除意图：不复活 */
    if ((f.size || 0) > JL_MIRROR_MAX_BYTES) { rec.skip.push({ path: p, why: "size", size: f.size || 0 }); continue; }
    var base = JL_MIRROR_BASE[p] || null;
    if (base && base.m === f.mtime && base.size === f.size) {
      var light = await jlMirrorStatChild(cs, p);
      if (light.ok === true && light.size === base.csize && light.lm === base.clm) { rec.same++; continue; }
      if (light.ok !== true && light.miss === true) {
        /* `[r2 修正 · E13 四段见 progress]` **对端的删除意图**（§2.8-1/2 + A14②「对侧删除后本侧不得复活」）：
           基线内 ∧ 对端**明确缺失**(404) ∧ 本侧自上次同步**未变** ⇒ `continue`（**跳过**）。
           **不得**按"本侧新增"重新写回 Contents —— 那正是 r2 实测到的"删除被复活"（`C6DELNEG` FAIL）。
           删除动作交给**拉方向**：它在下一个 tick 用**全量列举**确认缺失后，删工作区副本 + 立墓碑（§2.8-1）。 */
        rec.skip.push({ path: p, why: "peer-missing" });
        continue;
      }
    }
    ch = await jlMirrorReadChildFile(cs, p);
    blob = await wsReadBlob(ws, p);
    if (!blob || blob.ok !== true || !blob.blob) { rec.err.push({ path: p, why: "wsReadBlob" }); continue; }
    b64 = await jlMirrorBlobB64(blob.blob);
    if (b64 === null) { rec.err.push({ path: p, why: "读工作区内容失败" }); continue; }
    if (ch.ok === true && ch.b64 === b64) {
      rec.same++;
      jlMirrorBaseSet(p, { size: f.size || 0, m: f.mtime, csize: ch.size, clm: ch.lm });
      continue;
    }
    /* 乙-1（R2 并入 J3a）：同款冲突判定（两侧自基线以来都变过）⇒ 计数 + 读数 + 限频提示 */
    conflictP = !!(base && ch.ok === true && ch.lm !== base.clm && (f.mtime !== base.m || (f.size || 0) !== base.size));
    if (conflictP) jlMirrorConflictNote(rec, p);
    /* 冲突：对端更新 ⇒ 交给 pull 方向（时间戳取大者）;本轮不更新基线(§2.8-5) */
    if (ch.ok === true && ch.lm && f.mtime && ch.lm > f.mtime) { rec.skip.push({ path: p, why: "peer-newer" }); continue; }
    mime = blob.mime || "";
    await jlMirrorEnsureChildDir(cs, jlMirrorDirOf(p));
    try {
      await cs.save(p, jlMirrorMimeTextish(mime)
        ? { type: "file", format: "text", content: String(jlMirrorB64Text(b64) == null ? "" : jlMirrorB64Text(b64)) }
        : { type: "file", format: "base64", content: b64 });
      rec.wrote++;
      JL_MIRROR_PUSH_WRITES++;
      savedOk = true;
      if (!conflictP) jlMirrorBaseSet(p, { size: f.size || 0, m: f.mtime, csize: f.size || 0, clm: Date.now() });
      else rec.skip.push({ path: p, why: "conflict-base-hold" });   /* 冲突轮不更新基线（§2.8-5） */
    } catch (e2) { rec.err.push({ path: p, why: "contents.save:" + String((e2 && e2.message) || e2).slice(0, 100) }); }
    /* R3（乙-2）：**仅写成功路径**（`cs.save` 成功）⇒ 打开中的 clean 文档跟随（三计数入读数面）。
       ⚠️ 删除路径**不进本函数**（对已删路径 `revert()` ⇒ 404 ⇒ 子文档弹 `File Load Error`）。 */
    if (savedOk) {
      var nd = { ok: false, why: "n/a" };
      try { nd = await jlMirrorNudgeOpenDoc(p); } catch (eN) { nd = { ok: false, why: "nudge:" + String((eN && eN.message) || eN).slice(0, 80) }; }
      if (nd && nd.ok === true && nd.reverted === true) { JL_MIRROR_NUDGED++; JL_MIRROR_NUDGE_LAST_MS = Number(nd.ms || 0); }
      else if (nd && nd.ok === true && nd.skipped) { JL_MIRROR_NUDGE_SKIPPED++; rec.skip.push({ path: p, why: "nudge-" + String(nd.skipped) }); }
      else { JL_MIRROR_NUDGE_FAILED++; }
    }
  }
  /* 工作区已删（基线内 ∧ Contents 仍在 ∧ 无墓碑）⇒ 显式删除意图：墓碑 + 删 Contents（§2.8-2）
     ⚠️ **P0-1 闸**（方案 `:300` C-6 闸③ / `:332`「截断 ⇒ 本轮不判任何删除」）：工作区列被截断时
     `wl.map[p]` 对**被挤出窗口的仍然存在**的文件同样为假 ⇒ 若无闸即 `cs.delete(p)`（**静默删掉
     对侧 Contents 里的用户文件** + 立墓碑 ⇒ 长期消失）。⇒ 截断 tick **整轮不判任何删除**。 */
  if (trp.any) {
    rec.skip.push({ why: "delete-round-closed:truncated", ws: true, wsShown: trp.wsShown, wsTotal: trp.wsTotal, at: JL_MIRROR_MAX_FILES });
  } else if (JL_MIRROR_BASE_WS !== JL_LAB_WS) {   /* R3 改动 5：归属不符 ⇒ 删除轮整体跳过（保守：减删不误删；归属重建后同判据重检出，见 §9-11） */
    rec.skip.push({ why: "delete-round-closed:foreign-base", baseWs: JL_MIRROR_BASE_WS, ws: JL_LAB_WS });
  } else {
    for (p in JL_MIRROR_BASE) {
      if (!Object.prototype.hasOwnProperty.call(JL_MIRROR_BASE, p)) continue;
      if (wl.map[p]) continue;
      if (jlMirrorBeyondWindow(p)) { rec.skip.push({ path: p, why: "beyond-depth-window" }); continue; }
      if (jlMirrorGoneLive(p)) { jlMirrorBaseDel(p); continue; }
      var st = await jlMirrorStatChild(cs, p);
      if (st.ok !== true) { jlMirrorBaseDel(p); continue; }
      try {
        await cs.delete(p);
        rec.del++; JL_MIRROR_DELS++;
        jlMirrorGoneSet(p, "ws");
        jlMirrorBaseDel(p);
        /* R3（乙-2 · P1-3）：删除路径**只记计数面**（skipped:"gone"），绝不 revert()/contents.get
           —— 对已删路径 contents.get = 404 ⇒ 子文档弹 File Load Error（可见噪音 + 假成功）。 */
        JL_MIRROR_NUDGE_SKIPPED++;
        rec.skip.push({ path: p, why: "nudge-gone" });
      } catch (e3) { rec.err.push({ path: p, why: "contents.delete:" + String((e3 && e3.message) || e3).slice(0, 100) }); }
    }
  }
  if (rec.wrote || rec.del) rec.refresh = await jlMirrorRefreshChild();
  rec.ms = Date.now() - t0;
  return rec;
}

/* ---- tick（重入守卫 + 墙钟上限 + 不静默） ---- */
async function jlMirrorTickOnce(why) {
  if (JL_MIRROR_BUSY) { JL_MIRROR_SKIP_BUSY++; return null; }
  if (!jlLabAlive()) { jlMirrorStop("tab-closed"); return null; }
  JL_MIRROR_BUSY = true;
  JL_MIRROR_ERR = "";
  JL_MIRROR_FIRSTWRITE = null;
  var t0 = Date.now();
  var out = { why: String(why || "tick"), ms: 0, pull: null, push: null, wsrev: null, rail: "", refresh: null, save: false };
  try {
    if (!JL_MIRROR_STAT_LOADED) await jlMirrorStateLoad();
    jlMirrorGonePrune();
    out.pull = await jlBridgePull();
    out.push = await jlBridgePush();
    /* **P2-1 修**：`JL_MIRROR_SAME` 是**死计数器**（声明在常量区、发布进 `data-jl-mirror-stat.same`，
       但全文件 0 处自增 ⇒ 7 轮读数恒 0）。此处按两方向各自累计 `rec.same`（值比对命中数）
       ⇒ 该读数成真（报告 §1 的证据列同步改准为"`same` 增量 + `pullWrites/pushWrites` 增量"）。 */
    JL_MIRROR_SAME += Number((out.pull && out.pull.same) || 0) + Number((out.push && out.push.same) || 0);
    /* P0-1 闸的 tick 读数：本 tick 是否有列举被截断（>0 ⇒ 该 tick 的删除面整体关闭） */
    var truncTick = !!((out.pull && out.pull.truncated) || (out.push && out.push.truncated));
    if (truncTick) JL_MIRROR_TRUNC_TICKS++;
    var wrote = ((out.pull && out.pull.wrote) || 0) + ((out.pull && out.pull.del) || 0) +
      ((out.push && out.push.wrote) || 0) + ((out.push && out.push.del) || 0);
    if (wrote) {
      out.rail = jlMirrorRailRefresh();                 /* 跨页刷新：主页面右栏 */
      out.wsrev = await jlMirrorWsRevTick(JL_LAB_WS);   /* `wsRev` bump（唤醒子文档/其它标签页） */
      out.save = await jlMirrorStateSave();
      if (!out.refresh) out.refresh = await jlMirrorRefreshChild();
    }
    if (!JL_MIRROR_ERR && out.pull && out.pull.why && out.pull.why !== "not-ready") JL_MIRROR_ERR = out.pull.why;
  } catch (e) {
    JL_MIRROR_ERR = "tick 异常:" + String((e && e.message) || e).slice(0, 160);
  }
  out.ms = Date.now() - t0;
  JL_MIRROR_BUSY = false;
  if (out.ms > JL_MIRROR_TICK_MAX_MS) {
    JL_MIRROR_DEADLINE_HITS++;
    JL_MIRROR_ERR = JL_MIRROR_ERR || ("单 tick 墙钟 " + out.ms + " ms 超上限 " + JL_MIRROR_TICK_MAX_MS + " ms");
    toast("Jupyter 文件镜像单轮耗时 " + out.ms + " ms（已强制释放守卫）", "warn", 4200);
  }
  JL_MIRROR_TICKS++;
  JL_MIRROR_LAST = out;
  try {
    console.debug("[jl-mirror] " + JSON.stringify({
      why: out.why, ms: out.ms, ticks: JL_MIRROR_TICKS, truncTick: truncTick,
      pull: out.pull ? { listed: out.pull.listed, wrote: out.pull.wrote, same: out.pull.same, del: out.pull.del, tombDel: out.pull.tombDel, truncated: out.pull.truncated, mkdir: out.pull.mkdir, firstWriteAt: out.pull.firstWriteAt, err: out.pull.err.slice(0, 4), skip: out.pull.skip.slice(0, 4) } : null,
      push: out.push ? { listed: out.push.listed, wrote: out.push.wrote, same: out.push.same, del: out.push.del, truncated: out.push.truncated, ms: out.push.ms, err: out.push.err.slice(0, 4), skip: out.push.skip.slice(0, 4) } : null,
      wsrev: out.wsrev, rail: out.rail, refresh: out.refresh, save: out.save,
      conflicts: JL_MIRROR_CONFLICTS, nudged: JL_MIRROR_NUDGED, nudgeFailed: JL_MIRROR_NUDGE_FAILED, err: JL_MIRROR_ERR
    }).slice(0, 4000));
  } catch (e9) {}
  jlMirrorPub("stat", JSON.stringify({
    ticks: JL_MIRROR_TICKS, kicks: JL_MIRROR_KICKS, skipBusy: JL_MIRROR_SKIP_BUSY,
    pullWrites: JL_MIRROR_PULL_WRITES, pushWrites: JL_MIRROR_PUSH_WRITES, dels: JL_MIRROR_DELS,
    same: JL_MIRROR_SAME, tombDels: JL_MIRROR_TOMB_DELS,
    userDels: JL_MIRROR_USER_DELS,
    conflicts: JL_MIRROR_CONFLICTS,
    nudged: JL_MIRROR_NUDGED, nudgeSkipped: JL_MIRROR_NUDGE_SKIPPED,
    nudgeFailed: JL_MIRROR_NUDGE_FAILED, nudgeMs: JL_MIRROR_NUDGE_LAST_MS,
    baseWs: JL_MIRROR_BASE_WS || "",
    truncTicks: JL_MIRROR_TRUNC_TICKS, truncNow: truncTick,
    refreshes: JL_MIRROR_REFRESHES, deadlineHits: JL_MIRROR_DEADLINE_HITS,
    wsRev: JL_WSREV_VAL, wsRevBumps: JL_WSREV_BUMPS, jlRev: JL_MIRROR_JLREV, ready: JL_MIRROR_READY,
    baseKeys: Object.keys(JL_MIRROR_BASE).length, goneKeys: Object.keys(JL_MIRROR_GONE).length,
    lastMs: out.ms, lastPullWrote: (out.pull && out.pull.wrote) || 0, lastPushWrote: (out.push && out.push.wrote) || 0,
    firstWriteAt: JL_MIRROR_FIRSTWRITE, at: Date.now(), err: JL_MIRROR_ERR
  }).slice(0, 900));
  return out;
}
function jlMirrorTick() { return jlMirrorTickOnce("tick"); }
function jlMirrorKick(why) {
  JL_MIRROR_KICKS++;
  if (JL_MIRROR_BUSY) return Promise.resolve(null);
  return jlMirrorTickOnce("kick:" + String(why || ""));
}
function jlMirrorStart() {
  jlMirrorPub("state", "started@" + Date.now());
  if (JL_MIRROR_TICK !== null) return true;
  JL_MIRROR_TICK = setInterval(jlMirrorTick, JL_MIRROR_TICK_MS);
  jlMirrorKick("start");
  return true;
}
function jlMirrorStop(why) {
  if (JL_MIRROR_TICK !== null) { clearInterval(JL_MIRROR_TICK); JL_MIRROR_TICK = null; }
  jlMirrorPub("state", "stopped:" + String(why || "") + "@" + Date.now());
}
/* 跨页唤醒（§2.9）：子文档写 `LS_KEY+":jl"` ⇒ 本页 storage 事件 ⇒ 立刻拉一次（主页面是推送执行者） */
function jlOnStorageJl(e) {
  try {
    if (!e || String(e.key || "") !== (LS_KEY + JL_MIRROR_JLKEY)) return;
    var rec = null;
    try { rec = JSON.parse(String(e.newValue || "") || "{}"); } catch (e2) { rec = null; }
    var jr = Number((rec && rec.jlabRev) || 0);
    if (jr > JL_MIRROR_JLREV) { JL_MIRROR_JLREV = jr; jlMirrorKick("child-report"); }
  } catch (e3) {}
}
/* ===========================================================================
   27.9 Phase 5：空闲租约（**主页面单写者**）+ `jl:` 键 TTL/GC + 共享时钟 + 主页面侧续命
   契约来源（逐条）：
     · `specs/jupyterlite-plan.md` §3「Phase 5 —— 空闲租约同步」+ §2.9 键表（`jllease:main` /
       `jllease:jupyter` 由**主页面单写者**在 30 s tick 里代写两侧；子文档只写 `LS_KEY+":jl"`）
       + `勘-七-2.4`（共享时钟 = **读两份记录取 max**，`jlastActive` 字段作废）
       + `勘-七-1.4`（liveness 纯超时口径与 D-2 改准判据）+ `§1 A7`（一侧活动续命两侧 / 对侧关闭 / 主页面不在）
     · **键族口径**（`decisions/plans-decision-gates.md:246` 的 P2-1）：取「统一键名」⇒ 单一 `jl:` 前缀族，
       与 Phase 4 as-built 的 `jl:base:` / `jl:gone:` 同族；理由与逐条论证见
       `shared/tmp/jl-phase5/progress.md §3`（核心：Phase 4 的键已在产且已 PASS，改名会让落盘基线/墓碑失配）。
     · `liveness`（§2.9 / P3-2）：失活 ⇔ `now - beat > JL_LEASE_TTL_MS`（= `PY_IDLE_MS + 2×PY_IDLE_TICK`）
       **或** 句柄 `closed`（两者取**并**）；主页面不在 ⇒ 子文档**退化为独立计时**（DG6 退化分支）。
     · **写者纪律**（§2.9 P1-3）：`LS_KEY` 由主页面独占写（经 appA 的权威记录构造器 `stateRecord()`
       **一个字段不少**，只多写 `jlLease` —— 与 Phase 4 写 `wsRev` 同一口径/同一登记债）；`LS_KEY+":jl"`
       只由子文档写。**任一 appA `stateRecord()` 写入都会丢 `jlLease` 字段**（appA 字段表未含它）
       ⇒ 本页每 tick（≤ `JL_LEASE_TICK_MS`）重写一次即自愈；期间子文档读到 `mainLastActive=0`
       ⇒ 退化为「只按自身活动计时」⇒ **只会少续命、不会误释放**（安全方向，已如实登记）。
     · **主页面侧续命**（DG6=A 的一半，方案原写「`pyMaybeReclaim` 加一处前置条件」）：
       ❌ 不改 `appE.part`（派单书限定唯一代码面 = `appJ.part`）⇒ 等价落点 = 本页 tick 里
       **只推 slot 的 `lastActive`**（`pyMaybeReclaim` 的唯一判据就是 `now - s.lastActive < PY_IDLE_MS`）。
       ⚠ **不得**用 `pyTouch()`：它同时把 `PY_STATE.lastActive` 推到"现在"，而本页的「自身活动时刻」
       正是读 `PY_STATE.lastActive` ⇒ 会形成**自反馈**（共享时钟恒为 0、10 分钟回收永不触发）。
       因此这里**只写 `slot.lastActive`、不碰 `PY_STATE.lastActive`**（这是本功能最容易踩的死循环）。
     · **可见提示**（A7「两侧都给出可见提示」）：① Jupyter 侧 = 子文档 `#jl-sync-note` + 横幅 + 标题
       （见 27.8.6 的 `jlLeaseRelease`）② 主页面侧 = 本页 `toast()` + `#btn-wsr-jupyter` 的
       `data-jl-lease-*` 读数属性；另**只读**子文档状态行文本（同源、只读、非 API）用于把
       "子文档侧已释放"这一事实反映到主页面提示上（跨文档 API 零新增）。
   ES5 + `var` + `function`；读数面走 DOM（与 27.7 同口径）。
--------------------------------------------------------------------------- */
var JL_LEASE_IDLE_MS = (typeof PY_IDLE_MS === "number" && PY_IDLE_MS > 0) ? PY_IDLE_MS : 10 * 60 * 1000;
var JL_LEASE_TICK_MS = (typeof PY_IDLE_TICK === "number" && PY_IDLE_TICK > 0) ? PY_IDLE_TICK : 30 * 1000;
var JL_LEASE_TTL_PAD_TICKS = 2;                   /* JL_LEASE_TTL_MS = idleMs + 2×tickMs（§2.9） */
var JL_LEASE_KV_MAIN = "jl:lease:main";           /* 键族收口：单一 `jl:` 前缀（见 27.9 头注） */
var JL_LEASE_KV_JUP = "jl:lease:jupyter";
var JL_LEASE_PREFIX = "jl:lease:";
var JL_LEASE_JLKEY = ":jl";
var JL_LEASE_TAB = String(Math.random()).slice(2, 10);
var JL_LEASE_TIMER = null;
var JL_LEASE_TICKS = 0, JL_LEASE_KVW = 0, JL_LEASE_GC = 0, JL_LEASE_KA_CHECKS = 0, JL_LEASE_KA_TOUCHED = 0;
var JL_LEASE_PHASE = "init", JL_LEASE_ERR = "";
var JL_LEASE_OWN_AT = 0, JL_LEASE_SELF_BEAT = 0, JL_LEASE_JUP_AT = 0, JL_LEASE_JUP_BEAT = 0;
var JL_LEASE_CHILD_FRESH = null, JL_LEASE_SHARED_IDLE = null, JL_LEASE_SHARED_MAX = 0;
var JL_LEASE_GCINFO = null, JL_LEASE_ALERTED = false, JL_LEASE_KA_NOTED = false, JL_LEASE_CHILD_REL = null;
function jlLeaseTtlMs() { return JL_LEASE_IDLE_MS + JL_LEASE_TTL_PAD_TICKS * JL_LEASE_TICK_MS; }
function jlLeaseKvOk(key) { return String(key).indexOf(JL_LEASE_PREFIX) === 0; }
function jlLeaseKvGet(key) {
  if (!jlLeaseKvOk(key)) return Promise.reject(new Error("EKEY: 只接受 `jl:lease:` 前缀，收到 " + String(key)));
  return jlMirrorKvGet(key);
}
function jlLeaseKvPut(key, obj) {
  if (!jlLeaseKvOk(key)) return Promise.reject(new Error("EKEY: 只接受 `jl:lease:` 前缀，收到 " + String(key)));
  return jlMirrorKvPut(key, obj);
}
function jlLeaseKvDel(key) {
  if (!jlLeaseKvOk(key)) return Promise.reject(new Error("EKEY: 只接受 `jl:lease:` 前缀，收到 " + String(key)));
  return wsStoreTx(IDB_PYC, "readwrite", function (tx) {
    tx.objectStore(IDB_PYC).delete(String(key));
    return { ok: true };
  }).then(function (r) { return !!(r && r.ok === true); }, function () { return false; });
}
/* `jl:lease:` 前缀枚举（GC 用）。`pyocache` 里只有固定集合 + `wheel:` + `jl:` 三类键 ⇒ 前缀过滤不会误伤。 */
function jlLeaseKvScan(prefix) {
  var pre = String(prefix || JL_LEASE_PREFIX);
  return wsStoreTx(IDB_PYC, "readonly", function (tx) {
    var st = tx.objectStore(IDB_PYC);
    return wsReqP(st.getAllKeys()).then(function (keys) {
      keys = Array.isArray(keys) ? keys : [];
      var hit = [], i;
      for (i = 0; i < keys.length; i++) if (String(keys[i]).indexOf(pre) === 0) hit.push(String(keys[i]));
      if (!hit.length) return { ok: true, items: [] };
      return Promise.all(hit.map(function (k) {
        return wsReqP(st.get(k)).then(function (v) {
          var data = (v && typeof v.data === "string") ? v.data : null, o = null;
          try { o = data ? JSON.parse(data) : null; } catch (e) { o = null; }
          return { key: k, value: o, at: Number((v && v.at) || 0) };
        }, function () { return { key: k, value: null, at: 0 }; });
      })).then(function (arr) { return { ok: true, items: arr }; });
    });
  }).then(function (r) { return (r && r.ok === true) ? r.items : []; }, function () { return []; });
}
function jlLeaseReadAll() {
  return Promise.all([jlMirrorKvGet(JL_LEASE_KV_MAIN), jlMirrorKvGet(JL_LEASE_KV_JUP)])
    .then(function (a) { return { main: a[0] || null, jupyter: a[1] || null }; }, function () { return { main: null, jupyter: null }; });
}
/* 子文档上报的 `LS_KEY+":jl"`（只读；主页面**不写**该键） */
function jlLeaseChildRec() {
  var rec = null;
  try { rec = JSON.parse(String(localStorage.getItem(LS_KEY + JL_LEASE_JLKEY) || "") || "{}"); } catch (e) { rec = null; }
  if (!rec || typeof rec !== "object") return null;
  var l = (rec.lease && typeof rec.lease === "object") ? rec.lease : null;
  return { ok: true, tab: String(rec.tab || ""), beat: Number((l && l.beat) || 0),
    lastActive: Number((l && l.lastActive) || 0), jlabRev: Number(rec.jlabRev || 0), wsRevSeen: Number(rec.wsRevSeen || 0) };
}
/* 主页面自身活动时刻（= appE 的**真实** Python 活动读数面；续命**不碰**它，见 27.9 头注） */
function jlLeaseOwnActivityAt() {
  var v = 0;
  try { v = Number((typeof PY_STATE !== "undefined" && PY_STATE && PY_STATE.lastActive) || 0); } catch (e) { v = 0; }
  return isFinite(v) ? v : 0;
}
/* 共享时钟（主页面侧；`§2.6.1 D-2` 的改准公式）：`max(自身, jupyter 侧)` */
function jlLeaseSharedIdle(now) {
  var t = Number(now || Date.now());
  var own = JL_LEASE_OWN_AT, jup = JL_LEASE_JUP_AT;
  var last = Math.max(own, jup);
  if (!last) last = t;
  return Math.max(0, t - last);
}
/* 两个写者共用同一条 `LS_KEY` 记录（Phase 4 的 `wsRev` 与 Phase 5 的 `jlLease`），而 appA 的字段表里
   这两个键都**不在** ⇒ 任一方用 `stateRecord()` 写入都会把对方字段抹掉。统一在写前把对方字段从盘上
   接回来（单调取大）：否则本页 30 s 一次的租约写会把 `wsRev` 打回 0（跨页推送/刷新判据失效），
   而 Phase 4 的 wsRev 写会把 `jlLease` 抹掉（主页面侧续命断档 ≤1 tick，安全方向但仍是缺陷）。 */
function jlLsCarryFields(rec) {
  var cur = null;
  try { cur = JSON.parse(String(localStorage.getItem(LS_KEY) || "") || "{}"); } catch (e) { cur = null; }
  if (!cur || typeof cur !== "object" || !rec) return rec;
  var w = Number(cur.wsRev || 0);
  if (w > Number(rec.wsRev || 0)) rec.wsRev = w;
  var l = (cur.jlLease && typeof cur.jlLease === "object") ? cur.jlLease : null;
  if (l) {
    var mine = (rec.jlLease && typeof rec.jlLease === "object") ? rec.jlLease : null;
    rec.jlLease = {
      beat: Math.max(Number(l.beat || 0), Number((mine && mine.beat) || 0)),
      lastActive: Math.max(Number(l.lastActive || 0), Number((mine && mine.lastActive) || 0))
    };
  }
  return rec;
}
/* 写 `LS_KEY.jlLease`（主页面单写者；字段集固定 `{beat,lastActive}`，经 appA 权威构造器） */
function jlLeasePublishSelf(now, own) {
  try {
    var rec = stateRecord();
    var prev = (rec.jlLease && typeof rec.jlLease === "object") ? rec.jlLease : null;
    var la = Number(own || 0);
    if (prev && Number(prev.lastActive || 0) > la) la = Number(prev.lastActive);   /* 单调不减 */
    rec.jlLease = { beat: Number(now), lastActive: la };
    jlLsCarryFields(rec);                       /* 接回 `wsRev`（对方的字段），否则会把跨页版本号打回 0 */
    localStorage.setItem(LS_KEY, JSON.stringify(rec));
    JL_LEASE_KVW++;
    return true;
  } catch (e) {
    JL_LEASE_ERR = "LS_KEY 写入失败: " + String((e && e.message) || e).slice(0, 120);
    return false;
  }
}
/* TTL/GC（`jl:lease:` 键；beat 落后 > TTL ⇒ 失活 ⇒ 任一侧 tick 可清）。**不动** `jl:base:`/`jl:gone:`。 */
function jlLeaseGc(now) {
  var ttl = jlLeaseTtlMs();
  return jlLeaseKvScan(JL_LEASE_PREFIX).then(function (items) {
    var dead = [], i;
    for (i = 0; i < items.length; i++) {
      var v = items[i].value || {}, beat = Number(v.beat || 0);
      if (!beat || (Number(now) - beat) > ttl) dead.push(items[i].key);
    }
    if (!dead.length) { JL_LEASE_GCINFO = { scanned: items.length, deleted: 0, ttlMs: ttl }; return JL_LEASE_GCINFO; }
    return Promise.all(dead.map(function (k) { return jlLeaseKvDel(k); })).then(function () {
      JL_LEASE_GC += dead.length;
      JL_LEASE_GCINFO = { scanned: items.length, deleted: dead.length, keys: dead, ttlMs: ttl };
      return JL_LEASE_GCINFO;
    });
  }, function () { JL_LEASE_GCINFO = { scanned: 0, deleted: 0, err: "scan 失败", ttlMs: ttl }; return JL_LEASE_GCINFO; });
}
/* 主页面侧续命（DG6=A 的另一半）：Jupyter 侧仍在活动 ⇒ 推自家活 slot 的 `lastActive`。
   ⚠ **只写 `slot.lastActive`**（`pyMaybeReclaim` 的判据）；**不碰** `PY_STATE.lastActive`（自反馈屏障）。 */
function jlLeaseKeepAliveMain(now, childActive) {
  JL_LEASE_KA_CHECKS++;
  if (!childActive) return { childActive: false, touched: 0 };
  var touched = 0, i, s;
  try {
    if (typeof PY_POOL !== "undefined" && PY_POOL && PY_POOL.length) {
      for (i = 0; i < PY_POOL.length; i++) {
        s = PY_POOL[i];
        if (s && s.w && !s.taskId) { s.lastActive = Number(now); touched++; }
      }
    }
  } catch (e) { JL_LEASE_ERR = "续命失败: " + String((e && e.message) || e).slice(0, 120); }
  JL_LEASE_KA_TOUCHED += touched;
  if (touched && !JL_LEASE_KA_NOTED) {
    JL_LEASE_KA_NOTED = true;
    toast("Jupyter 侧有活动：主页面 Python 的空闲回收同步续期（统一时钟）", "info", 4200);
  }
  return { childActive: true, touched: touched, slots: (typeof PY_POOL !== "undefined" && PY_POOL) ? PY_POOL.length : 0 };
}
/* 只读子文档"已释放"事实（同源、只读、非 API）：把"Jupyter 侧已释放"这一事实带到主页面提示上。
   **主判据 = 子文档读数面**（`__JL_LEASE_STAT().released`）——它与子文档自己的可见提示**同源**
   （都取 `JL5.released`），但**不共用一个元素** ⇒ 不会被别的子系统覆盖。
   为什么不能只看文案：`#jl-sync-note` 是 Phase 4 同步诊断（`jlSyncNote`）与 Phase 5 释放提示（`jlLeaseNote`
   → 同一个 `jlSyncNote`）**共用**的元素，写法是 `el.textContent = …` ⇒ **后写者整体覆盖先写者**；
   真机 r2 实测该元素的最终文案是 `JL 同步[err] 连接形状不符（没有 requestExecute）⇒ 该连接未包装`
   （出自 `jlSyncWrapConn`，Phase 4 既有诊断、r1 console 已出现 10 次），释放文案被顶掉
   ⇒ 只按文案判会让主页面那条提示**恒不出现**。
   文案路径**保留为回退**：读数面取不到时（跨版本子文档 / 引导脚本未装载 / 降级）仍按文案判，不失效。 */
function jlLeaseChildNote() {
  if (!jlLabAlive()) return null;
  try {
    var st = null;
    try {
      st = (typeof JL_LAB_WIN.__JL_LEASE_STAT === "function") ? JL_LAB_WIN.__JL_LEASE_STAT() : null;
    } catch (e0) { st = null; }
    if (st && st.released === true) {
      var ps = st.preSync || {};
      return "内核已释放（读数面 __JL_LEASE_STAT：released=true · 释放前同步"
        + (Number(ps.ok) >= 1 ? "成功 " + ps.ms + " ms" : "未成功(gate=" + String(ps.gate) + ")")
        + " · releaseWithinWindow=" + String(st.withinWindow) + "）";
    }
    var d = JL_LAB_WIN.document, el = d ? d.getElementById("jl-sync-note") : null;
    return el ? String(el.textContent || "").slice(0, 300) : null;
  } catch (e) { return null; }
}
function jlLeaseReadout() {
  var now = Date.now();
  return { version: 1, tab: JL_LEASE_TAB, ticks: JL_LEASE_TICKS, phase: JL_LEASE_PHASE,
    idleMs: JL_LEASE_IDLE_MS, tickMs: JL_LEASE_TICK_MS, ttlMs: jlLeaseTtlMs(),
    ownAt: JL_LEASE_OWN_AT, selfBeat: JL_LEASE_SELF_BEAT, jupAt: JL_LEASE_JUP_AT, jupBeat: JL_LEASE_JUP_BEAT,
    sharedIdleMs: JL_LEASE_SHARED_IDLE, sharedMaxMs: JL_LEASE_SHARED_MAX, childFresh: JL_LEASE_CHILD_FRESH,
    labAlive: jlLabAlive(), kvWrites: JL_LEASE_KVW, gc: JL_LEASE_GCINFO, gcTotal: JL_LEASE_GC,
    kaChecks: JL_LEASE_KA_CHECKS, kaTouched: JL_LEASE_KA_TOUCHED, kaNoted: JL_LEASE_KA_NOTED,
    pooled: (typeof PY_POOL !== "undefined" && PY_POOL) ? PY_POOL.length : null,
    childReleased: JL_LEASE_CHILD_REL, alerted: JL_LEASE_ALERTED, err: JL_LEASE_ERR, at: now };
}
function jlLeasePublish(o) {
  var s = "";
  try { s = JSON.stringify(o); } catch (e) { s = "{}"; }
  jlMirrorPub("lease-stat", s);
  jlMirrorPub("lease-phase", String(o.phase || ""));
  jlMirrorPub("lease-idle", String(o.sharedIdleMs == null ? "" : (Math.round(o.sharedIdleMs / 1000) + "s/" + Math.round(Number(o.idleMs || 0) / 1000) + "s")));
  jlMirrorPub("lease-kv", String(o.kvWrites) + "/" + String(o.gcTotal));
  jlMirrorPub("lease-ka", String(o.kaChecks) + "/" + String(o.kaTouched));
  jlMirrorPub("lease-child", String(o.childReleased == null ? "" : o.childReleased));
}
/* 主页面 tick（30 s，与 appE 的 `PY_IDLE_TICK` 同值）：代写两侧租约 + 自写 `LS_KEY.jlLease` + TTL/GC + 续命 + 提示 */
function jlLeaseTick() {
  JL_LEASE_TICKS++;
  var now = Date.now();
  var own = jlLeaseOwnActivityAt();
  var child = jlLeaseChildRec();
  var childFresh = !!(child && child.ok && (now - Number(child.beat || 0)) <= jlLeaseTtlMs());
  var labAlive = jlLabAlive();
  var childAlive = !!(labAlive && childFresh);           /* liveness = 纯超时 ∨ 句柄 closed（取并） */
  if (own > 0) JL_LEASE_OWN_AT = own;
  JL_LEASE_SELF_BEAT = now;
  JL_LEASE_CHILD_FRESH = childFresh;
  JL_LEASE_JUP_AT = (childAlive && child) ? Number(child.lastActive || 0) : JL_LEASE_JUP_AT;
  JL_LEASE_JUP_BEAT = childAlive ? now : JL_LEASE_JUP_BEAT;
  JL_LEASE_SHARED_IDLE = jlLeaseSharedIdle(now);
  if (JL_LEASE_SHARED_IDLE > JL_LEASE_SHARED_MAX) JL_LEASE_SHARED_MAX = JL_LEASE_SHARED_IDLE;
  JL_LEASE_PHASE = childAlive ? (JL_LEASE_SHARED_IDLE >= JL_LEASE_IDLE_MS ? "shared-idle-over" : "shared-active")
    : "jupyter-absent";
  var w1 = jlLeaseKvPut(JL_LEASE_KV_MAIN, { tab: JL_LEASE_TAB, kind: "main", beat: now, lastActive: Number(JL_LEASE_OWN_AT || 0) });
  var w2 = childAlive
    ? jlLeaseKvPut(JL_LEASE_KV_JUP, { tab: String((child && child.tab) || ""), kind: "jupyter", beat: now, lastActive: Number(JL_LEASE_JUP_AT || 0) })
    : Promise.resolve(true);
  Promise.all([w1, w2]).then(function () { JL_LEASE_KVW += 2; }, function () {});
  jlLeasePublishSelf(now, JL_LEASE_OWN_AT);
  jlLeaseGc(now);
  jlLeaseKeepAliveMain(now, childAlive && (now - JL_LEASE_JUP_AT) < JL_LEASE_IDLE_MS);
  var note = jlLeaseChildNote();
  JL_LEASE_CHILD_REL = note === null ? null : (note.indexOf("内核已释放") >= 0);
  if (JL_LEASE_CHILD_REL === true && JL_LEASE_ALERTED !== true) {
    JL_LEASE_ALERTED = true;
    toast("Jupyter 侧内核已按空闲口径回收（超过 " + Math.round(JL_LEASE_IDLE_MS / 60000) + " 分钟无活动）；再次执行会自动重开", "info", 5200);
  }
  if (JL_LEASE_PHASE === "shared-idle-over" && !JL_LEASE_ALERTED) {
    JL_LEASE_ALERTED = true;
    toast("空闲已达 " + Math.round(JL_LEASE_IDLE_MS / 60000) + " 分钟：两侧运行时将各自回收（下次执行会自动重启）", "info", 5200);
  }
  if (JL_LEASE_SHARED_IDLE < JL_LEASE_IDLE_MS) JL_LEASE_ALERTED = false;
  jlLeasePublish(jlLeaseReadout());
  return JL_LEASE_PHASE;
}
function jlLeaseStart() {
  if (JL_LEASE_TIMER !== null) return { started: false, already: true, tickMs: JL_LEASE_TICK_MS };
  JL_LEASE_OWN_AT = jlLeaseOwnActivityAt();
  JL_LEASE_TIMER = setInterval(jlLeaseTick, JL_LEASE_TICK_MS);
  JL_LEASE_PHASE = "started";
  jlMirrorPub("lease", "started@" + Date.now() + " idleMs=" + JL_LEASE_IDLE_MS + " tickMs=" + JL_LEASE_TICK_MS);
  jlLeaseTick();
  return { started: true, tickMs: JL_LEASE_TICK_MS, idleMs: JL_LEASE_IDLE_MS };
}
function jlLeaseInit() {
  JL_LEASE_OWN_AT = jlLeaseOwnActivityAt();
  jlLeasePublish(jlLeaseReadout());
  jlLeaseStart();
  return true;
}
function jlMirrorInit() {
  try { window.addEventListener("storage", jlOnStorageJl, false); } catch (e) {}
  /* 需求 3 已落地 `wsCtxRegisterExtra` ⇒ Phase 4 注册「通过 JupyterLab 打开」（用户原话为准,§2.4 文案口径） */
  try {
    if (typeof wsCtxRegisterExtra === "function") {
      wsCtxRegisterExtra({
        id: "jl-open", label: "通过 JupyterLab 打开", icon: "file", hint: "在工作区为根的 JupyterLab 新标签页里打开该文件",
        when: function (ctx) { return !!(ctx && ctx.type === "file" && jlAvailable().ok); },
        run: function (ctx) {
          if (!ctx || !ctx.wsId) { toast("未绑定工作区", "warn", 3600); return; }
          if (ctx.wsId !== WS_RAIL_SEL) { toast("请先切到该文件所在的工作区", "warn", 3600); return; }
          jlLabOpen(ctx.wsId, ctx.path);
        }
      });
      jlMirrorPub("ctxmenu", "registered");
    }
  } catch (e4) { jlMirrorPub("ctxmenu", "ERR:" + String((e4 && e4.message) || e4).slice(0, 80)); }
  if (jlLabAlive()) jlMirrorStart();   /* 页内重入（异常路径）时接上 */
  jlLeaseInit();                       /* Phase 5：空闲租约（主页面单写者）+ TTL/GC + 共享时钟 */
  return true;
}
jlMirrorInit();
