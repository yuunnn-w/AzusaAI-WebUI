    }, function (e) { o.err = String((e && e.message) || e).slice(0, 140); return o; });
  } catch (e2) { o.err = String((e2 && e2.message) || e2).slice(0, 140); return Promise.resolve(o); }
}
/* Contents 递归列（驱动门 = 段名 denylist;越界/失败逐条留档,不静默） */
async function jlMirrorListChild(cs) {
  var out = { files: [], dirs: [], truncated: false, why: "", err: [] };
  var walk = async function (dir, dep) {
    if (out.truncated) return;
    /* **P0-1 闸的覆盖面补齐**：深度截断原先**不置** `truncated`（只静默 `return`）⇒ "枚举不完整"
       被下游当成"完整"（方案 `b2-sync-plan.md:300` 的 C-6 闸③ 逐字含"未命中 `MAX_DEPTH`"）。 */
    if (dep > JL_MIRROR_MAX_DEPTH) { out.truncated = true; out.why = out.why || "depth"; return; }
    var m = null;
    try { m = await cs.get(dir, { content: true }); }
    catch (e) { out.err.push({ path: dir, why: String((e && e.message) || e).slice(0, 100) }); return; }
    var items = (m && m.content) || [], i, it, p;
    if (Object.prototype.toString.call(items) !== "[object Array]") return;
    for (i = 0; i < items.length; i++) {
      it = items[i];
      if (!it || !it.name) continue;
      p = (dir === "/" ? "" : dir) + "/" + it.name;
      if (jlMirrorDenied(p)) continue;
      if (it.type === "directory") { out.dirs.push(p); await walk(p, dep + 1); }
      else if (out.files.length >= JL_MIRROR_MAX_FILES) { out.truncated = true; out.why = "count"; return; }
      else out.files.push(p);
    }
  };
  await walk("/", 0);
