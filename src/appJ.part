  }, function () { return null; });
}
function jlMirrorKvPut(key, obj) {
  return wsStoreTx(IDB_PYC, "readwrite", function (tx) {
    tx.objectStore(IDB_PYC).put({ name: String(key), data: JSON.stringify(obj || {}), at: Date.now(), jl: 1 }, String(key));
    return { ok: true };
