  }
  function jlSyncUtf8Bytes(s) { return new TextEncoder().encode(String(s)).length; }
  async function jlSyncContentsSnapshot(conn) {
    var out = { files: [], dirs: [], skipped: [], errors: [], entries: 0, bytes: 0,
      truncated: false, truncatedEntries: 0 };
    var sm2 = jlSyncSm();
    if (!sm2 || !sm2.contents) { out.errors.push("serviceManager.contents 缺失"); return out; }
    var stop = false;
    async function walk(dir, depth) {
      /* 目录列举**必须带 content**（`?` D 的形态面）：`contents.get(dir,{content:false})` 是
         "只取元数据"的语义 ⇒ 目录模型的 `content` 不被填充 ⇒ 快照恒为空 ⇒ ② 一件都注入不了。
         本批按"显式 content:true"收口，读数（两种写法的对照）落 out/r7/。 */
      var m = null;
      try { m = await sm2.contents.get(dir, { content: true }); }
      catch (e) { out.errors.push("listdir " + dir + ":" + ((e && e.message) || e)); return; }
      var items = (m && m.content) || [], i;
      for (i = 0; i < items.length; i++) {
        if (stop) return;
        var it = items[i];
        if (!it || !it.name) continue;
        var p = (dir === "/" ? "" : dir) + "/" + it.name;
        out.entries++;
        if (out.entries > JL_SYNC_MAX_ENTRIES) {
          out.truncated = true;
          out.truncatedEntries++;
          out.skipped.push({ path: dir, why: "count", prefix: true });
          stop = true;
          return;
        }
        if (it.type === "directory") {
          out.dirs.push(p);
          if (depth + 1 > JL_SYNC_MAX_DEPTH) {
            out.truncated = true;
            out.truncatedEntries++;
            out.skipped.push({ path: p, why: "depth", prefix: true });
            continue;
          }
          await walk(p, depth + 1);
          continue;
        }
        if (it.type !== "file" && it.type !== "notebook") { out.skipped.push({ path: p, why: "deny" }); continue; }
        if (out.files.length >= JL_SYNC_MAX_FILES) {
          out.truncated = true;
          out.skipped.push({ path: p, why: "count" });
          continue;
        }
        var b64 = null, size = 0, lm = null;
        try {
          if (it.type === "file") {
            var one = await sm2.contents.get(p, { content: true, format: "base64" });
            /* 去空白：base64 可能带折行（`?` D 未闭合前的保守归一）——两侧比对与摘要域都按去空白后的串取 */
            b64 = (one && typeof one.content === "string") ? one.content.replace(/\s+/g, "") : null;
            size = (one && typeof one.size === "number") ? one.size : (b64 ? jlSyncB64Bytes(b64) : 0);
            lm = (one && one.last_modified) || null;
          } else {
            var nb = await sm2.contents.get(p, { content: true, format: "text" });
            var txt = (nb && typeof nb.content === "string") ? nb.content : JSON.stringify((nb && nb.content) || {});
            b64 = jlSyncB64Utf8(txt);
            /* **字节数**（不是字符数）：内核侧的摘要用 `len(bytes)` ⇒ 非 ASCII 笔记本按字符数记账会恒不相等 */
            size = (nb && typeof nb.size === "number") ? nb.size : jlSyncUtf8Bytes(txt);
            lm = (nb && nb.last_modified) || null;
          }
        } catch (e2) { out.errors.push("read " + p + ":" + ((e2 && e2.message) || e2)); continue; }
