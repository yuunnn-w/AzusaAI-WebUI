/* ⑤ `filebrowser:refresh` 的**真正实现**（主页面驱动 ⇒ 主页面负责让子文档 UI 跟上） */
function jlMirrorRefreshChild() {
  var o = { at: Date.now(), has: null, ok: false, err: "", why: "" };
  var a = jlMirrorChildApp();
  if (!a || !a.commands) { o.err = "子文档 app.commands 缺失(" + (JL_MIRROR_WHY || "?") + ")"; return Promise.resolve(o); }
  try {
    o.has = (typeof a.commands.hasCommand === "function") ? !!a.commands.hasCommand("filebrowser:refresh") : null;
    if (o.has === false) { o.err = "子文档 filebrowser:refresh 不在册"; return Promise.resolve(o); }
    return Promise.resolve(a.commands.execute("filebrowser:refresh")).then(function () {
      o.ok = true; JL_MIRROR_REFRESHES++;
