    protoS.setAttribute = function (name, value) {
      if (String(name).toLowerCase() === "src") {
        var p = pathOf(value);
        if (p !== null) {
          var t = TEXT[p];
          if (t === undefined) missOf(p, "script.setAttribute");
          else return realSetAttrS.call(this, name, blobUrlOf(t, "text/javascript"));
        }
      }
      return realSetAttrS.call(this, name, value);
    };
    var realSetAttrL = protoL.setAttribute;
    protoL.setAttribute = function (name, value) {
      if (String(name).toLowerCase() === "href") {
        var p = pathOf(value);
        if (p !== null) {
          var t = TEXT[p];
