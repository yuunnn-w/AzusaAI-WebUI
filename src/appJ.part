          continue;
        }
        out.bytes += b64.length;
        out.files.push({ path: p, b64: b64, size: size, lastModified: lm,
          hash: jlSyncHashContent(b64, size) });
      }
    }
    await walk("/", 0);
    return out;
  }
  /* ② 的载荷构建（B2-b：**由"全量注入"升级为"差分注入 + 可短路"**，§3.3 分段短路表 + §4.4 C-1/C-2/C-5）
     · `full === true`（`__jlLedgerValid === false`：新 conn / 刚重启 / 世代不符 / 截断降级轮）
       ⇒ 注入 Contents 全集、`del` 恒空（§3.3「且本轮不做任何 C-5 摘除」）；
     · `full === false`（账本有效）⇒ 逐路径按**内容摘要**判等（§3.3 第 1 条：**按内容判等，不是时间戳**）：
         摘要相同 ⇒ 视为同一版本（**不触发注入**）；不同/侧无此路径 ⇒ `add`（C-1/C-2）；
         `P ∈ ledger 的已同步位 ∧ Contents 已无 P` ⇒ C-5 从内核 FS 摘除（`del`）。
     ⇒ **两处都不动**（`add` 与 `del` 皆空）时 ② **不派发隐藏执行**（调用方短路，§3.3「② 可短路」）。 */
  function jlSyncBuildIn(snap, ledger, full) {
    var L = ledger || {}, add = [], del = [], inSkip = [], holder = { __jlLedger: {} }, i, seen = {};
    for (i = 0; i < snap.files.length; i++) {
      var f = snap.files[i];
      var lr = jlSyncLedgerGet({ __jlLedger: L }, f.path);
      /* **入方向的跳过位**（B2-c 准入 ⑦ · §4.4 的对称面）：ledger 里是跳过位 ⇒ 该路径的内核副本
         是"权威侧旧内容 + 内核侧尚未回收的改动"混杂态 ⇒ **不得回灌** Contents 快照。
         （不写死这条，C-1 的"新增"读法会把内核改动**静默覆盖**：失败形状 = Contents 已存在 ∧
         内核把它改到超**回收**上限 ⇒ ④ 记 `{skipped:"size"}` ⇒ 下一格照 C-1 注入 Contents 旧内容
         ⇒ 内核改动丢失、`kernelEditSurvived=false`。）⇒ 与 C-11 对称：**不回写、也不回灌**，
         且**跳过位必须原样保留**（抹成"已同步位"会立刻引发下一边界 ④ 的 C-5 误判）。 */
      if (lr && lr.skipped) {
        seen[f.path] = true;
        inSkip.push({ path: f.path, why: String(lr.skipped), prefix: !!lr.prefix });
        jlSyncLedgerSet(holder, f.path, lr);
        continue;
      }
      var same = !!(lr && lr.hash && lr.hash === f.hash && lr.size === f.size);
      seen[f.path] = true;
      if (!same) add.push({ path: f.path, b64: f.b64 });
      jlSyncLedgerSet(holder, f.path, { size: f.size, mtime: (lr && !lr.skipped) ? lr.mtime : 0,
        lastModified: f.lastModified, hash: f.hash });
    }
    for (i = 0; i < snap.skipped.length; i++) {
      var s = snap.skipped[i];
      jlSyncLedgerSet(holder, s.path, s.prefix
        ? { skipped: s.why, at: Date.now() - KR.t0, prefix: true, root: s.path }
        : { skipped: s.why, at: Date.now() - KR.t0 });
    }
    if (full !== true) {
      for (var p in L) {
        if (!Object.prototype.hasOwnProperty.call(L, p)) continue;
        var pr = L[p];
        if (!pr || pr.skipped || seen[p]) continue;
        del.push(p);
      }
    }
    return { payload: { nonce: null, add: add, del: del, full: (full === true) },
      ledger: holder.__jlLedger, count: add.length, delCount: del.length, bytes: snap.bytes,
      inSkip: inSkip };
  }
  function jlSyncStatNoteSkips(snap) {
    var S = jlSyncSt(), i;
    for (i = 0; i < snap.skipped.length; i++) {
      var s = snap.skipped[i];
      S.skippedPaths.push({ path: s.path, why: s.why, prefix: !!s.prefix });
      jlSyncNote("跳过：" + s.path + "（why=" + s.why + (s.prefix ? " · prefix" : "") + "）", "warn", s.path);
    }
    if (snap.truncatedEntries) S.truncatedEntries += snap.truncatedEntries;
    if (snap.truncated) {
      JLS_DEGRADED = true;
      S.degraded = true;
      jlSyncNote("本边界扫描被上限截断（截断类只记前缀跳过位）⇒ 不静默", "degraded");
    }
    if (S.skippedPaths.length > 300) S.skippedPaths = S.skippedPaths.slice(-300);
  }
  function jlSyncLedgerGet(conn, path) {
    if (!conn.__jlLedger) return null;
    return Object.prototype.hasOwnProperty.call(conn.__jlLedger, path) ? conn.__jlLedger[path] : null;
  }
  function jlSyncLedgerSet(conn, path, rec) {
    if (!conn.__jlLedger) conn.__jlLedger = {};
    conn.__jlLedger[path] = rec;
    return rec;
  }
  async function jlSyncIn(conn) {
    var S = jlSyncSt();
    var rec = { at: Date.now() - KR.t0, conn: String(conn.id), bootSeen: conn.__jlBootSeen,
      nonce: conn.__jlNonce, ledgerValid: conn.__jlLedgerValid === true,
      forceOff: jlSyncForceOff("in"), gate: null, injected: 0, files: 0, bytes: 0,
      entries: 0, dirs: 0, applyMs: 0, applyStatus: "", stale: false, incomplete: false,
      truncated: false, ms: 0, errors: [], addCount: 0, delCount: 0, deleted: 0, full: false,
      shortCircuit: false };
    try {
      if (rec.forceOff) {
        rec.gate = "force-off";
        rec.incomplete = true;
        jlSyncNote("__JL_SYNC_FORCE_OFF.in=1 ⇒ 'in' 方向同步关闭（测试注入面）", "warn");
        return rec;
      }
      /* ② 的 boot 门槛：链首 await boot 观察点（§4.4 门槛的等价写法①），再按合取否定复核（写法②）。
         **boot 是懒惰启动的（B2-a 实测修正）**：`jlSyncWrapConn` 只登记、**不**起 hidden exec ——
         `sm.kernels.connectTo` 每被调用一次就产生**一个新的 KernelConnection 对象**（同一 kernel id；
         实测 r7：一次 `notebook:create-new` 触发 3 个对象），其中只有"真正跑单元格的那一个"的请求
         会被内核应答；对未使用的对象过早发 hidden exec ⇒ 永不应答 ⇒ **300 s 超时**（实测
         `bootRuns` 里两条 `sync.exec 超时 300000 ms`），并会把该对象的首个边界拖住。
         ⇒ 改为"**第一次进入边界时才 boot**"（此时内核必然已就绪：单元格在执行）。 */
      if (!conn.__jlSyncBoot) conn.__jlSyncBoot = jlSyncBootRun(conn);
      try { await jlRace(Promise.resolve(conn.__jlSyncBoot), JL_KERNEL_READY_MS, "sync.bootWait"); }
      catch (e) { rec.errors.push("bootWait:" + ((e && e.message) || e)); }
      rec.bootSeen = conn.__jlBootSeen;
      rec.nonce = conn.__jlNonce;
      if (conn.__jlBootSeen === 0 || conn.__jlNonce === null) {
        rec.gate = "boot-gate";
        rec.incomplete = true;
