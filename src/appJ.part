  var g = JL_MIRROR_GONE[p];
  if (!g) return null;
  if (Date.now() - Number(g.at || 0) > JL_MIRROR_GONE_TICKS * JL_MIRROR_TICK_MS) { delete JL_MIRROR_GONE[p]; return null; }
  return g;
}
function jlMirrorGonePrune() {
  var p, n = 0;
