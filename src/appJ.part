      return new Response(u8, { status: 200, headers: { "Content-Type": mimeOf(p) } });
    }
    function want(p) {
      if (SEG[p]) return Promise.resolve({ path: p, bytes: SEG[p] });
      if (!PORT) return Promise.resolve({ path: p, miss: "与父文档的专用通道未建立" });
      var q = ++QN;
