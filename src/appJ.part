          + String(conn.__jlNonce) + "）⇒ 不下发注入载荷；本边界按不完整处置（不判任何删除 + 下一边界全量）");
        return rec;
      }
      rec.gate = "pass";
      var snap = await jlSyncContentsSnapshot(conn);
      rec.entries = snap.entries;
      rec.dirs = snap.dirs.length;
      rec.truncated = snap.truncated;
      if (snap.errors.length) rec.errors = rec.errors.concat(snap.errors);
      jlSyncStatNoteSkips(snap);
      var fullIn = (rec.ledgerValid !== true);
      var built = jlSyncBuildIn(snap, conn.__jlLedger, fullIn);
      rec.addCount = built.count;
      rec.delCount = built.delCount;
      rec.full = fullIn;
      rec.inSkip = built.inSkip.length;
      /* 入方向跳过位（准入 ⑦）：**不静默** —— 逐路径进 `skippedPaths[]` + 状态行，
         与「跳过 ≠ 缺席」同款纪律（保留跳过位是语义的一部分，不是副作用）。 */
      for (var sq = 0; sq < built.inSkip.length; sq++) {
        var sj = built.inSkip[sq];
        jlSyncStatPushSkip(sj.path, sj.why, sj.prefix);
        jlSyncNote("入方向跳过：该路径在账本上是跳过位（why=" + sj.why + (sj.prefix ? " · prefix" : "")
          + "）⇒ 不下发 Contents 快照（内核侧改动不得被静默覆盖）", "warn", sj.path);
      }
      /* 跳过位清单的**内核侧投影**（§4.5 的 `open()` 包装器要用它判分支 ①/③/④）：
         来源 = 本边界 Contents 快照的跳过项 ∪ 账本的跳过位（含前缀位）。 */
      var skips = [], sl = 0, sp2 = null, sr2 = null;
      for (sl = 0; sl < snap.skipped.length; sl++) {
        skips.push({ path: snap.skipped[sl].path, why: String(snap.skipped[sl].why || ""),
          prefix: !!snap.skipped[sl].prefix });
      }
      for (sp2 in conn.__jlLedger) {
        if (!Object.prototype.hasOwnProperty.call(conn.__jlLedger, sp2)) continue;
        sr2 = conn.__jlLedger[sp2];
        if (sr2 && sr2.skipped) skips.push({ path: sp2, why: String(sr2.skipped), prefix: !!sr2.prefix });
      }
      skips.sort(function (a, b) { return String(a.path) < String(b.path) ? -1 : 1; });
      var skipsSig = JSON.stringify(skips);
      built.payload.skips = skips;
      /* 已推过的清单不重复推（否则"有跳过位的目录"会让 ② 每边界都多发一次隐藏执行，
         破坏 §3.3 的"② 可短路"常态口径）；清单变了 ⇒ **必须**推（否则包装器的分支 ④ 拿到的是旧清单）。 */
      var needSkips = (skips.length > 0 && conn.__jlSkipsSig !== skipsSig);
      /* §3.3 段短路表：**② 可短路**，前置 = `__jlLedgerValid === true` ∧ Contents 与 ledger 完全一致
         （= 差分的 `add` 与 `del` 皆空）⇒ 直接返回、**不发请求**（常态额外执行 ≤1 次的落点）。
         ⚠️ ④ **不得**短路（内核侧有没有脏只能靠扫描才知道）⇒ 短路口径只在本函数内。 */
      if (built.count === 0 && built.delCount === 0 && !needSkips) {
        conn.__jlLedger = built.ledger;                     /* 账本按 Contents 现值刷新（mtime/lastModified） */
        conn.__jlInjected = {};
        rec.shortCircuit = true;
        rec.ms = Date.now() - KR.t0 - rec.at;
        jlSyncNote("② 短路：Contents 与账本一致（add=0 ∧ del=0）⇒ 本边界不发任何隐藏执行"
          + (built.inSkip.length ? "（另有 " + built.inSkip.length + " 条入方向跳过位，见上）" : ""), "info");
        return rec;
      }
      rec.skipPush = needSkips ? skips.length : 0;
      built.payload.nonce = conn.__jlNonce;                 /* 当代值（boot 观察点确立） */
      var t0 = Date.now();
      var io = await jlSyncHiddenExec(conn, jlSyncApplySrc(built.payload), { budgetMs: JL_EXEC_TIMEOUT_MS });
      rec.applyMs = Date.now() - t0;
      rec.applyStatus = io.status;
      if (!io.status || io.status !== "ok") rec.errors.push("applyStatus=" + io.status);
      var res = jlSyncParseOut(io.streams.stdout || "", JL_SYNC_SENTINEL);
      if (res && res.stale === true) {
        rec.stale = true;
        rec.incomplete = true;
        S.generation.staleApply++;
        jlSyncLedgerClear(conn, "apply-stale");
        jlSyncNote("apply 侧世代不符（内核在本边界内重启/崩溃）⇒ 本边界不判任何删除", "degraded");
        return rec;
      }
      if (!res || res.ok !== true) {
        rec.incomplete = true;
        jlSyncDegrade("本次注入不完整（哨兵缺失 / JSON 解析失败 / 执行未 ok）⇒ 保留旧账本 + 置假 + 本边界不判任何删除");
        if (io.errors && io.errors.length) rec.errors.push(JSON.stringify(io.errors[0]));
        return rec;
      }
      /* ⚠️ **R-D2-1（B2-c · D3 补批，2026-09-17）**：`__azusa_sync_apply` **逐项失败只进 `_errs`、
         `ok` 仍 `true`** ⇒ 若照 `res.ok===true` 在下一行整体换账本，就把"内核**没**写成的路径"
         （新件注入失败 ⇒ 内核侧根本不存在）记成「**已同步位**」⇒ 下一边界 ④ 见其缺席 ⇒ C-6 删掉
         Contents 副本 = **用户刚建的文件两边都没了**（与 B2-b P0 同形的数据丢失）。
         ⇒ 非空即视为 `incomplete`：**保留旧账本**（不整体换）+ 本边界不判任何删除 + 不声明已注入。 */
      if (res.errors && res.errors.length) {
        rec.incomplete = true;
        var er0 = 0;
        for (er0 = 0; er0 < res.errors.length; er0++) {
          rec.errors.push(String(res.errors[er0].path) + ":" + String(res.errors[er0].error));
        }
        jlSyncDegrade("apply 逐项失败 " + res.errors.length + " 条（" + rec.errors[0]
          + "）⇒ 保留旧账本 + 本边界不判任何删除（R-D2-1）");
        return rec;
      }
      conn.__jlLedger = built.ledger;                       /* 只在一次完整成功的边界之后整体替换 */
      conn.__jlSkipsSig = skipsSig;                         /* 跳过位清单已随本边界推给内核（`open()` 分支 ①/③/④ 用） */
      /* 本边界注入过的路径（C-4 的冲突判定要它）——内核侧优先，但那要等 ④ 的扫描 ⇒ 这里先记我们的意图 */
      conn.__jlInjected = {};
      var ii = 0;
      for (ii = 0; ii < built.payload.add.length; ii++) {
        conn.__jlInjected[built.payload.add[ii].path] = built.payload.add[ii].b64.length;
      }
      if (res.errors && res.errors.length) {
        var ei = 0;
        for (ei = 0; ei < res.errors.length; ei++) rec.errors.push(String(res.errors[ei].path) + ":" + String(res.errors[ei].error));
      }
      rec.injected = Number(res.written) || 0;
      rec.files = built.count;
      rec.bytes = built.bytes;
      rec.deleted = Number(res.deleted) || 0;
      S.injected += rec.injected;
      rec.ms = Date.now() - t0;
      jlSyncNote("② 注入完成：" + (fullIn ? "全量" : "差分") + " 注入 " + rec.injected + " 件 / " + built.bytes
        + " B（删 " + rec.deleted + " 件 · 目录 " + rec.dirs + " 个 · 条目 " + rec.entries + "）· " + rec.ms + " ms", "info");
      return rec;
    } finally {
      var D = jlSyncDg();
      D.boundaries.push(rec);
      if (D.boundaries.length > 80) D.boundaries.shift();
      S.ledgerValid = conn.__jlLedgerValid === true;
    }
  }

  /* ==================== ④ `jlSyncOut`：内核 MEMFS 差分 → Contents（§3.3 链的 ④ + §4.4） ====================
     写死口径（逐条来自方案，实现时不得"简化"）：
       · **不得短路**（§3.3 短路表）：内核侧"有没有脏"只能靠扫描才知道 ⇒ 每个边界都扫一次；
       · **世代比对**（§4.4「④ 的 scan 比较」）：`scan.nonce` ≠ `conn.__jlNonce` ⇒ 同款重置（清账本 +
         置假 + 不判任何删除 + degraded + `resetCount++` + 追加 `events[{at:"scan"}]`）；
       · **`__jlLedgerValid` 置真的唯一落点**：世代比对通过之后、**判删除之前**（§4.4 v4 写死）；
       · **C-3 回收** / **C-6 删除（三条前置闸）** / **C-11 跳过位（含前缀跳过位）一律不回写** /
         **截断与上限 ⇒ 本轮不判任何删除** / **IO_TOTAL 命中 ⇒ 本边界不回写**；
       · 回声抑制 = **值比对为主**（摘要 + Contents 现值逐字节比对）+ **计数式 `jlApplyDepth` 为辅**
         （带泄漏护栏）+ 回声环收敛三件（按内容判等 / 自写后前移游标 / 硬熔断）。 */
  function jlSyncPathSegs(p) {
    var s = String(p || "").split("/"), out = [], i;
    for (i = 0; i < s.length; i++) { if (s[i]) out.push(s[i]); }
    return out;
  }
  /* 路径**段**前缀匹配（与 E-3 同款纪律：不用字符串前缀匹配 —— "/sub" 不得命中 "/subject"） */
  function jlSyncPathUnder(p, root) {
    var a = jlSyncPathSegs(p), b = jlSyncPathSegs(root), i;
    if (!b.length || b.length > a.length) return false;
    for (i = 0; i < b.length; i++) { if (a[i] !== b[i]) return false; }
    return true;
  }
  /* 跳过位命中（§4.4 C-11）：精确键 **或** 落在任一"前缀跳过位"的子树内 */
  function jlSyncSkipHit(conn, path) {
    var L = conn.__jlLedger || {}, r = jlSyncLedgerGet(conn, path), k;
    if (r && r.skipped) return r;
    for (k in L) {
      if (!Object.prototype.hasOwnProperty.call(L, k)) continue;
      r = L[k];
      if (r && r.skipped && r.prefix && jlSyncPathUnder(path, r.root || k)) return r;
    }
    return null;
  }
  /* `skippedPaths[]` 的单点追加（**逐路径**、按 (path,why,prefix) 去重 ⇒ 同一路径每边界只记一条） */
  function jlSyncStatPushSkip(path, why, prefix) {
    var S = jlSyncSt(), i;
    for (i = 0; i < S.skippedPaths.length; i++) {
      var e = S.skippedPaths[i];
      if (e.path === path && e.why === why && !!e.prefix === !!prefix) return false;
    }
    S.skippedPaths.push({ path: path, why: why, prefix: !!prefix });
    if (S.skippedPaths.length > 300) S.skippedPaths = S.skippedPaths.slice(-300);
    return true;
  }
  /* 计数式 `jlApplyDepth`（**辅助**）+ 泄漏护栏（P1-5 ②）：`finally` 保证递减，首尾断言归零 */
  async function jlSyncDepthWrap(conn, fn) {
    conn.__jlDepth = Number(conn.__jlDepth || 0) + 1;
    try { return await fn(); }
    finally { conn.__jlDepth = Number(conn.__jlDepth || 0) - 1; }
  }
  function jlSyncDepthCheck(conn, where) {
    var d = Number(conn.__jlDepth || 0);
    if (d !== 0) {
      jlSyncSt().depthLeak++;
      jlSyncNote("jlApplyDepth 泄漏护栏命中（" + where + " · 深度=" + d + "）⇒ 计数式回声抑制失衡", "err");
    }
    return d;
  }
  /* 回声环收敛三件之二/之三（§3.3）：值比对 + `JL_SYNC_ECHO_STOP_ROUNDS` 硬熔断（状态行记 echoQuiet，不静默）
     · `D.inject.echoQuiet` = 诊断注入面（准入 ⑨）：命中路径**强制**熔断 ⇒ 给"回声环硬熔断"
       配一条**真机臂**（此前只有读码级 ⇒ 未达 [E13] 已验证）。仅诊断用，不是产品运行期开关。 */
  function jlSyncEchoOk(conn, path, hash) {
    var E = conn.__jlEcho;
    if (!E) { E = conn.__jlEcho = {}; }
    var e = Object.prototype.hasOwnProperty.call(E, path) ? E[path] : null;
    if (!e) { e = E[path] = { last: null, quiet: 0 }; }
    var inj = jlSyncDg().inject;
    if (inj && inj.echoQuiet !== null && inj.echoQuiet !== undefined && String(inj.echoQuiet) === String(path)) {
      e.quiet = JL_SYNC_ECHO_STOP_ROUNDS;
    } else if (e.last !== null && !!hash && e.last === hash) e.quiet++;
    else e.quiet = 0;
    e.last = hash || null;
    if (e.quiet >= JL_SYNC_ECHO_STOP_ROUNDS) {
      jlSyncSt().echoQuiet++;
      jlSyncNote("回声环硬熔断：该路径连续 " + e.quiet + " 轮判为「候选改动」但内容与上轮相同 ⇒ 停止推送",
        "echoQuiet", path);
      return false;
    }
    return true;
  }
  /* 分片拼接；`path` 只为**诊断注入面**（准入 ⑨：`D.inject.dropChunk` ⇒ 真机臂"分片不齐"）。 */
  function jlSyncChunksJoin(c, path) {
    var parts = [], i, s = "";
    var inj = jlSyncDg().inject;
    if (inj && inj.dropChunk !== null && inj.dropChunk !== undefined && String(inj.dropChunk) === String(path)) {
      return { ok: false, reason: "injected-dropchunk", injected: true };
    }
    if (!c || !c.total) return { ok: false, reason: "no-chunks" };
    for (i = 0; i < c.total; i++) {
      if (typeof c.parts[i] !== "string") return { ok: false, reason: "missing-chunk-" + i, total: c.total };
      parts.push(c.parts[i]);
    }
    for (i = 0; i < parts.length; i++) s += parts[i];
    return { ok: true, b64: s, total: c.total };
  }
  /* 父目录兜底创建（`?` D 未闭合项：`contents.save` 是否自动建父目录**未实测**）⇒ 逐级 get，缺则 save 目录 */
  async function jlSyncContentsEnsureDir(conn, filePath) {
    var sm2 = jlSyncSm(), made = [], i, cur = "";
    if (!sm2 || !sm2.contents) return { ok: false, made: made, err: "serviceManager.contents 缺失" };
    var segs = jlSyncPathSegs(filePath);
    for (i = 0; i < segs.length - 1; i++) {
      cur = cur + "/" + segs[i];
      var mk = cur;
      try { await sm2.contents.get(mk, { content: false }); continue; } catch (e) { }
      try {
        await jlSyncDepthWrap(conn, function () { return sm2.contents.save(mk, { type: "directory" }); });
        made.push(mk);
      } catch (e2) { return { ok: false, made: made, path: mk, err: String((e2 && e2.message) || e2) }; }
    }
    return { ok: true, made: made };
  }
  /* 单路径回收：值比对（按内容判等，不是时间戳）⇒ 相同则不写（回声抑制的**主**手段） */
  async function jlSyncOutWrite(conn, path, b64, mm, oldr) {
    var out = { path: path, wrote: false, echoQuiet: false, valueSame: false, conflict: false,
      lastModified: null, curSize: null, err: "" };
    var sm2 = jlSyncSm();
    if (!sm2 || !sm2.contents) { out.err = "serviceManager.contents 缺失"; return out; }
    if (!jlSyncEchoOk(conn, path, mm.hash)) { out.echoQuiet = true; return out; }
    var cur = null;
    try { cur = await jlSyncDepthWrap(conn, function () { return sm2.contents.get(path, { content: true, format: "base64" }); }); }
    catch (e) { cur = null; }
    var curB64 = (cur && typeof cur.content === "string") ? cur.content.replace(/\s+/g, "") : null;
    out.curSize = (cur && typeof cur.size === "number") ? cur.size : null;
    if (curB64 !== null && curB64 === b64) {
      /* 内容逐字节相同 ⇒ 视为同一版本：**不写**（写就会造出一个新的 last_modified ⇒ 回声环的燃料） */
      out.valueSame = true;
      out.lastModified = (cur && cur.last_modified) || null;
      return out;
    }
    if (conn.__jlInjected && Object.prototype.hasOwnProperty.call(conn.__jlInjected, path)) out.conflict = true;
    var d = null;
    try { d = await jlSyncContentsEnsureDir(conn, path); } catch (e3) { d = { ok: false, err: String((e3 && e3.message) || e3) }; }
    out.mkdir = (d && d.made && d.made.length) ? d.made : [];
    if (d && d.ok === false) { out.err = "父目录兜底创建失败：" + String(d.err || "") + String(d.path || ""); }
    var saved = await jlSyncDepthWrap(conn, function () {
      return sm2.contents.save(path, { type: "file", format: "base64", content: b64 });
    });
    out.wrote = true;
    out.lastModified = (saved && saved.last_modified) || null;
    out.savedSize = (saved && typeof saved.size === "number") ? saved.size : null;
    out.savedFormat = "base64";
    return out;
  }
  /* ⑤ `filebrowser:refresh`（§3.3 链末）：**只调用、不实现**（该命令与其刷新语义属 **Phase 4** 的同款路径）。
     探测命令是否在册；不在 ⇒ 如实记一条（不得假装"刷过了"）。有界等待（`JL_SYNC_PUSH_WAIT_MS`）——
     不得让一次 UI 命令把链首拖住（链首挂住 = 后续边界只入队）。 */
  function jlSyncRefresh(conn) {
    var out = { called: false, has: null, ok: false, err: "" };
    var app = JLS_APP || KR.app || null;
    try {
      if (!app || !app.commands) { out.err = "app.commands 缺失"; }
      else {
        out.has = (typeof app.commands.hasCommand === "function") ? !!app.commands.hasCommand("filebrowser:refresh") : null;
        if (out.has === false) out.err = "命令 filebrowser:refresh 不在册";
        out.called = true;
        return jlRace(Promise.resolve(app.commands.execute("filebrowser:refresh")), JL_SYNC_PUSH_WAIT_MS, "⑤.refresh")
          .then(function () { out.ok = true; return out; },
            function (e) { out.err = String((e && e.message) || e); return out; });
      }
    } catch (e2) { out.err = String((e2 && e2.message) || e2); }
    return Promise.resolve(out);
  }
  async function jlSyncOut(conn) {
    var S = jlSyncSt();
    var rec = { at: Date.now() - KR.t0, conn: String(conn.id), forceOff: jlSyncForceOff("out"),
      gate: "pass", scans: 0, files: 0, same: 0, candidates: 0, reclaimed: 0, saved: 0, deleted: 0,
      skipHits: 0, skipTotal: 0, conflicts: [], over: [], noDelete: false, stale: false, incomplete: false,
      ioTruncated: false, ioBytes: 0, truncated: false, scanNonce: null, nonce: conn.__jlNonce,
      ledgerValidBefore: conn.__jlLedgerValid === true, refresh: null, ms: 0, errors: [], echoQuiet: 0,
      writeErrors: 0, savedLast: null };
    if (rec.forceOff) {
      rec.gate = "force-off"; rec.incomplete = true; rec.noDelete = true;
      jlSyncNote("__JL_SYNC_FORCE_OFF.out=1 ⇒ 'out' 方向同步关闭（测试注入面）", "warn");
      return rec;
    }
    if (conn.__jlBootSeen === 0 || conn.__jlNonce === null) {
      /* 没有 boot 就没有 `__azusa_sync_*`（内核重启后它们连定义都没了）⇒ 连扫描都发不出去 */
      rec.gate = "boot-gate"; rec.incomplete = true; rec.noDelete = true;
      jlSyncDegrade("④ 未过 boot 门槛（bootSeen=" + conn.__jlBootSeen + " · nonce=" + String(conn.__jlNonce)
        + "）⇒ 本边界不回收 + 不判任何删除");
      return rec;
    }
    rec.noDelete = true;                       /* 保守初值：任何提前返回都不判删除 */
    var t0 = Date.now(), io = null;
    try {
      io = await jlSyncHiddenExec(conn, jlSyncOutSrc(conn, jlSyncBaselineOf(conn), jlSyncKnownPaths(conn)),
        { budgetMs: JL_EXEC_TIMEOUT_MS });
    } catch (e) {
      rec.incomplete = true;
      jlSyncDegrade("④ 回收扫描异常：" + ((e && e.message) || e));
      return rec;
    }
    rec.scans = 1;
    var streamText = String(io.streams.stdout || "");
    rec.ioBytes = streamText.length + String(io.streams.stderr || "").length;
    var recs = jlSyncParseAll(streamText, JL_SYNC_SENTINEL), meta = null, i;
    for (i = recs.length - 1; i >= 0; i--) {
      if (recs[i] && recs[i].t === "meta") { meta = recs[i]; break; }
    }
    if (!meta || io.status !== "ok" || io.timeout) {
      rec.incomplete = true;
      jlSyncLedgerInvalidate(conn);
      jlSyncDegrade("④ 本次回收不完整（status=" + io.status + (io.timeout ? " · 超时" : "")
        + (meta ? "" : " · 哨兵/元数据缺失") + "）⇒ 本边界不回收 + 不判任何删除 + 下一边界全量（账本置假）");
      if (io.errors && io.errors.length) rec.errors.push(JSON.stringify(io.errors[0]));
      return rec;
    }
    rec.scanNonce = meta.nonce;
    rec.kernelSkips = (meta.skips || []).slice(0, 40);   /* 内核侧当前`_SYNC_SKIPS`的键（§4.5 包装器的依据；诊断留档） */
    S.generation.scanNonce = meta.nonce;
    if (String(meta.nonce) !== String(conn.__jlNonce)) {
      /* §4.4「④ 的 scan 比较」：窄窗口（boot 观察点之后、本边界 scan 之前重启/崩溃）⇒ 同款重置 */
      var g = S.generation, prev = conn.__jlNonce;
      g.prevNonce = prev;
      g.mismatch = (prev !== null && String(prev) !== String(meta.nonce));
      g.events.push({ at: "scan", prevNonce: prev, curNonce: meta.nonce, mismatch: g.mismatch,
        bootSeen: conn.__jlBootSeen, t: Date.now() - KR.t0 });
      rec.stale = true; rec.incomplete = true;
      jlSyncLedgerClear(conn, "scan-nonce-mismatch");
      return rec;
    }
    /* ★ `__jlLedgerValid` 置真的**唯一**落点，且必须在"判删除之前"（§4.4 v4 写死） */
    conn.__jlLedgerValid = true;
    S.ledgerValid = true;
    if (rec.ioBytes > JL_SYNC_IO_TOTAL) {
      /* §4.2 / R-19：分片只封单条，**总量**另行封；命中即判"本次同步不完整"（不回写 + 下一边界全量 + 不判删除） */
      S.ioTruncated++;
      rec.ioTruncated = true; rec.incomplete = true;
      jlSyncLedgerInvalidate(conn);
      jlSyncDegrade("单边界 IOPub 累计 " + rec.ioBytes + " B > JL_SYNC_IO_TOTAL(" + JL_SYNC_IO_TOTAL
        + ") ⇒ 本边界不回写 + 不判任何删除 + 下一边界全量");
      return rec;
    }
    /* 截断 / 上限 / 跳过 ⇒ **本轮不判任何删除**（§4.4 v3 保守闸；与 C-9 同款口径） */
    if (meta.truncated || Number(meta.truncatedEntries) > 0) {
      rec.truncated = true;
      JLS_DEGRADED = true;
      S.degraded = true;
      jlSyncNote("本边界内核侧扫描被上限截断（截断类只记前缀跳过位）⇒ 不静默", "degraded");
    }
    if (Number(meta.truncatedEntries) > 0) S.truncatedEntries += Number(meta.truncatedEntries);
    var sp = meta.skippedPaths || [], skipDenyN = 0;
    /* ⚠️ **保守闸③ 的输入口径分离（B2-c · 裁定 D2，2026-09-17）** —— 本节与下方的 `noDel` 是**一处判据**。
       `scan` 的 `skipped` 把两类语义并成一个计数：ⓐ **真实跳过事件**（截断 / 上限类 —— 指示"本轮扫描
       不完整"，该保守）；ⓑ **排除面常态命中**（`_deny()` 命中的 E-2 安装目录 / E-3 段名与后缀）。
       而本环境 `/home/pyodide/.ipython` **必然**命中 ⓑ（`JL_SYNC_DENY_SEGS` 含 `.ipython`）
       ⇒ `meta.skipped ≥ 1` 恒真 ⇒ 闸③ 恒真 ⇒ **C-6 的删除分支（"内核侧删件 ⇒ 删 Contents"）
       结构性沉默**（r10 实测：④ 边界 29 条 `noDelete` 全真、`deleted` 合计 0 ⇒ 从未执行过一次）。
       ⓑ 是**有意排除**、**不指示本轮扫描不完整** ⇒ 从闸③ 的输入里**分离出去**。
       **安全边界逐条不变**：真实跳过（`skippedReal`）/ 截断 / 不完整 ⇒ **仍 `noDel`**；
       `_deny()` 语义、`JL_SYNC_DENY_SEGS` 内容、`skippedPaths[]` 诊断留档**均未动**。 */
    for (i = 0; i < sp.length; i++) {
      if (sp[i] && sp[i].path) jlSyncStatPushSkip(sp[i].path, String(sp[i].why || "deny"), !!sp[i].prefix);
      if (sp[i] && String(sp[i].why || "deny") === "deny") skipDenyN++;
    }
    /* 真实跳过事件数 = 内核侧新分项 `skippedReal`；**老内核**（无该键 —— 例：装置 run-time override
       的替身 `scan`）回退为 `skipped − deny 命中数` ⇒ **回退方向偏保守**（分不清就仍计入闸③）。 */
    var skipReal = (typeof meta.skippedReal === "number" && isFinite(meta.skippedReal))
      ? Number(meta.skippedReal)
      : Math.max(0, (Number(meta.skipped) || 0) - skipDenyN);
    rec.skippedReal = skipReal;
    rec.skippedDeny = skipDenyN;
    if (skipReal > 0) {
      jlSyncNote("内核侧扫描本轮有 " + skipReal + " 条真实跳过（截断/上限类）⇒ 本轮不判任何删除（保守闸）", "warn");
    } else if (skipDenyN > 0) {
      jlSyncNote("内核侧扫描本轮的 " + skipDenyN + " 条跳过全属排除面（deny）常态命中 ⇒ 不计入保守闸③"
        + "（不指示本轮扫描不完整）", "info");
    }
    /* ⚠️ **R-D2-2（B2-c · D3 补批，2026-09-17）**：本轮 `scan` / `out` 侧的**任何异常**（`listdir`
       抛错 / `stat` 抛错 / 内容读失败）在报文里的形状都是"该路径**没出现**在 `files` 里" ——
       与"内核侧真的删了它"**同形** ⇒ 若照常走 C-6，就会把它判成内核侧删除、**删掉 Contents 副本**
       （数据丢失；与 R-D2-1 同族的"状态误记 ⇒ 错误删除"）。
       §4.4 v3 保守闸的语义 = "闸只认**可信的完整轮**" ⇒ 异常轮一律 `incomplete`：**闭闸 `noDel`**
       + **不推进账本**（`files` 不完整 ⇒ grow 里的"缺席"不是结论）。与 D2 分离（deny 命中不计入）
       不冲突：deny 是**有意排除**、不指示本轮扫描不完整；异常指示不完整。 */
    var metaErrs = (meta.errors && meta.errors.length) ? meta.errors.length : 0;
    if (metaErrs > 0) {
      rec.incomplete = true;
      rec.scanErrors = metaErrs;
      for (i = 0; i < meta.errors.length && i < 4; i++) {
        rec.errors.push(String((meta.errors[i] || {}).path) + ":" + String((meta.errors[i] || {}).error));
      }
      jlSyncDegrade("本轮扫描/回收侧异常 " + metaErrs + " 条（" + rec.errors[0]
        + "）⇒ 本边界不判任何删除 + 保留旧账本（R-D2-2）");
    }
    var files = meta.files || {}, p, chunks = {}, grow = { __jlLedger: {} }, k;
    for (i = 0; i < recs.length; i++) {
      var cr = recs[i];
      if (cr && cr.t === "c" && typeof cr.p === "string") {
        if (!chunks[cr.p]) chunks[cr.p] = { total: Number(cr.total) || 0, parts: {} };
        chunks[cr.p].parts[Number(cr.seq) || 0] = String(cr.d || "");
      }
    }
    /* ① 保留旧账本的**跳过位**（含前缀位）—— 它们不是"内核里的内容清单"，是"判定跳过"的结论 */
    var old = conn.__jlLedger || {};
    for (p in old) {
      if (!Object.prototype.hasOwnProperty.call(old, p)) continue;
      if (old[p] && old[p].skipped) jlSyncLedgerSet(grow, p, old[p]);
    }
    var lastMod = {};
    for (p in files) {
      if (!Object.prototype.hasOwnProperty.call(files, p)) continue;
      rec.files++;
      var mm = files[p] || {};
      var oldr = jlSyncLedgerGet(conn, p);
      var keepLM = (oldr && !oldr.skipped) ? oldr.lastModified : null;
      var keepHash = (oldr && !oldr.skipped) ? oldr.hash : null;
      var skip = jlSyncSkipHit(conn, p);
      if (skip) {
        /* C-11：跳过位（含前缀跳过位）命中 ⇒ **一律不回写 Contents**（既不 save 也不 delete） */
        S.skippedWrites++;
        rec.skipHits++;
        jlSyncStatPushSkip(p, String(skip.skipped || "deny"), !!skip.prefix);
        jlSyncNote("C-11 拒绝回写：该路径命中跳过位（why=" + String(skip.skipped)
          + (skip.prefix ? " · prefix" : "") + "）——内核里那份是不完整副本", "err", p);
        continue;                                  /* 账本里的跳过位已由上面整体保留 */
      }
      if (mm.over) {
        /* §4.2：超单边界回收上限 ⇒ **跳过 + 明确提示 + 不缓存、不懒取** */
        S.skippedWrites++;
        rec.over.push(p);
        jlSyncStatPushSkip(p, "size", false);
        jlSyncNote("超出单次回收上限（'out' 方向 · " + String(JL_SYNC_MAX_BYTES_OUT) + " B）⇒ 本边界不回收该文件",
          "warn", p);
        /* **跳过 ≠ 缺席**（§4.2）：没写进 Contents 就必须记**跳过位**，**不得**记"已同步位" ——
           否则下一边界 ② 的 C-5 把"账本有、Contents 无"判成对端删除 ⇒ `apply.del` 删掉**内核文件**。 */
        jlSyncLedgerSet(grow, p, { skipped: "size", at: Date.now() - KR.t0 });
        continue;
      }
      if (mm.same) {
        rec.same++;
        jlSyncLedgerSet(grow, p, { size: mm.size, mtime: mm.mtime, lastModified: keepLM, hash: mm.hash || keepHash });
        continue;
      }
      rec.candidates++;
      var joined = jlSyncChunksJoin(chunks[p], p);
      if (!joined.ok) {
        rec.incomplete = true;
        /* 准入 ⑩（r1 真机实测发现的缺口）：本支路"没写进 Contents"却**没进 `skipTotal` 的任何分项**
           ⇒ 状态行会显示"跳过 0"而实际有跳过。⇒ 单列 `chunkFail` 并计入 `skipTotal`。 */
        rec.chunkFail = Number(rec.chunkFail || 0) + 1;
        rec.errors.push(p + ":" + joined.reason);
        jlSyncDegrade("内容分片不齐（" + p + " · " + joined.reason + "）⇒ 本边界判不完整 + 不判任何删除");
        /* 内容没拿到 ⇒ 没写进 Contents ⇒ 同 `over` 分支：记**跳过位**，不得记"已同步位" */
        jlSyncStatPushSkip(p, "io", false);
        jlSyncLedgerSet(grow, p, { skipped: "io", at: Date.now() - KR.t0 });
        continue;
      }
      var w = null;
      try { w = await jlSyncOutWrite(conn, p, joined.b64, mm, oldr); }
      catch (e4) { w = { path: p, wrote: false, err: String((e4 && e4.message) || e4) }; }
      if (w.echoQuiet) rec.echoQuiet++;
      if (w.conflict) { rec.conflicts.push(p); jlSyncNote("C-4 冲突：本边界 ② 注入过该路径 ∧ 内核侧又改了 ⇒ 内核胜（后到者）", "warn", p); }
      if (w.err) { rec.writeErrors++; rec.errors.push(p + ":" + w.err); jlSyncNote("回收写回失败：" + w.err, "err", p); }
      if (w.wrote) {
        rec.reclaimed++;
        rec.saved++;
        lastMod[p] = w.lastModified;
        jlSyncLedgerSet(grow, p, { size: mm.size, mtime: mm.mtime, lastModified: w.lastModified || keepLM,
          hash: mm.hash || keepHash });
      } else if (w.valueSame) {
        /* Contents 里已是**逐字节相同**的内容 ⇒ 这条路真的已同步（回声抑制的常态落点，**不是**跳过） */
        if (w.lastModified) lastMod[p] = w.lastModified;
        jlSyncLedgerSet(grow, p, { size: mm.size, mtime: mm.mtime,
          lastModified: w.lastModified || keepLM, hash: mm.hash || keepHash });
      } else {
        /* 本边界**没有**写进 Contents（回声硬熔断 / 回写失败）⇒ 同 `over` 分支：记**跳过位**，
           **不得**记"已同步位"（否则下一边界 ② 的 C-5 会删内核文件、或按内容判等把 Contents 旧内容回灌内核）； */
        S.skippedWrites++;
        jlSyncStatPushSkip(p, w.echoQuiet ? "echo" : "io", false);
        jlSyncNote("本边界未回写（" + (w.echoQuiet ? "回声环硬熔断" : String(w.err || "写失败"))
          + "）⇒ 记跳过位（不回写、不判删除）", "warn", p);
        jlSyncLedgerSet(grow, p, { skipped: w.echoQuiet ? "echo" : "io", at: Date.now() - KR.t0 });
      }
    }
    /* C-6：`P ∈ ledger 的已同步位` ∧ 内核 FS 里已无 P ⇒ `contents.delete(P)`（三条前置闸全须满足） */
    var noDel = rec.incomplete || rec.truncated || skipReal > 0 || metaErrs > 0
      || Number(meta.truncatedEntries) > 0;
    if (noDel) {
      jlSyncNote("本轮有截断/真实跳过/不完整 ⇒ 不判任何删除（C-6 闸③ · 与 C-9 同款保守口径；"
        + "排除面 deny 命中不计入 —— D2 分离）", "warn");
    } else {
      var dels = [];
      for (p in old) {
        if (!Object.prototype.hasOwnProperty.call(old, p)) continue;
        var orr = old[p];
        if (!orr || orr.skipped || Object.prototype.hasOwnProperty.call(files, p)) continue;
        dels.push(p);
      }
      for (i = 0; i < dels.length; i++) {
        var dp = dels[i];
        var dres = null;
        try {
          dres = await jlSyncDepthWrap(conn, function () { return jlSyncSm().contents.delete(dp); });
          rec.deleted++;
          S.reclaimed++;
          jlSyncNote("C-6 内核侧删除 ⇒ 同步删 Contents（" + dp + "）", "info", dp);
        } catch (e5) {
          /* Contents 里本就没有 ⇒ 幂等（不当作失败）；其它错误如实登记 */
          var msg = String((e5 && e5.message) || e5);
          if (msg.indexOf("404") < 0 && msg.indexOf("Not Found") < 0 && msg.indexOf("not found") < 0) {
            rec.writeErrors++;
            rec.errors.push(dp + ":del:" + msg);
            jlSyncNote("C-6 删除失败：" + msg, "err", dp);
          }
        }
      }
    }
    /* 只在一次完整成功的边界之后整体替换。⚠️ **R-D2-2**：本轮 scan/out 侧有异常（`metaErrs > 0`）
       ⇒ `files` 不完整 ⇒ **不推进账本**（保留旧账本：本轮的"缺席"不是结论；若照常推进，被异常遮蔽
       的路径会被记成 `grow` 里缺席、把"没看见"固化成状态）。 */
    if (metaErrs === 0) conn.__jlLedger = grow.__jlLedger;
    rec.noDelete = !!noDel;
    rec.savedLast = lastMod;
    S.reclaimed += rec.reclaimed;
    rec.ms = Date.now() - t0;
    /* 状态行「跳过 N」的**展示口径**（B2-c 准入 ⑩）：此前只读 `rec.skipHits`（= **仅** C-11 命中）
       ⇒ 出现"状态行 跳过 0 而 `__JL_SYNC_STAT.skippedWrites=2`"的展示不一致。改 = 全量口径
       = C-11 + `over`（超回收上限）+ `echoQuiet`（回声硬熔断）+ 写失败 + **`chunkFail`（分片不齐，
       本支路原先一条分项都不进 —— r1 真机实测发现）**，并**分项**列出。 */
    rec.skipTotal = rec.skipHits + rec.over.length + rec.echoQuiet + rec.writeErrors + Number(rec.chunkFail || 0);
    /* ④ 的边界记录留档（诊断面；`D.boundaries` 只收 ② 的 rec —— 装置需要 ④ 的 rec 才能机械判 P-C14c/G9/G10） */
    var DO = jlSyncDg();
    DO.outBdrs = DO.outBdrs || [];
    DO.outBdrs.push(rec);
    if (DO.outBdrs.length > 40) DO.outBdrs.shift();
    jlSyncNote("④ 回收完成：内核 " + rec.files + " 件（未变 " + rec.same + " · 候选 " + rec.candidates
      + "）⇒ 回写 " + rec.reclaimed + " 件 / 删 Contents " + rec.deleted + " 件 · 跳过 " + rec.skipTotal
      + "（C-11 " + rec.skipHits + " · over " + rec.over.length + " · echo " + rec.echoQuiet
      + " · 写失败 " + rec.writeErrors + " · 分片不齐 " + Number(rec.chunkFail || 0) + "）· IOPub "
      + rec.ioBytes + " B · " + rec.ms + " ms"
      + (rec.noDelete ? " · **本轮不判任何删除**" : ""), rec.incomplete ? "warn" : "info");
    return rec;
  }

  /* ---- ① 能力探测降级（§3.3 / §5.1；P2-4 定案 (b) ⇒ 本环境恒走 degraded） ---- */
  function jlSyncFlush(conn) {
    var fn = null;
    try { if (typeof window.jlBridgePush === "function") fn = window.jlBridgePush; } catch (e) {}
    if (!fn) {
      JLS_DEGRADED = true;
      jlSyncSt().degraded = true;
      jlSyncNote("① flush：jlBridgePush 缺席（Phase 4 未落地 / P2-4 判为推送归主页面）"
        + " ⇒ 能力探测降级,直接进入 ②", "degraded");
      return Promise.resolve({ ok: false, degraded: true, reason: "bridge-absent" });
    }
    return jlRace(Promise.resolve().then(function () { return fn(); }), JL_SYNC_PUSH_WAIT_MS, "①0.flush")
      .then(function () { return { ok: true }; }, function (e) {
        jlSyncDegrade("① flush 超时/失败（" + ((e && e.message) || e) + "）⇒ 降级继续,不等回声环");
        return { ok: false, timeout: true };
      });
  }

  /* ---- 返回契约（§3.2）：IFuture 兼容代理 ---- */
  /* 槽位访问器：**赋值不得覆盖投递面**（上游 `OutputArea` 就是赋值；见 `jlSyncSlot` 的机械依据）。
     getter 返回可调用槽位（仍支持 `.connect/.emit`）⇒ 既有装置/读数写法不变。 */
  function jlSyncSlotProp(f, name, key) {
    Object.defineProperty(f, name, {
      get: function () { return f.__jlSig[key]; },
      set: function (h) { f.__jlSig[key].assign(h); },
      enumerable: true, configurable: true
    });
  }
  function jlSyncFuture(conn) {
    var f = { __jlSettled: false, __jlReal: null, __jlInnerDisposed: false, __jlHooks: [], __jlConn: conn || null };
    f.__jlResolve = null;
    f.__jlReject = null;
    f.done = new Promise(function (res, rej) { f.__jlResolve = res; f.__jlReject = rej; });
    f.__jlSig = { iopub: jlSyncSlot(), reply: jlSyncSlot(), stdin: jlSyncSlot() };
    jlSyncSlotProp(f, "onIOPub", "iopub");
    jlSyncSlotProp(f, "onReply", "reply");
    jlSyncSlotProp(f, "onStdin", "stdin");
    /* `msg` = 请求标识（不是可 await 面）：**发出前 undefined、发出后透出真 future 的 msg**（不伪造） */
    Object.defineProperty(f, "msg", {
      get: function () { return f.__jlReal ? f.__jlReal.msg : undefined; },
      enumerable: true, configurable: true
    });
    /* 上游 `KernelFutureHandler` 的这两个成员被 `CodeCell.execute` 的 recordTiming 支路直接调用
       （`n.outputArea.future.registerMessageHook(...)`）⇒ 缺席即 TypeError */
    f.registerMessageHook = function (h) { if (typeof h === "function") { f.removeMessageHook(h); f.__jlHooks.push(h); } };
    f.removeMessageHook = function (h) { var i = f.__jlHooks.indexOf(h); if (i >= 0) f.__jlHooks[i] = null; };
    f.sendInputReply = function (content, parentHeader) {
      if (f.__jlReal && typeof f.__jlReal.sendInputReply === "function") return f.__jlReal.sendInputReply(content, parentHeader);
      if (f.__jlConn && typeof f.__jlConn.sendInputReply === "function") return f.__jlConn.sendInputReply(content, parentHeader);
      return undefined;
    };
    f.dispose = function () {
      if (f.__jlDisposed) return;
      f.__jlDisposed = true;
      if (f.__jlReal && !f.__jlInnerDisposed) {
        f.__jlInnerDisposed = true;
        try { f.__jlReal.dispose(); } catch (e) {}
      }
      /* dispose 之后：回调注册退化为安全空操作（不抛、不再触发） */
      f.__jlSig.iopub.kill();
      f.__jlSig.reply.kill();
      f.__jlSig.stdin.kill();
      f.__jlHooks.length = 0;
    };
    return f;
  }
  function jlSyncSettleDone(f, m) {
    if (f.__jlSettled) return;
    f.__jlSettled = true;
    try { f.__jlResolve(m); } catch (e) {}
  }
  function jlSyncSettleAborted(conn, f, status) {
    if (f.__jlSettled) return;
    f.__jlSettled = true;
    var st = String(status || "aborted");
    var msg = { header: { msg_type: "execute_reply", msg_id: "jl-sync-" + st, date: new Date().toISOString() },
      parent_header: {}, metadata: {}, channel: "shell",
      content: { status: st, execution_count: null } };
    f.__jlSig.reply.emit(null, msg);           /* 不得吞掉 aborted */
    try { f.__jlResolve(msg); } catch (e) {}
    JLS_DEGRADED = true;
    jlSyncSt().degraded = true;
  }
  /* 上游形位两条都兼容：真 future 的这三个成员是**可赋值单处理器**（本 build 实测），
     若某版本是 Signal 则走 connect —— 投递一律收口到 `f.__jlSig[key].emit`。 */
  function jlSyncForwardSlot(f, real, name, key) {
    var deliver = function (m) {
      if (key === "iopub" && !jlSyncRunHooks(f, m)) return;   /* 钩子返回 false ⇒ 截断该条（上游 HookList 语义） */
      f.__jlSig[key].emit(null, m);
    };
    try {
      if (real[name] && typeof real[name].connect === "function") { real[name].connect(function (_, m) { deliver(m); }); return; }
      real[name] = function (m) { deliver(m); };
    } catch (e) { devlog("sync 转发装不上：" + name + " " + ((e && e.message) || e)); }
  }
  function jlSyncRunHooks(f, m) {
    var hs = f.__jlHooks, i, r;
