      get: function () { return hrefDesc.get.call(this); },
      set: function (v) {
        if (window.__JL_LINK_CALLS.length < 60) window.__JL_LINK_CALLS.push(String(v).slice(0, 160));
        var p = pathOf(v);
        if (p === null) return hrefDesc.set.call(this, v);
        var t = TEXT[p];
        if (t === undefined) { missOf(p, "link.href"); return hrefDesc.set.call(this, v); }
