        return { path: r.path || p, bytes: u8 };
      });
    }
    /* fetch 垫片:虚拟源命中内存段;**非虚拟源一律不触网**(零外部请求红线)⇒ 404 + 可见诊断 */
    self.fetch = function (input, init) {
      var url = (typeof input === "string") ? input : (input && (typeof input.href === "string" ? input.href : input.url));
      var p = pathOf(url);
      if (p === null) {
        L("nonvirtual-blocked " + String(url).slice(0, 120));
        if (MISS.indexOf(String(url)) < 0) MISS.push(String(url));
        pushDiag("nonvirtual");
        return Promise.resolve(resp(null, "", 404));
      }
      return fetchU8(p, "fetch").then(function (r) {
        if (r.miss) return resp(null, p, 404);
        return resp(r.bytes, r.path, 200);
      });
    };
